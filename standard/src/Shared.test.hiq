-- The operations of Standard.Shared in one task.  Several tasks at once
-- are tested end to end.
import Standard.Testing (
    assertTrue
);
import Standard.Shared (
    Mutex,
    Key,
    Held,
    makeMutex,
    acquire,
    tryAcquire,
    release,
    mutexHeld,
    destroyMutex,
    Atomic,
    makeAtomic,
    atomicLoad,
    atomicStore,
    atomicAdd,
    atomicExchange,
    atomicCompareSwap,
    destroyAtomic
);

module body Standard.Shared.Test is
    -- Acquire, check, and give back one more than was there.
    generic [R: Region]
    function addOne(mutex: &[Mutex[Int64], R]): Unit is
        assertTrue(not mutexHeld(mutex), "a mutex nobody acquired is not held");
        let { value as seen: Int64, key: Key } := acquire(mutex);
        assertTrue(seen = 41, "acquire hands out the value");
        assertTrue(mutexHeld(mutex), "the mutex is held after acquire");
        release(mutex, seen + 1, key);
        assertTrue(not mutexHeld(mutex), "the mutex is not held after release");
        return nil;
    end;

    function testMutexHandsTheValueOutAndBack(): Unit is
        let start: Int64 := 41;
        case makeMutex(start) of
            when Right(right as made: Mutex[Int64]) do
                let mutex: Mutex[Int64] := made;
                borrow m: &[Mutex[Int64], rho] := &mutex do
                    addOne(m);
                end borrow;
                let last: Int64 := destroyMutex(mutex);
                assertTrue(last = 42, "destroyMutex gives the value put back");
            when Left(left as back: Int64) do
                assertTrue(false, "a mutex could be made");
        end case;
        return nil;
    end;

    -- tryAcquire while the mutex is held, and after it is given back.
    generic [R: Region]
    function tryTwice(mutex: &[Mutex[Int64], R]): Unit is
        let { value as seen: Int64, key: Key } := acquire(mutex);
        case tryAcquire(mutex) of
            when Some(value as again: Held[Int64]) do
                assertTrue(false, "tryAcquire refuses a mutex that is held");
                let { value as other: Int64, key as otherKey: Key } := again;
                release(mutex, other, otherKey);
            when None do
                assertTrue(true, "tryAcquire refuses a mutex that is held");
        end case;
        release(mutex, seen, key);
        case tryAcquire(mutex) of
            when Some(value as again: Held[Int64]) do
                let { value as other: Int64, key as otherKey: Key } := again;
                assertTrue(other = 7, "tryAcquire takes a mutex that is free, with its value");
                release(mutex, other, otherKey);
            when None do
                assertTrue(false, "tryAcquire takes a mutex that is free, with its value");
        end case;
        return nil;
    end;

    function testTryAcquireWhileHeld(): Unit is
        let start: Int64 := 7;
        case makeMutex(start) of
            when Right(right as made: Mutex[Int64]) do
                let mutex: Mutex[Int64] := made;
                borrow m: &[Mutex[Int64], rho] := &mutex do
                    tryTwice(m);
                end borrow;
                let last: Int64 := destroyMutex(mutex);
                assertTrue(last = 7, "the value is unchanged");
            when Left(left as back: Int64) do
                assertTrue(false, "a mutex could be made");
        end case;
        return nil;
    end;

    generic [R: Region]
    function operate(word: &[Atomic, R]): Unit is
        assertTrue(atomicLoad(word) = 10, "a new word holds its initial value");
        assertTrue(atomicAdd(word, 5) = 15, "atomicAdd returns the sum");
        assertTrue(atomicAdd(word, -20) = -5, "atomicAdd takes a negative delta");
        assertTrue(atomicExchange(word, 3) = -5, "atomicExchange returns what was there");
        atomicStore(word, 4);
        assertTrue(atomicLoad(word) = 4, "atomicStore sets the word");
        assertTrue(atomicCompareSwap(word, 4, 9), "compare and swap on the expected value");
        assertTrue(not atomicCompareSwap(word, 4, 11), "compare and swap on another value fails");
        assertTrue(atomicLoad(word) = 9, "a failed compare and swap changes nothing");
        return nil;
    end;

    function testAtomicOperations(): Unit is
        case makeAtomic(10) of
            when Some(value as made: Atomic) do
                let word: Atomic := made;
                borrow w: &[Atomic, rho] := &word do
                    operate(w);
                end borrow;
                let last: Int64 := destroyAtomic(word);
                assertTrue(last = 9, "destroyAtomic gives the last value");
            when None do
                assertTrue(false, "an atomic word could be made");
        end case;
        return nil;
    end;
end module body.
