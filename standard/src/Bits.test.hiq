import Standard.Bits (
    float64Bits,
    float64FromBits,
    float32Bits,
    float32FromBits,
    int64Bits,
    int64FromBits,
    int32Bits,
    int32FromBits
);
import Standard.Testing (assertTrue);

module body Standard.Bits.Test is
    -- The bit patterns of binary64 and binary32, as Python's struct module gives them.
    function testFloat64Patterns(): Unit is
        assertTrue(float64Bits(1.0) = 4607182418800017408, "1.0 is 0x3ff0000000000000");
        assertTrue(float64Bits(-2.5) = 13836183955189006336, "-2.5 is 0xc004000000000000");
        assertTrue(float64Bits(0.1) = 4591870180066957722, "0.1 is 0x3fb999999999999a");
        assertTrue(float64FromBits(4607182418800017408) = 1.0, "0x3ff0000000000000 is 1.0");
        return nil;
    end;

    function testFloat32Patterns(): Unit is
        assertTrue(float32Bits(1.0) = 1065353216, "1.0 is 0x3f800000");
        assertTrue(float32Bits(-0.5) = 3204448256, "-0.5 is 0xbf000000");
        assertTrue(float32FromBits(3204448256) = -0.5, "0xbf000000 is -0.5");
        return nil;
    end;

    -- A NaN keeps its payload when read as bits and back.
    function testNaNPayloadKept(): Unit is
        let payload: Nat64 := 9221120237041090561;
        assertTrue(float64Bits(float64FromBits(payload)) = payload, "the payload of a NaN survives");
        return nil;
    end;

    function testTwosComplement(): Unit is
        assertTrue(int64Bits(-1) = 18446744073709551615, "-1 is all ones");
        assertTrue(int64FromBits(18446744073709551615) = -1, "all ones is -1");
        assertTrue(int64Bits(42) = 42, "a positive number keeps its value");
        assertTrue(int32Bits(-2) = 4294967294, "-2 is 0xfffffffe");
        assertTrue(int32FromBits(4294967294) = -2, "0xfffffffe is -2");
        return nil;
    end;
end module body.
