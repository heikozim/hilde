-- The examples of RFC 8949 appendix A that this reader takes, each fault
-- it refuses with its offset, the limits of depth and map size at the
-- limit and one past it, and a COSE key of kty 2 looked up by its
-- integer keys.
import Standard.Testing (
    assertTrue,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Text (
    hexToBytes,
    equal
);
import Standard.Cbor (
    CborFault,
    Truncated,
    Malformed,
    Indefinite,
    NotShortest,
    Tagged,
    UnknownSimple,
    TooDeep,
    TooLarge,
    DuplicateKey,
    BadText,
    Trailing,
    CborError,
    CborKind,
    CborUnsigned,
    CborNegative,
    CborBytes,
    CborText,
    CborArray,
    CborMap,
    CborFalse,
    CborTrue,
    CborNull,
    CborUndefined,
    CborFloat,
    Cbor,
    CborItem,
    readCbor,
    readCborPrefix,
    destroyCbor,
    usedBytes,
    rootOf,
    kindOf,
    unsignedOf,
    integerOf,
    bytesOf,
    textOf,
    boolOf,
    countOf,
    nthOf,
    keyOf,
    valueOf,
    textKey,
    integerKey,
    encodedOf
);

module body Standard.Cbor.Test is
    -- The bytes written in hexadecimal by text.
    function hex(text: Span[Nat8, Static]): String is
        case hexToBytes(text) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                abort("not hexadecimal");
        end case;
    end;

    function faultNumber(fault: CborFault): Int32 is
        case fault of
            when Truncated do
                return 1;
            when Malformed do
                return 2;
            when Indefinite do
                return 3;
            when NotShortest do
                return 4;
            when Tagged do
                return 5;
            when UnknownSimple do
                return 6;
            when TooDeep do
                return 7;
            when TooLarge do
                return 8;
            when DuplicateKey do
                return 9;
            when BadText do
                return 10;
            when Trailing do
                return 11;
        end case;
    end;

    function kindNumber(kind: Option[CborKind]): Int32 is
        case kind of
            when Some(value as k: CborKind) do
                case k of
                    when CborUnsigned do
                        return 1;
                    when CborNegative do
                        return 2;
                    when CborBytes do
                        return 3;
                    when CborText do
                        return 4;
                    when CborArray do
                        return 5;
                    when CborMap do
                        return 6;
                    when CborFalse do
                        return 7;
                    when CborTrue do
                        return 8;
                    when CborNull do
                        return 9;
                    when CborUndefined do
                        return 10;
                    when CborFloat do
                        return 11;
                end case;
            when None do
                return 0;
        end case;
    end;

    -- The bytes in data are refused with the fault numbered expected at
    -- the offset given.
    function refusedBytes(data: String, expected: Int32, offset: Index, message: Span[Nat8, Static]): Unit is
        case readCbor(asSpan(&data)) of
            when Right(right as document: Cbor) do
                destroyCbor(document);
                assertFailure(message);
            when Left(left as error: CborError) do
                assertTrue((faultNumber(error.fault) = expected) and (error.offset = offset), message);
        end case;
        destroyString(data);
        return nil;
    end;

    function refused(text: Span[Nat8, Static], expected: Int32, offset: Index, message: Span[Nat8, Static]): Unit is
        refusedBytes(hex(text), expected, offset, message);
        return nil;
    end;

    function read(text: Span[Nat8, Static]): Cbor is
        let data: String := hex(text);
        case readCbor(asSpan(&data)) of
            when Right(right as document: Cbor) do
                destroyString(data);
                return document;
            when Left(left as error: CborError) do
                destroyString(data);
                abort("an example was refused");
        end case;
    end;

    function readBytes(data: String): Option[Cbor] is
        case readCbor(asSpan(&data)) of
            when Right(right as document: Cbor) do
                destroyString(data);
                let some: Option[Cbor] := Some(value => document);
                return some;
            when Left(left as error: CborError) do
                destroyString(data);
                let none: Option[Cbor] := None();
                return none;
        end case;
    end;

    function integerIs(text: Span[Nat8, Static], expected: Int64, message: Span[Nat8, Static]): Unit is
        let document: Cbor := read(text);
        case integerOf(&document, rootOf(&document)) of
            when Some(value as number: Int64) do
                assertTrue(number = expected, message);
            when None do
                assertFailure(message);
        end case;
        destroyCbor(document);
        return nil;
    end;

    function kindIs(text: Span[Nat8, Static], expected: Int32, message: Span[Nat8, Static]): Unit is
        let document: Cbor := read(text);
        assertTrue(kindNumber(kindOf(&document, rootOf(&document))) = expected, message);
        destroyCbor(document);
        return nil;
    end;

    function stringIs(found: Option[String], expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case found of
            when Some(value as text: String) do
                assertTrue(equal(asSpan(&text), expected), message);
                destroyString(text);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    generic [R: Region]
    function itemInteger(document: &[Cbor, R], item: Option[CborItem], expected: Int64, message: Span[Nat8, Static]): Unit is
        case item of
            when Some(value as found: CborItem) do
                case integerOf(document, found) of
                    when Some(value as number: Int64) do
                        assertTrue(number = expected, message);
                    when None do
                        assertFailure(message);
                end case;
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function isNoString(found: Option[String]): Bool is
        case found of
            when Some(value as text: String) do
                destroyString(text);
                return false;
            when None do
                return true;
        end case;
    end;

    function isNoItem(item: Option[CborItem]): Bool is
        case item of
            when Some(value as found: CborItem) do
                return false;
            when None do
                return true;
        end case;
    end;

    function testIntegers(): Unit is
        integerIs("00", 0, "0");
        integerIs("17", 23, "23");
        integerIs("1818", 24, "24");
        integerIs("1903e8", 1000, "1000");
        integerIs("1b000000e8d4a51000", 1000000000000, "1000000000000");
        integerIs("20", -1, "-1");
        integerIs("3863", -100, "-100");
        integerIs("3b7fffffffffffffff", -9223372036854775807 - 1, "the least Int64");
        let below: Cbor := read("3b8000000000000000");
        let none: Option[Int64] := integerOf(&below, rootOf(&below));
        case none of
            when Some(value as number: Int64) do
                assertFailure("a negative number below Int64 has no Int64");
            when None do
                assertTrue(true, "a negative number below Int64 has no Int64");
        end case;
        destroyCbor(below);
        let most: Cbor := read("1bffffffffffffffff");
        case unsignedOf(&most, rootOf(&most)) of
            when Some(value as number: Nat64) do
                assertTrue(number = 18446744073709551615, "the most Nat64");
            when None do
                assertFailure("the most Nat64");
        end case;
        destroyCbor(most);
        return nil;
    end;

    function testKinds(): Unit is
        kindIs("f4", 7, "false");
        kindIs("f5", 8, "true");
        kindIs("f6", 9, "null");
        kindIs("f7", 10, "undefined");
        kindIs("f93c00", 11, "a half float");
        kindIs("fa47c35000", 11, "a single float");
        kindIs("fb3ff199999999999a", 11, "a double float");
        kindIs("40", 3, "empty bytes");
        kindIs("60", 4, "empty text");
        kindIs("80", 5, "empty array");
        kindIs("a0", 6, "empty map");
        let yes: Cbor := read("f5");
        case boolOf(&yes, rootOf(&yes)) of
            when Some(value as flag: Bool) do
                assertTrue(flag, "true reads as true");
            when None do
                assertFailure("true reads as true");
        end case;
        destroyCbor(yes);
        return nil;
    end;

    function testStrings(): Unit is
        let four: Cbor := read("4401020304");
        case bytesOf(&four, rootOf(&four)) of
            when Some(value as bytes: String) do
                assertTrue(length(&bytes) = 4, "four bytes");
                destroyString(bytes);
            when None do
                assertFailure("four bytes");
        end case;
        assertTrue(isNoString(textOf(&four, rootOf(&four))), "bytes are no text");
        destroyCbor(four);
        let ietf: Cbor := read("6449455446");
        stringIs(textOf(&ietf, rootOf(&ietf)), "IETF", "IETF");
        destroyCbor(ietf);
        let umlaut: Cbor := read("62c3bc");
        stringIs(textOf(&umlaut, rootOf(&umlaut)), "\u{fc}", "u with diaeresis");
        destroyCbor(umlaut);
        return nil;
    end;

    function testArraysAndMaps(): Unit is
        let document: Cbor := read("a26161016162820203");
        let top: CborItem := rootOf(&document);
        case countOf(&document, top) of
            when Some(value as pairs: Index) do
                assertTrue(pairs = 2, "two pairs");
            when None do
                assertFailure("two pairs");
        end case;
        itemInteger(&document, textKey(&document, top, "a"), 1, "a is 1");
        case textKey(&document, top, "b") of
            when Some(value as list: CborItem) do
                case countOf(&document, list) of
                    when Some(value as items: Index) do
                        assertTrue(items = 2, "b holds two items");
                    when None do
                        assertFailure("b holds two items");
                end case;
                itemInteger(&document, nthOf(&document, list, 1), 3, "b at 1 is 3");
                assertTrue(isNoItem(nthOf(&document, list, 2)), "b has no item at 2");
            when None do
                assertFailure("b is there");
        end case;
        assertTrue(isNoItem(textKey(&document, top, "c")), "c is not there");
        case keyOf(&document, top, 1) of
            when Some(value as key: CborItem) do
                stringIs(textOf(&document, key), "b", "the key of pair 1 is b");
            when None do
                assertFailure("the key of pair 1 is b");
        end case;
        itemInteger(&document, valueOf(&document, top, 0), 1, "the value of pair 0 is 1");
        assertTrue(isNoItem(keyOf(&document, top, 2)), "no pair 2");
        assertTrue(isNoItem(nthOf(&document, top, 0)), "a map is no array");
        destroyCbor(document);
        return nil;
    end;

    -- A COSE key of kty 2 (EC2), alg -7 (ES256), crv 1 (P-256), with an x
    -- and a y of 32 bytes each.
    function testCoseKey(): Unit is
        let key: Cbor := read("a5010203262001215820000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f225820202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f");
        let top: CborItem := rootOf(&key);
        itemInteger(&key, integerKey(&key, top, 1), 2, "kty is 2");
        itemInteger(&key, integerKey(&key, top, 3), -7, "alg is -7");
        itemInteger(&key, integerKey(&key, top, -1), 1, "crv is 1");
        case integerKey(&key, top, -3) of
            when Some(value as y: CborItem) do
                case bytesOf(&key, y) of
                    when Some(value as bytes: String) do
                        let wanted: String := hex("202122232425262728292a2b2c2d2e2f303132333435363738393a3b3c3d3e3f");
                        assertTrue(equal(asSpan(&bytes), asSpan(&wanted)), "y is its 32 bytes");
                        destroyString(wanted);
                        destroyString(bytes);
                    when None do
                        assertFailure("y is bytes");
                end case;
            when None do
                assertFailure("y is there");
        end case;
        assertTrue(isNoItem(integerKey(&key, top, 4)), "no key 4");
        assertTrue(usedBytes(&key) = 77, "the key takes 77 bytes");
        destroyCbor(key);
        return nil;
    end;

    function testRefusals(): Unit is
        refused("", 1, 0, "nothing");
        refused("18", 1, 0, "a one byte number without its byte");
        refused("1903", 1, 0, "a two byte number with one");
        refused("4401", 1, 0, "four bytes with one");
        refused("8201", 1, 0, "an array of two with one");
        refused("1c", 2, 0, "additional value 28");
        refused("9fff", 3, 0, "an indefinite array");
        refused("ff", 3, 0, "a break byte");
        refused("1817", 4, 0, "23 written in two bytes");
        refused("1900ff", 4, 0, "255 written in three bytes");
        refused("5800", 4, 0, "an empty byte string with a one byte length");
        refused("c074323031332d30332d32315432303a30343a30305a", 5, 0, "a tag");
        refused("f0", 6, 0, "simple value 16");
        refused("f818", 6, 0, "a simple value in a byte");
        refused("a201020103", 9, 3, "the key 1 twice");
        refused("a2616101616102", 9, 4, "the key a twice");
        refused("62c328", 10, 0, "text that is no UTF-8");
        refused("0000", 11, 1, "a byte after the item");
        return nil;
    end;

    function testDepth(): Unit is
        let sixteen: Cbor := read("8181818181818181818181818181818100");
        assertTrue(usedBytes(&sixteen) = 17, "sixteen arrays deep are read");
        destroyCbor(sixteen);
        refused("818181818181818181818181818181818100", 7, 16, "seventeen arrays deep are refused");
        return nil;
    end;

    -- A map of pairs pairs with the keys 0 to pairs - 1 and the value 0;
    -- pairs is at most 256 so the head takes two bytes after b9.
    function mapOf(pairs: Index): String is
        var builder: StringBuilder := makeStringBuilder();
        let head: Nat8 := 185;
        let one: Nat8 := 24;
        let two: Nat8 := 25;
        let zero: Nat8 := 0;
        writeByte(&!builder, head);
        writeByte(&!builder, byteOf(pairs / 256));
        writeByte(&!builder, byteOf(pairs - ((pairs / 256) * 256)));
        var key: Index := 0;
        while key < pairs do
            if key < 24 then
                writeByte(&!builder, byteOf(key));
            else if key < 256 then
                writeByte(&!builder, one);
                writeByte(&!builder, byteOf(key));
            else
                writeByte(&!builder, two);
                writeByte(&!builder, byteOf(key / 256));
                writeByte(&!builder, byteOf(key - ((key / 256) * 256)));
            end if;
            writeByte(&!builder, zero);
            key := key + 1;
        end while;
        return finalize(builder);
    end;

    function byteOf(small: Index): Nat8 is
        case toNat8(small) of
            when Some(value as byte: Nat8) do
                return byte;
            when None do
                abort("not a byte");
                let zero: Nat8 := 0;
                return zero;
        end case;
    end;

    -- Both maps have a head of two bytes after b9, the shortest for a
    -- count from 256 on.
    function testMapSize(): Unit is
        case readBytes(mapOf(256)) of
            when Some(value as full: Cbor) do
                case countOf(&full, rootOf(&full)) of
                    when Some(value as pairs: Index) do
                        assertTrue(pairs = 256, "a map of 256 pairs is read");
                    when None do
                        assertFailure("a map of 256 pairs is read");
                end case;
                destroyCbor(full);
            when None do
                assertFailure("a map of 256 pairs is read");
        end case;
        refusedBytes(mapOf(257), 8, 0, "a map of 257 pairs is refused");
        return nil;
    end;

    function testPrefix(): Unit is
        let data: String := hex("8201820203ff");
        case readCborPrefix(asSpan(&data)) of
            when Right(right as document: Cbor) do
                assertTrue(usedBytes(&document) = 5, "the item takes five bytes");
                case nthOf(&document, rootOf(&document), 1) of
                    when Some(value as inner: CborItem) do
                        case encodedOf(&document, inner) of
                            when Some(value as bytes: String) do
                                let wanted: String := hex("820203");
                                assertTrue(equal(asSpan(&bytes), asSpan(&wanted)), "the inner array is 820203");
                                destroyString(wanted);
                                destroyString(bytes);
                            when None do
                                assertFailure("the inner array is 820203");
                        end case;
                    when None do
                        assertFailure("an item at 1");
                end case;
                destroyCbor(document);
            when Left(left as error: CborError) do
                assertFailure("a prefix is read");
        end case;
        destroyString(data);
        refused("8201820203ff", 11, 5, "readCbor wants the item alone");
        return nil;
    end;
end module body.
