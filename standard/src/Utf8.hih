"""
UTF-8: decoding it, validating it and building it.

- A CodePoint that exists is a valid scalar value, and makeCodePoint is the only way to make one.
- makeCodePoint refuses a surrogate and anything above U+10FFFF.
- Invalid input is None, never the replacement character: substituting is the caller's to do.
- A stray continuation byte, a cut sequence, a byte from 0xF8 up and an overlong form are refused.
- So an overlong encoding of a slash cannot get past a path check.
- Encoding cannot fail, since every CodePoint is encodable.

    case makeCodePoint(233) of
        when Some(value as point: CodePoint) do
            appendCodePoint(&!builder, point);
        when None do
            skip;
    end case;
    let count: Option[Index] := countCodePoints(asSpan(&text));
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder
);

module Standard.Utf8 is
    ---
    --- A scalar value
    ---

    """
    One Unicode scalar value.  Free.

    It cannot be built out of range: see makeCodePoint.
    """
    type CodePoint: Free;

    """
    Make one, or refuse.

    None for a surrogate (U+D800 to U+dfff) and for anything above
    U+10FFFF.  Those are not scalar values, and UTF-8 has no encoding for
    them -- a decoder that accepted them would produce bytes no other
    decoder would read back.
    No contract: an Option result, which an ensures cannot look into.
    """
    function makeCodePoint(scalar: Nat32): Option[CodePoint];

    """
    The number behind it.
    """
    function codePointValue(point: CodePoint): Nat32
        ensures result <= 1114111;

    """
    How many bytes it takes: 1, 2, 3 or 4.
    """
    function encodedWidth(point: CodePoint): Index
        ensures (result >= 1) and (result <= 4);

    ---
    --- Reading
    ---

    """
    What one decoded sequence is: the scalar and how many bytes it took.

    The two travel together because a caller walking a string needs both,
    and working the width out again from the scalar is a second chance for
    the two to disagree.
    """
    type Decoded: Free;

    """
    The scalar.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function decodedPoint(decoded: Decoded): CodePoint;

    """
    How many bytes it occupied.
    """
    function decodedWidth(decoded: Decoded): Index
        ensures (result >= 1) and (result <= 4);

    """
    Decode the sequence that starts at at.

    None when the position is past the end, when the byte there is not a
    leader, when the sequence is cut short, when it is overlong, or when
    what it encodes is not a scalar value.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decodeAt(text: Span[Nat8, R], at: Index): Option[Decoded];

    """
    Is the whole string well-formed UTF-8?

    An empty string is valid: it is zero well-formed sequences.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isValid(text: Span[Nat8, R]): Bool;

    """
    How many scalar values the string holds, or None if it is not
    well-formed.

    None rather than a count of what could be read: a partial count of a
    broken string is a number that invites being used.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function countCodePoints(text: Span[Nat8, R]): Option[Index];

    ---
    --- Writing
    ---

    """
    Append one scalar value, encoded, to a builder.

    It cannot fail: a CodePoint that exists is encodable, which is what
    makeCodePoint is for.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region]
    function appendCodePoint(builder: &![StringBuilder, R],
        point: CodePoint): Unit;
end module.
