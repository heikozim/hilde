-- A safe module: the salt comes from Standard.Libcrypto, the tag from
-- Bindings.Argon2, and the check of an old bcrypt hash from
-- Bindings.Bcrypt, which hold the work with addresses.
import Standard.String (
    String,
    destroyString,
    length,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Text (
    parseNat,
    substring,
    constantTimeEqual
);
import Standard.Base64 (
    encodeUnpadded,
    decodeUnpadded
);
import Standard.Libcrypto (
    randomBytes,
    hmacSha256
);
import Bindings.Argon2 (
    argon2id
);
import Bindings.Bcrypt (
    bcryptCheck
);

module body Standard.Password is
    -- The values of every new hash.  No caller sets them, so no caller
    -- can choose weaker ones.
    constant new_memory: Nat32 := 65536;
    constant new_passes: Nat32 := 3;
    constant new_lanes: Nat32 := 4;
    constant new_salt_size: Index := 16;
    constant new_tag_size: Index := 32;

    -- The bounds a stored hash is read within.  Argon2 takes far more; these
    -- keep a stored string from asking for more than a gibibyte of memory,
    -- or for a long time, on every check.
    constant most_memory: Nat64 := 1048576;
    constant most_passes: Nat64 := 16;
    constant most_lanes: Nat64 := 16;
    constant fewest_salt_bytes: Index := 8;
    constant most_salt_bytes: Index := 64;
    constant fewest_tag_bytes: Index := 16;
    constant most_tag_bytes: Index := 64;
    constant most_digits: Index := 10;

    -- An old bcrypt hash is 60 bytes: the marker, two digits of cost, a
    -- dollar sign, then 53 bytes of salt and hash.  Each step of the cost
    -- doubles the work of a check; 4 is the least bcrypt takes, and a
    -- stored string asking for more than 16 is not computed.
    constant bcrypt_size: Index := 60;
    constant fewest_bcrypt_cost: Nat8 := 4;
    constant most_bcrypt_cost: Nat8 := 16;

    constant byte_dollar: Nat8 := 36;
    constant byte_dot: Nat8 := 46;
    constant byte_slash: Nat8 := 47;
    constant byte_zero: Nat8 := 48;
    constant byte_nine: Nat8 := 57;
    constant byte_upper_a: Nat8 := 65;
    constant byte_upper_z: Nat8 := 90;
    constant byte_lower_a: Nat8 := 97;
    constant byte_lower_b: Nat8 := 98;
    constant byte_lower_y: Nat8 := 121;
    constant byte_lower_z: Nat8 := 122;

    ---
    --- Writing a hash
    ---

    -- value in decimal digits, without a leading zero.
    generic [R: Region]
    function writeDecimal(builder: &![StringBuilder, R], value: Nat32): Unit is
        if value >= 10 then
            writeDecimal(&~builder, value / 10);
        end if;
        case toNat8(value - ((value / 10) * 10)) of
            when Some(value as digit: Nat8) do
                writeByte(&~builder, byte_zero + digit);
            when None do
                skip;
        end case;
        return nil;
    end;

    generic [S: Region, T: Region]
    function phcString(salt: Span[Nat8, S], tag: Span[Nat8, T]): String is
        var builder: StringBuilder := makeStringBuilder();
        writeString(&!builder, "$argon2id$v=19$m=");
        writeDecimal(&!builder, new_memory);
        writeString(&!builder, ",t=");
        writeDecimal(&!builder, new_passes);
        writeString(&!builder, ",p=");
        writeDecimal(&!builder, new_lanes);
        writeByte(&!builder, byte_dollar);
        let salt_text: String := encodeUnpadded(salt);
        writeString(&!builder, asSpan(&salt_text));
        destroyString(salt_text);
        writeByte(&!builder, byte_dollar);
        let tag_text: String := encodeUnpadded(tag);
        writeString(&!builder, asSpan(&tag_text));
        destroyString(tag_text);
        return finalize(builder);
    end;

    generic [R: Region]
    function hashPassword(password: Span[Nat8, R]): Option[String] is
        let salt: String := randomBytes(new_salt_size)?;
        case argon2id(password, asSpan(&salt), new_passes, new_memory, new_lanes, new_tag_size) of
            when Some(value as tag: String) do
                let made: String := phcString(asSpan(&salt), asSpan(&tag));
                destroyString(tag);
                destroyString(salt);
                return Some(value => made);
            when None do
                destroyString(salt);
                return None();
        end case;
    end;

    ---
    --- Reading a hash
    ---

    -- Whether text holds literal from at on.
    generic [R: Region]
    function literalAt(text: Span[Nat8, R], at: Index, literal: Span[Nat8, Static]): Bool is
        let size: Index := spanLength(text);
        let want: Index := spanLength(literal);
        if at > size then
            return false;
        end if;
        if (size - at) < want then
            return false;
        end if;
        var i: Index := 0;
        var same: Bool := true;
        while same and (i < want) do
            same := text[at + i] = literal[i];
            i := i + 1;
        end while;
        return same;
    end;

    -- The first place from start on that is not a digit, or the length.
    generic [R: Region]
    function digitsEnd(text: Span[Nat8, R], start: Index): Index is
        let size: Index := spanLength(text);
        var i: Index := start;
        var going: Bool := i < size;
        while going do
            let byte: Nat8 := text[i];
            if (byte >= byte_zero) and (byte <= byte_nine) then
                i := i + 1;
                going := i < size;
            else
                going := false;
            end if;
        end while;
        return i;
    end;

    -- The first place from start on that holds byte, or the length.
    generic [R: Region]
    function nextByte(text: Span[Nat8, R], start: Index, byte: Nat8): Index is
        let size: Index := spanLength(text);
        var i: Index := start;
        var going: Bool := i < size;
        while going do
            if text[i] = byte then
                going := false;
            else
                i := i + 1;
                going := i < size;
            end if;
        end while;
        return i;
    end;

    -- The number the digits from start up to final stand for, or 0 for a
    -- form a stored hash does not have: no digit, a leading zero, more
    -- digits than any bound needs.  Every value read is at least 1, so 0
    -- is never a value.
    generic [R: Region]
    function numberIn(text: Span[Nat8, R], start: Index, final: Index): Nat64 is
        if final <= start then
            return 0;
        end if;
        if (final - start) > most_digits then
            return 0;
        end if;
        if text[start] = byte_zero then
            return 0;
        end if;
        let found: Option[Nat64] := parseNat(substring(text, start, final));
        case found of
            when Some(value as number: Nat64) do
                return number;
            when None do
                return 0;
        end case;
    end;

    function nat32Of(value: Nat64): Nat32 is
        case toNat32(value) of
            when Some(value as small: Nat32) do
                return small;
            when None do
                return 0;
        end case;
    end;

    -- The check itself, once the string is read: the tag of password with
    -- the stored salt and values, compared with the stored tag in constant
    -- time.
    generic [P: Region, S: Region, T: Region]
    function compareTag(password: Span[Nat8, P], salt: Span[Nat8, S], tag: Span[Nat8, T], memory: Nat64, passes: Nat64, lanes: Nat64): PasswordCheck is
        case argon2id(password, salt, nat32Of(passes), nat32Of(memory), nat32Of(lanes), spanLength(tag)) of
            when Some(value as computed: String) do
                let same: Bool := constantTimeEqual(asSpan(&computed), tag);
                destroyString(computed);
                if same then
                    return Matches();
                else
                    return DoesNotMatch();
                end if;
            when None do
                return Failed();
        end case;
    end;

    ---
    --- Reading an old bcrypt hash
    ---

    -- Whether stored begins with one of the three markers of bcrypt read
    -- here: 2a, 2b and 2y.
    generic [R: Region]
    function isBcrypt(stored: Span[Nat8, R]): Bool is
        if literalAt(stored, 0, "$2a$") then
            return true;
        end if;
        if literalAt(stored, 0, "$2b$") then
            return true;
        end if;
        return literalAt(stored, 0, "$2y$");
    end;

    function isDigit(byte: Nat8): Bool is
        return (byte >= byte_zero) and (byte <= byte_nine);
    end;

    -- Whether byte is in the alphabet of bcrypt's salt and hash: the dot,
    -- the slash, the capitals, the small letters and the digits.
    function isBcryptByte(byte: Nat8): Bool is
        if (byte = byte_dot) or (byte = byte_slash) then
            return true;
        end if;
        if (byte >= byte_upper_a) and (byte <= byte_upper_z) then
            return true;
        end if;
        if (byte >= byte_lower_a) and (byte <= byte_lower_z) then
            return true;
        end if;
        return isDigit(byte);
    end;

    -- The stored string as the library takes it.  A hash marked 2y is
    -- computed exactly as one marked 2b, and not every system's library
    -- reads the first marker, so it is handed over as the second.
    generic [R: Region]
    function libraryForm(stored: Span[Nat8, R]): String is
        var builder: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(stored);
        var i: Index := 0;
        while i < size do
            if (i = 2) and (stored[i] = byte_lower_y) then
                writeByte(&!builder, byte_lower_b);
            else
                writeByte(&!builder, stored[i]);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    -- An old bcrypt hash, read strictly before the library sees it: 60
    -- bytes, a cost of two digits within the bounds above, a dollar sign
    -- after it, and 53 bytes of the alphabet.  A match asks the caller to
    -- store a new hash.
    generic [P: Region, S: Region]
    function checkBcrypt(password: Span[Nat8, P], stored: Span[Nat8, S]): PasswordCheck is
        if spanLength(stored) /= bcrypt_size then
            return Unreadable();
        end if;
        let tens: Nat8 := stored[4];
        let ones: Nat8 := stored[5];
        if not (isDigit(tens) and isDigit(ones)) then
            return Unreadable();
        end if;
        let cost: Nat8 := ((tens - byte_zero) * 10) + (ones - byte_zero);
        if (cost < fewest_bcrypt_cost) or (cost > most_bcrypt_cost) then
            return Unreadable();
        end if;
        if stored[6] /= byte_dollar then
            return Unreadable();
        end if;
        var i: Index := 7;
        var in_alphabet: Bool := true;
        while in_alphabet and (i < bcrypt_size) do
            in_alphabet := isBcryptByte(stored[i]);
            i := i + 1;
        end while;
        if not in_alphabet then
            return Unreadable();
        end if;
        let given: String := libraryForm(stored);
        let answer: Int32 := bcryptCheck(password, asSpan(&given));
        destroyString(given);
        if answer = 1 then
            return MatchesStoreAgain();
        end if;
        if answer = 0 then
            return DoesNotMatch();
        end if;
        return Failed();
    end;

    ---
    --- Checking a password
    ---

    generic [P: Region, S: Region]
    function checkPassword(password: Span[Nat8, P], stored: Span[Nat8, S]): PasswordCheck is
        if isBcrypt(stored) then
            return checkBcrypt(password, stored);
        end if;
        let size: Index := spanLength(stored);
        let prefix: Span[Nat8, Static] := "$argon2id$v=19$m=";
        if not literalAt(stored, 0, prefix) then
            return Unreadable();
        end if;
        let memory_start: Index := spanLength(prefix);
        let memory_end: Index := digitsEnd(stored, memory_start);
        let memory: Nat64 := numberIn(stored, memory_start, memory_end);
        if not literalAt(stored, memory_end, ",t=") then
            return Unreadable();
        end if;
        let passes_start: Index := memory_end + 3;
        let passes_end: Index := digitsEnd(stored, passes_start);
        let passes: Nat64 := numberIn(stored, passes_start, passes_end);
        if not literalAt(stored, passes_end, ",p=") then
            return Unreadable();
        end if;
        let lanes_start: Index := passes_end + 3;
        let lanes_end: Index := digitsEnd(stored, lanes_start);
        let lanes: Nat64 := numberIn(stored, lanes_start, lanes_end);
        if not literalAt(stored, lanes_end, "$") then
            return Unreadable();
        end if;
        if (passes = 0) or (passes > most_passes) then
            return Unreadable();
        end if;
        if (lanes = 0) or (lanes > most_lanes) then
            return Unreadable();
        end if;
        if (memory < (lanes * 8)) or (memory > most_memory) then
            return Unreadable();
        end if;
        let salt_start: Index := lanes_end + 1;
        let salt_end: Index := nextByte(stored, salt_start, byte_dollar);
        if salt_end >= size then
            return Unreadable();
        end if;
        let tag_start: Index := salt_end + 1;
        if nextByte(stored, tag_start, byte_dollar) /= size then
            return Unreadable();
        end if;
        let salt_bytes: Option[String] := decodeUnpadded(substring(stored, salt_start, salt_end));
        let tag_bytes: Option[String] := decodeUnpadded(substring(stored, tag_start, size));
        case salt_bytes of
            when Some(value as salt: String) do
                case tag_bytes of
                    when Some(value as tag: String) do
                        let salt_size: Index := length(&salt);
                        let tag_size: Index := length(&tag);
                        var answer: PasswordCheck := Unreadable();
                        if ((salt_size >= fewest_salt_bytes) and (salt_size <= most_salt_bytes)) and ((tag_size >= fewest_tag_bytes) and (tag_size <= most_tag_bytes)) then
                            answer := compareTag(password, asSpan(&salt), asSpan(&tag), memory, passes, lanes);
                        end if;
                        destroyString(tag);
                        destroyString(salt);
                        return answer;
                    when None do
                        destroyString(salt);
                        return Unreadable();
                end case;
            when None do
                case tag_bytes of
                    when Some(value as tag: String) do
                        destroyString(tag);
                    when None do
                        skip;
                end case;
                return Unreadable();
        end case;
    end;

    ---
    --- Peppered hashes
    ---

    -- The fixed beginning of a peppered hash: the values of every new hash,
    -- the only ones a peppered hash is read with.
    constant peppered_prefix: Span[Nat8, Static] := "$argon2id-hmac$v=19$m=65536,t=3,p=4$";
    constant fewest_pepper_bytes: Index := 32;
    constant most_password_bytes: Index := 128;
    constant mac_size: Index := 32;

    -- The HMAC-SHA256 under pepper of the Argon2id tag of password and salt.
    generic [P: Region, S: Region, Q: Region]
    function pepperedTag(password: Span[Nat8, P], salt: Span[Nat8, S], pepper: Span[Nat8, Q]): Option[String] is
        case argon2id(password, salt, new_passes, new_memory, new_lanes, new_tag_size) of
            when Some(value as tag: String) do
                let mac: Option[String] := hmacSha256(pepper, asSpan(&tag));
                destroyString(tag);
                return mac;
            when None do
                return None();
        end case;
    end;

    generic [P: Region, Q: Region]
    function hashPepperedPassword(password: Span[Nat8, P], pepper: Span[Nat8, Q]): Option[String] is
        if spanLength(pepper) < fewest_pepper_bytes then
            return None();
        end if;
        if (spanLength(password) = 0) or (spanLength(password) > most_password_bytes) then
            return None();
        end if;
        let salt: String := randomBytes(new_salt_size)?;
        case pepperedTag(password, asSpan(&salt), pepper) of
            when Some(value as mac: String) do
                var builder: StringBuilder := makeStringBuilder();
                writeString(&!builder, peppered_prefix);
                let salt_text: String := encodeUnpadded(asSpan(&salt));
                writeString(&!builder, asSpan(&salt_text));
                destroyString(salt_text);
                writeByte(&!builder, byte_dollar);
                let mac_text: String := encodeUnpadded(asSpan(&mac));
                writeString(&!builder, asSpan(&mac_text));
                destroyString(mac_text);
                destroyString(mac);
                destroyString(salt);
                return Some(value => finalize(builder));
            when None do
                destroyString(salt);
                return None();
        end case;
    end;

    generic [P: Region, S: Region, Q: Region]
    function checkPepperedPassword(password: Span[Nat8, P], stored: Span[Nat8, S], pepper: Span[Nat8, Q]): PasswordCheck is
        if spanLength(pepper) < fewest_pepper_bytes then
            return Failed();
        end if;
        if not literalAt(stored, 0, peppered_prefix) then
            return Unreadable();
        end if;
        let size: Index := spanLength(stored);
        let salt_start: Index := spanLength(peppered_prefix);
        let salt_end: Index := nextByte(stored, salt_start, byte_dollar);
        if salt_end >= size then
            return Unreadable();
        end if;
        let mac_start: Index := salt_end + 1;
        if nextByte(stored, mac_start, byte_dollar) /= size then
            return Unreadable();
        end if;
        let salt_bytes: Option[String] := decodeUnpadded(substring(stored, salt_start, salt_end));
        let mac_bytes: Option[String] := decodeUnpadded(substring(stored, mac_start, size));
        case salt_bytes of
            when Some(value as salt: String) do
                case mac_bytes of
                    when Some(value as mac: String) do
                        var answer: PasswordCheck := Unreadable();
                        if (length(&salt) = new_salt_size) and (length(&mac) = mac_size) then
                            answer := DoesNotMatch();
                            if (spanLength(password) > 0) and (spanLength(password) <= most_password_bytes) then
                                case pepperedTag(password, asSpan(&salt), pepper) of
                                    when Some(value as computed: String) do
                                        if constantTimeEqual(asSpan(&computed), asSpan(&mac)) then
                                            answer := Matches();
                                        end if;
                                        destroyString(computed);
                                    when None do
                                        answer := Failed();
                                end case;
                            end if;
                        end if;
                        destroyString(mac);
                        destroyString(salt);
                        return answer;
                    when None do
                        destroyString(salt);
                        return Unreadable();
                end case;
            when None do
                case mac_bytes of
                    when Some(value as mac: String) do
                        destroyString(mac);
                    when None do
                        skip;
                end case;
                return Unreadable();
        end case;
    end;
end module body.
