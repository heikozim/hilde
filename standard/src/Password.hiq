-- A safe module: the salt comes from Standard.Libcrypto, the tag from
-- Bindings.Argon2, and the check of an old bcrypt hash from
-- Bindings.Bcrypt, which hold the work with addresses.
import Standard.String (
    String,
    destroyString,
    length,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Text (
    parseNat,
    substring,
    constantTimeEqual
);
import Standard.Base64 (
    encodeUnpadded,
    decodeUnpadded
);
import Standard.Libcrypto (
    randomBytes,
    hmacSha256
);
import Bindings.Argon2 (
    argon2id
);
import Bindings.Bcrypt (
    bcryptCheck
);

module body Standard.Password is
    -- The values of every new hash.  No caller sets them, so no caller
    -- can choose weaker ones.
    constant newMemory: Nat32 := 65536;
    constant newPasses: Nat32 := 3;
    constant newLanes: Nat32 := 4;
    constant newSaltSize: Index := 16;
    constant newTagSize: Index := 32;

    -- The bounds a stored hash is read within.  Argon2 takes far more; these
    -- keep a stored string from asking for more than a gibibyte of memory,
    -- or for a long time, on every check.
    constant mostMemory: Nat64 := 1048576;
    constant mostPasses: Nat64 := 16;
    constant mostLanes: Nat64 := 16;
    constant fewestSaltBytes: Index := 8;
    constant mostSaltBytes: Index := 64;
    constant fewestTagBytes: Index := 16;
    constant mostTagBytes: Index := 64;
    constant mostDigits: Index := 10;

    -- An old bcrypt hash is 60 bytes: the marker, two digits of cost, a
    -- dollar sign, then 53 bytes of salt and hash.  Each step of the cost
    -- doubles the work of a check; 4 is the least bcrypt takes, and a
    -- stored string asking for more than 16 is not computed.
    constant bcryptSize: Index := 60;
    constant fewestBcryptCost: Nat8 := 4;
    constant mostBcryptCost: Nat8 := 16;

    constant byteDollar: Nat8 := 36;
    constant byteDot: Nat8 := 46;
    constant byteSlash: Nat8 := 47;
    constant byteZero: Nat8 := 48;
    constant byteNine: Nat8 := 57;
    constant byteUpperA: Nat8 := 65;
    constant byteUpperZ: Nat8 := 90;
    constant byteLowerA: Nat8 := 97;
    constant byteLowerB: Nat8 := 98;
    constant byteLowerY: Nat8 := 121;
    constant byteLowerZ: Nat8 := 122;

    ---
    --- Writing a hash
    ---

    -- value in decimal digits, without a leading zero.
    generic [R: Region]
    function writeDecimal(builder: &![StringBuilder, R], value: Nat32): Unit is
        if value >= 10 then
            writeDecimal(&~builder, value / 10);
        end if;
        case toNat8(value - ((value / 10) * 10)) of
            when Some(value as digit: Nat8) do
                writeByte(&~builder, byteZero + digit);
            when None do
                skip;
        end case;
        return nil;
    end;

    generic [S: Region, T: Region]
    function phcString(salt: Span[Nat8, S], tag: Span[Nat8, T]): String is
        var builder: StringBuilder := makeStringBuilder();
        writeString(&!builder, "$argon2id$v=19$m=");
        writeDecimal(&!builder, newMemory);
        writeString(&!builder, ",t=");
        writeDecimal(&!builder, newPasses);
        writeString(&!builder, ",p=");
        writeDecimal(&!builder, newLanes);
        writeByte(&!builder, byteDollar);
        let saltText: String := encodeUnpadded(salt);
        writeString(&!builder, asSpan(&saltText));
        destroyString(saltText);
        writeByte(&!builder, byteDollar);
        let tagText: String := encodeUnpadded(tag);
        writeString(&!builder, asSpan(&tagText));
        destroyString(tagText);
        return finalize(builder);
    end;

    generic [R: Region]
    function hashPassword(password: Span[Nat8, R]): Option[String] is
        let salt: String := randomBytes(newSaltSize)?;
        case argon2id(password, asSpan(&salt), newPasses, newMemory, newLanes, newTagSize) of
            when Some(value as tag: String) do
                let made: String := phcString(asSpan(&salt), asSpan(&tag));
                destroyString(tag);
                destroyString(salt);
                return Some(value => made);
            when None do
                destroyString(salt);
                return None();
        end case;
    end;

    ---
    --- Reading a hash
    ---

    -- Whether text holds literal from at on.
    generic [R: Region]
    function literalAt(text: Span[Nat8, R], at: Index, literal: Span[Nat8, Static]): Bool is
        let size: Index := spanLength(text);
        let want: Index := spanLength(literal);
        if at > size then
            return false;
        end if;
        if (size - at) < want then
            return false;
        end if;
        var i: Index := 0;
        var same: Bool := true;
        while same and (i < want) do
            same := text[at + i] = literal[i];
            i := i + 1;
        end while;
        return same;
    end;

    -- The first place from start on that is not a digit, or the length.
    generic [R: Region]
    function digitsEnd(text: Span[Nat8, R], start: Index): Index is
        let size: Index := spanLength(text);
        var i: Index := start;
        var going: Bool := i < size;
        while going do
            let byte: Nat8 := text[i];
            if (byte >= byteZero) and (byte <= byteNine) then
                i := i + 1;
                going := i < size;
            else
                going := false;
            end if;
        end while;
        return i;
    end;

    -- The first place from start on that holds byte, or the length.
    generic [R: Region]
    function nextByte(text: Span[Nat8, R], start: Index, byte: Nat8): Index is
        let size: Index := spanLength(text);
        var i: Index := start;
        var going: Bool := i < size;
        while going do
            if text[i] = byte then
                going := false;
            else
                i := i + 1;
                going := i < size;
            end if;
        end while;
        return i;
    end;

    -- The number the digits from start up to final stand for, or 0 for a
    -- form a stored hash does not have: no digit, a leading zero, more
    -- digits than any bound needs.  Every value read is at least 1, so 0
    -- is never a value.
    generic [R: Region]
    function numberIn(text: Span[Nat8, R], start: Index, final: Index): Nat64 is
        if final <= start then
            return 0;
        end if;
        if (final - start) > mostDigits then
            return 0;
        end if;
        if text[start] = byteZero then
            return 0;
        end if;
        let found: Option[Nat64] := parseNat(substring(text, start, final));
        case found of
            when Some(value as number: Nat64) do
                return number;
            when None do
                return 0;
        end case;
    end;

    function nat32Of(value: Nat64): Nat32 is
        case toNat32(value) of
            when Some(value as small: Nat32) do
                return small;
            when None do
                return 0;
        end case;
    end;

    -- The check itself, once the string is read: the tag of password with
    -- the stored salt and values, compared with the stored tag in constant
    -- time.
    generic [P: Region, S: Region, T: Region]
    function compareTag(password: Span[Nat8, P], salt: Span[Nat8, S], tag: Span[Nat8, T], memory: Nat64, passes: Nat64, lanes: Nat64): PasswordCheck is
        case argon2id(password, salt, nat32Of(passes), nat32Of(memory), nat32Of(lanes), spanLength(tag)) of
            when Some(value as computed: String) do
                let same: Bool := constantTimeEqual(asSpan(&computed), tag);
                destroyString(computed);
                if same then
                    return Matches();
                else
                    return DoesNotMatch();
                end if;
            when None do
                return Failed();
        end case;
    end;

    ---
    --- Reading an old bcrypt hash
    ---

    -- Whether stored begins with one of the three markers of bcrypt read
    -- here: 2a, 2b and 2y.
    generic [R: Region]
    function isBcrypt(stored: Span[Nat8, R]): Bool is
        if literalAt(stored, 0, "$2a$") then
            return true;
        end if;
        if literalAt(stored, 0, "$2b$") then
            return true;
        end if;
        return literalAt(stored, 0, "$2y$");
    end;

    function isDigit(byte: Nat8): Bool is
        return (byte >= byteZero) and (byte <= byteNine);
    end;

    -- Whether byte is in the alphabet of bcrypt's salt and hash: the dot,
    -- the slash, the capitals, the small letters and the digits.
    function isBcryptByte(byte: Nat8): Bool is
        if (byte = byteDot) or (byte = byteSlash) then
            return true;
        end if;
        if (byte >= byteUpperA) and (byte <= byteUpperZ) then
            return true;
        end if;
        if (byte >= byteLowerA) and (byte <= byteLowerZ) then
            return true;
        end if;
        return isDigit(byte);
    end;

    -- The stored string as the library takes it.  A hash marked 2y is
    -- computed exactly as one marked 2b, and not every system's library
    -- reads the first marker, so it is handed over as the second.
    generic [R: Region]
    function libraryForm(stored: Span[Nat8, R]): String is
        var builder: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(stored);
        var i: Index := 0;
        while i < size do
            if (i = 2) and (stored[i] = byteLowerY) then
                writeByte(&!builder, byteLowerB);
            else
                writeByte(&!builder, stored[i]);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    -- An old bcrypt hash, read strictly before the library sees it: 60
    -- bytes, a cost of two digits within the bounds above, a dollar sign
    -- after it, and 53 bytes of the alphabet.  A match asks the caller to
    -- store a new hash.
    generic [P: Region, S: Region]
    function checkBcrypt(password: Span[Nat8, P], stored: Span[Nat8, S]): PasswordCheck is
        if spanLength(stored) /= bcryptSize then
            return Unreadable();
        end if;
        let tens: Nat8 := stored[4];
        let ones: Nat8 := stored[5];
        if not (isDigit(tens) and isDigit(ones)) then
            return Unreadable();
        end if;
        let cost: Nat8 := ((tens - byteZero) * 10) + (ones - byteZero);
        if (cost < fewestBcryptCost) or (cost > mostBcryptCost) then
            return Unreadable();
        end if;
        if stored[6] /= byteDollar then
            return Unreadable();
        end if;
        var i: Index := 7;
        var inAlphabet: Bool := true;
        while inAlphabet and (i < bcryptSize) do
            inAlphabet := isBcryptByte(stored[i]);
            i := i + 1;
        end while;
        if not inAlphabet then
            return Unreadable();
        end if;
        let given: String := libraryForm(stored);
        let answer: Int32 := bcryptCheck(password, asSpan(&given));
        destroyString(given);
        if answer = 1 then
            return MatchesStoreAgain();
        end if;
        if answer = 0 then
            return DoesNotMatch();
        end if;
        return Failed();
    end;

    ---
    --- Checking a password
    ---

    generic [P: Region, S: Region]
    function checkPassword(password: Span[Nat8, P], stored: Span[Nat8, S]): PasswordCheck is
        if isBcrypt(stored) then
            return checkBcrypt(password, stored);
        end if;
        let size: Index := spanLength(stored);
        let prefix: Span[Nat8, Static] := "$argon2id$v=19$m=";
        if not literalAt(stored, 0, prefix) then
            return Unreadable();
        end if;
        let memoryStart: Index := spanLength(prefix);
        let memoryEnd: Index := digitsEnd(stored, memoryStart);
        let memory: Nat64 := numberIn(stored, memoryStart, memoryEnd);
        if not literalAt(stored, memoryEnd, ",t=") then
            return Unreadable();
        end if;
        let passesStart: Index := memoryEnd + 3;
        let passesEnd: Index := digitsEnd(stored, passesStart);
        let passes: Nat64 := numberIn(stored, passesStart, passesEnd);
        if not literalAt(stored, passesEnd, ",p=") then
            return Unreadable();
        end if;
        let lanesStart: Index := passesEnd + 3;
        let lanesEnd: Index := digitsEnd(stored, lanesStart);
        let lanes: Nat64 := numberIn(stored, lanesStart, lanesEnd);
        if not literalAt(stored, lanesEnd, "$") then
            return Unreadable();
        end if;
        if (passes = 0) or (passes > mostPasses) then
            return Unreadable();
        end if;
        if (lanes = 0) or (lanes > mostLanes) then
            return Unreadable();
        end if;
        if (memory < (lanes * 8)) or (memory > mostMemory) then
            return Unreadable();
        end if;
        let saltStart: Index := lanesEnd + 1;
        let saltEnd: Index := nextByte(stored, saltStart, byteDollar);
        if saltEnd >= size then
            return Unreadable();
        end if;
        let tagStart: Index := saltEnd + 1;
        if nextByte(stored, tagStart, byteDollar) /= size then
            return Unreadable();
        end if;
        let saltBytes: Option[String] := decodeUnpadded(substring(stored, saltStart, saltEnd));
        let tagBytes: Option[String] := decodeUnpadded(substring(stored, tagStart, size));
        case saltBytes of
            when Some(value as salt: String) do
                case tagBytes of
                    when Some(value as tag: String) do
                        let saltSize: Index := length(&salt);
                        let tagSize: Index := length(&tag);
                        var answer: PasswordCheck := Unreadable();
                        if ((saltSize >= fewestSaltBytes) and (saltSize <= mostSaltBytes)) and ((tagSize >= fewestTagBytes) and (tagSize <= mostTagBytes)) then
                            answer := compareTag(password, asSpan(&salt), asSpan(&tag), memory, passes, lanes);
                        end if;
                        destroyString(tag);
                        destroyString(salt);
                        return answer;
                    when None do
                        destroyString(salt);
                        return Unreadable();
                end case;
            when None do
                case tagBytes of
                    when Some(value as tag: String) do
                        destroyString(tag);
                    when None do
                        skip;
                end case;
                return Unreadable();
        end case;
    end;

    ---
    --- Peppered hashes
    ---

    -- The fixed beginning of a peppered hash: the values of every new hash,
    -- the only ones a peppered hash is read with.
    constant pepperedPrefix: Span[Nat8, Static] := "$argon2id-hmac$v=19$m=65536,t=3,p=4$";
    constant fewestPepperBytes: Index := 32;
    constant mostPasswordBytes: Index := 128;
    constant macSize: Index := 32;

    -- The HMAC-SHA256 under pepper of the Argon2id tag of password and salt.
    generic [P: Region, S: Region, Q: Region]
    function pepperedTag(password: Span[Nat8, P], salt: Span[Nat8, S], pepper: Span[Nat8, Q]): Option[String] is
        case argon2id(password, salt, newPasses, newMemory, newLanes, newTagSize) of
            when Some(value as tag: String) do
                let mac: Option[String] := hmacSha256(pepper, asSpan(&tag));
                destroyString(tag);
                return mac;
            when None do
                return None();
        end case;
    end;

    generic [P: Region, Q: Region]
    function hashPepperedPassword(password: Span[Nat8, P], pepper: Span[Nat8, Q]): Option[String] is
        if spanLength(pepper) < fewestPepperBytes then
            return None();
        end if;
        if (spanLength(password) = 0) or (spanLength(password) > mostPasswordBytes) then
            return None();
        end if;
        let salt: String := randomBytes(newSaltSize)?;
        case pepperedTag(password, asSpan(&salt), pepper) of
            when Some(value as mac: String) do
                var builder: StringBuilder := makeStringBuilder();
                writeString(&!builder, pepperedPrefix);
                let saltText: String := encodeUnpadded(asSpan(&salt));
                writeString(&!builder, asSpan(&saltText));
                destroyString(saltText);
                writeByte(&!builder, byteDollar);
                let macText: String := encodeUnpadded(asSpan(&mac));
                writeString(&!builder, asSpan(&macText));
                destroyString(macText);
                destroyString(mac);
                destroyString(salt);
                return Some(value => finalize(builder));
            when None do
                destroyString(salt);
                return None();
        end case;
    end;

    generic [P: Region, S: Region, Q: Region]
    function checkPepperedPassword(password: Span[Nat8, P], stored: Span[Nat8, S], pepper: Span[Nat8, Q]): PasswordCheck is
        if spanLength(pepper) < fewestPepperBytes then
            return Failed();
        end if;
        if not literalAt(stored, 0, pepperedPrefix) then
            return Unreadable();
        end if;
        let size: Index := spanLength(stored);
        let saltStart: Index := spanLength(pepperedPrefix);
        let saltEnd: Index := nextByte(stored, saltStart, byteDollar);
        if saltEnd >= size then
            return Unreadable();
        end if;
        let macStart: Index := saltEnd + 1;
        if nextByte(stored, macStart, byteDollar) /= size then
            return Unreadable();
        end if;
        let saltBytes: Option[String] := decodeUnpadded(substring(stored, saltStart, saltEnd));
        let macBytes: Option[String] := decodeUnpadded(substring(stored, macStart, size));
        case saltBytes of
            when Some(value as salt: String) do
                case macBytes of
                    when Some(value as mac: String) do
                        var answer: PasswordCheck := Unreadable();
                        if (length(&salt) = newSaltSize) and (length(&mac) = macSize) then
                            answer := DoesNotMatch();
                            if (spanLength(password) > 0) and (spanLength(password) <= mostPasswordBytes) then
                                case pepperedTag(password, asSpan(&salt), pepper) of
                                    when Some(value as computed: String) do
                                        if constantTimeEqual(asSpan(&computed), asSpan(&mac)) then
                                            answer := Matches();
                                        end if;
                                        destroyString(computed);
                                    when None do
                                        answer := Failed();
                                end case;
                            end if;
                        end if;
                        destroyString(mac);
                        destroyString(salt);
                        return answer;
                    when None do
                        destroyString(salt);
                        return Unreadable();
                end case;
            when None do
                case macBytes of
                    when Some(value as mac: String) do
                        destroyString(mac);
                    when None do
                        skip;
                end case;
                return Unreadable();
        end case;
    end;
end module body.
