--
-- Tests for Standard.Path.
--
-- The module is pure text, so every case here is a literal in and a literal
-- out, and the interesting ones are the edges rather than the middle:
-- .. as a component against .. as a substring, a trailing separator, a
-- name that is only a dot, and the root, which is the one path whose
-- directory is not shorter than itself.
--
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.Path (
    isAbsolute,
    hasParentComponent,
    baseName,
    directoryName,
    extension,
    joinPath
);

module body Standard.Path.Test is
    ---
    --- Helpers
    ---

    generic [R: Region, S: Region]
    function sameText(left: &[String, R], right: &[String, S]): Bool is
        let size: Index := length(left);
        if size /= length(right) then
            return false;
        end if;
        if size = 0 then
            return true;
        end if;
        var same: Bool := true;
        for i from 0 to size - 1 do
            if nthByte(left, i) /= nthByte(right, i) then
                same := false;
            end if;
        end for;
        return same;
    end;

    -- Is produced -- which this function consumes -- the same text as the
    -- literal wanted?
    function producedIs(produced: String, wanted: Span[Nat8, Static]): Bool is
        var got: String := produced;
        var expected: String := fromLiteral(wanted);
        let same: Bool := sameText(&got, &expected);
        destroyString(got);
        destroyString(expected);
        return same;
    end;

    function absoluteOf(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := isAbsolute(asSpan(&path));
        destroyString(path);
        return answer;
    end;

    function parentIn(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := hasParentComponent(asSpan(&path));
        destroyString(path);
        return answer;
    end;

    function baseOf(text: Span[Nat8, Static], wanted: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := producedIs(baseName(asSpan(&path)), wanted);
        destroyString(path);
        return answer;
    end;

    function directoryOf(text: Span[Nat8, Static],
        wanted: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := producedIs(directoryName(asSpan(&path)), wanted);
        destroyString(path);
        return answer;
    end;

    function extensionOf(text: Span[Nat8, Static],
        wanted: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        var answer: Bool := false;
        case extension(asSpan(&path)) of
            when Some(value as ext: String) do
                answer := producedIs(ext, wanted);
            when None do
                answer := false;
        end case;
        destroyString(path);
        return answer;
    end;

    function noExtensionIn(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        var answer: Bool := false;
        case extension(asSpan(&path)) of
            when Some(value as ext: String) do
                var taken: String := ext;
                destroyString(taken);
                answer := false;
            when None do
                answer := true;
        end case;
        destroyString(path);
        return answer;
    end;

    function joinIs(leftText: Span[Nat8, Static], rightText: Span[Nat8, Static],
        wanted: Span[Nat8, Static]): Bool is
        var left: String := fromLiteral(leftText);
        var right: String := fromLiteral(rightText);
        let answer: Bool := producedIs(joinPath(asSpan(&left), asSpan(&right)), wanted);
        destroyString(left);
        destroyString(right);
        return answer;
    end;

    ---
    --- The cases
    ---

    -- absolute and relative.
    function testAbsolute(): Unit is
        assertTrue(absoluteOf("/"), "the root is absolute");
        assertTrue(absoluteOf("/a/b"), "a leading separator is absolute");
        assertFalse(absoluteOf("a/b"), "no leading separator is relative");
        assertFalse(absoluteOf(""),
            "the empty path is not absolute, it is not anything");
        return nil;
    end;

    -- The two points .. as a component, not as a substring.
    function testParentComponent(): Unit is
        -- The four that must be found.
        assertTrue(parentIn(".."), "the path that is only `..'");
        assertTrue(parentIn("../a"), "at the start");
        assertTrue(parentIn("a/.."), "at the end, which the loop alone misses");
        assertTrue(parentIn("a/../b"), "in the middle");
        assertTrue(parentIn("/../a"), "after a leading separator");
        -- The five that must not be, and they are the point of the
        -- function: a substring search would answer true to every one.
        assertFalse(parentIn("..foo"), "a name that begins with two dots");
        assertFalse(parentIn("a..b"), "two dots inside a name");
        assertFalse(parentIn("foo.."), "a name that ends with two dots");
        assertFalse(parentIn("a/...b"), "three dots are not two");
        assertFalse(parentIn("."), "one dot is not two");
        assertFalse(parentIn("a/b"), "an ordinary path");
        assertFalse(parentIn(""), "the empty path");
        return nil;
    end;

    -- base and directory.
    function testBaseAndDirectory(): Unit is
        assertTrue(baseOf("a/b", "b"), "the base of a/b");
        assertTrue(baseOf("b", "b"), "a path with no separator is its own base");
        assertTrue(baseOf("a/b/", ""),
            "a trailing separator gives an empty base");
        assertTrue(baseOf("/a", "a"), "the base under the root");
        assertTrue(directoryOf("a/b", "a"), "the directory of a/b");
        assertTrue(directoryOf("/a", "/"),
            "the directory under the root is the root, one byte long");
        assertTrue(directoryOf("b", ""),
            "no separator gives an empty directory, not a dot");
        assertTrue(directoryOf("a/b/c", "a/b"), "two levels");
        return nil;
    end;

    -- extension.
    function testExtension(): Unit is
        assertTrue(extensionOf("a/b.txt", "txt"), "the ordinary case");
        assertTrue(extensionOf("b.tar.gz", "gz"),
            "the LAST dot, so a double suffix gives the last part");
        assertTrue(noExtensionIn("a/b"), "no dot, no extension");
        assertTrue(noExtensionIn(".bashrc"),
            "a leading dot is a name and not an extension");
        assertTrue(noExtensionIn("a."), "a trailing dot has nothing after it");
        assertTrue(noExtensionIn("a.b/c"),
            "the dot is in the DIRECTORY, not in the name");
        assertTrue(noExtensionIn(""), "the empty path");
        return nil;
    end;

    -- join.
    function testJoin(): Unit is
        assertTrue(joinIs("a", "b", "a/b"), "one separator goes between them");
        assertTrue(joinIs("a/", "b", "a/b"),
            "a left side that already ends in one does not get a second");
        assertTrue(joinIs("", "b", "b"), "an empty left side gives the right");
        assertTrue(joinIs("a", "/b", "/b"),
            "an absolute right side wins on its own");
        assertTrue(joinIs("/", "b", "/b"), "under the root");
        assertTrue(joinIs("a", "", "a/"),
            "an empty right side still gets its separator");
        return nil;
    end;
end module body.
