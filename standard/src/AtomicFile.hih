"""
Writing a file so that whoever opens it finds the old content or the new, never a part.

- The content goes to a temporary file beside it, is synced, and is renamed over the old file.
- The directory is synced after the rename, so that the rename survives a crash.
- A replaced file keeps its owner and group; when they cannot be given, nothing is replaced.
- The file gets exactly the mode given; the umask does not change it.
- Only an ordinary file is replaced; a symbolic link is neither followed nor overwritten.
- A backup is a hard link to the old file, named with .bak, so it keeps owner, mode and times.
- The directory must allow hard links for a backup.

    let mode: Nat32 := 420;
    let written: Either[AtomicFailure, Bool] := writeWithBackup("app.conf", asSpan(&text), mode);
    let change: Either[AtomicFailure, Change] := writeIfChanged("app.conf", asSpan(&text), mode);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.AtomicFile is
    """
    Why a file was not written.  After every failure but NotDurable the
    file at the path is as it was, and no temporary file is left.
    """
    union AtomicFailure: Free is
        """
        The path is empty, holds a zero byte or ends in a slash, or the
        mode is beyond octal 7777.
        """
        case BadInput;
        """
        Something other than an ordinary file is at the path, or at its
        backup's name.
        """
        case NotAFile;
        """
        The path could not be looked at, or the file there could not be
        read.
        """
        case LookFailed;
        """
        No temporary file could be made in the directory.
        """
        case TemporaryFailed;
        """
        Writing, syncing or closing the temporary file failed.
        """
        case WriteFailed;
        """
        The owner and group of the file being replaced could not be given
        to the new one, which needs privilege when they are not the
        writer's.
        """
        case OwnerFailed;
        """
        The mode could not be set.
        """
        case ModeFailed;
        """
        The old file could not be linked to its backup's name.
        """
        case BackupFailed;
        """
        The temporary file could not be renamed over the path.
        """
        case RenameFailed;
        """
        The new file is in place, but its directory could not be synced:
        after a crash the old one may be back.
        """
        case NotDurable;
    end;

    """
    A word for the failure, for a message a person reads.
    No contract: a text whose length follows its input.
    """
    function describeAtomicFailure(failure: AtomicFailure): String;

    """
    The name of the backup of path: path with .bak after it.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function backupName(path: Span[Nat8, R]): String;

    """
    Writes content to the file at path with the permission bits mode,
    replacing a file that is there in one step.  Right when the file is in
    place and its directory synced.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function writeAtomically(path: Span[Nat8, R], content: Span[Nat8, S], mode: Nat32): Either[AtomicFailure, Unit];

    """
    As writeAtomically, and before a file is replaced it is kept as the
    backup, which replaces an older backup.  Right true when there was a
    file to keep, false when the file is new.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function writeWithBackup(path: Span[Nat8, R], content: Span[Nat8, S], mode: Nat32): Either[AtomicFailure, Bool];

    """
    What writeIfChanged did.
    """
    union Change: Free is
        """
        The file had the content and the mode already, and was not
        written.
        """
        case Unchanged;
        """
        There was no file, and it was written.
        """
        case Created;
        """
        The file was replaced, and the old one kept as the backup.
        """
        case Replaced;
    end;

    """
    Writes as writeWithBackup, but only when the file at path does not
    have content and mode already.  The old file is read only when its size
    is that of content.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function writeIfChanged(path: Span[Nat8, R], content: Span[Nat8, S], mode: Nat32): Either[AtomicFailure, Change];

    """
    Puts the backup back at path in one step, with rename(2); the backup's
    name is gone afterwards.  Right true when there was a backup, false
    when there was none and nothing changed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function restoreBackup(path: Span[Nat8, R]): Either[AtomicFailure, Bool];
end module.
