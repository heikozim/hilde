-- A safe module over Bindings.Account.
import Bindings.Account (
    accountNumber,
    effectiveUser
);

module body Standard.Account is
    -- A number of the runtime as Nat32: -1 and -2 are the answers without
    -- one, and every number the system gives fits.
    function asNumber(value: Int64): Option[Nat32] is
        if value < 0 then
            return None();
        end if;
        return toNat32(value);
    end;

    generic [R: Region]
    function lookupAccount(name: Span[Nat8, R]): AccountLookup is
        let user: Int64 := accountNumber(name, false);
        if user = -2 then
            return LookupFailed();
        end if;
        let group: Int64 := accountNumber(name, true);
        if group = -2 then
            return LookupFailed();
        end if;
        case asNumber(user) of
            when Some(value as u: Nat32) do
                case asNumber(group) of
                    when Some(value as g: Nat32) do
                        return AccountFound(numbers => AccountNumbers(user => u, group => g));
                    when None do
                        return NoAccount();
                end case;
            when None do
                return NoAccount();
        end case;
    end;

    function runningUser(): Nat32 is
        return effectiveUser();
    end;

    function isSuperuser(): Bool is
        return effectiveUser() = 0;
    end;
end module body.
