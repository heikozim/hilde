"""
The server side of htmx: its requests told apart, its response headers written, its script served.

- A request is htmx's when its HX-Request header is the four bytes true, and no other value.
- An answer that depends on HX-Request says so with Vary: HX-Request.
- HX-Redirect takes a field value, and HX-Trigger an event name; anything else stops the programme.
- The header lines come out in the form FcgiServer.cgiResponseWith takes.
- The script is read from a file of at most scriptLimit bytes; a missing or larger file gives 404 or 500.

    if isHtmxRequest(asSpan(&hxRequest)) then
        let line: String := redirectHeader("/done");
        let answer: String := htmlResponse(200, asSpan(&line), "");
    end if;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);
import Standard.FcgiServer (
    isFieldValue,
    isHeaderBlock
);

module Standard.Htmx is
    """
    The name of the CGI variable a web server gives the HX-Request header
    as, HTTP_HX_REQUEST, for FcgiServer.requestParam.
    """
    function requestVariable(): Span[Nat8, Static]
        ensures spanLength(result) = 15;

    """
    Whether hxRequest, the value of the HX-Request header or the empty
    span when the request had none, marks a request of htmx: true for the
    four bytes true, false for every other value, True and 1 among them.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isHtmxRequest(hxRequest: Span[Nat8, R]): Bool;

    """
    Whether name may stand as an event of HX-Trigger: 1 to 128 bytes, each
    a letter, a digit or one of - _ : . so that it is neither a list nor
    JSON and cannot end the line.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isEventName(name: Span[Nat8, R]): Bool;

    """
    The header line HX-Redirect: url, with its line end: htmx then loads
    url as a whole page.  url must be a field value that is not empty.
    """
    generic [R: Region]
    function redirectHeader(url: Span[Nat8, R]): String
        requires (spanLength(url) > 0) and isFieldValue(url);

    """
    The header line HX-Trigger: event, with its line end: htmx then fires
    event on the element that made the request.  event must pass
    isEventName.
    """
    generic [R: Region]
    function triggerHeader(event: Span[Nat8, R]): String
        requires isEventName(event);

    """
    The header line Vary: HX-Request, with its line end, for an answer that
    is a fragment for htmx and a whole page otherwise, so that no cache
    gives the one for the other.
    """
    function varyHeader(): Span[Nat8, Static]
        ensures isHeaderBlock(result);

    """
    The CGI output of an HTML answer: the status, Content-Type text/html
    with charset utf-8, Vary: HX-Request, the lines of headers, an empty
    line and content.  headers must pass FcgiServer.isHeaderBlock; the empty
    span adds none.
    """
    generic [H: Region, B: Region]
    function htmlResponse(status: Nat16, headers: Span[Nat8, H], content: Span[Nat8, B]): String
        requires isHeaderBlock(headers);

    """
    The most bytes scriptResponse serves from its file: 1048576, one
    mebibyte.
    """
    function scriptLimit(): Index
        ensures result = 1048576;

    """
    The CGI output that serves the JavaScript file at path, such as
    htmx.min.js: 200 with Content-Type text/javascript, charset utf-8, and
    Cache-Control: public, max-age=86400.  404 with an empty body when the
    file cannot be opened or read, 500 when it holds more than scriptLimit
    bytes.  path names a file of the server, never one from the request.
    """
    generic [R: Region]
    function scriptResponse(path: Span[Nat8, R]): String
        requires spanLength(path) > 0;
end module.
