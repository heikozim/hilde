-- A safe module.  Bindings.MariaDB does the work with addresses and C;
-- its handles are wrapped here, one record each, and the mode of a
-- connection, Writing or Reading, is checked by the types of this module.
import Standard.String (
    String
);
import Bindings.MariaDB (
    libraryVersion as bindLibraryVersion,
    Connection as Handle,
    Transaction as BindTransaction,
    Values as BindValues,
    Cursor as BindCursor,
    MariaError as BindError,
    connectionFailed as bindConnectionFailed,
    newerDatabase as bindNewerDatabase,
    tooLarge as bindTooLarge,
    connectionLost as bindConnectionLost,
    alreadyInTransaction as bindAlreadyInTransaction,
    connect,
    closeDatabase as bindCloseDatabase,
    lastMessage as bindLastMessage,
    usesTls as bindUsesTls,
    migrate as bindMigrate,
    begin as bindBegin,
    commit as bindCommit,
    rollback as bindRollback,
    copyText as bindCopyText,
    noValues as bindNoValues,
    withInt64 as bindWithInt64,
    withFloat64 as bindWithFloat64,
    withBool as bindWithBool,
    withTimestamp as bindWithTimestamp,
    withText as bindWithText,
    withBytes as bindWithBytes,
    withNull as bindWithNull,
    dropValues as bindDropValues,
    valueCount as bindValueCount,
    start as bindStart,
    execute as bindExecute,
    advance as bindAdvance,
    columnCount as bindColumnCount,
    isNullColumn as bindIsNullColumn,
    columnInt64 as bindColumnInt64,
    columnFloat64 as bindColumnFloat64,
    columnBool as bindColumnBool,
    columnTimestamp as bindColumnTimestamp,
    columnText as bindColumnText,
    columnBytes as bindColumnBytes,
    finish as bindFinish
);

module body Standard.MariaDB is
    record Connection[M: Free]: Linear is
        handle: Handle;
        mode: M;
    end;

    record Transaction: Linear is
        inner: BindTransaction;
    end;

    record Values: Linear is
        inner: BindValues;
    end;

    record Cursor: Linear is
        inner: BindCursor;
    end;

    constant connectionFailed: Int32 := bindConnectionFailed;
    constant newerDatabase: Int32 := bindNewerDatabase;
    constant tooLarge: Int32 := bindTooLarge;
    constant connectionLost: Int32 := bindConnectionLost;
    constant alreadyInTransaction: Int32 := bindAlreadyInTransaction;

    -- The error numbers of MariaDB this module names.
    constant duplicateEntry: Int32 := 1062;
    constant duplicateEntryWithKeyName: Int32 := 1586;
    constant badNull: Int32 := 1048;
    constant rowIsReferenced: Int32 := 1451;
    constant noReferencedRow: Int32 := 1452;
    constant checkFailed: Int32 := 4025;
    constant deadlock: Int32 := 1213;
    constant lockWaitTimeout: Int32 := 1205;
    constant accessDenied: Int32 := 1045;
    constant readOnlyTransaction: Int32 := 1792;
    constant noSuchTable: Int32 := 1146;
    constant parseError: Int32 := 1064;

    function errorOf(error: BindError): MariaError is
        return MariaError(code => error.code);
    end;

    function isUniqueViolation(error: MariaError): Bool is
        return (error.code = duplicateEntry) or (error.code = duplicateEntryWithKeyName);
    end;

    function isConstraintViolation(error: MariaError): Bool is
        let references: Bool := (error.code = rowIsReferenced) or (error.code = noReferencedRow);
        let other: Bool := (error.code = badNull) or (error.code = checkFailed);
        return isUniqueViolation(error) or (references or other);
    end;

    function isBusy(error: MariaError): Bool is
        return (error.code = deadlock) or (error.code = lockWaitTimeout);
    end;

    function describe(error: MariaError): Span[Nat8, Static] is
        let code: Int32 := error.code;
        if code = connectionFailed then
            return "the connection to the server could not be made";
        else if code = newerDatabase then
            return "the database has more migrations than this programme knows";
        else if code = tooLarge then
            return "a value of 2 GiB or more";
        else if code = connectionLost then
            return "the server gave no answer";
        else if code = alreadyInTransaction then
            return "a transaction is open on this connection already";
        else if isUniqueViolation(error) then
            return "a unique key was violated";
        else if code = badNull then
            return "a not null column was given null";
        else if (code = rowIsReferenced) or (code = noReferencedRow) then
            return "a foreign key constraint was violated";
        else if code = checkFailed then
            return "a check constraint was violated";
        else if code = deadlock then
            return "a deadlock was detected";
        else if code = lockWaitTimeout then
            return "a lock was not available in time";
        else if code = accessDenied then
            return "the password was wrong";
        else if code = readOnlyTransaction then
            return "a write in a read only transaction";
        else if code = noSuchTable then
            return "the table does not exist";
        else if code = parseError then
            return "the statement is not valid SQL";
        end if;
        return "the server refused the statement";
    end;

    ---
    --- Opening and closing
    ---

    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function openWriter(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F]): Either[MariaError, Connection[Writing]] is
        case connect(host, port, database, user, password, caFile, false) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as handle: Handle) do
                return Right(right => Connection(handle => handle, mode => Writing()));
        end case;
    end;

    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function openReader(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F]): Either[MariaError, Connection[Reading]] is
        case connect(host, port, database, user, password, caFile, true) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as handle: Handle) do
                return Right(right => Connection(handle => handle, mode => Reading()));
        end case;
    end;

    generic [M: Free]
    function closeDatabase(db: Connection[M]): Unit is
        let { handle: Handle, mode: M } := db;
        bindCloseDatabase(handle);
        return nil;
    end;

    generic [M: Free, R: Region]
    function lastMessage(db: &[Connection[M], R]): String is
        return bindLastMessage(&(db->handle));
    end;

    generic [M: Free, R: Region]
    function usesTls(db: &[Connection[M], R]): Bool is
        return bindUsesTls(&(db->handle));
    end;

    generic [R: Region]
    function migrate(db: &![Connection[Writing], R], migrations: Span[Nat8, Static]): Either[MariaError, Index] is
        case bindMigrate(&!(db->handle), migrations) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as count: Index) do
                return Right(right => count);
        end case;
    end;

    ---
    --- Transactions
    ---

    generic [M: Free, R: Region]
    function begin(db: &![Connection[M], R]): Either[MariaError, Transaction] is
        case bindBegin(&!(db->handle)) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as inner: BindTransaction) do
                return Right(right => Transaction(inner => inner));
        end case;
    end;

    generic [M: Free, R: Region]
    function commit(db: &![Connection[M], R], transaction: Transaction): Either[MariaError, Unit] is
        let { inner: BindTransaction } := transaction;
        case bindCommit(&!(db->handle), inner) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as done: Unit) do
                return Right(right => nil);
        end case;
    end;

    generic [M: Free, R: Region]
    function rollback(db: &![Connection[M], R], transaction: Transaction): Unit is
        let { inner: BindTransaction } := transaction;
        bindRollback(&!(db->handle), inner);
        return nil;
    end;

    generic [R: Region]
    function copyText(text: Span[Nat8, R]): String is
        return bindCopyText(text);
    end;

    ---
    --- Values
    ---

    function noValues(): Values is
        return Values(inner => bindNoValues());
    end;

    function withInt64(values: Values, value: Int64): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithInt64(inner, value));
    end;

    function withFloat64(values: Values, value: Float64): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithFloat64(inner, value));
    end;

    function withBool(values: Values, value: Bool): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithBool(inner, value));
    end;

    function withTimestamp(values: Values, value: Int64): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithTimestamp(inner, value));
    end;

    generic [R: Region]
    function withText(values: Values, value: Span[Nat8, R]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithText(inner, value));
    end;

    generic [R: Region]
    function withBytes(values: Values, value: Span[Nat8, R]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithBytes(inner, value));
    end;

    function withNull(values: Values): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithNull(inner));
    end;

    function dropValues(values: Values): Unit is
        let { inner: BindValues } := values;
        bindDropValues(inner);
        return nil;
    end;

    function withInt64OrNull(values: Values, value: Option[Int64]): Values is
        case value of
            when Some(value as v: Int64) do
                return withInt64(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    function withFloat64OrNull(values: Values, value: Option[Float64]): Values is
        case value of
            when Some(value as v: Float64) do
                return withFloat64(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    function withBoolOrNull(values: Values, value: Option[Bool]): Values is
        case value of
            when Some(value as v: Bool) do
                return withBool(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    function withTimestampOrNull(values: Values, value: Option[Int64]): Values is
        case value of
            when Some(value as v: Int64) do
                return withTimestamp(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    generic [R: Region]
    function withTextOrNull(values: Values, value: Option[Span[Nat8, R]]): Values is
        case value of
            when Some(value as v: Span[Nat8, R]) do
                return withText(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    generic [R: Region]
    function withBytesOrNull(values: Values, value: Option[Span[Nat8, R]]): Values is
        case value of
            when Some(value as v: Span[Nat8, R]) do
                return withBytes(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    generic [R: Region]
    function valueCount(values: &[Values, R]): Index is
        return bindValueCount(&(values->inner));
    end;

    ---
    --- Statements
    ---

    generic [M: Free, R: Region, S: Region]
    function start(db: &![Connection[M], R], sql: Span[Nat8, S], values: Values): Cursor is
        let { inner: BindValues } := values;
        return Cursor(inner => bindStart(&!(db->handle), sql, inner));
    end;

    generic [R: Region, S: Region]
    function startWrite(db: &![Connection[Writing], R], sql: Span[Nat8, S], values: Values): Cursor is
        let { inner: BindValues } := values;
        return Cursor(inner => bindStart(&!(db->handle), sql, inner));
    end;

    generic [R: Region, S: Region]
    function execute(db: &![Connection[Writing], R], sql: Span[Nat8, S], values: Values): Either[MariaError, Nat64] is
        let { inner: BindValues } := values;
        case bindExecute(&!(db->handle), sql, inner) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as count: Nat64) do
                return Right(right => count);
        end case;
    end;

    generic [R: Region]
    function advance(cursor: &![Cursor, R]): Bool is
        return bindAdvance(&!(cursor->inner));
    end;

    generic [R: Region]
    function columnCount(cursor: &[Cursor, R]): Int32 is
        return bindColumnCount(&(cursor->inner));
    end;

    generic [R: Region]
    function columnInt64(cursor: &[Cursor, R], index: Int32): Int64 is
        return bindColumnInt64(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnFloat64(cursor: &[Cursor, R], index: Int32): Float64 is
        return bindColumnFloat64(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnBool(cursor: &[Cursor, R], index: Int32): Bool is
        return bindColumnBool(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnTimestamp(cursor: &[Cursor, R], index: Int32): Int64 is
        return bindColumnTimestamp(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnText(cursor: &[Cursor, R], index: Int32): Span[Nat8, R] is
        return bindColumnText(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnBytes(cursor: &[Cursor, R], index: Int32): Span[Nat8, R] is
        return bindColumnBytes(&(cursor->inner), index);
    end;

    generic [R: Region]
    function isNullColumn(cursor: &[Cursor, R], index: Int32): Bool is
        return bindIsNullColumn(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnInt64OrNone(cursor: &[Cursor, R], index: Int32): Option[Int64] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnInt64(cursor, index));
    end;

    generic [R: Region]
    function columnFloat64OrNone(cursor: &[Cursor, R], index: Int32): Option[Float64] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnFloat64(cursor, index));
    end;

    generic [R: Region]
    function columnBoolOrNone(cursor: &[Cursor, R], index: Int32): Option[Bool] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnBool(cursor, index));
    end;

    generic [R: Region]
    function columnTimestampOrNone(cursor: &[Cursor, R], index: Int32): Option[Int64] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnTimestamp(cursor, index));
    end;

    generic [R: Region]
    function columnTextOrNone(cursor: &[Cursor, R], index: Int32): Option[Span[Nat8, R]] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnText(cursor, index));
    end;

    generic [R: Region]
    function columnBytesOrNone(cursor: &[Cursor, R], index: Int32): Option[Span[Nat8, R]] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnBytes(cursor, index));
    end;

    generic [M: Free, R: Region]
    function finish(db: &![Connection[M], R], cursor: Cursor): Option[MariaError] is
        let { inner: BindCursor } := cursor;
        case bindFinish(&!(db->handle), inner) of
            when Some(value as error: BindError) do
                return Some(value => errorOf(error));
            when None do
                return None();
        end case;
    end;

    function libraryVersion(): Span[Nat8, Static] is
        return bindLibraryVersion();
    end;
end module body.
