-- A safe module: an Arena holds the arena of Bindings.Arena, which does the
-- work with addresses, and every call goes there.
import Bindings.Arena (
    Arena as Block,
    createArena as bindCreateArena,
    arenaAllocate as bindArenaAllocate,
    arenaSpan as bindArenaSpan,
    arenaUsed as bindArenaUsed,
    arenaCapacity as bindArenaCapacity,
    resetArena as bindResetArena,
    freeArena as bindFreeArena
);

module body Standard.Arena is
    -- The record holds only the runtime's block.  How much of it is used
    -- and how much there is are kept by the runtime, and the runtime alone
    -- checks that a piece fits before it hands one out (hilde_arena_alloc
    -- in lib/prelude.c, in both of its modes).  So no function here has a
    -- contract: its condition would have to call the runtime, which a
    -- contract may not.
    record Arena: Linear is
        block: Block;
    end;

    function createArena(capacity: ByteSize): Option[Arena] is
        case bindCreateArena(capacity) of
            when Some(value as block: Block) do
                let some: Option[Arena] := Some(value => Arena(block => block));
                return some;
            when None do
                let none: Option[Arena] := None();
                return none;
        end case;
    end;

    generic [T: Free, R: Region]
    function arenaAllocate(arena: &![Arena, R]): Option[&![T, R]] is
        return bindArenaAllocate(&!(arena->block));
    end;

    generic [T: Free, R: Region]
    function arenaSpan(arena: &![Arena, R], count: Index): Option[Span![T, R]] is
        return bindArenaSpan(&!(arena->block), count);
    end;

    generic [R: Region]
    function arenaUsed(arena: &[Arena, R]): ByteSize is
        return bindArenaUsed(&(arena->block));
    end;

    generic [R: Region]
    function arenaCapacity(arena: &[Arena, R]): ByteSize is
        return bindArenaCapacity(&(arena->block));
    end;

    function resetArena(arena: Arena): Arena is
        let { block: Block } := arena;
        return Arena(block => bindResetArena(block));
    end;

    function freeArena(arena: Arena): Unit is
        let { block: Block } := arena;
        bindFreeArena(block);
        return nil;
    end;
end module body.
