import Standard.String (
    String,
    makeEmpty,
    makeString,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    storeNth,
    asSpan
);
import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);

module body Standard.String.Test is
    -- The span of an empty string is empty, and asking for it does not
    -- stop the programme, where getSpan has no pair of bounds to take.
    -- asSpan of an empty string.
    function testAsSpanEmpty(): Unit is
        let s: String := makeEmpty();
        let whole: Span[Nat8, Static] := "";
        assertTrue(spanLength(asSpan(&s)) = 0, "empty string, empty span");
        assertTrue(spanLength(whole) = 0, "the empty literal, empty span");
        destroyString(s);
        return nil;
    end;

    -- asSpan of a string of one byte.
    function testAsSpanOneByte(): Unit is
        let s: String := fromLiteral("x");
        borrow view: &[String, R] := &s do
            let bytes: Span[Nat8, R] := asSpan(view);
            assertTrue(spanLength(bytes) = 1, "one byte, span of one");
            assertTrue(bytes[0] = 'x', "the byte is x");
        end borrow;
        destroyString(s);
        return nil;
    end;

    -- asSpan holds every byte.
    function testAsSpanWhole(): Unit is
        let s: String := fromLiteral("abc");
        borrow view: &[String, R] := &s do
            let bytes: Span[Nat8, R] := asSpan(view);
            let size: Index := spanLength(bytes);
            assertTrue(size = 3, "three bytes");
            var same: Bool := true;
            for i from 0 to size - 1 do
                if bytes[i] /= nthByte(view, i) then
                    same := false;
                end if;
            end for;
            assertTrue(same, "each byte the string's");
        end borrow;
        destroyString(s);
        return nil;
    end;

    -- makeEmpty and destroyString.
    function testMakeEmpty(): Unit is
        let str: String := makeEmpty();
        assertLength(&str, 0);
        destroyString(str);
        assertSuccess("makeEmpty and destroyString complete");
        return nil;
    end;

    -- makeString and destroyString.
    function testMakeString(): Unit is
        let b: String := makeString(4, 'a');
        assertLength(&b, 4);
        assertTrue(nthByte(&b, 0) = 'a', "[0] = a");
        assertTrue(nthByte(&b, 1) = 'a', "[1] = a");
        assertTrue(nthByte(&b, 2) = 'a', "[2] = a");
        assertTrue(nthByte(&b, 3) = 'a', "[3] = a");
        destroyString(b);
        assertSuccess("destroyString complete");
        return nil;
    end;

    -- fromLiteral.
    function testFromLiteral(): Unit is
        let s: String := fromLiteral("Hello, World!");
        assertLength(&s, 13);
        assertTrue(nthByte(&s, 0) = 'H', "[0] = H");
        assertTrue(nthByte(&s, 1) = 'e', "[1] = e");
        assertTrue(nthByte(&s, 2) = 'l', "[2] = l");
        assertTrue(nthByte(&s, 3) = 'l', "[3] = l");
        assertTrue(nthByte(&s, 4) = 'o', "[4] = o");
        assertTrue(nthByte(&s, 5) = ',', "[5] = ,");
        assertTrue(nthByte(&s, 6) = ' ', "[6] =  ");
        assertTrue(nthByte(&s, 7) = 'W', "[7] = W");
        assertTrue(nthByte(&s, 8) = 'o', "[8] = o");
        assertTrue(nthByte(&s, 9) = 'r', "[9] = r");
        assertTrue(nthByte(&s, 10) = 'l', "[10] = l");
        assertTrue(nthByte(&s, 11) = 'd', "[11] = d");
        assertTrue(nthByte(&s, 12) = '!', "[12] = !");
        destroyString(s);
        assertSuccess("destroyString complete");
        return nil;
    end;

    -- fromLiteral empty.
    function testFromLiteralEmpty(): Unit is
        let s: String := fromLiteral("");
        assertLength(&s, 0);
        destroyString(s);
        assertSuccess("destroyString complete");
        return nil;
    end;

    -- storeNth.
    function testStoreNth(): Unit is
        var b: String := makeString(3, 'a');
        assertLength(&b, 3);
        assertTrue(nthByte(&b, 0) = 'a', "[0] = a");
        assertTrue(nthByte(&b, 1) = 'a', "[1] = a");
        assertTrue(nthByte(&b, 2) = 'a', "[2] = a");
        storeNth(&!b, 0, 'b');
        assertTrue(nthByte(&b, 0) = 'b', "[0] = b");
        destroyString(b);
        assertSuccess("destroyString complete");
        return nil;
    end;

    ---
    --- Utilities
    ---

    generic [R: Region]
    function assertLength(ref: &[String, R], len: Index): Unit is
        assertTrue(length(ref) = len, "length");
        return nil;
    end;

    generic [R: Region]
    function assertNth(ref: &[String, R], pos: Index, value: Nat8): Unit is
        assertTrue(nthByte(ref, pos) = value, "nthByte");
        return nil;
    end;
end module body.
