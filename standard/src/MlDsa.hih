"""
Signs and verifies with ML-DSA of FIPS 204 at the levels 44, 65 and 87.

- A key is made from a seed of 32 bytes, so the same seed always gives the same key.
- Signing is the pure form of FIPS 204 with a context of at most 255 bytes, hedged with 32 random bytes.
- The behaviour is the same on every system: the backend carries its own portable C and SHAKE.
- The seed and the expanded secret key are wiped when the key is destroyed.
- verify gives false for any length that does not fit; it never traps.
- In a task a call needs 256 KiB of stack left, 576 KiB to sign at level 87; with less it gives None or false.

    let key: Option[MlDsaKey] := generateKeyPair(Level44());
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String,
    length
);

module Standard.MlDsa is
    """
    The parameter set of FIPS 204: ML-DSA-44, ML-DSA-65 or ML-DSA-87.
    """
    union ParameterSet: Free is
        case Level44;
        case Level65;
        case Level87;
    end;

    """
    A key pair of one parameter set, held as its seed, its public key and
    its expanded secret key.
    """
    type MlDsaKey: Linear;

    """
    The bytes of a seed, 32 at every level.
    """
    function seedBytes(): Index
        ensures result = 32;

    """
    The bytes of a public key of the set: 1312, 1952 or 2592.
    """
    function publicKeyBytes(set: ParameterSet): Index
        ensures (result >= 1312) and (result <= 2592);

    """
    The bytes of an expanded secret key of the set: 2560, 4032 or 4896.
    """
    function secretKeyBytes(set: ParameterSet): Index
        ensures (result >= 2560) and (result <= 4896);

    """
    The bytes of a signature of the set: 2420, 3309 or 4627.
    """
    function signatureBytes(set: ParameterSet): Index
        ensures (result >= 2420) and (result <= 4627);

    """
    The most bytes a context may have, 255.
    """
    function contextMost(): Index
        ensures result = 255;

    """
    The key pair of the set made from seed by ML-DSA.KeyGen_internal.  The
    seed is kept with the key.  None only when the backend refuses.  No
    contract on the result: it is an Option.
    """
    generic [S: Region]
    function keypairFromSeed(set: ParameterSet, seed: Span[Nat8, S]): Option[MlDsaKey]
        requires spanLength(seed) = seedBytes();

    """
    A new key pair of the set from a seed of 32 random bytes.  None when no
    random bytes could be had.
    No contract: the result is an Option.
    """
    function generateKeyPair(set: ParameterSet): Option[MlDsaKey];

    """
    The parameter set of key.
    No contract: the set is the whole answer, and the invariant of the key already holds it to the three.
    """
    generic [R: Region]
    function parameterSetOf(key: &[MlDsaKey, R]): ParameterSet;

    """
    A copy of the public key, the encoding of FIPS 204.
    """
    generic [R: Region]
    function publicKeyOf(key: &[MlDsaKey, R]): String
        ensures length(&result) = publicKeyBytes(parameterSetOf(key));

    """
    A copy of the seed the key was made from.  It is the whole secret: the
    caller wipes it.
    """
    generic [R: Region]
    function seedOf(key: &[MlDsaKey, R]): String
        ensures length(&result) = seedBytes();

    """
    A copy of the expanded secret key, the encoding of FIPS 204.  The caller
    wipes it.
    """
    generic [R: Region]
    function expandedSecretOf(key: &[MlDsaKey, R]): String
        ensures length(&result) = secretKeyBytes(parameterSetOf(key));

    """
    The signature of message with context under key, hedged with 32 random
    bytes.  None when no random bytes could be had or the backend refuses.
    No contract on the result: it is an Option.
    """
    generic [R: Region, M: Region, C: Region]
    function sign(key: &[MlDsaKey, R], message: Span[Nat8, M], context: Span[Nat8, C]): Option[String]
        requires spanLength(context) <= contextMost();

    """
    The signature of message with context under key with the given 32 bytes
    of randomness, for test vectors and fixed signatures; 32 zero bytes give
    the deterministic variant of FIPS 204.  No contract on the result: it is
    an Option.
    """
    generic [R: Region, M: Region, C: Region, N: Region]
    function signWithRandomness(key: &[MlDsaKey, R], message: Span[Nat8, M], context: Span[Nat8, C], randomness: Span[Nat8, N]): Option[String]
        requires (spanLength(context) <= contextMost()) and (spanLength(randomness) = 32);

    """
    Whether signature is one of message with context under publicKey of
    the set.  False for a key, context or signature of the wrong length.
    No contract: every input is allowed, a wrong length is an answer.
    """
    generic [P: Region, M: Region, C: Region, G: Region]
    function verify(set: ParameterSet, publicKey: Span[Nat8, P], message: Span[Nat8, M], context: Span[Nat8, C], signature: Span[Nat8, G]): Bool;

    """
    Wipes the seed and the secret key and gives the key back.
    No contract: it only frees or closes what it is given.
    """
    function destroyMlDsaKey(key: MlDsaKey): Unit;
end module.
