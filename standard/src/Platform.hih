"""
The system and the machine the programme was compiled for, and the host it runs on.

- The system is linux, openbsd, freebsd, macos, wasi or unknown.
- The machine is x86_64, aarch64, i386, arm, riscv64, ppc64, wasm32 or unknown.
- The system and the machine are fixed when the programme is compiled.
- The host name is asked of the kernel once, the first time, at most 255 bytes, unknown when there is none.

    print(systemName());
    print("/");
    printLn(machineName());
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Platform is
    """
    The name of the system, in small letters.
    """
    function systemName(): Span[Nat8, Static]
        ensures spanLength(result) > 0;

    """
    The name of the machine's architecture.
    """
    function machineName(): Span[Nat8, Static]
        ensures spanLength(result) > 0;

    """
    The name of the host the programme runs on, as the kernel gave it the
    first time it was asked, or unknown.
    """
    function hostName(): Span[Nat8, Static]
        ensures spanLength(result) > 0;
end module.
