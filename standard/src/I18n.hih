"""
Translated texts from a catalog that is part of the programme, for templates and for code.

- A key is a case of a union, a language a function with a case over it: an unknown key and a missing one do not compile.
- The language is asked for by its code on every call; nothing is stored, and several tasks may translate at once.
- A code no language has gives the catalog's default language.
- A text holds placeholders {name}, replaced by the arguments; {{ is a brace, and a placeholder without an argument stays as written.
- Plural forms after the six plural categories of Unicode; englishPlural and germanPlural are given, a catalog may bring its own rule.

    var arguments: Arguments := makeArguments();
    addText(&!arguments, "name", "Ada");
    let greeting: String := translate(messages(), "de", Greeting(), None(), &arguments);
    destroyArguments(arguments);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.I18n is
    """
    The plural category of a count, as the plural rules of Unicode name them.
    """
    union Category: Free is
        case Zero;
        case One;
        case Two;
        case Few;
        case Many;
        case Other;
    end;

    """
    The text of one key in one language: one text, a singular and a plural,
    or a text for each category.  In Forms an empty text stands for other.
    """
    union Message: Free is
        case Text is
            text: Span[Nat8, Static];
        case Plural is
            one: Span[Nat8, Static];
            other: Span[Nat8, Static];
        case Forms is
            zero: Span[Nat8, Static];
            one: Span[Nat8, Static];
            two: Span[Nat8, Static];
            few: Span[Nat8, Static];
            many: Span[Nat8, Static];
            other: Span[Nat8, Static];
    end;

    """
    A language of a catalog over the keys K: its code, such as en or de, its
    texts and the plural rule of its counts.
    """
    record Language[K: Free]: Free is
        code: Span[Nat8, Static];
        texts: Fn[K, Message];
        plural: Fn[Int64, Category];
    end;

    """
    A catalog over the keys K: the default language, and the further ones by
    an index from 0, None past the last.
    """
    record Catalog[K: Free]: Free is
        default: Language[K];
        others: Fn[Index, Option[Language[K]]];
    end;

    """
    The plural rule of English: one for 1, other for every other count.
    No contract: a union has no equality to state the result with.
    """
    function englishPlural(count: Int64): Category;

    """
    The plural rule of German, the same as English's.
    No contract: as for englishPlural.
    """
    function germanPlural(count: Int64): Category;

    """
    The language of the catalog whose code is the one asked for, ASCII
    letters in either case; the default language when there is none.
    No contract: a record of function pointers has no equality to state it with.
    """
    generic [K: Free, R: Region]
    function languageOf(catalog: Catalog[K], code: Span[Nat8, R]): Language[K];

    """
    The text of a message for a count: the form the rule gives for it, other
    when there is no count, the one text of a Text in any case.
    No contract: the form is one of the message's texts, which costs a case to state.
    """
    function formOf(message: Message, plural: Fn[Int64, Category], count: Option[Int64]): Span[Nat8, Static];

    """
    No count: the value a lookup takes for a text that is not counted.
    No contract: an Option has no equality to state it with.
    """
    function noCount(): Option[Int64];

    """
    The arguments of a text, by name, each a text of its own.  A number is
    kept as its decimal digits.
    """
    type Arguments: Linear;

    """
    No arguments.
    """
    function makeArguments(): Arguments
        ensures countArguments(&result) = 0;

    """
    How many arguments there are.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function countArguments(arguments: &[Arguments, R]): Index;

    """
    One more argument with a text.  A name given twice keeps the first.
    """
    generic [R: Region, S: Region]
    function addText(arguments: &![Arguments, R], name: Span[Nat8, Static], value: Span[Nat8, S]): Unit
        ensures countArguments(&arguments) = (old(countArguments(&arguments)) + 1);

    """
    One more argument with a number, written in decimal digits.
    """
    generic [R: Region]
    function addNumber(arguments: &![Arguments, R], name: Span[Nat8, Static], value: Int64): Unit
        ensures countArguments(&arguments) = (old(countArguments(&arguments)) + 1);

    """
    Gives the arguments back.
    No contract: it only frees or closes what it is given.
    """
    function destroyArguments(arguments: Arguments): Unit;

    """
    The text with each placeholder {name} replaced by the argument of that
    name.  {{ and }} are single braces; a placeholder without an argument
    and a brace that opens nothing stay as written.
    No contract: the length of the result depends on every placeholder, more than O(1) to state.
    """
    generic [R: Region, S: Region]
    function render(text: Span[Nat8, S], arguments: &[Arguments, R]): String;

    """
    The finished text of a key in the language asked for: the language by
    its code with the default after it, the form for the count, the
    arguments put in.  The count, when there is one, is not an argument by
    itself; a template that names count passes it as both.
    No contract: as for render.
    """
    generic [K: Free, R: Region, S: Region]
    function translate(catalog: Catalog[K], code: Span[Nat8, R], key: K, count: Option[Int64], arguments: &[Arguments, S]): String;
end module.
