"""
State that tasks share: a mutex that guards a value, and an atomic word of 64 bits.

- Tasks reach a shared thing through a read reference lent by a lending scope of Standard.Task.
- A mutex holds one value of any type; acquire moves it out with a key, release takes both back.
- The key is linear: a task that acquired must give it back, and only its own mutex takes it.
- A task that waits for a mutex lets its thread run other tasks.
- A mutex that is never given back ends the programme with the deadlock message of Standard.Task.
- An atomic word is read and changed in one step each.
- Every task sees the changes of one atomic word in one order.

    let { value as count: Int64, key: Key } := acquire(counter);
    release(counter, count + 1, key);
    let total: Int64 := atomicAdd(requests, 1);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Shared is
    """
    A value of T and a lock that lets one task at a time have it.  It is
    linear: destroyMutex gives the value back at the end.
    """
    type Mutex[T: Type]: Linear;

    """
    The proof that a task holds a mutex.  Only acquire and tryAcquire make
    one, and only release consumes it.
    """
    type Key: Linear;

    """
    What acquire hands out: the value and the key, to be taken apart with
    a let and given back to release.
    """
    record Held[T: Type]: Linear is
        value: T;
        key: Key;
    end;

    """
    A mutex that guards value and is not held.  Left gives the value back
    when there is no memory for the mutex.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [T: Type]
    function makeMutex(value: T): Either[T, Mutex[T]];

    """
    Waits until no task holds the mutex, then holds it and hands out its
    value with the key.  A task that acquires a mutex it holds already
    waits for itself, which ends in the deadlock message.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [T: Type, R: Region]
    function acquire(mutex: &[Mutex[T], R]): Held[T];

    """
    As acquire when no task holds the mutex; None at once when one does.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [T: Type, R: Region]
    function tryAcquire(mutex: &[Mutex[T], R]): Option[Held[T]];

    """
    Puts value back into the mutex and lets it go, which wakes the tasks
    that wait for it.  A key of another mutex stops the programme.
    No contract: it only frees or closes what it is given.
    """
    generic [T: Type, R: Region]
    function release(mutex: &[Mutex[T], R], value: T, key: Key): Unit;

    """
    Whether a task holds the mutex at this moment.  Another task may take
    or let it go right after, so the answer is a report, not a promise.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [T: Type, R: Region]
    function mutexHeld(mutex: &[Mutex[T], R]): Bool;

    """
    The value, and the mutex gone.  A mutex that is held, whose key was
    kept somewhere instead of being given back, stops the programme.
    No contract: it only frees or closes what it is given.
    """
    generic [T: Type]
    function destroyMutex(mutex: Mutex[T]): T;

    """
    A word of 64 bits that tasks read and change in one step each.  It is
    linear: destroyAtomic gives the last value.
    """
    type Atomic: Linear;

    """
    A word that holds initial.  None when there is no memory.
    No contract: an Option result, which an ensures cannot look into.
    """
    function makeAtomic(initial: Int64): Option[Atomic];

    """
    The value of the word.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function atomicLoad(atomic: &[Atomic, R]): Int64;

    """
    Sets the word to value.
    No contract: its effect is on the system or on what it consumes, which a condition cannot read.
    """
    generic [R: Region]
    function atomicStore(atomic: &[Atomic, R], value: Int64): Unit;

    """
    Adds delta to the word and returns the sum.  A sum that does not fit
    an Int64 stops the programme, as the plus sign does, and leaves the
    word unchanged.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function atomicAdd(atomic: &[Atomic, R], delta: Int64): Int64;

    """
    Sets the word to value and returns what it held before.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function atomicExchange(atomic: &[Atomic, R], value: Int64): Int64;

    """
    Sets the word to desired when it holds expected, and says whether it
    did; a word that holds something else is left as it is.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function atomicCompareSwap(atomic: &[Atomic, R], expected: Int64, desired: Int64): Bool;

    """
    The last value of the word, and the word gone.
    No contract: it only frees or closes what it is given.
    """
    function destroyAtomic(atomic: Atomic): Int64;
end module.
