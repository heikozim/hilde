"""
Fills and copies a whole range of a span in one call, checked once at the call instead of at every element.

- Every range is checked by the requires of the call, before anything is written; a range outside its span stops the programme.
- Inside the range nothing is checked again, so a fill or a copy runs as fast as memset and memmove.
- The elements are Free, so a fill or a copy never loses a linear value.
- A copy may overlap its target, as within one buffer.

    let size: Index := spanWriteLength(&target);
    fillBytes(&~target, 0, size, 0);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Bulk is
    """
    Sets count bytes of target from start on to value.
    """
    generic [R: Region]
    function fillBytes(target: Span![Nat8, R], start: Index, count: Index, value: Nat8): Unit
        requires (start <= spanWriteLength(&target)) and (count <= (spanWriteLength(&target) - start));

    """
    Sets count elements of target from start on to value.
    """
    generic [T: Free, R: Region]
    function fillSpan(target: Span![T, R], start: Index, count: Index, value: T): Unit
        requires (start <= spanWriteLength(&target)) and (count <= (spanWriteLength(&target) - start));

    """
    Copies all of source into target, its first element at at.
    """
    generic [T: Free, S: Region, R: Region]
    function copySpan(source: Span[T, S], target: Span![T, R], at: Index): Unit
        requires (at <= spanWriteLength(&target)) and (spanLength(source) <= (spanWriteLength(&target) - at));

    """
    Copies count elements of source from first on into target at at.
    """
    generic [T: Free, S: Region, R: Region]
    function copyRange(source: Span[T, S], first: Index, target: Span![T, R], at: Index, count: Index): Unit
        requires ((first <= spanLength(source)) and (count <= (spanLength(source) - first))) and ((at <= spanWriteLength(&target)) and (count <= (spanWriteLength(&target) - at)));
end module.
