-- A safe module: Bindings.Pcre compiles the pattern and asks the JIT for
-- machine code, Standard.Pcre makes the Regex every search takes.
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Pcre (
    Regex,
    fromCode
);
import Bindings.Pcre (
    Code,
    noSlot,
    compileCode,
    jitCode,
    jitBuiltIn as builtIn,
    errorText
);

module body Standard.PcreJit is
    record Compiled: Linear is
        regex: Regex;
        fallBack: Option[String];
    end;

    function limitText(): String is
        let text: Span[Nat8, Static] := "Standard.Pcre: the match limit must be at least 1";
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(text);
        var i: Index := 0;
        while i < size do
            writeByte(&!out, text[i]);
            i := i + 1;
        end while;
        return finalize(out);
    end;

    generic [R: Region]
    function compile(pattern: Span[Nat8, R], matchLimit: Nat32): Either[String, Compiled] is
        if matchLimit = 0 then
            let left: Either[String, Compiled] := Left(left => limitText());
            return left;
        end if;
        case compileCode(pattern, matchLimit) of
            when Left(left as message: String) do
                let failed: Either[String, Compiled] := Left(left => message);
                return failed;
            when Right(right as code: Code) do
                var made: Code := code;
                let rc: Int32 := jitCode(&!made);
                if rc = 0 then
                    let none: Option[String] := None();
                    let jitted: Either[String, Compiled] := Right(right => Compiled(regex => fromCode(made), fallBack => none));
                    return jitted;
                else
                    let reason: Option[String] := Some(value => errorText(rc, noSlot));
                    let interpreted: Either[String, Compiled] := Right(right => Compiled(regex => fromCode(made), fallBack => reason));
                    return interpreted;
                end if;
        end case;
    end;

    function jitBuiltIn(): Bool is
        return builtIn();
    end;
end module body.
