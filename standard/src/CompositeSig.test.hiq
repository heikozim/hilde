import Standard.Testing (
    assertTrue,
    assertFalse,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    makeString,
    asSpan,
    nthByte,
    storeNth
);
import Standard.Text (
    equal,
    substring
);
import Standard.CompositeSig (
    CompositeKey,
    publicKeyBytes,
    signatureBytes,
    openSshLabel,
    keypairFromSeeds,
    generateKeyPair,
    publicKeyOf,
    seedsOf,
    sign,
    signWithRandomness,
    verify,
    destroyCompositeKey
);

module body Standard.CompositeSig.Test is
    function seeded(a: Nat8, b: Nat8): CompositeKey is
        let first: String := makeString(32, a);
        let second: String := makeString(32, b);
        case keypairFromSeeds(asSpan(&first), asSpan(&second)) of
            when Some(value as key: CompositeKey) do
                destroyString(second);
                destroyString(first);
                return key;
            when None do
                destroyString(second);
                destroyString(first);
                abort("no key from the seeds");
        end case;
    end;

    -- A copy of signature with byte at flipped.
    generic [R: Region]
    function flipped(signature: &[String, R], at: Index): String is
        var copy: String := makeString(length(signature), 0);
        var i: Index := 0;
        while i < length(signature) do
            storeNth(&!copy, i, nthByte(signature, i));
            i := i + 1;
        end while;
        let old: Nat8 := nthByte(signature, at);
        var new: Nat8 := 0;
        if old /= 255 then
            new := old + 1;
        end if;
        storeNth(&!copy, at, new);
        return copy;
    end;

    -- A signature holds; it fails with either half changed, under another
    -- label, with another context and for another message.
    function testBothHalves(): Unit is
        let key: CompositeKey := seeded(1, 2);
        let public: String := publicKeyOf(&key);
        assertTrue(length(&public) = publicKeyBytes(), "the public key is 1344 bytes");
        case sign(&key, openSshLabel(), "the message", "ctx") of
            when Some(value as signature: String) do
                assertTrue(length(&signature) = signatureBytes(), "the signature is 2484 bytes");
                assertTrue(verify(asSpan(&public), openSshLabel(), "the message", "ctx", asSpan(&signature)), "the signature holds");
                assertFalse(verify(asSpan(&public), openSshLabel(), "the massage", "ctx", asSpan(&signature)), "not for another message");
                assertFalse(verify(asSpan(&public), openSshLabel(), "the message", "", asSpan(&signature)), "not with another context");
                assertFalse(verify(asSpan(&public), "COMPSIG-OTHER", "the message", "ctx", asSpan(&signature)), "not under another label");
                let lattice: String := flipped(&signature, 100);
                assertFalse(verify(asSpan(&public), openSshLabel(), "the message", "ctx", asSpan(&lattice)), "not with the ML-DSA half changed");
                destroyString(lattice);
                let ed: String := flipped(&signature, 2450);
                assertFalse(verify(asSpan(&public), openSshLabel(), "the message", "ctx", asSpan(&ed)), "not with the Ed25519 half changed");
                destroyString(ed);
                assertFalse(verify(substring(asSpan(&public), 0, 1312), openSshLabel(), "the message", "ctx", asSpan(&signature)), "not for a key of the wrong length");
                destroyString(signature);
            when None do
                assertFailure("nothing signed");
        end case;
        destroyString(public);
        destroyCompositeKey(key);
        return nil;
    end;

    -- The seeds give the key back, and fixed randomness the same signature.
    function testSeeds(): Unit is
        let key: CompositeKey := seeded(3, 4);
        let seeds: String := seedsOf(&key);
        assertTrue(length(&seeds) = 64, "two seeds of 32 bytes");
        case keypairFromSeeds(substring(asSpan(&seeds), 0, 32), substring(asSpan(&seeds), 32, 64)) of
            when Some(value as again: CompositeKey) do
                let a: String := publicKeyOf(&key);
                let b: String := publicKeyOf(&again);
                assertTrue(equal(asSpan(&a), asSpan(&b)), "the same seeds, the same key");
                destroyString(b);
                destroyString(a);
                destroyCompositeKey(again);
            when None do
                assertFailure("no key again");
        end case;
        destroyString(seeds);
        let zero: String := makeString(32, 0);
        case signWithRandomness(&key, openSshLabel(), "m", "", asSpan(&zero)) of
            when Some(value as first: String) do
                case signWithRandomness(&key, openSshLabel(), "m", "", asSpan(&zero)) of
                    when Some(value as second: String) do
                        assertTrue(equal(asSpan(&first), asSpan(&second)), "deterministic twice the same");
                        destroyString(second);
                    when None do
                        assertFailure("no second signature");
                end case;
                destroyString(first);
            when None do
                assertFailure("no first signature");
        end case;
        destroyString(zero);
        destroyCompositeKey(key);
        case generateKeyPair() of
            when Some(value as made: CompositeKey) do
                destroyCompositeKey(made);
            when None do
                assertFailure("no generated key");
        end case;
        return nil;
    end;
end module body.
