"""
The full version text and the info text of a programme, from its build and its platform.

- One line per field, the name in the first twelve columns and the value from column 13.
- The fields are version, commit, built, compiler and system, then the copyright last.
- fullVersionWith adds a line library for each linked C library the programme names, before the copyright.
- info adds what the running programme sees: binary, host and the time, read when it is called.
- The commit carries (dirty) when the work tree held changes; none when the build had no commit.
- The build time is UTC, in the form 2026-10-17T19:30:00Z.
- A programme that imports this module carries Standard.BuildInfo with it; one that does not, carries neither.

    setFullVersion(&!command, fullVersion("1.2.0", "2026 Example Corp"));
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);

module Standard.About is
    """
    The full version text: version, commit, built, compiler, system and
    machine, and copyright, each on a line of its own.  An empty notice
    leaves the copyright line out.
    """
    function fullVersion(version: Span[Nat8, Static], notice: Span[Nat8, Static]): String
        ensures length(&result) > 0;

    """
    The full version text with a line library for each entry of
    libraries, its name and run-time version as the programme writes them,
    sqlite 3.46.1 for one, in their order before the copyright.
    """
    generic [R: Region]
    function fullVersionWith(version: Span[Nat8, Static], notice: Span[Nat8, Static], libraries: &[Buffer[String], R]): String
        ensures length(&result) > 0;

    """
    The info text: art as it stands and the long name of the acronym, each
    left out when empty, then name, version, commit, system, arch, config,
    binary, compiler, host and time, each on a line of its own.  config is
    the path of the configuration in use, none when empty; binary is the
    name the programme was started by; time is the time of the call, UTC.
    """
    generic [A: Region, L: Region, C: Region]
    function info(art: Span[Nat8, A], longName: Span[Nat8, L], name: Span[Nat8, Static], version: Span[Nat8, Static], config: Span[Nat8, C]): String
        ensures length(&result) > 0;
end module.
