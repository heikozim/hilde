import Standard.Testing (
    assertTrue,
    assertFalse,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.Base32 (
    decodeBase32
);
import Standard.Libcrypto (
    hmacSha1
);
import Standard.Text (
    bytesToHex
);
import Standard.Otp (
    OtpHash,
    OtpSha1,
    OtpSha256,
    OtpSha512,
    hotp,
    totp,
    verifyTotp,
    newSecret,
    otpauthUri
);

module body Standard.Otp.Test is
    constant secret1: Span[Nat8, Static] := "12345678901234567890";
    constant secret256: Span[Nat8, Static] := "12345678901234567890123456789012";
    constant secret512: Span[Nat8, Static] := "1234567890123456789012345678901234567890123456789012345678901234";

    generic [R: Region]
    function same(text: &[String, R], expected: Span[Nat8, Static]): Bool is
        let size: Index := length(text);
        if size /= spanLength(expected) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            if nthByte(text, i) /= expected[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    function codeIs(made: Option[String], expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case made of
            when Some(value as code: String) do
                assertTrue(same(&code, expected), message);
                destroyString(code);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    -- HMAC-SHA1 of RFC 2202, test case 2.
    function testHmacSha1(): Unit is
        case hmacSha1("Jefe", "what do ya want for nothing?") of
            when Some(value as digest: String) do
                let hex: String := bytesToHex(asSpan(&digest));
                assertTrue(same(&hex, "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79"), "RFC 2202, test case 2");
                destroyString(hex);
                destroyString(digest);
            when None do
                assertFailure("no HMAC-SHA1");
        end case;
        return nil;
    end;

    -- RFC 4226 appendix D: the ten codes of counters 0 to 9.
    function testHotpVectors(): Unit is
        codeIs(hotp(secret1, 0, 6, OtpSha1()), "755224", "counter 0");
        codeIs(hotp(secret1, 1, 6, OtpSha1()), "287082", "counter 1");
        codeIs(hotp(secret1, 2, 6, OtpSha1()), "359152", "counter 2");
        codeIs(hotp(secret1, 3, 6, OtpSha1()), "969429", "counter 3");
        codeIs(hotp(secret1, 4, 6, OtpSha1()), "338314", "counter 4");
        codeIs(hotp(secret1, 5, 6, OtpSha1()), "254676", "counter 5");
        codeIs(hotp(secret1, 6, 6, OtpSha1()), "287922", "counter 6");
        codeIs(hotp(secret1, 7, 6, OtpSha1()), "162583", "counter 7");
        codeIs(hotp(secret1, 8, 6, OtpSha1()), "399871", "counter 8");
        codeIs(hotp(secret1, 9, 6, OtpSha1()), "520489", "counter 9");
        return nil;
    end;

    -- RFC 6238 appendix B: eight digits, steps of 30 seconds, three hashes.
    function testTotpVectors(): Unit is
        codeIs(totp(secret1, 59, 30, 8, OtpSha1()), "94287082", "59, SHA-1");
        codeIs(totp(secret256, 59, 30, 8, OtpSha256()), "46119246", "59, SHA-256");
        codeIs(totp(secret512, 59, 30, 8, OtpSha512()), "90693936", "59, SHA-512");
        codeIs(totp(secret1, 1111111109, 30, 8, OtpSha1()), "07081804", "1111111109, SHA-1");
        codeIs(totp(secret256, 1111111109, 30, 8, OtpSha256()), "68084774", "1111111109, SHA-256");
        codeIs(totp(secret512, 1111111109, 30, 8, OtpSha512()), "25091201", "1111111109, SHA-512");
        codeIs(totp(secret1, 1234567890, 30, 8, OtpSha1()), "89005924", "1234567890, SHA-1");
        codeIs(totp(secret256, 1234567890, 30, 8, OtpSha256()), "91819424", "1234567890, SHA-256");
        codeIs(totp(secret512, 1234567890, 30, 8, OtpSha512()), "93441116", "1234567890, SHA-512");
        codeIs(totp(secret1, 2000000000, 30, 8, OtpSha1()), "69279037", "2000000000, SHA-1");
        codeIs(totp(secret256, 2000000000, 30, 8, OtpSha256()), "90698825", "2000000000, SHA-256");
        codeIs(totp(secret512, 2000000000, 30, 8, OtpSha512()), "38618901", "2000000000, SHA-512");
        codeIs(totp(secret1, 20000000000, 30, 8, OtpSha1()), "65353130", "20000000000, SHA-1");
        codeIs(totp(secret256, 20000000000, 30, 8, OtpSha256()), "77737706", "20000000000, SHA-256");
        codeIs(totp(secret512, 20000000000, 30, 8, OtpSha512()), "47863826", "20000000000, SHA-512");
        return nil;
    end;

    function testVerify(): Unit is
        assertTrue(verifyTotp(secret1, "94287082", 59, 30, 8, OtpSha1(), 0), "the code of its step");
        assertTrue(verifyTotp(secret1, "94287082", 89, 30, 8, OtpSha1(), 1), "a step later, inside the window");
        assertFalse(verifyTotp(secret1, "94287082", 89, 30, 8, OtpSha1(), 0), "a step later, without a window");
        assertTrue(verifyTotp(secret1, "94287082", 29, 30, 8, OtpSha1(), 1), "a step earlier, inside the window");
        assertFalse(verifyTotp(secret1, "94287082", 29, 30, 8, OtpSha1(), 0), "a step earlier, without a window");
        assertFalse(verifyTotp(secret1, "94287082", 119, 30, 8, OtpSha1(), 1), "two steps later");
        assertFalse(verifyTotp(secret1, "94287083", 59, 30, 8, OtpSha1(), 1), "one digit off");
        assertFalse(verifyTotp(secret1, "9428708", 59, 30, 8, OtpSha1(), 1), "a digit short");
        assertFalse(verifyTotp(secret1, "94287082", -1, 30, 8, OtpSha1(), 1), "a time below 0");
        return nil;
    end;

    function testRefusals(): Unit is
        case hotp(secret1, 0, 5, OtpSha1()) of
            when Some(value as code: String) do
                destroyString(code);
                assertFailure("five digits were taken");
            when None do
                assertSuccess("five digits are refused");
        end case;
        case hotp("", 0, 6, OtpSha1()) of
            when Some(value as code: String) do
                destroyString(code);
                assertFailure("an empty secret was taken");
            when None do
                assertSuccess("an empty secret is refused");
        end case;
        return nil;
    end;

    -- A new secret is 32 base32 characters for 20 bytes.
    function testNewSecretAndUri(): Unit is
        case newSecret() of
            when Some(value as secret: String) do
                assertTrue(length(&secret) = 32, "32 characters");
                case decodeBase32(asSpan(&secret)) of
                    when Some(value as raw: String) do
                        assertTrue(length(&raw) = 20, "20 bytes");
                        destroyString(raw);
                    when None do
                        assertFailure("the secret is not base32");
                end case;
                destroyString(secret);
            when None do
                assertFailure("no secret");
        end case;
        let uri: String := otpauthUri("Hilde Wiki", "ann@example.org", "GEZDGNBVGY3TQOJQ", OtpSha1(), 6, 30);
        assertTrue(same(&uri, "otpauth://totp/Hilde%20Wiki:ann@example.org?secret=GEZDGNBVGY3TQOJQ&issuer=Hilde%20Wiki&algorithm=SHA1&digits=6&period=30"), "the URI");
        destroyString(uri);
        return nil;
    end;
end module body.
