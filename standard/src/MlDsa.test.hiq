import Standard.Testing (
    assertTrue,
    assertFalse,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    makeString,
    asSpan
);
import Standard.Text (
    equal
);
import Standard.MlDsa (
    ParameterSet,
    Level44,
    Level65,
    Level87,
    MlDsaKey,
    publicKeyBytes,
    secretKeyBytes,
    signatureBytes,
    keypairFromSeed,
    generateKeyPair,
    publicKeyOf,
    seedOf,
    expandedSecretOf,
    sign,
    signWithRandomness,
    verify,
    destroyMlDsaKey
);

module body Standard.MlDsa.Test is
    function keyOf(set: ParameterSet): MlDsaKey is
        case generateKeyPair(set) of
            when Some(value as key: MlDsaKey) do
                return key;
            when None do
                abort("no key");
        end case;
    end;

    function seeded(set: ParameterSet, byte: Nat8): MlDsaKey is
        let seed: String := makeString(32, byte);
        case keypairFromSeed(set, asSpan(&seed)) of
            when Some(value as key: MlDsaKey) do
                destroyString(seed);
                return key;
            when None do
                destroyString(seed);
                abort("no key from the seed");
        end case;
    end;

    -- A key of the set signs, the signature holds, and it fails for
    -- another message, another context and another key.
    function signsAndVerifies(set: ParameterSet): Unit is
        let key: MlDsaKey := keyOf(set);
        let other: MlDsaKey := keyOf(set);
        let public: String := publicKeyOf(&key);
        let otherPublic: String := publicKeyOf(&other);
        assertTrue(length(&public) = publicKeyBytes(set), "the length of the public key");
        case sign(&key, "the message", "ctx") of
            when Some(value as signature: String) do
                assertTrue(length(&signature) = signatureBytes(set), "the length of the signature");
                assertTrue(verify(set, asSpan(&public), "the message", "ctx", asSpan(&signature)), "the signature holds");
                assertFalse(verify(set, asSpan(&public), "the massage", "ctx", asSpan(&signature)), "not for another message");
                assertFalse(verify(set, asSpan(&public), "the message", "", asSpan(&signature)), "not for another context");
                assertFalse(verify(set, asSpan(&otherPublic), "the message", "ctx", asSpan(&signature)), "not under another key");
                assertFalse(verify(set, "short", "the message", "ctx", asSpan(&signature)), "not for a key of the wrong length");
                assertFalse(verify(set, asSpan(&public), "the message", "ctx", "short"), "not for a signature of the wrong length");
                destroyString(signature);
            when None do
                assertFailure("nothing signed");
        end case;
        destroyString(otherPublic);
        destroyString(public);
        destroyMlDsaKey(other);
        destroyMlDsaKey(key);
        return nil;
    end;

    function testLevels(): Unit is
        signsAndVerifies(Level44());
        signsAndVerifies(Level65());
        signsAndVerifies(Level87());
        return nil;
    end;

    -- The same seed gives the same key, another seed another; the seed and
    -- the secret come back with their lengths.
    function testSeed(): Unit is
        let a: MlDsaKey := seeded(Level44(), 7);
        let b: MlDsaKey := seeded(Level44(), 7);
        let c: MlDsaKey := seeded(Level44(), 8);
        let pa: String := publicKeyOf(&a);
        let pb: String := publicKeyOf(&b);
        let pc: String := publicKeyOf(&c);
        assertTrue(equal(asSpan(&pa), asSpan(&pb)), "the same seed, the same key");
        assertFalse(equal(asSpan(&pa), asSpan(&pc)), "another seed, another key");
        let seed: String := seedOf(&a);
        let secret: String := expandedSecretOf(&a);
        assertTrue(length(&seed) = 32, "the seed");
        assertTrue(length(&secret) = secretKeyBytes(Level44()), "the secret");
        destroyString(secret);
        destroyString(seed);
        destroyString(pc);
        destroyString(pb);
        destroyString(pa);
        destroyMlDsaKey(c);
        destroyMlDsaKey(b);
        destroyMlDsaKey(a);
        return nil;
    end;

    -- With fixed randomness the signature is the same twice, and hedged
    -- signatures of the same message differ.
    function testRandomness(): Unit is
        let key: MlDsaKey := seeded(Level65(), 1);
        let zero: String := makeString(32, 0);
        case signWithRandomness(&key, "m", "", asSpan(&zero)) of
            when Some(value as first: String) do
                case signWithRandomness(&key, "m", "", asSpan(&zero)) of
                    when Some(value as second: String) do
                        assertTrue(equal(asSpan(&first), asSpan(&second)), "deterministic twice the same");
                        destroyString(second);
                    when None do
                        assertFailure("no second signature");
                end case;
                destroyString(first);
            when None do
                assertFailure("no first signature");
        end case;
        case sign(&key, "m", "") of
            when Some(value as hedgedA: String) do
                case sign(&key, "m", "") of
                    when Some(value as hedgedB: String) do
                        assertFalse(equal(asSpan(&hedgedA), asSpan(&hedgedB)), "hedged signatures differ");
                        destroyString(hedgedB);
                    when None do
                        assertFailure("no hedged signature");
                end case;
                destroyString(hedgedA);
            when None do
                assertFailure("no hedged signature");
        end case;
        destroyString(zero);
        destroyMlDsaKey(key);
        return nil;
    end;
end module body.
