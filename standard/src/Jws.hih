"""
JSON Web Signatures in the compact form of RFC 7515, JSON Web Keys and OpenID Connect claims.

- Public keys are read from JSON Web Keys after RFC 7517 and RFC 7518.
- The algorithm follows from the kind of the key and nothing else.
- ES256, ES384 and ES512 for P-256, P-384 and P-521, EdDSA for Ed25519, RS256 for RSA.
- ML-DSA-44, ML-DSA-65 and ML-DSA-87 follow the draft of the JOSE working group.
- A token whose header names another algorithm than the key's is refused, and none never holds.
- ECDSA signatures are the two numbers side by side, as RFC 7518 asks, not DER.

    case verifyWithJwks(asSpan(&token), asSpan(&keySet)) of
        when Some(value as payload: String) do
            let problem: Option[String] :=
                claimsProblem(asSpan(&payload), issuer, clientId, asSpan(&nonce), now, 60);
        when None do
            printLn("token refused");
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);
import Standard.X509 (
    PrivateKey,
    KeyKind
);

module Standard.Jws is
    """
    The bytes in base64url without padding.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function base64UrlEncode(bytes: Span[Nat8, R]): String;

    """
    The bytes a base64url text without padding stands for.  None for a
    byte outside the alphabet, padding among them, or a length no encoding
    has.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function base64UrlDecode(text: Span[Nat8, R]): Option[String];

    """
    The name of the algorithm a key of kind signs with, as the header
    writes it.
    No contract: a view into its argument, whose length depends on it.
    """
    function algorithmOf(kind: KeyKind): Span[Nat8, Static];

    """
    The compact JWS of payload signed with key: the header holds alg and,
    when keyId is not empty, kid.  None when libcrypto fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, P: Region, I: Region]
    function signCompact(key: &[PrivateKey, K], payload: Span[Nat8, P], keyId: Span[Nat8, I]): Option[String];

    """
    The payload of the compact JWS token when its signature holds under the
    public key publicDer, a DER SubjectPublicKeyInfo, and its header names
    the algorithm of that key.  None otherwise.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [T: Region, P: Region]
    function verifyCompact(token: Span[Nat8, T], publicDer: Span[Nat8, P]): Option[String];

    """
    The DER public key of a JWK: kty EC with crv P-256, P-384 or P-521 and
    x and y, kty OKP with crv Ed25519 and x, kty RSA with n and e, or kty
    "AKP" with alg ML-DSA-44, ML-DSA-65 or ML-DSA-87 and pub.  None for any
    other key and for coordinates or a key of the wrong length.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [J: Region]
    function publicKeyFromJwk(jwk: Span[Nat8, J]): Option[String];

    """
    The JWK of the public key publicDer, with its members in the order RFC
    7638 sorts them: crv, kty, x, y for EC; crv, kty, x for Ed25519; e,
    kty, n for RSA; alg, kty, pub for ML-DSA, kty "AKP".  None for bytes that
    are no public key.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [P: Region]
    function jwkOfPublicKey(publicDer: Span[Nat8, P]): Option[String];

    """
    The payload of token when it verifies under the key of the JWK set
    jwks whose kid is the kid of the token's header; a token without a kid
    is tried against a set of one key only.  None otherwise.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [T: Region, J: Region]
    function verifyWithJwks(token: Span[Nat8, T], jwks: Span[Nat8, J]): Option[String];

    """
    Why the claims of a payload do not hold, or None when they do: iss must
    be issuer, aud must be audience or an array that holds it, exp must lie
    after now and nbf, when it is there, not after now, both with leeway
    seconds of slack; when nonce is not empty, the nonce claim must be it.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [P: Region, I: Region, A: Region, N: Region]
    function claimsProblem(payload: Span[Nat8, P], issuer: Span[Nat8, I], audience: Span[Nat8, A],
        nonce: Span[Nat8, N], now: Int64, leeway: Int64): Option[String];
end module.
