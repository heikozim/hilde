--
-- Tests for Standard.Time.
--
-- A clock is the easiest thing in a library to write a flaky test against,
-- so every assertion here is one that cannot depend on how fast the machine
-- is or on what the date happens to be:
--
--   * the wall clock is after a date in the past, which catches a clock
--     that answers zero or garbage without depending on today;
--   * hasMonotonic and monotonicNanos agree -- an invariant that holds
--     on a platform with a monotonic clock and on one without, so the
--     assertion count does not change between them;
--   * and the monotonic clock does not go backwards, phrased so that a
--     platform without one passes it honestly rather than by skipping.
--
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.Time (
    wallNanos,
    hasMonotonic,
    monotonicNanos
);

module body Standard.Time.Test is
    ---
    --- Helpers
    ---

    function readingOr(fallback: Nat64): Nat64 is
        case monotonicNanos() of
            when Some(value as reading: Nat64) do
                return reading;
            when None do
                return fallback;
        end case;
    end;

    function monotonicAnswers(): Bool is
        case monotonicNanos() of
            when Some(value as reading: Nat64) do
                return true;
            when None do
                return false;
        end case;
    end;

    ---
    --- The wall clock
    ---

    -- the wall clock.
    function testWall(): Unit is
        -- 2020-01-01T00:00:00Z in nanoseconds.  A date in the past, so the
        -- assertion cannot rot: it catches a clock that answers zero or
        -- something that is not a time at all, and it does not care what
        -- today is.
        let year2020: Nat64 := 1577836800000000000;
        let now: Nat64 := wallNanos();
        assertTrue(now > year2020,
            "the wall clock is somewhere after the start of 2020");
        -- Two readings in a row do not go backwards.  On the wall clock
        -- that is not guaranteed in general -- the clock can be set -- but
        -- it is guaranteed for two calls with nothing between them that
        -- could set it.
        assertTrue(wallNanos() >= now,
            "a second reading is not earlier than the first");
        return nil;
    end;

    ---
    --- The monotonic clock, if there is one
    ---

    -- the monotonic clock, where there is one.
    function testMonotonic(): Unit is
        -- The invariant that holds on both platforms, which is why it is
        -- one assertion and not a skip: the question and the answer agree.
        assertTrue(hasMonotonic() = monotonicAnswers(),
            "hasMonotonic and monotonicNanos say the same thing");

        -- "It does not go backwards", phrased so that a platform without a
        -- monotonic clock passes it honestly: the fallback for the first
        -- reading is 0 and for the second is 1, so the comparison is true
        -- there for a reason a reader can see, and on a platform with a
        -- clock it is the real question.
        let first: Nat64 := readingOr(0);
        let second: Nat64 := readingOr(1);
        assertTrue(second >= first,
            "a later reading is not earlier than an earlier one");

        -- And where there is one, its readings are not zero: a clock that
        -- answered zero twice would pass the line above.
        if hasMonotonic() then
            assertTrue(readingOr(0) > 0,
                "the monotonic clock is running");
        else
            assertFalse(monotonicAnswers(),
                "no monotonic clock here, and none is offered");
        end if;
        return nil;
    end;
end module body.
