-- A safe module: the three streams are reached through Bindings.Terminal.
import Bindings.Terminal (
    writeStdout,
    writeStderr,
    readStdin,
    writeStderrText,
    isTerminalNumber,
    setEcho,
    widthOf,
    drainNumber
);
import Standard.String (
    String
);
import Standard.IO (
    TerminalCapability,
    ByteOutputStream,
    writeByte,
    ByteInputStream,
    readByte
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize,
    writeByte as sbWriteByte
);

module body Standard.IO.Terminal is
    record StandardOutput: Linear is
    end;

    record StandardError: Linear is
    end;

    record StandardInput: Linear is
    end;

    generic [R: Region]
    function acquireOutput(term: &![TerminalCapability, R]): StandardOutput is
        return StandardOutput();
    end;

    generic [R: Region]
    function acquireError(term: &![TerminalCapability, R]): StandardError is
        return StandardError();
    end;

    generic [R: Region]
    function acquireInput(term: &![TerminalCapability, R]): StandardInput is
        return StandardInput();
    end;

    function releaseOutput(stream: StandardOutput): Unit is
        let {} := stream;
        return nil;
    end;

    function releaseError(stream: StandardError): Unit is
        let {} := stream;
        return nil;
    end;

    function releaseInput(stream: StandardInput): Unit is
        let {} := stream;
        return nil;
    end;

    instance ByteOutputStream(StandardOutput) is
        generic [R: Region]
        method writeByte(stream: &![StandardOutput, R], byte: Nat8): Unit is
            writeStdout(byte);
            return nil;
        end;
    end;

    instance ByteOutputStream(StandardError) is
        generic [R: Region]
        method writeByte(stream: &![StandardError, R], byte: Nat8): Unit is
            writeStderr(byte);
            return nil;
        end;
    end;

    generic [R: Region, S: Region]
    function writeErrorText(stream: &![StandardError, R], text: Span[Nat8, S]): Bool is
        return writeStderrText(text);
    end;

    instance ByteInputStream(StandardInput) is
        generic [R: Region]
        method readByte(stream: &![StandardInput, R]): Option[Nat8] is
            return readStdin();
        end;
    end;

    generic [R: Region]
    function readLine(input: &![StandardInput, R]): String is
        var sb: StringBuilder := makeStringBuilder();
        var reading: Bool := true;
        while reading do
            case readByte(&~input) of
                when Some(value as byte: Nat8) do
                    if (byte = '\r') or (byte = '\n') then
                        reading := false;
                    else
                        sbWriteByte(&!sb, byte);
                    end if;
                when None do
                    -- The end of the input.
                    reading := false;
            end case;
        end while;
        return finalize(sb);
    end;

    ---
    --- The terminal
    ---

    constant inputNumber: Int32 := 0;
    constant outputNumber: Int32 := 1;

    generic [R: Region]
    function inputIsTerminal(input: &[StandardInput, R]): Bool is
        return isTerminalNumber(inputNumber);
    end;

    generic [R: Region]
    function outputIsTerminal(output: &[StandardOutput, R]): Bool is
        return isTerminalNumber(outputNumber);
    end;

    generic [R: Region]
    function readHiddenLine(input: &![StandardInput, R]): Option[String] is
        if not isTerminalNumber(inputNumber) then
            let plain: Option[String] := Some(value => readLine(&~input));
            return plain;
        end if;
        if not setEcho(inputNumber, false) then
            let none: Option[String] := None();
            return none;
        end if;
        let line: String := readLine(&~input);
        let restored: Bool := setEcho(inputNumber, true);
        writeStderr('\n');
        let some: Option[String] := Some(value => line);
        return some;
    end;

    generic [R: Region]
    function terminalWidth(output: &[StandardOutput, R]): Nat32 is
        return widthOf(outputNumber);
    end;

    generic [R: Region]
    function drainInput(input: &![StandardInput, R]): Bool is
        return drainNumber(inputNumber);
    end;
end module body.
