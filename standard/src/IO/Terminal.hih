"""
The standard output, the standard error and the standard input of a programme.

- Each stream is linear, acquired through a TerminalCapability and released when done.
- readLine reads up to a carriage return, a line feed or the end of the input.
- readHiddenLine reads a password with the echo off; a signal while it is off leaves it off.
- terminalWidth gives 0 when the width is unknown, which is not a narrow terminal.
- writeErrorText and drainInput return false when the kernel refused.

    var terminal: TerminalCapability := acquireTerminal(&!root);
    var input: StandardInput := acquireInput(&!terminal);
    let line: String := readLine(&!input);
    releaseInput(input);
    releaseTerminal(terminal);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.IO (
    TerminalCapability,
    ByteOutputStream,
    writeByte,
    ByteInputStream,
    readByte
);
import Standard.String (
    String
);

module Standard.IO.Terminal is
    type StandardOutput: Linear;

    type StandardError: Linear;

    type StandardInput: Linear;

    """
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function acquireOutput(term: &![TerminalCapability, R]): StandardOutput;

    """
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function acquireError(term: &![TerminalCapability, R]): StandardError;

    """
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function acquireInput(term: &![TerminalCapability, R]): StandardInput;

    """
    No contract: it only frees or closes what it is given.
    """
    function releaseOutput(stream: StandardOutput): Unit;

    """
    No contract: it only frees or closes what it is given.
    """
    function releaseError(stream: StandardError): Unit;

    """
    No contract: it only frees or closes what it is given.
    """
    function releaseInput(stream: StandardInput): Unit;

    instance ByteOutputStream(StandardOutput);

    instance ByteOutputStream(StandardError);

    instance ByteInputStream(StandardInput);

    """
    Writes text to the standard error with write(2), after the bytes
    writeByte wrote before, so that a line goes out in one piece as far as
    the kernel takes it.  Returns false when the kernel refused a write.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function writeErrorText(stream: &![StandardError, R], text: Span[Nat8, S]): Bool;

    """
    Reads a line from the standard input, up to a carriage return, a line
    feed or the end of the input.  The line end is not part of the result.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function readLine(input: &![StandardInput, R]): String;

    """
    Whether the standard input is a terminal.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function inputIsTerminal(input: &[StandardInput, R]): Bool;

    """
    Whether the standard output is a terminal.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function outputIsTerminal(output: &[StandardOutput, R]): Bool;

    """
    Reads a line from the standard input without showing it, for a
    password.  On a terminal the echo is switched off for the line, as
    readpassphrase(3) does, which drops what was typed before; it is
    switched on again after the line, and a line feed goes to the standard
    error in place of the one not shown.  Input that is no terminal is read
    as readLine reads it.  None when the terminal refused to switch its
    echo off, and then nothing was read.  A signal that ends the programme
    while the echo is off leaves it off.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readHiddenLine(input: &![StandardInput, R]): Option[String];

    """
    The columns of the terminal behind the standard output, or 0 when it is
    none or does not say.  0 is unknown, not narrow: a caller falls back to
    a width of its own.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function terminalWidth(output: &[StandardOutput, R]): Nat32;

    """
    Drops what the terminal at the standard input holds that was not read
    yet, so that a programme started next does not read it.  What this
    process has read ahead into its own buffer stays there.  Does nothing
    for input that is no terminal.  Returns false when the kernel refused.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function drainInput(input: &![StandardInput, R]): Bool;
end module.
