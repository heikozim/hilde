"""
The capability to reach the terminal, and the type classes of byte streams.

- A TerminalCapability is linear and comes only from the root capability.
- Standard.IO.Terminal takes it to hand out the standard output, error and input.
- ByteOutputStream writes one byte to a stream at a time.
- ByteInputStream reads one byte at a time, as an Option, so that a stream can end.

    var terminal: TerminalCapability := acquireTerminal(&!root);
    var output: StandardOutput := acquireOutput(&!terminal);
    writeByte(&!output, 10);
    releaseOutput(output);
    releaseTerminal(terminal);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.IO is
    """
    Terminal access capability.
    """
    type TerminalCapability: Linear;

    """
    Acquire a terminal capability from the root capability.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function acquireTerminal(root: &![RootCapability, R]): TerminalCapability;

    """
    Release the terminal capability.
    No contract: it only frees or closes what it is given.
    """
    function releaseTerminal(term: TerminalCapability): Unit;

    typeclass ByteOutputStream(T: Type) is
        """
        No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
        """
        generic [R: Region]
        method writeByte(stream: &![T, R], byte: Nat8): Unit;
    end;

    typeclass ByteInputStream(T: Type) is
        """
        No contract: an Option result, which an ensures cannot look into.
        """
        generic [R: Region]
        method readByte(stream: &![T, R]): Option[Nat8];
    end;
end module.
