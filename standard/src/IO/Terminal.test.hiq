import Standard.Testing (
    assertSuccess,
    assertTrue
);
import Standard.IO (
    TerminalCapability,
    acquireTerminal,
    releaseTerminal,
    writeByte
);
import Standard.IO.Terminal (
    StandardOutput,
    StandardError,
    StandardInput,
    acquireOutput,
    acquireError,
    acquireInput,
    releaseOutput,
    releaseError,
    releaseInput,
    outputIsTerminal,
    terminalWidth,
    drainInput
);

module body Standard.IO.Terminal.Test is
    -- stdout: writeByte.
    generic [R: Region]
    function testStdoutWriteByte(root: &![RootCapability, R]): Unit is
        var term: TerminalCapability := acquireTerminal(root);
        var stdout: StandardOutput := acquireOutput(&!term);
        writeByte(&!stdout, 'a');
        releaseOutput(stdout);
        releaseTerminal(term);
        assertSuccess("writeByte completed");
        return nil;
    end;

    -- stderr: writeByte.
    generic [R: Region]
    function testStderrWriteByte(root: &![RootCapability, R]): Unit is
        var term: TerminalCapability := acquireTerminal(root);
        var stderr: StandardError := acquireError(&!term);
        writeByte(&!stderr, 'a');
        releaseError(stderr);
        releaseTerminal(term);
        assertSuccess("writeByte completed");
        return nil;
    end;

    -- The width is 0 where the output is no terminal, as under hilde test,
    -- which takes the output; on a terminal it is what the terminal says,
    -- which a pseudo-terminal measures outside this file.  Dropping the
    -- pending input succeeds on a terminal and does nothing elsewhere.
    generic [R: Region]
    function testWidthAndDrain(root: &![RootCapability, R]): Unit is
        var term: TerminalCapability := acquireTerminal(root);
        var stdout: StandardOutput := acquireOutput(&!term);
        var stdin: StandardInput := acquireInput(&!term);
        assertTrue(outputIsTerminal(&stdout) or (terminalWidth(&stdout) = 0), "no terminal has no width");
        assertTrue(drainInput(&!stdin), "dropping pending input succeeds");
        releaseInput(stdin);
        releaseOutput(stdout);
        releaseTerminal(term);
        return nil;
    end;
end module body.
