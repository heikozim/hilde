"""
Regular expressions in linear time.

- Syntax as RE2; each thing it refuses or does differently has a test.
- Time is linear in the length of the input for every pattern.
- Backreferences and lookaround are refused, with a message that names Standard.Pcre.
- A pattern given to compile as a string literal is checked when the programme is compiled.
- A compiled Regex never changes: tasks may search one at once without a lock.
- Positions are byte offsets; matches start and end on UTF-8 boundaries.
- A dot and a class match one code point, not one byte.

    case compile("^[0-9]+-[0-9]+$") of
        when Right(right as regex: Regex) do
            let isRange: Bool := match(&regex, asSpan(&text));
            destroyRegex(regex);
        when Left(left as message: String) do
            reportPattern(message);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.Buffer (
    Buffer
);
import Standard.String (
    String
);

module Standard.Regex is
    """
    A compiled pattern.  Linear, because it owns its program.  It is never
    changed after compile and every search keeps its state to itself, so
    several tasks can search one Regex at once, lent to them through a
    lending scope of Standard.Task.
    """
    type Regex: Linear;

    """
    Compile a pattern.  Right is the compiled pattern; Left is a message
    naming what is wrong and the byte offset where it was found.  A pattern
    is too large when its program passes 100,000 instructions, or when the
    table of captures one search keeps -- two threads per instruction, each
    with a slot for the start and the end of every group -- would pass
    16,777,216 entries.

    A string literal passed here is checked by the compiler as well, so a
    pattern that can never compile does not survive into a programme.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function compile(pattern: Span[Nat8, R]): Either[String, Regex];

    """
    Give back a compiled pattern.
    No contract: it only frees or closes what it is given.
    """
    function destroyRegex(regex: Regex): Unit;

    """
    How many capturing groups the pattern has, not counting the whole match.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function groupCount(regex: &[Regex, R]): Index;

    """
    Is there a match anywhere in the text?  Anchor with ^ and $ (or
    \\A and \\z) to ask about the whole text.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function match(regex: &[Regex, R], text: Span[Nat8, S]): Bool;

    """
    Where a match was found, and where each of its groups was.  Linear.
    """
    type Found: Linear;

    """
    The leftmost match -- and among the matches that start there, the one
    the pattern prefers, as RE2 and Perl choose.  None when there is none.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function find(regex: &[Regex, R], text: Span[Nat8, S]): Option[Found];

    """
    The byte offset where the match starts.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function foundStart(found: &[Found, R]): Index;

    """
    The byte offset just after the match.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function foundEnd(found: &[Found, R]): Index;

    """
    Where group group started -- 1 is the first group, 0 the whole match.
    None when that group took no part in the match, or does not exist.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function groupStart(found: &[Found, R], group: Index): Option[Index];

    """
    Where group group ended.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function groupEnd(found: &[Found, R], group: Index): Option[Index];

    """
    Give back a match.
    No contract: it only frees or closes what it is given.
    """
    function destroyFound(found: Found): Unit;

    """
    Where one match lies: start up to but not including stop.  Free.
    """
    record Hit: Free is
        start: Index;
        stop: Index;
    end;

    """
    Every match, left to right, none overlapping.  An empty match that
    abuts the previous match is skipped, as Go's regexp (RE2's semantics)
    does.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region, S: Region]
    function find_all(regex: &[Regex, R], text: Span[Nat8, S]): Buffer[Hit];

    """
    Replace every match.  In rewrite, \\0 is the whole match, \\1 to
    \\9 are the groups, and \\\\ is one backslash -- RE2's rewrite
    syntax.  Any other backslash is copied as it stands.
    No contract: a text whose length follows its input.
    """
    generic [R: Region, S: Region, T: Region]
    function replace(regex: &[Regex, R], text: Span[Nat8, S], rewrite: Span[Nat8, T]): String;
end module.
