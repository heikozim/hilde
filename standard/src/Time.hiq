-- A safe module: Bindings.Time reads the clocks.
import Bindings.Time (
    wallNanos as bindWallNanos,
    hasMonotonic as bindHasMonotonic,
    monotonicReading
);

module body Standard.Time is
    function wallNanos(): Nat64 is
        return bindWallNanos();
    end;

    function hasMonotonic(): Bool is
        return bindHasMonotonic();
    end;

    function monotonicNanos(): Option[Nat64] is
        let reading: Int64 := monotonicReading();
        if reading < 0 then
            -- No monotonic clock on this build.  hasMonotonic answers the
            -- same question without taking a reading.
            let none: Option[Nat64] := None();
            return none;
        end if;
        return toNat64(reading);
    end;
end module body.
