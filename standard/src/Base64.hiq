import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);

module body Standard.Base64 is
    constant byte_upper_a: Nat8 := 65;
    constant byte_lower_a: Nat8 := 97;
    constant byte_zero: Nat8 := 48;
    constant byte_plus: Nat8 := 43;
    constant byte_slash: Nat8 := 47;
    constant byte_minus: Nat8 := 45;
    constant byte_underscore: Nat8 := 95;
    constant byte_equals: Nat8 := 61;
    constant low_two_bits: Nat8 := 3;
    constant low_four_bits: Nat8 := 15;
    constant low_six_bits: Nat8 := 63;

    -- The character of a six-bit value.
    function letter(value: Nat8): Nat8 is
        if value < 26 then
            return byte_upper_a + value;
        end if;
        if value < 52 then
            return byte_lower_a + (value - 26);
        end if;
        if value < 62 then
            return byte_zero + (value - 52);
        end if;
        if value = 62 then
            return byte_plus;
        end if;
        return byte_slash;
    end;

    -- The six-bit value of a character of the alphabet, None for any other
    -- byte, the padding character among them.
    function valueOf(byte: Nat8): Option[Nat8] is
        if (byte >= byte_upper_a) and (byte < (byte_upper_a + 26)) then
            return Some(value => byte - byte_upper_a);
        end if;
        if (byte >= byte_lower_a) and (byte < (byte_lower_a + 26)) then
            return Some(value => (byte - byte_lower_a) + 26);
        end if;
        if (byte >= byte_zero) and (byte < (byte_zero + 10)) then
            return Some(value => (byte - byte_zero) + 52);
        end if;
        if byte = byte_plus then
            let plus: Nat8 := 62;
            return Some(value => plus);
        end if;
        if byte = byte_slash then
            let slash: Nat8 := 63;
            return Some(value => slash);
        end if;
        return None();
    end;

    -- The value of the character at the given place, or 64 when it is not
    -- in the alphabet.  A private shorthand: every caller checks for 64
    -- before it uses the value, and nothing outside this module sees it.
    generic [R: Region]
    function sixBits(text: Span[Nat8, R], at: Index): Nat8 is
        case valueOf(text[at]) of
            when Some(value as v: Nat8) do
                return v;
            when None do
                return 64;
        end case;
    end;

    generic [R: Region]
    function encodeWith(bytes: Span[Nat8, R], padded: Bool): String is
        let size: Index := spanLength(bytes);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while (i + 3) <= size do
            let a: Nat8 := bytes[i];
            let b: Nat8 := bytes[i + 1];
            let c: Nat8 := bytes[i + 2];
            writeByte(&!builder, letter(a / 4));
            writeByte(&!builder, letter((bitwiseAnd(a, low_two_bits) * 16) + (b / 16)));
            writeByte(&!builder, letter((bitwiseAnd(b, low_four_bits) * 4) + (c / 64)));
            writeByte(&!builder, letter(bitwiseAnd(c, low_six_bits)));
            i := i + 3;
        end while;
        let rest: Index := size - i;
        if rest = 1 then
            let a: Nat8 := bytes[i];
            writeByte(&!builder, letter(a / 4));
            writeByte(&!builder, letter(bitwiseAnd(a, low_two_bits) * 16));
            if padded then
                writeByte(&!builder, byte_equals);
                writeByte(&!builder, byte_equals);
            end if;
        end if;
        if rest = 2 then
            let a: Nat8 := bytes[i];
            let b: Nat8 := bytes[i + 1];
            writeByte(&!builder, letter(a / 4));
            writeByte(&!builder, letter((bitwiseAnd(a, low_two_bits) * 16) + (b / 16)));
            writeByte(&!builder, letter(bitwiseAnd(b, low_four_bits) * 4));
            if padded then
                writeByte(&!builder, byte_equals);
            end if;
        end if;
        return finalize(builder);
    end;

    generic [R: Region]
    function encode(bytes: Span[Nat8, R]): String is
        return encodeWith(bytes, true);
    end;

    generic [R: Region]
    function encodeUnpadded(bytes: Span[Nat8, R]): String is
        return encodeWith(bytes, false);
    end;

    -- Decode the first count characters of text, which hold no padding.
    -- None when a character is not in the alphabet, when count is one more
    -- than a multiple of four, or when the last character carries bits
    -- the bytes do not use.
    generic [R: Region]
    function decodeBody(text: Span[Nat8, R], count: Index): Option[String] is
        let groups: Index := count / 4;
        let rest: Index := count - (groups * 4);
        if rest = 1 then
            return None();
        end if;
        var good: Bool := true;
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while good and ((i + 4) <= count) do
            let a: Nat8 := sixBits(text, i);
            let b: Nat8 := sixBits(text, i + 1);
            let c: Nat8 := sixBits(text, i + 2);
            let d: Nat8 := sixBits(text, i + 3);
            if ((a = 64) or (b = 64)) or ((c = 64) or (d = 64)) then
                good := false;
            else
                writeByte(&!builder, (a * 4) + (b / 16));
                writeByte(&!builder, (bitwiseAnd(b, low_four_bits) * 16) + (c / 4));
                writeByte(&!builder, (bitwiseAnd(c, low_two_bits) * 64) + d);
            end if;
            i := i + 4;
        end while;
        if good and (rest = 2) then
            let a: Nat8 := sixBits(text, i);
            let b: Nat8 := sixBits(text, i + 1);
            if ((a = 64) or (b = 64)) or (bitwiseAnd(b, low_four_bits) /= 0) then
                good := false;
            else
                writeByte(&!builder, (a * 4) + (b / 16));
            end if;
        end if;
        if good and (rest = 3) then
            let a: Nat8 := sixBits(text, i);
            let b: Nat8 := sixBits(text, i + 1);
            let c: Nat8 := sixBits(text, i + 2);
            if ((a = 64) or (b = 64)) or ((c = 64) or (bitwiseAnd(c, low_two_bits) /= 0)) then
                good := false;
            else
                writeByte(&!builder, (a * 4) + (b / 16));
                writeByte(&!builder, (bitwiseAnd(b, low_four_bits) * 16) + (c / 4));
            end if;
        end if;
        let made: String := finalize(builder);
        if good then
            return Some(value => made);
        else
            destroyString(made);
            return None();
        end if;
    end;

    generic [R: Region]
    function decode(text: Span[Nat8, R]): Option[String] is
        let size: Index := spanLength(text);
        if (size - ((size / 4) * 4)) /= 0 then
            return None();
        end if;
        var pads: Index := 0;
        if (size >= 1) and (text[size - 1] = byte_equals) then
            pads := pads + 1;
            if (size >= 2) and (text[size - 2] = byte_equals) then
                pads := pads + 1;
            end if;
        end if;
        -- With the padding taken off, what is left must not be a multiple
        -- of four unless there was none: = stands only where it fills a
        -- group.
        let content: Index := size - pads;
        let rest: Index := content - ((content / 4) * 4);
        if (pads = 1) and (rest /= 3) then
            return None();
        end if;
        if (pads = 2) and (rest /= 2) then
            return None();
        end if;
        return decodeBody(text, content);
    end;

    generic [R: Region]
    function decodeUnpadded(text: Span[Nat8, R]): Option[String] is
        return decodeBody(text, spanLength(text));
    end;

    -- The text with each from byte replaced by to, and every other as it is.
    generic [R: Region]
    function swapped(text: Span[Nat8, R], from_a: Nat8, to_a: Nat8, from_b: Nat8, to_b: Nat8): String is
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < spanLength(text) do
            let byte: Nat8 := text[i];
            if byte = from_a then
                writeByte(&!builder, to_a);
            else if byte = from_b then
                writeByte(&!builder, to_b);
            else
                writeByte(&!builder, byte);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    generic [R: Region]
    function encodeUrl(bytes: Span[Nat8, R]): String is
        let plain: String := encodeWith(bytes, true);
        let url: String := swapped(asSpan(&plain), byte_plus, byte_minus, byte_slash, byte_underscore);
        destroyString(plain);
        return url;
    end;

    generic [R: Region]
    function decodeUrl(text: Span[Nat8, R]): Option[String] is
        var i: Index := 0;
        while i < spanLength(text) do
            if (text[i] = byte_plus) or (text[i] = byte_slash) then
                let none: Option[String] := None();
                return none;
            end if;
            i := i + 1;
        end while;
        let plain: String := swapped(text, byte_minus, byte_plus, byte_underscore, byte_slash);
        let bytes: Option[String] := decode(asSpan(&plain));
        destroyString(plain);
        return bytes;
    end;
end module body.
