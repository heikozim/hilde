-- A safe module.  Decoding follows the plan of Mark Adler's puff.c, the
-- reference decoder in zlib's contrib directory: a canonical code is kept
-- as the number of codes of each length and the symbols in code order,
-- and a symbol is found bit by bit.  The bit reader and the bit writer
-- hold their state in a record passed by reference; the language has no
-- shifts, so a shift is a multiplication or a division by a power of two.
import Standard.String (
    String,
    length as stringLength,
    asSpan,
    destroyString,
    fromByteBuffer
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Buffer (
    Buffer,
    initialize,
    allocateEmpty,
    destroyFree,
    length as bufferLength,
    nth as bufferNth,
    lengthMut as bufferLengthMut,
    nthMut as bufferNthMut,
    storeNth as bufferStore,
    insertBack,
    getSpan as bufferSpan
);

module body Standard.Gzip is
    constant zero_index: Index := 0;
    constant one_index: Index := 1;
    constant zero32: Nat32 := 0;
    constant one32: Nat32 := 1;
    constant two32: Nat32 := 2;
    constant eight32: Nat32 := 8;
    constant byte_weight: Nat32 := 128;
    constant byte_span: Nat32 := 256;
    constant zero_i32: Int32 := 0;
    constant one_i32: Int32 := 1;
    constant minus_one: Int32 := -1;
    constant minus_two: Int32 := -2;
    constant no_position: Int64 := -1;
    constant crc_polynomial: Nat32 := 3988292384;
    constant all_ones: Nat32 := 4294967295;
    constant window: Index := 32768;
    constant hash_size: Index := 32768;
    constant min_match: Index := 3;
    constant max_match: Index := 258;
    constant max_chain: Index := 128;
    constant stored_most: Index := 65535;
    constant size_modulus: Nat64 := 4294967296;
    constant max_bits: Index := 15;
    constant low_byte: Nat32 := 255;
    constant low_word: Nat32 := 65535;
    -- Failures inside the module, turned into GzipFailure at the edge.
    constant ok: Nat8 := 0;
    constant fail_truncated: Nat8 := 1;
    constant fail_bad: Nat8 := 2;
    constant fail_large: Nat8 := 3;

    ---
    --- Conversions of values the callers have checked
    ---

    -- The length modulo 4294967296, as the trailer of gzip keeps it.  It is
    -- taken in Nat64, so that it holds where Index has 32 bits as well as
    -- where it has 64.
    function trailerLength(value: Index): Nat32 is
        case toNat64(value) of
            when Some(value as wide: Nat64) do
                case toNat32(rem(wide, size_modulus)) of
                    when Some(value as narrow: Nat32) do
                        return narrow;
                    when None do
                        abort("Standard.Gzip: a length modulo 4294967296 did not fit a Nat32");
                end case;
            when None do
                abort("Standard.Gzip: an Index did not fit a Nat64");
        end case;
    end;

    function natOf(value: Index): Nat32 is
        case toNat32(value) of
            when Some(value as narrow: Nat32) do
                return narrow;
            when None do
                abort("Standard.Gzip: a checked Index did not fit a Nat32");
        end case;
    end;

    function indexOf(value: Nat32): Index is
        case toIndex(value) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                abort("Standard.Gzip: a Nat32 did not fit an Index");
        end case;
    end;

    function indexOfSigned(value: Int32): Index is
        case toIndex(value) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                abort("Standard.Gzip: a negative Int32 was used as an Index");
        end case;
    end;

    function signedOf(value: Nat32): Int32 is
        case toInt32(value) of
            when Some(value as narrow: Int32) do
                return narrow;
            when None do
                abort("Standard.Gzip: a checked Nat32 did not fit an Int32");
        end case;
    end;

    function byteOf(value: Nat32): Nat8 is
        case toNat8(value) of
            when Some(value as narrow: Nat8) do
                return narrow;
            when None do
                abort("Standard.Gzip: a checked value did not fit a byte");
        end case;
    end;

    function wideByte(value: Nat8): Nat32 is
        case toNat32(value) of
            when Some(value as wide: Nat32) do
                return wide;
            when None do
                abort("Standard.Gzip: a byte did not fit a Nat32");
        end case;
    end;

    function positionOf(value: Index): Int64 is
        case toInt64(value) of
            when Some(value as wide: Int64) do
                return wide;
            when None do
                abort("Standard.Gzip: an Index did not fit an Int64");
        end case;
    end;

    function indexOfPosition(value: Int64): Index is
        case toIndex(value) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                abort("Standard.Gzip: a negative position was used as an Index");
        end case;
    end;

    -- Two to the power count, for count up to 31.
    function powerOfTwo(count: Nat32): Nat32 is
        var value: Nat32 := one32;
        var i: Nat32 := zero32;
        while i < count do
            value := value * two32;
            i := i + one32;
        end while;
        return value;
    end;

    ---
    --- CRC-32
    ---

    function crcTable(): Buffer[Nat32] is
        var table: Buffer[Nat32] := initialize(indexOf(byte_span), zero32);
        var n: Nat32 := zero32;
        while n < byte_span do
            var c: Nat32 := n;
            var k: Nat32 := zero32;
            while k < eight32 do
                if bitwiseAnd(c, one32) = one32 then
                    c := bitwiseXor(crc_polynomial, c / two32);
                else
                    c := c / two32;
                end if;
                k := k + one32;
            end while;
            bufferStore(&!table, indexOf(n), c);
            n := n + one32;
        end while;
        return table;
    end;

    -- crc carried on over count bytes of data from start, with table.
    generic [R: Region, T: Region]
    function crcRange(table: &[Buffer[Nat32], T], crc: Nat32, data: Span[Nat8, R], start: Index, count: Index): Nat32 is
        var c: Nat32 := bitwiseXor(crc, all_ones);
        var i: Index := zero_index;
        while i < count do
            let slot: Nat32 := bitwiseAnd(bitwiseXor(c, wideByte(data[start + i])), low_byte);
            c := bitwiseXor(bufferNth(table, indexOf(slot)), c / byte_span);
            i := i + 1;
        end while;
        return bitwiseXor(c, all_ones);
    end;

    generic [R: Region]
    function crc32(data: Span[Nat8, R]): Nat32 is
        let table: Buffer[Nat32] := crcTable();
        let crc: Nat32 := crcRange(&table, zero32, data, zero_index, spanLength(data));
        destroyFree(table);
        return crc;
    end;

    ---
    --- Reading bits
    ---

    -- The next byte of the input is at, cur holds the bits of the byte
    -- before it that are not read yet, left how many; past is set when a
    -- read went beyond the end, and the bits read then are 0.
    record Reader: Free is
        at: Index;
        cur: Nat32;
        left: Nat32;
        past: Bool;
    end;

    generic [R: Region, S: Region]
    function getBit(data: Span[Nat8, S], reader: &![Reader, R]): Nat32 is
        if reader->left = zero32 then
            if reader->at < spanLength(data) then
                reader->cur := wideByte(data[reader->at]);
                reader->at := reader->at + 1;
                reader->left := eight32;
            else
                reader->past := true;
                return zero32;
            end if;
        end if;
        let bit: Nat32 := bitwiseAnd(reader->cur, one32);
        reader->cur := reader->cur / two32;
        reader->left := reader->left - one32;
        return bit;
    end;

    -- count bits, the first read the lowest, as RFC 1951 packs numbers.
    generic [R: Region, S: Region]
    function getBits(data: Span[Nat8, S], reader: &![Reader, R], count: Nat32): Nat32 is
        var value: Nat32 := zero32;
        var weight: Nat32 := one32;
        var i: Nat32 := zero32;
        while i < count do
            value := value + (getBit(data, &~reader) * weight);
            weight := weight * two32;
            i := i + one32;
        end while;
        return value;
    end;

    ---
    --- Canonical codes
    ---

    record Huffman: Linear is
        counts: Buffer[Nat32];
        symbols: Buffer[Nat32];
    end;

    -- A code and how complete it is: 0 complete, above 0 incomplete,
    -- below 0 over-subscribed, as puff's construct answers.
    record Built: Linear is
        code: Huffman;
        left: Int32;
    end;

    function destroyHuffman(code: Huffman): Unit is
        let { counts: Buffer[Nat32], symbols: Buffer[Nat32] } := code;
        destroyFree(counts);
        destroyFree(symbols);
        return nil;
    end;

    function destroyBuilt(built: Built): Unit is
        let { code: Huffman, left: Int32 } := built;
        destroyHuffman(code);
        return nil;
    end;

    generic [R: Region]
    function builtLeft(built: &[Built, R]): Int32 is
        return built->left;
    end;

    generic [R: Region]
    function codeOf(built: &[Built, R]): &[Huffman, R] is
        return &(built->code);
    end;

    -- The code whose lengths are the count entries of lengths from start.
    generic [R: Region]
    function construct(lengths: &[Buffer[Nat32], R], start: Index, count: Index): Built is
        var counts: Buffer[Nat32] := initialize(max_bits + 1, zero32);
        var symbol: Index := zero_index;
        while symbol < count do
            let slot: Index := indexOf(bufferNth(lengths, start + symbol));
            let counted: Nat32 := bufferNthMut(&!counts, slot) + one32;
            bufferStore(&!counts, slot, counted);
            symbol := symbol + 1;
        end while;
        var left: Int32 := one_i32;
        var size: Index := one_index;
        var over: Bool := false;
        while size <= max_bits do
            left := left * 2;
            left := left - signedOf(bufferNthMut(&!counts, size));
            if left < zero_i32 then
                over := true;
            end if;
            size := size + 1;
        end while;
        var offsets: Buffer[Nat32] := initialize(max_bits + 1, zero32);
        size := one_index;
        while size < max_bits do
            let next: Nat32 := bufferNthMut(&!offsets, size) + bufferNthMut(&!counts, size);
            bufferStore(&!offsets, size + 1, next);
            size := size + 1;
        end while;
        var symbols: Buffer[Nat32] := initialize(count + 1, zero32);
        if not over then
            symbol := zero_index;
            while symbol < count do
                let length: Index := indexOf(bufferNth(lengths, start + symbol));
                if length /= zero_index then
                    let place: Index := indexOf(bufferNthMut(&!offsets, length));
                    bufferStore(&!symbols, place, natOf(symbol));
                    let moved: Nat32 := bufferNthMut(&!offsets, length) + one32;
                    bufferStore(&!offsets, length, moved);
                end if;
                symbol := symbol + 1;
            end while;
        end if;
        destroyFree(offsets);
        if over then
            left := minus_one;
        end if;
        return Built(code => Huffman(counts => counts, symbols => symbols), left => left);
    end;

    -- The next symbol of code, -1 when no code matches, -2 when the input
    -- ended.
    generic [R: Region, S: Region, H: Region]
    function decode(data: Span[Nat8, S], reader: &![Reader, R], code: &[Huffman, H]): Int32 is
        var bits: Int32 := zero_i32;
        var first: Int32 := zero_i32;
        var index: Int32 := zero_i32;
        var size: Index := one_index;
        while size <= max_bits do
            bits := bits + signedOf(getBit(data, &~reader));
            if reader->past then
                return minus_two;
            end if;
            let count: Int32 := signedOf(bufferNth(&(code->counts), size));
            if bits < (first + count) then
                return signedOf(bufferNth(&(code->symbols), indexOfSigned(index + (bits - first))));
            end if;
            index := index + count;
            first := (first + count) * 2;
            bits := bits * 2;
            size := size + 1;
        end while;
        return minus_one;
    end;

    ---
    --- The tables of lengths and distances
    ---

    -- The extra bits and the bases of the 29 length codes and the 30
    -- distance codes of RFC 1951 section 3.2.5, computed from the rule
    -- that each base is the one before plus the range of its extra bits.
    record Tables: Linear is
        lengthExtra: Buffer[Nat32];
        lengthBase: Buffer[Nat32];
        distanceExtra: Buffer[Nat32];
        distanceBase: Buffer[Nat32];
    end;

    function makeTables(): Tables is
        let length_codes: Index := 29;
        let distance_codes: Index := 30;
        var length_extra: Buffer[Nat32] := initialize(length_codes, zero32);
        var length_base: Buffer[Nat32] := initialize(length_codes, zero32);
        var i: Index := zero_index;
        let first_length: Nat32 := 3;
        bufferStore(&!length_base, zero_index, first_length);
        while i < length_codes do
            if (i >= 8) and (i < 28) then
                bufferStore(&!length_extra, i, natOf((i - 4) / 4));
            end if;
            if (i > zero_index) and (i < 28) then
                let before: Nat32 := bufferNthMut(&!length_base, i - 1);
                bufferStore(&!length_base, i, before + powerOfTwo(bufferNthMut(&!length_extra, i - 1)));
            end if;
            i := i + 1;
        end while;
        let longest: Nat32 := 258;
        bufferStore(&!length_base, 28, longest);
        var distance_extra: Buffer[Nat32] := initialize(distance_codes, zero32);
        var distance_base: Buffer[Nat32] := initialize(distance_codes, zero32);
        bufferStore(&!distance_base, zero_index, one32);
        i := zero_index;
        while i < distance_codes do
            if i >= 4 then
                bufferStore(&!distance_extra, i, natOf((i - 2) / 2));
            end if;
            if i > zero_index then
                let before: Nat32 := bufferNthMut(&!distance_base, i - 1);
                bufferStore(&!distance_base, i, before + powerOfTwo(bufferNthMut(&!distance_extra, i - 1)));
            end if;
            i := i + 1;
        end while;
        return Tables(lengthExtra => length_extra, lengthBase => length_base, distanceExtra => distance_extra, distanceBase => distance_base);
    end;

    function destroyTables(tables: Tables): Unit is
        let { lengthExtra as length_extra: Buffer[Nat32], lengthBase as length_base: Buffer[Nat32], distanceExtra as distance_extra: Buffer[Nat32], distanceBase as distance_base: Buffer[Nat32] } := tables;
        destroyFree(length_extra);
        destroyFree(length_base);
        destroyFree(distance_extra);
        destroyFree(distance_base);
        return nil;
    end;

    ---
    --- Inflating
    ---

    -- One byte more of output, or false when it would pass the limit.
    generic [R: Region]
    function putOut(out: &![Buffer[Nat8], R], limit: Index, byte: Nat8): Bool is
        if bufferLengthMut(&~out) >= limit then
            return false;
        end if;
        insertBack(&~out, byte);
        return true;
    end;

    -- A stored block: its length and the length's complement, then the
    -- bytes.  The bits left of the current byte are dropped.
    generic [R: Region, S: Region, O: Region]
    function stored(data: Span[Nat8, S], reader: &![Reader, R], out: &![Buffer[Nat8], O], limit: Index): Nat8 is
        reader->left := zero32;
        let at: Index := reader->at;
        if (at + 4) > spanLength(data) then
            return fail_truncated;
        end if;
        let size: Nat32 := wideByte(data[at]) + (wideByte(data[at + 1]) * byte_span);
        let complement: Nat32 := wideByte(data[at + 2]) + (wideByte(data[at + 3]) * byte_span);
        if bitwiseXor(size, complement) /= low_word then
            return fail_bad;
        end if;
        let count: Index := indexOf(size);
        if ((at + 4) + count) > spanLength(data) then
            return fail_truncated;
        end if;
        var i: Index := zero_index;
        while i < count do
            if not putOut(&~out, limit, data[(at + 4) + i]) then
                return fail_large;
            end if;
            i := i + 1;
        end while;
        reader->at := (at + 4) + count;
        return ok;
    end;

    -- The symbols of a block with the codes given, up to its end.  start
    -- is where this stream's output began: a distance may not reach
    -- before it.
    generic [R: Region, S: Region, O: Region, L: Region, D: Region, T: Region]
    function codes(data: Span[Nat8, S], reader: &![Reader, R], out: &![Buffer[Nat8], O], limit: Index, start: Index, length_code: &[Huffman, L], distance_code: &[Huffman, D], tables: &[Tables, T]): Nat8 is
        let end_of_block: Int32 := 256;
        let first_length_symbol: Int32 := 257;
        let length_codes: Int32 := 29;
        let distance_codes: Int32 := 30;
        while true do
            let symbol: Int32 := decode(data, &~reader, length_code);
            if symbol = minus_two then
                return fail_truncated;
            end if;
            if symbol < zero_i32 then
                return fail_bad;
            end if;
            if symbol < end_of_block then
                if not putOut(&~out, limit, byteOf(natOf(indexOfSigned(symbol)))) then
                    return fail_large;
                end if;
            else
                if symbol = end_of_block then
                    return ok;
                end if;
                let length_index: Int32 := symbol - first_length_symbol;
                if length_index >= length_codes then
                    return fail_bad;
                end if;
                let li: Index := indexOfSigned(length_index);
                let length: Index := indexOf(bufferNth(&(tables->lengthBase), li) + getBits(data, &~reader, bufferNth(&(tables->lengthExtra), li)));
                let distance_symbol: Int32 := decode(data, &~reader, distance_code);
                if distance_symbol = minus_two then
                    return fail_truncated;
                end if;
                if (distance_symbol < zero_i32) or (distance_symbol >= distance_codes) then
                    return fail_bad;
                end if;
                let di: Index := indexOfSigned(distance_symbol);
                let distance: Index := indexOf(bufferNth(&(tables->distanceBase), di) + getBits(data, &~reader, bufferNth(&(tables->distanceExtra), di)));
                if reader->past then
                    return fail_truncated;
                end if;
                let made: Index := bufferLengthMut(&~out);
                if distance > (made - start) then
                    return fail_bad;
                end if;
                var k: Index := zero_index;
                while k < length do
                    let size: Index := bufferLengthMut(&~out);
                    let byte: Nat8 := bufferNthMut(&~out, size - distance);
                    if not putOut(&~out, limit, byte) then
                        return fail_large;
                    end if;
                    k := k + 1;
                end while;
            end if;
        end while;
        return fail_bad;
    end;

    -- The code lengths of the fixed codes of RFC 1951 section 3.2.6: the
    -- 288 literal and length symbols, then the 30 distances.
    function fixedLengths(): Buffer[Nat32] is
        let seven: Nat32 := 7;
        let nine: Nat32 := 9;
        let five: Nat32 := 5;
        let distance_start: Index := 288;
        var lengths: Buffer[Nat32] := initialize(318, eight32);
        var i: Index := 144;
        while i < 256 do
            bufferStore(&!lengths, i, nine);
            i := i + 1;
        end while;
        while i < 280 do
            bufferStore(&!lengths, i, seven);
            i := i + 1;
        end while;
        i := distance_start;
        while i < 318 do
            bufferStore(&!lengths, i, five);
            i := i + 1;
        end while;
        return lengths;
    end;

    generic [R: Region, S: Region, O: Region, T: Region]
    function fixedBlock(data: Span[Nat8, S], reader: &![Reader, R], out: &![Buffer[Nat8], O], limit: Index, start: Index, tables: &[Tables, T]): Nat8 is
        let lengths: Buffer[Nat32] := fixedLengths();
        let literals: Built := construct(&lengths, zero_index, 288);
        let distances: Built := construct(&lengths, 288, 30);
        destroyFree(lengths);
        let result: Nat8 := codes(data, &~reader, &~out, limit, start, codeOf(&literals), codeOf(&distances), tables);
        destroyBuilt(literals);
        destroyBuilt(distances);
        return result;
    end;

    -- Whether a built code may be used: complete, or incomplete with one
    -- code only, which RFC 1951 allows for a block of one symbol.
    generic [R: Region]
    function usable(built: &[Built, R], count: Index): Bool is
        let left: Int32 := built->left;
        if left < zero_i32 then
            return false;
        end if;
        if left = zero_i32 then
            return true;
        end if;
        let unused: Index := indexOf(bufferNth(&(built->code->counts), zero_index));
        return (count - unused) = 1;
    end;

    -- The order the code length code's lengths come in, RFC 1951 section
    -- 3.2.7, one letter each: A for 0, B for 1 and so on.
    function lengthOrder(): Span[Nat8, Static] is
        return "QRSAIHJGKFLEMDNCOBP";
    end;

    generic [R: Region, S: Region, O: Region, T: Region]
    function dynamicBlock(data: Span[Nat8, S], reader: &![Reader, R], out: &![Buffer[Nat8], O], limit: Index, start: Index, tables: &[Tables, T]): Nat8 is
        let five: Nat32 := 5;
        let four: Nat32 := 4;
        let three: Nat32 := 3;
        let two: Nat32 := 2;
        let seven: Nat32 := 7;
        let literal_count: Index := indexOf(getBits(data, &~reader, five)) + 257;
        let distance_count: Index := indexOf(getBits(data, &~reader, five)) + 1;
        let length_code_count: Index := indexOf(getBits(data, &~reader, four)) + 4;
        if reader->past then
            return fail_truncated;
        end if;
        if (literal_count > 286) or (distance_count > 30) then
            return fail_bad;
        end if;
        let order: Span[Nat8, Static] := lengthOrder();
        var lengths: Buffer[Nat32] := initialize(320, zero32);
        var i: Index := zero_index;
        while i < length_code_count do
            let place: Index := indexOf(wideByte(order[i] - 'A'));
            bufferStore(&!lengths, place, getBits(data, &~reader, three));
            i := i + 1;
        end while;
        var bad: Nat8 := ok;
        if reader->past then
            bad := fail_truncated;
        end if;
        -- The lengths of both codes, read with the code length code.
        let total: Index := literal_count + distance_count;
        if bad = ok then
            let length_lengths: Built := construct(&lengths, zero_index, 19);
            if builtLeft(&length_lengths) /= zero_i32 then
                bad := fail_bad;
            end if;
            var filled: Index := zero_index;
            while (filled < total) and (bad = ok) do
                let symbol: Int32 := decode(data, &~reader, codeOf(&length_lengths));
                if symbol = minus_two then
                    bad := fail_truncated;
                else
                    if symbol < zero_i32 then
                        bad := fail_bad;
                    else
                        if symbol < 16 then
                            bufferStore(&!lengths, filled, natOf(indexOfSigned(symbol)));
                            filled := filled + 1;
                        else
                            var value: Nat32 := zero32;
                            var repeat: Index := zero_index;
                            if symbol = 16 then
                                if filled = zero_index then
                                    bad := fail_bad;
                                else
                                    value := bufferNthMut(&!lengths, filled - 1);
                                    repeat := indexOf(getBits(data, &~reader, two)) + 3;
                                end if;
                            else
                                if symbol = 17 then
                                    repeat := indexOf(getBits(data, &~reader, three)) + 3;
                                else
                                    repeat := indexOf(getBits(data, &~reader, seven)) + 11;
                                end if;
                            end if;
                            if (bad = ok) and ((filled + repeat) > total) then
                                bad := fail_bad;
                            end if;
                            while (bad = ok) and (repeat > zero_index) do
                                bufferStore(&!lengths, filled, value);
                                filled := filled + 1;
                                repeat := repeat - 1;
                            end while;
                        end if;
                    end if;
                end if;
            end while;
            destroyBuilt(length_lengths);
        end if;
        if (bad = ok) and reader->past then
            bad := fail_truncated;
        end if;
        if (bad = ok) and (bufferNthMut(&!lengths, 256) = zero32) then
            -- No code for the end of the block.
            bad := fail_bad;
        end if;
        var result: Nat8 := bad;
        if bad = ok then
            let literals: Built := construct(&lengths, zero_index, literal_count);
            let distances: Built := construct(&lengths, literal_count, distance_count);
            if usable(&literals, literal_count) and usable(&distances, distance_count) then
                result := codes(data, &~reader, &~out, limit, start, codeOf(&literals), codeOf(&distances), tables);
            else
                result := fail_bad;
            end if;
            destroyBuilt(literals);
            destroyBuilt(distances);
        end if;
        destroyFree(lengths);
        return result;
    end;

    -- One whole DEFLATE stream from reader's place, into out.
    generic [R: Region, S: Region, O: Region]
    function inflateStream(data: Span[Nat8, S], reader: &![Reader, R], out: &![Buffer[Nat8], O], limit: Index): Nat8 is
        let tables: Tables := makeTables();
        let start: Index := bufferLengthMut(&~out);
        let two: Nat32 := 2;
        var result: Nat8 := ok;
        var last: Bool := false;
        while (result = ok) and (not last) do
            last := (getBit(data, &~reader) = one32);
            let kind: Nat32 := getBits(data, &~reader, two);
            if reader->past then
                result := fail_truncated;
            else
                if kind = zero32 then
                    result := stored(data, &~reader, &~out, limit);
                else
                    if kind = one32 then
                        result := fixedBlock(data, &~reader, &~out, limit, start, &tables);
                    else
                        if kind = two then
                            result := dynamicBlock(data, &~reader, &~out, limit, start, &tables);
                        else
                            result := fail_bad;
                        end if;
                    end if;
                end if;
            end if;
        end while;
        destroyTables(tables);
        return result;
    end;

    function failureOf(code: Nat8): GzipFailure is
        if code = fail_truncated then
            return Truncated();
        end if;
        if code = fail_large then
            return TooLarge();
        end if;
        return BadData();
    end;

    function refused(failure: GzipFailure): Either[GzipFailure, String] is
        let answer: Either[GzipFailure, String] := Left(left => failure);
        return answer;
    end;

    generic [R: Region]
    function inflateRaw(data: Span[Nat8, R], limit: Index): Either[GzipFailure, String] is
        var reader: Reader := Reader(at => zero_index, cur => zero32, left => zero32, past => false);
        var out: Buffer[Nat8] := allocateEmpty();
        let result: Nat8 := inflateStream(data, &!reader, &!out, limit);
        if result /= ok then
            destroyFree(out);
            return refused(failureOf(result));
        else
            if reader.at /= spanLength(data) then
                destroyFree(out);
                return refused(TrailingData());
            else
                let text: String := fromByteBuffer(out);
                return Right(right => text);
            end if;
        end if;
    end;

    ---
    --- The gzip member
    ---

    -- The Nat32 of four bytes of data from at, the lowest first.
    generic [R: Region]
    function readWord(data: Span[Nat8, R], at: Index): Nat32 is
        let b0: Nat32 := wideByte(data[at]);
        let b1: Nat32 := wideByte(data[at + 1]) * byte_span;
        let b2: Nat32 := (wideByte(data[at + 2]) * byte_span) * byte_span;
        let b3: Nat32 := ((wideByte(data[at + 3]) * byte_span) * byte_span) * byte_span;
        return ((b0 + b1) + b2) + b3;
    end;

    -- The place after a zero-terminated field from at, or the length of
    -- data when there is no zero byte.
    generic [R: Region]
    function afterZero(data: Span[Nat8, R], at: Index): Index is
        let size: Index := spanLength(data);
        var i: Index := at;
        while i < size do
            if data[i] = 0 then
                return i + 1;
            end if;
            i := i + 1;
        end while;
        return size;
    end;

    -- The header of a member from at: where its DEFLATE stream begins, or
    -- a failure.  ok in the first field means the second holds the place.
    record Header: Free is
        failure: Nat8;
        place: Index;
        notGzip: Bool;
        checksum: Bool;
    end;

    generic [R: Region, T: Region]
    function readHeader(data: Span[Nat8, R], at: Index, table: &[Buffer[Nat32], T]): Header is
        let size: Index := spanLength(data);
        let reserved_flags: Nat8 := 224;
        let flag_crc: Nat8 := 2;
        let flag_extra: Nat8 := 4;
        let flag_name: Nat8 := 8;
        let flag_comment: Nat8 := 16;
        -- Each byte is looked at only once the length has been checked.
        if (at + 2) > size then
            return Header(failure => fail_bad, place => at, notGzip => true, checksum => false);
        end if;
        if (data[at] /= 31) or (data[at + 1] /= 139) then
            return Header(failure => fail_bad, place => at, notGzip => true, checksum => false);
        end if;
        if (at + 10) > size then
            return Header(failure => fail_truncated, place => at, notGzip => false, checksum => false);
        end if;
        let flags: Nat8 := data[at + 3];
        if (data[at + 2] /= 8) or (bitwiseAnd(flags, reserved_flags) /= 0) then
            return Header(failure => fail_bad, place => at, notGzip => true, checksum => false);
        end if;
        var place: Index := at + 10;
        if bitwiseAnd(flags, flag_extra) /= 0 then
            if (place + 2) > size then
                return Header(failure => fail_truncated, place => at, notGzip => false, checksum => false);
            end if;
            let extra: Index := indexOf(wideByte(data[place]) + (wideByte(data[place + 1]) * byte_span));
            place := (place + 2) + extra;
        end if;
        if bitwiseAnd(flags, flag_name) /= 0 then
            place := afterZero(data, place);
        end if;
        if bitwiseAnd(flags, flag_comment) /= 0 then
            place := afterZero(data, place);
        end if;
        if bitwiseAnd(flags, flag_crc) /= 0 then
            if (place + 2) > size then
                return Header(failure => fail_truncated, place => at, notGzip => false, checksum => false);
            end if;
            let stated: Nat32 := wideByte(data[place]) + (wideByte(data[place + 1]) * byte_span);
            let computed: Nat32 := bitwiseAnd(crcRange(table, zero32, data, at, place - at), low_word);
            if stated /= computed then
                return Header(failure => fail_bad, place => at, notGzip => false, checksum => true);
            end if;
            place := place + 2;
        end if;
        if place > size then
            return Header(failure => fail_truncated, place => at, notGzip => false, checksum => false);
        end if;
        return Header(failure => ok, place => place, notGzip => false, checksum => false);
    end;

    -- The CRC-32 of the bytes of out from start up to, not including,
    -- final.
    generic [O: Region, T: Region]
    function crcOfBuffer(table: &[Buffer[Nat32], T], out: &[Buffer[Nat8], O], start: Index, final: Index): Nat32 is
        var c: Nat32 := all_ones;
        var i: Index := start;
        while i < final do
            let slot: Nat32 := bitwiseAnd(bitwiseXor(c, wideByte(bufferNth(out, i))), low_byte);
            c := bitwiseXor(bufferNth(table, indexOf(slot)), c / byte_span);
            i := i + 1;
        end while;
        return bitwiseXor(c, all_ones);
    end;

    generic [R: Region]
    function gunzip(data: Span[Nat8, R], limit: Index): Either[GzipFailure, String] is
        let size: Index := spanLength(data);
        let table: Buffer[Nat32] := crcTable();
        var out: Buffer[Nat8] := allocateEmpty();
        var at: Index := zero_index;
        var members: Index := zero_index;
        var failure: Option[GzipFailure] := None();
        while (at < size) or (members = zero_index) do
            let header: Header := readHeader(data, at, &table);
            if header.failure /= ok then
                if header.notGzip then
                    if members = zero_index then
                        failure := Some(value => NotGzip());
                    else
                        failure := Some(value => TrailingData());
                    end if;
                else
                    if header.checksum then
                        failure := Some(value => BadChecksum());
                    else
                        failure := Some(value => failureOf(header.failure));
                    end if;
                end if;
                at := size;
                members := members + 1;
            else
                let start: Index := bufferLengthMut(&!out);
                var reader: Reader := Reader(at => header.place, cur => zero32, left => zero32, past => false);
                let result: Nat8 := inflateStream(data, &!reader, &!out, limit);
                if result /= ok then
                    failure := Some(value => failureOf(result));
                    at := size;
                else
                    let trailer: Index := reader.at;
                    if (trailer + 8) > size then
                        failure := Some(value => Truncated());
                        at := size;
                    else
                        let made: Index := bufferLengthMut(&!out);
                        var crc: Nat32 := zero32;
                        if made > start then
                            crc := crcOfBuffer(&table, &out, start, made);
                        end if;
                        let length: Nat32 := trailerLength(made - start);
                        if (crc /= readWord(data, trailer)) or (length /= readWord(data, trailer + 4)) then
                            failure := Some(value => BadChecksum());
                            at := size;
                        else
                            at := trailer + 8;
                        end if;
                    end if;
                end if;
                members := members + 1;
            end if;
        end while;
        destroyFree(table);
        case failure of
            when Some(value as failed: GzipFailure) do
                destroyFree(out);
                return refused(failed);
            when None do
                let text: String := fromByteBuffer(out);
                return Right(right => text);
        end case;
    end;

    ---
    --- Writing bits
    ---

    record Writer: Linear is
        out: StringBuilder;
        cur: Nat32;
        weight: Nat32;
    end;

    function makeWriter(): Writer is
        return Writer(out => makeStringBuilder(), cur => zero32, weight => one32);
    end;

    generic [R: Region]
    function emitByte(writer: &![Writer, R], byte: Nat8): Unit is
        writeByte(&!(writer->out), byte);
        return nil;
    end;

    generic [R: Region]
    function putBit(writer: &![Writer, R], bit: Nat32): Unit is
        writer->cur := writer->cur + (bit * writer->weight);
        if writer->weight = byte_weight then
            let full: Nat8 := byteOf(writer->cur);
            writer->cur := zero32;
            writer->weight := one32;
            emitByte(&~writer, full);
        else
            writer->weight := writer->weight * two32;
        end if;
        return nil;
    end;

    -- count bits of value, the lowest first.
    generic [R: Region]
    function putBits(writer: &![Writer, R], value: Nat32, count: Nat32): Unit is
        var rest: Nat32 := value;
        var i: Nat32 := zero32;
        while i < count do
            putBit(&~writer, rem(rest, two32));
            rest := rest / two32;
            i := i + one32;
        end while;
        return nil;
    end;

    -- A code of length bits, the highest first, as Huffman codes go.
    generic [R: Region]
    function putCode(writer: &![Writer, R], code: Nat32, length: Nat32): Unit is
        var mask: Nat32 := powerOfTwo(length - one32);
        while mask > zero32 do
            putBit(&~writer, rem(code / mask, two32));
            mask := mask / two32;
        end while;
        return nil;
    end;

    -- The partial byte written out, padded with zero bits.
    generic [R: Region]
    function align(writer: &![Writer, R]): Unit is
        if writer->weight /= one32 then
            let full: Nat8 := byteOf(writer->cur);
            writer->cur := zero32;
            writer->weight := one32;
            emitByte(&~writer, full);
        end if;
        return nil;
    end;

    function finishWriter(writer: Writer): String is
        var open: Writer := writer;
        align(&!open);
        let { out: StringBuilder, cur: Nat32, weight: Nat32 } := open;
        return finalize(out);
    end;

    -- A literal or length symbol in the fixed code.
    generic [R: Region]
    function putSymbol(writer: &![Writer, R], symbol: Nat32): Unit is
        if symbol <= 143 then
            putCode(writer, symbol + 48, eight32);
        else
            if symbol <= 255 then
                putCode(writer, (symbol - 144) + 400, 9);
            else
                if symbol <= 279 then
                    putCode(writer, symbol - 256, 7);
                else
                    putCode(writer, (symbol - 280) + 192, eight32);
                end if;
            end if;
        end if;
        return nil;
    end;

    -- The largest index of bases whose value is not above value.
    generic [R: Region]
    function codeFor(bases: &[Buffer[Nat32], R], value: Nat32): Index is
        var i: Index := bufferLength(bases);
        while i > zero_index do
            i := i - 1;
            if bufferNth(bases, i) <= value then
                return i;
            end if;
        end while;
        return zero_index;
    end;

    generic [R: Region, T: Region]
    function putMatch(writer: &![Writer, R], tables: &[Tables, T], length: Index, distance: Index): Unit is
        let five: Nat32 := 5;
        let length_value: Nat32 := natOf(length);
        let li: Index := codeFor(&(tables->lengthBase), length_value);
        putSymbol(&~writer, natOf(li) + 257);
        putBits(&~writer, length_value - bufferNth(&(tables->lengthBase), li), bufferNth(&(tables->lengthExtra), li));
        let distance_value: Nat32 := natOf(distance);
        let di: Index := codeFor(&(tables->distanceBase), distance_value);
        putCode(&~writer, natOf(di), five);
        putBits(&~writer, distance_value - bufferNth(&(tables->distanceBase), di), bufferNth(&(tables->distanceExtra), di));
        return nil;
    end;

    ---
    --- Deflating
    ---

    generic [R: Region]
    function hashAt(data: Span[Nat8, R], at: Index): Index is
        let a: Index := indexOf(wideByte(data[at]));
        let b: Index := indexOf(wideByte(data[at + 1]));
        let c: Index := indexOf(wideByte(data[at + 2]));
        return rem(((a * 1024) + (b * 32)) + c, hash_size);
    end;

    -- How many bytes from candidate equal those from at, at most 258 and
    -- never past the end.
    generic [R: Region]
    function matchLength(data: Span[Nat8, R], candidate: Index, at: Index): Index is
        let size: Index := spanLength(data);
        var most: Index := max_match;
        if (size - at) < most then
            most := size - at;
        end if;
        var n: Index := zero_index;
        var going: Bool := true;
        while going and (n < most) do
            -- Indexed only below most, whichever way the condition above
            -- is evaluated.
            if data[candidate + n] = data[at + n] then
                n := n + 1;
            else
                going := false;
            end if;
        end while;
        return n;
    end;

    -- Puts at into the chains of its hash.
    generic [R: Region, H: Region, P: Region]
    function insertAt(data: Span[Nat8, R], at: Index, head: &![Buffer[Int64], H], previous: &![Buffer[Int64], P]): Unit is
        if (at + 2) < spanLength(data) then
            let hash: Index := hashAt(data, at);
            bufferStore(&~previous, rem(at, window), bufferNthMut(&~head, hash));
            bufferStore(&~head, hash, positionOf(at));
        end if;
        return nil;
    end;

    -- data as one final block of the fixed code, matches found through
    -- the hash chains over the window of 32 KiB, greedy.
    generic [R: Region]
    function fixedStream(data: Span[Nat8, R]): String is
        let tables: Tables := makeTables();
        var writer: Writer := makeWriter();
        var head: Buffer[Int64] := initialize(hash_size, no_position);
        var previous: Buffer[Int64] := initialize(window, no_position);
        let size: Index := spanLength(data);
        let two: Nat32 := 2;
        putBits(&!writer, one32, one32);
        putBits(&!writer, one32, two);
        var at: Index := zero_index;
        while at < size do
            var best_length: Index := zero_index;
            var best_distance: Index := zero_index;
            if (at + 2) < size then
                var candidate: Int64 := bufferNthMut(&!head, hashAt(data, at));
                var chain: Index := zero_index;
                let here: Int64 := positionOf(at);
                let reach: Int64 := positionOf(window);
                while ((candidate >= 0) and ((here - candidate) <= reach)) and (chain < max_chain) do
                    let from0: Index := indexOfPosition(candidate);
                    let length: Index := matchLength(data, from0, at);
                    if length > best_length then
                        best_length := length;
                        best_distance := at - from0;
                    end if;
                    if best_length = max_match then
                        chain := max_chain;
                    else
                        candidate := bufferNthMut(&!previous, rem(from0, window));
                        chain := chain + 1;
                    end if;
                end while;
            end if;
            if best_length >= min_match then
                putMatch(&!writer, &tables, best_length, best_distance);
                var k: Index := zero_index;
                while k < best_length do
                    insertAt(data, at + k, &!head, &!previous);
                    k := k + 1;
                end while;
                at := at + best_length;
            else
                putSymbol(&!writer, wideByte(data[at]));
                insertAt(data, at, &!head, &!previous);
                at := at + 1;
            end if;
        end while;
        let end_of_block: Nat32 := 256;
        putSymbol(&!writer, end_of_block);
        destroyFree(head);
        destroyFree(previous);
        destroyTables(tables);
        return finishWriter(writer);
    end;

    -- data as stored blocks of at most 65535 bytes.
    generic [R: Region]
    function storedStream(data: Span[Nat8, R]): String is
        var writer: Writer := makeWriter();
        let size: Index := spanLength(data);
        var at: Index := zero_index;
        var first: Bool := true;
        while first or (at < size) do
            first := false;
            var count: Index := size - at;
            if count > stored_most then
                count := stored_most;
            end if;
            var final: Nat32 := zero32;
            if (at + count) = size then
                final := one32;
            end if;
            putBits(&!writer, final, one32);
            putBits(&!writer, zero32, 2);
            align(&!writer);
            let length: Nat32 := natOf(count);
            let complement: Nat32 := bitwiseXor(length, low_word);
            emitByte(&!writer, byteOf(rem(length, byte_span)));
            emitByte(&!writer, byteOf(length / byte_span));
            emitByte(&!writer, byteOf(rem(complement, byte_span)));
            emitByte(&!writer, byteOf(complement / byte_span));
            var i: Index := zero_index;
            while i < count do
                emitByte(&!writer, data[at + i]);
                i := i + 1;
            end while;
            at := at + count;
        end while;
        return finishWriter(writer);
    end;

    generic [R: Region]
    function deflateRaw(data: Span[Nat8, R]): String is
        let coded: String := fixedStream(data);
        let size: Index := spanLength(data);
        var blocks: Index := (size + (stored_most - 1)) / stored_most;
        if blocks = zero_index then
            blocks := one_index;
        end if;
        if stringLength(&coded) <= (size + (blocks * 5)) then
            return coded;
        else
            destroyString(coded);
            return storedStream(data);
        end if;
    end;

    generic [R: Region]
    function putWord(out: &![StringBuilder, R], value: Nat32): Unit is
        var rest: Nat32 := value;
        var i: Index := zero_index;
        while i < 4 do
            writeByte(&~out, byteOf(rem(rest, byte_span)));
            rest := rest / byte_span;
            i := i + 1;
        end while;
        return nil;
    end;

    generic [R: Region]
    function gzip(data: Span[Nat8, R]): String is
        let packed: String := deflateRaw(data);
        var out: StringBuilder := makeStringBuilder();
        -- The magic 31 139, DEFLATE 8, no flags, the time 0, no extra
        -- flags, and 255 for an operating system not named.
        writeByte(&!out, 31);
        writeByte(&!out, 139);
        writeByte(&!out, 8);
        var i: Index := zero_index;
        while i < 6 do
            writeByte(&!out, 0);
            i := i + 1;
        end while;
        writeByte(&!out, 255);
        writeString(&!out, asSpan(&packed));
        destroyString(packed);
        putWord(&!out, crc32(data));
        putWord(&!out, trailerLength(spanLength(data)));
        return finalize(out);
    end;
end module body.
