"""
A store for Standard.Users in a database of Standard.Database, on every backend it has.

- The users are kept in the table hilde_users, the failed attempts in hilde_user_failures.
- openDatabaseUsers makes the two tables and their index when they are missing, in the types of the backend.
- The store holds the database; closeDatabaseUsers gives it back.

    case openDatabaseUsers(db) of
        when Right(right as opened: DatabaseUsers) do
            var users: DatabaseUsers := opened;
            let added: Either[UserError, Bool] := addUser(&!users, "alice", asSpan(&password));
            closeDatabase(closeDatabaseUsers(users));
        when Left(left as failed: DatabaseUsersFailed) do
            let { db: Database[Writing], error: UserError } := failed;
            closeDatabase(db);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Database (
    Database,
    Writing
);
import Standard.Users (
    UserError,
    UserStore
);

module Standard.DatabaseUsers is
    """
    A store in the tables hilde_users and hilde_user_failures of a database
    it holds: SQLite, SQLCipher, PostgreSQL or MariaDB.
    """
    type DatabaseUsers: Linear;

    """
    Makes the two tables and their index when they are missing, and holds
    db.  On Left the database comes back with the error.
    No contract: the result is I/O.
    """
    function openDatabaseUsers(db: Database[Writing]): Either[DatabaseUsersFailed, DatabaseUsers];

    """
    A store that could not be opened, and its database.
    """
    record DatabaseUsersFailed: Linear is
        db: Database[Writing];
        error: UserError;
    end;

    """
    Gives the database back.
    No contract: it only frees or closes what it is given.
    """
    function closeDatabaseUsers(users: DatabaseUsers): Database[Writing];

    instance UserStore(DatabaseUsers);
end module.
