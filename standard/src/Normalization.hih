"""
The four normalization forms of Unicode for UTF-8 text, NFD, NFC, NFKD and NFKC.

- The data is that of the Unicode Character Database 17.0.0.
- NFD and NFC keep what a text means and differ only in how its accents are written.
- NFKD and NFKC also fold compatibility variants, such as ligatures, into their plain forms.
- Two texts that should compare equal compare equal byte for byte after the same form.
- Text that is not well-formed UTF-8 is refused with None, not repaired.

    case toNfc(asSpan(&typed)) of
        when Some(value as normal: String) do
            printLn(asSpan(&normal));
            destroyString(normal);
        when None do
            printLn("not UTF-8");
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Normalization is
    """
    The text in Normalization Form D: every character decomposed as far as
    its canonical decomposition goes, the accents in their canonical order.
    None when the text is not well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function toNfd(text: Span[Nat8, R]): Option[String];

    """
    The text in Normalization Form C: decomposed as for D, then composed
    again wherever Unicode has one character for a letter and its accent.
    None when the text is not well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function toNfc(text: Span[Nat8, R]): Option[String];

    """
    The text in NFKD: as NFD, with the compatibility
    decompositions as well.  None when the text is not well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function toNfkd(text: Span[Nat8, R]): Option[String];

    """
    The text in NFKC: as NFKD, then composed as for NFC.
    None when the text is not well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function toNfkc(text: Span[Nat8, R]): Option[String];

    """
    The canonical combining class of a code point, 0 for most; the value
    canonical ordering sorts accents by.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    function combiningClass(point: Index): Index;
end module.
