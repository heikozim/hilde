"""
The calls of Standard.Sperli in the shape a C library can export: one session that holds the comm and the last result, and codes instead of Either.

- Every call is one session and plain numbers or bytes; nothing else crosses.
- A call that answers with data keeps it in the session until takeResult hands it on.
- Every call answers with 0 or a code of Standard.SperliError; notReady, resultPending and resultMissing are added.
- A session whose join failed holds the code of the failure and no comm.
- The calls only check what Standard.Sperli would refuse by a contract; the C library checks the rest first.

    let session: Session := openSession(text);
    let sent: Int32 := sessionSend(&!session, 1, 7, message);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.SperliExport is
    """
    The most bytes of a job description in text: 4194304.
    """
    function maxDescription(): Index
        ensures result = 4194304;

    """
    The most bytes of one message, one contribution or one result: 16777216.
    """
    function maxMessage(): Index
        ensures result = 16777216;

    """
    The most bytes of the data of a collective call: 16777200.
    """
    function maxCollective(): Index
        ensures result = 16777200;

    """
    The most bytes of a checkpoint state: 268435456.
    """
    function maxState(): Index
        ensures result = 268435456;

    """
    The most bytes of the path of the checkpoint directory: 4096.
    """
    function maxPath(): Index
        ensures result = 4096;

    """
    The code of a call on a session that holds no comm, because the join
    failed or the session is closed: -6.
    """
    function notReady(): Int32
        ensures result = -6;

    """
    The code of a call that would produce a result while an earlier one has
    not been taken: -11.
    """
    function resultPending(): Int32
        ensures result = -11;

    """
    The code of takeResult when the session holds no result: -10.
    """
    function resultMissing(): Int32
        ensures result = -10;

    """
    A comm, or the code of the join that failed, and the result of the last
    call that answered with data.  It is linear: closeSession gives it back.
    """
    type Session: Linear;

    """
    The session of the job that description, the text of a job description in
    hexadecimal digits, names.  The join is made here.  A session whose join
    failed holds the code and no comm.
    """
    generic [R: Region]
    function openSession(description: Span[Nat8, R]): Session
        requires spanLength(description) <= 4194304;

    """
    0 when the session holds a comm, else the code of the join that failed.
    No contract: a value whose only cheap property is its type.
    """
    generic [R: Region]
    function sessionCode(session: &[Session, R]): Int32;

    """
    The own rank, 0 for a session without a comm.
    """
    generic [R: Region]
    function sessionRank(session: &[Session, R]): Nat32
        ensures result < 4096;

    """
    The number of ranks, 0 for a session without a comm.
    """
    generic [R: Region]
    function sessionSize(session: &[Session, R]): Nat32
        ensures result <= 4096;

    """
    How many bytes of result the session holds.
    """
    generic [R: Region]
    function resultLength(session: &[Session, R]): Index
        ensures result <= 268435456;

    """
    Copies the result into out, which the caller makes as long as
    resultLength says, and gives the result up.  0 or resultMissing.
    No contract: the result is that of the copy.
    """
    generic [R: Region, B: Region]
    function takeResult(session: &![Session, R], out: Span![Nat8, B]): Int32;

    """
    Sends data to rank target with tag.  0 or a code.
    No contract: the result is that of the write.
    """
    generic [R: Region, D: Region]
    function sessionSend(session: &![Session, R], target: Nat32, tag: Nat32, data: Span[Nat8, D]): Int32
        requires ((target < 4096) and (tag <= 2147483647)) and (spanLength(data) <= 16777216);

    """
    Receives the next message from source with tag and keeps it as the result.
    No contract: the result is that of the reads.
    """
    generic [R: Region]
    function sessionRecv(session: &![Session, R], source: Nat32, tag: Nat32): Int32
        requires (source < 4096) and (tag <= 2147483647);

    """
    The barrier of Standard.Sperli.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region]
    function sessionBarrier(session: &![Session, R]): Int32;

    """
    The broadcast of Standard.Sperli; the result is kept.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region, D: Region]
    function sessionBcast(session: &![Session, R], root: Nat32, data: Span[Nat8, D]): Int32
        requires (root < 4096) and (spanLength(data) <= 16777200);

    """
    The reduction of Standard.Sperli; the result is kept.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region, D: Region]
    function sessionReduce(session: &![Session, R], root: Nat32, elementType: Nat8, reduction: Nat8, data: Span[Nat8, D]): Int32
        requires ((root < 4096) and (elementType <= 6)) and ((reduction <= 10) and (spanLength(data) <= 16777200));

    """
    The allreduce of Standard.Sperli; the result is kept.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region, D: Region]
    function sessionAllreduce(session: &![Session, R], elementType: Nat8, reduction: Nat8, data: Span[Nat8, D]): Int32
        requires ((elementType <= 6) and (reduction <= 10)) and (spanLength(data) <= 16777200);

    """
    The gather of Standard.Sperli; the result is kept.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region, D: Region]
    function sessionGather(session: &![Session, R], root: Nat32, data: Span[Nat8, D]): Int32
        requires (root < 4096) and (spanLength(data) <= 16777200);

    """
    The scatter of Standard.Sperli; the result is kept.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region, D: Region]
    function sessionScatter(session: &![Session, R], root: Nat32, data: Span[Nat8, D]): Int32
        requires (root < 4096) and (spanLength(data) <= 268435456);

    """
    Names the directory of the checkpoint files.  0 or a code.
    No contract: the result is that of the call.
    """
    generic [R: Region, P: Region]
    function sessionUseCheckpoints(session: &![Session, R], path: Span[Nat8, P]): Int32
        requires (spanLength(path) > 0) and (spanLength(path) <= 4096);

    """
    The collective checkpoint of payload.  0 or a code.
    No contract: the result is that of the writes and reads.
    """
    generic [R: Region, P: Region]
    function sessionCheckpoint(session: &![Session, R], payload: Span[Nat8, P]): Int32
        requires spanLength(payload) <= 268435456;

    """
    The collective resume; the payload of this rank is kept as the result.
    No contract: the result is that of the reads.
    """
    generic [R: Region]
    function sessionResume(session: &![Session, R]): Int32;

    """
    Leaves the job and gives back what the session held.
    No contract: it only frees or closes what it is given.
    """
    function closeSession(session: Session): Unit;
end module.
