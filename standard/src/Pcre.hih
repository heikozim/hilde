"""
Regular expressions through PCRE2, with its syntax and its engine.

- The names are those of Standard.Regex, but a search here can fail and gives an Either.
- Left when the match limit was reached, when one search needed over 512 MiB, or PCRE2 failed.
- Positions are byte offsets.
- A search does not change a compiled pattern.
- For text from outside the program use Standard.Regex, which runs in linear time.

    case compile("([a-z]+)@([a-z.]+)", 100000) of
        when Right(right as regex: Regex) do
            let hits: Either[String, Buffer[Hit]] := find_all(&regex, asSpan(&text));
            destroyRegex(regex);
        when Left(left as message: String) do
            printLn(asSpan(&message));
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin", Instead => "Standard.Regex");
import Standard.Buffer (
    Buffer
);
import Standard.String (
    String
);
import Bindings.Pcre (
    Code
);

module Standard.Pcre is
    """
    A compiled pattern with its match limit.  It is linear, because it owns
    the compiled code.
    """
    type Regex: Linear;

    """
    Compiles a pattern.  matchLimit bounds how many times the matcher may
    call its internal match function in one search, and must be at least 1.
    Left is the message of PCRE2 and the byte offset where it stopped.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function compile(pattern: Span[Nat8, R], matchLimit: Nat32): Either[String, Regex];

    """
    Makes a Regex of a pattern compiled by Bindings.Pcre, which a program
    cannot import; Standard.PcreJit makes its patterns so.
    No contract: the Regex holds the code and its group count and nothing else to check.
    """
    function fromCode(code: Code): Regex;

    """
    Gives back a compiled pattern.
    No contract: it only frees or closes what it is given.
    """
    function destroyRegex(regex: Regex): Unit;

    """
    How many capturing groups the pattern has, not counting the whole match.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function groupCount(regex: &[Regex, R]): Index;

    """
    Whether there is a match anywhere in text.  Left when the search failed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function match(regex: &[Regex, R], text: Span[Nat8, S]): Either[String, Bool];

    """
    Where a match was found, and where each of its groups was.  It is
    linear.
    """
    type Found: Linear;

    """
    The first match.  Right of None when there is none, Left when the
    search failed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function find(regex: &[Regex, R], text: Span[Nat8, S]): Either[String, Option[Found]];

    """
    The byte offset where the match starts.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function foundStart(found: &[Found, R]): Index;

    """
    The byte offset just after the match.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function foundEnd(found: &[Found, R]): Index;

    """
    Where a group started: 1 is the first group, 0 the whole match.  None
    when that group took no part in the match, or does not exist.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function groupStart(found: &[Found, R], group: Index): Option[Index];

    """
    Where a group ended, byte offset just after it.  None as for groupStart.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function groupEnd(found: &[Found, R], group: Index): Option[Index];

    """
    Gives back a match.
    No contract: it only frees or closes what it is given.
    """
    function destroyFound(found: Found): Unit;

    """
    Where one match lies: from start up to but not including stop.
    """
    record Hit: Free is
        start: Index;
        stop: Index;
    end;

    """
    Every match, left to right, none overlapping.  An empty match right
    after the previous match is skipped, and after an empty match the next
    search starts one byte further on, as find_all of Standard.Regex does
    in code points.  Left when a search failed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function find_all(regex: &[Regex, R], text: Span[Nat8, S]): Either[String, Buffer[Hit]];

    """
    Replaces every match find_all finds by rewrite, in which a backslash
    and a digit stand for that group and two backslashes for one, as in
    replace of Standard.Regex.  Left when a search failed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region, T: Region]
    function replace(regex: &[Regex, R], text: Span[Nat8, S], rewrite: Span[Nat8, T]): Either[String, String];

    """
    The version of PCRE2 the programme runs with, for version --full.
    No contract: the library answers.
    """
    function libraryVersion(): String;
end module.
