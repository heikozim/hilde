"""
The resource limits of the process, what it has used, and how long the system has been up.

- A limit has a soft value, which the kernel enforces, and a hard one.
- The process may raise the soft value up to the hard one.
- Lowering a hard limit cannot be undone without privilege.
- No limit is written as unlimited, the largest Nat64, on every platform.
- A call the kernel refuses returns None or false.

    let cores: Bool := disableCoreDumps();
    case readLimit(OpenFiles()) of
        when Some(value as limit: Limit) do
            let wide: Limit := Limit(soft => limit.hard, hard => limit.hard);
            let raised: Bool := setLimit(OpenFiles(), wide);
        when None do
            skip;
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Resource is
    """
    A resource the kernel limits.
    """
    union Resource: Free is
        """
        The size of the process's data segment, as the system counts it
        for RLIMIT_DATA, in bytes.
        """
        case DataSize;
        """
        The number of descriptors open at once: a descriptor that would
        be numbered at or above the soft limit is refused.
        """
        case OpenFiles;
        """
        The largest core file written when the process ends by a signal,
        in bytes; 0 writes none.
        """
        case CoreSize;
    end;

    """
    The soft and the hard limit of a resource.
    """
    record Limit: Free is
        soft: Nat64;
        hard: Nat64;
    end;

    """
    The value of a limit that is no limit.
    """
    constant unlimited: Nat64;

    """
    The limits of resource.  None when the kernel refused.
    No contract: an Option result, which an ensures cannot look into.
    """
    function readLimit(resource: Resource): Option[Limit];

    """
    Sets the limits of resource.  Returns false, and changes nothing, when
    the soft limit is above the hard one, a value is one no limit can have
    on this platform, or the kernel refused: raising a hard limit needs
    privilege.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function setLimit(resource: Resource, limit: Limit): Bool;

    """
    Sets the soft and the hard limit of the core size to 0, so that no
    core file, and none of the memory it would hold, is written.  Returns
    false when the kernel refused.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function disableCoreDumps(): Bool;

    """
    What the process has used so far: CPU time in microseconds, spent in
    the process and in the kernel for it, and the largest resident set in
    bytes.  FreeBSD's kernel sets the largest resident set at a clock tick,
    so a process that asks in its first milliseconds reads 0 there.
    """
    record Usage: Free is
        userMicros: Nat64;
        systemMicros: Nat64;
        peakResidentBytes: Nat64;
    end;

    """
    What the process has used, with getrusage(2).  None when the kernel
    refused.
    No contract: an Option result, which an ensures cannot look into.
    """
    function readUsage(): Option[Usage];

    """
    Nanoseconds since the system started, time asleep included.  None
    where there is no such clock, and on a system this library does not
    know.
    No contract: an Option result, which an ensures cannot look into.
    """
    function systemUptimeNanos(): Option[Nat64];
end module.
