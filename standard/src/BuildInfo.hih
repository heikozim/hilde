"""
What a programme knows about its own build: commit, state of the work tree, time, compiler and its own values.

- The compiler fills it in only for a programme that imports this module; git runs only then.
- The commit is 40 or 64 hex digits, or empty when the build was not in a git work tree or ran with --no-build-vcs.
- The time is SOURCE_DATE_EPOCH when it was set, so that a build can give the same bytes twice.
- Values come from --build-value=name=value: names of 1 to 64 bytes, texts of at most 1024 bytes.
- Every text lives as long as the programme; no function allocates.

    printLn(commit());
    case value("channel") of
        when Some(value as channel: Span[Nat8, Static]) do
            printLn(channel);
        when None do
            printLn("no channel");
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.BuildInfo is
    """
    The commit the programme was built from, in hex, or an empty span when
    the compiler had none.
    """
    function commit(): Span[Nat8, Static]
        ensures (spanLength(result) = 0) or (spanLength(result) = 40) or (spanLength(result) = 64);

    """
    Whether the work tree held changes against the commit when the
    programme was built.  It is false when there is no commit.
    No contract: tying it to the commit needs a call into C, which a condition may not make.
    """
    function dirty(): Bool;

    """
    The time of the build in seconds since 1970.
    """
    function builtAt(): Int64
        ensures result >= 0;

    """
    The version of the compiler, as hilde --version prints it.
    """
    function compilerVersion(): Span[Nat8, Static]
        ensures spanLength(result) > 0;

    """
    How many values the build was given with --build-value.
    No contract: a number the system or the build gives.
    """
    function valueCount(): Index;

    """
    The name of the value at the position, counted from zero in the order
    the build was given them, or an empty span when the position is not
    below valueCount.  The position is checked here and not in a requires,
    because the count is read from C, which a condition may not call.
    """
    function valueName(index: Index): Span[Nat8, Static]
        ensures spanLength(result) <= 64;

    """
    The text of the value at the position, or an empty span when the
    position is not below valueCount.
    """
    function valueText(index: Index): Span[Nat8, Static]
        ensures spanLength(result) <= 1024;

    """
    The text of the value of that name, or None when the build was given
    none.  Time linear in the number of values.
    No contract: that the text belongs to the name costs the same walk again.
    """
    generic [R: Region]
    function value(name: Span[Nat8, R]): Option[Span[Nat8, Static]];
end module.
