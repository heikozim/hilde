"""
What one does with text: parse it, encode it, compare it and take it apart.

- Standard.String is the container; this module reads text through a Span[Nat8, R].
- Every error is an Option, never a sentinel: nothing here returns -1.
- Nothing traps on bad input: a string that is not a number, or does not fit, is None.
- What is taken apart comes back as spans of the same bytes: nothing is copied.
- What is built is a fresh String that the caller owns.
- Case changes touch ASCII letters only, so they are safe on UTF-8.
- equal stops at the first difference; for secrets use constantTimeEqual.
- A search for a part takes time linear in the lengths of the text and the part.

    let port: Option[Nat64] := parseNat(trim(asSpan(&field)));
    let parts: Buffer[Span[Nat8, Static]] := split("a,b,c", ",");
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);

module Standard.Text is
    ---
    --- Classification
    ---

    """
    Is the byte an ASCII decimal digit?
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function isDigit(byte: Nat8): Bool;

    """
    The value of an ASCII hexadecimal digit, either case.  None for
    anything else.
    No contract: an Option result, which an ensures cannot look into.
    """
    function hexDigitValue(byte: Nat8): Option[Nat8];

    ---
    --- Parsing, all with overflow protection
    ---

    """
    A decimal string with an optional minus sign in front to a number.
    None when there is no digit, when anything but the one sign and digits
    is there, or when the value does not fit in an Int64; the smallest,
    -9223372036854775808, fits.  A plus sign is not read.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseInt(string: Span[Nat8, R]): Option[Int64];

    """
    A decimal string to a number.  None when the string is empty, when it
    holds anything but digits, or when the value does not fit in a Nat64.

    The overflow check happens before the multiplication, so nothing ever
    traps: a sixty-digit string is None, not an abort.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseNat(string: Span[Nat8, R]): Option[Nat64];

    """
    The decimal digits of value, without a sign and without leading zeros;
    0 is written 0.  parseNat reads it back.  One digit for a value below 10,
    at most 20 for the largest Nat64.
    """
    function formatNat(value: Nat64): String
        ensures (length(&result) >= 1) and (length(&result) <= 20)
        ensures (value < 10) = (length(&result) = 1);

    """
    The decimal digits of value with a minus sign in front of a negative
    value, as parseInt reads them; the smallest Int64 is written whole,
    -9223372036854775808, 20 characters.  One character exactly for a value
    from 0 to 9.  The sign is not in a contract: reading a byte of the result
    goes through C, which a condition may not call.
    """
    function formatInt(value: Int64): String
        ensures (length(&result) >= 1) and (length(&result) <= 20)
        ensures ((value >= 0) and (value < 10)) = (length(&result) = 1);

    """
    A hexadecimal string to a number, either case, with no 0x prefix.
    Same rules as parseNat.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseHex(string: Span[Nat8, R]): Option[Nat64];

    """
    A time string to a number of seconds.  A bare number is seconds; a
    trailing m, h or d multiplies by 60, 3600 or 86400.

    None for anything else, and None rather than a trap when the product
    does not fit.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseDuration(string: Span[Nat8, R]): Option[Nat64];

    ---
    --- Taking apart
    ---

    """
    The position of the first occurrence of byte, or None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function indexOfByte(string: Span[Nat8, R], byte: Nat8): Option[Index];

    """
    The bytes from start up to but not including stop, as a span of the
    same bytes: nothing is copied.  Empty when start is not before stop;
    both are clamped to the length of string, so no index can be out of
    bounds.  Standard.String.fromSpan makes a string of it that is owned.
    """
    generic [R: Region]
    function substring(string: Span[Nat8, R], start: Index, stop: Index): Span[Nat8, R]
        ensures spanLength(result) <= spanLength(string);

    """
    string without its leading and trailing space, tab, carriage return
    and line feed, as a span of the same bytes.
    """
    generic [R: Region]
    function trim(string: Span[Nat8, R]): Span[Nat8, R]
        ensures spanLength(result) <= spanLength(string);

    """
    The position of the first occurrence of part in text, or None.  The
    empty part occurs at 0.
    No contract: the answer is an Option, and that part stands there costs a comparison of its length.
    """
    generic [R: Region, S: Region]
    function indexOf(text: Span[Nat8, R], part: Span[Nat8, S]): Option[Index];

    """
    Whether part occurs in text.  The empty part occurs in every text.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function contains(text: Span[Nat8, R], part: Span[Nat8, S]): Bool;

    """
    Whether text begins with prefix.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function startsWith(text: Span[Nat8, R], prefix: Span[Nat8, S]): Bool;

    """
    Whether text ends with suffix.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function endsWith(text: Span[Nat8, R], suffix: Span[Nat8, S]): Bool;

    """
    How often part occurs in text, counted from the start without
    overlapping, as replace replaces it.  0 for the empty part.
    """
    generic [R: Region, S: Region]
    function countOf(text: Span[Nat8, R], part: Span[Nat8, S]): Index
        ensures result <= spanLength(text);

    """
    The pieces of text between the occurrences of separator, as spans of
    text, in order.  Two separators next to each other give an empty
    piece, and so do a separator at either end; the empty text is one
    empty piece.  An empty separator gives text whole, as one piece.
    No contract: the count of pieces is that of the separators, which
    costs a search.
    """
    generic [R: Region, S: Region]
    function split(text: Span[Nat8, R], separator: Span[Nat8, S]): Buffer[Span[Nat8, R]];

    """
    The lines of text as spans, without their line ends.  A line ends at
    a line feed, and a carriage return right before it is dropped too; a
    last line without a line feed is a line; a line feed at the very end
    starts no further line.  The empty text has no lines.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function lines(text: Span[Nat8, R]): Buffer[Span[Nat8, R]];

    """
    Whether text looks like binary data rather than text: a zero byte in
    its first 512 bytes, the rule of grep and diff.  The empty text is
    text.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isBinary(text: Span[Nat8, R]): Bool;

    ---
    --- Building
    ---

    """
    A fresh string of the pieces with separator between each two.
    No contract: a text whose length follows its input.
    """
    generic [R: Region, P: Region, S: Region]
    function join(pieces: &[Buffer[Span[Nat8, R]], P], separator: Span[Nat8, S]): String;

    """
    A fresh string of text with every occurrence of old replaced by new,
    found from the start without overlapping; what a replacement wrote is
    not searched again.  An empty old replaces nothing.
    No contract: the length of the result depends on how often old occurs.
    """
    generic [R: Region, O: Region, N: Region]
    function replace(text: Span[Nat8, R], old: Span[Nat8, O], new: Span[Nat8, N]): String;

    """
    A fresh string with every ASCII small letter turned into its capital.
    Bytes outside a-z are left exactly as they are, so this is safe on
    UTF-8, as toLower is.
    """
    generic [R: Region]
    function toUpper(string: Span[Nat8, R]): String
        ensures length(&result) = spanLength(string);

    """
    A fresh string with every ASCII capital turned into its lower case.
    Bytes outside A-Z are left exactly as they are, so this is safe on
    UTF-8: no multi-byte sequence contains a byte in that range.
    """
    generic [R: Region]
    function toLower(string: Span[Nat8, R]): String
        ensures length(&result) = spanLength(string);

    ---
    --- Encoding
    ---

    """
    Percent-encode the bytes a URL cannot carry unescaped.
    """
    generic [R: Region]
    function urlEncode(string: Span[Nat8, R]): String
        ensures length(&result) >= spanLength(string);

    """
    Undo percent-encoding.  A % that is not followed by two hexadecimal
    digits is kept as it stands, which is what a decoder that must not lose
    bytes has to do.
    """
    generic [R: Region]
    function urlDecode(string: Span[Nat8, R]): String
        ensures length(&result) <= spanLength(string);

    """
    Every byte as two lower-case hexadecimal digits.

    one function for every digest length: a sixteen-byte digest and a
    thirty-two-byte one differ in the string handed in, not in the code.
    """
    generic [R: Region]
    function bytesToHex(string: Span[Nat8, R]): String
        ensures length(&result) = (spanLength(string) * 2);

    """
    The bytes a text of hexadecimal digits stands for, two digits to a
    byte, the first the high half.  Upper and lower case are both read.
    None for an odd number of digits or for any byte that is not a
    hexadecimal digit, a space or a 0x in front among them.  The empty text
    gives no bytes.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function hexToBytes(text: Span[Nat8, R]): Option[String];

    ---
    --- Comparison
    ---

    """
    True when left and right hold the same bytes in the same order.  Two
    empty spans are equal.  It stops at the first difference, so the time
    it takes says where that is: for secrets use constantTimeEqual.  Equal
    spans have equal lengths, which the ensures states.
    """
    generic [R: Region, S: Region]
    function equal(left: Span[Nat8, R], right: Span[Nat8, S]): Bool
        ensures (not result) or (spanLength(left) = spanLength(right));

    """
    Compare two strings without letting the time taken say where they
    differ.  For secrets: tokens, session identifiers, digests.

    Every byte of the longer string is read on every call, and the lengths
    go into the same accumulator as the bytes, so a difference in length is
    not decided sooner than a difference in content.  What is visible from
    outside is the length of the longer string, because that is how many
    times the loop runs -- and the caller controls one of the two.  That
    is named here rather than claimed away.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function constantTimeEqual(left: Span[Nat8, R], right: Span[Nat8, S]): Bool;
end module.
