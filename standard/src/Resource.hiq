-- A safe module: the calls into C are those of Bindings.Resource, which
-- number a resource 0, 1 and 2 in the order of the union here.
import Bindings.Resource (
    LimitPair,
    UsageNumbers,
    limitOf,
    setLimitOf,
    usageNumbers,
    bootNanos
);

module body Standard.Resource is
    constant unlimited: Nat64 := 18446744073709551615;

    function number(resource: Resource): Nat32 is
        case resource of
            when DataSize do
                return 0;
            when OpenFiles do
                return 1;
            when CoreSize do
                return 2;
        end case;
    end;

    function readLimit(resource: Resource): Option[Limit] is
        case limitOf(number(resource)) of
            when Some(value as pair: LimitPair) do
                let some: Option[Limit] := Some(value => Limit(soft => pair.soft, hard => pair.hard));
                return some;
            when None do
                let none: Option[Limit] := None();
                return none;
        end case;
    end;

    function setLimit(resource: Resource, limit: Limit): Bool is
        if limit.soft > limit.hard then
            return false;
        end if;
        return setLimitOf(number(resource), limit.soft, limit.hard);
    end;

    function disableCoreDumps(): Bool is
        let zero: Nat64 := 0;
        return setLimit(CoreSize(), Limit(soft => zero, hard => zero));
    end;

    function readUsage(): Option[Usage] is
        case usageNumbers() of
            when Some(value as numbers: UsageNumbers) do
                let some: Option[Usage] := Some(value => Usage(
                    userMicros => numbers.userMicros,
                    systemMicros => numbers.systemMicros,
                    peakResidentBytes => numbers.peakBytes
                ));
                return some;
            when None do
                let none: Option[Usage] := None();
                return none;
        end case;
    end;

    function systemUptimeNanos(): Option[Nat64] is
        let nanos: Int64 := bootNanos();
        if nanos < 0 then
            let none: Option[Nat64] := None();
            return none;
        end if;
        return toNat64(nanos);
    end;
end module body.
