import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Text (
    equal
);
import Standard.Order (
    Ordering,
    LessThan,
    Equal,
    GreaterThan,
    compare
);
import Standard.Semver (
    Version,
    makeVersion,
    parseVersion,
    formatVersion,
    nextPatch,
    nextMinor,
    nextMajor,
    sameMajor,
    greaterVersion,
    mostNumber
);

module body Standard.Semver.Test is
    function reads(text: Span[Nat8, Static], major: Int64, minor: Int64, patch: Int64): Unit is
        case parseVersion(text) of
            when Some(value as version: Version) do
                assertTrue(((version.major = major) and (version.minor = minor)) and (version.patch = patch), "the numbers read");
                let back: String := formatVersion(version);
                assertTrue(equal(asSpan(&back), text), "written back as read");
                destroyString(back);
            when None do
                assertFailure("a version was refused");
        end case;
        return nil;
    end;

    function refused(text: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case parseVersion(text) of
            when Some(value as version: Version) do
                assertFailure(message);
            when None do
                assertSuccess(message);
        end case;
        return nil;
    end;

    function testReading(): Unit is
        reads("v0.0.0", 0, 0, 0);
        reads("v1.4.2", 1, 4, 2);
        reads("v10.200.3000", 10, 200, 3000);
        reads("v999999999.0.1", 999999999, 0, 1);
        refused("1.4.2", "no v");
        refused("V1.4.2", "a capital V");
        refused("v1.4", "two numbers");
        refused("v1.4.2.0", "four numbers");
        refused("v01.4.2", "a leading zero");
        refused("v1..2", "an empty number");
        refused("v1.4.2-rc1", "something after the patch");
        refused("v1000000000.0.0", "ten digits");
        refused("v1.a.2", "a letter");
        refused("", "the empty text");
        return nil;
    end;

    function testOrder(): Unit is
        let a: Version := makeVersion(1, 2, 3);
        let b: Version := makeVersion(1, 10, 0);
        let c: Version := makeVersion(2, 0, 0);
        case compare(&a, &b) of
            when LessThan do
                assertSuccess("1.2.3 before 1.10.0, by number");
            when Equal do
                assertFailure("1.2.3 equal to 1.10.0");
            when GreaterThan do
                assertFailure("1.2.3 after 1.10.0");
        end case;
        case compare(&c, &b) of
            when LessThan do
                assertFailure("2.0.0 before 1.10.0");
            when Equal do
                assertFailure("2.0.0 equal to 1.10.0");
            when GreaterThan do
                assertSuccess("2.0.0 after 1.10.0");
        end case;
        let g: Version := greaterVersion(a, b);
        assertTrue(g.minor = 10, "the greater of two");
        assertTrue(sameMajor(a, b), "1.2.3 and 1.10.0 share the major");
        assertTrue(not sameMajor(b, c), "1.10.0 and 2.0.0 do not");
        return nil;
    end;

    function testNext(): Unit is
        let a: Version := makeVersion(1, 2, 3);
        let p: Version := nextPatch(a);
        let m: Version := nextMinor(a);
        let j: Version := nextMajor(a);
        assertTrue(((p.major = 1) and (p.minor = 2)) and (p.patch = 4), "next patch");
        assertTrue(((m.major = 1) and (m.minor = 3)) and (m.patch = 0), "next minor");
        assertTrue(((j.major = 2) and (j.minor = 0)) and (j.patch = 0), "next major");
        assertTrue(mostNumber() = 999999999, "nine digits");
        return nil;
    end;
end module body.
