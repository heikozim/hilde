"""
Type classes for partial and total equivalence relations.

- PartialEquality is symmetric and transitive but need not be reflexive.
- Equality is a total equivalence: reflexive, symmetric and transitive.
- Both compare through read references, so neither uses up its arguments.
- The compiler does not check these laws; an instance is trusted to keep them.
- This module gives both instances for Unit, where any two values are equal.

    let same: Bool := equal(&left, &right);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Equality is
    """
    Represents a partial equivalence relation, that is, a total equivalence
    relation that is non-reflexive.
    """
    typeclass PartialEquality(T: Type) is
        """
        No contract: the answer is a Bool, nothing cheaper holds.
        """
        generic [R: Region, S: Region]
        method partialEq(a: &[T, R], b: &[T, S]): Bool;
    end;

    """
    Represents a total equivalence relation.
    """
    typeclass Equality(T: Type) is
        """
        No contract: the answer is a Bool, nothing cheaper holds.
        """
        generic [R: Region, S: Region]
        method equal(a: &[T, R], b: &[T, S]): Bool;
    end;

    instance PartialEquality(Unit);
    instance Equality(Unit);
end module.
