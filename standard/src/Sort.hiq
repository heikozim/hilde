--
-- Standard.Sort.  A top-down merge sort
-- that only moves elements, through the buffer's own operations: the upper
-- half is taken off the end of the buffer, both halves are sorted, and the
-- merge reverses them so that the next element of each is its last one --
-- removeLast is O(1), removeFirst would move the whole rest.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyEmpty,
    length,
    nthRef,
    insertBack,
    removeLast,
    reverse
);
import Standard.Order (
    Ordering,
    TotalOrder,
    compare
);

module body Standard.Sort is
    generic [T: Type(TotalOrder)]
    function sort(buffer: Buffer[T]): Buffer[T] is
        let n: Index := length(&buffer);
        if n < 2 then
            return buffer;
        else
            var low: Buffer[T] := buffer;
            var high: Buffer[T] := allocateEmpty();
            let upper: Index := n - (n / 2);
            for i from 1 to upper do
                insertBack(&!high, removeLast(&!low));
            end for;
            reverse(&!high);
            let sortedLow: Buffer[T] := sort(low);
            let sortedHigh: Buffer[T] := sort(high);
            return merge(sortedLow, sortedHigh);
        end if;
    end;

    -- Both sorted, low holding the elements that came first.  Reversed,
    -- each one's next element is its last; the smaller of the two goes to
    -- the output, and on a tie the one from low -- that is what keeps
    -- the sort stable.
    generic [T: Type(TotalOrder)]
    function merge(low: Buffer[T], high: Buffer[T]): Buffer[T] is
        var a: Buffer[T] := low;
        var b: Buffer[T] := high;
        reverse(&!a);
        reverse(&!b);
        var out: Buffer[T] := allocateEmpty();
        while (length(&a) > 0) and (length(&b) > 0) do
            if takeFromLow(&a, &b) then
                insertBack(&!out, removeLast(&!a));
            else
                insertBack(&!out, removeLast(&!b));
            end if;
        end while;
        while length(&a) > 0 do
            insertBack(&!out, removeLast(&!a));
        end while;
        while length(&b) > 0 do
            insertBack(&!out, removeLast(&!b));
        end while;
        destroyEmpty(a);
        destroyEmpty(b);
        return out;
    end;

    generic [T: Type(TotalOrder), R: Region, S: Region]
    function takeFromLow(a: &[Buffer[T], R], b: &[Buffer[T], S]): Bool is
        let order: Ordering := compare(nthRef(a, length(a) - 1), nthRef(b, length(b) - 1));
        case order of
            when LessThan do
                return true;
            when Equal do
                return true;
            when GreaterThan do
                return false;
        end case;
    end;

    generic [T: Type(TotalOrder), R: Region]
    function isSorted(buffer: &[Buffer[T], R]): Bool is
        let n: Index := length(buffer);
        var sorted: Bool := true;
        if n > 1 then
            for i from 1 to n - 1 do
                case compare(nthRef(buffer, i - 1), nthRef(buffer, i)) of
                    when LessThan do
                        skip;
                    when Equal do
                        skip;
                    when GreaterThan do
                        sorted := false;
                end case;
            end for;
        end if;
        return sorted;
    end;

    -- The lower bound: low only ever moves past elements less than the
    -- key, high only onto elements not less than it, so at the end low
    -- is the first position whose element is not less than the key.
    generic [T: Type(TotalOrder), R: Region, S: Region]
    function binarySearch(buffer: &[Buffer[T], R], key: &[T, S]): Search is
        let n: Index := length(buffer);
        var low: Index := 0;
        var high: Index := n;
        while low < high do
            let middle: Index := low + ((high - low) / 2);
            case compare(nthRef(buffer, middle), key) of
                when LessThan do
                    low := middle + 1;
                when Equal do
                    high := middle;
                when GreaterThan do
                    high := middle;
            end case;
        end while;
        if low < n then
            case compare(nthRef(buffer, low), key) of
                when Equal do
                    return Found(position => low);
                when LessThan do
                    return Missing(insertAt => low);
                when GreaterThan do
                    return Missing(insertAt => low);
            end case;
        end if;
        return Missing(insertAt => low);
    end;
end module body.
