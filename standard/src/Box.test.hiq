import Standard.Box (
    Box,
    makeBox,
    unbox,
    readFree,
    storeFree,
    boxSwap,
    unboxReadRef
);
import Standard.Testing (
    assertTrue,
    assertFailure
);

module body Standard.Box.Test is
    -- Basic lifecycle: makeBox and unbox.
    function testBasicLifecycle(): Unit is
        let e: Either[Int32, Box[Int32]] := makeBox(10);
        case e of
            when Right(right as box: Box[Int32]) do
                let i: Int32 := unbox(box);
                assertTrue(i = 10, "box contents equal 10");
            when Left(left: Int32) do
                assertFailure("makeBox failed.");
        end case;
        return nil;
    end;

    -- readFree.
    function testReadFree(): Unit is
        let e: Either[Int32, Box[Int32]] := makeBox(10);
        case e of
            when Right(right as box: Box[Int32]) do
                let val: Int32 := readFree(&box);
                assertTrue(val = 10, "readFree result equals 10");
                unbox(box);
            when Left(left: Int32) do
                assertFailure("makeBox failed.");
        end case;
        return nil;
    end;

    -- storeFree.
    function testStoreFree(): Unit is
        let e: Either[Int32, Box[Int32]] := makeBox(10);
        case e of
            when Right(right: Box[Int32]) do
                var box: Box[Int32] := right;
                storeFree(&!box, 20);
                assertTrue(unbox(box) = 20, "box contents equal 20");
            when Left(left: Int32) do
                assertFailure("makeBox failed.");
        end case;
        return nil;
    end;

    -- boxSwap.
    function testSwap(): Unit is
        let e: Either[Int32, Box[Int32]] := makeBox(10);
        case e of
            when Right(right: Box[Int32]) do
                var box: Box[Int32] := right;
                let old: Int32 := boxSwap(&!box, 20);
                assertTrue(old = 10, "old box contents equal 10");
                assertTrue(unbox(box) = 20, "box contents equal 20");
            when Left(left: Int32) do
                assertFailure("makeBox failed.");
        end case;
        return nil;
    end;

    -- unboxReadRef.
    function testUnboxReadRef(): Unit is
        let e: Either[Int32, Box[Int32]] := makeBox(10);
        case e of
            when Right(right as box: Box[Int32]) do
                let val: Int32 := !unboxReadRef(&box);
                assertTrue(val = 10, "value from reference equals 10");
                assertTrue(unbox(box) = 10, "unbox value equals 10");
            when Left(left: Int32) do
                assertFailure("makeBox failed.");
        end case;
        return nil;
    end;
end module body.
