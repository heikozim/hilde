import Standard.Testing (
    assertTrue
);
import Standard.Postgres (
    PgError,
    connectionFailed,
    stateCode,
    stateClass,
    isUniqueViolation,
    isConstraintViolation,
    isBusy,
    noValues,
    withInt64,
    withText,
    withNull,
    valueCount,
    dropValues,
    Values
);

module body Standard.Postgres.Test is
    -- SQLSTATEs as numbers, the first and the last there can be, and a
    -- class taken from them.
    function testStateCode(): Unit is
        assertTrue(stateCode("00000") = 0, "00000 is 0");
        assertTrue(stateCode("ZZZZZ") = 60466175, "ZZZZZ is the largest");
        assertTrue(stateCode("23505") = 3505685, "23505");
        assertTrue(stateCode("28P01") = 3764881, "28P01");
        assertTrue(stateClass(PgError(code => stateCode("23505"))) = 75, "class 23");
        assertTrue(stateClass(PgError(code => stateCode("40P01"))) = 144, "class 40");
        assertTrue(stateClass(PgError(code => connectionFailed)) = -1, "a code of the module has no class");
        return nil;
    end;

    function testClasses(): Unit is
        let unique: PgError := PgError(code => stateCode("23505"));
        let foreign: PgError := PgError(code => stateCode("23503"));
        let deadlock: PgError := PgError(code => stateCode("40P01"));
        let syntax: PgError := PgError(code => stateCode("42601"));
        assertTrue(isUniqueViolation(unique), "23505 is unique");
        assertTrue(not isUniqueViolation(foreign), "23503 is not unique");
        assertTrue(isConstraintViolation(foreign), "23503 is a constraint");
        assertTrue(not isConstraintViolation(syntax), "42601 is no constraint");
        assertTrue(isBusy(deadlock), "40P01 is busy");
        assertTrue(not isBusy(unique), "23505 is not busy");
        return nil;
    end;

    function testValues(): Unit is
        let values: Values := withNull(withText(withInt64(noValues(), 1), "a"));
        assertTrue(valueCount(&values) = 3, "three values");
        dropValues(values);
        return nil;
    end;
end module body.
