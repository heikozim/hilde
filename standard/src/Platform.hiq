-- A safe module over Bindings.Platform.
import Bindings.Platform (
    systemText,
    machineText,
    hostText
);

module body Standard.Platform is
    function systemName(): Span[Nat8, Static] is
        return systemText();
    end;

    function machineName(): Span[Nat8, Static] is
        return machineText();
    end;

    function hostName(): Span[Nat8, Static] is
        return hostText();
    end;
end module body.
