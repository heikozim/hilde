"""
The subcommands setup and user of a programme: its vault of secrets, its completion and manual, and its users.

- setup has init, set, get, delete, list, rotate-key, rotate-pepper, completion and manual; user has add, del, passwd and list.
- A secret or a password is read from the terminal without echo, a new one twice; from standard input only with --password-stdin; never from an argument.
- Every read secret is wiped when it is no longer needed.
- runSetup and runUser give the exit status, 0 or 1, and write what went wrong to errors.
- Only a programme that imports this module carries the vault and its cryptography.

    let setup: SetupKeys := addSetup(&!root);
    case parse(&root, &arguments) of
        when Right(right as outcome: Outcome) do
            useOutcome(outcome);
        when Left(left as error: ArgumentError) do
            useError(error);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.StringBuilder (
    StringBuilder
);
import Standard.Arguments (
    Command,
    Matches,
    FlagKey,
    PathKey,
    PositionalKey,
    SubcommandKey
);
import Standard.Users (
    UserStore
);
import Standard.Doctor (
    Checkup
);

module Standard.Setup is
    """
    The keys of setup and its words, as addSetup declared them.
    """
    record SetupKeys: Free is
        setup: SubcommandKey;
        initVault: SubcommandKey;
        set: SubcommandKey;
        get: SubcommandKey;
        delete: SubcommandKey;
        list: SubcommandKey;
        rotateKey: SubcommandKey;
        rotatePepper: SubcommandKey;
        completion: SubcommandKey;
        manual: SubcommandKey;
        setName: PositionalKey;
        getName: PositionalKey;
        deleteName: PositionalKey;
        newPepper: PathKey;
        shell: PositionalKey;
        fromInput: FlagKey;
    end;

    """
    The keys of user and its words, as addUserCommands declared them.
    """
    record UserKeys: Free is
        user: SubcommandKey;
        add: SubcommandKey;
        del: SubcommandKey;
        passwd: SubcommandKey;
        list: SubcommandKey;
        addName: PositionalKey;
        delName: PositionalKey;
        passwdName: PositionalKey;
        fromInput: FlagKey;
        passwdInput: FlagKey;
    end;

    """
    Declares setup with its nine words under root.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function addSetup(root: &![Command, R]): SetupKeys;

    """
    Declares user with its four words under root.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function addUserCommands(root: &![Command, R]): UserKeys;

    """
    Runs the word of setup the matches chose, on the vault of envPath and
    pepperPath with the key in the line keyName; completion and manual
    are written from command, the manual with date.  Output goes to out,
    a failure to errors.  Gives 0, or 1 when it failed.
    """
    generic [R: Region, M: Region, E: Region, P: Region, K: Region, D: Region, T: Region, U: Region]
    function runSetup(command: &[Command, R], matches: &[Matches, M], keys: SetupKeys, envPath: Span[Nat8, E], pepperPath: Span[Nat8, P], keyName: Span[Nat8, K], date: Span[Nat8, D], out: &![StringBuilder, T], errors: &![StringBuilder, U]): Int32
        ensures (result = 0) or (result = 1);

    """
    Adds to checkup whether the vault of envPath and pepperPath with the
    key in the line keyName opens, with the reason when it does not and
    fix as the command that sets it up.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, E: Region, P: Region, K: Region, F: Region]
    function checkVault(checkup: &![Checkup, R], envPath: Span[Nat8, E], pepperPath: Span[Nat8, P], keyName: Span[Nat8, K], fix: Span[Nat8, F]): Unit;

    """
    Adds to checkup the completion scripts of bash, zsh and fish and the
    manual page of command, with date, as files under prefix, /usr/local
    for a service or the .local directory in the home of a user tool:
    share/bash-completion/completions/name, share/zsh/site-functions/_name,
    share/fish/vendor_completions.d/name.fish, and man/man1/name.1 on
    OpenBSD and FreeBSD, share/man/man1/name.1 elsewhere.  init writes the
    ones that are not there.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, C: Region, N: Region, D: Region, S: Region, X: Region]
    function addInstallFiles(checkup: &![Checkup, R], command: &[Command, C], name: Span[Nat8, N], date: Span[Nat8, D], system: Span[Nat8, S], prefix: Span[Nat8, X]): Unit;

    """
    Runs the word of user the matches chose on store.  Output goes to
    out, a failure to errors.  Gives 0, or 1 when it failed.
    """
    generic [S: Type(UserStore), R: Region, M: Region, T: Region, U: Region]
    function runUser(matches: &[Matches, M], keys: UserKeys, store: &![S, R], out: &![StringBuilder, T], errors: &![StringBuilder, U]): Int32
        ensures (result = 0) or (result = 1);
end module.
