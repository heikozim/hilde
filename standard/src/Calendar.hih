"""
Dates and times of day in the Gregorian calendar, time zones from zone files, and RFC 3339 text.

- An Instant counts seconds and nanoseconds since 1970-01-01T00:00:00Z, without leap seconds.
- A Civil is what a clock shows: a date from the year 0 to 9999 and a time of day, no zone.
- A Zone is read from a file in the format of RFC 8536, version 2 or later, at most one MiB.
- After the last transition a zone file lists, the rule of its footer gives the offset.
- Outside the years 0 to 9999 the functions give None; a second 60 is never read.
- Standard.Time reads the clocks; this module only computes and reads zone files.

    let zone: Either[ZoneFailure, Zone] := loadZone("Europe/Berlin");
    let stamp: Option[Stamp] := parseRfc3339("2026-09-27T01:10:00+02:00");
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Calendar is
    """
    A point in time: seconds since 1970-01-01T00:00:00Z, and nanoseconds
    from 0 to 999999999.  Earlier times have negative seconds.
    """
    record Instant: Free is
        seconds: Int64;
        nanos: Nat32;
    end;

    """
    A date and a time of day as a clock shows them: a year from 0 to 9999,
    a month from 1 to 12, a day of that month, an hour from 0 to 23, a
    minute and a second from 0 to 59, and nanoseconds.
    """
    record Civil: Free is
        year: Int32;
        month: Nat8;
        day: Nat8;
        hour: Nat8;
        minute: Nat8;
        second: Nat8;
        nanos: Nat32;
    end;

    """
    Whether the fields of civil name a date that exists and a time of day.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function validCivil(civil: Civil): Bool;

    """
    The day of the week of civil's date as ISO 8601 counts it, 1 for Monday
    to 7 for Sunday, or 0 when civil is not valid.
    """
    function weekday(civil: Civil): Nat8
        ensures result <= 7;

    """
    What a clock offset seconds east of UTC shows at instant.  None when
    that is outside the years 0 to 9999, and for nanoseconds of a second
    or more.
    No contract: an Option result, which an ensures cannot look into.
    """
    function civilAt(instant: Instant, offset: Int32): Option[Civil];

    """
    The instant at which a clock offset seconds east of UTC shows civil.
    None when civil is not valid.
    No contract: an Option result, which an ensures cannot look into.
    """
    function instantOf(civil: Civil, offset: Int32): Option[Instant];

    ---
    --- Zones
    ---

    """
    A time zone read from a file.  It is linear: destroyZone gives it back.
    """
    type Zone: Linear;

    """
    Why no zone was read.
    """
    union ZoneFailure: Free is
        """
        The name is not one of the zone database: letters, digits and the
        marks slash, underscore, hyphen and plus, no part empty.
        """
        case NotAZoneName;
        """
        There is no such file, or it is not an ordinary file.
        """
        case ZoneMissing;
        """
        The file is not a zone file this module reads.
        """
        case ZoneMalformed;
    end;

    """
    The zone of the name, such as Europe/Berlin, from /usr/share/zoneinfo.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function loadZone(name: Span[Nat8, R]): Either[ZoneFailure, Zone];

    """
    The zone in the file at path: RFC 8536, version 2 or later, at most one
    MiB, an ordinary file.  A larger file is ZoneMalformed, found by its
    size before any of it is read.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function loadZoneFile(path: Span[Nat8, R]): Either[ZoneFailure, Zone];

    """
    The zone in data, the bytes of a zone file as loadZoneFile reads them.
    ZoneMalformed for anything RFC 8536 does not allow, for a version
    before 2, and for an offset beyond 25 hours.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readZone(data: Span[Nat8, R]): Either[ZoneFailure, Zone];

    """
    The zone of a rule in the form of the variable TZ, such as
    CET-1CEST,M3.5.0,M10.5.0/3, without a file.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function zoneOfRule(rule: Span[Nat8, R]): Either[ZoneFailure, Zone];

    """
    UTC, without a file.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function utcZone(): Zone;

    """
    The zone the system is set to: the variable TZ when it is set, a zone
    name with or without a leading colon or else a rule, and the file
    /etc/localtime when it is not.
    No contract: an Either result, which an ensures cannot look into.
    """
    function localZone(): Either[ZoneFailure, Zone];

    """
    Gives back everything a zone holds.
    No contract: it only frees or closes what it is given.
    """
    function destroyZone(zone: Zone): Unit;

    """
    The offset east of UTC in seconds, and whether it is daylight saving
    time.
    """
    record Offset: Free is
        seconds: Int32;
        daylight: Bool;
    end;

    """
    The zone's offset at instant.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function offsetAt(zone: &[Zone, R], instant: Instant): Offset;

    """
    The zone's abbreviation at instant, such as CET or CEST.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function abbreviationAt(zone: &[Zone, R], instant: Instant): String;

    """
    What a clock in the zone shows at instant; None outside the years 0 to
    9999.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function localAt(zone: &[Zone, R], instant: Instant): Option[Civil];

    """
    When a clock in the zone shows a time of day.  Exactly once in most of
    the year.  Twice in the hour the clocks are put back: the earlier and
    the later instant.  Never in the hour they are put forward: then before
    is read with the offset after the change and lies before it, after is
    read with the earlier offset and lies after it.  NotACivil
    when the civil is not valid.
    """
    union Resolved: Free is
        case Exactly is
            instant: Instant;
        case Twice is
            earlier: Instant;
            later: Instant;
        case Skipped is
            before: Instant;
            after: Instant;
        case NotACivil;
    end;

    """
    The instants at which a clock in the zone shows civil.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function resolveLocal(zone: &[Zone, R], civil: Civil): Resolved;

    ---
    --- RFC 3339
    ---

    """
    instant as RFC 3339 text for a clock offset seconds east of UTC, whole
    minutes: 2026-09-27T01:10:00Z for the offset 0, else with the offset
    as +02:00, and the nanoseconds as a fraction without trailing zeros
    when they are not 0.  None outside the years 0 to 9999 and for an
    offset that is not whole minutes or beyond 23:59.
    No contract: an Option result, which an ensures cannot look into.
    """
    function formatRfc3339(instant: Instant, offset: Int32): Option[String];

    """
    An instant and the offset it was written with.
    """
    record Stamp: Free is
        instant: Instant;
        offset: Int32;
    end;

    """
    RFC 3339 text read: a date, T or t, a time with an optional fraction of
    one to nine digits, and Z, z or an offset of hours and minutes.  None
    for anything else, for a date or time that does not exist, and for a
    second 60, which the system clock does not count.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseRfc3339(text: Span[Nat8, R]): Option[Stamp];
end module.
