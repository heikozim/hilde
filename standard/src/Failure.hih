"""
A failure for the Left of an Either: its operation, its kind, its message and the failure behind it.

- It is meant for the boundary of a module or a programme, where a caller decides by the kind.
- Each operation on the way out may wrap a failure under its own name, with or without a kind.
- The kind of a chain is the first that is not Unclassified, from the outermost to the first cause.
- A kind maps to an HTTP status, so a server can answer a request with it.
- A Failure is linear: destroyFailure gives back the whole chain.
- Wrapping stops the programme when no memory is left, as a string does.

    let failure: Failure := makeFailure("file.write", Unclassified(), "disk full");
    let outer: Failure := wrapFailure("store.save", failure);
    let line: String := describeFailure(&outer);
    destroyFailure(outer);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Failure is
    """
    What kind of failure it is, for a caller that decides by it.
    """
    union FailureKind: Free is
        """
        No kind given: this failure leaves the question to its cause.
        """
        case Unclassified;
        """
        What was asked for does not exist.
        """
        case NotFound;
        """
        The caller may not do what it asked for.
        """
        case NoPermission;
        """
        What the caller gave is not valid.
        """
        case Invalid;
    end;

    """
    A failure with its operation, its kind, its message and the failure
    that caused it, if any.  Linear: destroyFailure gives it back, with
    its whole chain.
    """
    type Failure: Linear;

    """
    A failure of the operation op, of kind, with message, caused by
    nothing further.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [O: Region, M: Region]
    function makeFailure(op: Span[Nat8, O], kind: FailureKind, message: Span[Nat8, M]): Failure;

    """
    cause wrapped under the operation op, with no kind of its own, so
    that the kind of the chain is found further down.  Stops the programme
    when there is no memory left to keep cause, as a string does.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function wrapFailure(op: Span[Nat8, R], cause: Failure): Failure;

    """
    cause wrapped under the operation op with kind, which is the kind of
    the chain unless kind is Unclassified.  Stops the programme when there
    is no memory left to keep cause.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function wrapFailureAs(op: Span[Nat8, R], kind: FailureKind, cause: Failure): Failure;

    """
    The kind of the chain: the first kind that is not Unclassified, from
    failure towards its first cause, or Unclassified when there is none.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function kindOf(failure: &[Failure, R]): FailureKind;

    """
    The operation of failure itself, the outermost of its chain.
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function operationOf(failure: &[Failure, R]): Span[Nat8, R];

    """
    The message of the first cause of the chain, the failure that was not
    made by wrapping.
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function messageOf(failure: &[Failure, R]): Span[Nat8, R];

    """
    How many failures the chain holds, failure itself included.  A contract
    on makeFailure, wrapFailure and wrapFailureAs could say how the length
    of the chain grows, but a condition may not call this function: it reaches
    C through Standard.Box, so those three state none.
    """
    generic [R: Region]
    function chainLength(failure: &[Failure, R]): Index
        ensures result >= 1;

    """
    The chain as one line: the operations from the outermost, each
    followed by a colon and a space, then the message of the first cause.
    An empty operation is left out.  For a failure of the operation
    file.write with the message disk full, wrapped under store.save, it is
    store.save: file.write: disk full.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function describeFailure(failure: &[Failure, R]): String;

    """
    Whether failure or one of its causes is of kind.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function hasKind(failure: &[Failure, R], kind: FailureKind): Bool;

    """
    The HTTP status a kind stands for: 404 for NotFound, 403 for
    NoPermission, 400 for Invalid and 500 for Unclassified.
    """
    function httpStatus(kind: FailureKind): Nat16
        ensures (result >= 100) and (result <= 599);

    """
    Gives back a failure and its whole chain.
    No contract: it only frees or closes what it is given.
    """
    function destroyFailure(failure: Failure): Unit;
end module.
