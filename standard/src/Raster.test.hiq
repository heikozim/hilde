import Standard.Buffer (
    Buffer,
    initialize,
    nth,
    getSpanMut,
    getSpan,
    destroyFree
);
import Standard.Raster (
    fillRect,
    blendMask,
    copyRows
);
import Standard.Testing (assertTrue);

module body Standard.Raster.Test is
    -- The four bytes of the pixel at column x and row y of a picture width
    -- pixels wide, as one number with red highest.
    generic [R: Region]
    function pixel(buf: &[Buffer[Nat8], R], width: Index, x: Index, y: Index): Nat64 is
        let at: Index := ((y * width) + x) * 4;
        var value: Nat64 := 0;
        var k: Index := 0;
        while k < 4 do
            case toNat64(nth(buf, at + k)) of
                when Some(value as b: Nat64) do
                    value := (value * 256) + b;
                when None do
                    skip;
            end case;
            k := k + 1;
        end while;
        return value;
    end;

    -- A rectangle half outside a picture of 4 by 3 pixels: from column -1
    -- and row 1, 3 by 5 pixels, so columns 0 and 1 of rows 1 and 2.
    function testFillRectClips(): Unit is
        var buf: Buffer[Nat8] := initialize(48, 0);
        borrow b: &![Buffer[Nat8], R] := &!buf do
            let sp: Span![Nat8, R] := getSpanMut(b, 0, 47);
            fillRect(sp, 4, 3, -1, 1, 3, 5, 287454020);
        end borrow;
        assertTrue(pixel(&buf, 4, 0, 0) = 0, "row 0 left as it was");
        assertTrue(pixel(&buf, 4, 0, 1) = 287454020, "column 0 of row 1 filled");
        assertTrue(pixel(&buf, 4, 1, 2) = 287454020, "column 1 of row 2 filled");
        assertTrue(pixel(&buf, 4, 2, 2) = 0, "column 2 left as it was");
        destroyFree(buf);
        return nil;
    end;

    -- A rectangle wholly outside, on each side, draws nothing.
    function testFillRectOutside(): Unit is
        var buf: Buffer[Nat8] := initialize(16, 0);
        borrow b: &![Buffer[Nat8], R] := &!buf do
            var sp: Span![Nat8, R] := getSpanMut(b, 0, 15);
            fillRect(&~sp, 2, 2, 2, 0, 5, 5, 4294967295);
            fillRect(&~sp, 2, 2, -5, 0, 5, 5, 4294967295);
            fillRect(&~sp, 2, 2, 0, 2, 5, 5, 4294967295);
            fillRect(sp, 2, 2, -9223372036854775807, -9223372036854775807, 65536, 65536, 4294967295);
        end borrow;
        var i: Index := 0;
        var zero: Bool := true;
        while i < 16 do
            if nth(&buf, i) /= 0 then
                zero := false;
            end if;
            i := i + 1;
        end while;
        assertTrue(zero, "nothing drawn");
        destroyFree(buf);
        return nil;
    end;

    -- A mask of 2 by 2 with coverage 255, 0, 128 and 255 drawn opaque white
    -- at column 1 and row -1 of a black opaque picture of 3 by 2: only its
    -- lower row lands, at columns 1 and 2 of row 0.
    function testBlendMask(): Unit is
        var buf: Buffer[Nat8] := initialize(24, 0);
        borrow b: &![Buffer[Nat8], R] := &!buf do
            var black: Span![Nat8, R] := getSpanMut(b, 0, 23);
            fillRect(&~black, 3, 2, 0, 0, 3, 2, 255);
        end borrow;
        var mask: Buffer[Nat8] := initialize(4, 255);
        borrow m: &![Buffer[Nat8], M] := &!mask do
            var ms: Span![Nat8, M] := getSpanMut(m, 0, 3);
            let none: Nat8 := 0;
            let half: Nat8 := 128;
            ms[1] := none;
            ms[2] := half;
        end borrow;
        borrow r: &[Buffer[Nat8], Q] := &mask do
            let coverage: Span[Nat8, Q] := getSpan(r, 0, 3);
            borrow b: &![Buffer[Nat8], R] := &!buf do
                let sp: Span![Nat8, R] := getSpanMut(b, 0, 23);
                blendMask(sp, 3, 2, coverage, 2, 1, -1, 4294967295);
            end borrow;
        end borrow;
        assertTrue(pixel(&buf, 3, 0, 0) = 255, "column 0 left black");
        assertTrue(pixel(&buf, 3, 1, 0) = 2155905279, "half coverage gives 128 in each colour");
        assertTrue(pixel(&buf, 3, 2, 0) = 4294967295, "full coverage gives white");
        assertTrue(pixel(&buf, 3, 1, 1) = 255, "row 1 left black");
        destroyFree(mask);
        destroyFree(buf);
        return nil;
    end;

    -- Row 1 of a picture of 2 by 3 copied into a second one; rows 0 and 2
    -- stay.
    function testCopyRows(): Unit is
        var source: Buffer[Nat8] := initialize(24, 9);
        var target: Buffer[Nat8] := initialize(24, 0);
        borrow r: &[Buffer[Nat8], S] := &source do
            let from_source: Span[Nat8, S] := getSpan(r, 0, 23);
            borrow t: &![Buffer[Nat8], Q] := &!target do
                let sp: Span![Nat8, Q] := getSpanMut(t, 0, 23);
                copyRows(from_source, sp, 2, 1, 2);
            end borrow;
        end borrow;
        assertTrue(nth(&target, 7) = 0, "row 0 left");
        assertTrue(nth(&target, 8) = 9, "row 1 copied, first byte");
        assertTrue(nth(&target, 15) = 9, "row 1 copied, last byte");
        assertTrue(nth(&target, 16) = 0, "row 2 left");
        destroyFree(source);
        destroyFree(target);
        return nil;
    end;
end module body.
