"""
A store for Standard.Users in an SQLite database of Standard.Sqlite.

- The users are kept in the table hilde_users, the failed attempts in hilde_user_failures.
- openSqliteUsers makes the two tables and their index when they are missing.
- The store holds the connection; closeSqliteUsers gives it back.

    case openSqliteUsers(db) of
        when Right(right as opened: SqliteUsers) do
            var users: SqliteUsers := opened;
            let added: Either[UserError, Bool] := addUser(&!users, "alice", asSpan(&password));
            closeDatabase(closeSqliteUsers(users));
        when Left(left as failed: SqliteUsersFailed) do
            let { db: Connection[Writing], error: UserError } := failed;
            closeDatabase(db);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Sqlite (
    Connection,
    Writing
);
import Standard.Users (
    UserError,
    UserStore
);

module Standard.SqliteUsers is
    """
    A store in the tables hilde_users and hilde_user_failures of an SQLite
    database it holds.
    """
    type SqliteUsers: Linear;

    """
    Makes the two tables and their index when they are missing, and holds
    db.  On Left the connection comes back with the error.
    No contract: the result is I/O.
    """
    function openSqliteUsers(db: Connection[Writing]): Either[SqliteUsersFailed, SqliteUsers];

    """
    A store that could not be opened, and its connection.
    """
    record SqliteUsersFailed: Linear is
        db: Connection[Writing];
        error: UserError;
    end;

    """
    Gives the connection back.
    No contract: it only frees or closes what it is given.
    """
    function closeSqliteUsers(users: SqliteUsers): Connection[Writing];

    instance UserStore(SqliteUsers);
end module.
