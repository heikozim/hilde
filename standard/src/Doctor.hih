"""
Checks that the files, directories, socket and account a programme declares are there as they should be, and makes what is not there.

- One line per check, ok or missing, and for a missing one the command that makes it right on this system.
- A file or directory must have the kind, the mode of Standard.Paths and the owner: the service account, or the running user for a user tool.
- A socket must take a connection; nothing is written to it.
- A service's commands start with doas on OpenBSD and with sudo elsewhere when the process is not the superuser.
- Paths in the commands are quoted for the shell when they hold more than letters, digits and / . _ - + : @ % , =.
- runCheckup changes nothing; runInit makes only what is not there, overwrites nothing and runs its commands without a shell.
- For a service with a socket, init prints the FastCGIserver and UrlToolkit blocks that hand a Hiawatha site to it.

    var checkup: Checkup := makeCheckup("notes", Service());
    expectPath(&!checkup, DataDirectory(), "/var/notes");
    var out: StringBuilder := makeStringBuilder();
    let missing: Index := runCheckup(&checkup, false, &!out);
    destroyCheckup(checkup);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder
);
import Standard.Paths (
    AppKind,
    PathKind,
    isAppName
);

module Standard.Doctor is
    """
    What a programme declares: its app name, whether it is a service or a
    user tool, and the paths it needs, each with what it is for.  Linear:
    destroyCheckup gives it back.
    """
    type Checkup: Linear;

    """
    A checkup of nothing yet for app as kind.
    """
    function makeCheckup(app: Span[Nat8, Static], kind: AppKind): Checkup
        requires isAppName(app);

    """
    Adds the path of what to the checkup.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, S: Region]
    function expectPath(checkup: &![Checkup, R], what: PathKind, path: Span[Nat8, S]): Unit;

    """
    Adds a file that init writes with text and mode when it is not there,
    making its directory with mode 0755 when that is missing; runCheckup
    says whether it is there.  A file that is there is never written.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, P: Region]
    function expectFile(checkup: &![Checkup, R], path: Span[Nat8, P], text: String, mode: Nat32): Unit;

    """
    Adds a check another module made, such as whether the vault opens:
    name says what, path where; a missing one with its reason and the
    command that fixes it, empty when there is none.  runCheckup lists it
    after the paths.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, P: Region, W: Region, F: Region]
    function addResult(checkup: &![Checkup, R], name: Span[Nat8, Static], path: Span[Nat8, P], good: Bool, reason: Span[Nat8, W], fix: Span[Nat8, F]): Unit;

    """
    Gives the checkup back.
    No contract: it only frees or closes what it is given.
    """
    function destroyCheckup(checkup: Checkup): Unit;

    """
    Runs every check on this system and writes the lines, or with json
    true a JSON array of one object per check with what, path, ok, reason
    and fix, to out.  Returns how many are missing; a programme exits with
    a status other than 0 when that is not 0.
    No contract: the result depends on the system.
    """
    generic [R: Region, T: Region]
    function runCheckup(checkup: &[Checkup, R], json: Bool, out: &![StringBuilder, T]): Index;

    """
    As runCheckup, with the commands written for the system named, as
    Standard.Platform names it, and for a process that is the superuser or
    not.
    No contract: the result depends on the system.
    """
    generic [S: Region, R: Region, T: Region]
    function runCheckupOn(system: Span[Nat8, S], superuser: Bool, checkup: &[Checkup, R], json: Bool, out: &![StringBuilder, T]): Index;

    """
    Makes what runCheckup finds not there, in order: the service account,
    each file and directory with its mode and owner, the service file of
    the system for binary, and the service enabled at boot.  Nothing that
    is there is changed or overwritten.  The first step that fails ends
    the run.  With dryRun, or for a service when the process is not the
    superuser, nothing is done: the steps are listed, and without dryRun
    the command that runs init as the superuser.  Writes one line per
    step to out, then for a service with a socket the text of hiawathaBlock,
    and returns how many steps are not done.
    No contract: the result depends on the system.
    """
    generic [B: Region, R: Region, T: Region]
    function runInit(checkup: &[Checkup, R], binary: Span[Nat8, B], dryRun: Bool, out: &![StringBuilder, T]): Index;

    """
    As runInit, for the system named and a process that is the superuser
    or not.
    No contract: the result depends on the system.
    """
    generic [S: Region, B: Region, R: Region, T: Region]
    function runInitOn(system: Span[Nat8, S], superuser: Bool, checkup: &[Checkup, R], binary: Span[Nat8, B], dryRun: Bool, out: &![StringBuilder, T]): Index;

    """
    The service file init writes on the system for the checkup's app
    running binary: an rc.d script on OpenBSD and FreeBSD, a systemd unit
    with its hardening on Linux, which may write only in the checkup's
    directories, and on macOS the property list of a launchd daemon that
    runs as the service account and is started again when it ends.
    No contract: a text whose length follows its input.
    """
    generic [S: Region, R: Region, B: Region]
    function serviceFile(system: Span[Nat8, S], checkup: &[Checkup, R], binary: Span[Nat8, B]): String;

    """
    The blocks of hiawatha.conf that hand every request of a site to the
    checkup's socket: a FastCGIserver and a UrlToolkit, both named by the
    app, and a comment with the UseToolkit line for the VirtualHost.
    Empty when the checkup declares no socket.
    No contract: the text is made from the declared paths.
    """
    generic [R: Region]
    function hiawathaBlock(checkup: &[Checkup, R]): String;
end module.
