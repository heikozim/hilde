"""
A Standard.Cache that tasks share, with one fill per key.

- When several tasks miss the same key at once, one runs the fill and the others wait for its value.
- Tasks reach it through a read reference lent by a lending scope of Standard.Task.
- While a fill runs, other keys stay usable.
- A task that waits for the fill of its key lets the other runnable tasks run meanwhile.
- A clear or flush during a fill keeps its value out, and the next miss fills again.
- A fill that makes no value stores nothing, and the next task that misses fills itself.
- Limits, lifetimes and which entry goes first are those of Standard.Cache.

    case makeSharedCache(1000, 1048576, 60000000000) of
        when Some(value as cache: SharedCache[Nat64, Nat64]) do
            servePrices(cache);
        when None do
            reportNoMemory();
    end case;

    let price: Option[Nat64] := getWith(prices, item, nowNanos(), lookUpPrice);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Buffer (
    Buffer
);
import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Hash (
    Hashable
);
import Standard.Cache (
    Filled
);

module Standard.SharedCache is
    """
    The shared cache.  Linear: destroySharedCache ends it and gives back
    what it held.
    """
    type SharedCache[K: Type, V: Type]: Linear;

    """
    A shared cache with the limits of Standard.Cache.makeCache; None when
    there is no memory for its mutex.
    """
    generic [K: Free(TotalOrder, Hashable), V: Type]
    function makeSharedCache(limit: Index, sizeLimit: Nat64, lifetime: Nat64): Option[SharedCache[K, V]]
        requires (limit > 0) and (sizeLimit > 0);

    """
    The entries, and the end of the shared cache.  No task may hold it.
    No contract: it only frees or closes what it is given.
    """
    generic [K: Free(TotalOrder, Hashable), V: Type]
    function destroySharedCache(shared: SharedCache[K, V]): Buffer[Pair[K, V]];

    """
    The value under key; on a miss the value fill makes, made once for all
    the tasks that miss key at the same time.  None when fill makes none.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Free(TotalOrder, Hashable), V: Free, R: Region]
    function getWith(shared: &[SharedCache[K, V], R], key: K, now: Nat64, fill: Fn[K, Option[Filled[V]]]): Option[V];

    """
    Remove the entry under key and give it back; a fill running for any key
    stores nothing.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Free(TotalOrder, Hashable), V: Type, R: Region]
    function clear(shared: &[SharedCache[K, V], R], key: K): Option[Pair[K, V]];

    """
    Remove every entry and give them back; a fill running stores nothing.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [K: Free(TotalOrder, Hashable), V: Type, R: Region]
    function flush(shared: &[SharedCache[K, V], R]): Buffer[Pair[K, V]];

    """
    How many fills getWith has run, for a test and for a log.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [K: Free(TotalOrder, Hashable), V: Type, R: Region]
    function fillCount(shared: &[SharedCache[K, V], R]): Nat64;

    """
    How many entries there are.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [K: Free(TotalOrder, Hashable), V: Type, R: Region]
    function sharedCount(shared: &[SharedCache[K, V], R]): Index;
end module.
