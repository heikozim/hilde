import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    nthByte
);
import Standard.Base32 (
    encodeBase32,
    encodeBase32Unpadded,
    decodeBase32
);

module body Standard.Base32.Test is
    generic [R: Region]
    function same(text: &[String, R], expected: Span[Nat8, Static]): Bool is
        let size: Index := length(text);
        if size /= spanLength(expected) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            if nthByte(text, i) /= expected[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- One vector of RFC 4648 section 10, both ways, padded and not.
    function vector(plain: Span[Nat8, Static], padded: Span[Nat8, Static], unpadded: Span[Nat8, Static]): Unit is
        let encoded: String := encodeBase32(plain);
        assertTrue(same(&encoded, padded), "padded");
        destroyString(encoded);
        let bare: String := encodeBase32Unpadded(plain);
        assertTrue(same(&bare, unpadded), "unpadded");
        destroyString(bare);
        decodes(padded, plain, "the padded form decoded");
        decodes(unpadded, plain, "the unpadded form decoded");
        return nil;
    end;

    function decodes(text: Span[Nat8, Static], expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case decodeBase32(text) of
            when Some(value as plain: String) do
                assertTrue(same(&plain, expected), message);
                destroyString(plain);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function refused(text: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case decodeBase32(text) of
            when Some(value as plain: String) do
                destroyString(plain);
                assertFailure(message);
            when None do
                assertSuccess(message);
        end case;
        return nil;
    end;

    function testVectors(): Unit is
        vector("", "", "");
        vector("f", "MY======", "MY");
        vector("fo", "MZXQ====", "MZXQ");
        vector("foo", "MZXW6===", "MZXW6");
        vector("foob", "MZXW6YQ=", "MZXW6YQ");
        vector("fooba", "MZXW6YTB", "MZXW6YTB");
        vector("foobar", "MZXW6YTBOI======", "MZXW6YTBOI");
        return nil;
    end;

    function testDecoding(): Unit is
        decodes("mzxw6ytboi", "foobar", "small letters");
        decodes("GEZDGNBVGY3TQOJQGEZDGNBVGY3TQOJQ", "12345678901234567890", "the secret of RFC 6238");
        refused("MZXW6YTB1", "a 1 is not in the alphabet");
        refused("M", "one character is no encoding");
        refused("MZX", "three characters are no encoding");
        refused("MZ======", "bits left over that are not zero");
        refused("MY=====", "padding that does not fill eight");
        refused("M=Y=====", "padding in the middle");
        refused("MZXW6 YTB", "a space");
        return nil;
    end;
end module body.
