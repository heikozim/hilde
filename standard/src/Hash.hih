"""
Keyed hashing with SipHash, and the type class Hashable that a hash map needs of its keys.

- SipHash takes a key of 128 bits, as two Nat64, and a message, and gives 64 bits.
- Without the key an attacker cannot choose many keys of a map that fall on one slot.
- SipHash-1-3 is the variant for hash maps: one round per word and three at the end.
- SipHash-2-4 is slower and meant where the output leaves the programme.
- Two values equal under their type's order must give the same hash under the same key.
- The integer types, Index and String are Hashable here; sipHash13 and sipHash24 never fail.

    let tag: Nat64 := sipHash24(key0, key1, asSpan(&message));
    let slot: Nat64 := hashOf(&name, key0, key1);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Hash is
    """
    SipHash-1-3 of bytes under the key key0, key1: the bytes read as words
    of eight, little-endian.  Never fails.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function sipHash13(key0: Nat64, key1: Nat64, bytes: Span[Nat8, R]): Nat64;

    """
    SipHash-2-4 of bytes under the key key0, key1.  Never fails.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function sipHash24(key0: Nat64, key1: Nat64, bytes: Span[Nat8, R]): Nat64;

    """
    A type whose values a keyed hash map can hash.  Two values equal under
    the type's order must give the same hash under the same key.
    """
    typeclass Hashable(T: Type) is
        """
        SipHash-1-3 of the value's bytes under the key key0, key1.
        No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
        """
        generic [R: Region]
        method hashOf(value: &[T, R], key0: Nat64, key1: Nat64): Nat64;
    end;

    instance Hashable(Nat8);
    instance Hashable(Nat16);
    instance Hashable(Nat32);
    instance Hashable(Nat64);
    instance Hashable(Int8);
    instance Hashable(Int16);
    instance Hashable(Int32);
    instance Hashable(Int64);
    instance Hashable(Index);
    instance Hashable(String);
end module.
