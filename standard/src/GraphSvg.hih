"""
Node and edge networks drawn as SVG documents, built on Standard.Svg.

- The layout is decided by the graph alone: the same graph and the same options give the same bytes on every run.
- A graph without a cycle is drawn in layers: a node stands on the layer after the layers of the nodes its edges come from, and the nodes of one layer stand side by side in the order of their slots.
- A graph with a cycle is drawn with its nodes on one circle, in the order of their slots, the first at the top.
- The values of the nodes are the labels; they are escaped like every text of Standard.Svg.
- Every part carries a class, so a style sheet colours the drawing; the colours the options give are written as they stand.

    var graph: Graph[String, Unit] := makeGraph();
    let a: NodeId := addNode(&!graph, "first");
    let b: NodeId := addNode(&!graph, "second");
    let added: Either[Unit, EdgeId] := addEdge(&!graph, a, b, nil);
    let svg: String := renderGraph(&graph, makeGraphOptions(400, 300));
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String,
    length
);
import Standard.Graph (
    Graph
);

module Standard.GraphSvg is
    """
    How a drawing is laid out and coloured: the size of the document and
    the classes and colours of its parts.
    """
    record GraphOptions: Free is
        """
        The width of the document in pixels.
        """
        width: Int64;
        """
        The height of the document in pixels.
        """
        height: Int64;
        """
        The class of the circle of a node.
        """
        nodeClass: Span[Nat8, Static];
        """
        The class of the line of an edge and of its arrowhead.
        """
        edgeClass: Span[Nat8, Static];
        """
        The class of the text of a label.
        """
        labelClass: Span[Nat8, Static];
        """
        What the circle of a node is filled with, such as currentColor.
        """
        nodeFill: Span[Nat8, Static];
        """
        What the line of an edge and its arrowhead are drawn with.
        """
        edgeStroke: Span[Nat8, Static];
    end;

    """
    Options with the given size and the usual classes and colours: the
    classes graph-node, graph-edge and graph-label, and currentColor
    throughout, so a style sheet colours the drawing.
    """
    function makeGraphOptions(width: Int64, height: Int64): GraphOptions
        requires (width >= 100) and (width <= 10000) and (height >= 100) and (height <= 10000)
        ensures (result.width = width) and (result.height = height);

    """
    The graph as a document of the size the options give.  A node is a
    circle of the radius 20 with its label in the middle; an edge is a
    line from the circle of its source to the circle of its target, with
    an arrowhead at the target.  An edge that leads from a node to itself
    is drawn as nothing.  The root carries the class svg-graph.
    """
    generic [E: Type, R: Region]
    function renderGraph(graph: &[Graph[String, E], R], options: GraphOptions): String
        ensures length(&result) > 0;
end module.
