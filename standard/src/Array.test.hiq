import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.Array (
    Array,
    View,
    Shape,
    maxRank,
    maxElements,
    nat8Type,
    int32Type,
    int64Type,
    float32Type,
    float64Type,
    boolType,
    isElementType,
    elementSize,
    shape1,
    shape2,
    shape3,
    shape4,
    rank,
    extent,
    paddedExtent,
    count,
    sameShape,
    isBroadcastable,
    broadcastShapes,
    broadcastCount,
    productShape,
    zeros,
    destroy,
    elementType,
    shape,
    size,
    byteCount,
    setNat8,
    setInt32,
    setInt64,
    setFloat32,
    setFloat64,
    setBool,
    view,
    viewElementType,
    viewShape,
    viewRank,
    viewSize,
    viewExtent,
    viewStride,
    viewOffset,
    isContiguous,
    sliceAxis,
    pick,
    swapAxes,
    broadcast,
    ordinal,
    getNat8,
    getInt32,
    getInt64,
    getFloat32,
    getFloat64,
    getBool,
    copy,
    packedBytes,
    fromPacked
);

module body Standard.Array.Test is
    ---
    --- Limits, element types and shapes
    ---

    function testLimits(): Unit is
        assertTrue(maxRank() = 4, "the largest rank is 4");
        assertTrue(maxElements() = 2147483648, "the largest count is 2^31");
        assertTrue(nat8Type() = 0, "Nat8 is code 0");
        assertTrue(int32Type() = 1, "Int32 is code 1");
        assertTrue(int64Type() = 2, "Int64 is code 2");
        assertTrue(float32Type() = 5, "Float32 is code 5");
        assertTrue(float64Type() = 6, "Float64 is code 6");
        assertTrue(boolType() = 7, "Bool is code 7");
        return nil;
    end;

    function testElementTypes(): Unit is
        assertTrue(isElementType(0) and isElementType(1), "codes 0 and 1 are types");
        assertTrue(isElementType(2) and isElementType(5), "codes 2 and 5 are types");
        assertTrue(isElementType(6) and isElementType(7), "codes 6 and 7 are types");
        assertFalse(isElementType(3), "code 3 (Nat32) is not an element type");
        assertFalse(isElementType(4), "code 4 (Nat64) is not an element type");
        assertFalse(isElementType(8), "code 8 is not an element type");
        assertFalse(isElementType(255), "code 255 is not an element type");
        assertTrue(elementSize(nat8Type()) = 1, "a Nat8 takes 1 byte");
        assertTrue(elementSize(boolType()) = 1, "a Bool takes 1 byte");
        assertTrue(elementSize(int32Type()) = 4, "an Int32 takes 4 bytes");
        assertTrue(elementSize(float32Type()) = 4, "a Float32 takes 4 bytes");
        assertTrue(elementSize(int64Type()) = 8, "an Int64 takes 8 bytes");
        assertTrue(elementSize(float64Type()) = 8, "a Float64 takes 8 bytes");
        return nil;
    end;

    function testShapes(): Unit is
        let a: Shape := shape1(5);
        assertTrue((rank(a) = 1) and (count(a) = 5), "a vector of 5");
        let b: Shape := shape2(2, 3);
        assertTrue((rank(b) = 2) and (extent(b, 0) = 2) and (extent(b, 1) = 3), "a 2 by 3 matrix");
        assertTrue(count(b) = 6, "6 elements");
        let c: Shape := shape3(2, 3, 4);
        assertTrue((rank(c) = 3) and (count(c) = 24), "2 by 3 by 4");
        let d: Shape := shape4(2, 3, 4, 5);
        assertTrue((rank(d) = 4) and (count(d) = 120), "2 by 3 by 4 by 5");
        assertTrue(paddedExtent(b, 2) = 1, "an axis above the rank has extent 1");
        assertTrue(paddedExtent(b, 3) = 1, "so has the last one");
        assertTrue(sameShape(b, shape2(2, 3)), "equal shapes");
        assertFalse(sameShape(b, shape2(3, 2)), "the extents differ");
        assertFalse(sameShape(shape1(6), b), "the ranks differ");
        let largest: Shape := shape1(maxElements());
        assertTrue(count(largest) = 2147483648, "the largest vector");
        return nil;
    end;

    -- Broadcasting by the rules of NumPy.
    function testBroadcastShapes(): Unit is
        assertTrue(isBroadcastable(shape1(3), shape2(2, 3)), "(3) stretches to (2,3)");
        assertTrue(isBroadcastable(shape2(1, 3), shape2(4, 3)), "(1,3) stretches to (4,3)");
        assertTrue(isBroadcastable(shape2(4, 1), shape2(4, 3)), "(4,1) stretches to (4,3)");
        assertTrue(isBroadcastable(shape2(4, 3), shape2(4, 3)), "equal shapes");
        assertTrue(isBroadcastable(shape1(1), shape3(2, 3, 4)), "(1) stretches to (2,3,4)");
        assertFalse(isBroadcastable(shape1(2), shape2(2, 3)), "(2) does not meet (2,3): the last axes differ");
        assertFalse(isBroadcastable(shape2(2, 3), shape1(3)), "a larger rank does not shrink");
        assertFalse(isBroadcastable(shape2(4, 3), shape2(4, 1)), "an extent above 1 does not shrink");
        case broadcastShapes(shape2(5, 1), shape1(3)) of
            when Some(value as joined: Shape) do
                assertTrue(sameShape(joined, shape2(5, 3)), "(5,1) with (3) is (5,3)");
            when None do
                assertTrue(false, "(5,1) and (3) broadcast");
        end case;
        case broadcastShapes(shape3(2, 1, 4), shape2(3, 1)) of
            when Some(value as joined: Shape) do
                assertTrue(sameShape(joined, shape3(2, 3, 4)), "(2,1,4) with (3,1) is (2,3,4)");
            when None do
                assertTrue(false, "(2,1,4) and (3,1) broadcast");
        end case;
        case broadcastShapes(shape1(1), shape1(1)) of
            when Some(value as joined: Shape) do
                assertTrue(sameShape(joined, shape1(1)), "(1) with (1) is (1)");
            when None do
                assertTrue(false, "(1) and (1) broadcast");
        end case;
        case broadcastShapes(shape2(2, 3), shape2(2, 4)) of
            when Some(value as joined: Shape) do
                assertTrue(false, "(2,3) and (2,4) do not broadcast");
            when None do
                assertTrue(true, "(2,3) and (2,4) are refused");
        end case;
        case broadcastShapes(shape1(3), shape1(4)) of
            when Some(value as joined: Shape) do
                assertTrue(false, "(3) and (4) do not broadcast");
            when None do
                assertTrue(true, "(3) and (4) are refused");
        end case;
        return nil;
    end;

    -- The element count of the broadcast, as a requires states it.
    function testBroadcastCount(): Unit is
        assertTrue(broadcastCount(shape2(2, 3), shape1(3)) = 6, "(2,3) with (3) holds 6 elements");
        assertTrue(broadcastCount(shape2(5, 1), shape1(3)) = 15, "(5,1) with (3) holds 15 elements");
        assertTrue(broadcastCount(shape3(2, 1, 4), shape2(3, 1)) = 24, "(2,1,4) with (3,1) holds 24 elements");
        assertTrue(broadcastCount(shape1(1), shape1(1)) = 1, "(1) with (1) holds 1 element");
        assertTrue(broadcastCount(shape2(2, 3), shape1(2)) = 0, "(2,3) and (2) do not broadcast");
        assertTrue(broadcastCount(shape1(3), shape1(4)) = 0, "(3) and (4) do not broadcast");
        assertTrue(broadcastCount(shape2(2, 3), shape2(2, 4)) = 0, "(2,3) and (2,4) do not broadcast");
        return nil;
    end;

    -- The check of the shapes of a product, as a requires states it.
    function testProductShape(): Unit is
        let p: Shape := productShape(shape2(2, 3), shape2(3, 5));
        assertTrue(sameShape(p, shape2(2, 5)), "(2,3) times (3,5) is (2,5)");
        return nil;
    end;

    ---
    --- Owning arrays and typed elements
    ---

    generic [R: Region]
    function checkFloat64(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(viewElementType(v) = float64Type(), "the view has the type of the array");
        assertTrue(getFloat64(v, 0) = 1.5, "ordinal 0");
        assertTrue(getFloat64(v, 1) = -2.25, "ordinal 1");
        assertTrue(getFloat64(v, 2) = 0.0, "ordinal 2 stays zero");
        assertTrue(getFloat64(v, 5) = 1.0e300, "ordinal 5");
        return nil;
    end;

    function testFloat64(): Unit is
        var a: Array := zeros(float64Type(), shape2(2, 3));
        assertTrue(elementType(&a) = float64Type(), "the element type");
        assertTrue(size(&a) = 6, "the size");
        assertTrue(byteCount(&a) = 48, "6 elements of 8 bytes");
        setFloat64(&!a, 0, 1.5);
        setFloat64(&!a, 1, -2.25);
        setFloat64(&!a, 5, 1.0e300);
        checkFloat64(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkFloat32(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(getFloat32(v, 0) = 0.5, "ordinal 0");
        assertTrue(getFloat32(v, 2) = -8.0, "ordinal 2");
        assertTrue(getFloat32(v, 1) = 0.0, "ordinal 1 stays zero");
        return nil;
    end;

    function testFloat32(): Unit is
        var a: Array := zeros(float32Type(), shape1(3));
        assertTrue(byteCount(&a) = 12, "3 elements of 4 bytes");
        setFloat32(&!a, 0, 0.5);
        setFloat32(&!a, 2, -8.0);
        checkFloat32(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkInt64(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(getInt64(v, 0) = 9223372036854775807, "the largest Int64");
        assertTrue(getInt64(v, 1) = -9223372036854775807, "a very small Int64");
        assertTrue(getInt64(v, 2) = -1, "minus one");
        assertTrue(getInt64(v, 3) = 0, "zero");
        return nil;
    end;

    function testInt64(): Unit is
        var a: Array := zeros(int64Type(), shape1(4));
        setInt64(&!a, 0, 9223372036854775807);
        setInt64(&!a, 1, -9223372036854775807);
        setInt64(&!a, 2, -1);
        checkInt64(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkInt32(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(getInt32(v, 0) = 2147483647, "the largest Int32");
        assertTrue(getInt32(v, 1) = -2147483647, "a very small Int32");
        assertTrue(getInt32(v, 2) = -1, "minus one");
        return nil;
    end;

    function testInt32(): Unit is
        var a: Array := zeros(int32Type(), shape1(3));
        setInt32(&!a, 0, 2147483647);
        setInt32(&!a, 1, -2147483647);
        setInt32(&!a, 2, -1);
        checkInt32(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkBytes(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(getNat8(v, 0) = 255, "255");
        assertTrue(getNat8(v, 1) = 0, "0");
        assertTrue(getNat8(v, 2) = 7, "7");
        return nil;
    end;

    function testNat8(): Unit is
        var a: Array := zeros(nat8Type(), shape1(3));
        setNat8(&!a, 0, 255);
        setNat8(&!a, 2, 7);
        checkBytes(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkBools(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(getBool(v, 0), "true");
        assertFalse(getBool(v, 1), "false");
        assertTrue(getBool(v, 2), "true again");
        return nil;
    end;

    function testBool(): Unit is
        var a: Array := zeros(boolType(), shape1(3));
        setBool(&!a, 0, true);
        setBool(&!a, 2, true);
        checkBools(&a);
        destroy(a);
        return nil;
    end;

    ---
    --- Views: strides, slicing without a copy, broadcasting
    ---

    -- A 3 by 4 matrix of Int64 with the value 10 * row + column.
    function matrix(): Array is
        var a: Array := zeros(int64Type(), shape2(3, 4));
        var k: Index := 0;
        while k < 12 do
            let row: Index := k / 4;
            let column: Index := rem(k, 4);
            setInt64(&!a, k, indexToInt64((10 * row) + column));
            k := k + 1;
        end while;
        return a;
    end;

    function indexToInt64(x: Index): Int64 is
        case toInt64(x) of
            when Some(value as n: Int64) do
                return n;
            when None do
                abort("an Index did not fit an Int64");
        end case;
    end;

    generic [R: Region]
    function checkStrides(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(viewRank(v) = 2, "rank 2");
        assertTrue((viewExtent(v, 0) = 3) and (viewExtent(v, 1) = 4), "extents 3 and 4");
        assertTrue((viewStride(v, 0) = 4) and (viewStride(v, 1) = 1), "strides 4 and 1: row-major");
        assertTrue(viewOffset(v) = 0, "no offset");
        assertTrue(isContiguous(v), "a whole array is contiguous");
        assertTrue(getInt64(v, ordinal(v, 2, 3, 0, 0)) = 23, "row 2, column 3");
        assertTrue(ordinal(v, 2, 3, 0, 0) = 11, "the last ordinal");
        return nil;
    end;

    function testStrides(): Unit is
        let a: Array := matrix();
        checkStrides(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkSlices(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        -- Rows 1 and 2, all columns.
        let rows: View[R] := sliceAxis(v, 0, 1, 3, 1);
        assertTrue((viewExtent(rows, 0) = 2) and (viewExtent(rows, 1) = 4), "2 rows of 4");
        assertTrue(viewOffset(rows) = 4, "it starts at the second row, the same bytes");
        assertTrue(viewStride(rows, 0) = 4, "the strides are kept");
        assertTrue(isContiguous(rows), "whole rows are contiguous");
        assertTrue(getInt64(rows, 0) = 10, "first element of the slice");
        assertTrue(getInt64(rows, 7) = 23, "last element of the slice");
        -- Every second column from column 1: columns 1 and 3.
        let columns: View[R] := sliceAxis(v, 1, 1, 4, 2);
        assertTrue(viewExtent(columns, 1) = 2, "two columns");
        assertTrue(viewStride(columns, 1) = 2, "the step doubles the stride");
        assertFalse(isContiguous(columns), "every second column leaves gaps");
        assertTrue(getInt64(columns, 0) = 1, "row 0, column 1");
        assertTrue(getInt64(columns, 1) = 3, "row 0, column 3");
        assertTrue(getInt64(columns, 5) = 23, "row 2, column 3");
        -- A slice of a slice.
        let inner: View[R] := sliceAxis(rows, 1, 2, 4, 1);
        assertTrue(viewSize(inner) = 4, "2 by 2");
        assertTrue(viewOffset(inner) = 6, "offsets add up");
        assertTrue(getInt64(inner, 0) = 12, "row 1, column 2");
        assertTrue(getInt64(inner, 3) = 23, "row 2, column 3");
        -- One element of the slice.
        let one: View[R] := sliceAxis(sliceAxis(v, 0, 2, 3, 1), 1, 0, 1, 1);
        assertTrue(viewSize(one) = 1, "one element");
        assertTrue(getInt64(one, 0) = 20, "row 2, column 0");
        return nil;
    end;

    function testSlices(): Unit is
        let a: Array := matrix();
        checkSlices(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkPickAndSwap(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        let row: View[R] := pick(v, 0, 1);
        assertTrue((viewRank(row) = 1) and (viewExtent(row, 0) = 4), "a row is a vector of 4");
        assertTrue(viewOffset(row) = 4, "row 1 starts at 4");
        assertTrue(getInt64(row, 2) = 12, "row 1, column 2");
        let column: View[R] := pick(v, 1, 3);
        assertTrue((viewRank(column) = 1) and (viewExtent(column, 0) = 3), "a column is a vector of 3");
        assertTrue(viewStride(column, 0) = 4, "its step is a row");
        assertTrue(getInt64(column, 2) = 23, "row 2, column 3");
        let t: View[R] := swapAxes(v, 0, 1);
        assertTrue((viewExtent(t, 0) = 4) and (viewExtent(t, 1) = 3), "the transpose is 4 by 3");
        assertTrue((viewStride(t, 0) = 1) and (viewStride(t, 1) = 4), "the strides are exchanged");
        assertFalse(isContiguous(t), "the transpose is not contiguous");
        assertTrue(getInt64(t, ordinal(t, 3, 2, 0, 0)) = 23, "t[3,2] is a[2,3]");
        assertTrue(getInt64(t, 1) = 10, "t[0,1] is a[1,0]");
        let back: View[R] := swapAxes(t, 1, 0);
        assertTrue(isContiguous(back), "swapping twice restores the order");
        return nil;
    end;

    function testPickAndSwap(): Unit is
        let a: Array := matrix();
        checkPickAndSwap(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkBroadcast(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        -- A row of 4 stretched over 3 rows: the step along the rows is 0.
        let row: View[R] := pick(v, 0, 2);
        let wide: View[R] := broadcast(row, shape2(3, 4));
        assertTrue((viewExtent(wide, 0) = 3) and (viewExtent(wide, 1) = 4), "3 by 4");
        assertTrue((viewStride(wide, 0) = 0) and (viewStride(wide, 1) = 1), "rows repeat with step 0");
        assertTrue(viewSize(wide) = 12, "12 elements without a copy");
        assertTrue(getInt64(wide, 0) = 20, "row 0 is row 2");
        assertTrue(getInt64(wide, 11) = 23, "so is the last row");
        -- A column of 3 stretched over 5 columns.
        let column: View[R] := sliceAxis(sliceAxis(v, 1, 1, 2, 1), 0, 0, 3, 1);
        assertTrue((viewExtent(column, 0) = 3) and (viewExtent(column, 1) = 1), "a column of 3 by 1");
        let broad: View[R] := broadcast(column, shape2(3, 5));
        assertTrue((viewStride(broad, 1) = 0) and (viewStride(broad, 0) = 4), "columns repeat with step 0");
        assertTrue(getInt64(broad, 14) = 21, "row 2 of the column, last repeat");
        assertTrue(getInt64(broad, 5) = 11, "row 1 of the column, first repeat");
        -- A rank grows.
        let cube: View[R] := broadcast(row, shape3(2, 3, 4));
        assertTrue(viewRank(cube) = 3, "rank 3");
        assertTrue((viewStride(cube, 0) = 0) and (viewStride(cube, 1) = 0) and (viewStride(cube, 2) = 1), "both new axes repeat");
        assertTrue(getInt64(cube, 23) = 23, "the last element");
        assertFalse(isContiguous(cube), "a broadcast view repeats and is not contiguous");
        return nil;
    end;

    function testBroadcast(): Unit is
        let a: Array := matrix();
        checkBroadcast(&a);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function checkCopyValues(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(isContiguous(v), "a copy is packed");
        assertTrue(getInt64(v, 1) = 10, "packed[0,1] is a[1,0]");
        assertTrue(getInt64(v, 11) = 23, "the last element");
        return nil;
    end;

    function testCopy(): Unit is
        let a: Array := matrix();
        let packed: Array := copyTransposed(&a);
        assertTrue(elementType(&packed) = int64Type(), "the type is kept");
        assertTrue(sameShape(shape(&packed), shape2(4, 3)), "the shape of the transpose");
        checkCopyValues(&packed);
        destroy(packed);
        destroy(a);
        return nil;
    end;

    generic [R: Region]
    function copyTransposed(a: &[Array, R]): Array is
        return copy(swapAxes(view(a), 0, 1));
    end;

    generic [R: Region]
    function checkPacked(a: &[Array, R]): Unit is
        let bytes: Span[Nat8, R] := packedBytes(a);
        assertTrue(spanLength(bytes) = 8, "two Int32 take 8 bytes");
        assertTrue((bytes[0] = 1) and (bytes[1] = 0) and (bytes[2] = 0) and (bytes[3] = 0), "1 as little endian");
        assertTrue((bytes[4] = 255) and (bytes[5] = 255) and (bytes[6] = 255) and (bytes[7] = 255), "-1 as little endian");
        case fromPacked(int32Type(), shape1(2), bytes) of
            when Some(value as b: Array) do
                assertTrue(sameShape(shape(&b), shape1(2)), "the shape is the one asked for");
                checkInt32Pair(&b);
                destroy(b);
            when None do
                assertTrue(false, "the bytes of an Int32 pair were taken");
        end case;
        assertTrue(isNone(fromPacked(int32Type(), shape1(3), bytes)), "the length does not fit the shape");
        assertTrue(isNone(fromPacked(3, shape1(2), bytes)), "an unknown element type is refused");
        assertTrue(isNone(fromPacked(boolType(), shape1(8), bytes)), "bytes that are no Bool are refused");
        return nil;
    end;

    generic [R: Region]
    function checkInt32Pair(a: &[Array, R]): Unit is
        let v: View[R] := view(a);
        assertTrue(getInt32(v, 0) = 1, "first Int32");
        assertTrue(getInt32(v, 1) = -1, "second Int32");
        return nil;
    end;

    function isNone(value: Option[Array]): Bool is
        case value of
            when Some(value as a: Array) do
                destroy(a);
                return false;
            when None do
                return true;
        end case;
    end;

    function testPacked(): Unit is
        var a: Array := zeros(int32Type(), shape1(2));
        setInt32(&!a, 0, 1);
        setInt32(&!a, 1, -1);
        checkPacked(&a);
        destroy(a);
        return nil;
    end;
end module body.
