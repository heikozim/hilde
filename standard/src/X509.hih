"""
Keys and X.509 certificates: made, written, read, signed and verified.

- A key is NIST P-256, P-384 or P-521 with ECDSA, Ed25519, RSA, or ML-DSA of FIPS 204.
- RSA keys have 2048, 3072 or 4096 bits and sign with PKCS 1 v1.5 over SHA-256.
- ML-DSA keys come from Standard.MlDsa on every system, written as PKCS 8 with the seed and the expanded key.
- A certificate or a request with an ML-DSA key is not made: those functions give None.
- A certificate made here has version 3 and a serial number of 127 random bits.
- Its basic constraints and key usage are marked critical, and it carries the key identifiers.
- A leaf made here has the extended key usages of a server and of a client.
- DNS names are one text separated by commas, and a text isDnsNameList refuses is refused.
- A private key is written as unencrypted PEM: whoever holds the text holds the key.

    let key: Option[PrivateKey] := generateKey(EcP256());
    let made: Option[Certificate] := selfSigned(&signer, "web", "example.org", 90, false);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.X509 is
    """
    The kinds of key.
    """
    union KeyKind: Free is
        case EcP256;
        case EcP384;
        case EcP521;
        case Ed25519Key;
        case Rsa2048;
        case Rsa3072;
        case Rsa4096;
        case MlDsa44;
        case MlDsa65;
        case MlDsa87;
    end;

    """
    A private key.  It is linear: destroyPrivateKey gives it back.
    """
    type PrivateKey: Linear;

    """
    A new key of kind from the random source of libcrypto.  None when
    libcrypto refused.
    No contract: the result is an Option.
    """
    function generateKey(kind: KeyKind): Option[PrivateKey];

    """
    The kind of the key.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function keyKindOf(key: &[PrivateKey, R]): KeyKind;

    """
    The key as unencrypted PKCS 8 PEM text.  Whoever holds it holds the
    key.  An ML-DSA key holds its seed and its expanded key, as OpenSSL
    writes it.
    No contract: the result is an Option.
    """
    generic [R: Region]
    function privateKeyToPem(key: &[PrivateKey, R]): Option[String];

    """
    The first private key of PEM text.  None when there is none, when it is
    encrypted, or when it is of a kind this module does not have.  An
    ML-DSA key is read with its seed alone or with its seed and expanded
    key, which must agree; with the expanded key alone it is None.
    No contract: the result is an Option.
    """
    generic [R: Region]
    function privateKeyFromPem(pem: Span[Nat8, R]): Option[PrivateKey];

    """
    The public half of the key as a DER SubjectPublicKeyInfo.
    No contract: the result is an Option.
    """
    generic [R: Region]
    function publicKeyDer(key: &[PrivateKey, R]): Option[String];

    """
    The signature of message under the key: for ECDSA the DER of the pair
    of numbers over the SHA-256 (P-256), SHA-384 (P-384) or SHA-512 (P-521)
    of message; for RSA PKCS 1 v1.5 over its SHA-256; for Ed25519 the
    signature of the message itself; for ML-DSA the hedged signature of the
    message with the empty context.
    No contract: the result is an Option.
    """
    generic [R: Region, M: Region]
    function signMessage(key: &[PrivateKey, R], message: Span[Nat8, M]): Option[String];

    """
    Whether signature, in the form signMessage makes, is one of message
    under the public key publicDer, a DER SubjectPublicKeyInfo.
    No contract: every input is allowed, a wrong one is an answer.
    """
    generic [P: Region, M: Region, S: Region]
    function verifyMessage(publicDer: Span[Nat8, P], message: Span[Nat8, M], signature: Span[Nat8, S]): Bool;

    """
    The kind of the public key publicDer, a DER SubjectPublicKeyInfo.  None
    when it is no public key or of a kind this module does not have.
    No contract: the result is an Option.
    """
    generic [P: Region]
    function publicKeyKind(publicDer: Span[Nat8, P]): Option[KeyKind];

    """
    Frees key.
    No contract: it only frees or closes what it is given.
    """
    function destroyPrivateKey(key: PrivateKey): Unit;

    """
    A certificate.  It is linear: destroyCertificate gives it back.
    """
    type Certificate: Linear;

    """
    The first certificate of PEM text, or of DER bytes.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function certificateFromPem(pem: Span[Nat8, R]): Option[Certificate];
    """
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function certificateFromDer(der: Span[Nat8, R]): Option[Certificate];

    """
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function certificateToPem(certificate: &[Certificate, R]): Option[String];
    """
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function certificateToDer(certificate: &[Certificate, R]): Option[String];

    """
    The common name of the subject, and of the issuer, as UTF-8.  None when
    the name has none.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function subjectName(certificate: &[Certificate, R]): Option[String];
    """
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function issuerName(certificate: &[Certificate, R]): Option[String];

    """
    The DNS names of the subject alternative name, separated by commas;
    empty when there are none.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function dnsNamesOf(certificate: &[Certificate, R]): String;

    """
    The start and the end of validity, in seconds since 1970.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function validFrom(certificate: &[Certificate, R]): Option[Int64];
    """
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function validUntil(certificate: &[Certificate, R]): Option[Int64];

    """
    The serial number in hexadecimal digits.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function serialNumber(certificate: &[Certificate, R]): Option[String];

    """
    The SHA-256 of the DER form, 32 bytes.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function fingerprintSha256(certificate: &[Certificate, R]): Option[String];

    """
    Whether the certificate is for the public half of key; false for an
    ML-DSA key.
    No contract: the answer is the whole result.
    """
    generic [R: Region, K: Region]
    function belongsTo(certificate: &[Certificate, R], key: &[PrivateKey, K]): Bool;

    """
    Whether the certificate may sign others: a CA.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isAuthority(certificate: &[Certificate, R]): Bool;

    """
    Frees certificate.
    No contract: it only frees or closes what it is given.
    """
    function destroyCertificate(certificate: Certificate): Unit;

    """
    Whether names is a list of DNS names as this module takes them: one or
    more, separated by commas.  A name holds letters, digits and hyphens in
    labels of at most 63 bytes between dots, the first label may be a star
    alone, and the whole is at most 253 bytes.  Every function that makes a
    certificate or a request refuses other names before libcrypto sees them.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isDnsNameList(names: Span[Nat8, R]): Bool;

    """
    A certificate for key, signed by key itself, with commonName and the
    DNS names, valid from now for days, 1 to 36500, and a CA when authority
    is true.  names may be empty.  None for a common name that is empty,
    longer than 64 bytes or holds a control byte, for names that are not a
    list, for an ML-DSA key, and when libcrypto refused.
    No contract: the result is an Option.
    """
    generic [K: Region, C: Region, N: Region]
    function selfSigned(key: &[PrivateKey, K], commonName: Span[Nat8, C], names: Span[Nat8, N], days: Nat32, authority: Bool): Option[Certificate];

    """
    A certificate for the public half of subjectKey, issued by authority
    and signed with authorityKey, otherwise as selfSigned.  None also when
    authority is no CA, authorityKey does not belong to it, or either key is
    an ML-DSA key.
    No contract: the result is an Option.
    """
    generic [A: Region, K: Region, S: Region, C: Region, N: Region]
    function issue(authority: &[Certificate, A], authorityKey: &[PrivateKey, K], subjectKey: &[PrivateKey, S],
        commonName: Span[Nat8, C], names: Span[Nat8, N], days: Nat32, isCa: Bool): Option[Certificate];

    """
    A certificate request for key in DER, with commonName, which may be
    empty, and the DNS names, signed by key.  None for an ML-DSA key.
    No contract: the result is an Option.
    """
    generic [K: Region, C: Region, N: Region]
    function certificateRequest(key: &[PrivateKey, K], commonName: Span[Nat8, C], names: Span[Nat8, N]): Option[String];

    """
    A leaf certificate for the key of the DER certificate request, issued
    by authority with authorityKey, with the common name and the DNS names
    the request asks for, valid for days.  None when the request does not
    parse, its signature does not hold, its key is an ML-DSA key, or a name
    it asks for would be refused by selfSigned.
    No contract: the result is an Option.
    """
    generic [A: Region, K: Region, R: Region]
    function issueFromRequest(authority: &[Certificate, A], authorityKey: &[PrivateKey, K], request: Span[Nat8, R], days: Nat32): Option[Certificate];

    """
    Verifies the first certificate of the PEM text chain, with the others
    of chain as intermediates, against the certificates of the PEM text
    trusted, at the time at in seconds since 1970, and for the DNS name
    host unless host is empty.  None when it verifies; otherwise the words
    of libcrypto on why not.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [C: Region, T: Region, H: Region]
    function verifyChain(chain: Span[Nat8, C], trusted: Span[Nat8, T], host: Span[Nat8, H], at: Int64): Option[String];
end module.
