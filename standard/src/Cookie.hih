"""
HTTP cookies after RFC 6265: one cookie read out of a Cookie header, a Set-Cookie value written.

- A cookie written here has no Domain attribute, so only the host that set it gets it back.
- strictOptions gives Secure, HttpOnly, SameSite=Strict and no expiry.
- A name, value or path that could end the header or start an attribute is refused, not escaped.
- A value outside printable ASCII has to be encoded by the caller first, as hexadecimal or base64.
- Every refusal comes back as None.

    let header: Option[String] := setCookie("session", token, "/", strictOptions());
    let sent: Option[String] := cookieValue(asSpan(&cookieHeader), "session");
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Cookie is
    """
    The SameSite attribute: whether the browser sends the cookie with a
    request that another site started.  SameSiteNone needs Secure.
    """
    union SameSite: Free is
        case SameSiteStrict;
        case SameSiteLax;
        case SameSiteNone;
    end;

    """
    The attributes of a cookie besides its name, value and path.
    """
    record CookieOptions: Free is
        """
        Max-Age in seconds; None for a cookie that ends with the browser
        session.
        """
        maxAgeSeconds: Option[Nat32];
        secure: Bool;
        httpOnly: Bool;
        sameSite: SameSite;
    end;

    """
    Secure, HttpOnly, SameSite=Strict and no Max-Age.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function strictOptions(): CookieOptions;

    """
    Whether name is a cookie name: one byte or more, each a token
    character of RFC 9110, that is a letter, a digit or one of the fifteen
    symbols that section 5.6.2 lists.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isCookieName(name: Span[Nat8, R]): Bool;

    """
    Whether value is a cookie value: printable ASCII without a space, a
    double quote, a comma, a semicolon or a backslash, possibly empty.  A
    value with any other byte has to be encoded first, as hexadecimal or
    base64.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isCookieValue(value: Span[Nat8, R]): Bool;

    """
    The value of the first cookie called name in header, the value of a
    Cookie header: pairs name=value separated by semicolons and spaces.
    A value in double quotes comes without them.  None when there is no
    such cookie, when name is no cookie name, and when the pair's value
    is no cookie value.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function cookieValue(header: Span[Nat8, R], name: Span[Nat8, S]): Option[String];

    """
    The value of a Set-Cookie header for name, value and path, with the
    attributes of options.  None when name is no cookie name, value no
    cookie value, path empty, not starting with a slash or holding a
    semicolon or a byte outside printable ASCII, and for SameSite=None
    without Secure.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [N: Region, V: Region, P: Region]
    function setCookie(name: Span[Nat8, N], value: Span[Nat8, V], path: Span[Nat8, P], options: CookieOptions): Option[String];

    """
    The value of a Set-Cookie header that removes the cookie name at path:
    an empty value and Max-Age=0, with the Secure, HttpOnly and SameSite of
    options, which must be those it was set with.  None as for setCookie.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [N: Region, P: Region]
    function deleteCookie(name: Span[Nat8, N], path: Span[Nat8, P], options: CookieOptions): Option[String];
end module.
