-- Tests for Standard.Password: a hash it makes checks, in the PHC string
-- form; every way a stored string can be wrong is Unreadable or
-- DoesNotMatch and never an abort; a hash with other values is checked
-- with its own.  The fixed hashes below were made by another
-- implementation and are checked here as they stand.  An old bcrypt hash
-- that matches asks for a new one.
import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    fromSpan,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Text (
    constantTimeEqual,
    substring
);
import Standard.Base64 (
    decode
);
import Standard.Password (
    PasswordCheck,
    hashPassword,
    checkPassword,
    hashPepperedPassword,
    checkPepperedPassword
);

module body Standard.Password.Test is
    function isMatch(check: PasswordCheck): Bool is
        case check of
            when Matches do
                return true;
            when MatchesStoreAgain do
                return false;
            when DoesNotMatch do
                return false;
            when Unreadable do
                return false;
            when Failed do
                return false;
        end case;
    end;

    function isMismatch(check: PasswordCheck): Bool is
        case check of
            when Matches do
                return false;
            when MatchesStoreAgain do
                return false;
            when DoesNotMatch do
                return true;
            when Unreadable do
                return false;
            when Failed do
                return false;
        end case;
    end;

    function isUnreadable(check: PasswordCheck): Bool is
        case check of
            when Matches do
                return false;
            when MatchesStoreAgain do
                return false;
            when DoesNotMatch do
                return false;
            when Unreadable do
                return true;
            when Failed do
                return false;
        end case;
    end;

    function isStoreAgain(check: PasswordCheck): Bool is
        case check of
            when Matches do
                return false;
            when MatchesStoreAgain do
                return true;
            when DoesNotMatch do
                return false;
            when Unreadable do
                return false;
            when Failed do
                return false;
        end case;
    end;

    -- A hash made here checks with its password and not with another, and
    -- it has the form and the values of a new hash: 16 bytes of salt and 32
    -- of tag in Base64 without padding make 22 and 43 characters.
    function testHashThenCheck(): Unit is
        case hashPassword("correct horse battery staple") of
            when Some(value as stored: String) do
                assertTrue(isMatch(checkPassword("correct horse battery staple", asSpan(&stored))), "the password checks against its own hash");
                assertTrue(isMismatch(checkPassword("correct horse battery stapler", asSpan(&stored))), "a wrong password does not match");
                assertTrue(isMismatch(checkPassword("", asSpan(&stored))), "the empty password does not match");
                let head: String := fromSpan(substring(asSpan(&stored), 0, 31));
                assertTrue(constantTimeEqual(asSpan(&head), "$argon2id$v=19$m=65536,t=3,p=4$"), "the values of a new hash");
                destroyString(head);
                assertTrue(length(&stored) = 97, "31 + 22 + 1 + 43 characters");
                assertTrue(nthByte(&stored, 53) = 36, "a dollar sign between salt and tag");
                destroyString(stored);
            when None do
                assertTrue(false, "a hash is made");
        end case;
        return nil;
    end;

    -- Two hashes of one password differ: each has a salt of its own.
    function testSaltsDiffer(): Unit is
        case hashPassword("same") of
            when Some(value as first: String) do
                case hashPassword("same") of
                    when Some(value as second: String) do
                        assertTrue(not constantTimeEqual(asSpan(&first), asSpan(&second)), "two hashes of one password differ");
                        destroyString(second);
                    when None do
                        assertTrue(false, "the second hash is made");
                end case;
                destroyString(first);
            when None do
                assertTrue(false, "the first hash is made");
        end case;
        return nil;
    end;

    -- A hash another implementation made, with the password
    -- "hilde-cross-check": checked as it stands, and with a password
    -- changed in one place.
    function testForeignHash(): Unit is
        let stored: Span[Nat8, Static] := "$argon2id$v=19$m=65536,t=3,p=4$WFdChB+rfrsq/IdBtloWFQ$Dyh1ObjtdpMVu8ssmCtUd7Hy1VJ5Bt+sOzq0Zecu4BY";
        assertTrue(isMatch(checkPassword("hilde-cross-check", stored)), "the foreign hash checks");
        assertTrue(isMismatch(checkPassword("hilde-cross-checK", stored)), "a wrong password against the foreign hash");
        return nil;
    end;

    -- A hash with other values than a new one is checked with those values:
    -- m=19456, t=2, p=1, made by another implementation of Argon2id and
    -- written in the PHC string form.
    function testOtherValues(): Unit is
        let stored: Span[Nat8, Static] := "$argon2id$v=19$m=19456,t=2,p=1$FIQUuS8TXcMJ4MXnkhr3Ug$c5ht2ynAu77nxYfYxeQy7DvJB1QkQJWmXU700F4xKxk";
        assertTrue(isMatch(checkPassword("other values", stored)), "a hash with m=19456,t=2,p=1 checks");
        assertTrue(isMismatch(checkPassword("other value", stored)), "and a wrong password does not");
        return nil;
    end;

    -- Every way a stored string can be wrong.  The base is a hash made
    -- here, so that each case differs from a good one in one place only.
    function testBrokenStrings(): Unit is
        case hashPassword("pw") of
            when Some(value as stored: String) do
                let good: Span[Nat8, Static] := "pw";
                -- The tag changed in its first character.
                let changedTag: String := withByteAt(asSpan(&stored), 54);
                assertTrue(isMismatch(checkPassword(good, asSpan(&changedTag))), "a changed tag does not match");
                destroyString(changedTag);
                -- The salt changed in its first character.
                let changedSalt: String := withByteAt(asSpan(&stored), 31);
                assertTrue(isMismatch(checkPassword(good, asSpan(&changedSalt))), "a changed salt does not match");
                destroyString(changedSalt);
                -- Cut short, inside the tag and before it.
                let cutTag: String := fromSpan(substring(asSpan(&stored), 0, 90));
                assertTrue(not isMatch(checkPassword(good, asSpan(&cutTag))), "a cut tag does not match");
                destroyString(cutTag);
                let cutSalt: String := fromSpan(substring(asSpan(&stored), 0, 40));
                assertTrue(isUnreadable(checkPassword(good, asSpan(&cutSalt))), "a string cut inside the salt is unreadable");
                destroyString(cutSalt);
                destroyString(stored);
            when None do
                assertTrue(false, "a hash is made");
        end case;
        assertTrue(isUnreadable(checkPassword("pw", "")), "the empty string is unreadable");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2i$v=19$m=65536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "argon2i is another variant");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2d$v=19$m=65536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "argon2d is another variant");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=16$m=65536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "version 16 is not read");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$m=65536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "no version is not read");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=065536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "a leading zero");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=2097152,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "two gibibytes are above the bound");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=0,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "no pass");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=17,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "17 passes are above the bound");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=3,p=17$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "17 lanes are above the bound");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=31,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "less memory than 8 kibibytes a lane");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=99999999999,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "more digits than any bound needs");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=3,p=4$c29tZXNhbHQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc$")), "a dollar sign after the tag");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=3,p=4$c29tZQ$CTFhFdXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "a salt of 4 bytes");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFhFdXPJO1aFaMa")), "a tag of 12 bytes");
        assertTrue(isUnreadable(checkPassword("pw", "$argon2id$v=19$m=65536,t=3,p=4$c29tZXNhbHRzb21lc2FsdA$CTFh!dXPJO1aFaMaO6Mm5c8y7cJHAph8ArZWb2GRPPc")), "a byte outside Base64 in the tag");
        return nil;
    end;

    -- An old bcrypt hash: the test vector of crypt_blowfish, the password U*U
    -- with cost 5, under each of the three markers read here.  A match is
    -- MatchesStoreAgain and never Matches.
    function testBcrypt(): Unit is
        let markedA: Span[Nat8, Static] := "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW";
        let markedB: Span[Nat8, Static] := "$2b$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW";
        let markedY: Span[Nat8, Static] := "$2y$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW";
        assertTrue(isStoreAgain(checkPassword("U*U", markedA)), "the vector marked 2a asks for a new hash");
        assertTrue(isStoreAgain(checkPassword("U*U", markedB)), "the vector marked 2b asks for a new hash");
        assertTrue(isStoreAgain(checkPassword("U*U", markedY)), "the vector marked 2y asks for a new hash");
        assertTrue(isMismatch(checkPassword("U*V", markedA)), "another password against 2a does not match");
        assertTrue(isMismatch(checkPassword("U*V", markedY)), "another password against 2y does not match");
        assertTrue(isMismatch(checkPassword("", markedB)), "the empty password does not match");
        return nil;
    end;

    -- Every way a bcrypt string is read as not a hash, each a small change of
    -- the vector.
    function testBrokenBcrypt(): Unit is
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$03$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")), "cost 3 is below the bound");
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$17$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")), "cost 17 is above the bound");
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOe")), "59 bytes");
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeWW")), "61 bytes");
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOe!")), "a byte outside the alphabet");
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$0x$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")), "a cost that is not two digits");
        assertTrue(isUnreadable(checkPassword("U*U", "$2a$05CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeWW")), "no dollar sign after the cost");
        assertTrue(isUnreadable(checkPassword("U*U", "$2x$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW")), "the marker 2x is not read");
        assertTrue(isUnreadable(checkPassword("U*U", "$2$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeWW")), "the marker 2 is not read");
        return nil;
    end;

    -- The pepper of the foreign peppered hash below, 32 bytes.
    function foreignPepper(): String is
        case decode("ESjAlNmqwVv+Sd80GhZBeeuHmp1VC6F0Yj530h8eAOQ=") of
            when Some(value as pepper: String) do
                return pepper;
            when None do
                abort("the pepper is no Base64");
        end case;
    end;

    -- A peppered hash another implementation made, with the password
    -- "correct horse battery staple" and the pepper above: checked as it
    -- stands, with a password changed in one place, and with another pepper.
    function testForeignPepperedHash(): Unit is
        let stored: Span[Nat8, Static] := "$argon2id-hmac$v=19$m=65536,t=3,p=4$TJOpzpz05KxhmZpBJ60MnQ$Roy0fVJy2OMh6C4nyiXdJmJ4GFepb4sXTg8x5ILcI5Q";
        let pepper: String := foreignPepper();
        assertTrue(isMatch(checkPepperedPassword("correct horse battery staple", stored, asSpan(&pepper))), "the foreign peppered hash checks");
        assertTrue(isMismatch(checkPepperedPassword("correct horse battery stapler", stored, asSpan(&pepper))), "a wrong password against it");
        let other: Span[Nat8, Static] := "0123456789abcdef0123456789abcdef";
        assertTrue(isMismatch(checkPepperedPassword("correct horse battery staple", stored, other)), "another pepper does not match");
        destroyString(pepper);
        return nil;
    end;

    -- A peppered hash made here checks with its password and pepper, has the
    -- fixed beginning, 22 characters of salt and 43 of code; a short pepper
    -- and a password out of bounds make none.
    function testPepperedHashThenCheck(): Unit is
        let pepper: Span[Nat8, Static] := "0123456789abcdef0123456789abcdef";
        case hashPepperedPassword("a long enough password", pepper) of
            when Some(value as stored: String) do
                assertTrue(length(&stored) = 102, "the beginning, 22 characters of salt, a dollar and 43 of code");
                let head: Span[Nat8, Static] := "$argon2id-hmac$v=19$m=65536,t=3,p=4$";
                assertTrue(constantTimeEqual(substring(asSpan(&stored), 0, spanLength(head)), head), "the fixed beginning");
                assertTrue(isMatch(checkPepperedPassword("a long enough password", asSpan(&stored), pepper)), "it checks");
                assertTrue(isMismatch(checkPepperedPassword("a long enough passwore", asSpan(&stored), pepper)), "another password does not");
                assertTrue(isMismatch(checkPepperedPassword("", asSpan(&stored), pepper)), "an empty password never matches");
                assertTrue(isFailed(checkPepperedPassword("a long enough password", asSpan(&stored), "short")), "a short pepper fails");
                let broken: String := withByteAt(asSpan(&stored), 70);
                assertTrue(isMismatch(checkPepperedPassword("a long enough password", asSpan(&broken), pepper)), "a changed code does not match");
                destroyString(broken);
                destroyString(stored);
            when None do
                assertTrue(false, "a peppered hash is made");
        end case;
        case hashPepperedPassword("a long enough password", "short") of
            when Some(value as stored: String) do
                assertTrue(false, "a short pepper makes no hash");
                destroyString(stored);
            when None do
                skip;
        end case;
        case hashPepperedPassword("", pepper) of
            when Some(value as stored: String) do
                assertTrue(false, "an empty password makes no hash");
                destroyString(stored);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- Peppered strings of another form are Unreadable.
    function testBrokenPepperedStrings(): Unit is
        let pepper: Span[Nat8, Static] := "0123456789abcdef0123456789abcdef";
        assertTrue(isUnreadable(checkPepperedPassword("pw", "$argon2id-hmac$v=19$m=65536,t=2,p=4$TJOpzpz05KxhmZpBJ60MnQ$Roy0fVJy2OMh6C4nyiXdJmJ4GFepb4sXTg8x5ILcI5Q", pepper)), "other passes are not read");
        assertTrue(isUnreadable(checkPepperedPassword("pw", "$argon2id-hmac$v=19$m=65536,t=3,p=4$TJOpzpz05KxhmZpBJ60M$Roy0fVJy2OMh6C4nyiXdJmJ4GFepb4sXTg8x5ILcI5Q", pepper)), "a salt of 15 bytes");
        assertTrue(isUnreadable(checkPepperedPassword("pw", "$argon2id-hmac$v=19$m=65536,t=3,p=4$TJOpzpz05KxhmZpBJ60MnQ$Roy0fVJy2OMh6C4nyiXdJmJ4GFepb4sXTg8x5ILc", pepper)), "a code of 30 bytes");
        assertTrue(isUnreadable(checkPepperedPassword("pw", "$argon2id-hmac$v=19$m=65536,t=3,p=4$TJOpzpz05KxhmZpBJ60MnQ", pepper)), "no code");
        assertTrue(isUnreadable(checkPepperedPassword("pw", "$argon2id-hmac$v=19$m=65536,t=3,p=4$TJOpzpz05KxhmZpBJ60MnQ$Roy0$x", pepper)), "a third part");
        assertTrue(isUnreadable(checkPepperedPassword("pw", "$argon2id$v=19$m=65536,t=3,p=4$TJOpzpz05KxhmZpBJ60MnQ$Roy0fVJy2OMh6C4nyiXdJmJ4GFepb4sXTg8x5ILcI5Q", pepper)), "a hash without pepper is not read here");
        return nil;
    end;

    function isFailed(check: PasswordCheck): Bool is
        case check of
            when Matches do
                return false;
            when MatchesStoreAgain do
                return false;
            when DoesNotMatch do
                return false;
            when Unreadable do
                return false;
            when Failed do
                return true;
        end case;
    end;

    -- The string with the byte at at changed to another character of the
    -- Base64 alphabet: A becomes B, anything else A.
    generic [R: Region]
    function withByteAt(text: Span[Nat8, R], at: Index): String is
        var builder: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(text);
        var i: Index := 0;
        while i < size do
            if i = at then
                if text[i] = 65 then
                    writeByte(&!builder, 66);
                else
                    writeByte(&!builder, 65);
                end if;
            else
                writeByte(&!builder, text[i]);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;
end module body.
