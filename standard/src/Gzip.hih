"""
Compression in the formats of gzip: DEFLATE of RFC 1951, raw or in a gzip member of RFC 1952.

- Written in Hilde; it binds no library.
- It decompresses every valid stream: stored blocks and blocks with fixed and dynamic codes.
- It compresses with fixed codes or stored blocks, finding repeats at most 32 KiB back.
- A stream of zlib at its default level is smaller than what it writes.
- Decompressing stops at a limit the caller names, since a few bytes can describe gigabytes.
- Every length, distance and code is checked before use; a stream that breaks a rule is refused.

    let packed: String := gzip(asSpan(&page));
    case gunzip(asSpan(&packed), 1048576) of
        when Right(right as unpacked: String) do
            skip;
        when Left(left as failure: GzipFailure) do
            skip;
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Gzip is
    """
    Why decompressing failed.
    """
    union GzipFailure: Free is
        -- The bytes do not begin with a gzip header, or its method is not
        -- DEFLATE, or a reserved flag is set.
        case NotGzip;
        -- The input ends in the middle of the stream.
        case Truncated;
        -- A block breaks a rule of RFC 1951: its type, a code, a length
        -- or a distance.
        case BadData;
        -- What comes out would be larger than the limit.
        case TooLarge;
        -- The CRC-32 or the size in the trailer does not match, or the
        -- header's own checksum does not.
        case BadChecksum;
        -- Bytes follow the last member that are not a member.
        case TrailingData;
    end;

    """
    The CRC-32 of data as gzip and zip compute it, polynomial 0xEDB88320.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function crc32(data: Span[Nat8, R]): Nat32;

    """
    data compressed as a raw DEFLATE stream of RFC 1951.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function deflateRaw(data: Span[Nat8, R]): String;

    """
    A raw DEFLATE stream decompressed, at most limit bytes of it.  The
    stream must end with the input.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function inflateRaw(data: Span[Nat8, R], limit: Index): Either[GzipFailure, String];

    """
    data compressed as one gzip member, with no name and the time 0, so
    that the same data gives the same bytes.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function gzip(data: Span[Nat8, R]): String;

    """
    Every gzip member of data decompressed and joined, at most limit
    bytes in all, each member's CRC-32 and size checked.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function gunzip(data: Span[Nat8, R], limit: Index): Either[GzipFailure, String];
end module.
