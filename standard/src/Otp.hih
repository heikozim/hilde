"""
One-time passwords, HOTP after RFC 4226 and TOTP after RFC 6238, as authenticator apps make them.

- A code is the HMAC of a counter under the shared secret, cut to 6 to 8 decimal digits.
- For TOTP the counter is the number of steps since 1970, of 30 seconds as a rule.
- SHA-1 is what the apps use; SHA-256 and SHA-512 are what the RFC adds.
- verifyTotp takes codes of window steps before and after too, and compares in constant time.
- A code once taken is the caller's to remember, so that it is not taken twice.

    let accepted: Bool :=
        verifyTotp(asSpan(&secret), asSpan(&code), nowSeconds, 30, 6, OtpSha1(), 1);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.Otp is
    """
    The hash of the HMAC.
    """
    union OtpHash: Free is
        case OtpSha1;
        case OtpSha256;
        case OtpSha512;
    end;

    """
    The code of counter: digits decimal digits, 6 to 8, with leading
    zeros.  None for another number of digits, an empty secret, or when
    libcrypto fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [S: Region]
    function hotp(secret: Span[Nat8, S], counter: Nat64, digits: Nat8, hash: OtpHash): Option[String];

    """
    The code at seconds since 1970, with steps of step seconds, at least 1.
    None also for a time below 0.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [S: Region]
    function totp(secret: Span[Nat8, S], seconds: Int64, step: Nat32, digits: Nat8, hash: OtpHash): Option[String];

    """
    Whether code is the TOTP code at seconds or at one of window steps
    before or after it.  False for a code that is not digits decimal
    digits.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [S: Region, C: Region]
    function verifyTotp(secret: Span[Nat8, S], code: Span[Nat8, C], seconds: Int64, step: Nat32, digits: Nat8,
        hash: OtpHash, window: Nat8): Bool;

    """
    A new secret of 20 random bytes, as RFC 4226 asks at least, in base32
    without padding.  None when the random source fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    function newSecret(): Option[String];

    """
    The otpauth URI an authenticator app reads from a QR code: the issuer
    and the account in its label, the secret in base32, the hash, the
    digits and the step.  issuer and account are percent-encoded.
    No contract: a text whose length follows its input.
    """
    generic [I: Region, A: Region, S: Region]
    function otpauthUri(issuer: Span[Nat8, I], account: Span[Nat8, A], secretBase32: Span[Nat8, S],
        hash: OtpHash, digits: Nat8, step: Nat32): String;
end module.
