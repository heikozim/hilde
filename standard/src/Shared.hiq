-- A safe module: the mutexes and atomic words are those of Bindings.Shared,
-- wrapped here one record each.  atomicAdd is a loop of compare and swap,
-- so that the sum is computed by Hilde's own checked addition.
import Bindings.Shared (
    Mutex as BindMutex,
    Key as BindKey,
    Held as BindHeld,
    Atomic as BindAtomic,
    makeMutex as bindMakeMutex,
    acquire as bindAcquire,
    tryAcquire as bindTryAcquire,
    release as bindRelease,
    mutexHeld as bindMutexHeld,
    destroyMutex as bindDestroyMutex,
    makeAtomic as bindMakeAtomic,
    atomicLoad as bindAtomicLoad,
    atomicStore as bindAtomicStore,
    atomicExchange as bindAtomicExchange,
    atomicCompareSwap as bindAtomicCompareSwap,
    destroyAtomic as bindDestroyAtomic
);

module body Standard.Shared is
    record Mutex[T: Type]: Linear is
        inner: BindMutex[T];
    end;

    record Key: Linear is
        inner: BindKey;
    end;

    generic [T: Type]
    function makeMutex(value: T): Either[T, Mutex[T]] is
        case bindMakeMutex(value) of
            when Left(left as back: T) do
                let failed: Either[T, Mutex[T]] := Left(left => back);
                return failed;
            when Right(right as made: BindMutex[T]) do
                let mutex: Either[T, Mutex[T]] := Right(right => Mutex(inner => made));
                return mutex;
        end case;
    end;

    -- The value and the key of the binding, as this module's Held.
    generic [T: Type]
    function wrapHeld(held: BindHeld[T]): Held[T] is
        let { value as taken: T, key as inner: BindKey } := held;
        let wrapped: Held[T] := Held(value => taken, key => Key(inner => inner));
        return wrapped;
    end;

    generic [T: Type, R: Region]
    function acquire(mutex: &[Mutex[T], R]): Held[T] is
        return wrapHeld(bindAcquire(&(mutex->inner)));
    end;

    generic [T: Type, R: Region]
    function tryAcquire(mutex: &[Mutex[T], R]): Option[Held[T]] is
        case bindTryAcquire(&(mutex->inner)) of
            when Some(value as held: BindHeld[T]) do
                let some: Option[Held[T]] := Some(value => wrapHeld(held));
                return some;
            when None do
                let none: Option[Held[T]] := None();
                return none;
        end case;
    end;

    generic [T: Type, R: Region]
    function release(mutex: &[Mutex[T], R], value: T, key: Key): Unit is
        let { inner: BindKey } := key;
        bindRelease(&(mutex->inner), value, inner);
        return nil;
    end;

    generic [T: Type, R: Region]
    function mutexHeld(mutex: &[Mutex[T], R]): Bool is
        return bindMutexHeld(&(mutex->inner));
    end;

    generic [T: Type]
    function destroyMutex(mutex: Mutex[T]): T is
        let { inner: BindMutex[T] } := mutex;
        return bindDestroyMutex(inner);
    end;

    record Atomic: Linear is
        inner: BindAtomic;
    end;

    function makeAtomic(initial: Int64): Option[Atomic] is
        case bindMakeAtomic(initial) of
            when Some(value as word: BindAtomic) do
                let some: Option[Atomic] := Some(value => Atomic(inner => word));
                return some;
            when None do
                let none: Option[Atomic] := None();
                return none;
        end case;
    end;

    generic [R: Region]
    function atomicLoad(atomic: &[Atomic, R]): Int64 is
        return bindAtomicLoad(&(atomic->inner));
    end;

    generic [R: Region]
    function atomicStore(atomic: &[Atomic, R], value: Int64): Unit is
        bindAtomicStore(&(atomic->inner), value);
        return nil;
    end;

    generic [R: Region]
    function atomicAdd(atomic: &[Atomic, R], delta: Int64): Int64 is
        var seen: Int64 := bindAtomicLoad(&(atomic->inner));
        var sum: Int64 := seen + delta;
        while not bindAtomicCompareSwap(&(atomic->inner), seen, sum) do
            seen := bindAtomicLoad(&(atomic->inner));
            sum := seen + delta;
        end while;
        return sum;
    end;

    generic [R: Region]
    function atomicExchange(atomic: &[Atomic, R], value: Int64): Int64 is
        return bindAtomicExchange(&(atomic->inner), value);
    end;

    generic [R: Region]
    function atomicCompareSwap(atomic: &[Atomic, R], expected: Int64, desired: Int64): Bool is
        return bindAtomicCompareSwap(&(atomic->inner), expected, desired);
    end;

    function destroyAtomic(atomic: Atomic): Int64 is
        let { inner: BindAtomic } := atomic;
        return bindDestroyAtomic(inner);
    end;
end module body.
