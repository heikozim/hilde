--
-- A box is an array of the compiler, Hilde.Array, with exactly one element;
-- it holds no pointer.  It is made with room for one, so it costs one
-- allocation of one element.

import Hilde.Array (
    Array,
    allocateArray,
    arrayNth,
    arrayNthRef,
    arrayStore,
    arraySwap,
    arrayInsert,
    arrayRemove,
    destroyEmptyArray
);

module body Standard.Box is
    record Box[T: Type]: Linear is
        cell: Array[T];
    end;

    generic [T: Type]
    function makeBox(val: T): Either[T, Box[T]] is
        let opt: Option[Array[T]] := allocateArray(1);
        case opt of
            when Some(value as cell: Array[T]) do
                var filled: Array[T] := cell;
                arrayInsert(&!filled, 0, val);
                let box: Box[T] := Box(cell => filled);
                let right: Either[T, Box[T]] := Right(right => box);
                return right;
            when None do
                let left: Either[T, Box[T]] := Left(left => val);
                return left;
        end case;
    end;

    generic [T: Type]
    function unbox(box: Box[T]): T is
        let { cell: Array[T] } := box;
        var emptied: Array[T] := cell;
        let value: T := arrayRemove(&!emptied, 0);
        destroyEmptyArray(emptied);
        return value;
    end;

    generic [T: Free, R: Region]
    function readFree(boxref: &[Box[T], R]): T is
        return arrayNth(&(boxref->cell), 0);
    end;

    generic [T: Free, R: Region]
    function storeFree(boxref: &![Box[T], R], value: T): Unit is
        arrayStore(&!(boxref->cell), 0, value);
        return nil;
    end;

    generic [T: Type, R: Region]
    function boxSwap(boxref: &![Box[T], R], new: T): T is
        return arraySwap(&!(boxref->cell), 0, new);
    end;

    generic [T: Type, R: Region]
    function unboxReadRef(ref: &[Box[T], R]): &[T, R] is
        return arrayNthRef(&(ref->cell), 0);
    end;
end module body.
