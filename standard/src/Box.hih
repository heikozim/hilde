"""
One value on the heap, owned by a linear handle.

- A box is how a recursive type refers to itself, and a pattern in a case looks through it.
- A box is linear: unbox gives it back and returns the contents.
- A failed allocation hands the value back as the Left, so nothing leaks.

    case makeBox(7) of
        when Right(right as box: Box[Nat64]) do
            let seven: Nat64 := unbox(box);
        when Left(left as value: Nat64) do
            skip;
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Box is
    """
    A box: one value on the heap.  Linear: it must be unboxed.
    """
    type Box[T: Type]: Linear;

    """
    Allocate a box and put val inside.

    On success the box is the Right.  If the allocation fails, the Left is
    the value handed back, so that nothing leaks.  Left carries the failure
    and Right the success, as the question mark operator expects, so
    makeBox(v)? passes a failure on.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [T: Type]
    function makeBox(val: T): Either[T, Box[T]];

    """
    Give the box back and return its contents.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [T: Type]
    function unbox(box: Box[T]): T;

    """
    A copy of the contents of a box that holds a free value.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [T: Free, R: Region]
    function readFree(boxref: &[Box[T], R]): T;

    """
    Store a new free value in the box, through a write reference to it; the
    old value is dropped.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [T: Free, R: Region]
    function storeFree(boxref: &![Box[T], R], value: T): Unit;

    """
    Store a new value in the box and return the old one.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [T: Type, R: Region]
    function boxSwap(boxref: &![Box[T], R], new: T): T;

    """
    A reference to the contents, from a reference to the box.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [T: Type, R: Region]
    function unboxReadRef(ref: &[Box[T], R]): &[T, R];
end module.
