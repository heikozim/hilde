-- Hands a buffer of its own to the runtime's hilde_resolve, which fills it
-- with the addresses of the answer, and copies what was written into a
-- String.  Nothing of the resolver's memory is handed out: the runtime
-- frees the answer before it returns.
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer
);
import Standard.String (
    String,
    makeString,
    storeNth
);

module body Bindings.Resolve is
    constant maximumAddresses: Index := 64;
    constant recordSize: Index := 17;

    -- The size bytes at address, as a String.
    function copied(address: Address[Nat8], size: Index): String is
        var out: String := makeString(size, 0);
        var i: Index := 0;
        while i < size do
            storeNth(&!out, i, @embed(Nat8, "($1)[$2]", address, i));
            i := i + 1;
        end while;
        return out;
    end;

    function indexOf(value: Int32): Index is
        case toIndex(value) of
            when Some(value as v: Index) do
                return v;
            when None do
                return 0;
        end case;
    end;

    generic [R: Region]
    function resolveRecords(name: Span[Nat8, R]): Either[Int32, String] is
        let size: Index := maximumAddresses * recordSize;
        let out: Address[Nat8] := allocateBuffer(size);
        case nullCheck(out) of
            when Some(value as unused: Pointer[Nat8]) do
                skip;
            when None do
                let failed: Int32 := -3;
                let none: Either[Int32, String] := Left(left => failed);
                return none;
        end case;
        let count: Int32 := @embed(Int32, "hilde_resolve($1, $2, $3)", name, out, maximumAddresses);
        if count < 0 then
            @embed(Unit, "hilde_free($1)", out);
            let left: Either[Int32, String] := Left(left => count);
            return left;
        end if;
        let records: String := copied(out, indexOf(count) * recordSize);
        @embed(Unit, "hilde_free($1)", out);
        let right: Either[Int32, String] := Right(right => records);
        return right;
    end;
end module body.
