"""
Binds the system log, openlog(3), syslog(3) and closelog(3), through the runtime in lib/prelude.c.

- It reaches C with @embed, so it is an unsafe module; Standard.Log is the safe module built on it.
- The name is cut to 63 bytes; an unknown facility counts as user, an unknown priority as error.
- Text is sent as it is, never read as a format, and ends at a zero byte if it holds one.
- Opening again closes the connection made before.

    openSystemLog("shop", 1);
    writeSystemLog(1, "started");
    closeSystemLog();
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.SystemLog is
    """
    Connects the process to the system log under name, cut to 63 bytes, and
    the facility with index facility: 0 user, 1 daemon, 2 to 9 local0 to
    local7; another index is taken as user.  A connection made before is
    closed first.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openSystemLog(name: Span[Nat8, R], facility: Nat8): Unit;

    """
    Sends text to the system log with the priority with index priority: 0
    debug, 1 info, 2 warning, 3 error; another index is taken as error.
    The text is sent as it is, never read as a format, and ends at a zero
    byte if it holds one.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function writeSystemLog(priority: Nat8, text: Span[Nat8, R]): Unit;

    """
    Closes the connection to the system log.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeSystemLog(): Unit;
end module.
