-- A union of the two types reads the bits of one as the other; C allows
-- that read through a union, and it compiles to a move between registers.
pragma Unsafe_Module;

module body Bindings.Bits is
    function float64Bits(value: Float64): Nat64 is
        return @embed(Nat64, "((union { double d; uint64_t u; }) { .d = $1 }).u", value);
    end;

    function float64FromBits(bits: Nat64): Float64 is
        return @embed(Float64, "((union { double d; uint64_t u; }) { .u = $1 }).d", bits);
    end;

    function float32Bits(value: Float32): Nat32 is
        return @embed(Nat32, "((union { float f; uint32_t u; }) { .f = $1 }).u", value);
    end;

    function float32FromBits(bits: Nat32): Float32 is
        return @embed(Float32, "((union { float f; uint32_t u; }) { .u = $1 }).f", bits);
    end;

    function int64Bits(value: Int64): Nat64 is
        return @embed(Nat64, "((union { int64_t i; uint64_t u; }) { .i = $1 }).u", value);
    end;

    function int64FromBits(bits: Nat64): Int64 is
        return @embed(Int64, "((union { int64_t i; uint64_t u; }) { .u = $1 }).i", bits);
    end;

    function int32Bits(value: Int32): Nat32 is
        return @embed(Nat32, "((union { int32_t i; uint32_t u; }) { .i = $1 }).u", value);
    end;

    function int32FromBits(bits: Nat32): Int32 is
        return @embed(Int32, "((union { int32_t i; uint32_t u; }) { .u = $1 }).i", bits);
    end;
end module body.
