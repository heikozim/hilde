"""
Binds the fibers, scopes and channels of the runtime in lib/prelude.c, which run tasks on threads.

- A task's argument and result live in raw memory between spawn and join: an unsafe module.
- Standard.Task is the safe module built on it, and the one a programme imports.
- The compiler checks what a task is handed at the calls of Standard.Task, not here.
- Each declaration here is the one of Standard.Task with the same name.

    let started: Either[Nat64, Task[Nat64]] := spawn(&!scope, double, 21);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.File (
    FileDescriptor
);

module Bindings.Task is
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function tasksAvailable(): Bool;

    ---
    --- Scopes
    ---

    type Scope: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function openScope(): Option[Scope];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function openScopeSized(stackBytes: Index): Option[Scope];

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeScope(scope: Scope): Unit;

    ---
    --- Tasks
    ---

    type Task[T: Type]: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [A: Type, T: Type, R: Region]
    function spawn(scope: &![Scope, R], work: Fn[A, T], argument: A): Either[A, Task[T]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function join(task: Task[T]): T;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function taskDone(task: &[Task[T], R]): Bool;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function waitScopeBelow(scope: &![Scope, R], count: Index): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function yieldNow(): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function waitReadable(file: &[FileDescriptor, R]): Bool;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function waitWritable(file: &[FileDescriptor, R]): Bool;

    ---
    --- Lending scopes
    ---

    type Lending[R: Region]: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function openLending(anchor: &[T, R]): Option[Lending[R]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function openLendingSized(anchor: &[T, R], stackBytes: Index): Option[Lending[R]];

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function closeLending(scope: Lending[R]): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [A: Type, T: Type, R: Region, S: Region]
    function spawnLending(scope: &![Lending[R], S], work: Fn[A, T], argument: A): Either[A, Task[T]];

    ---
    --- Channels
    ---

    type Sender[T: Type]: Linear;

    type Receiver[T: Type]: Linear;

    record Channel[T: Type]: Linear is
        sender: Sender[T];
        receiver: Receiver[T];
    end;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function openChannel(capacity: Index): Option[Channel[T]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function send(sender: &![Sender[T], R], value: T): Option[T];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function receive(receiver: &![Receiver[T], R]): Option[T];

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function closeSender(sender: Sender[T]): Unit;

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function closeReceiver(receiver: Receiver[T]): Unit;

    union Polled[T: Type]: Type is
        case Took is
            value: T;
        case Nothing;
        case Finished;
    end;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function tryReceive(receiver: &![Receiver[T], R]): Polled[T];

    """
    As tryReceive, after waiting at most nanos nanoseconds for a value:
    Nothing when the time ran out first.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function receiveWithin(receiver: &![Receiver[T], R], nanos: Int64): Polled[T];

    """
    The running task waits nanos nanoseconds while the others run; 0 or
    less lets them run once.  Without tasks the programme waits.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function sleepNanos(nanos: Int64): Unit;

    union Selected[T: Type, U: Type]: Type is
        case First is
            value: T;
        case Second is
            value: U;
        case Neither;
    end;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, U: Type, R: Region, S: Region]
    function receiveEither(first: &![Receiver[T], R], second: &![Receiver[U], S]): Selected[T, U];
end module.
