"""
Binds the 8-bit library of PCRE2, libpcre2-8, through the declarations in Bindings.C.Pcre2.

- It hands addresses to C, so it is an unsafe module.
- Standard.Pcre is the safe module built on it, and the one a programme imports.
- It compiles a pattern and runs one search; every search a programme sees is built on that.
- Standard.PcreJit, the other safe module on it, also asks the JIT of PCRE2 for machine code.

    let compiled: Either[String, Code] := compileCode("[a-z]+", 1000000);
    let found: Either[Int32, Option[Buffer[Index]]] := search(&regex, asSpan(&text), 0);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Buffer (
    Buffer
);
import Standard.String (
    String
);

module Bindings.Pcre is
    """
    The value of a slot for a group that took no part in a match, and of an
    offset that is not there.
    """
    constant noSlot: Index;

    """
    A compiled pattern with its match limit.  It owns the compiled code.
    """
    type Code: Linear;

    """
    Compiles pattern with the given match limit, which must be at least 1.
    Left is the message of PCRE2 and the byte offset where it stopped.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function compileCode(pattern: Span[Nat8, R], matchLimit: Nat32): Either[String, Code];

    """
    Gives back a compiled pattern.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function destroyCode(compiled: Code): Unit;

    """
    How many capturing groups the pattern has, not counting the whole match.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function codeGroups(compiled: &[Code, R]): Index;

    """
    What the searches of one pattern need besides the pattern, made once for
    a run of searches.  It is linear, because it owns memory of PCRE2.
    """
    type Searcher: Linear;

    """
    Makes a searcher for regex.  It stops the program when there is no
    memory for it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openSearcher(regex: &[Code, R]): Searcher;

    """
    Gives back a searcher.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeSearcher(searcher: Searcher): Unit;

    """
    One search of text from byte start with a searcher made for regex, and
    for no other pattern.  The result is that of search.
    No contract: the result comes from PCRE2.
    """
    generic [Q: Region, R: Region, S: Region]
    function searchWith(searcher: &![Searcher, Q], regex: &[Code, R], text: Span[Nat8, S], start: Index): Either[Int32, Option[Buffer[Index]]];

    """
    One search of text from byte start.  Right of Some holds two slots per
    group, the whole match first, noSlot for a group that took no part;
    Right of None means no match; Left holds the error code of PCRE2.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function search(regex: &[Code, R], text: Span[Nat8, S], start: Index): Either[Int32, Option[Buffer[Index]]];

    """
    Whether this PCRE2 was built with its JIT compiler.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function jitBuiltIn(): Bool;

    """
    Compiles the pattern of compiled to machine code through the JIT of
    PCRE2, which every later search then runs.  0 when it did; otherwise
    the error code of PCRE2, and the pattern is searched by the interpreter
    as before.
    """
    generic [R: Region]
    function jitCode(compiled: &![Code, R]): Int32
        ensures result <= 0;

    """
    Whether compiled runs machine code of the JIT.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function codeJit(compiled: &[Code, R]): Bool;

    """
    "Standard.Pcre: " and the message of PCRE2 for an error code, and the
    byte offset after it unless at is noSlot.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function errorText(code: Int32, at: Index): String;

    """
    The version of PCRE2, as pcre2_config reports it; empty when it
    reports none.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function libraryVersion(): String;
end module.
