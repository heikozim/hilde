-- Tests for Bindings.Bcrypt, with the test vector of crypt_blowfish, the
-- bcrypt of libxcrypt and of many systems: the password U*U against its
-- hash with cost 5.  Only what both systems answer alike is asserted: a
-- hash the library cannot read is -1 on Linux and 0 on OpenBSD, whose
-- crypt_checkpass does not tell a broken hash from a wrong password, so
-- that case is held to not matching.
import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Bindings.Bcrypt (
    bcryptCheck
);

module body Standard.Bindings.Bcrypt.Test is
    function testVector(): Unit is
        assertTrue(bcryptCheck("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW") = 1, "the vector of crypt_blowfish, 2a");
        assertTrue(bcryptCheck("U*U", "$2b$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW") = 1, "the same hash marked 2b");
        return nil;
    end;

    function testWrongPassword(): Unit is
        assertTrue(bcryptCheck("U*V", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW") = 0, "another password does not match");
        assertTrue(bcryptCheck("", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW") = 0, "the empty password does not match");
        return nil;
    end;

    -- The password U*U with a zero byte after it: C would read U*U and stop,
    -- and that matches, so the check refuses a zero byte before C sees it.
    function testZeroByte(): Unit is
        var builder: StringBuilder := makeStringBuilder();
        writeByte(&!builder, 85);
        writeByte(&!builder, 42);
        writeByte(&!builder, 85);
        writeByte(&!builder, 0);
        let withZero: String := finalize(builder);
        assertTrue(bcryptCheck(asSpan(&withZero), "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW") = 0, "U*U and a zero byte does not match");
        destroyString(withZero);
        return nil;
    end;

    function testBrokenHash(): Unit is
        assertTrue(bcryptCheck("U*U", "") = -1, "an empty hash cannot be checked");
        assertTrue(bcryptCheck("U*U", "$2a$05$CCCCCCCC") /= 1, "a cut hash does not match");
        assertTrue(bcryptCheck("U*U", "$2a$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeX") /= 1, "a changed hash does not match");
        return nil;
    end;
end module body.
