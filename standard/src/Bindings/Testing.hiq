-- Asks hilde_running_under_valgrind in lib/prelude/core.c, which reads
-- valgrind's own header only in a build with -DHILDE_VALGRIND.
pragma Unsafe_Module;

module body Bindings.Testing is
    -- No contract: a Bool about the running programme has no range to state.
    function runningUnderValgrind(): Bool is
        return @embed(Int32, "hilde_running_under_valgrind()") = 1;
    end;
end module body.
