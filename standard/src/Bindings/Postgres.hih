"""
Binds libpq, the client library of PostgreSQL, through the declarations of Bindings.C.Libpq.

- It hands addresses and arrays of values to C and makes spans over a result: an unsafe module.
- Standard.Postgres is the safe module built on it, the one a programme imports and reads.
- A connection runs over TCP with TLS, sslmode verify-full, against the CA certificates given.
- All values and all columns travel in the binary form of the server.
- A failure is a PgError: the SQLSTATE read in base 36, or a negative code of this module.
- A failure of start is kept in the cursor and reported by finish.

    let values: Values := withInt64(noValues(), 42);
    let changed: Either[PgError, Nat64] := execute(&!db, "DELETE FROM cart WHERE id = $1", values);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Postgres is
    """
    A connection to a server.  Linear: closeDatabase ends it.
    """
    type Connection: Linear;

    """
    A failure: the SQLSTATE of the server as a number, five characters of
    0 to 9 and A to Z read in base 36, or a negative code of this module.
    """
    record PgError: Free is
        code: Int32;
    end;

    constant connectionFailed: Int32;
    constant newerDatabase: Int32;
    constant tooLarge: Int32;
    constant connectionLost: Int32;
    constant alreadyInTransaction: Int32;

    """
    The number of a five character SQLSTATE.  The characters are taken as
    base 36 digits; a byte that is no digit and no capital letter counts 0.
    """
    generic [R: Region]
    function stateNumber(text: Span[Nat8, R]): Int32
        requires spanLength(text) = 5
        ensures (result >= 0) and (result <= 60466175);

    """
    Open a connection over TCP with TLS and sslmode verify-full against the
    CA certificates in the file caFile.  readOnly makes every transaction of
    the session read only.
    """
    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function connect(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F], readOnly: Bool): Either[PgError, Connection]
        requires (spanLength(host) > 0) and (spanLength(database) > 0)
        requires (spanLength(user) > 0) and (spanLength(caFile) > 0)
        requires port > 0;

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeDatabase(db: Connection): Unit;

    """
    The last message of libpq for this connection, copied.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function lastMessage(db: &[Connection, R]): String;

    """
    True when the connection runs over TLS.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function usesTls(db: &[Connection, R]): Bool;

    type Values: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function noValues(): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withInt64(values: Values, value: Int64): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withFloat64(values: Values, value: Float64): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withBool(values: Values, value: Bool): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withTimestamp(values: Values, value: Int64): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function withText(values: Values, value: Span[Nat8, R]): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function withBytes(values: Values, value: Span[Nat8, R]): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withNull(values: Values): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function dropValues(values: Values): Unit;

    """
    How many values were added.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function valueCount(values: &[Values, R]): Index;

    type Cursor: Linear;

    """
    Run sql with values bound to $1, $2 and so on, all values and all
    columns in the binary form of the server.  A failure is kept in the
    cursor and reported by finish.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function start(db: &![Connection, R], sql: Span[Nat8, S], values: Values): Cursor;

    """
    Run a statement and give the number of rows it changed or returned.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function execute(db: &![Connection, R], sql: Span[Nat8, S], values: Values): Either[PgError, Nat64];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function advance(cursor: &![Cursor, R]): Bool;

    """
    How many columns the result has; 0 after a failure.
    """
    generic [R: Region]
    function columnCount(cursor: &[Cursor, R]): Int32
        ensures result >= 0;

    generic [R: Region]
    function isNullColumn(cursor: &[Cursor, R], index: Int32): Bool
        requires index >= 0;
    generic [R: Region]
    function columnInt64(cursor: &[Cursor, R], index: Int32): Int64
        requires index >= 0;
    generic [R: Region]
    function columnFloat64(cursor: &[Cursor, R], index: Int32): Float64
        requires index >= 0;
    generic [R: Region]
    function columnBool(cursor: &[Cursor, R], index: Int32): Bool
        requires index >= 0;
    generic [R: Region]
    function columnTimestamp(cursor: &[Cursor, R], index: Int32): Int64
        requires index >= 0;
    generic [R: Region]
    function columnText(cursor: &[Cursor, R], index: Int32): Span[Nat8, R]
        requires index >= 0;
    generic [R: Region]
    function columnBytes(cursor: &[Cursor, R], index: Int32): Span[Nat8, R]
        requires index >= 0;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function finish(db: &![Connection, R], cursor: Cursor): Option[PgError];

    type Transaction: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function begin(db: &![Connection, R]): Either[PgError, Transaction];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function commit(db: &![Connection, R], transaction: Transaction): Either[PgError, Unit];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function rollback(db: &![Connection, R], transaction: Transaction): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function migrate(db: &![Connection, R], migrations: Span[Nat8, Static]): Either[PgError, Index];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function copyText(text: Span[Nat8, R]): String;

    """
    The version of libpq, as PQlibVersion reports it: the major version
    times 10000 and the minor.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function libraryVersion(): Int32;
end module.
