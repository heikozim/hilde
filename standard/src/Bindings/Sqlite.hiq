-- Binds libsqlite3 through the declarations of Bindings.C.Sqlite3, and
-- builds spans over the memory of SQLite with @embed.  It is an unsafe
-- module for that; Standard.Sqlite is the safe module built on it.  The
-- handles are linear, and a span into a row carries the region of the
-- borrow the row is lent under.
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullPointer,
    nullCheck,
    allocateBuffer,
    load,
    deallocate
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyEmpty,
    insertBack,
    nthMut,
    lengthMut,
    remove,
    length as bufferLength
);
import Standard.String (
    String,
    makeString,
    destroyString,
    storeNth,
    getSpan,
    length as stringLength
);
import Bindings.C.Sqlite3 (
    sqlite3_libversion,
    sqlite3_sleep,
    SQLITE_BUSY,
    SQLITE_LOCKED,
    OpenFlags,
    combineOpenFlags,
    rawOpenFlags,
    SQLITE_OPEN_CREATE,
    SQLITE_OPEN_EXRESCODE,
    SQLITE_OPEN_READONLY,
    SQLITE_OPEN_READWRITE,
    rawPrepareFlags,
    SQLITE_PREPARE_PERSISTENT,
    SQLITE_OK,
    SQLITE_TOOBIG,
    SQLITE_ROW,
    SQLITE_DONE,
    SQLITE_NULL,
    sqlite3_open_v2,
    sqlite3_close_v2,
    sqlite3_extended_errcode,
    sqlite3_errstr,
    sqlite3_busy_timeout,
    sqlite3_prepare_v3,
    sqlite3_step,
    sqlite3_reset,
    sqlite3_clear_bindings,
    sqlite3_finalize,
    sqlite3_bind_int64,
    sqlite3_bind_double,
    sqlite3_bind_text,
    sqlite3_bind_blob,
    sqlite3_bind_null,
    sqlite3_column_type,
    sqlite3_column_int64,
    sqlite3_column_double,
    sqlite3_column_text,
    sqlite3_column_blob,
    sqlite3_column_bytes,
    sqlite3_changes64
);

module body Bindings.Sqlite is
    -- How long stepped tries a busy step again, in nanoseconds, by the
    -- monotonic clock; and how often, 100 microseconds apart, where the
    -- build has no such clock.
    constant busyNanos: Int64 := 5000000000;
    constant busyTries: Int32 := 50000;
    ---
    --- Handles
    ---

    -- A statement the connection keeps, under the text it was prepared
    -- from.  The text is a string constant of the programme, so its address
    -- lives as long as the programme; the key is still its bytes, because
    -- two constants with the same query are the same statement.
    record Kept: Free is
        text: Address[Nat8];
        size: Index;
        statement: Address[Unit];
    end;

    -- Whether the connection may write is in writing; the mode as a type
    -- is the business of Standard.Sqlite.
    record Connection: Linear is
        handle: Address[Unit];
        writing: Bool;
        cache: Buffer[Kept];
        prepared: Index;
    end;

    record Transaction: Linear is
        handle: Address[Unit];
    end;

    -- failure is SQLITE_OK until something fails; after that every bind
    -- and step is skipped and finish reports it.  statement is null when
    -- preparing failed.
    record Cursor: Linear is
        handle: Address[Unit];
        statement: Address[Unit];
        text: Address[Nat8];
        size: Index;
        failure: Int32;
    end;

    constant newerDatabase: Int32 := -1;

    -- SQLITE_MISUSE of sqlite3.h, which the generated C does not include.
    constant sqliteMisuse: Int32 := 21;

    function describe(error: SqlError): Span[Nat8, Static] is
        if error.code = newerDatabase then
            return "the database has more migrations than this programme knows";
        end if;
        let text: Address[Nat8] := sqlite3_errstr(error.code);
        return @embed(Span[Nat8, Static], "hilde_make_span((void*)$1, strlen((const char*)$1))", text);
    end;

    ---
    --- C memory, the little there is
    ---

    -- The address of a span's first byte, never null: SQLite reads a null
    -- text or blob as an SQL null, so an empty span points at an empty string.
    generic [R: Region]
    function bytesOf(value: Span[Nat8, R]): Address[Nat8] is
        if spanLength(value) = 0 then
            return @embed(Address[Nat8], "(hilde_nat8_t*)\"\"");
        end if;
        return @embed(Address[Nat8], "(hilde_nat8_t*)($1).data", value);
    end;

    function valueLength(size: Index): Option[Int32] is
        return toInt32(size);
    end;

    function lengthInt32(size: Index): Int32 is
        case toInt32(size) of
            when Some(value as v: Int32) do
                return v;
            when None do
                abort("Standard.Sqlite: a value longer than 2 GiB");
        end case;
    end;

    -- A copy of the span with a zero byte after it, for the file name.  The
    -- caller deallocates it.
    generic [R: Region]
    function terminated(value: Span[Nat8, R]): Pointer[Nat8] is
        let size: Index := spanLength(value);
        let address: Address[Nat8] := allocateBuffer(size + 1);
        case nullCheck(address) of
            when Some(value as pointer: Pointer[Nat8]) do
                let source: Address[Nat8] := bytesOf(value);
                @embed(Address[Nat8], "hilde_memcpy($1, $2, $3)", pointer, source, size);
                return pointer;
            when None do
                abort("Standard.Sqlite: out of memory");
        end case;
    end;

    function slotOf(): Pointer[Address[Unit]] is
        let address: Address[Address[Unit]] := allocateBuffer(1);
        case nullCheck(address) of
            when Some(value as pointer: Pointer[Address[Unit]]) do
                return pointer;
            when None do
                abort("Standard.Sqlite: out of memory");
        end case;
    end;

    function slotAddress(slot: Pointer[Address[Unit]]): Address[Address[Unit]] is
        return @embed(Address[Address[Unit]], "$1", slot);
    end;

    function sameHandle(a: Address[Unit], b: Address[Unit]): Bool is
        return @embed(Bool, "($1 == $2)", a, b);
    end;

    function isNull(address: Address[Unit]): Bool is
        case nullCheck(address) of
            when Some(value as pointer: Pointer[Unit]) do
                return false;
            when None do
                return true;
        end case;
    end;

    ---
    --- Opening and closing
    ---

    -- Run one statement of this module's own to its end, ignoring rows:
    -- the pragmas of an open, and the begin and commit of a transaction.
    function runOnce(handle: Address[Unit], sql: Span[Nat8, Static]): Int32 is
        let slot: Pointer[Address[Unit]] := slotOf();
        let noFlags: Nat32 := 0;
        let noTail: Address[Address[Nat8]] := nullPointer();
        let rc: Int32 := sqlite3_prepare_v3(handle, bytesOf(sql), lengthInt32(spanLength(sql)), noFlags, slotAddress(slot), noTail);
        let statement: Address[Unit] := load(slot);
        deallocate(slot);
        if rc /= SQLITE_OK then
            return sqlite3_extended_errcode(handle);
        end if;
        var step: Int32 := stepped(statement);
        while step = SQLITE_ROW do
            step := stepped(statement);
        end while;
        var result: Int32 := SQLITE_OK;
        if step /= SQLITE_DONE then
            result := sqlite3_extended_errcode(handle);
        end if;
        let finalized: Int32 := sqlite3_finalize(statement);
        return result;
    end;

    generic [R: Region]
    function openHandle(path: Span[Nat8, R], flags: OpenFlags): Either[SqlError, Address[Unit]] is
        let name: Pointer[Nat8] := terminated(path);
        let slot: Pointer[Address[Unit]] := slotOf();
        let noVfs: Address[Nat8] := nullPointer();
        let rc: Int32 := sqlite3_open_v2(@embed(Address[Nat8], "$1", name), slotAddress(slot),
            bitsInt32(rawOpenFlags(flags)), noVfs);
        deallocate(name);
        let handle: Address[Unit] := load(slot);
        deallocate(slot);
        if rc /= SQLITE_OK then
            var code: Int32 := rc;
            if not isNull(handle) then
                code := sqlite3_extended_errcode(handle);
                let closed: Int32 := sqlite3_close_v2(handle);
            end if;
            return Left(left => SqlError(code => code));
        end if;
        let timeout: Int32 := sqlite3_busy_timeout(handle, 0);
        return Right(right => handle);
    end;

    function bitsInt32(bits: Nat32): Int32 is
        case toInt32(bits) of
            when Some(value as v: Int32) do
                return v;
            when None do
                abort("Standard.Sqlite: a flag does not fit an int");
        end case;
    end;

    -- One step of statement.  The busy timeout of openHandle is 0, so
    -- SQLite answers SQLITE_BUSY at once when another connection holds the
    -- lock; the step is tried again every 100 microseconds, while other
    -- tasks run, until five seconds have passed on the monotonic clock.  A
    -- count of tries alone waited longer, as a sleep and a step take more
    -- than 100 microseconds under load.  SQLite's own busy handler sleeps 1,
    -- 2, 5, 10 and up to 100 milliseconds between its tries, so a writer
    -- under load waited far longer than the lock was held.  Outside a
    -- transaction a step that was busy may be tried again as it is; inside
    -- one a writer holds the lock from its begin.
    function stepped(statement: Address[Unit]): Int32 is
        var rc: Int32 := sqlite3_step(statement);
        if not busyOrLocked(rc) then
            return rc;
        end if;
        let began: Int64 := @embed(Int64, "hilde_time_monotonic_nanos()");
        var tries: Int32 := 0;
        while busyOrLocked(rc) and stillWaiting(began, tries) do
            @embed(Unit, "hilde_task_sleep_ns(100000)");
            rc := sqlite3_step(statement);
            tries := tries + 1;
        end while;
        return rc;
    end;

    -- Whether a busy step begun at began, after tries tries, is tried
    -- again: less than busyNanos since began, or, without a monotonic
    -- clock (began below 0), fewer than busyTries tries.
    function stillWaiting(began: Int64, tries: Int32): Bool is
        if began < 0 then
            return tries < busyTries;
        end if;
        let now: Int64 := @embed(Int64, "hilde_time_monotonic_nanos()");
        if now < began then
            -- The clock failed or went back: the count decides.
            return tries < busyTries;
        end if;
        return (now - began) < busyNanos;
    end;

    -- SQLITE_BUSY or SQLITE_LOCKED, also as an extended code, whose
    -- low byte is the primary one.
    function busyOrLocked(rc: Int32): Bool is
        let primary: Int32 := rc - ((rc / 256) * 256);
        return (primary = SQLITE_BUSY) or (primary = SQLITE_LOCKED);
    end;

    -- The switch to WAL.  On a database file another connection opens at
    -- the same time SQLite answers it with SQLITE_BUSY at once: it is tried
    -- again every 10 ms, at most 500 times, about as long as stepped waits
    -- for a busy step.
    function switchToWal(handle: Address[Unit]): Int32 is
        var rc: Int32 := runOnce(handle, "PRAGMA journal_mode=WAL");
        var tries: Int32 := 0;
        while busyOrLocked(rc) and (tries < 500) do
            let slept: Int32 := sqlite3_sleep(10);
            rc := runOnce(handle, "PRAGMA journal_mode=WAL");
            tries := tries + 1;
        end while;
        return rc;
    end;

    generic [R: Region]
    function openWriter(path: Span[Nat8, R]): Either[SqlError, Connection] is
        let flags: OpenFlags := combineOpenFlags(combineOpenFlags(SQLITE_OPEN_READWRITE, SQLITE_OPEN_CREATE), SQLITE_OPEN_EXRESCODE);
        case openHandle(path, flags) of
            when Left(left as error: SqlError) do
                return Left(left => error);
            when Right(right as handle: Address[Unit]) do
                -- WAL: readers do not block the writer and the writer does
                -- not block readers.  Foreign keys: SQLite leaves them off
                -- unless a connection asks.  "PRAGMA synchronous=NORMAL": in
                -- WAL mode a commit then writes the log without waiting for
                -- the disk, which is synced at each checkpoint; a crash of
                -- the programme loses nothing, a loss of power at most the
                -- last commits, and the file is never corrupted.  SQLite's
                -- default waits for the disk at every commit.
                var rc: Int32 := switchToWal(handle);
                if rc = SQLITE_OK then
                    rc := runOnce(handle, "PRAGMA foreign_keys=ON");
                end if;
                if rc = SQLITE_OK then
                    rc := runOnce(handle, "PRAGMA synchronous=NORMAL");
                end if;
                if rc /= SQLITE_OK then
                    let closed: Int32 := sqlite3_close_v2(handle);
                    return Left(left => SqlError(code => rc));
                end if;
                let cache: Buffer[Kept] := allocateEmpty();
                let none: Index := 0;
                let db: Connection := Connection(handle => handle, writing => true, cache => cache, prepared => none);
                return Right(right => db);
        end case;
    end;

    generic [R: Region]
    function openReader(path: Span[Nat8, R]): Either[SqlError, Connection] is
        let flags: OpenFlags := combineOpenFlags(SQLITE_OPEN_READONLY, SQLITE_OPEN_EXRESCODE);
        case openHandle(path, flags) of
            when Left(left as error: SqlError) do
                return Left(left => error);
            when Right(right as handle: Address[Unit]) do
                let cache: Buffer[Kept] := allocateEmpty();
                let none: Index := 0;
                let db: Connection := Connection(handle => handle, writing => false, cache => cache, prepared => none);
                return Right(right => db);
        end case;
    end;

    function closeDatabase(db: Connection): Unit is
        let { handle: Address[Unit], writing: Bool, cache: Buffer[Kept], prepared: Index } := db;
        var kept: Buffer[Kept] := cache;
        while bufferLength(&kept) > 0 do
            let entry: Kept := remove(&!kept, 0);
            let finalized: Int32 := sqlite3_finalize(entry.statement);
        end while;
        destroyEmpty(kept);
        let closed: Int32 := sqlite3_close_v2(handle);
        return nil;
    end;

    ---
    --- The statement cache
    ---

    function sameText(entry: Kept, text: Address[Nat8], size: Index): Bool is
        if entry.size /= size then
            return false;
        end if;
        return @embed(Int32, "memcmp($1, $2, $3)", entry.text, text, size) = 0;
    end;

    -- A reference to the cache has the region of db and uses db up, so
    -- every caller hands in a fresh reborrow, &~db.
    generic [R: Region]
    function cacheCount(db: &![Connection, R]): Index is
        return lengthMut(&!(db->cache));
    end;

    generic [R: Region]
    function cacheAt(db: &![Connection, R], position: Index): Kept is
        return nthMut(&!(db->cache), position);
    end;

    generic [R: Region]
    function cacheTake(db: &![Connection, R], position: Index): Kept is
        return remove(&!(db->cache), position);
    end;

    generic [R: Region]
    function cachePut(db: &![Connection, R], entry: Kept): Unit is
        insertBack(&!(db->cache), entry);
        return nil;
    end;

    generic [R: Region]
    function take(db: &![Connection, R], sql: Span[Nat8, Static]): Cursor is
        let text: Address[Nat8] := bytesOf(sql);
        let size: Index := spanLength(sql);
        let handle: Address[Unit] := db->handle;
        var found: Bool := false;
        var statement: Address[Unit] := nullPointer();
        var i: Index := 0;
        while (not found) and (i < cacheCount(&~db)) do
            if sameText(cacheAt(&~db, i), text, size) then
                let entry: Kept := cacheTake(&~db, i);
                statement := entry.statement;
                found := true;
            else
                i := i + 1;
            end if;
        end while;
        if found then
            return Cursor(handle => handle, statement => statement, text => text, size => size, failure => SQLITE_OK);
        end if;
        let slot: Pointer[Address[Unit]] := slotOf();
        let noTail: Address[Address[Nat8]] := nullPointer();
        let rc: Int32 := sqlite3_prepare_v3(handle, text, lengthInt32(size),
            rawPrepareFlags(SQLITE_PREPARE_PERSISTENT),
            slotAddress(slot), noTail);
        statement := load(slot);
        deallocate(slot);
        db->prepared := db->prepared + 1;
        var failure: Int32 := SQLITE_OK;
        if rc /= SQLITE_OK then
            failure := sqlite3_extended_errcode(handle);
        else
            -- A text that is empty or only a comment prepares to no
            -- statement; every later call on it would fail unseen.
            if @embed(Bool, "(($1) == NULL)", statement) then
                failure := sqliteMisuse;
            end if;
        end if;
        return Cursor(handle => handle, statement => statement, text => text, size => size, failure => failure);
    end;

    generic [R: Region]
    function start(db: &![Connection, R], sql: Span[Nat8, Static], values: Values): Cursor is
        return bindAll(take(db, sql), values);
    end;

    generic [R: Region]
    function startWrite(db: &![Connection, R], sql: Span[Nat8, Static], values: Values): Cursor is
        return bindAll(take(db, sql), values);
    end;

    generic [R: Region]
    function execute(db: &![Connection, R], sql: Span[Nat8, Static], values: Values): Either[SqlError, Nat64] is
        var running: Cursor := bindAll(take(&~db, sql), values);
        while advance(&!running) do
            skip;
        end while;
        var count: Nat64 := 0;
        if fine(&running) then
            count := changesOf(db->handle);
        end if;
        case finish(&~db, running) of
            when Some(value as error: SqlError) do
                return Left(left => error);
            when None do
                return Right(right => count);
        end case;
    end;

    generic [R: Region]
    function preparedCount(db: &![Connection, R]): Index is
        return db->prepared;
    end;

    ---
    --- Values
    ---

    union Value: Linear is
        case IntegerValue is
            value: Int64;
        case RealValue is
            value: Float64;
        case TextValue is
            value: String;
        case BlobValue is
            value: String;
        case NullValue;
    end;

    record Values: Linear is
        items: Buffer[Value];
    end;

    function noValues(): Values is
        let items: Buffer[Value] := allocateEmpty();
        return Values(items => items);
    end;

    function withValue(values: Values, value: Value): Values is
        let { items: Buffer[Value] } := values;
        var list: Buffer[Value] := items;
        insertBack(&!list, value);
        return Values(items => list);
    end;

    function withInt64(values: Values, value: Int64): Values is
        return withValue(values, IntegerValue(value => value));
    end;

    function withFloat64(values: Values, value: Float64): Values is
        return withValue(values, RealValue(value => value));
    end;

    generic [R: Region]
    function withText(values: Values, value: Span[Nat8, R]): Values is
        return withValue(values, TextValue(value => copyText(value)));
    end;

    generic [R: Region]
    function withBlob(values: Values, value: Span[Nat8, R]): Values is
        return withValue(values, BlobValue(value => copyText(value)));
    end;

    function withNull(values: Values): Values is
        return withValue(values, NullValue());
    end;

    function withInt64OrNull(values: Values, value: Option[Int64]): Values is
        case value of
            when Some(value as v: Int64) do
                return withInt64(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    function withFloat64OrNull(values: Values, value: Option[Float64]): Values is
        case value of
            when Some(value as v: Float64) do
                return withFloat64(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    generic [R: Region]
    function withTextOrNull(values: Values, value: Option[Span[Nat8, R]]): Values is
        case value of
            when Some(value as v: Span[Nat8, R]) do
                return withText(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    generic [R: Region]
    function withBlobOrNull(values: Values, value: Option[Span[Nat8, R]]): Values is
        case value of
            when Some(value as v: Span[Nat8, R]) do
                return withBlob(values, v);
            when None do
                return withNull(values);
        end case;
    end;

    -- SQLITE_TRANSIENT: SQLite copies the bytes before the call returns.
    function transient(): Address[Unit] is
        return @embed(Address[Unit], "((void*)(intptr_t)-1)");
    end;

    -- One value, bound at the position index; its result code.  A text or
    -- blob longer than an Int32 can count is SQLITE_TOOBIG, which SQLite
    -- itself answers for a value over its size limit: the value may come
    -- from outside, and its length is no reason to stop.
    function bindOne(statement: Address[Unit], index: Int32, item: Value): Int32 is
        case item of
            when IntegerValue(value as v: Int64) do
                return sqlite3_bind_int64(statement, index, v);
            when RealValue(value as v: Float64) do
                return sqlite3_bind_double(statement, index, v);
            when TextValue(value as s: String) do
                var rc: Int32 := SQLITE_TOOBIG;
                case valueLength(stringLength(&s)) of
                    when Some(value as size: Int32) do
                        rc := sqlite3_bind_text(statement, index, bytesOf(textOf(&s)), size, transient());
                    when None do
                        skip;
                end case;
                destroyString(s);
                return rc;
            when BlobValue(value as s: String) do
                var rc: Int32 := SQLITE_TOOBIG;
                case valueLength(stringLength(&s)) of
                    when Some(value as size: Int32) do
                        let bytes: Address[Unit] := @embed(Address[Unit], "(void*)$1", bytesOf(textOf(&s)));
                        rc := sqlite3_bind_blob(statement, index, bytes, size, transient());
                    when None do
                        skip;
                end case;
                destroyString(s);
                return rc;
            when NullValue do
                return sqlite3_bind_null(statement, index);
        end case;
    end;

    -- Every value, in order, onto the cursor's statement.  After a failure
    -- the rest are only destroyed.
    function bindAll(cursor: Cursor, values: Values): Cursor is
        let { handle: Address[Unit], statement: Address[Unit], text: Address[Nat8], size: Index, failure: Int32 } := cursor;
        let { items: Buffer[Value] } := values;
        var list: Buffer[Value] := items;
        var now: Int32 := failure;
        var index: Int32 := 1;
        while bufferLength(&list) > 0 do
            let item: Value := remove(&!list, 0);
            if now = SQLITE_OK then
                let rc: Int32 := bindOne(statement, index, item);
                if rc = SQLITE_TOOBIG then
                    -- Possibly this module's own answer, which the
                    -- connection never saw: keep it as it is.
                    now := rc;
                else if rc /= SQLITE_OK then
                    now := sqlite3_extended_errcode(handle);
                end if;
            else
                dropValue(item);
            end if;
            index := index + 1;
        end while;
        destroyEmpty(list);
        return Cursor(handle => handle, statement => statement, text => text, size => size, failure => now);
    end;

    function dropValue(item: Value): Unit is
        case item of
            when TextValue(value as s: String) do
                destroyString(s);
            when BlobValue(value as s: String) do
                destroyString(s);
            when IntegerValue(value as n: Int64) do
                skip;
            when RealValue(value as r: Float64) do
                skip;
            when NullValue do
                skip;
        end case;
        return nil;
    end;

    ---
    --- Stepping and reading
    ---

    generic [R: Region]
    function advance(cursor: &![Cursor, R]): Bool is
        if cursor->failure /= SQLITE_OK then
            return false;
        end if;
        let rc: Int32 := stepped(cursor->statement);
        if rc = SQLITE_ROW then
            return true;
        end if;
        if rc /= SQLITE_DONE then
            cursor->failure := sqlite3_extended_errcode(cursor->handle);
        end if;
        return false;
    end;

    generic [R: Region]
    function columnInt64(cursor: &[Cursor, R], index: Int32): Int64 is
        return sqlite3_column_int64(cursor->statement, index);
    end;

    generic [R: Region]
    function columnFloat64(cursor: &[Cursor, R], index: Int32): Float64 is
        return sqlite3_column_double(cursor->statement, index);
    end;

    -- sqlite3_column_bytes after sqlite3_column_text, in that order: the
    -- order SQLite's documentation gives for a length that belongs to the
    -- pointer.
    generic [R: Region]
    function columnText(cursor: &[Cursor, R], index: Int32): Span[Nat8, R] is
        let bytes: Address[Nat8] := sqlite3_column_text(cursor->statement, index);
        let size: Int32 := sqlite3_column_bytes(cursor->statement, index);
        return @embed(Span[Nat8, R], "hilde_make_span((void*)$1, (size_t)$2)", bytes, size);
    end;

    generic [R: Region]
    function columnBlob(cursor: &[Cursor, R], index: Int32): Span[Nat8, R] is
        let bytes: Address[Unit] := sqlite3_column_blob(cursor->statement, index);
        let size: Int32 := sqlite3_column_bytes(cursor->statement, index);
        return @embed(Span[Nat8, R], "hilde_make_span((void*)$1, (size_t)$2)", bytes, size);
    end;

    generic [R: Region]
    function isNullColumn(cursor: &[Cursor, R], index: Int32): Bool is
        return sqlite3_column_type(cursor->statement, index) = SQLITE_NULL;
    end;

    generic [R: Region]
    function columnInt64OrNone(cursor: &[Cursor, R], index: Int32): Option[Int64] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnInt64(cursor, index));
    end;

    generic [R: Region]
    function columnFloat64OrNone(cursor: &[Cursor, R], index: Int32): Option[Float64] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnFloat64(cursor, index));
    end;

    generic [R: Region]
    function columnTextOrNone(cursor: &[Cursor, R], index: Int32): Option[Span[Nat8, R]] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnText(cursor, index));
    end;

    generic [R: Region]
    function columnBlobOrNone(cursor: &[Cursor, R], index: Int32): Option[Span[Nat8, R]] is
        if isNullColumn(cursor, index) then
            return None();
        end if;
        return Some(value => columnBlob(cursor, index));
    end;

    ---
    --- Ending
    ---

    generic [R: Region]
    function finish(db: &![Connection, R], cursor: Cursor): Option[SqlError] is
        let { handle: Address[Unit], statement: Address[Unit], text: Address[Nat8], size: Index, failure: Int32 } := cursor;
        if not sameHandle(handle, db->handle) then
            abort("Standard.Sqlite: a statement was finished on another connection than it was started on");
        end if;
        if not isNull(statement) then
            let reset: Int32 := sqlite3_reset(statement);
            let cleared: Int32 := sqlite3_clear_bindings(statement);
            cachePut(&~db, Kept(text => text, size => size, statement => statement));
        end if;
        if failure /= SQLITE_OK then
            return Some(value => SqlError(code => failure));
        end if;
        return None();
    end;

    generic [R: Region]
    function fine(cursor: &[Cursor, R]): Bool is
        return cursor->failure = SQLITE_OK;
    end;

    function changesOf(handle: Address[Unit]): Nat64 is
        case toNat64(sqlite3_changes64(handle)) of
            when Some(value as v: Nat64) do
                return v;
            when None do
                return 0;
        end case;
    end;

    ---
    --- Transactions
    ---

    generic [R: Region]
    function begin(db: &![Connection, R]): Either[SqlError, Transaction] is
        var rc: Int32 := SQLITE_OK;
        if db->writing then
            rc := runOnce(db->handle, "BEGIN IMMEDIATE");
        else
            rc := runOnce(db->handle, "BEGIN");
        end if;
        if rc /= SQLITE_OK then
            return Left(left => SqlError(code => rc));
        end if;
        return Right(right => Transaction(handle => db->handle));
    end;

    generic [R: Region]
    function commit(db: &![Connection, R], transaction: Transaction): Either[SqlError, Unit] is
        let { handle: Address[Unit] } := transaction;
        if not sameHandle(handle, db->handle) then
            abort("Standard.Sqlite: a transaction was committed on another connection than it was begun on");
        end if;
        let rc: Int32 := runOnce(handle, "COMMIT");
        if rc /= SQLITE_OK then
            let back: Int32 := runOnce(handle, "ROLLBACK");
            return Left(left => SqlError(code => rc));
        end if;
        return Right(right => nil);
    end;

    generic [R: Region]
    function rollback(db: &![Connection, R], transaction: Transaction): Unit is
        let { handle: Address[Unit] } := transaction;
        if not sameHandle(handle, db->handle) then
            abort("Standard.Sqlite: a transaction was rolled back on another connection than it was begun on");
        end if;
        let back: Int32 := runOnce(handle, "ROLLBACK");
        return nil;
    end;

    ---
    --- Migrations
    ---

    -- The version the database is at: pragma user_version.
    function userVersion(handle: Address[Unit]): Either[SqlError, Index] is
        let sql: Span[Nat8, Static] := "PRAGMA user_version";
        let slot: Pointer[Address[Unit]] := slotOf();
        let noFlags: Nat32 := 0;
        let noTail: Address[Address[Nat8]] := nullPointer();
        let rc: Int32 := sqlite3_prepare_v3(handle, bytesOf(sql), lengthInt32(spanLength(sql)), noFlags, slotAddress(slot), noTail);
        let statement: Address[Unit] := load(slot);
        deallocate(slot);
        if rc /= SQLITE_OK then
            return Left(left => SqlError(code => sqlite3_extended_errcode(handle)));
        end if;
        var version: Index := 0;
        let step: Int32 := stepped(statement);
        if step = SQLITE_ROW then
            case toIndex(sqlite3_column_int64(statement, 0)) of
                when Some(value as v: Index) do
                    version := v;
                when None do
                    skip;
            end case;
        else
            -- Only a row is an answer: an error read as version 0 would run
            -- every migration again.
            let failed: SqlError := SqlError(code => sqlite3_extended_errcode(handle));
            let finalizedAfterError: Int32 := sqlite3_finalize(statement);
            return Left(left => failed);
        end if;
        let finalized: Int32 := sqlite3_finalize(statement);
        return Right(right => version);
    end;

    -- Run a migration's text, statement after statement: prepare takes the
    -- first and says where the rest begins.
    function runScript(handle: Address[Unit], text: Address[Nat8], size: Index): Int32 is
        var at: Address[Nat8] := text;
        var left: Index := size;
        var result: Int32 := SQLITE_OK;
        while (result = SQLITE_OK) and (left > 0) do
            let slot: Pointer[Address[Unit]] := slotOf();
            let tailSlot: Address[Address[Nat8]] := allocateBuffer(1);
            if @embed(Bool, "(($1) == NULL)", tailSlot) then
                abort("Standard.Sqlite: out of memory");
            end if;
            let noFlags: Nat32 := 0;
            let rc: Int32 := sqlite3_prepare_v3(handle, at, lengthInt32(left), noFlags, slotAddress(slot), tailSlot);
            let statement: Address[Unit] := load(slot);
            deallocate(slot);
            let tail: Address[Nat8] := @embed(Address[Nat8], "*($1)", tailSlot);
            @embed(Unit, "hilde_free($1)", tailSlot);
            if rc /= SQLITE_OK then
                result := sqlite3_extended_errcode(handle);
            else
                if not isNull(statement) then
                    var step: Int32 := stepped(statement);
                    while step = SQLITE_ROW do
                        step := stepped(statement);
                    end while;
                    if step /= SQLITE_DONE then
                        result := sqlite3_extended_errcode(handle);
                    end if;
                    let finalized: Int32 := sqlite3_finalize(statement);
                end if;
                let used: Index := @embed(Index, "(size_t)($1 - $2)", tail, at);
                left := left - used;
                at := tail;
                if used = 0 then
                    left := left - left;
                end if;
            end if;
        end while;
        return result;
    end;

    -- "PRAGMA user_version = <n>" for this version: the one statement this
    -- module builds from a number.  The digits are written here and not
    -- with snprintf: the generated C does not include <stdio.h> (see the
    -- comment at the top of lib/prelude.c).
    function setVersion(handle: Address[Unit], version: Index): Int32 is
        let prefix: Span[Nat8, Static] := "PRAGMA user_version = ";
        var digits: Index := 1;
        var scale: Index := 1;
        while (version / scale) >= 10 do
            scale := scale * 10;
            digits := digits + 1;
        end while;
        let size: Index := spanLength(prefix) + digits;
        var sql: String := makeString(size, ' ');
        var i: Index := 0;
        while i < spanLength(prefix) do
            storeNth(&!sql, i, prefix[i]);
            i := i + 1;
        end while;
        var rest: Index := version;
        while scale > 0 do
            let digit: Index := rest / scale;
            storeNth(&!sql, i, digitByte(digit));
            rest := rest - (digit * scale);
            scale := scale / 10;
            i := i + 1;
        end while;
        let rc: Int32 := runScript(handle, bytesOf(textOf(&sql)), size);
        destroyString(sql);
        return rc;
    end;

    function digitByte(digit: Index): Nat8 is
        case toNat8(digit + 48) of
            when Some(value as b: Nat8) do
                return b;
            when None do
                return '0';
        end case;
    end;

    -- A decimal number at the position at in the migrations constant, up
    -- to the newline after it.
    function digitAt(migrations: Span[Nat8, Static], at: Index): Bool is
        if at >= spanLength(migrations) then
            return false;
        end if;
        let b: Nat8 := migrations[at];
        return (b >= '0') and (b <= '9');
    end;

    generic [R: Region]
    function migrate(db: &![Connection, R], migrations: Span[Nat8, Static]): Either[SqlError, Index] is
        let handle: Address[Unit] := db->handle;
        var have: Index := 0;
        case userVersion(handle) of
            when Left(left as error: SqlError) do
                return Left(left => error);
            when Right(right as v: Index) do
                have := v;
        end case;
        -- Walk the constant: "<size>\n<text>" for each migration, in order.
        var at: Index := 0;
        var number: Index := 0;
        var applied: Index := 0;
        var failure: Int32 := SQLITE_OK;
        let total: Index := spanLength(migrations);
        while (failure = SQLITE_OK) and (at < total) do
            var size: Index := 0;
            while digitAt(migrations, at) do
                size := ((size * 10) + byteValue(migrations[at])) - 48;
                at := at + 1;
            end while;
            at := at + 1;
            number := number + 1;
            if number > have then
                failure := runOnce(handle, "BEGIN IMMEDIATE");
                -- Another connection may have run this migration after the
                -- version was read above and before this one got the lock:
                -- the version is read again under it, and a migration that
                -- is in already is not run twice.
                var already: Bool := false;
                if failure = SQLITE_OK then
                    case userVersion(handle) of
                        when Left(left as error: SqlError) do
                            failure := error.code;
                        when Right(right as current: Index) do
                            already := current >= number;
                    end case;
                end if;
                if (failure = SQLITE_OK) and (not already) then
                    let text: Address[Nat8] := @embed(Address[Nat8], "((hilde_nat8_t*)($1).data + $2)", migrations, at);
                    failure := runScript(handle, text, size);
                    if failure = SQLITE_OK then
                        failure := setVersion(handle, number);
                    end if;
                end if;
                if failure = SQLITE_OK then
                    failure := runOnce(handle, "COMMIT");
                end if;
                if failure /= SQLITE_OK then
                    let back: Int32 := runOnce(handle, "ROLLBACK");
                else if not already then
                    applied := applied + 1;
                end if;
            end if;
            at := at + size;
        end while;
        if failure /= SQLITE_OK then
            return Left(left => SqlError(code => failure));
        end if;
        if have > number then
            return Left(left => SqlError(code => newerDatabase));
        end if;
        return Right(right => applied);
    end;

    function byteValue(b: Nat8): Index is
        case toIndex(b) of
            when Some(value as v: Index) do
                return v;
            when None do
                return 0;
        end case;
    end;

    ---
    --- Text
    ---

    generic [R: Region]
    function copyText(text: Span[Nat8, R]): String is
        let size: Index := spanLength(text);
        var copy: String := makeString(size, ' ');
        var i: Index := 0;
        while i < size do
            storeNth(&!copy, i, text[i]);
            i := i + 1;
        end while;
        return copy;
    end;

    generic [R: Region]
    function textOf(text: &[String, R]): Span[Nat8, R] is
        let size: Index := stringLength(text);
        if size = 0 then
            return @embed(Span[Nat8, R], "hilde_make_span((void*)\"\", 0)");
        end if;
        return getSpan(text, 0, size - 1);
    end;

    function libraryVersion(): Span[Nat8, Static] is
        let text: Address[Nat8] := sqlite3_libversion();
        return @embed(Span[Nat8, Static], "(($1) == NULL) ? hilde_make_span((void*)\"\", 0) : hilde_make_span((void*)$1, strlen((const char*)$1))", text);
    end;
end module body.
