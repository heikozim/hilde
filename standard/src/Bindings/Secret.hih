"""
Binds the reading of a secret from the terminal or a descriptor, into memory that is wiped before it is given back.

- It reaches C with @embed, so it is an unsafe module.
- Standard.Secret is the safe module built on it, and the one a programme imports.
- The buffer holds secretCapacity bytes; it is wiped on every failure and when it is destroyed.

    case allocateRaw() of
        when Some(value as raw: RawSecret) do
            destroyRaw(raw);
        when None do
            skip;
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Secret is
    """
    The most bytes a secret holds.
    """
    constant secretCapacity: Index;

    """
    Memory for one secret and the number of its bytes in use.
    """
    type RawSecret: Linear;

    """
    A buffer of secretCapacity bytes, none in use, or None when the memory
    cannot be had.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function allocateRaw(): Option[RawSecret];

    """
    Reads a line from the terminal of the process with the echo off,
    after prompt.  The length read, -1 without a terminal, -2 for a line
    longer than secretCapacity, -3 when reading failed or a signal came.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, P: Region]
    function readTerminalInto(raw: &![RawSecret, R], prompt: Span[Nat8, P]): Int64;

    """
    Reads a line from standard input.  The length read, -2 for a line longer
    than secretCapacity, -3 when reading failed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function readInputInto(raw: &![RawSecret, R]): Int64;

    """
    The bytes in use.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function rawBytes(raw: &[RawSecret, R]): Span[Nat8, R];

    """
    Wipes the whole buffer and gives it back.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function destroyRaw(raw: RawSecret): Unit;
end module.
