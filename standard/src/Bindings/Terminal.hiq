-- Binds the standard streams of libc through the runtime.  It reaches C
-- with @embed and imports C functions, so it is an unsafe module;
-- Standard.IO.Terminal is the safe module built on it.
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    spanToPointer,
    arraySizeInBytes
);

module body Bindings.Terminal is
    constant EOF: Int32 := -1;

    generic [R: Region]
    function writeStderrText(text: Span[Nat8, R]): Bool is
        let size: Index := spanLength(text);
        if size = 0 then
            -- Nothing to write, and no first byte to point write(2) at.
            return true;
        end if;
        let address: Pointer[Nat8] := spanToPointer(text);
        let bytes: ByteSize := arraySizeInBytes(sizeof(Nat8), size);
        return @embed(Int32, "hilde_stderr_write_all($1, $2)", address, bytes) = 1;
    end;

    function isTerminalNumber(fd: Int32): Bool is
        return @embed(Int32, "hilde_terminal_is($1)", fd) = 1;
    end;

    function setEcho(fd: Int32, on: Bool): Bool is
        var flag: Int32 := 0;
        if on then
            flag := 1;
        end if;
        return @embed(Int32, "hilde_terminal_echo($1, $2)", fd, flag) = 1;
    end;

    function widthOf(fd: Int32): Nat32 is
        return @embed(Nat32, "hilde_terminal_width($1)", fd);
    end;

    function drainNumber(fd: Int32): Bool is
        return @embed(Int32, "hilde_terminal_drain($1)", fd) = 1;
    end;

    function writeStdout(byte: Nat8): Unit is
        putByte(byte, @embed(Address[Nat8], "hilde_stdout()"));
        return nil;
    end;

    function writeStderr(byte: Nat8): Unit is
        putByte(byte, @embed(Address[Nat8], "hilde_stderr()"));
        return nil;
    end;

    function readStdin(): Option[Nat8] is
        let res: Int32 := fgetc(@embed(Address[Nat8], "hilde_stdin()"));
        if res = EOF then
            return None();
        else
            return toNat8(res);
        end if;
    end;

    function putByte(byte: Nat8, stream: Address[Nat8]): Unit is
        case toInt32(byte) of
            when Some(value as c: Int32) do
                fputc(c, stream);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- Through the runtime and not under their libc names: gcc knows fputc
    -- as a built-in taking a pointer to a stream, and warns about this declaration
    -- in any program whose headers bring stdio.h.
    pragma Foreign_Import(External_Name => "hilde_fputc");
    function fputc(c: Int32, stream: Address[Nat8]): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_fgetc");
    function fgetc(stream: Address[Nat8]): Int32 is
    end;
end module body.
