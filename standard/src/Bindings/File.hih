"""
Binds the file, directory, process, environment and socket calls of the C library, by lib/prelude.c.

- It hands the kernel the address of a string's bytes, so it is an unsafe module.
- It holds a directory stream as a pointer.
- Standard.File is the safe module built on it, and the one a programme imports.
- A path here is a copy with a zero byte after it and none inside, as Standard.File makes it.
- A path that is empty, does not end in a zero byte or holds one before its end is refused.
- A count never reaches past the string it names.

    let number: Int32 := openRead(&path);
    let read: Int64 := readInto(number, &!buffer, 0, 4096);
    let closed: Bool := closeNumber(number);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Bindings.File is
    """
    The descriptor of the file opened for reading, or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openRead(path: &[String, R]): Int32;

    """
    The descriptor of the file created or emptied for writing, mode 0600,
    or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openWrite(path: &[String, R]): Int32;

    """
    The descriptor of the file created if missing and opened for
    appending, set to mode, or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openAppend(path: &[String, R], mode: Nat32): Int32;

    """
    Opens path for appending, set to mode, and puts it in place of the
    descriptor number with dup2(2).  true on success; false when path
    could not be opened or dup2 failed, and the number still names the old
    file, or when close-on-exec could not be set on it again, and it names
    the new file.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function reopenAppend(number: Int32, path: &[String, R], mode: Nat32): Bool;

    """
    Closes the descriptor.  True when the kernel reported no error.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeNumber(number: Int32): Bool;

    """
    Reads at most count bytes into buffer from position at on.  Returns what
    the kernel returned: the bytes read, 0 at the end of the file, a
    negative number on a failure.  -1 without a call when at and count do
    not lie inside the buffer, or count is 0.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function readInto(number: Int32, buffer: &![String, R], at: Index, count: Index): Int64;

    """
    Writes all of data, retrying short writes.  True when every byte was
    written; true without a call for empty data.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function writeAll(number: Int32, data: Span[Nat8, R]): Bool;

    """
    Reads into buffer at at, at most count bytes, from a non-blocking
    socket, waiting at most milliseconds in all: the bytes read, 0 at the
    end of the stream, -1 on an error, -2 when the time ran out; -1
    without a call when at and count do not lie inside the buffer.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function readWithinInto(number: Int32, buffer: &![String, R], at: Index, count: Index, milliseconds: Nat32): Int64;

    """
    Writes all of data to a non-blocking socket within milliseconds in
    all: 1 when every byte went out, -1 on an error, -2 when the time ran
    out; 1 without a call for empty data.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function writeWithinNumber(number: Int32, data: Span[Nat8, R], milliseconds: Nat32): Int32;

    """
    Makes the socket non-blocking.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function nonblockingNumber(number: Int32): Bool;

    """
    What the path names, in the runtime's numbers: 0 unknown, 1 regular
    file, 2 directory, 3 symbolic link, 4 something else.  follow is 1 to
    ask about the target of a link, 0 to ask about the link.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function kindCode(path: &[String, R], follow: Int32): Int32;

    """
    Reads the target of the link into buffer.  The number of bytes, which
    may fill the buffer, or a negative number on a failure.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function readLink(path: &[String, R], buffer: &![String, S]): Int64;

    """
    Creates a symbolic link name that points at target.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function makeLink(target: &[String, R], name: &[String, S]): Bool;

    """
    The two descriptors of a new pipe.
    """
    record PipeNumbers: Free is
        reading: Int32;
        writing: Int32;
    end;

    """
    A new pipe, or None when the kernel refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function openPipeNumbers(): Option[PipeNumbers];

    """
    Moves the offset of the descriptor; origin is 0 from the start, 1 from
    here, 2 from the end.  The new offset, or a negative number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function seekNumber(number: Int32, offset: Int64, origin: Int32): Int64;

    """
    Creates a directory, mode 0700.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function makeDirectory(path: &[String, R]): Bool;

    """
    Removes an empty directory.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function removeDirectory(path: &[String, R]): Bool;

    """
    A directory stream of the C library.  It must be given back with
    closeStream.
    """
    type Stream: Linear;

    """
    The stream of the directory, or None when it cannot be opened.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openStream(path: &[String, R]): Option[Stream];

    """
    Reads the next name into buffer, skipping . and ..: the number of bytes,
    -1 at the end, -2 on a failed read, -3 for a name longer than the
    buffer.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function nextName(stream: &[Stream, R], buffer: &![String, S]): Int64;

    """
    Closes the stream.  True when the C library reported no error.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeStream(stream: Stream): Bool;

    """
    The process id and the three descriptors of a started process: its
    standard input, output and error.
    """
    record Spawned: Free is
        pid: Int32;
        input: Int32;
        output: Int32;
        errors: Int32;
    end;

    """
    Starts the programme.  packed holds count arguments, the programme
    first, each followed by a zero byte; the last byte of packed is a zero
    byte.  None when the process could not be started, and without a call
    when packed does not hold exactly count zero bytes or does not end in
    one.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function spawnPacked(packed: &[String, R], count: Index): Option[Spawned];

    """
    Sends the termination signal to the process.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function terminatePid(pid: Int32): Bool;

    """
    Waits for the process to end: 0 to 255 its exit code, 256 plus a signal
    number when a signal ended it, -1 when the wait failed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function waitPid(pid: Int32): Int32;

    """
    The number of the termination signal on this platform.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function terminationSignal(): Int32;

    """
    Copies the value of the environment variable name into buffer, as much
    as fits.  The whole length of the value, which may be more than the
    buffer holds, or -1 when the variable is not set.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function environmentInto(name: &[String, R], buffer: &![String, S]): Int64;

    """
    Removes the file.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function removePath(path: &[String, R]): Bool;

    """
    Removes the file.  True when it is gone afterwards, also when it was
    not there.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function removePathIfThere(path: &[String, R]): Bool;

    """
    Overwrites a regular file once with random bytes, syncs it and removes
    it.  2 when that was done, 3 when the file had more than one link and
    was only unlinked, 0 when it was refused or failed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function secureRemovePath(path: &[String, R]): Int32;

    """
    Sets the mode of the open descriptor number with fchmod(2).  True on
    success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function setModeNumber(number: Int32, mode: Nat32): Bool;

    """
    What the runtime found at a name: found is 1 when something is there,
    0 when nothing is, and -1 when the name could not be looked at; the
    other slots hold something only for 1.  kind has the numbers of
    kindCode, mode the permission bits, device, inode and links the
    numbers of st_dev, st_ino and st_nlink.
    """
    record StatusNumbers: Free is
        found: Int32;
        kind: Nat32;
        mode: Nat32;
        owner: Nat32;
        group: Nat32;
        size: Nat64;
        device: Nat64;
        inode: Nat64;
        links: Nat64;
    end;

    """
    What the path names, with lstat(2) when follow is 0 and stat(2) when
    it is 1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function statusNumbers(path: &[String, R], follow: Int32): StatusNumbers;

    """
    What the open descriptor number is, with fstat(2); found is 1 on
    success and -1 otherwise.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function statusOpenNumbers(number: Int32): StatusNumbers;

    """
    Sets the owner and group of the open descriptor number with fchown(2).
    True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function setOwnerNumber(number: Int32, owner: Nat32, group: Nat32): Bool;

    """
    Writes what the kernel holds of the open descriptor number to the disk
    with fsync(2).  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function syncNumber(number: Int32): Bool;

    """
    Opens the directory at path, syncs it with fsync(2) and closes it.
    True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function syncDirectoryPath(path: &[String, R]): Bool;

    """
    Renames source to target with rename(2).  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function renamePath(source: &[String, R], target: &[String, S]): Bool;

    """
    Makes name a hard link to existing with link(2).  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function linkPath(existing: &[String, R], name: &[String, S]): Bool;

    """
    Makes a new file from template with mkstemp(3): the six bytes before
    the zero byte at its end are X, and they are replaced in template with
    the new name's.  The descriptor, open for reading and writing with mode
    0600, or -1, and then no file was made.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function makeTemporary(template: &![String, R]): Int32;

    """
    Makes a new file at path, only when the name is free, open for writing
    with mode set on it.  The descriptor, or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function createNewNumber(path: &[String, R], mode: Nat32): Int32;

    """
    Opens an existing file for writing from its first byte, without
    truncating it.  The descriptor, or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openOverwriteNumber(path: &[String, R]): Int32;

    """
    The longest path a Unix domain socket may have on this platform.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function socketPathLimit(): Index;

    """
    The descriptor of a new listening socket at path with the given mode,
    or a negative number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function listenAt(path: &[String, R], mode: Nat32): Int32;

    """
    The descriptor of the next connection, or a negative number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function acceptNumber(listener: Int32): Int32;

    """
    As acceptNumber, waiting at most milliseconds.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function acceptNumberWithin(listener: Int32, milliseconds: Nat32): Int32;

    """
    The descriptor of a connection to the socket at path, or a negative
    number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function connectTo(path: &[String, R]): Int32;

    """
    Closes the listening socket and removes its path.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function closeListening(number: Int32, path: &[String, R]): Bool;

    """
    The descriptor of a TCP connection to address, 4 bytes of IPv4 or 16
    of IPv6 in network order, at port, made within milliseconds.  Otherwise
    -1 when the connection was refused, -2 when the time ran out, -3 when
    the address cannot be reached, -4 for anything else, an address of
    another size among them.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function connectTcpNumber(address: Span[Nat8, R], port: Nat16, milliseconds: Nat32): Int32;

    """
    The descriptor of a TCP socket bound to address, 4 bytes of IPv4 or 16
    of IPv6 in network order, at port and listening, or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function listenTcpNumber(address: Span[Nat8, R], port: Nat16): Int32;

    """
    The local port of the TCP socket number, or 0 when it has none.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function tcpLocalPort(number: Int32): Nat16;
end module.
