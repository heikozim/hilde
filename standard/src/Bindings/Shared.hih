"""
Binds the mutexes of the runtime in lib/prelude.c and the atomic operations of the C compiler.

- The value a mutex guards lives in raw memory beside the lock, so it is an unsafe module.
- That value is moved out and back through a read reference.
- An atomic is one word of 64 bits.
- Standard.Shared is the safe module built on it, and the one a programme imports.
- Each declaration here is the one of Standard.Shared with the same name.

    let { value: Nat64, key: Key } := acquire(&mutex);
    release(&mutex, value + 1, key);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Shared is
    type Mutex[T: Type]: Linear;

    type Key: Linear;

    record Held[T: Type]: Linear is
        value: T;
        key: Key;
    end;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function makeMutex(value: T): Either[T, Mutex[T]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function acquire(mutex: &[Mutex[T], R]): Held[T];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function tryAcquire(mutex: &[Mutex[T], R]): Option[Held[T]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function release(mutex: &[Mutex[T], R], value: T, key: Key): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function mutexHeld(mutex: &[Mutex[T], R]): Bool;

    """
    Frees mutex.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function destroyMutex(mutex: Mutex[T]): T;

    type Atomic: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function makeAtomic(initial: Int64): Option[Atomic];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function atomicLoad(atomic: &[Atomic, R]): Int64;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function atomicStore(atomic: &[Atomic, R], value: Int64): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function atomicExchange(atomic: &[Atomic, R], value: Int64): Int64;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function atomicCompareSwap(atomic: &[Atomic, R], expected: Int64, desired: Int64): Bool;

    """
    Frees atomic.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function destroyAtomic(atomic: Atomic): Int64;
end module.
