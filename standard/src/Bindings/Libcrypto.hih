"""
Binds libcrypto through the declarations in Bindings.C.Libcrypto.

- The library is that of OpenSSL on Linux and that of LibreSSL on OpenBSD.
- It hands addresses to C, so it is an unsafe module.
- Standard.Libcrypto is the safe module built on it, and the one a programme imports.
- Each function here is the one of Standard.Libcrypto with the same name.

    let digest: Option[String] := sha256(asSpan(&message));
    let sealed: Option[String] := sealAes256Gcm(asSpan(&key), asSpan(&nonce), asSpan(&text), "");
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Libcrypto is
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, N: Region, P: Region, A: Region]
    function sealAes256Gcm(key: Span[Nat8, K], nonce: Span[Nat8, N], plaintext: Span[Nat8, P], aad: Span[Nat8, A]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, N: Region, S: Region, A: Region]
    function openAes256Gcm(key: Span[Nat8, K], nonce: Span[Nat8, N], sealed: Span[Nat8, S], aad: Span[Nat8, A]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, N: Region, P: Region, A: Region]
    function sealChaCha20Poly1305(key: Span[Nat8, K], nonce: Span[Nat8, N], plaintext: Span[Nat8, P], aad: Span[Nat8, A]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, N: Region, S: Region, A: Region]
    function openChaCha20Poly1305(key: Span[Nat8, K], nonce: Span[Nat8, N], sealed: Span[Nat8, S], aad: Span[Nat8, A]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region]
    function x25519PublicKey(privateKey: Span[Nat8, K]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, P: Region]
    function x25519SharedSecret(privateKey: Span[Nat8, K], peerPublicKey: Span[Nat8, P]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [S: Region]
    function ed25519PublicKey(seed: Span[Nat8, S]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [S: Region, M: Region]
    function ed25519Sign(seed: Span[Nat8, S], message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [P: Region, M: Region, G: Region]
    function ed25519Verify(publicKey: Span[Nat8, P], message: Span[Nat8, M], signature: Span[Nat8, G]): Bool;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function randomBytes(count: Index): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [M: Region]
    function sha256(message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, M: Region]
    function hmacSha256(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [M: Region]
    function sha384(message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [M: Region]
    function sha512(message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [M: Region]
    function sha3_256(message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [M: Region]
    function sha3_512(message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, M: Region]
    function hmacSha384(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, M: Region]
    function hmacSha512(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, M: Region]
    function hmacSha1(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The HMAC of message under key with SHA3-512, 64 bytes.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, M: Region]
    function hmacSha3_512(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The version of libcrypto the programme runs with, as OpenSSL_version
    reports it; empty when it reports none.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function libraryVersion(): Span[Nat8, Static];
end module.
