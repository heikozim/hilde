-- Binds the poller of the runtime.  It reaches C with @embed and holds the
-- runtime's handle as a pointer, so it is an unsafe module; Standard.Poller
-- is the safe module built on it.
pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    Address,
    nullCheck
);

module body Bindings.Poller is
    function backendCode(): Int32 is
        return @embed(Int32, "hilde_poller_backend()");
    end;

    record Handle: Linear is
        -- The backend's own state.  Nat8 because Hilde has no type shaped
        -- like void, and nothing here ever loads through it.
        state: Pointer[Nat8];
    end;

    function createHandle(): Option[Handle] is
        let address: Address[Nat8] := @embed(Address[Nat8], "hilde_poller_create()");
        case nullCheck(address) of
            when Some(value as state: Pointer[Nat8]) do
                let some: Option[Handle] := Some(value => Handle(state => state));
                return some;
            when None do
                let none: Option[Handle] := None();
                return none;
        end case;
    end;

    function destroyHandle(handle: Handle): Unit is
        let { state: Pointer[Nat8] } := handle;
        @embed(Unit, "hilde_poller_destroy($1)", state);
        return nil;
    end;

    generic [R: Region]
    function addDescriptor(handle: &![Handle, R], descriptor: Int32, bits: Int32): Bool is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Int32, "hilde_poller_add($1, $2, $3)", state, descriptor, bits) = 1;
    end;

    generic [R: Region]
    function modifyDescriptor(handle: &![Handle, R], descriptor: Int32, bits: Int32): Bool is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Int32, "hilde_poller_modify($1, $2, $3)", state, descriptor, bits) = 1;
    end;

    generic [R: Region]
    function dropDescriptor(handle: &![Handle, R], descriptor: Int32): Bool is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Int32, "hilde_poller_drop($1, $2)", state, descriptor) = 1;
    end;

    generic [R: Region]
    function registeredCount(handle: &[Handle, R]): Index is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Index, "hilde_poller_registered($1)", state);
    end;

    generic [R: Region]
    function waitHandle(handle: &![Handle, R], timeoutMillis: Int32): Int32 is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Int32, "hilde_poller_wait($1, $2)", state, timeoutMillis);
    end;

    generic [R: Region]
    function eventDescriptorAt(handle: &[Handle, R], index: Index): Int32 is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Int32, "hilde_poller_event_fd($1, $2)", state, index);
    end;

    generic [R: Region]
    function eventFlagsAt(handle: &[Handle, R], index: Index): Int32 is
        let state: Pointer[Nat8] := handle->state;
        return @embed(Int32, "hilde_poller_event_flags($1, $2)", state, index);
    end;
end module body.
