"""
Binds the reading of numbers from little endian bytes and their splitting into bytes, with @embed in plain C.

- It reaches C with @embed, so it is an unsafe module.
- Standard.Array is the safe module built on it, and the one a programme imports.
- A load needs the whole number inside the span, which its requires states.
- A number is split into bytes one at a time, so this module never writes memory.
- The byte order is little endian on every host, and a float keeps its bits, a NaN included.

    let x: Float64 := loadFloat64(bytes, 8);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Array is
    """
    The Float64 whose eight little endian bytes start at the byte offset at.
    The caller keeps the whole number inside bytes.
    """
    generic [R: Region]
    function loadFloat64(bytes: Span[Nat8, R], at: Index): Float64
        requires (spanLength(bytes) >= 8) and (at <= (spanLength(bytes) - 8));

    """
    The Float32 whose four little endian bytes start at the byte offset at.
    The caller keeps the whole number inside bytes.
    """
    generic [R: Region]
    function loadFloat32(bytes: Span[Nat8, R], at: Index): Float32
        requires (spanLength(bytes) >= 4) and (at <= (spanLength(bytes) - 4));

    """
    The Int64 whose eight little endian bytes start at the byte offset at.
    The caller keeps the whole number inside bytes.
    """
    generic [R: Region]
    function loadInt64(bytes: Span[Nat8, R], at: Index): Int64
        requires (spanLength(bytes) >= 8) and (at <= (spanLength(bytes) - 8));

    """
    The Int32 whose four little endian bytes start at the byte offset at.
    The caller keeps the whole number inside bytes.
    """
    generic [R: Region]
    function loadInt32(bytes: Span[Nat8, R], at: Index): Int32
        requires (spanLength(bytes) >= 4) and (at <= (spanLength(bytes) - 4));

    """
    Byte k of the eight little endian bytes of value, k = 0 the lowest.
    A float gives the bytes of its bits.
    """
    function float64Byte(value: Float64, k: Index): Nat8
        requires k <= 7;

    """
    Byte k of the four little endian bytes of value, k = 0 the lowest.
    A float gives the bytes of its bits.
    """
    function float32Byte(value: Float32, k: Index): Nat8
        requires k <= 3;

    """
    Byte k of the eight little endian bytes of value, k = 0 the lowest.
    A float gives the bytes of its bits.
    """
    function int64Byte(value: Int64, k: Index): Nat8
        requires k <= 7;

    """
    Byte k of the four little endian bytes of value, k = 0 the lowest.
    A float gives the bytes of its bits.
    """
    function int32Byte(value: Int32, k: Index): Nat8
        requires k <= 3;
end module.
