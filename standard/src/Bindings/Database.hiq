-- An unsafe module: it ends a linear value's life in C before it stops
-- the programme, and it keeps a value in a box of bytes that it casts back
-- to the type its caller names.
pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    Address,
    allocate,
    nullCheck,
    load,
    store,
    deallocate,
    pointerCast
);

module body Bindings.Database is
    generic [T: Type]
    function abandon(value: T, message: Span[Nat8, Static]): Never is
        @embed(Unit, "((void)sizeof($1))", value);
        abort(message);
    end;

    record Erased: Linear is
        -- The box, typed as bytes: the holder does not name the type.
        handle: Pointer[Nat8];
    end;

    generic [T: Type]
    function erase(value: T): Erased is
        let addr: Address[T] := allocate();
        case nullCheck(addr) of
            when Some(value as box: Pointer[T]) do
                store(box, value);
                let bytes: Pointer[Nat8] := pointerCast(box);
                return Erased(handle => bytes);
            when None do
                abandon(value, "Bindings.Database.erase: out of memory");
        end case;
    end;

    generic [T: Type]
    function unerase(erased: Erased): T is
        let { handle: Pointer[Nat8] } := erased;
        let box: Pointer[T] := pointerCast(handle);
        let value: T := load(box);
        deallocate(box);
        return value;
    end;

    generic [T: Type, R: Region]
    function reveal(erased: &[Erased, R]): &[T, R] is
        let handle: Pointer[Nat8] := erased->handle;
        return @embed(&[T, R], "((void *) $1)", handle);
    end;

    generic [T: Type, R: Region]
    function revealWrite(erased: &![Erased, R]): &![T, R] is
        let handle: Pointer[Nat8] := erased->handle;
        return @embed(&![T, R], "((void *) $1)", handle);
    end;
end module body.
