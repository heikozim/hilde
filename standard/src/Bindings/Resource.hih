"""
Binds the resource calls of the runtime in lib/prelude.c: limits, usage and the boot clock.

- It reaches C with @embed, so it is an unsafe module; Standard.Resource is the safe module built on it.
- The calls are getrlimit(2), setrlimit(2), getrusage(2) and the clock since the system started.
- A resource is an index: 0 the data segment, 1 open files, 2 the size of a core file.
- No limit is the largest Nat64.
- A refusal of the kernel gives None or false; nothing aborts.
- CPU time is counted in microseconds, the largest resident set in bytes.

    let files: Option[LimitPair] := limitOf(1);
    let raised: Bool := setLimitOf(1, 4096, 4096);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Resource is
    """
    A soft and a hard limit.
    """
    record LimitPair: Free is
        soft: Nat64;
        hard: Nat64;
    end;

    """
    The limits of which, with getrlimit(2).  None when which is no
    resource or the kernel refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function limitOf(which: Nat32): Option[LimitPair];

    """
    Sets the limits of which with setrlimit(2).  True on success; false
    when which is no resource, soft is above hard, a value is one no limit
    can have, or the kernel refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function setLimitOf(which: Nat32, soft: Nat64, hard: Nat64): Bool;

    """
    What getrusage(2) says of the process: CPU time in microseconds, in
    the process and in the kernel for it, and the largest resident set in
    bytes.
    """
    record UsageNumbers: Free is
        userMicros: Nat64;
        systemMicros: Nat64;
        peakBytes: Nat64;
    end;

    """
    The usage of the process, or None when the kernel refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function usageNumbers(): Option[UsageNumbers];

    """
    Nanoseconds since the system started, time asleep included, or -1
    where there is no such clock.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function bootNanos(): Int64;
end module.
