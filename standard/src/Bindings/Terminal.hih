"""
Binds the standard streams of libc, stdin, stdout and stderr, through the runtime in lib/prelude.c.

- It reaches C with @embed and imports C functions, so it is an unsafe module.
- Standard.IO.Terminal is the safe module built on it, and the one a programme imports.
- Bytes go one at a time through the streams of libc; writeStderrText writes with write(2).
- A terminal is named by the number of its descriptor.

    if isTerminalNumber(0) then
        let quiet: Bool := setEcho(0, false);
    end if;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Terminal is
    """
    Writes one byte to the standard output.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function writeStdout(byte: Nat8): Unit;

    """
    Writes one byte to the standard error.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function writeStderr(byte: Nat8): Unit;

    """
    Reads one byte from the standard input, or None at its end.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function readStdin(): Option[Nat8];

    """
    Writes text to the standard error with write(2), after what the stream
    of libc still holds.  Returns false when the kernel refused a write.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function writeStderrText(text: Span[Nat8, R]): Bool;

    """
    Whether the descriptor fd is a terminal.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function isTerminalNumber(fd: Int32): Bool;

    """
    Switches the echo of the terminal at fd on or off, the echo of the
    line feed with it.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function setEcho(fd: Int32, on: Bool): Bool;

    """
    The columns of the terminal at fd, or 0 when it is none or does not
    say.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function widthOf(fd: Int32): Nat32;

    """
    Drops what waits to be read on the terminal at fd.  True on success,
    and for an fd that is no terminal.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function drainNumber(fd: Int32): Bool;
end module.
