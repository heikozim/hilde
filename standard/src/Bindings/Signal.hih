"""
Binds the signal handling of the runtime in lib/prelude.c, with alarm(2), getpid(2) and kill(2).

- It reaches C with @embed, so it is an unsafe module; Standard.Signal is the safe module built on it.
- The handler counts signals and writes a byte to a pipe of the runtime.
- A kind is an index: 0 hangup, 1 interrupt, 2 terminate, 3 user1, 4 user2.
- One watch is in place at a time; a second watchMask fails and installs nothing.
- The counts go on from one watch to the next.

    if watchMask(7) then
        let woken: Bool := waitPipe(1000);
        let stops: Nat32 := arrivals(2);
    end if;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Signal is
    """
    Installs the handler for the kinds whose bits are set in mask, bit 0
    for kind 0 and so on.  True on success; false when a watch is in
    place already or the kernel refused, and then nothing is installed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function watchMask(mask: Nat8): Bool;

    """
    How often kind arrived since the process started, counting on from
    one watch to the next.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function arrivals(kind: Nat8): Nat32;

    """
    Waits until the runtime's pipe holds a byte or milliseconds have
    passed, then empties the pipe.  True when a byte was there.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function waitPipe(milliseconds: Nat32): Bool;

    """
    Empties the runtime's pipe without waiting.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function drainPipe(): Unit;

    """
    Gives every watched kind its default action again.  True when the
    kernel took each one back.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function stopMask(): Bool;

    """
    alarm(2): the seconds left of the alarm set before.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function setAlarm(seconds: Nat32): Nat32;

    """
    getpid(2).
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function currentProcess(): Int32;

    """
    kill(2) with the signal of kind to process.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function sendTo(process: Int32, kind: Nat8): Bool;
end module.
