"""
Binds ML-DSA of FIPS 204 from the libcrux code the compiler carries, the backend of Standard.MlDsa.

- It calls C with @embed, so it is an unsafe module.
- Standard.MlDsa is the safe module built on it, and the one a programme imports.
- The same portable C runs on every system, with no library to link.
- The libcrux code is a stopgap: once LibreSSL offers ML-DSA natively, this backend moves to libcrypto and the libcrux code is removed.
- Every length is checked here before C reads a byte; a wrong one gives None or false.
- A level is 44, 65 or 87; any other gives None, false or 0.
- In a task with too little stack left a call gives None or false instead of running past the guard pages.

    let made: Option[KeyBytes] := keypair(44, asSpan(&seed));
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.MlDsa is
    """
    The public key and the expanded secret key of FIPS 204 made from one
    seed.  The secret is wiped when the record is taken apart by
    Standard.MlDsa.
    """
    record KeyBytes: Linear is
        public: String;
        secret: String;
    end;

    """
    The bytes of a public key of the level, or 0 for an unknown level.
    """
    function publicBytes(level: Int32): Index
        ensures (result = 0) or ((result >= 1312) and (result <= 2592));

    """
    The bytes of an expanded secret key of the level, or 0.
    """
    function secretBytes(level: Int32): Index
        ensures (result = 0) or ((result >= 2560) and (result <= 4896));

    """
    The bytes of a signature of the level, or 0.
    """
    function signatureBytes(level: Int32): Index
        ensures (result = 0) or ((result >= 2420) and (result <= 4627));

    """
    ML-DSA.KeyGen_internal: the key pair of seed, which must be 32 bytes.
    None for an unknown level or a seed of another length.
    No contract: the result is an Option, and every input is checked here.
    """
    generic [S: Region]
    function keypair(level: Int32, seed: Span[Nat8, S]): Option[KeyBytes];

    """
    ML-DSA.Sign, the pure form: the signature of message with context, at
    most 255 bytes, under the expanded secret key, with randomness, 32
    bytes, of which 32 zero bytes give the deterministic variant.  None
    for an unknown level or any length that does not fit.
    No contract: the result is an Option, and every input is checked here.
    """
    generic [K: Region, M: Region, C: Region, N: Region]
    function sign(level: Int32, secret: Span[Nat8, K], message: Span[Nat8, M], context: Span[Nat8, C], randomness: Span[Nat8, N]): Option[String];

    """
    ML-DSA.Verify, the pure form: whether signature is one of message with
    context under the public key.  False for an unknown level or any
    length that does not fit.
    No contract: every input is allowed, a wrong length is an answer.
    """
    generic [P: Region, M: Region, C: Region, G: Region]
    function verify(level: Int32, public: Span[Nat8, P], message: Span[Nat8, M], context: Span[Nat8, C], signature: Span[Nat8, G]): Bool;
end module.
