"""
Binds the reading of the bits of a number as a number of another type of the same width, in C.

- It reaches C with @embed, so it is an unsafe module.
- Standard.Bits is the safe module built on it, and the one a programme imports.
- Every bit pattern is kept: nothing is rounded, and a NaN keeps its payload.

    let bits: Nat64 := float64Bits(1.0);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Bits is
    """
    The 64 bits of a binary64 floating point number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function float64Bits(value: Float64): Nat64;

    """
    The binary64 floating point number of 64 bits.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function float64FromBits(bits: Nat64): Float64;

    """
    The 32 bits of a binary32 floating point number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function float32Bits(value: Float32): Nat32;

    """
    The binary32 floating point number of 32 bits.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function float32FromBits(bits: Nat32): Float32;

    """
    The 64 bits of a two's complement integer.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function int64Bits(value: Int64): Nat64;

    """
    The two's complement integer of 64 bits.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function int64FromBits(bits: Nat64): Int64;

    """
    The 32 bits of a two's complement integer.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function int32Bits(value: Int32): Nat32;

    """
    The two's complement integer of 32 bits.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function int32FromBits(bits: Nat32): Int32;
end module.
