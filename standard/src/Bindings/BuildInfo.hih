"""
Binds what the compiler writes into the C of the programme about its build.

- It reaches C with @embed, so it is an unsafe module.
- Standard.BuildInfo is the safe module built on it, and the one a programme imports.
- The texts are C strings of the programme's data, so their spans live as long as the programme.

    let hash: Span[Nat8, Static] := commitText();
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.BuildInfo is
    """
    The commit of the work tree the programme was compiled in, in hex, or
    an empty span when git gave none.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function commitText(): Span[Nat8, Static];

    """
    One when git listed changes against the commit, else zero.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function dirtyFlag(): Int32;

    """
    The time of the build in seconds since 1970.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function buildSeconds(): Int64;

    """
    The version of the compiler that built the programme.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function compilerText(): Span[Nat8, Static];

    """
    How many values were given with --build-value.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function valueTotal(): Index;

    """
    The name of the value at the position, counted from zero in the order
    they were given.  The position is below valueTotal: the C reads past
    the table otherwise, and Standard.BuildInfo requires it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function nameAt(index: Index): Span[Nat8, Static];

    """
    The text of the value at the position, which is below valueTotal.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function textAt(index: Index): Span[Nat8, Static];
end module.
