pragma Unsafe_Module;

module body Bindings.Signal is
    function watchMask(mask: Nat8): Bool is
        return @embed(Int32, "hilde_signal_watch($1)", mask) = 1;
    end;

    function arrivals(kind: Nat8): Nat32 is
        return @embed(Nat32, "hilde_signal_count($1)", kind);
    end;

    function waitPipe(milliseconds: Nat32): Bool is
        return @embed(Int32, "hilde_signal_wait($1)", milliseconds) = 1;
    end;

    function drainPipe(): Unit is
        @embed(Unit, "hilde_signal_drain()");
        return nil;
    end;

    function stopMask(): Bool is
        return @embed(Int32, "hilde_signal_stop()") = 1;
    end;

    function setAlarm(seconds: Nat32): Nat32 is
        return @embed(Nat32, "hilde_signal_alarm($1)", seconds);
    end;

    function currentProcess(): Int32 is
        return @embed(Int32, "hilde_process_number()");
    end;

    function sendTo(process: Int32, kind: Nat8): Bool is
        return @embed(Int32, "hilde_signal_send($1, $2)", process, kind) = 1;
    end;
end module body.
