"""
Binds the lookup of an account in the password database and the effective user of the process, from the runtime.

- It reaches C with @embed, so it is an unsafe module.
- Standard.Account is the safe module built on it, and the one a programme imports.
- A name longer than 255 bytes or holding a zero byte is not looked up.

    let user: Int64 := accountNumber("_notes", false);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Account is
    """
    The user number of the account name, or with group true its group
    number: -1 when there is no such account or the name cannot be one,
    -2 when the lookup failed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function accountNumber(name: Span[Nat8, R], group: Bool): Int64;

    """
    The effective user number of the process.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function effectiveUser(): Nat32;
end module.
