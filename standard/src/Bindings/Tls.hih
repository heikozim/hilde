"""
Binds libtls, the TLS library of OpenBSD and, as libretls over OpenSSL, of Debian.

- It hands addresses to C through the declarations in Bindings.C.Tls, so it is an unsafe module.
- Standard.Tls is the safe module built on it, and the one a programme imports.
- Each function here is the one of Standard.Tls with the same name, except connectSocket and connectSocketAs.
- connectSocket is the half of Standard.Tls.connectOver that works on the socket's number.
- A socket handed to connectSocket or acceptSocket stays open when the client is closed.
- A failure comes back as a String with the message.

    let client: Either[String, Client] := connect("example.org", "443", "/etc/ssl/cert.pem");
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Tls is
    type Client: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [H: Region, P: Region, C: Region]
    function connect(host: Span[Nat8, H], port: Span[Nat8, P], caFile: Span[Nat8, C]): Either[String, Client];

    """
    Sets the connected socket number to non-blocking and completes the
    handshake over it within milliseconds, verifying the server's
    certificate against the certificates in caFile and against host.  The
    socket stays open when the client is closed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [H: Region, C: Region]
    function connectSocket(number: Int32, host: Span[Nat8, H], caFile: Span[Nat8, C], milliseconds: Nat32): Either[String, Client];

    """
    connect and connectSocket, presenting the certificate in
    certificateFile with the key in keyFile to the server.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [H: Region, P: Region, C: Region, E: Region, K: Region]
    function connectAs(host: Span[Nat8, H], port: Span[Nat8, P], caFile: Span[Nat8, C], certificateFile: Span[Nat8, E], keyFile: Span[Nat8, K]): Either[String, Client];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [H: Region, C: Region, E: Region, K: Region]
    function connectSocketAs(number: Int32, host: Span[Nat8, H], caFile: Span[Nat8, C], certificateFile: Span[Nat8, E], keyFile: Span[Nat8, K], milliseconds: Nat32): Either[String, Client];

    """
    connectSocketAs, limited to TLS 1.3: a server that offers less is refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [H: Region, C: Region, E: Region, K: Region]
    function connectSocketAsTls13(number: Int32, host: Span[Nat8, H], caFile: Span[Nat8, C], certificateFile: Span[Nat8, E], keyFile: Span[Nat8, K], milliseconds: Nat32): Either[String, Client];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function send(client: &![Client, R], data: Span[Nat8, S]): Either[String, Unit];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function receive(client: &![Client, R], most: Index): Either[String, String];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function sendWithin(client: &![Client, R], data: Span[Nat8, S], milliseconds: Nat32): Either[String, Unit];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function receiveWithin(client: &![Client, R], most: Index, milliseconds: Nat32): Either[String, String];

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeClient(client: Client): Unit;

    type Server: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [C: Region, K: Region]
    function makeServer(certificateFile: Span[Nat8, C], keyFile: Span[Nat8, K]): Either[String, Server];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [C: Region, K: Region]
    function makeServerFromMemory(certificate: Span[Nat8, C], key: Span[Nat8, K]): Either[String, Server];

    """
    Sets the connected socket number to non-blocking and completes the
    server's handshake over it within milliseconds.  The socket stays open
    when the connection is closed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function acceptSocket(server: &[Server, R], number: Int32, milliseconds: Nat32): Either[String, Client];

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeServer(server: Server): Unit;

    """
    makeServer and makeServerFromMemory with clients that must present a
    certificate the certificates in clientCaFile, or clientCa, verify.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [C: Region, K: Region, A: Region]
    function makeVerifyingServer(certificateFile: Span[Nat8, C], keyFile: Span[Nat8, K], clientCaFile: Span[Nat8, A]): Either[String, Server];
    """
    makeVerifyingServer, limited to TLS 1.3: a client that offers less is refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [C: Region, K: Region, A: Region]
    function makeVerifyingServerTls13(certificateFile: Span[Nat8, C], keyFile: Span[Nat8, K], clientCaFile: Span[Nat8, A]): Either[String, Server];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [C: Region, K: Region, A: Region]
    function makeVerifyingServerFromMemory(certificate: Span[Nat8, C], key: Span[Nat8, K], clientCa: Span[Nat8, A]): Either[String, Server];

    """
    What a connection knows of its peer's certificate: whether there is
    one, its subject and the hash libtls gives, SHA256: and hexadecimal
    digits.  None where there is no certificate.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function peerCertificateProvided(client: &[Client, R]): Bool;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function peerSubject(client: &[Client, R]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function peerHash(client: &[Client, R]): Option[String];
end module.
