-- Each function is one call of a routine of mircoblis against
-- mirco_lapack.h.  The routines take every argument by address, so a number
-- is handed over as a compound literal, and info is written into info[0]
-- and returned.  Before a call each span is held to the size the routine
-- will touch; a span too short gives -1000 and no call.  A work array of
-- lwork -1 is the query of its size and needs one element; for dgesdd and
-- dgelsd lwork is the length of work, and one element is the query, since
-- an embedded call names at most nine arguments.
pragma Unsafe_Module;
pragma Foreign_Library(Name => "mircoblis");
pragma Foreign_Header(Name => "mirco_lapack.h");

module body Bindings.Lapack is
    generic [R: Region, S: Region, Q: Region, I: Region]
    function gesv(n: Int32, nrhs: Int32, a: Span![Float64, R], pivots: Span![Int32, S], b: Span![Float64, Q], info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $2 < 1 || $6.size < 1 || $3.size < (size_t) $1 * (size_t) $1 || $4.size < (size_t) $1 || $5.size < (size_t) $1 * (size_t) $2) ? -1000 : (dgesv_(&(int){ $1 }, &(int){ $2 }, (double*) $3.data, &(int){ $1 }, (int*) $4.data, (double*) $5.data, &(int){ $1 }, (int*) $6.data), ((int*) $6.data)[0]))", n, nrhs, a, pivots, b, info);
    end;

    generic [R: Region, S: Region, I: Region]
    function getrf(m: Int32, n: Int32, a: Span![Float64, R], pivots: Span![Int32, S], info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $2 < 1 || $5.size < 1 || $3.size < (size_t) $1 * (size_t) $2 || $4.size < (size_t) ($1 < $2 ? $1 : $2)) ? -1000 : (dgetrf_(&(int){ $1 }, &(int){ $2 }, (double*) $3.data, &(int){ $1 }, (int*) $4.data, (int*) $5.data), ((int*) $5.data)[0]))", m, n, a, pivots, info);
    end;

    generic [R: Region, I: Region]
    function potrf(n: Int32, a: Span![Float64, R], info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $3.size < 1 || $2.size < (size_t) $1 * (size_t) $1) ? -1000 : (dpotrf_((char[]){ 76, 0 }, &(int){ $1 }, (double*) $2.data, &(int){ $1 }, (int*) $3.data), ((int*) $3.data)[0]))", n, a, info);
    end;

    generic [R: Region, S: Region, Q: Region, I: Region]
    function geqrf(m: Int32, n: Int32, a: Span![Float64, R], tau: Span![Float64, S], work: Span![Float64, Q], lwork: Int32, info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $2 < 1 || $7.size < 1 || $3.size < (size_t) $1 * (size_t) $2 || $4.size < (size_t) ($1 < $2 ? $1 : $2) || $5.size < 1 || ($6 != -1 && ($6 < 1 || $5.size < (size_t) $6))) ? -1000 : (dgeqrf_(&(int){ $1 }, &(int){ $2 }, (double*) $3.data, &(int){ $1 }, (double*) $4.data, (double*) $5.data, &(int){ $6 }, (int*) $7.data), ((int*) $7.data)[0]))", m, n, a, tau, work, lwork, info);
    end;

    generic [R: Region, S: Region, Q: Region, I: Region]
    function orgqr(m: Int32, n: Int32, k: Int32, a: Span![Float64, R], tau: Span![Float64, S], work: Span![Float64, Q], lwork: Int32, info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($2 < 1 || $1 < $2 || $3 < 0 || $3 > $2 || $8.size < 1 || $4.size < (size_t) $1 * (size_t) $2 || $5.size < (size_t) $3 || $6.size < 1 || ($7 != -1 && ($7 < 1 || $6.size < (size_t) $7))) ? -1000 : (dorgqr_(&(int){ $1 }, &(int){ $2 }, &(int){ $3 }, (double*) $4.data, &(int){ $1 }, (double*) $5.data, (double*) $6.data, &(int){ $7 }, (int*) $8.data), ((int*) $8.data)[0]))", m, n, k, a, tau, work, lwork, info);
    end;

    generic [R: Region, S: Region, Q: Region, P: Region, I: Region]
    function syevd(n: Int32, a: Span![Float64, R], w: Span![Float64, S], work: Span![Float64, Q], lwork: Int32, iwork: Span![Int32, P], liwork: Int32, info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $8.size < 1 || $2.size < (size_t) $1 * (size_t) $1 || $3.size < (size_t) $1 || $4.size < 1 || $6.size < 1 || ($5 != -1 && ($5 < 1 || $4.size < (size_t) $5)) || ($7 != -1 && ($7 < 1 || $6.size < (size_t) $7))) ? -1000 : (dsyevd_((char[]){ 86, 0 }, (char[]){ 76, 0 }, &(int){ $1 }, (double*) $2.data, &(int){ $1 }, (double*) $3.data, (double*) $4.data, &(int){ $5 }, (int*) $6.data, &(int){ $7 }, (int*) $8.data), ((int*) $8.data)[0]))", n, a, w, work, lwork, iwork, liwork, info);
    end;

    generic [R: Region, S: Region, Q: Region, P: Region, O: Region, N: Region, I: Region]
    function gesdd(m: Int32, n: Int32, a: Span![Float64, R], s: Span![Float64, S], u: Span![Float64, Q], vt: Span![Float64, P], work: Span![Float64, O], iwork: Span![Int32, N], info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $2 < 1 || $9.size < 1 || $3.size < (size_t) $1 * (size_t) $2 || $4.size < (size_t) ($1 < $2 ? $1 : $2) || $5.size < (size_t) $1 * (size_t) ($1 < $2 ? $1 : $2) || $6.size < (size_t) ($1 < $2 ? $1 : $2) * (size_t) $2 || $8.size < 8 * (size_t) ($1 < $2 ? $1 : $2) || $7.size < 1 || $7.size > 2147483647) ? -1000 : (dgesdd_((char[]){ 83, 0 }, &(int){ $1 }, &(int){ $2 }, (double*) $3.data, &(int){ $1 }, (double*) $4.data, (double*) $5.data, &(int){ $1 }, (double*) $6.data, &(int){ $1 < $2 ? $1 : $2 }, (double*) $7.data, &(int){ $7.size == 1 ? -1 : (int) $7.size }, (int*) $8.data, (int*) $9.data), ((int*) $9.data)[0]))", m, n, a, s, u, vt, work, iwork, info);
    end;

    -- The integer work of dgelsd is at most 3 min(m, n) nlvl + 11 min(m, n)
    -- with nlvl below 64, so a span of 203 min(m, n) is always enough.
    generic [R: Region, S: Region, Q: Region, O: Region, N: Region, I: Region]
    function gelsd(m: Int32, n: Int32, a: Span![Float64, R], b: Span![Float64, S], s: Span![Float64, Q], work: Span![Float64, O], iwork: Span![Int32, N], info: Span![Int32, I]): Int32 is
        return @embed(Int32, "(int32_t) (($1 < 1 || $2 < 1 || $8.size < 2 || $3.size < (size_t) $1 * (size_t) $2 || $4.size < (size_t) ($1 > $2 ? $1 : $2) || $5.size < (size_t) ($1 < $2 ? $1 : $2) || $7.size < 203 * (size_t) ($1 < $2 ? $1 : $2) || $6.size < 1 || $6.size > 2147483647) ? -1000 : (dgelsd_(&(int){ $1 }, &(int){ $2 }, &(int){ 1 }, (double*) $3.data, &(int){ $1 }, (double*) $4.data, &(int){ $1 > $2 ? $1 : $2 }, (double*) $5.data, &(double){ -1.0 }, (int*) $8.data + 1, (double*) $6.data, &(int){ $6.size == 1 ? -1 : (int) $6.size }, (int*) $7.data, (int*) $8.data), ((int*) $8.data)[0]))", m, n, a, b, s, work, iwork, info);
    end;

    generic [R: Region, S: Region, Q: Region]
    function gemm(m: Int32, n: Int32, k: Int32, a: Span[Float64, R], b: Span[Float64, S], c: Span![Float64, Q]): Unit is
        return @embed(Unit, "(($1 < 1 || $2 < 1 || $3 < 1 || $4.size < (size_t) $1 * (size_t) $3 || $5.size < (size_t) $3 * (size_t) $2 || $6.size < (size_t) $1 * (size_t) $2) ? (hilde_unit_t) 0 : (dgemm_((const char[]){ 78, 0 }, (const char[]){ 78, 0 }, &(int){ $1 }, &(int){ $2 }, &(int){ $3 }, &(double){ 1.0 }, (const double*) $4.data, &(int){ $1 }, (const double*) $5.data, &(int){ $3 }, &(double){ 0.0 }, (double*) $6.data, &(int){ $1 }), (hilde_unit_t) 0))", m, n, k, a, b, c);
    end;

    generic [R: Region, S: Region, Q: Region]
    function gemmScaled(m: Int32, n: Int32, k: Int32, alpha: Float64, a: Span[Float64, R], b: Span[Float64, S], beta: Float64, c: Span![Float64, Q]): Unit is
        return @embed(Unit, "(($1 < 1 || $2 < 1 || $3 < 1 || $5.size < (size_t) $1 * (size_t) $3 || $6.size < (size_t) $3 * (size_t) $2 || $8.size < (size_t) $1 * (size_t) $2) ? (hilde_unit_t) 0 : (dgemm_((const char[]){ 78, 0 }, (const char[]){ 78, 0 }, &(int){ $1 }, &(int){ $2 }, &(int){ $3 }, &(double){ $4 }, (const double*) $5.data, &(int){ $1 }, (const double*) $6.data, &(int){ $3 }, &(double){ $7 }, (double*) $8.data, &(int){ $1 }), (hilde_unit_t) 0))", m, n, k, alpha, a, b, beta, c);
    end;
end module body.
