--
-- Bindings.Sqlite: the length a text, a blob or a key may have before it
-- is refused with SQLITE_TOOBIG.  The line lies at 2^31 bytes, where an
-- Int32 ends; a value there needs gigabytes of memory, so the line is held
-- here on the function that draws it.
import Bindings.Sqlite (
    valueLength
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.Bindings.Sqlite.Test is
    constant refused: Int64 := -1;

    -- The length as SQLite counts it, or refused.
    function counted(size: Index): Int64 is
        case valueLength(size) of
            when Some(value as length: Int32) do
                case toInt64(length) of
                    when Some(value as wide: Int64) do
                        return wide;
                    when None do
                        return refused;
                end case;
            when None do
                return refused;
        end case;
    end;

    function testValueLength(): Unit is
        let empty: Index := 0;
        let largest: Index := 2147483647;
        let first: Index := 2147483648;
        let wrap: Index := 4294967296;
        let zero: Int64 := 0;
        let largestCount: Int64 := 2147483647;
        assertTrue(counted(empty) = zero, "an empty value is counted as 0");
        assertTrue(counted(largest) = largestCount, "2^31 - 1 bytes are counted as they are");
        assertTrue(counted(first) = refused, "2^31 bytes are refused, not stopped on");
        assertTrue(counted(maximum_index) = refused, "the largest Index is refused");
        assertFalse(counted(wrap) = zero, "2^32 does not wrap round to 0");
        return nil;
    end;
end module body.
