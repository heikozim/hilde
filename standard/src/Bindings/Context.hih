"""
Binds what Standard.Context needs of the kernel and the runtime: pipes and a chain to wait on.

- The chain of reading ends lives in lib/prelude.c, and a context waits on it with poll(2).
- Both ends of a new pipe are close-on-exec.
- It hands addresses to C, so it is an unsafe module.
- Standard.Context is the safe module built on it, and the one a programme imports.

    let root: Node := emptyNode();
    let ready: Int32 := nodeReady(&root, 0);
    releaseNode(root);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Context is
    """
    The two ends of a new pipe, read end first, both close-on-exec.
    """
    record Ends: Free is
        reading: Int32;
        writing: Int32;
    end;

    """
    One level of a chain: a reading end and a reference to the level
    above.  Linear: releaseNode gives it back.
    """
    type Node: Linear;

    """
    A new pipe, or None when the kernel refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function openEnds(): Option[Ends];

    """
    Closes the descriptor.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeNumber(number: Int32): Unit;

    """
    The empty chain, which holds no descriptor and is never ready.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function emptyNode(): Node;

    """
    A level for reading below parent, which then stays until this level
    is released as well.  None when there is no memory, and then reading
    is not taken and stays the caller's to close.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function nodeBelow(reading: Int32, parent: &[Node, R]): Option[Node];

    """
    Gives the level back.  The last level that refers to one above gives
    that one back too, and the last reference to a reading end closes it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function releaseNode(node: Node): Unit;

    """
    Waits at most milliseconds until a reading end of the chain can be
    read from or has hung up; 0 asks without waiting, -1 waits as long as
    it takes.  1 when one is ready, 0 when the time ran out, -1 when poll
    failed or there was no memory.  A signal restarts the wait.
    """
    generic [R: Region]
    function nodeReady(node: &[Node, R], milliseconds: Int32): Int32
        ensures (result >= -1) and (result <= 1);
end module.
