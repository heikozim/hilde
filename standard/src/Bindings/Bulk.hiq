-- Binds the bulk loops.  Each calls a loop of the runtime prelude over the
-- data of a span, with no check inside: the safe modules check the range
-- once, at the call, and the loop runs at the speed of C.  A count of 0
-- touches nothing, so the null data of an empty span is never offset.  It
-- reaches C with @embed, so it is an unsafe module; Standard.Bulk and
-- Standard.Raster are the safe modules built on it.
pragma Unsafe_Module;

module body Bindings.Bulk is
    generic [R: Region]
    function fillBytes(target: Span![Nat8, R], start: Index, count: Index, value: Nat8): Unit is
        @embed(Unit, "hilde_bulk_fill_bytes((uint8_t*)($1).data, ($2), ($3), (uint8_t)($4))", target, start, count, value);
        return nil;
    end;

    -- The value is copied from the parameter into each place, so that an
    -- element of any size and alignment is written whole.
    generic [T: Free, R: Region]
    function fillElements(target: Span![T, R], start: Index, count: Index, value: T): Unit is
        @embed(Unit, "hilde_bulk_fill_elements((unsigned char*)($1).data, ($2), ($3), &($4), sizeof($4))", target, start, count, value);
        return nil;
    end;

    generic [T: Free, S: Region, R: Region]
    function copyElements(source: Span[T, S], first: Index, target: Span![T, R], at: Index, count: Index): Unit is
        let size: ByteSize := sizeof(T);
        @embed(Unit, "hilde_bulk_copy_elements((const unsigned char*)($1).data, ($2), (unsigned char*)($3).data, ($4), ($5), ($6))", source, first, target, at, count, size);
        return nil;
    end;

    generic [R: Region]
    function fillPixels(pixels: Span![Nat8, R], width: Index, top: Index, bottom: Index, left: Index, right: Index, color: Nat32): Unit is
        @embed(Unit, "hilde_bulk_fill_pixels((uint8_t*)($1).data, ($2), ($3), ($4), ($5), ($6), (uint32_t)($7))", pixels, width, top, bottom, left, right, color);
        return nil;
    end;

    -- Each channel is (colour * c + old * (255 - c) + 127) / 255 with c the
    -- coverage times the alpha of the colour over 255; alpha itself goes
    -- towards 255 by c.  A coverage of 0 leaves the pixel as it is.
    generic [R: Region, M: Region]
    function blendCoverage(pixels: Span![Nat8, R], width: Index, x: Index, y: Index, mask: Span[Nat8, M], mask_width: Index, mx: Index, my: Index, w: Index, h: Index, color: Nat32): Unit is
        @embed(Unit, "hilde_bulk_blend_coverage((uint8_t*)($1).data, ($2), ($3), ($4), (const uint8_t*)($5).data, ($6), ($7), ($8), ($9), ($10), (uint32_t)($11))", pixels, width, x, y, mask, mask_width, mx, my, w, h, color);
        return nil;
    end;
end module body.
