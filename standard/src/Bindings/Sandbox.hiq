-- Binds the calls that confine the process through the runtime.  It hands
-- the kernel the address of a string's bytes, so it is an unsafe module;
-- Standard.Sandbox is the safe module built on it.
pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    spanToPointer
);
import Standard.String (
    String,
    length,
    nthByte,
    getSpan
);

module body Bindings.Sandbox is
    ---
    --- What is handed to C
    ---

    -- The number of zero bytes in the string.
    generic [R: Region]
    function zeroBytes(string: &[String, R]): Index is
        let size: Index := length(string);
        var count: Index := 0;
        if size > 0 then
            for i from 0 to size - 1 do
                if nthByte(string, i) = 0 then
                    count := count + 1;
                end if;
            end for;
        end if;
        return count;
    end;

    -- A string C may read: not empty, its last byte the zero byte that ends
    -- it, and no zero byte before that one.  C reads up to the first zero
    -- byte: a string without one at its end would be read past, and a zero
    -- byte inside would hand the kernel a shorter string than the one that
    -- was checked.
    generic [R: Region]
    function readable(string: &[String, R]): Bool is
        let size: Index := length(string);
        if size = 0 then
            return false;
        end if;
        if nthByte(string, size - 1) /= 0 then
            return false;
        end if;
        return zeroBytes(string) = 1;
    end;

    -- The address of the first byte.  Only called on a string that is not
    -- empty: the span [0, 0] names its first byte.
    generic [R: Region]
    function firstByte(string: &[String, R]): Pointer[Nat8] is
        return spanToPointer(getSpan(string, 0, 0));
    end;

    ---
    --- The runtime's functions, declared so that the C compiler holds each
    --- declaration against its definition in lib/prelude.c.
    ---

    pragma Foreign_Import(External_Name => "hilde_sandbox_platform");
    function cPlatform(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_set_no_new_privileges");
    function cSetNoNewPrivileges(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_query_no_new_privileges");
    function cQueryNoNewPrivileges(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_pledge");
    function cPledge(promises: Pointer[Nat8]): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_unveil");
    function cUnveil(path: Pointer[Nat8], permissions: Pointer[Nat8]): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_unveil_lock");
    function cUnveilLock(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_pledge_exec");
    function cPledgeExec(promises: Pointer[Nat8], withPromises: Int32,
        execPromises: Pointer[Nat8], withExec: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_unveil_probe");
    function cUnveilProbe(grants: Pointer[Nat8], size: Index, count: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_seatbelt");
    function cSeatbelt(grants: Pointer[Nat8], count: Int32, promises: Pointer[Nat8],
        withPromises: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_capsicum");
    function cCapsicum(grants: Pointer[Nat8], count: Int32, promises: Pointer[Nat8],
        withPromises: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_query_capsicum");
    function cQueryCapsicum(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_landlock_abi");
    function cLandlockAbi(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_landlock_open");
    function cLandlockOpen(abi: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_landlock_add");
    function cLandlockAdd(ruleset: Int32, abi: Int32, path: Pointer[Nat8], permissions: Pointer[Nat8]): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_landlock_restrict");
    function cLandlockRestrict(ruleset: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_landlock_close");
    function cLandlockClose(ruleset: Int32): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_seccomp");
    function cSeccomp(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_query_seccomp");
    function cQuerySeccomp(): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_sandbox_thread_count");
    function cThreadCount(): Int32 is
    end;

    ---
    --- The binding
    ---

    function platform(): Int32 is
        return cPlatform();
    end;

    function setNoNewPrivileges(): Int32 is
        return cSetNoNewPrivileges();
    end;

    function queryNoNewPrivileges(): Int32 is
        return cQueryNoNewPrivileges();
    end;

    generic [R: Region]
    function pledge(promises: &[String, R]): Int32 is
        if not readable(promises) then
            return 0;
        end if;
        return cPledge(firstByte(promises));
    end;

    generic [R: Region, S: Region]
    function unveil(path: &[String, R], permissions: &[String, S]): Int32 is
        if (not readable(path)) or (not readable(permissions)) then
            return 0;
        end if;
        return cUnveil(firstByte(path), firstByte(permissions));
    end;

    function lockUnveil(): Int32 is
        return cUnveilLock();
    end;

    function flag(set: Bool): Int32 is
        if set then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region, S: Region]
    function pledgeWithExec(promises: &[String, R], withPromises: Bool,
        execPromises: &[String, S], withExec: Bool): Int32 is
        if (not readable(promises)) or (not readable(execPromises)) then
            return 0;
        end if;
        return cPledgeExec(firstByte(promises), flag(withPromises),
            firstByte(execPromises), flag(withExec));
    end;

    -- Whether grants is count pairs for C to walk: not empty, its last byte
    -- a zero byte, and two zero bytes for each path, so that the walk ends
    -- inside the string.
    generic [R: Region]
    function packedPairs(grants: &[String, R], count: Index): Bool is
        let size: Index := length(grants);
        if (size = 0) or (count = 0) then
            return false;
        end if;
        if nthByte(grants, size - 1) /= 0 then
            return false;
        end if;
        return zeroBytes(grants) = (count * 2);
    end;

    generic [R: Region]
    function unveilProbe(grants: &[String, R], count: Index): Int32 is
        if not packedPairs(grants, count) then
            return -2;
        end if;
        case toInt32(count) of
            when Some(value as narrow: Int32) do
                return cUnveilProbe(firstByte(grants), length(grants), narrow);
            when None do
                return -2;
        end case;
    end;

    -- Whether grants is count pairs for C to walk, or with no path a single
    -- zero byte, so that C has a byte to be pointed at.
    generic [R: Region]
    function packedOrNone(grants: &[String, R], count: Index): Bool is
        if count = 0 then
            return (length(grants) = 1) and (nthByte(grants, 0) = 0);
        end if;
        return packedPairs(grants, count);
    end;

    generic [R: Region, S: Region]
    function seatbelt(grants: &[String, R], count: Index, promises: &[String, S], withPromises: Bool): Int32 is
        if (not packedOrNone(grants, count)) or (not readable(promises)) then
            return -2;
        end if;
        case toInt32(count) of
            when Some(value as narrow: Int32) do
                return cSeatbelt(firstByte(grants), narrow, firstByte(promises), flag(withPromises));
            when None do
                return -2;
        end case;
    end;

    generic [R: Region, S: Region]
    function capsicum(grants: &[String, R], count: Index, promises: &[String, S], withPromises: Bool): Int32 is
        if (not packedOrNone(grants, count)) or (not readable(promises)) then
            return -2;
        end if;
        case toInt32(count) of
            when Some(value as narrow: Int32) do
                return cCapsicum(firstByte(grants), narrow, firstByte(promises), flag(withPromises));
            when None do
                return -2;
        end case;
    end;

    function queryCapsicum(): Int32 is
        return cQueryCapsicum();
    end;

    function landlockAbi(): Int32 is
        return cLandlockAbi();
    end;

    function landlockOpen(abi: Int32): Int32 is
        return cLandlockOpen(abi);
    end;

    generic [R: Region, S: Region]
    function landlockAdd(ruleset: Int32, abi: Int32, path: &[String, R], permissions: &[String, S]): Int32 is
        if (not readable(path)) or (not readable(permissions)) then
            return 0;
        end if;
        return cLandlockAdd(ruleset, abi, firstByte(path), firstByte(permissions));
    end;

    function landlockRestrict(ruleset: Int32): Int32 is
        return cLandlockRestrict(ruleset);
    end;

    function landlockClose(ruleset: Int32): Int32 is
        return cLandlockClose(ruleset);
    end;

    function seccomp(): Int32 is
        return cSeccomp();
    end;

    function querySeccomp(): Int32 is
        return cQuerySeccomp();
    end;

    function threadCount(): Int32 is
        return cThreadCount();
    end;
end module body.
