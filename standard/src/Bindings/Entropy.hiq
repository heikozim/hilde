-- getentropy is declared inside the one C expression that calls it: which
-- header declares it, and under which feature macros, differs from system
-- to system (glibc wants _DEFAULT_SOURCE, which the runtime does not set),
-- while the function itself is the same, int getentropy(void *, size_t).
-- A declaration in block scope is plain C, and a second one that agrees
-- with a header's is allowed.  The braced group
-- is an extension of gcc and clang, and the keyword in front of it tells
-- both not to warn about it under the pedantic yardstick.
pragma Unsafe_Module;

module body Bindings.Entropy is
    function entropyWord(): Nat64 is
        return @embed(Nat64, "__extension__ ({ extern int getentropy(void *, size_t); uint64_t hilde_entropy_word = 0; (getentropy(&hilde_entropy_word, sizeof hilde_entropy_word) == 0) ? hilde_entropy_word : (uint64_t) 0; })");
    end;
end module body.
