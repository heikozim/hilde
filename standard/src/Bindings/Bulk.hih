"""
Binds the loops that fill, copy and blend a whole range of a span at once, with @embed in plain C.

- It reaches C with @embed, so it is an unsafe module.
- Standard.Bulk is the safe module built on it, and the one a programme imports; Standard.Raster stands on it too.
- No index is checked in here: the caller keeps every range inside its span, which the safe modules state as contracts.
- A copy may overlap its target: it moves the bytes as memmove does.

    fillBytes(&~target, 0, 64, 255);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Bulk is
    """
    Sets count bytes of target from start on to value.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function fillBytes(target: Span![Nat8, R], start: Index, count: Index, value: Nat8): Unit;

    """
    Sets count elements of target from start on to value.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Free, R: Region]
    function fillElements(target: Span![T, R], start: Index, count: Index, value: T): Unit;

    """
    Copies count elements of source from first on into target at at.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Free, S: Region, R: Region]
    function copyElements(source: Span[T, S], first: Index, target: Span![T, R], at: Index, count: Index): Unit;

    """
    Sets the pixels of the rows top up to bottom and the columns left up to
    right of a picture of width pixels a row, four bytes a pixel, to color,
    red in its highest byte and alpha in its lowest.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function fillPixels(pixels: Span![Nat8, R], width: Index, top: Index, bottom: Index, left: Index, right: Index, color: Nat32): Unit;

    """
    Blends color over the w by h pixels at column x and row y of a picture
    of width pixels a row, each pixel by the byte of mask at column mx plus
    its column and row my plus its row, a mask of mask_width bytes a row,
    times the alpha of color.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, M: Region]
    function blendCoverage(pixels: Span![Nat8, R], width: Index, x: Index, y: Index, mask: Span[Nat8, M], mask_width: Index, mx: Index, my: Index, w: Index, h: Index, color: Nat32): Unit;
end module.
