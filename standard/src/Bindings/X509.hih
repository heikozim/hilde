"""
Binds the X.509 and key functions of libcrypto that Standard.X509 needs.

- Every call is a C expression on the system's OpenSSL headers, held to its real prototype.
- It hands addresses to C, so it is an unsafe module.
- Standard.X509 is the safe module built on it, and the one a programme imports.
- Each function is the one of Standard.X509 its docstring names, on the raw numbers of the kinds.
- rsaBits takes only the three kinds of RSA; any other kind stops the programme.
- Kinds: 1 P-256, 2 P-384, 3 Ed25519, 4 to 6 RSA of 2048, 3072 and 4096 bits, 7 P-521.
- Kinds 8 to 10 are ML-DSA-44, -65 and -87; 0 stands for no kind.
- Key and Cert are linear: dropKey and dropCert free them.

    let key: Option[Key] := newKey(1);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.X509 is
    """
    A key of libcrypto, an EVP_PKEY.  Linear: dropKey frees it.
    """
    type Key: Linear;

    """
    A certificate of libcrypto, an X509.  Linear: dropCert frees it.
    """
    type Cert: Linear;

    """
    What readRequest gives: the key of a request whose signature holds, its
    common name and its DNS names separated by commas.
    """
    record Parts: Linear is
        key: Key;
        commonName: String;
        names: String;
    end;

    """
    generateKey; keyKindOf as a number, 0 for a kind of no number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function newKey(kind: Int32): Option[Key];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function kindOfKey(key: &[Key, R]): Int32;

    """
    The numbers of the three kinds of RSA, 4, 5 and 6.  A condition may not
    call a function of a binding module, so the requires of rsaBits names
    the numbers these ensures give.
    """
    function kindRsa2048(): Int32
        ensures result = 4;
    function kindRsa3072(): Int32
        ensures result = 5;
    function kindRsa4096(): Int32
        ensures result = 6;

    """
    The bits of an RSA kind: 2048, 3072 or 4096.  The kind must be
    kindRsa2048, kindRsa3072 or kindRsa4096; any other number stops the
    programme, there is no size to fall back on.
    """
    function rsaBits(kind: Int32): Int32
        requires ((kind = 4) or (kind = 5)) or (kind = 6)
        ensures ((result = 2048) or (result = 3072)) or (result = 4096);

    """
    privateKeyToPem, privateKeyFromPem, publicKeyDer, signMessage and
    verifyMessage.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function pemOfKey(key: &[Key, R]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function keyOfPem(pem: Span[Nat8, R]): Option[Key];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function publicDerOfKey(key: &[Key, R]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, M: Region]
    function signWith(key: &[Key, R], message: Span[Nat8, M]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [P: Region, M: Region, S: Region]
    function verify(publicDer: Span[Nat8, P], message: Span[Nat8, M], signature: Span[Nat8, S]): Bool;

    """
    publicKeyKind as a number, 0 for a key of no kind of this module or
    bytes that are no public key.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [P: Region]
    function kindOfPublicDer(publicDer: Span[Nat8, P]): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function dropKey(key: Key): Unit;

    """
    certificateFromPem, certificateFromDer, certificateToPem and
    certificateToDer.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function certOfPem(pem: Span[Nat8, R]): Option[Cert];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function certOfDer(der: Span[Nat8, R]): Option[Cert];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function pemOfCert(certificate: &[Cert, R]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function derOfCert(certificate: &[Cert, R]): Option[String];

    """
    subjectName, or issuerName when issuer is true; dnsNamesOf; validFrom,
    or validUntil when last is true; serialNumber; fingerprintSha256;
    belongsTo; isAuthority.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function nameOf(certificate: &[Cert, R], issuer: Bool): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function namesOf(certificate: &[Cert, R]): String;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function timeOf(certificate: &[Cert, R], last: Bool): Option[Int64];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function serialOf(certificate: &[Cert, R]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function fingerprintOf(certificate: &[Cert, R]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, K: Region]
    function keyMatches(certificate: &[Cert, R], key: &[Key, K]): Bool;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function authorityOf(certificate: &[Cert, R]): Bool;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function dropCert(certificate: Cert): Unit;

    """
    selfSigned and issue, on names the caller has checked.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, C: Region, N: Region]
    function selfSignedCert(key: &[Key, K], commonName: Span[Nat8, C], names: Span[Nat8, N], days: Int32, authority: Bool): Option[Cert];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [A: Region, K: Region, S: Region, C: Region, N: Region]
    function issuedCert(issuer: &[Cert, A], signer: &[Key, K], subject: &[Key, S],
        commonName: Span[Nat8, C], names: Span[Nat8, N], days: Int32, authority: Bool): Option[Cert];

    """
    certificateRequest on names the caller has checked, and the parts of a
    DER request whose signature holds.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [K: Region, C: Region, N: Region]
    function requestFor(key: &[Key, K], commonName: Span[Nat8, C], names: Span[Nat8, N]): Option[String];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function readRequest(der: Span[Nat8, R]): Option[Parts];

    """
    verifyChain.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [C: Region, T: Region, H: Region]
    function verifyChain(chain: Span[Nat8, C], trusted: Span[Nat8, T], host: Span[Nat8, H], at: Int64): Option[String];
end module.
