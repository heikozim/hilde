-- Binds the clocks of libc through three functions of the runtime.  It
-- reaches C with @embed, so it is an unsafe module; Standard.Time is the
-- safe module built on it.
pragma Unsafe_Module;

module body Bindings.Time is
    function wallNanos(): Nat64 is
        return @embed(Nat64, "hilde_time_wall_nanos()");
    end;

    function hasMonotonic(): Bool is
        return @embed(Int32, "hilde_time_has_monotonic()") = 1;
    end;

    function monotonicReading(): Int64 is
        return @embed(Int64, "hilde_time_monotonic_nanos()");
    end;
end module body.
