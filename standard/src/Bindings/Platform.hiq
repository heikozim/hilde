-- The runtime answers from the macros of the C compiler for its target.
pragma Unsafe_Module;

module body Bindings.Platform is
    function systemText(): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_platform_system()");
    end;

    function machineText(): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_platform_machine()");
    end;

    function hostText(): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_platform_host()");
    end;
end module body.
