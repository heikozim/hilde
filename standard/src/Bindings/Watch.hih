"""
Binds the watching of files in the runtime in lib/prelude.c: inotify on Linux, kqueue on the BSDs.

- It reaches C with @embed and hands it the address of a path's bytes: an unsafe module.
- Standard.Watch is the safe module built on it.
- A path ends in a zero byte and holds no other; watchAdd refuses one that does not.
- Watchers and watches are numbers; a negative number is a failure.
- watchWait gives -2 when the time ran out and -1 on a failure.

    let watcher: Int32 := watchOpen();
    let watch: Int32 := watchAdd(watcher, &path, true);
    let changed: Int32 := watchWait(watcher, 5000);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Watch is
    """
    Whether watching is built on this platform.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function watchAvailable(): Bool;

    """
    A watcher's descriptor, or a negative number.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function watchOpen(): Int32;

    """
    Adds a watch of path to watcher: the names of a directory when
    directory is true, else a file.  The watch's number, or a negative
    number, also for a path that does not end in its one zero byte.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function watchAdd(watcher: Int32, path: &[String, R], directory: Bool): Int32;

    """
    Waits at most milliseconds: the number of a watch that changed, -2
    when the time ran out, -1 on a failure.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function watchWait(watcher: Int32, milliseconds: Nat32): Int32;

    """
    Gives back what a watch holds.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function watchForget(number: Int32): Bool;

    """
    Closes a watcher.  True on success.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function watchClose(watcher: Int32): Bool;
end module.
