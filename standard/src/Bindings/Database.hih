"""
Binds nothing outside: it holds a driver's value in a box whose type does not name the driver.

- It binds nothing outside, but it casts a box to the type its caller names, so it is an unsafe module.
- Standard.Database is the safe module built on it, and its drivers reveal only what they erased.
- abandon does not return.

    let box: Erased := erase(connection);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Database is
    """
    Stop the programme with message, taking value, a linear value that can
    no longer be ended the right way: a transaction handed to a database of
    another backend than the one it was begun on.  It does not return.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function abandon(value: T, message: Span[Nat8, Static]): Never;

    """
    A linear value of a type the holder does not name, in a box on the
    heap.  Only the module that erased it knows the type, and only it
    reveals or unerases it.
    """
    type Erased: Linear;

    """
    Move value into a new box.  Stops the programme when the box cannot be
    allocated.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function erase(value: T): Erased;

    """
    Take the value out of its box and free the box.  T is the type the
    value was erased with; another type is undefined behaviour.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type]
    function unerase(erased: Erased): T;

    """
    A read reference to the value in the box, as T, the type it was
    erased with.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function reveal(erased: &[Erased, R]): &[T, R];

    """
    A write reference to the value in the box, as T, the type it was
    erased with.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Type, R: Region]
    function revealWrite(erased: &![Erased, R]): &![T, R];
end module.
