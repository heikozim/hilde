"""
Binds the resolver of the C library, getaddrinfo, for Standard.Resolve.

- It reaches C with @embed, so it is an unsafe module; Standard.Resolve is the safe module built on it.
- A function of the runtime copies every address out of the answer before the answer is freed.
- One answer gives at most maximum_addresses addresses; the resolver's others are dropped.
- Both families come back, each address as the resolver gave it; Standard.Resolve folds a mapped one.
- A failure is a number: -1 no address for the name, -2 no answer, -3 anything else.

    let found: Either[Int32, String] := resolveRecords("example.org");
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Resolve is
    """
    The most addresses one answer gives; the resolver's others are dropped.
    """
    constant maximum_addresses: Index;

    """
    The size of one record of resolveRecords: the length of the address, 4
    or 16, then the address in network byte order padded to 16 bytes.
    """
    constant record_size: Index;

    """
    Every address of name, of both families, one record each, as the
    resolver gave it; Standard.Resolve folds an IPv6 address that maps an
    IPv4 one.  Left with -1
    when the resolver knows no address for the name, -2 when it could not
    be asked or did not answer, and -3 for anything else: no memory, a
    system error, a zero byte in the name.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function resolveRecords(name: Span[Nat8, R]): Either[Int32, String];
end module.
