"""
Binds the calls that confine the process, through the functions of the runtime in lib/prelude.c.

- On OpenBSD the calls are pledge and unveil; on Linux no new privileges, Landlock and seccomp.
- On macOS the call is seatbelt, which starts the programme again under a Seatbelt profile.
- On FreeBSD the call is capsicum, which opens the paths and enters capability mode.
- It hands the kernel the address of a string's bytes, so it is an unsafe module.
- Standard.Sandbox is the safe module built on it, and the one a programme imports.
- A string given here ends in one zero byte and holds no other, as Standard.Sandbox makes it.
- Every function checks that itself and refuses a string that does not, without a call.
- An answer is a number: as a rule 1 done, 0 refused, -1 when the platform has no such mechanism.

    if platform() = 1 then
        let pledged: Int32 := pledge(&promises);
    end if;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Sandbox is
    """
    The sandbox this programme was built for: 1 OpenBSD, with pledge and
    unveil; 2 Linux, with no new privileges, Landlock and seccomp; 3
    macOS, with Seatbelt; 4 FreeBSD, with Capsicum; 0 none, which is also
    the answer on Android and in a library.
    """
    function platform(): Int32
        ensures (result >= 0) and (result <= 4);

    """
    Sets no new privileges.  1 when the flag is set afterwards, 0 when the
    call failed or the platform has no such flag.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function setNoNewPrivileges(): Int32;

    """
    Whether no new privileges is set: 1, 0, or -1 when the platform cannot
    be asked.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function queryNoNewPrivileges(): Int32;

    """
    Pledges the promises, a list of words separated by spaces.  No promises
    for a child the process starts.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function pledge(promises: &[String, R]): Int32;

    """
    Unveils the path with the permissions, letters of r, w, x and c; the
    empty permissions hide the path.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function unveil(path: &[String, R], permissions: &[String, S]): Int32;

    """
    Locks the unveiled view, so that no later call can widen it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function lockUnveil(): Int32;

    """
    Pledges the promises, and the execpromises a programme this process
    starts runs under.  A false flag leaves its part out: the promises stay
    as they are, or a started programme runs without pledge and without the
    unveil view.  Both strings must be readable either way.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function pledgeWithExec(promises: &[String, R], withPromises: Bool,
        execPromises: &[String, S], withExec: Bool): Int32;

    """
    Runs the first count paths of grants through unveil in a child process.
    The index of the first path the kernel refused for want of room, -1
    when all fit, -2 when the child could not be run or grants is not count
    pairs of path and permissions each ending in a zero byte, -3 on a
    platform without unveil.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function unveilProbe(grants: &[String, R], count: Index): Int32;

    """
    The version of Landlock the kernel offers: 1 and up, 0 when the kernel
    has none or refused the question, -1 on a platform without Landlock.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function landlockAbi(): Int32;

    """
    The descriptor of a new ruleset that handles every right that version
    of Landlock knows, or -1.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function landlockOpen(abi: Int32): Int32;

    """
    Adds the path with the permissions as a rule of the ruleset.  1 when
    the path is covered, 0 when it is not.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function landlockAdd(ruleset: Int32, abi: Int32, path: &[String, R], permissions: &[String, S]): Int32;

    """
    Restricts the process to the ruleset and closes it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function landlockRestrict(ruleset: Int32): Int32;

    """
    Closes a ruleset that is not applied.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function landlockClose(ruleset: Int32): Int32;

    """
    Installs the seccomp filter that refuses the calls a confined programme
    has no use for, for every thread.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function seccomp(): Int32;

    """
    Whether a call the seccomp filter refuses is refused: 1, 0, or -1 when
    the platform cannot be asked.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function querySeccomp(): Int32;

    """
    Confines the process with Seatbelt: the programme is started again
    under a profile of the count paths of grants and of promises, when
    withPromises is true.  Where it started, this call does not return
    and the process ends as the confined one ends.  In the confined
    process the number of paths in the profile; -2 when the programme
    could not be started so, when the profile was built from another
    policy, or when grants is not count pairs of path and permissions or
    a single zero byte for none; -1 on a platform without Seatbelt.
    """
    generic [R: Region, S: Region]
    function seatbelt(grants: &[String, R], count: Index, promises: &[String, S], withPromises: Bool): Int32
        ensures result >= -2;

    """
    Enters capability mode with the count paths of grants, each opened and
    limited to the rights of its permissions, when promises, given when
    withPromises is true, need neither the network nor exec.  The number
    of paths opened when the process is in capability mode; -3 when the
    promises are missing or need what capability mode forbids; -2 when it
    could not be entered, already was, or grants is not count pairs of
    path and permissions or a single zero byte for none; -1 on a platform
    without Capsicum.
    """
    generic [R: Region, S: Region]
    function capsicum(grants: &[String, R], count: Index, promises: &[String, S], withPromises: Bool): Int32
        ensures result >= -3;

    """
    1 when the process is in capability mode, as the kernel answers, 0 when
    it is not, -1 on a platform without Capsicum.
    """
    function queryCapsicum(): Int32
        ensures (result >= -1) and (result <= 1);

    """
    The number of threads of the process, or -1 when it cannot be counted.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function threadCount(): Int32;
end module.
