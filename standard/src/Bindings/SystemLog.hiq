pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    spanToPointer,
    arraySizeInBytes
);

module body Bindings.SystemLog is
    generic [R: Region]
    function openSystemLog(name: Span[Nat8, R], facility: Nat8): Unit is
        let size: Index := spanLength(name);
        if size = 0 then
            -- No first byte to point at: the empty name is passed as such.
            @embed(Unit, "hilde_syslog_open((const uint8_t*) \"\", 0, $1)", facility);
            return nil;
        end if;
        let address: Pointer[Nat8] := spanToPointer(name);
        let bytes: ByteSize := arraySizeInBytes(sizeof(Nat8), size);
        @embed(Unit, "hilde_syslog_open($1, $2, $3)", address, bytes, facility);
        return nil;
    end;

    generic [R: Region]
    function writeSystemLog(priority: Nat8, text: Span[Nat8, R]): Unit is
        let size: Index := spanLength(text);
        if size = 0 then
            -- No first byte to point at: an empty text is sent as such.
            @embed(Unit, "hilde_syslog_write($1, (const uint8_t*) \"\", 0)", priority);
            return nil;
        end if;
        let address: Pointer[Nat8] := spanToPointer(text);
        let bytes: ByteSize := arraySizeInBytes(sizeof(Nat8), size);
        @embed(Unit, "hilde_syslog_write($1, $2, $3)", priority, address, bytes);
        return nil;
    end;

    function closeSystemLog(): Unit is
        @embed(Unit, "hilde_syslog_close()");
        return nil;
    end;
end module body.
