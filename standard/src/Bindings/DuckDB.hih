"""
Binds libduckdb, DuckDB's release build, through the declarations of Bindings.C.Duckdb.

- It hands handles to C by value and by address and makes spans over the memory of a data chunk.
- So it is an unsafe module.
- Standard.DuckDB is the safe module built on it, the one a programme imports and documented there.

    let opened: Either[DuckError, Connection] := connect("/var/db/stats.duckdb", false);
    let changed: Either[DuckError, Nat64] := execute(&!db, "DELETE FROM hits", noValues());
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.DuckDB is
    """
    An open database file and one connection to it.  Linear: closeDatabase
    ends it.
    """
    type Connection: Linear;

    """
    A failure: the error type of DuckDB, or a negative code of this module.
    """
    record DuckError: Free is
        code: Int32;
    end;

    constant openFailed: Int32;
    constant newerDatabase: Int32;
    constant statementRefused: Int32;
    constant duplicateKey: Int32;
    constant writeConflict: Int32;
    constant failedTransaction: Int32;
    constant constraintType: Int32;
    constant transactionType: Int32;
    constant catalogType: Int32;
    constant parserType: Int32;
    constant binderType: Int32;
    constant invalidInputType: Int32;
    constant permissionType: Int32;

    """
    Open the database file at path, creating it unless readOnly, with
    access to other files and the loading of extensions switched off and
    the configuration locked.  The settings are read back from DuckDB, and
    the open fails when one does not hold.
    """
    generic [R: Region]
    function connect(path: Span[Nat8, R], readOnly: Bool): Either[DuckError, Connection]
        requires spanLength(path) > 0;

    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeDatabase(db: Connection): Unit;

    """
    The words of DuckDB for the last failure on this connection, copied;
    empty when there was none.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function lastMessage(db: &[Connection, R]): String;

    """
    The version of libduckdb, as the library reports it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function libraryVersion(): Span[Nat8, Static];

    type Values: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function noValues(): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withInt64(values: Values, value: Int64): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withFloat64(values: Values, value: Float64): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withBool(values: Values, value: Bool): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withTimestamp(values: Values, value: Int64): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function withText(values: Values, value: Span[Nat8, R]): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function withBytes(values: Values, value: Span[Nat8, R]): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function withNull(values: Values): Values;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function dropValues(values: Values): Unit;

    """
    How many values were added.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function valueCount(values: &[Values, R]): Index;

    type Cursor: Linear;

    """
    Prepare sql, bind values to its question marks and run it.  A failure
    is kept in the cursor and reported by finish.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function start(db: &![Connection, R], sql: Span[Nat8, S], values: Values): Cursor;

    """
    Run a statement and give the number of rows it changed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function execute(db: &![Connection, R], sql: Span[Nat8, S], values: Values): Either[DuckError, Nat64];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function advance(cursor: &![Cursor, R]): Bool;

    """
    How many columns the result has; 0 after a failure.
    """
    generic [R: Region]
    function columnCount(cursor: &[Cursor, R]): Int32
        ensures result >= 0;

    generic [R: Region]
    function isNullColumn(cursor: &[Cursor, R], index: Int32): Bool
        requires index >= 0;
    generic [R: Region]
    function columnInt64(cursor: &[Cursor, R], index: Int32): Int64
        requires index >= 0;
    generic [R: Region]
    function columnFloat64(cursor: &[Cursor, R], index: Int32): Float64
        requires index >= 0;
    generic [R: Region]
    function columnBool(cursor: &[Cursor, R], index: Int32): Bool
        requires index >= 0;
    generic [R: Region]
    function columnTimestamp(cursor: &[Cursor, R], index: Int32): Int64
        requires index >= 0;
    generic [R: Region]
    function columnText(cursor: &[Cursor, R], index: Int32): Span[Nat8, R]
        requires index >= 0;
    generic [R: Region]
    function columnBytes(cursor: &[Cursor, R], index: Int32): Span[Nat8, R]
        requires index >= 0;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function finish(db: &![Connection, R], cursor: Cursor): Option[DuckError];

    type Transaction: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function begin(db: &![Connection, R]): Either[DuckError, Transaction];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function commit(db: &![Connection, R], transaction: Transaction): Either[DuckError, Unit];
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function rollback(db: &![Connection, R], transaction: Transaction): Unit;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function migrate(db: &![Connection, R], migrations: Span[Nat8, Static]): Either[DuckError, Index];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function copyText(text: Span[Nat8, R]): String;
end module.
