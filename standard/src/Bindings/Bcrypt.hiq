-- Binds the runtime's check of a bcrypt hash.  It reaches C with @embed,
-- so it is an unsafe module; Standard.Password is the safe module built on
-- it.  libxcrypt is linked on Linux and libcrypt on FreeBSD: OpenBSD has
-- crypt_checkpass in its C library.
pragma Unsafe_Module;
pragma Foreign_Library(Name => "crypt", System => "Linux");
pragma Foreign_Library(Name => "crypt", System => "FreeBSD");

module body Bindings.Bcrypt is
    generic [P: Region, H: Region]
    function bcryptCheck(password: Span[Nat8, P], hash: Span[Nat8, H]): Int32 is
        return @embed(Int32, "hilde_bcrypt_check($1, $2)", password, hash);
    end;
end module body.
