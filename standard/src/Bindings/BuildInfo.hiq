-- The macros HILDE_BUILD_* and the table hilde_build_values, names and
-- texts in turn and a null pointer last, are written by the compiler into
-- every programme that compiles this module.
pragma Unsafe_Module;

module body Bindings.BuildInfo is
    function commitText(): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_make_span((void*)HILDE_BUILD_COMMIT, sizeof(HILDE_BUILD_COMMIT) - 1)");
    end;

    function dirtyFlag(): Int32 is
        return @embed(Int32, "(int32_t)HILDE_BUILD_DIRTY");
    end;

    function buildSeconds(): Int64 is
        return @embed(Int64, "(int64_t)HILDE_BUILD_TIME");
    end;

    function compilerText(): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_make_span((void*)HILDE_BUILD_COMPILER, sizeof(HILDE_BUILD_COMPILER) - 1)");
    end;

    function valueTotal(): Index is
        return @embed(Index, "(size_t)HILDE_BUILD_VALUE_COUNT");
    end;

    function nameAt(index: Index): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_make_span((void*)hilde_build_values[2 * $1], hilde_build_values[2 * $1] ? strlen(hilde_build_values[2 * $1]) : 0)", index);
    end;

    function textAt(index: Index): Span[Nat8, Static] is
        return @embed(Span[Nat8, Static], "hilde_make_span((void*)hilde_build_values[2 * $1 + 1], hilde_build_values[2 * $1 + 1] ? strlen(hilde_build_values[2 * $1 + 1]) : 0)", index);
    end;
end module body.
