"""
Binds libargon2, the reference implementation of Argon2, through Bindings.C.Argon2.

- It hands addresses to C, so it is an unsafe module.
- Standard.Password is the safe module built on it.
- It computes Argon2id of version 0x13 only.
- A refused input or a failure of the library gives None, and nothing aborts.

    let tag: Option[String] := argon2id(asSpan(&password), asSpan(&salt), 3, 65536, 4, 32);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.Argon2 is
    """
    The Argon2id tag of password and salt, length bytes long, after passes
    passes over memory kibibytes in lanes lanes, version 0x13.  None when the
    library refuses an input or fails, and for a password, salt or length
    the library cannot take, one of four gibibytes or more.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [P: Region, S: Region]
    function argon2id(password: Span[Nat8, P], salt: Span[Nat8, S], passes: Nat32, memory: Nat32, lanes: Nat32, length: Index): Option[String];

    """
    The same with a secret key and associated data, which only the
    library's context call takes.  The test vectors of RFC 9106 use both.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [P: Region, S: Region, K: Region, A: Region]
    function argon2idKeyed(password: Span[Nat8, P], salt: Span[Nat8, S], secret: Span[Nat8, K], data: Span[Nat8, A], passes: Nat32, memory: Nat32, lanes: Nat32, length: Index): Option[String];
end module.
