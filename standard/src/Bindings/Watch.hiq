-- Binds the watching of files in the runtime: every call is one @embed of
-- a function of lib/prelude.c, and a path is handed over as the address of
-- its first byte, after it was checked to end in its one zero byte.
pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    spanToPointer
);
import Standard.String (
    String,
    length,
    nthByte,
    getSpan
);

module body Bindings.Watch is
    -- Whether path is not empty, ends in a zero byte and holds no other.
    generic [R: Region]
    function readable(path: &[String, R]): Bool is
        let size: Index := length(path);
        if size = 0 then
            return false;
        end if;
        var zeros: Index := 0;
        for i from 0 to size - 1 do
            if nthByte(path, i) = 0 then
                zeros := zeros + 1;
            end if;
        end for;
        return (zeros = 1) and (nthByte(path, size - 1) = 0);
    end;

    function watchAvailable(): Bool is
        return @embed(Int32, "hilde_watch_available()") = 1;
    end;

    function watchOpen(): Int32 is
        return @embed(Int32, "hilde_watch_open()");
    end;

    generic [R: Region]
    function watchAdd(watcher: Int32, path: &[String, R], directory: Bool): Int32 is
        if not readable(path) then
            return -1;
        end if;
        var flag: Int32 := 0;
        if directory then
            flag := 1;
        end if;
        let address: Pointer[Nat8] := spanToPointer(getSpan(path, 0, 0));
        return @embed(Int32, "hilde_watch_add($1, $2, $3)", watcher, address, flag);
    end;

    function watchWait(watcher: Int32, milliseconds: Nat32): Int32 is
        return @embed(Int32, "hilde_watch_wait($1, $2)", watcher, milliseconds);
    end;

    function watchForget(number: Int32): Bool is
        return @embed(Int32, "hilde_watch_forget($1)", number) = 1;
    end;

    function watchClose(watcher: Int32): Bool is
        return @embed(Int32, "hilde_file_close($1)", watcher) = 1;
    end;
end module body.
