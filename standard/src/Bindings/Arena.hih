"""
Binds the arena of the runtime in lib/prelude.c, which takes memory with mmap and hands out pieces.

- It reaches C with @embed and turns an address into a reference, so it is an unsafe module.
- Standard.Arena is the safe module built on it, and the one a programme imports.
- Each function here is the one of Standard.Arena with the same name.

    let made: Option[Arena] := createArena(65536);
    let got: Option[Span![Int32, R]] := arenaSpan(r, 100);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Arena is
    type Arena: Linear;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function createArena(capacity: ByteSize): Option[Arena];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Free, R: Region]
    function arenaAllocate(arena: &![Arena, R]): Option[&![T, R]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [T: Free, R: Region]
    function arenaSpan(arena: &![Arena, R], count: Index): Option[Span![T, R]];

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function arenaUsed(arena: &[Arena, R]): ByteSize;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function arenaCapacity(arena: &[Arena, R]): ByteSize;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function resetArena(arena: Arena): Arena;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function freeArena(arena: Arena): Unit;
end module.
