-- The runtime asks getpwnam_r and geteuid.
pragma Unsafe_Module;

module body Bindings.Account is
    generic [R: Region]
    function accountNumber(name: Span[Nat8, R], group: Bool): Int64 is
        var which: Int32 := 0;
        if group then
            which := 1;
        end if;
        return @embed(Int64, "hilde_account_number((const uint8_t*) $1.data, $1.size, (int) $2)", name, which);
    end;

    function effectiveUser(): Nat32 is
        return @embed(Nat32, "hilde_account_effective()");
    end;
end module body.
