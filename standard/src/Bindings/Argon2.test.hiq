-- Tests for Bindings.Argon2: the test vector of RFC 9106 for Argon2id,
-- which needs the secret and the associated data only the context call
-- takes; the two calls agreeing where both apply; and the inputs the
-- library refuses, each answered with None rather than an abort.
import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    makeString,
    destroyString,
    length,
    asSpan
);
import Standard.Text (
    bytesToHex,
    constantTimeEqual
);
import Bindings.Argon2 (
    argon2id,
    argon2idKeyed
);

module body Standard.Bindings.Argon2.Test is
    -- RFC 9106, section 5.3: 32 kibibytes, 3 passes, 4 lanes, a tag of 32
    -- bytes; the password 32 bytes of 1, the salt 16 of 2, the secret 8 of
    -- 3, the associated data 12 of 4.
    function testRfc9106Argon2id(): Unit is
        let password: String := makeString(32, 1);
        let salt: String := makeString(16, 2);
        let secret: String := makeString(8, 3);
        let data: String := makeString(12, 4);
        case argon2idKeyed(asSpan(&password), asSpan(&salt), asSpan(&secret), asSpan(&data), 3, 32, 4, 32) of
            when Some(value as tag: String) do
                let hex: String := bytesToHex(asSpan(&tag));
                assertTrue(constantTimeEqual(asSpan(&hex), "0d640df58d78766c08c037a34a8b53c9d01ef0452d75b65eb52520e96b01e659"), "the tag of RFC 9106 section 5.3");
                destroyString(hex);
                destroyString(tag);
            when None do
                assertTrue(false, "the vector of RFC 9106 is computed");
        end case;
        destroyString(data);
        destroyString(secret);
        destroyString(salt);
        destroyString(password);
        return nil;
    end;

    -- Without a secret and without associated data the context call and the
    -- plain call compute the same tag.
    function testBothCallsAgree(): Unit is
        let password: String := makeString(20, 7);
        let salt: String := makeString(16, 9);
        let none: String := makeString(0, 0);
        case argon2id(asSpan(&password), asSpan(&salt), 2, 64, 1, 32) of
            when Some(value as plain: String) do
                case argon2idKeyed(asSpan(&password), asSpan(&salt), asSpan(&none), asSpan(&none), 2, 64, 1, 32) of
                    when Some(value as keyed: String) do
                        assertTrue(length(&plain) = 32, "the plain call gives 32 bytes");
                        assertTrue(constantTimeEqual(asSpan(&plain), asSpan(&keyed)), "the two calls agree without secret and data");
                        destroyString(keyed);
                    when None do
                        assertTrue(false, "the context call computes");
                end case;
                destroyString(plain);
            when None do
                assertTrue(false, "the plain call computes");
        end case;
        destroyString(none);
        destroyString(salt);
        destroyString(password);
        return nil;
    end;

    -- What the library refuses comes back as None.
    function testRefusals(): Unit is
        let password: String := makeString(8, 5);
        let salt: String := makeString(16, 6);
        let shortSalt: String := makeString(7, 6);
        assertTrue(isNone(argon2id(asSpan(&password), asSpan(&shortSalt), 1, 64, 1, 32)), "a salt of 7 bytes is refused");
        assertTrue(isNone(argon2id(asSpan(&password), asSpan(&salt), 1, 7, 1, 32)), "7 kibibytes for one lane is refused");
        assertTrue(isNone(argon2id(asSpan(&password), asSpan(&salt), 0, 64, 1, 32)), "0 passes is refused");
        assertTrue(isNone(argon2id(asSpan(&password), asSpan(&salt), 1, 64, 0, 32)), "0 lanes is refused");
        assertTrue(isNone(argon2id(asSpan(&password), asSpan(&salt), 1, 64, 1, 3)), "a tag of 3 bytes is refused");
        assertTrue(not isNone(argon2id(asSpan(&password), asSpan(&salt), 1, 64, 1, 4)), "a tag of 4 bytes is taken");
        destroyString(shortSalt);
        destroyString(salt);
        destroyString(password);
        return nil;
    end;

    function isNone(result: Option[String]): Bool is
        case result of
            when Some(value as bytes: String) do
                destroyString(bytes);
                return false;
            when None do
                return true;
        end case;
    end;
end module body.
