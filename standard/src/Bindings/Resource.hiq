-- Binds the resource calls of the runtime.  The numbers come back through
-- memory, since Hilde has no way to receive more than one value from C:
-- a buffer of slots, written by the runtime, read out and given back.
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    load,
    deallocate,
    positiveOffset
);

module body Bindings.Resource is
    record LimitPair: Free is
        soft: Nat64;
        hard: Nat64;
    end;

    record UsageNumbers: Free is
        userMicros: Nat64;
        systemMicros: Nat64;
        peakBytes: Nat64;
    end;

    function limitOf(which: Nat32): Option[LimitPair] is
        let address: Address[Nat64] := allocateBuffer(2);
        case nullCheck(address) of
            when Some(value as slots: Pointer[Nat64]) do
                let read: Bool := @embed(Int32, "hilde_resource_limit($1, $2)", which, slots) = 1;
                if read then
                    let soft: Nat64 := load(slots);
                    let hard: Nat64 := load(positiveOffset(slots, 1));
                    deallocate(slots);
                    let some: Option[LimitPair] := Some(value => LimitPair(soft => soft, hard => hard));
                    return some;
                end if;
                deallocate(slots);
                let none: Option[LimitPair] := None();
                return none;
            when None do
                let none: Option[LimitPair] := None();
                return none;
        end case;
    end;

    function setLimitOf(which: Nat32, soft: Nat64, hard: Nat64): Bool is
        return @embed(Int32, "hilde_resource_set_limit($1, $2, $3)", which, soft, hard) = 1;
    end;

    function usageNumbers(): Option[UsageNumbers] is
        let address: Address[Nat64] := allocateBuffer(3);
        case nullCheck(address) of
            when Some(value as slots: Pointer[Nat64]) do
                let read: Bool := @embed(Int32, "hilde_resource_usage($1)", slots) = 1;
                if read then
                    let user: Nat64 := load(slots);
                    let system: Nat64 := load(positiveOffset(slots, 1));
                    let peak: Nat64 := load(positiveOffset(slots, 2));
                    deallocate(slots);
                    let some: Option[UsageNumbers] :=
                        Some(value => UsageNumbers(userMicros => user, systemMicros => system, peakBytes => peak));
                    return some;
                end if;
                deallocate(slots);
                let none: Option[UsageNumbers] := None();
                return none;
            when None do
                let none: Option[UsageNumbers] := None();
                return none;
        end case;
    end;

    function bootNanos(): Int64 is
        return @embed(Int64, "hilde_time_boot_nanos()");
    end;
end module body.
