"""
Binds getentropy, the system's call for a few bytes of secure random, for the keys of hash maps.

- It calls C with @embed, so it is an unsafe module.
- Standard.HashMap is the safe module built on it.
- A failed call gives 0, which a caller tells from a rare true 0 by asking twice.

    let seed: Nat64 := entropyWord();
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Bindings.Entropy is
    """
    Eight bytes from getentropy as a Nat64, or 0 when the call fails.  A
    caller that must tell a failure from the rare 0 asks twice.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function entropyWord(): Nat64;
end module.
