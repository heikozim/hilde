-- The count is a static variable inside the one C expression that reads
-- it, so the runtime needs no function for it.  The addition is atomic, so
-- two threads never read the same number; relaxed order is enough, because
-- only the number itself must be unique.  The braced group is an extension
-- of gcc and clang, and the keyword in front of it tells both not to warn
-- about it under the pedantic yardstick.  The count starts at
-- HILDE_SERIAL_START, which the runtime defines as 0; a build that defines
-- HILDE_SERIAL_NEAR_WRAP starts it two below the largest Nat64, so that a
-- test sees the third number wrap round to 0.
pragma Unsafe_Module;

module body Bindings.Serial is
    function nextSerial(): Nat64 is
        return @embed(Nat64, "__extension__ ({ static uint64_t hilde_serial_count = HILDE_SERIAL_START; __atomic_add_fetch(&hilde_serial_count, 1, __ATOMIC_RELAXED); })");
    end;
end module body.
