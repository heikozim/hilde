"""
Binds the poller of the runtime in lib/prelude.c, which waits on many descriptors at once.

- It waits with epoll on Linux and with kqueue on OpenBSD, FreeBSD and macOS.
- It reaches C with @embed and holds the runtime's handle as a pointer, so it is an unsafe module.
- Standard.Poller is the safe module built on it, and the one a programme imports.

    let added: Bool := addDescriptor(&!handle, listener, 1);
    let ready: Int32 := waitHandle(&!handle, 1000);
    let first: Int32 := eventDescriptorAt(&handle, 0);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Bindings.Poller is
    """
    The backend the runtime was built with: 0 none, 1 epoll, 2 kqueue.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function backendCode(): Int32;

    """
    The runtime's poller.  It must be given back with destroyHandle.
    """
    type Handle: Linear;

    """
    A new poller, or None when there is no backend or the kernel refused.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function createHandle(): Option[Handle];

    """
    Closes the poller's own descriptor, not the ones registered.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function destroyHandle(handle: Handle): Unit;

    """
    Registers descriptor for the interest bits, 1 read and 2 write.  False
    when the backend refused it.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function addDescriptor(handle: &![Handle, R], descriptor: Int32, bits: Int32): Bool;

    """
    Changes the interest bits of a registered descriptor.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function modifyDescriptor(handle: &![Handle, R], descriptor: Int32, bits: Int32): Bool;

    """
    Removes a registered descriptor.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function dropDescriptor(handle: &![Handle, R], descriptor: Int32): Bool;

    """
    How many descriptors are registered.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function registeredCount(handle: &[Handle, R]): Index;

    """
    Waits at most timeoutMillis milliseconds, without end when it is
    negative.  Returns how many descriptors are ready, or a negative number
    when the wait failed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function waitHandle(handle: &![Handle, R], timeoutMillis: Int32): Int32;

    """
    The descriptor of the event at index of the last wait, or a negative
    number past the end.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function eventDescriptorAt(handle: &[Handle, R], index: Index): Int32;

    """
    The flags of the event at index of the last wait: 1 readable, 2
    writable, 4 failed.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function eventFlagsAt(handle: &[Handle, R], index: Index): Int32;
end module.
