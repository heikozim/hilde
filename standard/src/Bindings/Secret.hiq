-- The runtime reads into the buffer and wipes it on a failure; the buffer
-- is wiped here once more before it is freed.
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    deallocate,
    wipe
);

module body Bindings.Secret is
    constant secretCapacity: Index := 1024;

    record RawSecret: Linear is
        bytes: Pointer[Nat8];
        used: Index;
    end;

    function allocateRaw(): Option[RawSecret] is
        let address: Address[Nat8] := allocateBuffer(secretCapacity);
        case nullCheck(address) of
            when Some(value as bytes: Pointer[Nat8]) do
                let some: Option[RawSecret] := Some(value => RawSecret(bytes => bytes, used => 0));
                return some;
            when None do
                let none: Option[RawSecret] := None();
                return none;
        end case;
    end;

    -- A length the runtime gave back, kept as the bytes in use when it is
    -- one.
    generic [R: Region]
    function keep(raw: &![RawSecret, R], got: Int64): Int64 is
        if got >= 0 then
            raw->used := @embed(Index, "(size_t) $1", got);
        else
            let none: Index := 0;
            raw->used := none;
        end if;
        return got;
    end;

    generic [R: Region, P: Region]
    function readTerminalInto(raw: &![RawSecret, R], prompt: Span[Nat8, P]): Int64 is
        let got: Int64 := @embed(Int64, "hilde_secret_read_tty((const uint8_t*) $1.data, $1.size, $2, (size_t) $3)", prompt, raw->bytes, secretCapacity);
        return keep(&~raw, got);
    end;

    generic [R: Region]
    function readInputInto(raw: &![RawSecret, R]): Int64 is
        let got: Int64 := @embed(Int64, "hilde_secret_read_fd(0, $1, (size_t) $2)", raw->bytes, secretCapacity);
        return keep(&~raw, got);
    end;

    generic [R: Region]
    function rawBytes(raw: &[RawSecret, R]): Span[Nat8, R] is
        return @embed(Span[Nat8, R], "hilde_make_span((void*) $1, $2)", raw->bytes, raw->used);
    end;

    function destroyRaw(raw: RawSecret): Unit is
        let { bytes: Pointer[Nat8], used: Index } := raw;
        let size: ByteSize := 1024;
        wipe(bytes, size);
        deallocate(bytes);
        return nil;
    end;
end module body.
