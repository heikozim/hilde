-- Binds the byte level of numbers.  A load assembles the bytes one at a
-- time and a split gives one byte, so that the result does not depend on
-- the host; the bits of a float are copied with memcpy.  It reaches C with @embed, so it
-- is an unsafe module; Standard.Array is the safe module built on it.
pragma Unsafe_Module;

module body Bindings.Array is
    generic [R: Region]
    function loadFloat64(bytes: Span[Nat8, R], at: Index): Float64 is
        return @embed(Float64, "__extension__ ({ const uint8_t* p = (const uint8_t*)($1).data + ($2); uint64_t u = 0; for (int i = 7; i >= 0; i--) { u = (u << 8) | p[i]; } double d; __builtin_memcpy(&d, &u, 8); d; })", bytes, at);
    end;

    generic [R: Region]
    function loadFloat32(bytes: Span[Nat8, R], at: Index): Float32 is
        return @embed(Float32, "__extension__ ({ const uint8_t* p = (const uint8_t*)($1).data + ($2); uint32_t u = 0; for (int i = 3; i >= 0; i--) { u = (u << 8) | p[i]; } float f; __builtin_memcpy(&f, &u, 4); f; })", bytes, at);
    end;

    generic [R: Region]
    function loadInt64(bytes: Span[Nat8, R], at: Index): Int64 is
        return @embed(Int64, "__extension__ ({ const uint8_t* p = (const uint8_t*)($1).data + ($2); uint64_t u = 0; for (int i = 7; i >= 0; i--) { u = (u << 8) | p[i]; } int64_t v; __builtin_memcpy(&v, &u, 8); v; })", bytes, at);
    end;

    generic [R: Region]
    function loadInt32(bytes: Span[Nat8, R], at: Index): Int32 is
        return @embed(Int32, "__extension__ ({ const uint8_t* p = (const uint8_t*)($1).data + ($2); uint32_t u = 0; for (int i = 3; i >= 0; i--) { u = (u << 8) | p[i]; } int32_t v; __builtin_memcpy(&v, &u, 4); v; })", bytes, at);
    end;

    function float64Byte(value: Float64, k: Index): Nat8 is
        return @embed(Nat8, "__extension__ ({ double x = ($1); uint64_t u; __builtin_memcpy(&u, &x, 8); (uint8_t)(u >> (8 * (($2) & 7))); })", value, k);
    end;

    function float32Byte(value: Float32, k: Index): Nat8 is
        return @embed(Nat8, "__extension__ ({ float x = ($1); uint32_t u; __builtin_memcpy(&u, &x, 4); (uint8_t)(u >> (8 * (($2) & 3))); })", value, k);
    end;

    function int64Byte(value: Int64, k: Index): Nat8 is
        return @embed(Nat8, "__extension__ ({ int64_t x = ($1); uint64_t u; __builtin_memcpy(&u, &x, 8); (uint8_t)(u >> (8 * (($2) & 7))); })", value, k);
    end;

    function int32Byte(value: Int32, k: Index): Nat8 is
        return @embed(Nat8, "__extension__ ({ int32_t x = ($1); uint32_t u; __builtin_memcpy(&u, &x, 4); (uint8_t)(u >> (8 * (($2) & 3))); })", value, k);
    end;
end module body.
