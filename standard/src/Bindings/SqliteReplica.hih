"""
Binds libsqlite3 through the declarations in Bindings.C.Sqlite3, for statements whose text is known only when they run.

- It hands addresses to C, so it is an unsafe module.
- Standard.SqliteReplica is the safe module built on it, and the one a programme imports.
- A statement is prepared alone and finalized after its run; nothing is cached.
- prepareOne refuses text that holds more than one statement, or none.
- The backup copies a whole database from one connection into a file or from a file.
- A failure comes back as SQLite's extended result code, or its words.

    let opened: Either[String, Database] := openDatabase("data.db");
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Bindings.SqliteReplica is
    """
    An open database.  Linear: closeDatabase gives it back.
    """
    type Database: Linear;

    """
    A prepared statement.  Linear: finalizeStatement gives it back.
    """
    type Statement: Linear;

    """
    The database file at path, made when it is not there.  Left with
    SQLite's words when it cannot be opened.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function openDatabase(path: Span[Nat8, R]): Either[String, Database];
    """
    Closes the handle it is given.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function closeDatabase(db: Database): Unit;

    """
    The one statement sql holds.  Left with SQLite's words when it does
    not prepare, and when sql holds no statement or more than one.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [D: Region, R: Region]
    function prepareOne(db: &[Database, D], sql: Span[Nat8, R]): Either[String, Statement];

    """
    Whether the statement only reads, how many parameters it takes and how
    many columns its rows have.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function isReadOnly(statement: &[Statement, R]): Bool;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function parameterCount(statement: &[Statement, R]): Index;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function columnCount(statement: &[Statement, R]): Index;

    """
    A value bound at position, counted from 1; SQLite's result code comes
    back, 0 for success.  Text and blob are copied by SQLite.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function bindInt64(statement: &![Statement, R], position: Index, value: Int64): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function bindFloat64(statement: &![Statement, R], position: Index, value: Float64): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function bindText(statement: &![Statement, R], position: Index, value: Span[Nat8, S]): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region, S: Region]
    function bindBlob(statement: &![Statement, R], position: Index, value: Span[Nat8, S]): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function bindNull(statement: &![Statement, R], position: Index): Int32;

    """
    One step: 100 when a row is there, 101 at the end, SQLite's code of the
    failure otherwise.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function stepStatement(statement: &![Statement, R]): Int32;

    """
    The columns of the current row, counted from 0.  columnKind is 1 for
    an integer, 2 a float, 3 text, 4 a blob and 5 null.  Text and blob are
    copies.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function columnKind(statement: &[Statement, R], column: Index): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function columnInt64(statement: &[Statement, R], column: Index): Int64;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function columnFloat64(statement: &[Statement, R], column: Index): Float64;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function columnBytes(statement: &[Statement, R], column: Index): String;

    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function finalizeStatement(statement: Statement): Unit;

    """
    The rows the last statement changed, and SQLite's extended code and
    words for the last failure.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function changes(db: &[Database, R]): Int64;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function errorCode(db: &[Database, R]): Int32;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [R: Region]
    function errorWords(db: &[Database, R]): String;

    """
    The whole database db copied into the file at path, through the
    online backup, and back from such a file into db.  False when the
    file cannot be opened or the backup fails.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [D: Region, R: Region]
    function backupInto(db: &[Database, D], path: Span[Nat8, R]): Bool;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    generic [D: Region, R: Region]
    function restoreFrom(db: &[Database, D], path: Span[Nat8, R]): Bool;

    """
    The bits of a signed integer as an unsigned one, and back, for numbers
    written as bytes.
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function int64Bits(value: Int64): Nat64;
    """
    No contract: a binding to C; the safe module built on it states the contracts.
    """
    function int64OfBits(bits: Nat64): Int64;
end module.
