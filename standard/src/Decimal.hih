"""
Decimal numbers for money: exact, with at most 18 digits and at most 18 of them after the point.

- A number is a sign, whole units and a scale, the digits after the point: 12.34 is 1234 at scale 2.
- Adding and subtracting are exact, and so is multiplying while the product fits in 18 digits.
- Dividing is rounded to the scale the caller names; 0.1 plus 0.2 is 0.3.
- Rounding is half away from zero: 2.345 is 2.35 at scale 2, and -2.345 is -2.35.
- Nothing aborts: overflow, division by zero and a text that is no number give None.

    case parseDecimal("19.99") of
        when Some(value as price: Decimal) do
            let total: Option[Decimal] := multiplyDecimal(price, quantity);
        when None do
            skip;
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Decimal is
    """
    A decimal number.  Free, so it copies.
    """
    type Decimal: Free;

    """
    The most digits after the point: 18.
    """
    constant mostScale: Nat8;

    """
    units divided by ten to the power of scale; None when scale is above
    mostScale or units has more than 18 digits.
    """
    function makeDecimal(units: Int64, scale: Nat8): Option[Decimal];

    """
    The number a text writes: an optional minus, at least one digit, and
    optionally a point followed by at least one digit.  No plus, no
    exponent, no separator of thousands.  None for any other text, and for
    one with more than 18 digits after the point or a value beyond 18
    digits.
    """
    generic [R: Region]
    function parseDecimal(text: Span[Nat8, R]): Option[Decimal];

    """
    The number with as many digits after the point as its scale, and a
    minus when it is below zero: 0.30 stays 0.30.
    """
    function decimalToString(value: Decimal): String;

    """
    The units, as in makeDecimal.
    """
    function decimalUnits(value: Decimal): Int64;

    """
    The scale, as in makeDecimal.
    """
    function decimalScale(value: Decimal): Nat8;

    """
    left plus right, at the larger of their scales; None when it does not
    fit.
    """
    function addDecimal(left: Decimal, right: Decimal): Option[Decimal];

    """
    left minus right, at the larger of their scales; None when it does not
    fit.
    """
    function subtractDecimal(left: Decimal, right: Decimal): Option[Decimal];

    """
    left times right, exact, at the sum of their scales; None when that is
    above mostScale or the product has more than 18 digits.  roundDecimal
    brings it to the scale wanted.
    """
    function multiplyDecimal(left: Decimal, right: Decimal): Option[Decimal];

    """
    left divided by right, rounded to scale half away from zero; None when
    right is zero, scale is above mostScale or the quotient does not fit.
    """
    function divideDecimal(left: Decimal, right: Decimal, scale: Nat8): Option[Decimal];

    """
    The number at another scale: rounded half away from zero when the
    scale is smaller, exact when it is larger; None when it does not fit.
    """
    function roundDecimal(value: Decimal, scale: Nat8): Option[Decimal];

    """
    Whether the two are the same number, whatever their scales: 0.3 and
    0.30 are.
    """
    function equalDecimal(left: Decimal, right: Decimal): Bool;

    """
    Whether left is the smaller number.
    """
    function lessDecimal(left: Decimal, right: Decimal): Bool;
end module.
