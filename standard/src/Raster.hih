"""
Fills, blends and copies the pixels of a picture held in a span of bytes, four bytes a pixel, red, green, blue and alpha, rows from the top without padding.

- A picture of width by height pixels needs width times height times 4 bytes, which the requires of every call checks once.
- Drawing clips at the edges: a rectangle or a mask partly outside draws the part inside, wholly outside nothing.
- A colour is a Nat32 with red in the highest byte and alpha in the lowest.
- A mask is a grey bitmap of one byte a pixel; its coverage times the alpha of the colour is blended over the picture.
- Time linear in the pixels drawn; no pixel outside the rectangle is read or written.

    fillRect(&~pixels, 640, 480, 0, 0, 640, 480, 4294967295);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Raster is
    """
    The most pixels a side of a picture has: 65536.
    """
    function mostSide(): Index
        ensures result = 65536;

    """
    The w by h pixels at column x and row y of the picture set to color,
    the parts outside the picture left out.
    """
    generic [R: Region]
    function fillRect(pixels: Span![Nat8, R], width: Index, height: Index, x: Int64, y: Int64, w: Index, h: Index, color: Nat32): Unit
        requires ((width <= mostSide()) and (height <= mostSide())) and ((((width * height) * 4) <= spanWriteLength(&pixels)) and ((w <= mostSide()) and (h <= mostSide())));

    """
    The grey mask of mask_width bytes a row drawn in color with its top left
    corner at column x and row y, its coverage times the alpha of color
    blended over the picture, the parts outside the picture left out.
    """
    generic [R: Region, M: Region]
    function blendMask(pixels: Span![Nat8, R], width: Index, height: Index, mask: Span[Nat8, M], mask_width: Index, x: Int64, y: Int64, color: Nat32): Unit
        requires ((width <= mostSide()) and (height <= mostSide())) and ((((width * height) * 4) <= spanWriteLength(&pixels)) and (((mask_width >= 1) and (mask_width <= mostSide())) and ((spanLength(mask) % mask_width) = 0)));

    """
    The rows top up to bottom of source copied into the same rows of
    target, both pictures width pixels wide.
    """
    generic [S: Region, R: Region]
    function copyRows(source: Span[Nat8, S], target: Span![Nat8, R], width: Index, top: Index, bottom: Index): Unit
        requires ((width <= mostSide()) and (top <= bottom)) and ((((bottom * width) * 4) <= spanLength(source)) and (((bottom * width) * 4) <= spanWriteLength(&target)));
end module.
