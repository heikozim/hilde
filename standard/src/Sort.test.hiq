-- Standard.Sort.  Stability is tested with
-- a record whose order looks at one field only, so that equal elements
-- can still be told apart by the other.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyEmpty,
    destroyFree,
    length,
    nth,
    nthRef,
    insertBack,
    removeLast
);
import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Order (
    Ordering,
    TotalOrder,
    compare,
    equal
);
import Standard.Sort (
    Search,
    sort,
    isSorted,
    binarySearch
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.Sort.Test is
    record Item: Free is
        key: Int32;
        tag: Int32;
    end;

    instance TotalOrder(Item) is
        generic [R: Region, S: Region]
        method compare(a: &[Item, R], b: &[Item, S]): Ordering is
            let ak: Int32 := a->key;
            let bk: Int32 := b->key;
            return compare(&ak, &bk);
        end;
    end;

    -- sort of an empty buffer and of one element.
    function testEmptyAndOne(): Unit is
        let empty: Buffer[Int32] := allocateEmpty();
        let sortedEmpty: Buffer[Int32] := sort(empty);
        assertTrue(length(&sortedEmpty) = 0, "empty stays empty");
        destroyEmpty(sortedEmpty);
        var one: Buffer[Int32] := allocateEmpty();
        insertBack(&!one, 42);
        let sortedOne: Buffer[Int32] := sort(one);
        assertTrue(length(&sortedOne) = 1, "one element stays one");
        assertTrue(nth(&sortedOne, 0) = 42, "and is the same");
        destroyFree(sortedOne);
        return nil;
    end;

    -- sort of Int32, with negatives and a duplicate.
    function testIntegers(): Unit is
        var b: Buffer[Int32] := allocateEmpty();
        insertBack(&!b, 5);
        insertBack(&!b, -3);
        insertBack(&!b, 9);
        insertBack(&!b, 0);
        insertBack(&!b, -3);
        insertBack(&!b, 7);
        insertBack(&!b, 1);
        let s: Buffer[Int32] := sort(b);
        assertTrue(length(&s) = 7, "length 7");
        assertTrue(nth(&s, 0) = -3, "[0] = -3");
        assertTrue(nth(&s, 1) = -3, "[1] = -3");
        assertTrue(nth(&s, 2) = 0, "[2] = 0");
        assertTrue(nth(&s, 3) = 1, "[3] = 1");
        assertTrue(nth(&s, 4) = 5, "[4] = 5");
        assertTrue(nth(&s, 5) = 7, "[5] = 7");
        assertTrue(nth(&s, 6) = 9, "[6] = 9");
        destroyFree(s);
        return nil;
    end;

    function item(key: Int32, tag: Int32): Item is
        return Item(key => key, tag => tag);
    end;

    generic [R: Region]
    function tagAt(b: &[Buffer[Item], R], pos: Index): Int32 is
        let it: Item := nth(b, pos);
        return it.tag;
    end;

    -- equal keys keep their order.
    function testStable(): Unit is
        var b: Buffer[Item] := allocateEmpty();
        insertBack(&!b, item(2, 0));
        insertBack(&!b, item(1, 1));
        insertBack(&!b, item(2, 2));
        insertBack(&!b, item(1, 3));
        insertBack(&!b, item(2, 4));
        insertBack(&!b, item(0, 5));
        let s: Buffer[Item] := sort(b);
        assertTrue(tagAt(&s, 0) = 5, "key 0: tag 5");
        assertTrue(tagAt(&s, 1) = 1, "first key 1: tag 1");
        assertTrue(tagAt(&s, 2) = 3, "second key 1: tag 3");
        assertTrue(tagAt(&s, 3) = 0, "first key 2: tag 0");
        assertTrue(tagAt(&s, 4) = 2, "second key 2: tag 2");
        assertTrue(tagAt(&s, 5) = 4, "third key 2: tag 4");
        destroyFree(s);
        return nil;
    end;

    -- 1000 numbers: sorted, none lost.
    function testLarge(): Unit is
        var b: Buffer[Index] := allocateEmpty();
        var x: Index := 1;
        var sumBefore: Index := 0;
        let modulus: Index := 1009;
        for i from 1 to 1000 do
            x := rem((x * 37) + 11, modulus);
            insertBack(&!b, x);
            sumBefore := sumBefore + x;
        end for;
        assertFalse(isSorted(&b), "the input is not sorted");
        let s: Buffer[Index] := sort(b);
        assertTrue(length(&s) = 1000, "length 1000");
        assertTrue(isSorted(&s), "the output is sorted");
        var sumAfter: Index := 0;
        for j from 0 to 999 do
            sumAfter := sumAfter + nth(&s, j);
        end for;
        assertTrue(sumAfter = sumBefore, "the sum is the same");
        destroyFree(s);
        return nil;
    end;

    generic [R: Region]
    function stringIs(b: &[Buffer[String], R], pos: Index, text: Span[Nat8, Static]): Bool is
        let expected: String := fromLiteral(text);
        let same: Bool := equal(nthRef(b, pos), &expected);
        destroyString(expected);
        return same;
    end;

    -- sort of String, a linear type: bytes, shorter prefix first.
    function testStrings(): Unit is
        var b: Buffer[String] := allocateEmpty();
        insertBack(&!b, fromLiteral("pear"));
        insertBack(&!b, fromLiteral("apple"));
        insertBack(&!b, fromLiteral("banana"));
        insertBack(&!b, fromLiteral("app"));
        insertBack(&!b, fromLiteral(""));
        insertBack(&!b, fromLiteral("Zebra"));
        var s: Buffer[String] := sort(b);
        assertTrue(length(&s) = 6, "length 6");
        assertTrue(stringIs(&s, 0, ""), "[0] is the empty string");
        assertTrue(stringIs(&s, 1, "Zebra"), "[1] Zebra: Z is 90, before a");
        assertTrue(stringIs(&s, 2, "app"), "[2] app, a prefix of apple");
        assertTrue(stringIs(&s, 3, "apple"), "[3] apple");
        assertTrue(stringIs(&s, 4, "banana"), "[4] banana");
        assertTrue(stringIs(&s, 5, "pear"), "[5] pear");
        while length(&s) > 0 do
            destroyString(removeLast(&!s));
        end while;
        destroyEmpty(s);
        return nil;
    end;

    -- isSorted.
    function testIsSorted(): Unit is
        var b: Buffer[Int32] := allocateEmpty();
        assertTrue(isSorted(&b), "empty is sorted");
        insertBack(&!b, 1);
        assertTrue(isSorted(&b), "one element is sorted");
        insertBack(&!b, 1);
        insertBack(&!b, 2);
        assertTrue(isSorted(&b), "1 1 2 is sorted");
        insertBack(&!b, 0);
        assertFalse(isSorted(&b), "1 1 2 0 is not");
        destroyFree(b);
        return nil;
    end;

    function foundAt(result: Search, pos: Index): Bool is
        case result of
            when Found(position as p: Index) do
                return p = pos;
            when Missing(insertAt as q: Index) do
                return false;
        end case;
    end;

    function missingAt(result: Search, pos: Index): Bool is
        case result of
            when Found(position as q: Index) do
                return false;
            when Missing(insertAt as p: Index) do
                return p = pos;
        end case;
    end;

    -- binarySearch: the first of equal keys, or where the key goes.
    function testBinarySearch(): Unit is
        var b: Buffer[Int32] := allocateEmpty();
        let seven: Int32 := 7;
        assertTrue(missingAt(binarySearch(&b, &seven), 0), "empty: missing at 0");
        insertBack(&!b, 1);
        insertBack(&!b, 3);
        insertBack(&!b, 3);
        insertBack(&!b, 3);
        insertBack(&!b, 7);
        let zero: Int32 := 0;
        let one: Int32 := 1;
        let three: Int32 := 3;
        let four: Int32 := 4;
        let eight: Int32 := 8;
        assertTrue(foundAt(binarySearch(&b, &one), 0), "1 found at 0");
        assertTrue(foundAt(binarySearch(&b, &three), 1), "3 found at 1, the first of three");
        assertTrue(foundAt(binarySearch(&b, &seven), 4), "7 found at 4");
        assertTrue(missingAt(binarySearch(&b, &zero), 0), "0 missing, goes to 0");
        assertTrue(missingAt(binarySearch(&b, &four), 4), "4 missing, goes to 4");
        assertTrue(missingAt(binarySearch(&b, &eight), 5), "8 missing, goes to 5");
        destroyFree(b);
        return nil;
    end;
end module body.
