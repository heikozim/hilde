-- A safe module over Bindings.Secret.
import Bindings.Secret (
    RawSecret,
    allocateRaw,
    readTerminalInto,
    readInputInto,
    rawBytes,
    destroyRaw
);
import Standard.Text (
    constantTimeEqual
);

module body Standard.Secret is
    record Secret: Linear is
        raw: RawSecret;
    end;

    -- What a length from the runtime means: the secret when it is one and
    -- not empty, the error otherwise; the memory goes on an error.
    function outcome(raw: RawSecret, got: Int64): Either[SecretError, Secret] is
        if got > 0 then
            let some: Either[SecretError, Secret] := Right(right => Secret(raw => raw));
            return some;
        end if;
        destroyRaw(raw);
        if got = 0 then
            let empty: Either[SecretError, Secret] := Left(left => Empty());
            return empty;
        end if;
        if got = -1 then
            let none: Either[SecretError, Secret] := Left(left => NoTerminal());
            return none;
        end if;
        if got = -2 then
            let long: Either[SecretError, Secret] := Left(left => TooLong());
            return long;
        end if;
        let failed: Either[SecretError, Secret] := Left(left => Failed());
        return failed;
    end;

    generic [P: Region]
    function readSecret(prompt: Span[Nat8, P]): Either[SecretError, Secret] is
        case allocateRaw() of
            when Some(value as fresh: RawSecret) do
                var raw: RawSecret := fresh;
                let got: Int64 := readTerminalInto(&!raw, prompt);
                return outcome(raw, got);
            when None do
                let failed: Either[SecretError, Secret] := Left(left => Failed());
                return failed;
        end case;
    end;

    generic [P: Region, A: Region]
    function readNewSecret(prompt: Span[Nat8, P], again: Span[Nat8, A]): Either[SecretError, Secret] is
        case readSecret(prompt) of
            when Right(right as first: Secret) do
                case readSecret(again) of
                    when Right(right as second: Secret) do
                        let same: Bool := constantTimeEqual(secretBytes(&first), secretBytes(&second));
                        destroySecret(second);
                        if same then
                            let some: Either[SecretError, Secret] := Right(right => first);
                            return some;
                        end if;
                        destroySecret(first);
                        let mismatch: Either[SecretError, Secret] := Left(left => Mismatch());
                        return mismatch;
                    when Left(left as error: SecretError) do
                        destroySecret(first);
                        let failed: Either[SecretError, Secret] := Left(left => error);
                        return failed;
                end case;
            when Left(left as error: SecretError) do
                let failed: Either[SecretError, Secret] := Left(left => error);
                return failed;
        end case;
    end;

    function readSecretFromInput(): Either[SecretError, Secret] is
        case allocateRaw() of
            when Some(value as fresh: RawSecret) do
                var raw: RawSecret := fresh;
                let got: Int64 := readInputInto(&!raw);
                return outcome(raw, got);
            when None do
                let failed: Either[SecretError, Secret] := Left(left => Failed());
                return failed;
        end case;
    end;

    generic [R: Region]
    function secretBytes(secret: &[Secret, R]): Span[Nat8, R] is
        return rawBytes(&(secret->raw));
    end;

    function destroySecret(secret: Secret): Unit is
        let { raw: RawSecret } := secret;
        destroyRaw(raw);
        return nil;
    end;
end module body.
