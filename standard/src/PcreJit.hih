"""
Patterns of Standard.Pcre compiled to machine code by the JIT of PCRE2.

- Importing this module is how a program says that it makes machine code at run time.
- Standard.Pcre alone never makes machine code.
- A pattern compiled here is a Regex of Standard.Pcre, searched with the same results.
- When the JIT gives no machine code, the interpreter of PCRE2 searches, and fallBack says why.
- The PCRE2 of Hilde makes machine code without a page writable and executable at once.

    case compile("[0-9]{4}-[0-9]{2}-[0-9]{2}", 100000) of
        when Right(right as compiled: Compiled) do
            let { regex: Regex, fallBack: Option[String] } := compiled;
            let found: Either[String, Bool] := match(&regex, asSpan(&line));
            destroyRegex(regex);
        when Left(left as message: String) do
            printLn(asSpan(&message));
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin", Instead => "Standard.Regex");
import Standard.Pcre (
    Regex
);
import Standard.String (
    String
);

module Standard.PcreJit is
    """
    A pattern compiled by compile.  regex is searched with the functions of
    Standard.Pcre.  fallBack is None when the JIT made machine code, and
    otherwise holds why it did not; the interpreter searches then.
    """
    record Compiled: Linear is
        regex: Regex;
        fallBack: Option[String];
    end;

    """
    Compiles a pattern as compile of Standard.Pcre does, with the same Left,
    then asks the JIT for machine code.
    No contract: the result is an Either of a parser.
    """
    generic [R: Region]
    function compile(pattern: Span[Nat8, R], matchLimit: Nat32): Either[String, Compiled];

    """
    Whether the PCRE2 this program is linked with has the JIT.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function jitBuiltIn(): Bool;
end module.
