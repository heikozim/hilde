import Standard.String (
    String,
    destroyString,
    length,
    nthByte
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    initialize,
    destroyFree,
    insertBack,
    storeNth,
    length as bufferLength,
    nth as bufferNth,
    nthMut as bufferNthMut
);

module body Standard.Text is
    -- Byte values by name.  A bare 48 in the middle of a parser is right
    -- until somebody changes it.
    constant byte_tab: Nat8 := 9;
    constant byte_line_feed: Nat8 := 10;
    constant byte_return: Nat8 := 13;
    constant byte_space: Nat8 := 32;
    constant byte_quote: Nat8 := 34;
    constant byte_hash: Nat8 := 35;
    constant byte_percent: Nat8 := 37;
    constant byte_ampersand: Nat8 := 38;
    constant byte_apostrophe: Nat8 := 39;
    constant byte_plus: Nat8 := 43;
    constant byte_hyphen: Nat8 := 45;
    constant byte_zero: Nat8 := 48;
    constant byte_nine: Nat8 := 57;
    constant byte_colon: Nat8 := 58;
    constant byte_less: Nat8 := 60;
    constant byte_greater: Nat8 := 62;
    constant byte_question: Nat8 := 63;
    constant byte_upper_a: Nat8 := 65;
    constant byte_upper_f: Nat8 := 70;
    constant byte_upper_h: Nat8 := 72;
    constant byte_upper_p: Nat8 := 80;
    constant byte_upper_t: Nat8 := 84;
    constant byte_upper_z: Nat8 := 90;
    constant byte_underscore: Nat8 := 95;
    constant byte_lower_a: Nat8 := 97;
    constant byte_lower_d: Nat8 := 100;
    constant byte_lower_f: Nat8 := 102;
    constant byte_lower_h: Nat8 := 104;
    constant byte_lower_m: Nat8 := 109;
    constant byte_lower_z: Nat8 := 122;
    constant byte_tilde: Nat8 := 126;
    -- An integer literal is an Int32 unless a declaration says otherwise, so
    -- the two step widths an assignment uses are named.
    constant step_one: Index := 1;
    constant zero_index: Index := 0;
    constant byte_zero0: Nat8 := 0;
    -- How much of a text isBinary looks at, as grep and diff do.
    constant binary_window: Index := 512;
    -- parseInt reads the digits as a Nat64 and puts the sign on after: the
    -- largest Int64, and the magnitude of the smallest, one more.
    constant int_positive_ceiling: Nat64 := 9223372036854775807;
    constant int_magnitude_ceiling: Nat64 := 9223372036854775808;
    constant step_escape: Index := 3;
    constant case_gap: Nat8 := 32;
    constant hex_letter_gap: Nat8 := 87;

    -- The exact decimal guard, and it takes two numbers, not one.
    -- maximum_nat64 is 18446744073709551615, so a running total above
    -- 1844674407370955161 cannot take another digit at all, and a total
    -- exactly equal to it can take a digit of 5 but not of 6.  A single
    -- ceiling of ...160 was the first version and it refused the largest
    -- Nat64 there is; the test suite is what found that.
    constant nat_decimal_ceiling: Nat64 := 1844674407370955161;
    constant nat_decimal_last_digit: Nat64 := 5;
    -- The same for hexadecimal.
    constant nat_hex_ceiling: Nat64 := 1152921504606846975;

    constant seconds_per_minute: Nat64 := 60;
    constant seconds_per_hour: Nat64 := 3600;
    constant seconds_per_day: Nat64 := 86400;
    -- A day is the largest multiplier, so a value above this cannot be
    -- scaled and stay inside Nat64.  Checked before the multiplication.
    constant duration_ceiling: Nat64 := 213503982334601;

    ---
    --- Widening, which cannot fail and still has to say so
    ---

    function natOfByte(byte: Nat8): Nat64 is
        case toNat64(byte) of
            when Some(value: Nat64) do
                return value;
            when None do
                -- Every Nat8 fits in a Nat64.  If this is ever reached the
                -- conversion is broken, and a wrong number would be worse
                -- than a stop.
                abort("Standard.Text: a Nat8 did not fit in a Nat64.");
        end case;
    end;

    function natOfIndex(index: Index): Nat64 is
        case toNat64(index) of
            when Some(value: Nat64) do
                return value;
            when None do
                abort("Standard.Text: an Index did not fit in a Nat64.");
        end case;
    end;

    ---
    --- Classification
    ---

    function isDigit(byte: Nat8): Bool is
        return (byte >= byte_zero) and (byte <= byte_nine);
    end;

    function isSpace(byte: Nat8): Bool is
        -- The grammar does not chain or without parentheses, and a guard
        -- reads better than three levels of them.
        if (byte = byte_space) or (byte = byte_tab) then
            return true;
        end if;
        return (byte = byte_return) or (byte = byte_line_feed);
    end;

    function hexDigitValue(byte: Nat8): Option[Nat8] is
        if (byte >= byte_zero) and (byte <= byte_nine) then
            let digit: Option[Nat8] := Some(value => byte - byte_zero);
            return digit;
        end if;
        if (byte >= byte_upper_a) and (byte <= byte_upper_f) then
            let digit: Option[Nat8] := Some(value => (byte - byte_upper_a) + 10);
            return digit;
        end if;
        if (byte >= byte_lower_a) and (byte <= byte_lower_f) then
            let digit: Option[Nat8] := Some(value => (byte - byte_lower_a) + 10);
            return digit;
        end if;
        let none: Option[Nat8] := None();
        return none;
    end;

    function hexDigit(value: Nat8): Nat8 is
        if value < 10 then
            return byte_zero + value;
        end if;
        return hex_letter_gap + value;
    end;

    function isReservedUrlByte(byte: Nat8): Bool is
        if (byte = byte_quote) or (byte = byte_hash) then
            return true;
        end if;
        if (byte = byte_percent) or (byte = byte_ampersand) then
            return true;
        end if;
        if (byte = byte_apostrophe) or (byte = byte_plus) then
            return true;
        end if;
        if (byte = byte_colon) or (byte = byte_less) then
            return true;
        end if;
        return (byte = byte_greater) or (byte = byte_question);
    end;

    function needsEncoding(byte: Nat8): Bool is
        if (byte <= byte_space) or (byte >= byte_tilde) then
            return true;
        end if;
        return isReservedUrlByte(byte);
    end;

    ---
    --- Parsing
    ---

    -- The one place the decimal guard lives.  It answers None rather than
    -- trapping, because a string that is too long is an answer and not a
    -- crash.
    function stepDecimal(total: Nat64, digit: Nat64): Option[Nat64] is
        if total > nat_decimal_ceiling then
            let none: Option[Nat64] := None();
            return none;
        end if;
        if (total = nat_decimal_ceiling) and (digit > nat_decimal_last_digit) then
            let none: Option[Nat64] := None();
            return none;
        end if;
        let some: Option[Nat64] := Some(value => (total * 10) + digit);
        return some;
    end;

    generic [R: Region]
    function parseNatUpTo(string: Span[Nat8, R], upto: Index): Option[Nat64] is
        var total: Nat64 := 0;
        var good: Bool := upto > 0;
        var i: Index := 0;
        while (i < upto) and good do
            let byte: Nat8 := string[i];
            if isDigit(byte) then
                case stepDecimal(total, natOfByte(byte - byte_zero)) of
                    when Some(value: Nat64) do
                        total := value;
                    when None do
                        good := false;
                end case;
            else
                good := false;
            end if;
            i := i + 1;
        end while;
        if good then
            let some: Option[Nat64] := Some(value => total);
            return some;
        end if;
        let none: Option[Nat64] := None();
        return none;
    end;

    generic [R: Region]
    function parseNat(string: Span[Nat8, R]): Option[Nat64] is
        return parseNatUpTo(string, spanLength(string));
    end;

    -- The value inside answer, or fallback when answer is None.
    generic [T: Free]
    function valueOr(answer: Option[T], fallback: T): T is
        case answer of
            when Some(value as inner: T) do
                return inner;
            when None do
                return fallback;
        end case;
    end;

    -- The digits of value, the most significant first, written to out.
    generic [B: Region]
    function writeDigits(out: &![StringBuilder, B], value: Nat64): Unit is
        let ten: Nat64 := 10;
        if value >= ten then
            writeDigits(&~out, value / ten);
        end if;
        let digit: Nat64 := value - ((value / ten) * ten);
        let zero: Nat8 := '0';
        let fallback: Nat8 := 0;
        writeByte(&~out, zero + valueOr(toNat8(digit), fallback));
        return nil;
    end;

    function formatNat(value: Nat64): String is
        var out: StringBuilder := makeStringBuilder();
        writeDigits(&!out, value);
        return finalize(out);
    end;

    function formatInt(value: Int64): String is
        var out: StringBuilder := makeStringBuilder();
        let zero: Int64 := 0;
        let one: Int64 := 1;
        let fallback: Nat64 := 0;
        if value < zero then
            writeByte(&!out, '-');
            -- The magnitude as -(value + 1) + 1, so that the smallest Int64,
            -- whose negation does not fit, is written whole.
            let below: Nat64 := valueOr(toNat64(-(value + one)), fallback);
            writeDigits(&!out, below + 1);
        else
            writeDigits(&!out, valueOr(toNat64(value), fallback));
        end if;
        return finalize(out);
    end;

    generic [R: Region]
    function parseInt(string: Span[Nat8, R]): Option[Int64] is
        let size: Index := spanLength(string);
        let none: Option[Int64] := None();
        if size = 0 then
            return none;
        end if;
        var negative: Bool := false;
        var start: Index := 0;
        if string[zero_index] = byte_hyphen then
            negative := true;
            start := step_one;
        end if;
        case parseNat(spanPart(string, start, size - start)) of
            when None do
                return none;
            when Some(value as magnitude: Nat64) do
                if negative and (magnitude = int_magnitude_ceiling) then
                    let smallest: Option[Int64] := Some(value => minimum_int64);
                    return smallest;
                end if;
                if magnitude > int_positive_ceiling then
                    return none;
                end if;
                case toInt64(magnitude) of
                    when None do
                        return none;
                    when Some(value as wide: Int64) do
                        if negative then
                            let zero: Int64 := 0;
                            let result: Option[Int64] := Some(value => zero - wide);
                            return result;
                        end if;
                        let result: Option[Int64] := Some(value => wide);
                        return result;
                end case;
        end case;
    end;

    generic [R: Region]
    function parseHex(string: Span[Nat8, R]): Option[Nat64] is
        let size: Index := spanLength(string);
        var total: Nat64 := 0;
        var good: Bool := size > 0;
        var i: Index := 0;
        while (i < size) and good do
            case hexDigitValue(string[i]) of
                when Some(value: Nat8) do
                    if total <= nat_hex_ceiling then
                        total := (total * 16) + natOfByte(value);
                    else
                        good := false;
                    end if;
                when None do
                    good := false;
            end case;
            i := i + 1;
        end while;
        if good then
            let some: Option[Nat64] := Some(value => total);
            return some;
        end if;
        let none: Option[Nat64] := None();
        return none;
    end;

    function scaleDuration(parsed: Option[Nat64], scale: Nat64): Option[Nat64] is
        let none: Option[Nat64] := None();
        case parsed of
            when Some(value: Nat64) do
                if (scale > 1) and (value > duration_ceiling) then
                    return none;
                end if;
                let some: Option[Nat64] := Some(value => value * scale);
                return some;
            when None do
                return none;
        end case;
    end;

    generic [R: Region]
    function parseDuration(string: Span[Nat8, R]): Option[Nat64] is
        let size: Index := spanLength(string);
        let none: Option[Nat64] := None();
        if size = 0 then
            return none;
        end if;
        let last: Nat8 := string[size - 1];
        var scale: Nat64 := 1;
        var digits: Index := size;
        if last = byte_lower_m then
            scale := seconds_per_minute;
            digits := size - 1;
        end if;
        if last = byte_lower_h then
            scale := seconds_per_hour;
            digits := size - 1;
        end if;
        if last = byte_lower_d then
            scale := seconds_per_day;
            digits := size - 1;
        end if;
        return scaleDuration(parseNatUpTo(string, digits), scale);
    end;

    ---
    --- Taking apart
    ---

    generic [R: Region]
    function indexOfByte(string: Span[Nat8, R], byte: Nat8): Option[Index] is
        let size: Index := spanLength(string);
        var i: Index := 0;
        var found: Bool := false;
        var at: Index := 0;
        while (i < size) and (not found) do
            if string[i] = byte then
                found := true;
                at := i;
            end if;
            i := i + 1;
        end while;
        if found then
            let some: Option[Index] := Some(value => at);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    generic [R: Region]
    function substring(string: Span[Nat8, R], start: Index, stop: Index): Span[Nat8, R] is
        let size: Index := spanLength(string);
        var start_at: Index := start;
        var upto: Index := stop;
        if start_at > size then
            start_at := size;
        end if;
        if upto > size then
            upto := size;
        end if;
        if upto <= start_at then
            return spanPart(string, start_at, zero_index);
        end if;
        return spanPart(string, start_at, upto - start_at);
    end;

    generic [R: Region]
    function trim(string: Span[Nat8, R]): Span[Nat8, R] is
        let size: Index := spanLength(string);
        var start_at: Index := 0;
        while (start_at < size) and isSpace(string[start_at]) do
            start_at := start_at + 1;
        end while;
        var upto: Index := size;
        while (upto > start_at) and isSpace(string[upto - 1]) do
            upto := upto - 1;
        end while;
        return substring(string, start_at, upto);
    end;

    -- Whether part stands in text at at.  False, not an index out of
    -- bounds, when part would reach past the end, so callers need not
    -- guard the call.
    generic [R: Region, S: Region]
    function matchesAt(text: Span[Nat8, R], at: Index, part: Span[Nat8, S]): Bool is
        let size: Index := spanLength(text);
        let wanted: Index := spanLength(part);
        if at > size then
            return false;
        end if;
        if wanted > (size - at) then
            return false;
        end if;
        var k: Index := 0;
        while k < wanted do
            if text[at + k] /= part[k] then
                return false;
            end if;
            k := k + 1;
        end while;
        return true;
    end;

    -- The search is Knuth, Morris and Pratt's.  The table holds, for each
    -- length k of a prefix of part, the length of the longest proper
    -- prefix of it that is also a suffix of it; position 0 is unused.
    -- Built in time linear in the length of part.
    generic [S: Region]
    function borderTable(part: Span[Nat8, S]): Buffer[Index] is
        let wanted: Index := spanLength(part);
        var table: Buffer[Index] := initialize(wanted + 1, zero_index);
        var k: Index := 0;
        var i: Index := 1;
        while i < wanted do
            while (k > 0) and (part[i] /= part[k]) do
                k := bufferNthMut(&!table, k);
            end while;
            if part[i] = part[k] then
                k := k + 1;
            end if;
            storeNth(&!table, i + 1, k);
            i := i + 1;
        end while;
        return table;
    end;

    -- The first occurrence of part in text at start or after it, or None.
    -- part is not empty and table is its border table.  After a mismatch
    -- the table says how much of part still matches, so no byte of text
    -- is read again: time linear in the length of text after start.
    generic [R: Region, S: Region, Q: Region]
    function findFrom(text: Span[Nat8, R], start: Index, part: Span[Nat8, S], table: &[Buffer[Index], Q]): Option[Index] is
        let size: Index := spanLength(text);
        let wanted: Index := spanLength(part);
        var k: Index := 0;
        var i: Index := start;
        while i < size do
            while (k > 0) and (text[i] /= part[k]) do
                k := bufferNth(table, k);
            end while;
            if text[i] = part[k] then
                k := k + 1;
            end if;
            if k = wanted then
                let found: Option[Index] := Some(value => (i + 1) - wanted);
                return found;
            end if;
            i := i + 1;
        end while;
        let none: Option[Index] := None();
        return none;
    end;

    generic [R: Region, S: Region]
    function indexOf(text: Span[Nat8, R], part: Span[Nat8, S]): Option[Index] is
        if spanLength(part) = 0 then
            let first: Option[Index] := Some(value => zero_index);
            return first;
        end if;
        let table: Buffer[Index] := borderTable(part);
        let found: Option[Index] := findFrom(text, zero_index, part, &table);
        destroyFree(table);
        return found;
    end;

    generic [R: Region, S: Region]
    function contains(text: Span[Nat8, R], part: Span[Nat8, S]): Bool is
        case indexOf(text, part) of
            when Some(value as at: Index) do
                return true;
            when None do
                return false;
        end case;
    end;

    generic [R: Region, S: Region]
    function startsWith(text: Span[Nat8, R], prefix: Span[Nat8, S]): Bool is
        return matchesAt(text, zero_index, prefix);
    end;

    generic [R: Region, S: Region]
    function endsWith(text: Span[Nat8, R], suffix: Span[Nat8, S]): Bool is
        let size: Index := spanLength(text);
        let wanted: Index := spanLength(suffix);
        if wanted > size then
            return false;
        end if;
        return matchesAt(text, size - wanted, suffix);
    end;

    generic [R: Region, S: Region]
    function countOf(text: Span[Nat8, R], part: Span[Nat8, S]): Index is
        let size: Index := spanLength(text);
        let wanted: Index := spanLength(part);
        var count: Index := 0;
        if wanted = 0 then
            return count;
        end if;
        let table: Buffer[Index] := borderTable(part);
        var at: Index := 0;
        var searching: Bool := true;
        while searching do
            case findFrom(text, at, part, &table) of
                when Some(value as hit: Index) do
                    count := count + 1;
                    at := hit + wanted;
                when None do
                    searching := false;
            end case;
        end while;
        destroyFree(table);
        return count;
    end;

    generic [R: Region, S: Region]
    function split(text: Span[Nat8, R], separator: Span[Nat8, S]): Buffer[Span[Nat8, R]] is
        var pieces: Buffer[Span[Nat8, R]] := allocateEmpty();
        let size: Index := spanLength(text);
        let wanted: Index := spanLength(separator);
        if wanted = 0 then
            insertBack(&!pieces, text);
        else
            let table: Buffer[Index] := borderTable(separator);
            var piece_start: Index := 0;
            var searching: Bool := true;
            while searching do
                case findFrom(text, piece_start, separator, &table) of
                    when Some(value as hit: Index) do
                        insertBack(&!pieces, spanPart(text, piece_start, hit - piece_start));
                        piece_start := hit + wanted;
                    when None do
                        searching := false;
                end case;
            end while;
            destroyFree(table);
            insertBack(&!pieces, spanPart(text, piece_start, size - piece_start));
        end if;
        return pieces;
    end;

    generic [R: Region]
    function lines(text: Span[Nat8, R]): Buffer[Span[Nat8, R]] is
        var found: Buffer[Span[Nat8, R]] := allocateEmpty();
        let size: Index := spanLength(text);
        var piece_start: Index := 0;
        var i: Index := 0;
        while i < size do
            if text[i] = byte_line_feed then
                var stop: Index := i;
                if stop > piece_start then
                    if text[stop - 1] = byte_return then
                        stop := stop - 1;
                    end if;
                end if;
                insertBack(&!found, spanPart(text, piece_start, stop - piece_start));
                piece_start := i + 1;
            end if;
            i := i + 1;
        end while;
        if piece_start < size then
            insertBack(&!found, spanPart(text, piece_start, size - piece_start));
        end if;
        return found;
    end;

    generic [R: Region]
    function isBinary(text: Span[Nat8, R]): Bool is
        var upto: Index := spanLength(text);
        if upto > binary_window then
            upto := binary_window;
        end if;
        var i: Index := 0;
        while i < upto do
            if text[i] = byte_zero0 then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    generic [R: Region]
    function toLower(string: Span[Nat8, R]): String is
        let size: Index := spanLength(string);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < size do
            let byte: Nat8 := string[i];
            if (byte >= byte_upper_a) and (byte <= byte_upper_z) then
                writeByte(&!builder, byte + case_gap);
            else
                writeByte(&!builder, byte);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    generic [R: Region]
    function toUpper(string: Span[Nat8, R]): String is
        let size: Index := spanLength(string);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < size do
            let byte: Nat8 := string[i];
            if (byte >= byte_lower_a) and (byte <= byte_lower_z) then
                writeByte(&!builder, byte - case_gap);
            else
                writeByte(&!builder, byte);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    generic [R: Region, P: Region, S: Region]
    function join(pieces: &[Buffer[Span[Nat8, R]], P], separator: Span[Nat8, S]): String is
        var builder: StringBuilder := makeStringBuilder();
        let count: Index := bufferLength(pieces);
        var i: Index := 0;
        while i < count do
            if i > 0 then
                writeString(&!builder, separator);
            end if;
            writeString(&!builder, bufferNth(pieces, i));
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    generic [R: Region, O: Region, N: Region]
    function replace(text: Span[Nat8, R], old: Span[Nat8, O], new: Span[Nat8, N]): String is
        var builder: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(text);
        let wanted: Index := spanLength(old);
        if wanted = 0 then
            writeString(&!builder, text);
        else
            let table: Buffer[Index] := borderTable(old);
            var at: Index := 0;
            var searching: Bool := true;
            while searching do
                case findFrom(text, at, old, &table) of
                    when Some(value as hit: Index) do
                        writeString(&!builder, spanPart(text, at, hit - at));
                        writeString(&!builder, new);
                        at := hit + wanted;
                    when None do
                        searching := false;
                end case;
            end while;
            destroyFree(table);
            writeString(&!builder, spanPart(text, at, size - at));
        end if;
        return finalize(builder);
    end;

    ---
    --- Encoding
    ---

    generic [R: Region]
    function urlEncode(string: Span[Nat8, R]): String is
        let size: Index := spanLength(string);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < size do
            let byte: Nat8 := string[i];
            if needsEncoding(byte) then
                writeByte(&!builder, byte_percent);
                writeByte(&!builder, hexDigit(byte / 16));
                writeByte(&!builder, hexDigit(byte - ((byte / 16) * 16)));
            else
                writeByte(&!builder, byte);
            end if;
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    generic [R: Region]
    function lowNibbleOfEscape(string: Span[Nat8, R], at: Index, high: Nat8): Option[Nat8] is
        let none: Option[Nat8] := None();
        case hexDigitValue(string[at + 2]) of
            when Some(value: Nat8) do
                let byte: Option[Nat8] := Some(value => (high * 16) + value);
                return byte;
            when None do
                return none;
        end case;
    end;

    generic [R: Region]
    function escapeAt(string: Span[Nat8, R], at: Index): Option[Nat8] is
        let size: Index := spanLength(string);
        let none: Option[Nat8] := None();
        if (at + 2) >= size then
            return none;
        end if;
        case hexDigitValue(string[at + 1]) of
            when Some(value: Nat8) do
                return lowNibbleOfEscape(string, at, value);
            when None do
                return none;
        end case;
    end;

    generic [R: Region]
    function urlDecode(string: Span[Nat8, R]): String is
        let size: Index := spanLength(string);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < size do
            let byte: Nat8 := string[i];
            var taken: Index := step_one;
            if byte = byte_percent then
                case escapeAt(string, i) of
                    when Some(value: Nat8) do
                        writeByte(&!builder, value);
                        taken := step_escape;
                    when None do
                        -- A % that is not followed by two hexadecimal
                        -- digits stays as it is.  A decoder that drops bytes
                        -- it does not understand is a decoder that changes
                        -- the message.
                        writeByte(&!builder, byte);
                end case;
            else
                writeByte(&!builder, byte);
            end if;
            i := i + taken;
        end while;
        return finalize(builder);
    end;

    generic [R: Region]
    function bytesToHex(string: Span[Nat8, R]): String is
        let size: Index := spanLength(string);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < size do
            let byte: Nat8 := string[i];
            writeByte(&!builder, hexDigit(byte / 16));
            writeByte(&!builder, hexDigit(byte - ((byte / 16) * 16)));
            i := i + 1;
        end while;
        return finalize(builder);
    end;

    generic [R: Region]
    function hexToBytes(text: Span[Nat8, R]): Option[String] is
        let size: Index := spanLength(text);
        if (size - ((size / 2) * 2)) /= 0 then
            return None();
        end if;
        var good: Bool := true;
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while good and (i < size) do
            case hexDigitValue(text[i]) of
                when Some(value as high: Nat8) do
                    case hexDigitValue(text[i + 1]) of
                        when Some(value as low: Nat8) do
                            writeByte(&!builder, (high * 16) + low);
                        when None do
                            good := false;
                    end case;
                when None do
                    good := false;
            end case;
            i := i + 2;
        end while;
        let made: String := finalize(builder);
        if good then
            return Some(value => made);
        else
            destroyString(made);
            return None();
        end if;
    end;

    ---
    --- Comparison
    ---

    function wrapIndex(i: Index, size: Index): Index is
        return rem(i, size);
    end;

    generic [R: Region, S: Region]
    function equal(left: Span[Nat8, R], right: Span[Nat8, S]): Bool is
        let size: Index := spanLength(left);
        if size /= spanLength(right) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            if left[i] /= right[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    generic [R: Region, S: Region]
    function constantTimeEqual(left: Span[Nat8, R], right: Span[Nat8, S]): Bool is
        let left_size: Index := spanLength(left);
        let right_size: Index := spanLength(right);
        if (left_size = 0) or (right_size = 0) then
            -- The one branch visible from outside, and it has to be: there
            -- is no byte to read, so there is nothing to fold a length
            -- difference into.  An empty secret is not a secret.
            return left_size = right_size;
        end if;
        var longest: Index := left_size;
        if right_size > longest then
            longest := right_size;
        end if;
        -- The lengths go into the same accumulator as the bytes, so a
        -- difference in length is not decided sooner than one in content.
        var accumulator: Nat64 := bitwiseXor(natOfIndex(left_size),
            natOfIndex(right_size));
        var i: Index := 0;
        while i < longest do
            let left_byte: Nat8 := left[wrapIndex(i, left_size)];
            let right_byte: Nat8 := right[wrapIndex(i, right_size)];
            accumulator := bitwiseOr(accumulator,
                natOfByte(bitwiseXor(left_byte, right_byte)));
            i := i + 1;
        end while;
        return accumulator = 0;
    end;
end module body.
