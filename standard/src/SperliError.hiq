module body Standard.SperliError is
    function badCertificate(): Int32 is
        return 1601;
    end;

    function subjectMismatch(): Int32 is
        return 1602;
    end;

    function refusedHost(): Int32 is
        return 1603;
    end;

    function tokenExpired(): Int32 is
        return 1604;
    end;

    function tokenForeignJob(): Int32 is
        return 1605;
    end;

    function tokenWrongRank(): Int32 is
        return 1606;
    end;

    function tokenBadSignature(): Int32 is
        return 1607;
    end;

    function oversizedFrame(): Int32 is
        return 1608;
    end;

    function staleIncarnation(): Int32 is
        return 1609;
    end;

    function badFrame(): Int32 is
        return 1610;
    end;

    function peerLost(): Int32 is
        return 1611;
    end;

    function peerAborted(): Int32 is
        return 1612;
    end;

    function badHello(): Int32 is
        return 1613;
    end;

    function badLaunch(): Int32 is
        return 1614;
    end;

    function startFailed(): Int32 is
        return 1615;
    end;

    function badJob(): Int32 is
        return 1616;
    end;

    function collectiveMismatch(): Int32 is
        return 1617;
    end;

    function badCollective(): Int32 is
        return 1618;
    end;

    function badCheckpointFile(): Int32 is
        return 1619;
    end;

    function digestMismatch(): Int32 is
        return 1620;
    end;

    function badCommit(): Int32 is
        return 1621;
    end;

    function resumeRefused(): Int32 is
        return 1622;
    end;

    function sizeMismatch(): Int32 is
        return 1623;
    end;

    function openHandles(): Int32 is
        return 1624;
    end;

    function checkpointFailed(): Int32 is
        return 1625;
    end;

    function restartStatus(): Int32 is
        return 75;
    end;

    function describe(code: Int32): Span[Nat8, Static] is
        if code = 1601 then
            return "the peer has no certificate of the job CA";
        end if;
        if code = 1602 then
            return "the subject of the certificate is not the job and rank of the peer";
        end if;
        if code = 1603 then
            return "the host is refused";
        end if;
        if code = 1604 then
            return "the join token has expired";
        end if;
        if code = 1605 then
            return "the join token is for another job";
        end if;
        if code = 1606 then
            return "the join token is for another rank, size, incarnation or host";
        end if;
        if code = 1607 then
            return "the join token is malformed or its signature does not hold";
        end if;
        if code = 1608 then
            return "the frame is larger than the limit";
        end if;
        if code = 1609 then
            return "the frame is from an older incarnation";
        end if;
        if code = 1610 then
            return "the header of the frame breaks the protocol";
        end if;
        if code = 1611 then
            return "the peer was lost";
        end if;
        if code = 1612 then
            return "the peer aborted the job";
        end if;
        if code = 1613 then
            return "the hello of the peer is missing, repeated or not acceptable";
        end if;
        if code = 1614 then
            return "the command line or the host list is wrong";
        end if;
        if code = 1615 then
            return "a rank could not be started";
        end if;
        if code = 1616 then
            return "the job description is malformed";
        end if;
        if code = 1617 then
            return "the collective frame does not match the call";
        end if;
        if code = 1618 then
            return "the arguments of the collective call are wrong";
        end if;
        if code = 1619 then
            return "the checkpoint file is not the one expected";
        end if;
        if code = 1620 then
            return "the SHA-256 of the checkpoint file does not match";
        end if;
        if code = 1621 then
            return "the COMMIT file is malformed or its signature does not hold";
        end if;
        if code = 1622 then
            return "no epoch can be resumed";
        end if;
        if code = 1623 then
            return "the job has another size than the checkpoint";
        end if;
        if code = 1624 then
            return "a send or receive is still open";
        end if;
        if code = 1625 then
            return "the checkpoint could not be written or sent";
        end if;
        return "";
    end;
end module body.
