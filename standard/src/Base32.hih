"""
Base32 after RFC 4648, section 6, the form in which the secrets of one-time passwords are written.

- The alphabet is A to Z and 2 to 7; five bytes become eight characters.
- The padded form ends with = up to a multiple of eight characters; the unpadded form has none.
- Decoding takes capitals and small letters alike, since people type these secrets.
- A byte outside the alphabet, a length no encoding has or misplaced padding gives None.
- Bits left over at the end that are not zero give None too; nothing aborts on bad input.

    let secret: String := encodeBase32Unpadded(asSpan(&key));
    let back: Option[String] := decodeBase32(asSpan(&secret));
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String,
    length
);

module Standard.Base32 is
    """
    The bytes in base32 with padding.  An empty span gives an empty string.
    """
    generic [R: Region]
    function encodeBase32(bytes: Span[Nat8, R]): String
        ensures length(&result) = (((spanLength(bytes) + 4) / 5) * 8);

    """
    The bytes in base32 without padding.
    """
    generic [R: Region]
    function encodeBase32Unpadded(bytes: Span[Nat8, R]): String
        ensures length(&result) = (((spanLength(bytes) * 8) + 4) / 5);

    """
    The bytes a base32 text stands for, padded or not.  None when the text
    is not base32 as the module's text says.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decodeBase32(text: Span[Nat8, R]): Option[String];
end module.
