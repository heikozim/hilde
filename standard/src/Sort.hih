"""
Sorting and searching a buffer whose elements have a total order of Standard.Order.TotalOrder.

- sort takes O(n log n) comparisons in every case and O(n) extra memory.
- sort is stable: equal elements keep their order, so the result depends on the input alone.
- sort moves elements and never copies them, so it sorts linear elements as well as free ones.
- binarySearch takes O(log n) comparisons and does not check that the buffer is sorted.
- A module that sorts Strings or integers imports TotalOrder from Standard.Order, else H3061.

    let sorted: Buffer[String] := sort(names);
    case binarySearch(&sorted, &wanted) of
        when Found(position: Index) do
            showAt(position);
        when Missing(insertAt: Index) do
            offerToAdd(insertAt);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.Buffer (
    Buffer,
    length
);
import Standard.Order (
    TotalOrder
);

module Standard.Sort is
    """
    What binarySearch found: the position of the first element equal to
    the key, or -- when there is none -- the position where the key would
    have to be inserted to keep the buffer sorted.
    """
    union Search: Free is
        case Found is
            position: Index;
        case Missing is
            insertAt: Index;
    end;

    """
    Sort the buffer in ascending order and hand it back.  Stable.  Aborts,
    as Standard.Buffer does, when memory runs out.
    """
    generic [T: Type(TotalOrder)]
    function sort(buffer: Buffer[T]): Buffer[T]
        ensures length(&result) = old(length(&buffer));

    """
    Whether every element is less than or equal to the one after it.  An
    empty buffer and a buffer of one element are sorted.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [T: Type(TotalOrder), R: Region]
    function isSorted(buffer: &[Buffer[T], R]): Bool;

    """
    Search a sorted buffer for key, in O(log n) comparisons.  With
    duplicates, Found names the first of them.  On a buffer that is not
    sorted the answer is some position, and not a meaningful one; nothing
    checks, because checking would cost the O(n) the search exists to
    avoid.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [T: Type(TotalOrder), R: Region, S: Region]
    function binarySearch(buffer: &[Buffer[T], R], key: &[T, S]): Search;
end module.
