import Standard.Testing (
    assertTrue,
    assertFalse,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    storeNth,
    asSpan
);
import Standard.Csrf (
    csrfKeyBytes,
    csrfToken,
    csrfValid,
    changingMethod,
    sameOriginRequest
);

module body Standard.Csrf.Test is
    -- A fixed test key of 32 bytes; a real one comes from the secret store.
    constant key: Span[Nat8, Static] := "0123456789abcdef0123456789abcdef";
    constant sessionA: Span[Nat8, Static] := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    constant sessionB: Span[Nat8, Static] := "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";

    function testTokenRoundTrip(): Unit is
        assertTrue(csrfKeyBytes() = 32, "32 bytes of key");
        case csrfToken(key, sessionA) of
            when Some(value as token: String) do
                assertTrue(length(&token) = 64, "64 hexadecimal digits");
                assertTrue(csrfValid(key, sessionA, asSpan(&token)), "the token of its session");
                assertFalse(csrfValid(key, sessionB, asSpan(&token)), "not the token of another session");
                assertFalse(csrfValid("0123456789abcdef0123456789abcdeX", sessionA, asSpan(&token)), "not under another key");
                var changed: String := token;
                let last: Nat8 := nthByte(&changed, 63);
                if last = '0' then
                    storeNth(&!changed, 63, '1');
                else
                    storeNth(&!changed, 63, '0');
                end if;
                assertFalse(csrfValid(key, sessionA, asSpan(&changed)), "one digit changed");
                destroyString(changed);
            when None do
                assertFailure("no token");
        end case;
        assertFalse(csrfValid(key, sessionA, ""), "an empty field");
        assertFalse(csrfValid(key, "", ""), "no session");
        return nil;
    end;

    -- 31 bytes of key are refused, 32 taken.
    function testShortKey(): Unit is
        case csrfToken("0123456789abcdef0123456789abcde", sessionA) of
            when Some(value as token: String) do
                destroyString(token);
                assertFailure("a key of 31 bytes was taken");
            when None do
                assertTrue(true, "a key of 31 bytes is refused");
        end case;
        return nil;
    end;

    function testMethods(): Unit is
        assertFalse(changingMethod("GET"), "GET");
        assertFalse(changingMethod("HEAD"), "HEAD");
        assertFalse(changingMethod("OPTIONS"), "OPTIONS");
        assertTrue(changingMethod("POST"), "POST");
        assertTrue(changingMethod("DELETE"), "DELETE");
        assertTrue(changingMethod("get"), "a method in small letters is not GET");
        return nil;
    end;

    function testOrigin(): Unit is
        assertTrue(sameOriginRequest("same-origin", "", "https://example.org"), "same origin");
        assertTrue(sameOriginRequest("none", "", "https://example.org"), "typed by the user");
        assertFalse(sameOriginRequest("cross-site", "https://example.org", "https://example.org"), "cross-site, whatever the origin says");
        assertFalse(sameOriginRequest("same-site", "", "https://example.org"), "another origin of the same site");
        assertTrue(sameOriginRequest("", "https://Example.org", "https://example.org"), "the origin without regard to case");
        assertFalse(sameOriginRequest("", "https://evil.example", "https://example.org"), "another origin");
        assertFalse(sameOriginRequest("", "https://example.org.evil.example", "https://example.org"), "a longer origin");
        assertFalse(sameOriginRequest("", "null", "https://example.org"), "the null origin");
        assertTrue(sameOriginRequest("", "", "https://example.org"), "no header, not a browser");
        return nil;
    end;
end module body.
