"""
A task that is handed an arena of its own, which ends with the task.

- spawnWithArena makes an arena of at least the capacity asked for and starts the task with it.
- Only arenaAllocate and arenaSpan on that arena take from it; all else is allocated as usual.
- The arena is Linear: the task hands it back with its result and cannot drop it.
- The arena is freed as the task ends, before join sees the result; its used part is overwritten.
- The argument is checked as spawn's is: no reference or span in it, at any depth (H3002).
- Left hands the argument back, untouched, when the arena or the task could not be made.

    case spawnWithArena(&!scope, work, request, 65536) of
        when Right(right as task: Task[Reply]) do
            answer(join(task));
        when Left(left as unused: Request) do
            refuse(unused);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Arena (
    Arena
);
import Standard.Task (
    Scope,
    Task
);

module Standard.TaskArena is
    """
    A value with an arena beside it: what a task of spawnWithArena gets,
    its argument and its arena, and what it gives back, its result and the
    arena.  A public record, so that the task takes it apart with a let.
    """
    record WithArena[V: Type]: Linear is
        value: V;
        arena: Arena;
    end;

    """
    Start work as a task in scope, with argument and a new arena of at
    least capacity bytes.

    Left hands the argument back, untouched, when the arena could not be
    made or no task could be started; nothing is kept.  The arena is freed
    when the task ends -- whatever arena the task hands back, it is that
    one that is freed -- and its used part is overwritten first, as
    freeArena does.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [A: Type, T: Type, R: Region]
    function spawnWithArena(scope: &![Scope, R],
        work: Fn[WithArena[A], WithArena[T]],
        argument: A,
        capacity: ByteSize): Either[A, Task[T]];
end module.
