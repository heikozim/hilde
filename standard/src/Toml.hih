"""
TOML as version 1.0.0 of its specification defines it, read strictly and then asked by path.

- A document is checked from its first byte to its last before any value is read from it.
- A path is the keys from the top down, joined by dots as in TOML, and an array index in brackets.
- The empty path is the whole document; a path that leads nowhere or to another kind gives None.
- Reading refuses rather than guesses: the Left is a TomlFault with its line and column.
- Nothing here aborts on bad input.
- Arrays and inline tables may be nested mostDepth deep, which is 128.
- Integers are kept as Int64, floats and dates and times as the text they were written in.

    case readToml(asSpan(&text)) of
        when Right(right as parsed: Toml) do
            let port: Option[Int64] := integerAt(&parsed, "servers[1].port");
            destroyToml(parsed);
        when Left(left as error: TomlError) do
            report(error.line, error.column);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Toml is
    """
    What was wrong with a text readToml refused.
    """
    union TomlFault: Free is
        """
        The text ends inside a value, a string, a key or a table's name.
        """
        case CutShort;
        """
        A byte that cannot stand where it stands, such as a lone carriage
        return, or anything but a comment after a value on its line.
        """
        case ByteOutOfPlace;
        """
        A string with an escape TOML does not have, a unicode escape that
        is no scalar value, or a control character.
        """
        case BadString;
        """
        An integer or a float not written as TOML writes one, or an
        integer past Int64.
        """
        case BadNumber;
        """
        A date or a time not written as TOML writes one, or not in the
        calendar.
        """
        case BadDateTime;
        """
        Bytes that are not UTF-8.
        """
        case NotUtf8;
        """
        A key defined twice, or a table defined twice, after its keys were
        set with dotted keys, or after it was closed as an inline table.
        """
        case DefinedTwice;
        """
        Arrays and inline tables nested deeper than mostDepth.
        """
        case NestedTooDeep;
    end;

    """
    A refusal: what was wrong, and the line and the column where it was
    found, both counted from 1, the column in bytes.
    """
    record TomlError: Free is
        fault: TomlFault;
        line: Index;
        column: Index;
    end;

    """
    The kind of a value.
    """
    union TomlKind: Free is
        case TomlString;
        case TomlInteger;
        case TomlFloat;
        case TomlBoolean;
        """
        A date and a time with an offset from UTC, as in
        1979-05-27T07:32:00Z.
        """
        case TomlOffsetDateTime;
        """
        A date and a time without an offset.
        """
        case TomlLocalDateTime;
        case TomlLocalDate;
        case TomlLocalTime;
        case TomlArray;
        case TomlTable;
    end;

    """
    How deep arrays and inline tables may be nested: 128.
    """
    constant mostDepth: Index;

    """
    A document that has been read.  Linear: destroyToml gives it back.
    """
    type Toml: Linear;

    """
    Read and check a whole text.  The Right is the document, the Left the
    first thing that was wrong with it.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readToml(text: Span[Nat8, R]): Either[TomlError, Toml];

    """
    Frees document.
    No contract: it only frees or closes what it is given.
    """
    function destroyToml(document: Toml): Unit;

    """
    The kind of the value at path, None when there is none.  A path that
    is not written as a path is None too.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function kindAt(document: &[Toml, R], path: Span[Nat8, P]): Option[TomlKind];

    """
    The string at path, its escapes decoded; None for any other kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function stringAt(document: &[Toml, R], path: Span[Nat8, P]): Option[String];

    """
    The integer at path; None for any other kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function integerAt(document: &[Toml, R], path: Span[Nat8, P]): Option[Int64];

    """
    The float at path as it was written, without underscores: 3.1415,
    -2e-3, inf, -inf, nan; None for any other kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function floatAt(document: &[Toml, R], path: Span[Nat8, P]): Option[String];

    """
    The Bool at path; None for any other kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function boolAt(document: &[Toml, R], path: Span[Nat8, P]): Option[Bool];

    """
    The date, time or both at path as written, a lower-case t or a space
    between date and time made a capital T and a lower-case z a capital
    Z; None for any other kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function dateTimeAt(document: &[Toml, R], path: Span[Nat8, P]): Option[String];

    """
    How many elements the array at path holds, or keys the table at path;
    None for a value of another kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function countAt(document: &[Toml, R], path: Span[Nat8, P]): Option[Index];

    """
    The key number n, from 0, of the table at path, in the order the keys
    were defined; None past the last or for another kind.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function keyAt(document: &[Toml, R], path: Span[Nat8, P], n: Index): Option[String];
end module.
