"""
The binary form of an owning array: a header with magic, version, element type, rank and shape, then the elements.

- All numbers are little endian: eight bytes for an extent, the width of the type for an element.
- The decoder checks magic, version, element type, rank, every extent and the length before it takes any element.
- A value that is cut, too long, inconsistent or out of range is refused with the reason, and nothing is allocated for it.
- Decoding takes time linear in the length, and encoding writes exactly encodedSize bytes.
- Only a packed array is written; copy a view first.

    let written: Index := encode(&a, &!out);
    case decode(received) of
        when Right(right as b: Array) do
            destroy(b);
        when Left(left as e: DecodeError) do
            skip;
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.Array (
    Array
);
import Standard.Buffer (
    Buffer,
    length
);

module Standard.ArrayWire is
    """
    Why a value was refused.  describe gives the text of each.
    """
    union DecodeError: Free is
        case TooShort;
        case BadMagic;
        case BadVersion;
        case BadFlags;
        case BadElementType;
        case BadRank;
        case BadExtent;
        case TooLarge;
        case BadLength;
        case BadBool;
    end;

    """
    The version of the form, 1.
    """
    function wireVersion(): Nat8
        ensures result = 1;

    """
    The size of the header of an array of the rank, 8 bytes and 8 for each axis.
    """
    function headerSize(axes: Index): Index
        requires (axes >= 1) and (axes <= 4)
        ensures result = (8 + (8 * axes));

    """
    The number of bytes encode writes for the array.
    """
    generic [R: Region]
    function encodedSize(a: &[Array, R]): Index
        ensures result > 8;

    """
    Append the encoded array to out and return the number of bytes written.
    """
    generic [R: Region, Q: Region]
    function encode(a: &[Array, R], out: &![Buffer[Nat8], Q]): Index
        ensures result = encodedSize(a)
        ensures length(&out) = (old(length(&out)) + result);

    """
    The array that bytes spell, or the reason it was refused.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decode(bytes: Span[Nat8, R]): Either[DecodeError, Array];

    """
    A short text for the reason.
    """
    function describe(error: DecodeError): Span[Nat8, Static]
        ensures spanLength(result) > 0;
end module.
