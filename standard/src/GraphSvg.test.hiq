import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    fromSpan
);
import Standard.Text (
    constantTimeEqual,
    contains
);
import Standard.Buffer (
    Buffer,
    length,
    nth,
    destroyFree
);
import Standard.Tuples (
    Pair
);
import Standard.Graph (
    Graph,
    NodeId,
    EdgeId,
    makeGraph,
    addNode,
    addEdge,
    removeNode,
    nodeCount,
    nodes,
    destroyEmpty
);
import Standard.GraphSvg (
    GraphOptions,
    makeGraphOptions,
    renderGraph
);

module body Standard.GraphSvg.Test is
    -- Compares the document with the expected bytes and frees it.
    function sameAs(made: String, expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        assertTrue(constantTimeEqual(asSpan(&made), expected), message);
        destroyString(made);
        return nil;
    end;

    -- Joins two nodes with an edge of no value.
    generic [R: Region]
    function linked(graph: &![Graph[String, Unit], R], source: NodeId, target: NodeId): Unit is
        let added: Either[Unit, EdgeId] := addEdge(graph, source, target, nil);
        case added of
            when Right(right as made: EdgeId) do
                skip;
            when Left(left as given: Unit) do
                skip;
        end case;
        return nil;
    end;

    -- Takes every node out of a graph, freeing its label, and destroys the
    -- empty rest.
    function dropLabelled(graph: Graph[String, Unit]): Unit is
        var rest: Graph[String, Unit] := graph;
        while nodeCount(&rest) > 0 do
            let all: Buffer[NodeId] := nodes(&rest);
            let head: NodeId := nth(&all, 0);
            case removeNode(&!rest, head) of
                when Some(value as taken: Pair[String, Buffer[Unit]]) do
                    let { first: String, second: Buffer[Unit] } := taken;
                    destroyString(first);
                    destroyFree(second);
                when None do
                    skip;
            end case;
            destroyFree(all);
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function testEmptyGraph(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        sameAs(renderGraph(&g, makeGraphOptions(400, 300)),
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"300\" viewBox=\"0 0 400 300\" class=\"svg-graph\" />",
            "an empty graph is a bare document");
        destroyEmpty(g);
        return nil;
    end;

    function testSingleNode(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        addNode(&!g, fromSpan("only"));
        sameAs(renderGraph(&g, makeGraphOptions(400, 300)),
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"400\" height=\"300\" viewBox=\"0 0 400 300\" class=\"svg-graph\"><circle class=\"graph-node\" cx=\"200\" cy=\"150\" r=\"20\" fill=\"currentColor\" /><text class=\"graph-label\" text-anchor=\"middle\" x=\"200\" y=\"155\">only</text></svg>",
            "a single node stands in the middle");
        dropLabelled(g);
        return nil;
    end;

    -- A chain of three nodes stands on three layers, one under the other.
    function testLayeredChain(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        let a: NodeId := addNode(&!g, fromSpan("a"));
        let b: NodeId := addNode(&!g, fromSpan("b"));
        let c: NodeId := addNode(&!g, fromSpan("c"));
        linked(&!g, a, b);
        linked(&!g, b, c);
        let svg: String := renderGraph(&g, makeGraphOptions(400, 300));
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"100\" cy=\"150\" r=\"20\""), "the first node is on the first layer");
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"200\" cy=\"150\" r=\"20\""), "the second node is on the second layer");
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"300\" cy=\"150\" r=\"20\""), "the third node is on the third layer");
        assertTrue(contains(asSpan(&svg),
            "<line class=\"graph-edge\" stroke=\"currentColor\" x1=\"120\" y1=\"150\" x2=\"172\" y2=\"150\" />"),
            "the first edge is a line between the rims");
        assertTrue(contains(asSpan(&svg),
            "<polygon class=\"graph-edge\" fill=\"currentColor\" points=\"180,150 172,146 172,154\" />"),
            "the first edge carries an arrowhead");
        assertTrue(contains(asSpan(&svg),
            "points=\"280,150 272,146 272,154\""), "the second edge carries an arrowhead");
        destroyString(svg);
        dropLabelled(g);
        return nil;
    end;

    -- A diamond: the two middle nodes stand on one layer, side by side in
    -- the order of their slots.
    function testLayeredDiamond(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        let a: NodeId := addNode(&!g, fromSpan("top"));
        let b: NodeId := addNode(&!g, fromSpan("left"));
        let c: NodeId := addNode(&!g, fromSpan("right"));
        let d: NodeId := addNode(&!g, fromSpan("bottom"));
        linked(&!g, a, b);
        linked(&!g, a, c);
        linked(&!g, b, d);
        linked(&!g, c, d);
        let svg: String := renderGraph(&g, makeGraphOptions(400, 300));
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"100\" cy=\"150\" r=\"20\""), "the top is alone on its layer");
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"200\" cy=\"100\" r=\"20\""), "the first middle node is above");
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"200\" cy=\"200\" r=\"20\""), "the second middle node is below");
        assertTrue(contains(asSpan(&svg),
            "<circle class=\"graph-node\" cx=\"300\" cy=\"150\" r=\"20\""), "the bottom is alone on its layer");
        destroyString(svg);
        dropLabelled(g);
        return nil;
    end;

    -- A graph with a cycle is drawn on a circle: the two nodes of a cycle
    -- of two stand on one horizontal line through the middle.
    function testCycleDrawnOnCircle(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        let a: NodeId := addNode(&!g, fromSpan("a"));
        let b: NodeId := addNode(&!g, fromSpan("b"));
        linked(&!g, a, b);
        linked(&!g, b, a);
        let svg: String := renderGraph(&g, makeGraphOptions(400, 300));
        assertTrue(contains(asSpan(&svg), "<circle class=\"graph-node\" cx=\"320\" cy=\"150\" r=\"20\""),
            "the first node of the cycle stands on the right");
        assertTrue(contains(asSpan(&svg), "<circle class=\"graph-node\" cx=\"80\" cy=\"150\" r=\"20\""),
            "the second node of the cycle stands on the left");
        assertTrue(contains(asSpan(&svg),
            "<polygon class=\"graph-edge\" fill=\"currentColor\" points=\"100,150 108,154 108,146\" />"),
            "the edge back stands on the circle too");
        destroyString(svg);
        dropLabelled(g);
        return nil;
    end;

    function testLabelEscaped(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        addNode(&!g, fromSpan("a<b>&\"c\"'d"));
        let svg: String := renderGraph(&g, makeGraphOptions(400, 300));
        assertTrue(contains(asSpan(&svg), ">a&lt;b&gt;&amp;&quot;c&quot;&#39;d</text>"),
            "the label is escaped");
        assertTrue(not contains(asSpan(&svg), "<b>"), "no label byte breaks out of a tag");
        destroyString(svg);
        dropLabelled(g);
        return nil;
    end;

    -- A node that leads to itself is drawn as nothing, and the options
    -- classes reach the parts.
    function testSelfEdgeAndClasses(): Unit is
        var g: Graph[String, Unit] := makeGraph();
        let only: NodeId := addNode(&!g, fromSpan("loop"));
        linked(&!g, only, only);
        let options: GraphOptions := GraphOptions(width => 400, height => 300, nodeClass => "n", edgeClass => "e",
            labelClass => "l", nodeFill => "blue", edgeStroke => "red");
        let svg: String := renderGraph(&g, options);
        assertTrue(contains(asSpan(&svg), "<circle class=\"n\" cx=\"320\" cy=\"150\" r=\"20\" fill=\"blue\" />"),
            "the options reach the circle");
        assertTrue(contains(asSpan(&svg), "<text class=\"l\""), "the options reach the label");
        assertTrue(not contains(asSpan(&svg), "<line"), "an edge to the node itself is drawn as nothing");
        assertTrue(not contains(asSpan(&svg), "<polygon"), "no arrowhead without an edge");
        destroyString(svg);
        dropLabelled(g);
        return nil;
    end;
end module body.
