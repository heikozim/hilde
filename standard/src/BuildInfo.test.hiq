import Standard.Testing (
    assertTrue
);
import Standard.BuildInfo (
    commit,
    dirty,
    builtAt,
    compilerVersion,
    valueCount,
    valueName,
    valueText,
    value
);

module body Standard.BuildInfo.Test is
    -- hilde test gives no values, and the commit is the one of the tree
    -- the test runs in, or none.
    function testWithoutValues(): Unit is
        let size: Index := spanLength(commit());
        assertTrue((size = 0) or (size = 40) or (size = 64), "commit length");
        assertTrue((not dirty()) or (size > 0), "dirty only with a commit");
        assertTrue(builtAt() > 0, "time");
        assertTrue(spanLength(compilerVersion()) > 0, "compiler version");
        assertTrue(valueCount() = 0, "no values");
        assertTrue(spanLength(valueName(0)) = 0, "no name past the end");
        assertTrue(spanLength(valueText(0)) = 0, "no text past the end");
        case value("channel") of
            when Some(value as found: Span[Nat8, Static]) do
                assertTrue(spanLength(found) > 1024, "no value for a name not given");
            when None do
                assertTrue(true, "none");
        end case;
        return nil;
    end;
end module body.
