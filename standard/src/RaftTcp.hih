"""
The messages of Standard.Raft over TCP: each one as bytes behind a length of four bytes.

- Every number is written most significant byte first, in a fixed width.
- A frame holds at most frameLimit bytes; a longer length is refused before anything is read.
- decodeMessage takes only bytes that are one well-formed message and nothing after it.
- Every count and length read is checked against the bytes that are really there.
- The connections are Standard.File's: the caller listens, connects, accepts and closes.

    let sent: Bool := sendMessage(&!socket, &message);
    let next: Option[Message] := receiveMessage(&!socket);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String,
    length
);
import Standard.File (
    FileDescriptor
);
import Standard.Raft (
    Message
);

module Standard.RaftTcp is
    """
    The most bytes the body of one frame may have: 16777216.
    """
    function frameLimit(): Index
        ensures result = 16777216;

    """
    The bytes of message, without the length in front: 70 at the least,
    the fixed fields and three counts.
    """
    generic [R: Region]
    function encodeMessage(message: &[Message, R]): String
        ensures length(&result) >= 70;

    """
    The message the bytes hold.  None when they end too early, go on after
    the message, carry a count or a length the bytes cannot hold, or are
    not a well-formed message of Standard.Raft.
    No contract: a parser whose None is its answer to bytes that are no message.
    """
    generic [R: Region]
    function decodeMessage(bytes: Span[Nat8, R]): Option[Message];

    """
    Writes message to socket as one frame: its length in four bytes, then
    its bytes.  False when the message is longer than frameLimit or a
    write failed.
    No contract: the result is that of the writes.
    """
    generic [S: Region, R: Region]
    function sendMessage(socket: &![FileDescriptor, S], message: &[Message, R]): Bool;

    """
    Reads one frame from socket and decodes it.  None when the connection
    ended or failed, the length is over frameLimit, or the bytes are no
    message.
    No contract: the result is that of the reads.
    """
    generic [S: Region]
    function receiveMessage(socket: &![FileDescriptor, S]): Option[Message];
end module.
