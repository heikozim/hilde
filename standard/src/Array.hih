"""
Arrays of numbers with a shape, strides and an element type, and views that share their bytes.

- An Array owns its bytes and is linear; destroy gives them back. A View only borrows them.
- Rank is 1 to maxRank, every extent at least 1, and the element count at most maxElements.
- Slicing, picking, swapping axes and broadcasting make a new View and copy no element.
- Broadcasting follows the rules of NumPy: axes line up from the end, and an extent of 1 stretches.
- The element types are Nat8, Int32, Int64, Float32, Float64 and Bool, named by the codes of the type functions.
- A wrong shape, element type or index is a requires that fails, and the programme stops there.
- An element is found in time linear in the rank.

    var a: Array := zeros(float64Type(), shape2(2, 3));
    setFloat64(&!a, 4, 2.5);
    let n: Index := size(&a);
    destroy(a);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Array is
    """
    An array that owns its elements, packed in row-major order.  Linear.
    """
    type Array: Linear;

    """
    A borrowed look at the elements of an array, with its own shape, strides and offset.
    """
    type View[R: Region]: Free;

    """
    The extents of an array or a view, from one axis to maxRank.
    """
    type Shape: Free;

    ---
    --- Limits and element types
    ---

    """
    The largest rank, 4.
    """
    function maxRank(): Index
        ensures result = 4;

    """
    The largest element count of an array, 2147483648.
    """
    function maxElements(): Index
        ensures result = 2147483648;

    """
    The code of the element type Nat8, 0.  It is the type of plain bytes.
    """
    function nat8Type(): Nat8
        ensures result = 0;

    """
    The code of the element type Int32, 1.
    """
    function int32Type(): Nat8
        ensures result = 1;

    """
    The code of the element type Int64, 2.
    """
    function int64Type(): Nat8
        ensures result = 2;

    """
    The code of the element type Float32, 5.
    """
    function float32Type(): Nat8
        ensures result = 5;

    """
    The code of the element type Float64, 6.
    """
    function float64Type(): Nat8
        ensures result = 6;

    """
    The code of the element type Bool, 7.
    """
    function boolType(): Nat8
        ensures result = 7;

    """
    Whether code names one of the six element types.
    No contract: a Bool answer to a question about the argument alone.
    """
    function isElementType(code: Nat8): Bool;

    """
    The width of one element of the type, in bytes.
    """
    function elementSize(code: Nat8): Index
        requires isElementType(code)
        ensures (result >= 1) and (result <= 8);

    ---
    --- Shapes
    ---

    """
    The shape of a vector of a elements.
    """
    function shape1(a: Index): Shape
        requires (a >= 1) and (a <= maxElements())
        ensures rank(result) = 1;

    """
    The shape of a matrix of a rows and b columns.
    """
    function shape2(a: Index, b: Index): Shape
        requires (a >= 1) and (a <= maxElements())
        requires (b >= 1) and (b <= maxElements())
        requires (a * b) <= maxElements()
        ensures rank(result) = 2;

    """
    The shape of an array of rank 3.
    """
    function shape3(a: Index, b: Index, c: Index): Shape
        requires (a >= 1) and (a <= maxElements())
        requires (b >= 1) and (b <= maxElements())
        requires (c >= 1) and (c <= maxElements())
        requires (a * b) <= maxElements()
        requires ((a * b) * c) <= maxElements()
        ensures rank(result) = 3;

    """
    The shape of an array of rank 4.
    """
    function shape4(a: Index, b: Index, c: Index, d: Index): Shape
        requires (a >= 1) and (a <= maxElements())
        requires (b >= 1) and (b <= maxElements())
        requires (c >= 1) and (c <= maxElements())
        requires (d >= 1) and (d <= maxElements())
        requires (a * b) <= maxElements()
        requires ((a * b) * c) <= maxElements()
        requires (((a * b) * c) * d) <= maxElements()
        ensures rank(result) = 4;

    """
    The number of axes of the shape.
    """
    function rank(form: Shape): Index
        ensures (result >= 1) and (result <= 4);

    """
    The extent of the shape along axis.
    """
    function extent(form: Shape, axis: Index): Index
        requires axis < rank(form)
        ensures (result >= 1) and (result <= 2147483648);

    """
    The extent along axis, or 1 for an axis from the rank up to maxRank.
    """
    function paddedExtent(form: Shape, axis: Index): Index
        requires axis < 4
        ensures (result >= 1) and (result <= 2147483648);

    """
    The number of elements, the product of the extents.
    """
    function count(form: Shape): Index
        ensures (result >= 1) and (result <= 2147483648);

    """
    Whether both shapes have the same rank and the same extents.
    No contract: a Bool answer to a question about the arguments alone.
    """
    function sameShape(a: Shape, b: Shape): Bool;

    """
    Whether a view of the shape source can be stretched to the shape target by
    broadcasting: target has at least the rank of source, and along the axes lined
    up from the end each extent is equal or the one of source is 1.
    No contract: a Bool answer to a question about the arguments alone.
    """
    function isBroadcastable(source: Shape, target: Shape): Bool;

    """
    The shape two operands are stretched to, or None when an axis lined up
    from the end has two extents that differ and neither is 1.
    No contract: an Option result, which an ensures cannot look into.
    """
    function broadcastShapes(a: Shape, b: Shape): Option[Shape];

    """
    The number of elements two shapes stretch to together, or 0 when they
    do not broadcast.  It is the count of the shape broadcastShapes gives,
    as one number that a contract can compare.
    """
    function broadcastCount(a: Shape, b: Shape): Index
        ensures (result = 0) or ((result >= 1) and (result <= 2147483648));

    """
    The shape of the product of a matrix of shape a and one of shape b.  The
    columns of a must be the rows of b.
    """
    function productShape(a: Shape, b: Shape): Shape
        requires rank(a) = 2
        requires rank(b) = 2
        requires extent(a, 1) = extent(b, 0)
        ensures rank(result) = 2
        ensures extent(result, 0) = extent(a, 0)
        ensures extent(result, 1) = extent(b, 1);

    ---
    --- Owning arrays
    ---

    """
    An array of the shape with every element zero (false for Bool).  Aborts
    when the memory cannot be had.
    """
    function zeros(kind: Nat8, form: Shape): Array
        requires isElementType(kind)
        ensures elementType(&result) = kind
        ensures size(&result) = count(form);

    """
    Give an array back.
    No contract: it only frees or closes what it is given.
    """
    function destroy(a: Array): Unit;

    """
    The code of the element type of the array.
    """
    generic [R: Region]
    function elementType(a: &[Array, R]): Nat8
        ensures isElementType(result);

    """
    The shape of the array.
    """
    generic [R: Region]
    function shape(a: &[Array, R]): Shape
        ensures count(result) = size(a);

    """
    The number of elements of the array.
    """
    generic [R: Region]
    function size(a: &[Array, R]): Index
        ensures (result >= 1) and (result <= 2147483648);

    """
    The number of bytes the elements of the array take.
    """
    generic [R: Region]
    function byteCount(a: &[Array, R]): Index
        ensures result = (size(a) * elementSize(elementType(a)));

    """
    Store a Nat8 at the ordinal k, counted in row-major order.
    """
    generic [R: Region]
    function setNat8(a: &![Array, R], k: Index, value: Nat8): Unit
        requires elementType(&a) = nat8Type()
        requires k < size(&a)
        ensures size(&a) = old(size(&a));

    """
    Store an Int32 at the ordinal k, counted in row-major order.
    """
    generic [R: Region]
    function setInt32(a: &![Array, R], k: Index, value: Int32): Unit
        requires elementType(&a) = int32Type()
        requires k < size(&a)
        ensures size(&a) = old(size(&a));

    """
    Store an Int64 at the ordinal k, counted in row-major order.
    """
    generic [R: Region]
    function setInt64(a: &![Array, R], k: Index, value: Int64): Unit
        requires elementType(&a) = int64Type()
        requires k < size(&a)
        ensures size(&a) = old(size(&a));

    """
    Store a Float32 at the ordinal k, counted in row-major order.
    """
    generic [R: Region]
    function setFloat32(a: &![Array, R], k: Index, value: Float32): Unit
        requires elementType(&a) = float32Type()
        requires k < size(&a)
        ensures size(&a) = old(size(&a));

    """
    Store a Float64 at the ordinal k, counted in row-major order.
    """
    generic [R: Region]
    function setFloat64(a: &![Array, R], k: Index, value: Float64): Unit
        requires elementType(&a) = float64Type()
        requires k < size(&a)
        ensures size(&a) = old(size(&a));

    """
    Store a Bool at the ordinal k, counted in row-major order.
    """
    generic [R: Region]
    function setBool(a: &![Array, R], k: Index, value: Bool): Unit
        requires elementType(&a) = boolType()
        requires k < size(&a)
        ensures size(&a) = old(size(&a));

    ---
    --- Views
    ---

    """
    A view of the whole array, contiguous, in the region of the borrow.
    """
    generic [R: Region]
    function view(a: &[Array, R]): View[R]
        ensures viewElementType(result) = elementType(a)
        ensures viewSize(result) = size(a)
        ensures isContiguous(result);

    """
    The code of the element type of the view.
    """
    generic [R: Region]
    function viewElementType(v: View[R]): Nat8
        ensures isElementType(result);

    """
    The shape of the view.
    """
    generic [R: Region]
    function viewShape(v: View[R]): Shape
        ensures count(result) = viewSize(v);

    """
    The number of axes of the view.
    """
    generic [R: Region]
    function viewRank(v: View[R]): Index
        ensures (result >= 1) and (result <= 4);

    """
    The number of elements of the view.
    """
    generic [R: Region]
    function viewSize(v: View[R]): Index
        ensures (result >= 1) and (result <= 2147483648);

    """
    The extent of the view along axis.
    """
    generic [R: Region]
    function viewExtent(v: View[R], axis: Index): Index
        requires axis < viewRank(v)
        ensures (result >= 1) and (result <= 2147483648);

    """
    The step along axis, counted in elements.  It is 0 along a broadcast axis.
    """
    generic [R: Region]
    function viewStride(v: View[R], axis: Index): Index
        requires axis < viewRank(v)
        ensures result <= 2147483648;

    """
    The position of the first element of the view in the bytes it looks at,
    counted in elements.
    """
    generic [R: Region]
    function viewOffset(v: View[R]): Index
        ensures result < 2147483648;

    """
    Whether the view runs through its bytes in row-major order without a gap.
    No contract: a Bool answer to a question about the argument alone.
    """
    generic [R: Region]
    function isContiguous(v: View[R]): Bool;

    """
    The view of the part of the array from start up to stop, every step
    elements, along axis.  No element is copied.
    """
    generic [R: Region]
    function sliceAxis(v: View[R], axis: Index, start: Index, stop: Index, step: Index): View[R]
        requires axis < viewRank(v)
        requires step >= 1
        requires start < stop
        requires stop <= viewExtent(v, axis)
        ensures viewRank(result) = viewRank(v)
        ensures viewElementType(result) = viewElementType(v)
        ensures viewExtent(result, axis) <= viewExtent(v, axis);

    """
    The view with axis fixed at position at, so that one axis fewer is left.
    """
    generic [R: Region]
    function pick(v: View[R], axis: Index, at: Index): View[R]
        requires viewRank(v) >= 2
        requires axis < viewRank(v)
        requires at < viewExtent(v, axis)
        ensures viewRank(result) = (viewRank(v) - 1)
        ensures viewElementType(result) = viewElementType(v);

    """
    The view with the axes a and b exchanged.  For a matrix this is the
    transpose.
    """
    generic [R: Region]
    function swapAxes(v: View[R], a: Index, b: Index): View[R]
        requires a < viewRank(v)
        requires b < viewRank(v)
        ensures viewRank(result) = viewRank(v)
        ensures viewSize(result) = viewSize(v);

    """
    The view stretched to the shape target, with a step of 0 along each axis it
    repeats.  The shape of v must be broadcastable to it.
    """
    generic [R: Region]
    function broadcast(v: View[R], target: Shape): View[R]
        requires isBroadcastable(viewShape(v), target)
        ensures sameShape(viewShape(result), target)
        ensures viewElementType(result) = viewElementType(v);

    """
    The ordinal, in row-major order, of the element at the coordinates.  The
    coordinates from the rank up to maxRank are 0.
    """
    generic [R: Region]
    function ordinal(v: View[R], c0: Index, c1: Index, c2: Index, c3: Index): Index
        requires c0 < paddedExtent(viewShape(v), 0)
        requires c1 < paddedExtent(viewShape(v), 1)
        requires c2 < paddedExtent(viewShape(v), 2)
        requires c3 < paddedExtent(viewShape(v), 3)
        ensures result < viewSize(v);

    """
    The Nat8 at the ordinal k of the view.
    """
    generic [R: Region]
    function getNat8(v: View[R], k: Index): Nat8
        requires viewElementType(v) = nat8Type()
        requires k < viewSize(v);

    """
    The Int32 at the ordinal k of the view.
    """
    generic [R: Region]
    function getInt32(v: View[R], k: Index): Int32
        requires viewElementType(v) = int32Type()
        requires k < viewSize(v);

    """
    The Int64 at the ordinal k of the view.
    """
    generic [R: Region]
    function getInt64(v: View[R], k: Index): Int64
        requires viewElementType(v) = int64Type()
        requires k < viewSize(v);

    """
    The Float32 at the ordinal k of the view.
    """
    generic [R: Region]
    function getFloat32(v: View[R], k: Index): Float32
        requires viewElementType(v) = float32Type()
        requires k < viewSize(v);

    """
    The Float64 at the ordinal k of the view.
    """
    generic [R: Region]
    function getFloat64(v: View[R], k: Index): Float64
        requires viewElementType(v) = float64Type()
        requires k < viewSize(v);

    """
    The Bool at the ordinal k of the view.
    """
    generic [R: Region]
    function getBool(v: View[R], k: Index): Bool
        requires viewElementType(v) = boolType()
        requires k < viewSize(v);

    """
    A new array that owns a packed copy of the elements the view reaches, in
    row-major order.  Aborts when the memory cannot be had.
    """
    generic [R: Region]
    function copy(v: View[R]): Array
        ensures elementType(&result) = viewElementType(v)
        ensures size(&result) = viewSize(v);

    """
    The bytes of an array, packed little endian, for the wire format of
    Standard.ArrayWire.  The span lives as long as the borrow.
    """
    generic [R: Region]
    function packedBytes(a: &[Array, R]): Span[Nat8, R]
        ensures spanLength(result) = byteCount(a);

    """
    An array of the element type and shape made from packed little endian
    bytes.  None when the length of bytes is not the byte count of the shape,
    when the element type is unknown, or when a Bool byte is not 0 or 1.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function fromPacked(kind: Nat8, form: Shape, bytes: Span[Nat8, R]): Option[Array];
end module.
