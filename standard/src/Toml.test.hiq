-- Standard.Toml.  Most documents are the examples of the TOML 1.0.0
-- specification.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Order (
    equal
);
import Standard.Toml (
    Toml,
    TomlError,
    TomlFault,
    CutShort,
    ByteOutOfPlace,
    BadString,
    BadNumber,
    BadDateTime,
    NotUtf8,
    DefinedTwice,
    NestedTooDeep,
    TomlKind,
    TomlString,
    TomlInteger,
    TomlFloat,
    TomlBoolean,
    TomlOffsetDateTime,
    TomlLocalDateTime,
    TomlLocalDate,
    TomlLocalTime,
    TomlArray,
    TomlTable,
    readToml,
    destroyToml,
    kindAt,
    stringAt,
    integerAt,
    floatAt,
    boolAt,
    dateTimeAt,
    countAt,
    keyAt
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.Toml.Test is
    function textIs(found: Option[String], want: Span[Nat8, Static]): Bool is
        case found of
            when Some(value as s: String) do
                let w: String := fromLiteral(want);
                let same: Bool := equal(&s, &w);
                if not same then
                    print("got: ");
                    printLn(asSpan(&s));
                end if;
                destroyString(w);
                destroyString(s);
                return same;
            when None do
                printLn("got: none");
                return false;
        end case;
    end;

    function stringIs(found: Option[String], want: String): Bool is
        case found of
            when Some(value as s: String) do
                let same: Bool := equal(&s, &want);
                destroyString(s);
                destroyString(want);
                return same;
            when None do
                destroyString(want);
                return false;
        end case;
    end;

    function isNone(found: Option[String]): Bool is
        case found of
            when Some(value as s: String) do
                destroyString(s);
                return false;
            when None do
                return true;
        end case;
    end;

    function wholeIs(found: Option[Int64], want: Int64): Bool is
        case found of
            when Some(value as v: Int64) do
                return v = want;
            when None do
                return false;
        end case;
    end;

    function countIs(found: Option[Index], want: Index): Bool is
        case found of
            when Some(value as v: Index) do
                return v = want;
            when None do
                return false;
        end case;
    end;

    function kindNumber(kind: TomlKind): Index is
        case kind of
            when TomlString do
                return 1;
            when TomlInteger do
                return 2;
            when TomlFloat do
                return 3;
            when TomlBoolean do
                return 4;
            when TomlOffsetDateTime do
                return 5;
            when TomlLocalDateTime do
                return 6;
            when TomlLocalDate do
                return 7;
            when TomlLocalTime do
                return 8;
            when TomlArray do
                return 9;
            when TomlTable do
                return 10;
        end case;
    end;

    function kindIs(found: Option[TomlKind], want: Index): Bool is
        case found of
            when Some(value as k: TomlKind) do
                return kindNumber(k) = want;
            when None do
                return false;
        end case;
    end;

    function faultNumber(fault: TomlFault): Index is
        case fault of
            when CutShort do
                return 1;
            when ByteOutOfPlace do
                return 2;
            when BadString do
                return 3;
            when BadNumber do
                return 4;
            when BadDateTime do
                return 5;
            when NotUtf8 do
                return 6;
            when DefinedTwice do
                return 7;
            when NestedTooDeep do
                return 8;
        end case;
    end;

    -- Reading text fails with fault at line and column.
    generic [R: Region]
    function failsAt(text: Span[Nat8, R], fault: TomlFault, line: Index, column: Index): Bool is
        case readToml(text) of
            when Left(left as e: TomlError) do
                let good: Bool := ((faultNumber(e.fault) = faultNumber(fault)) and (e.line = line)) and (e.column = column);
                if not good then
                    print("fault ");
                    print(faultNumber(e.fault));
                    print(" at ");
                    print(e.line);
                    print(":");
                    printLn(e.column);
                end if;
                return good;
            when Right(right as d: Toml) do
                destroyToml(d);
                printLn("read, not refused");
                return false;
        end case;
    end;

    -- Reading text fails, whatever the place.
    generic [R: Region]
    function refused(text: Span[Nat8, R], fault: TomlFault): Bool is
        case readToml(text) of
            when Left(left as e: TomlError) do
                let good: Bool := faultNumber(e.fault) = faultNumber(fault);
                if not good then
                    print("fault ");
                    printLn(faultNumber(e.fault));
                end if;
                return good;
            when Right(right as d: Toml) do
                destroyToml(d);
                printLn("read, not refused");
                return false;
        end case;
    end;

    -- Reading text succeeds.
    generic [R: Region]
    function reads(text: Span[Nat8, R]): Bool is
        case readToml(text) of
            when Left(left as e: TomlError) do
                print("refused: fault ");
                print(faultNumber(e.fault));
                print(" at ");
                print(e.line);
                print(":");
                printLn(e.column);
                return false;
            when Right(right as d: Toml) do
                destroyToml(d);
                return true;
        end case;
    end;

    -- The example at the top of the specification.
    function testSpecificationExample(): Unit is
        let text: Span[Nat8, Static] := "# This is a TOML document\n\ntitle = \"TOML Example\"\n\n[owner]\nname = \"Tom Preston-Werner\"\ndob = 1979-05-27T07:32:00-08:00\n\n[database]\nenabled = true\nports = [ 8000, 8001, 8002 ]\ndata = [ [\"delta\", \"phi\"], [3.14] ]\ntemp_targets = { cpu = 79.5, case = 72.0 }\n\n[servers]\n\n[servers.alpha]\nip = \"192.0.2.1\"\nrole = \"frontend\"\n\n[servers.beta]\nip = \"192.0.2.2\"\nrole = \"backend\"\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                assertTrue(textIs(stringAt(&d, "title"), "TOML Example"), "title");
                assertTrue(textIs(stringAt(&d, "owner.name"), "Tom Preston-Werner"), "owner.name");
                assertTrue(textIs(dateTimeAt(&d, "owner.dob"), "1979-05-27T07:32:00-08:00"), "dob");
                assertTrue(kindIs(kindAt(&d, "owner.dob"), 5), "dob has an offset");
                case boolAt(&d, "database.enabled") of
                    when Some(value as b: Bool) do
                        assertTrue(b, "enabled");
                    when None do
                        assertTrue(false, "enabled is a Bool");
                end case;
                assertTrue(countIs(countAt(&d, "database.ports"), 3), "three ports");
                assertTrue(wholeIs(integerAt(&d, "database.ports[1]"), 8001), "the second port");
                assertTrue(textIs(stringAt(&d, "database.data[0][1]"), "phi"), "an array in an array");
                assertTrue(textIs(floatAt(&d, "database.data[1][0]"), "3.14"), "a float in an array");
                assertTrue(textIs(floatAt(&d, "database.temp_targets.cpu"), "79.5"), "an inline table");
                assertTrue(textIs(keyAt(&d, "servers", 1), "beta"), "the second server");
                assertTrue(textIs(stringAt(&d, "servers.beta.role"), "backend"), "beta's role");
                assertTrue(countIs(countAt(&d, ""), 4), "four keys at the top");
                assertTrue(textIs(keyAt(&d, "", 0), "title"), "the first key at the top");
                assertTrue(isNone(stringAt(&d, "database.ports[3]")), "past the last port: None");
                assertTrue(isNone(stringAt(&d, "database.enabled")), "a Bool asked as a string: None");
                assertTrue(isNone(stringAt(&d, "nothing.here")), "a path to nothing: None");
                assertTrue(isNone(stringAt(&d, "title.")), "a path that is not one: None");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "the example reads");
        end case;
        return nil;
    end;

    -- The four strings and their escapes.
    function testStrings(): Unit is
        let text: Span[Nat8, Static] := "str = \"I'm a string. \\\"You can quote me\\\". Name\\tJos\\u00E9\\nLocation\\tSF.\"\nlit = 'C:\\Users\\nodejs\\templates'\nmulti = \"\"\"\nRoses are red\nViolets are blue\"\"\"\ntrimmed = \"\"\"\\\n       The quick brown \\\n\n       fox jumps over \\\n       the lazy dog.\\\n       \"\"\"\nquotes = \"\"\"Here are two quotation marks: \"\". Simple enough.\"\"\"\nfifteen = '''Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\"'''\nlines = '''\nThe first newline is\ntrimmed in raw strings.\n   All other whitespace\n   is preserved.\n'''\nbig = \"\\U0001F600\"\n\"quoted key\" = 1\n'' = 2\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                var jose: StringBuilder := makeStringBuilder();
                writeString(&!jose, "I'm a string. \"You can quote me\". Name\tJos");
                let c3: Nat8 := 195;
                let a9: Nat8 := 169;
                writeByte(&!jose, c3);
                writeByte(&!jose, a9);
                writeString(&!jose, "\nLocation\tSF.");
                assertTrue(stringIs(stringAt(&d, "str"), finalize(jose)), "escapes, a two-byte letter");
                assertTrue(textIs(stringAt(&d, "lit"), "C:\\Users\\nodejs\\templates"), "a literal keeps its backslashes");
                assertTrue(textIs(stringAt(&d, "multi"), "Roses are red\nViolets are blue"), "the first line end dropped");
                assertTrue(textIs(stringAt(&d, "trimmed"), "The quick brown fox jumps over the lazy dog."), "line-ending backslashes");
                assertTrue(textIs(stringAt(&d, "quotes"), "Here are two quotation marks: \"\". Simple enough."), "two quotes inside");
                assertTrue(textIs(stringAt(&d, "fifteen"), "Here are fifteen quotation marks: \"\"\"\"\"\"\"\"\"\"\"\"\"\"\""), "quotes in a literal");
                assertTrue(textIs(stringAt(&d, "lines"), "The first newline is\ntrimmed in raw strings.\n   All other whitespace\n   is preserved.\n"), "a multi-line literal");
                var face: StringBuilder := makeStringBuilder();
                let f0: Nat8 := 240;
                let x9f: Nat8 := 159;
                let x98: Nat8 := 152;
                let x80: Nat8 := 128;
                writeByte(&!face, f0);
                writeByte(&!face, x9f);
                writeByte(&!face, x98);
                writeByte(&!face, x80);
                assertTrue(stringIs(stringAt(&d, "big"), finalize(face)), "an eight-digit escape");
                assertTrue(wholeIs(integerAt(&d, "\"quoted key\""), 1), "a quoted key");
                assertTrue(wholeIs(integerAt(&d, "''"), 2), "the empty key");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "the strings read");
        end case;
        assertTrue(refused("a = \"\\x\"\n", BadString()), "an escape TOML does not have");
        assertTrue(refused("a = \"\\uD800\"\n", BadString()), "a surrogate");
        assertTrue(refused("a = \"line\nbreak\"\n", BadString()), "a line end in a basic string");
        assertTrue(refused("a = \"open\n", BadString()), "a string left open at the line end");
        assertTrue(failsAt("a = \"open", CutShort(), 1, 5), "a string left open at the end");
        return nil;
    end;

    -- Integers in four bases, and what TOML refuses.
    function testIntegers(): Unit is
        let text: Span[Nat8, Static] := "a = +99\nb = 42\nc = 0\nd = -17\ne = 1_000\nf = 0xDEADBEEF\ng = 0xdead_beef\nh = 0o755\ni = 0b11010110\nj = 9223372036854775807\nk = -9223372036854775808\nl = +0\nm = -0\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                assertTrue(wholeIs(integerAt(&d, "a"), 99), "+99");
                let minus17: Int64 := -17;
                assertTrue(wholeIs(integerAt(&d, "d"), minus17), "-17");
                assertTrue(wholeIs(integerAt(&d, "e"), 1000), "1_000");
                let deadBeef: Int64 := 3735928559;
                assertTrue(wholeIs(integerAt(&d, "f"), deadBeef), "0xDEADBEEF");
                assertTrue(wholeIs(integerAt(&d, "g"), deadBeef), "0xdead_beef");
                assertTrue(wholeIs(integerAt(&d, "h"), 493), "0o755");
                assertTrue(wholeIs(integerAt(&d, "i"), 214), "0b11010110");
                let largest: Int64 := 9223372036854775807;
                assertTrue(wholeIs(integerAt(&d, "j"), largest), "the largest Int64");
                let lowest: Int64 := -9223372036854775807 - 1;
                assertTrue(wholeIs(integerAt(&d, "k"), lowest), "the smallest Int64");
                assertTrue(wholeIs(integerAt(&d, "m"), 0), "-0");
                assertTrue(kindIs(kindAt(&d, "c"), 2), "an integer");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "the integers read");
        end case;
        assertTrue(failsAt("a = 01\n", BadNumber(), 1, 5), "a leading zero");
        assertTrue(refused("a = 1__0\n", BadNumber()), "two underscores");
        assertTrue(refused("a = _1\n", ByteOutOfPlace()), "an underscore first");
        assertTrue(refused("a = 1_\n", BadNumber()), "an underscore last");
        assertTrue(refused("a = 0x\n", BadNumber()), "0x without digits");
        assertTrue(refused("a = +0x1\n", BadNumber()), "a sign before 0x");
        assertTrue(refused("a = 9223372036854775808\n", BadNumber()), "past Int64");
        assertTrue(refused("a = -9223372036854775809\n", BadNumber()), "below Int64");
        assertTrue(refused("a = 0x8000000000000000\n", BadNumber()), "0x past Int64");
        return nil;
    end;

    -- Floats as written, and what TOML refuses.
    function testFloats(): Unit is
        let text: Span[Nat8, Static] := "a = +1.0\nb = 3.1415\nc = -0.01\nd = 5e+22\ne = 1e06\nf = -2E-2\ng = 6.626e-34\nh = 224_617.445_991_228\ni = inf\nj = +inf\nk = -inf\nl = nan\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                assertTrue(textIs(floatAt(&d, "b"), "3.1415"), "3.1415");
                assertTrue(textIs(floatAt(&d, "d"), "5e+22"), "5e+22");
                assertTrue(textIs(floatAt(&d, "h"), "224617.445991228"), "underscores dropped");
                assertTrue(textIs(floatAt(&d, "k"), "-inf"), "-inf");
                assertTrue(textIs(floatAt(&d, "l"), "nan"), "nan");
                assertTrue(kindIs(kindAt(&d, "e"), 3), "1e06 is a float");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "the floats read");
        end case;
        assertTrue(refused("a = .7\n", ByteOutOfPlace()), "no digit before the point");
        assertTrue(refused("a = 7.\n", BadNumber()), "no digit after the point");
        assertTrue(refused("a = 3.e+20\n", BadNumber()), "a point before the exponent");
        assertTrue(refused("a = 1e\n", BadNumber()), "an exponent without digits");
        assertTrue(refused("a = 01.5\n", BadNumber()), "a leading zero");
        return nil;
    end;

    -- Dates and times of the four kinds.
    function testDates(): Unit is
        let text: Span[Nat8, Static] := "odt1 = 1979-05-27T07:32:00Z\nodt2 = 1979-05-27T00:32:00-07:00\nodt3 = 1979-05-27T00:32:00.999999-07:00\nodt4 = 1979-05-27 07:32:00z\nldt1 = 1979-05-27T07:32:00\nld1 = 1979-05-27\nlt1 = 07:32:00\nlt2 = 00:32:00.999999\nleap = 2000-02-29\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                assertTrue(textIs(dateTimeAt(&d, "odt1"), "1979-05-27T07:32:00Z"), "odt1");
                assertTrue(textIs(dateTimeAt(&d, "odt3"), "1979-05-27T00:32:00.999999-07:00"), "a fraction and an offset");
                assertTrue(textIs(dateTimeAt(&d, "odt4"), "1979-05-27T07:32:00Z"), "a space made T, z made Z");
                assertTrue(kindIs(kindAt(&d, "ldt1"), 6), "a local date-time");
                assertTrue(kindIs(kindAt(&d, "ld1"), 7), "a local date");
                assertTrue(kindIs(kindAt(&d, "lt1"), 8), "a local time");
                assertTrue(textIs(dateTimeAt(&d, "lt2"), "00:32:00.999999"), "a time with a fraction");
                assertTrue(textIs(dateTimeAt(&d, "leap"), "2000-02-29"), "a leap day");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "the dates read");
        end case;
        assertTrue(failsAt("a = 1979-02-29\n", BadDateTime(), 1, 5), "not a leap year");
        assertTrue(refused("a = 1979-13-01\n", BadDateTime()), "a thirteenth month");
        assertTrue(refused("a = 25:00:00\n", BadDateTime()), "a hour 25");
        assertTrue(refused("a = 1979-05-27T07:32\n", BadDateTime()), "no seconds");
        assertTrue(refused("a = 1979-05-27T07:32:00+25:00\n", BadDateTime()), "an offset of 25 hours");
        return nil;
    end;

    -- Tables: headers, dotted keys, implicit tables, arrays of tables.
    function testTables(): Unit is
        let text: Span[Nat8, Static] := "name = \"Orange\"\nphysical.color = \"orange\"\nphysical.shape = \"round\"\nsite.\"google.com\" = true\n\n[fruit]\napple.color = \"red\"\napple.taste.sweet = true\n\n[fruit.apple.texture]\nsmooth = true\n\n[x.y.z.w]\n[x]\n\n[[products]]\nname = \"Hammer\"\nsku = 738594937\n\n[[products]]\n\n[[products]]\nname = \"Nail\"\nsku = 284758393\ncolor = \"gray\"\n\n[[fruits]]\nname = \"apple\"\n[fruits.physical]\ncolor = \"red\"\n[[fruits.varieties]]\nname = \"red delicious\"\n[[fruits.varieties]]\nname = \"granny smith\"\n[[fruits]]\nname = \"banana\"\n[[fruits.varieties]]\nname = \"plantain\"\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                assertTrue(textIs(stringAt(&d, "physical.shape"), "round"), "dotted keys");
                case boolAt(&d, "site.\"google.com\"") of
                    when Some(value as b: Bool) do
                        assertTrue(b, "a quoted key with a dot");
                    when None do
                        assertTrue(false, "site.google.com is there");
                end case;
                case boolAt(&d, "fruit.apple.texture.smooth") of
                    when Some(value as b: Bool) do
                        assertTrue(b, "a table below dotted keys");
                    when None do
                        assertTrue(false, "the texture is there");
                end case;
                assertTrue(kindIs(kindAt(&d, "x.y.z"), 10), "an implicit table");
                assertTrue(countIs(countAt(&d, "products"), 3), "three products");
                assertTrue(countIs(countAt(&d, "products[1]"), 0), "an empty product");
                assertTrue(textIs(stringAt(&d, "products[2].color"), "gray"), "the third product");
                assertTrue(textIs(stringAt(&d, "fruits[0].varieties[1].name"), "granny smith"), "a nested array of tables");
                assertTrue(textIs(stringAt(&d, "fruits[1].varieties[0].name"), "plantain"), "the second fruit's variety");
                assertTrue(textIs(stringAt(&d, "fruits[0].physical.color"), "red"), "a table in an element");
                destroyToml(d);
            when Left(left as e: TomlError) do
                print("fault at line ");
                printLn(e.line);
                assertTrue(false, "the tables read");
        end case;
        assertTrue(failsAt("name = \"Tom\"\nname = \"Pradyun\"\n", DefinedTwice(), 2, 1), "a key twice");
        assertTrue(refused("[fruit]\napple = \"red\"\n[fruit]\norange = \"orange\"\n", DefinedTwice()), "a table twice");
        assertTrue(refused("[fruit]\napple.color = \"red\"\n[fruit.apple]\n", DefinedTwice()), "a header for a table of dotted keys");
        assertTrue(refused("fruit.apple = 1\nfruit.apple.smooth = true\n", DefinedTwice()), "a value made a table");
        assertTrue(refused("type = { name = \"Nail\" }\ntype.edible = false\n", DefinedTwice()), "an inline table extended by a dotted key");
        assertTrue(refused("a = { b = 1 }\n[a.c]\n", DefinedTwice()), "an inline table extended by a header");
        assertTrue(refused("a = [1]\n[[a]]\n", DefinedTwice()), "an array extended as an array of tables");
        assertTrue(refused("[[a]]\n[a]\n", DefinedTwice()), "an array of tables named by a header");
        assertTrue(reads("[a.b.c]\nd = 1\n[a]\ne = 2\n"), "a header for an implicit table");
        return nil;
    end;

    -- Arrays, inline tables and what is refused around them.
    function testArraysAndInlineTables(): Unit is
        let text: Span[Nat8, Static] := "integers = [ 1, 2, 3 ]\nnested_mixed_array = [ [ 1, 2 ], [\"a\", \"b\", \"c\"] ]\nstring_array = [ \"all\", 'strings', \"\"\"are the same\"\"\", '''type''' ]\nnumbers = [ 0.1, 0.2, 0.5, 1, 2, 5 ]\ncontributors = [\n  \"Foo Bar <foo@example.com>\",\n  { name = \"Baz Qux\", email = \"bazqux@example.com\", url = \"https://example.com/bazqux\" }\n]\nintegers3 = [\n  1,\n  2, # this is ok\n]\nempty = []\npoint = { x = 1, y = 2 }\nanimal = { type.name = \"pug\" }\n";
        case readToml(text) of
            when Right(right as d: Toml) do
                assertTrue(textIs(stringAt(&d, "nested_mixed_array[1][2]"), "c"), "a nested array");
                assertTrue(textIs(stringAt(&d, "string_array[2]"), "are the same"), "strings of all kinds in one array");
                assertTrue(kindIs(kindAt(&d, "numbers[3]"), 2), "mixed kinds in one array");
                assertTrue(textIs(stringAt(&d, "contributors[1].email"), "bazqux@example.com"), "an inline table in an array");
                assertTrue(countIs(countAt(&d, "integers3"), 2), "a trailing comma and a comment");
                assertTrue(countIs(countAt(&d, "empty"), 0), "an empty array");
                assertTrue(wholeIs(integerAt(&d, "point.y"), 2), "an inline table");
                assertTrue(textIs(stringAt(&d, "animal.type.name"), "pug"), "a dotted key in an inline table");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "the arrays read");
        end case;
        assertTrue(refused("a = [1 2]\n", ByteOutOfPlace()), "no comma between elements");
        assertTrue(refused("a = { b = 1, }\n", ByteOutOfPlace()), "a trailing comma in an inline table");
        assertTrue(refused("a = { b = 1,\n c = 2 }\n", ByteOutOfPlace()), "a line end in an inline table");
        assertTrue(refused("a = { b = 1, b = 2 }\n", DefinedTwice()), "a key twice in an inline table");
        assertTrue(failsAt("a = [1,\n", CutShort(), 1, 5), "an array left open");
        return nil;
    end;

    -- Bytes that do not belong: control characters, a lone carriage
    -- return, bytes that are not UTF-8, anything after a value.
    function testBadBytes(): Unit is
        var b: StringBuilder := makeStringBuilder();
        writeString(&!b, "a = 1\n# comment ");
        let bell: Nat8 := 7;
        writeByte(&!b, bell);
        writeString(&!b, "\n");
        let control: String := finalize(b);
        assertTrue(failsAt(asSpan(&control), ByteOutOfPlace(), 2, 11), "a control character in a comment");
        destroyString(control);
        var c: StringBuilder := makeStringBuilder();
        writeString(&!c, "a = \"x");
        let high: Nat8 := 255;
        writeByte(&!c, high);
        writeString(&!c, "\"\n");
        let bad: String := finalize(c);
        assertTrue(failsAt(asSpan(&bad), NotUtf8(), 1, 7), "a byte that is not UTF-8");
        destroyString(bad);
        assertTrue(failsAt("a = 1\rb = 2\n", ByteOutOfPlace(), 1, 6), "a lone carriage return");
        assertTrue(failsAt("a = 1 b = 2\n", ByteOutOfPlace(), 1, 7), "a second key on one line");
        assertTrue(failsAt("a = 1\nb =\n", ByteOutOfPlace(), 2, 4), "a key without its value");
        assertTrue(failsAt("[table\n", ByteOutOfPlace(), 1, 7), "a header left open");
        assertTrue(reads("a = 1\r\nb = 2\r\n"), "carriage return and line feed");
        assertTrue(reads(""), "the empty document");
        return nil;
    end;

    -- Arrays nested mostDepth deep are read; one level more is refused.
    function testDepth(): Unit is
        var deep: StringBuilder := makeStringBuilder();
        writeString(&!deep, "a = ");
        var i: Index := 0;
        while i < 128 do
            writeByte(&!deep, '[');
            i := i + 1;
        end while;
        let zero: Index := 0;
        i := zero;
        while i < 128 do
            writeByte(&!deep, ']');
            i := i + 1;
        end while;
        writeByte(&!deep, '\n');
        let ok: String := finalize(deep);
        assertTrue(reads(asSpan(&ok)), "128 levels");
        destroyString(ok);
        var deeper: StringBuilder := makeStringBuilder();
        writeString(&!deeper, "a = ");
        i := zero;
        while i < 129 do
            writeByte(&!deeper, '[');
            i := i + 1;
        end while;
        let tooDeep: String := finalize(deeper);
        assertTrue(refused(asSpan(&tooDeep), NestedTooDeep()), "129 levels");
        destroyString(tooDeep);
        return nil;
    end;

    -- Write the number in decimal digits.
    generic [B: Region]
    function writeNumber(out: &![StringBuilder, B], number: Index): Unit is
        let ten: Index := 10;
        if number >= ten then
            writeNumber(&~out, number / ten);
        end if;
        case toNat8(number - ((number / ten) * ten)) of
            when Some(value as digit: Nat8) do
                writeByte(&~out, digit + 48);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- n keys k0 to k(n-1) at the top, each with its number, then extra.
    function manyKeys(n: Index, extra: Span[Nat8, Static]): String is
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < n do
            writeByte(&!builder, 'k');
            writeNumber(&!builder, i);
            writeString(&!builder, " = ");
            writeNumber(&!builder, i);
            writeByte(&!builder, '\n');
            i := i + 1;
        end while;
        writeString(&!builder, extra);
        return finalize(builder);
    end;

    -- Many keys are each found under their own name, a key given again at
    -- the end is refused on its line, and the elements of a long array of
    -- tables keep their order.
    function testManyKeys(): Unit is
        let n: Index := 3000;
        let many: String := manyKeys(n, "");
        case readToml(asSpan(&many)) of
            when Right(right as d: Toml) do
                assertTrue(countIs(countAt(&d, ""), 3000), "3000 keys at the top");
                assertTrue(wholeIs(integerAt(&d, "k0"), 0), "the first key");
                assertTrue(wholeIs(integerAt(&d, "k1234"), 1234), "a key in the middle");
                assertTrue(wholeIs(integerAt(&d, "k2999"), 2999), "the last key");
                assertFalse(wholeIs(integerAt(&d, "k3000"), 3000), "no key past the last");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "3000 keys read");
        end case;
        destroyString(many);
        let twice: String := manyKeys(n, "k5 = 1\n");
        assertTrue(failsAt(asSpan(&twice), DefinedTwice(), 3001, 1), "a key of 3000 given again");
        destroyString(twice);
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < 500 do
            writeString(&!builder, "[[t]]\nv = ");
            writeNumber(&!builder, i);
            writeByte(&!builder, '\n');
            i := i + 1;
        end while;
        let tables: String := finalize(builder);
        case readToml(asSpan(&tables)) of
            when Right(right as d: Toml) do
                assertTrue(countIs(countAt(&d, "t"), 500), "500 elements");
                assertTrue(wholeIs(integerAt(&d, "t[0].v"), 0), "the first element");
                assertTrue(wholeIs(integerAt(&d, "t[250].v"), 250), "an element in the middle");
                assertTrue(wholeIs(integerAt(&d, "t[499].v"), 499), "the last element");
                destroyToml(d);
            when Left(left as e: TomlError) do
                assertTrue(false, "500 elements read");
        end case;
        destroyString(tables);
        return nil;
    end;
end module body.
