-- A safe module.  A number is read digit by digit into an Int64; nine digits
-- at most keep it far below the end of the type.
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Order (
    Ordering,
    LessThan,
    Equal,
    GreaterThan,
    TotalOrder
);

module body Standard.Semver is
    constant mostDigits: Index := 9;

    function mostNumber(): Int64 is
        return 999999999;
    end;

    function makeVersion(major: Int64, minor: Int64, patch: Int64): Version is
        return Version(major => major, minor => minor, patch => patch);
    end;

    -- The digit the byte stands for, or -1 when it is no digit.
    function digitOf(byte: Nat8): Int64 is
        if (byte < '0') or (byte > '9') then
            return -1;
        end if;
        case toInt64(byte - '0') of
            when Some(value as digit: Int64) do
                return digit;
            when None do
                abort("Standard.Semver: a digit did not fit an Int64");
        end case;
    end;

    -- The number of the digits from at to before end, or -1 when they are
    -- not a number of the module's form.
    generic [R: Region]
    function numberOf(text: Span[Nat8, R], at: Index, before: Index): Int64 is
        if (before <= at) or ((before - at) > mostDigits) then
            return -1;
        end if;
        if ((before - at) > 1) and (text[at] = '0') then
            return -1;
        end if;
        var value: Int64 := 0;
        var i: Index := at;
        while i < before do
            let digit: Int64 := digitOf(text[i]);
            if digit < 0 then
                return -1;
            end if;
            value := (value * 10) + digit;
            i := i + 1;
        end while;
        return value;
    end;

    -- Where the next dot stands from at on, or the length of the text when
    -- there is none.
    generic [R: Region]
    function dotFrom(text: Span[Nat8, R], at: Index): Index is
        var i: Index := at;
        while i < spanLength(text) do
            if text[i] = '.' then
                return i;
            end if;
            i := i + 1;
        end while;
        return spanLength(text);
    end;

    generic [R: Region]
    function parseVersion(text: Span[Nat8, R]): Option[Version] is
        let size: Index := spanLength(text);
        if (size < 6) or (text[0] /= 'v') then
            return None();
        end if;
        let first: Index := dotFrom(text, 1);
        if first >= size then
            return None();
        end if;
        let second: Index := dotFrom(text, first + 1);
        if second >= size then
            return None();
        end if;
        if dotFrom(text, second + 1) /= size then
            return None();
        end if;
        let major: Int64 := numberOf(text, 1, first);
        let minor: Int64 := numberOf(text, first + 1, second);
        let patch: Int64 := numberOf(text, second + 1, size);
        if ((major < 0) or (minor < 0)) or (patch < 0) then
            return None();
        end if;
        return Some(value => Version(major => major, minor => minor, patch => patch));
    end;

    generic [R: Region]
    function writeNumber(out: &![StringBuilder, R], number: Int64): Unit is
        if number >= 10 then
            writeNumber(&~out, number / 10);
        end if;
        case toNat8(number - ((number / 10) * 10)) of
            when Some(value as digit: Nat8) do
                writeByte(&~out, '0' + digit);
            when None do
                abort("Standard.Semver: a digit did not fit a Nat8");
        end case;
        return nil;
    end;

    function formatVersion(version: Version): String is
        var out: StringBuilder := makeStringBuilder();
        writeByte(&!out, 'v');
        writeNumber(&!out, version.major);
        writeByte(&!out, '.');
        writeNumber(&!out, version.minor);
        writeByte(&!out, '.');
        writeNumber(&!out, version.patch);
        return finalize(out);
    end;

    function nextPatch(version: Version): Version is
        return Version(major => version.major, minor => version.minor, patch => version.patch + 1);
    end;

    function nextMinor(version: Version): Version is
        return Version(major => version.major, minor => version.minor + 1, patch => 0);
    end;

    function nextMajor(version: Version): Version is
        return Version(major => version.major + 1, minor => 0, patch => 0);
    end;

    function sameMajor(left: Version, right: Version): Bool is
        return left.major = right.major;
    end;

    function compareNumbers(left: Int64, right: Int64): Ordering is
        if left < right then
            return LessThan();
        else if left > right then
            return GreaterThan();
        end if;
        return Equal();
    end;

    function orderOf(left: Version, right: Version): Ordering is
        if left.major /= right.major then
            return compareNumbers(left.major, right.major);
        else if left.minor /= right.minor then
            return compareNumbers(left.minor, right.minor);
        end if;
        return compareNumbers(left.patch, right.patch);
    end;

    function greaterVersion(left: Version, right: Version): Version is
        case orderOf(left, right) of
            when LessThan do
                return right;
            when Equal do
                return left;
            when GreaterThan do
                return left;
        end case;
    end;

    instance TotalOrder(Version) is
        generic [R: Region, S: Region]
        method compare(a: &[Version, R], b: &[Version, S]): Ordering is
            return orderOf(!a, !b);
        end;
    end;
end module body.
