import Standard.Testing (
    assertTrue
);
import Standard.Database (
    Backend,
    SqliteBackend,
    SqlCipherBackend,
    DbError,
    isUniqueViolation,
    isConstraintViolation,
    isBusy
);
-- The driver is imported for its slots, which class its codes; the
-- open function is not called.
import Standard.Database.Sqlite (
    openSqlite
);

module body Standard.Database.Sqlite.Test is
    function error(backend: Backend, code: Int32): DbError is
        return DbError(backend => backend, code => code);
    end;

    -- The classes for SQLite's extended codes, and a code that is in no class.
    function testClasses(): Unit is
        assertTrue(isUniqueViolation(error(SqliteBackend(), 2067)), "SQLite unique");
        assertTrue(isUniqueViolation(error(SqlCipherBackend(), 1555)), "SQLCipher primary key");
        assertTrue(isConstraintViolation(error(SqliteBackend(), 2067)), "unique is a constraint");
        assertTrue(isConstraintViolation(error(SqliteBackend(), 787)), "SQLite foreign key");
        assertTrue(isConstraintViolation(error(SqliteBackend(), 1299)), "SQLite not null");
        assertTrue(not isUniqueViolation(error(SqliteBackend(), 787)), "a foreign key is not unique");
        assertTrue(isBusy(error(SqliteBackend(), 5)), "SQLite busy");
        assertTrue(isBusy(error(SqliteBackend(), 517)), "SQLite busy snapshot");
        assertTrue(isBusy(error(SqlCipherBackend(), 6)), "SQLCipher locked");
        assertTrue(not isBusy(error(SqliteBackend(), 19)), "a constraint is not busy");
        return nil;
    end;
end module body.
