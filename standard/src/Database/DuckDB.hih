"""
The DuckDB driver of Standard.Database: a programme that imports it can open a DuckDB file.

- It links libduckdb, and only a programme that imports it does.
- The question marks of a statement are sent as they stand.
- The rules of Standard.DuckDB hold: no other file is read or written, and no extension is loaded.

    case openDuckDB("facts.duckdb") of
        when Right(right as opened: Database[Writing]) do
            ...
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Database (
    Database,
    Writing,
    Reading,
    DbError
);

module Standard.Database.DuckDB is
    """
    Open the DuckDB file at path for writing, creating it when it is not
    there, as Standard.DuckDB.openWriter.
    """
    generic [R: Region]
    function openDuckDB(path: Span[Nat8, R]): Either[DbError, Database[Writing]]
        requires spanLength(path) > 0;

    """
    Open an existing DuckDB file for reading only.
    """
    generic [R: Region]
    function openDuckDBReader(path: Span[Nat8, R]): Either[DbError, Database[Reading]]
        requires spanLength(path) > 0;
end module.
