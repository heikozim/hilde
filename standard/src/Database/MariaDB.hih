"""
The MariaDB driver of Standard.Database: a programme that imports it can open a MariaDB connection.

- It links libmariadb, and only a programme that imports it does.
- The question marks of a statement are sent as they stand.

    case openMariaDB("db.example", 3306, "app", "app", password, "/etc/ssl/ca.pem") of
        when Right(right as opened: Database[Writing]) do
            ...
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Database (
    Database,
    Writing,
    Reading,
    DbError
);

module Standard.Database.MariaDB is
    """
    Open a MariaDB connection that may write, over TLS that is required,
    the certificate and its name verified against the CA file caFile, as
    Standard.MariaDB.openWriter.
    """
    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function openMariaDB(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F]): Either[DbError, Database[Writing]]
        requires (spanLength(host) > 0) and (spanLength(database) > 0)
        requires (spanLength(user) > 0) and (spanLength(caFile) > 0)
        requires port > 0;

    """
    Open a MariaDB connection whose transactions are read only.
    """
    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function openMariaDBReader(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F]): Either[DbError, Database[Reading]]
        requires (spanLength(host) > 0) and (spanLength(database) > 0)
        requires (spanLength(user) > 0) and (spanLength(caFile) > 0)
        requires port > 0;
end module.
