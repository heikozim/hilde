"""
The SQLite and SQLCipher driver of Standard.Database: a programme that imports it can open those files.

- It links libsqlcipher, and only a programme that imports it does.
- SQLite is SQLCipher opened without a key, which writes SQLite's own file format.

    case openSqlite("app.db") of
        when Right(right as opened: Database[Writing]) do
            ...
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Database (
    Database,
    Writing,
    Reading,
    DbError
);
import Standard.SqlCipher (
    Key
);

module Standard.Database.Sqlite is
    """
    Open an SQLite file for writing, creating it when it is not there.
    """
    generic [R: Region]
    function openSqlite(path: Span[Nat8, R]): Either[DbError, Database[Writing]]
        requires spanLength(path) > 0;

    """
    Open an existing SQLite file for reading.
    """
    generic [R: Region]
    function openSqliteReader(path: Span[Nat8, R]): Either[DbError, Database[Reading]]
        requires spanLength(path) > 0;

    """
    Open an SQLCipher file for writing with key, which the open takes.
    """
    generic [R: Region]
    function openSqlCipher(path: Span[Nat8, R], key: Key): Either[DbError, Database[Writing]]
        requires spanLength(path) > 0;

    """
    Open an existing SQLCipher file for reading with key.
    """
    generic [R: Region]
    function openSqlCipherReader(path: Span[Nat8, R], key: Key): Either[DbError, Database[Reading]]
        requires spanLength(path) > 0;
end module.
