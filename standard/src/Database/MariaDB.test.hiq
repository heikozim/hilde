import Standard.Testing (
    assertTrue
);
import Standard.Database (
    Backend,
    MariaDBBackend,
    DbError,
    isUniqueViolation,
    isConstraintViolation,
    isBusy
);
-- The driver is imported for its slots, which class its codes; the
-- open function is not called.
import Standard.Database.MariaDB (
    openMariaDB
);

module body Standard.Database.MariaDB.Test is
    function error(backend: Backend, code: Int32): DbError is
        return DbError(backend => backend, code => code);
    end;

    -- The classes for MariaDB's error numbers, and a code that is in no class.
    function testClasses(): Unit is
        assertTrue(isUniqueViolation(error(MariaDBBackend(), 1062)), "MariaDB duplicate entry");
        assertTrue(isUniqueViolation(error(MariaDBBackend(), 1586)), "MariaDB duplicate entry for a key name");
        assertTrue(isConstraintViolation(error(MariaDBBackend(), 1452)), "MariaDB foreign key");
        assertTrue(isConstraintViolation(error(MariaDBBackend(), 1048)), "MariaDB not null");
        assertTrue(not isUniqueViolation(error(MariaDBBackend(), 1452)), "1452 is not unique");
        assertTrue(isBusy(error(MariaDBBackend(), 1213)), "MariaDB deadlock");
        assertTrue(isBusy(error(MariaDBBackend(), 1205)), "MariaDB lock wait timeout");
        assertTrue(not isConstraintViolation(error(MariaDBBackend(), 1064)), "1064 is no constraint");
        assertTrue(not isBusy(error(MariaDBBackend(), -1)), "a code of the MariaDB module");
        return nil;
    end;
end module body.
