import Standard.Testing (
    assertTrue
);
import Standard.Database (
    Backend,
    PostgresBackend,
    DbError,
    isUniqueViolation,
    isConstraintViolation,
    isBusy
);
-- The driver is imported for its slots, which class its codes; the
-- open function is not called.
import Standard.Database.Postgres (
    openPostgres
);

module body Standard.Database.Postgres.Test is
    function error(backend: Backend, code: Int32): DbError is
        return DbError(backend => backend, code => code);
    end;

    -- The classes for PostgreSQL's SQLSTATEs, and a code that is in no class.
    function testClasses(): Unit is
        assertTrue(isUniqueViolation(error(PostgresBackend(), 3505685)), "PostgreSQL 23505");
        assertTrue(isConstraintViolation(error(PostgresBackend(), 3505683)), "PostgreSQL 23503");
        assertTrue(not isUniqueViolation(error(PostgresBackend(), 3505683)), "23503 is not unique");
        assertTrue(isBusy(error(PostgresBackend(), 6718465)), "PostgreSQL 40001");
        assertTrue(not isConstraintViolation(error(PostgresBackend(), 6819553)), "42601 is no constraint");
        assertTrue(not isConstraintViolation(error(PostgresBackend(), -1)), "a code of the module");
        return nil;
    end;
end module body.
