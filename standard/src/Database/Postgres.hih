"""
The PostgreSQL driver of Standard.Database: a programme that imports it can open a PostgreSQL connection.

- It links libpq, and only a programme that imports it does.
- The question marks of a statement become $1, $2, ... before it is sent.

    case openPostgres("db.example", 5432, "app", "app", password, "/etc/ssl/ca.pem") of
        when Right(right as opened: Database[Writing]) do
            ...
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Database (
    Database,
    Writing,
    Reading,
    DbError
);

module Standard.Database.Postgres is
    """
    Open a PostgreSQL connection that may write, over TLS with verify-full
    against the CA file caFile, as Standard.Postgres.openWriter.
    """
    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function openPostgres(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F]): Either[DbError, Database[Writing]]
        requires (spanLength(host) > 0) and (spanLength(database) > 0)
        requires (spanLength(user) > 0) and (spanLength(caFile) > 0)
        requires port > 0;

    """
    Open a PostgreSQL connection whose transactions are read only.
    """
    generic [H: Region, D: Region, U: Region, P: Region, F: Region]
    function openPostgresReader(host: Span[Nat8, H], port: Nat16, database: Span[Nat8, D], user: Span[Nat8, U], password: Span[Nat8, P], caFile: Span[Nat8, F]): Either[DbError, Database[Reading]]
        requires (spanLength(host) > 0) and (spanLength(database) > 0)
        requires (spanLength(user) > 0) and (spanLength(caFile) > 0)
        requires port > 0;
end module.
