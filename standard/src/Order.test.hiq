import Standard.Order (
    Ordering,
    compare,
    equal
);
import Standard.String (
    String,
    fromLiteral,
    makeString,
    destroyString
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.Order.Test is
    -- Nat8.
    function testNat8(): Unit is
        let a: Nat8 := 0;
        assertTrue(equal(&a, &a), "equal() works");
        return nil;
    end;

    function isLess(order: Ordering): Bool is
        case order of
            when LessThan do
                return true;
            when Equal do
                return false;
            when GreaterThan do
                return false;
        end case;
    end;

    function isGreater(order: Ordering): Bool is
        case order of
            when LessThan do
                return false;
            when Equal do
                return false;
            when GreaterThan do
                return true;
        end case;
    end;

    -- Hilde's addition: the other nine integer types.
    -- Int32, Int64, Index, Nat64, ByteSize.
    function testInteger(): Unit is
        let minus: Int32 := -5;
        let plus: Int32 := 3;
        assertTrue(isLess(compare(&minus, &plus)), "Int32: -5 < 3");
        assertTrue(isGreater(compare(&plus, &minus)), "Int32: 3 > -5");
        assertTrue(equal(&minus, &minus), "Int32: -5 = -5");
        let bigMinus: Int64 := -9000000000;
        let smallPlus: Int64 := 1;
        assertTrue(isLess(compare(&bigMinus, &smallPlus)), "Int64: -9e9 < 1");
        let i: Index := 7;
        let j: Index := 70;
        assertTrue(isLess(compare(&i, &j)), "Index: 7 < 70");
        let n: Nat64 := 18446744073709551615;
        let m: Nat64 := 0;
        assertTrue(isGreater(compare(&n, &m)), "Nat64: max > 0");
        let s: ByteSize := 4096;
        assertTrue(equal(&s, &s), "ByteSize: 4096 = 4096");
        let a8: Int8 := -128;
        let b8: Int8 := 127;
        assertTrue(isLess(compare(&a8, &b8)), "Int8: -128 < 127");
        let a16: Nat16 := 65535;
        let b16: Nat16 := 1;
        assertTrue(isGreater(compare(&a16, &b16)), "Nat16: 65535 > 1");
        let a32: Nat32 := 4000000000;
        let b32: Nat32 := 5;
        assertTrue(isGreater(compare(&a32, &b32)), "Nat32: 4e9 > 5");
        let c16: Int16 := -1;
        let d16: Int16 := 0;
        assertTrue(isLess(compare(&c16, &d16)), "Int16: -1 < 0");
        return nil;
    end;

    -- String: bytes, unsigned, shorter prefix first.
    function testString(): Unit is
        let app: String := fromLiteral("app");
        let apple: String := fromLiteral("apple");
        let apply: String := fromLiteral("apply");
        let empty: String := fromLiteral("");
        let high: String := makeString(1, 200);
        let low: String := makeString(1, 100);
        assertTrue(isLess(compare(&app, &apple)), "app < apple");
        assertTrue(isGreater(compare(&apple, &app)), "apple > app");
        assertTrue(isLess(compare(&apple, &apply)), "apple < apply");
        assertTrue(isLess(compare(&empty, &app)), "empty < app");
        assertTrue(equal(&apple, &apple), "apple = apple");
        assertFalse(equal(&apple, &apply), "apple /= apply");
        assertTrue(isGreater(compare(&high, &low)), "byte 200 > byte 100: unsigned");
        destroyString(app);
        destroyString(apple);
        destroyString(apply);
        destroyString(empty);
        destroyString(high);
        destroyString(low);
        return nil;
    end;
end module body.
