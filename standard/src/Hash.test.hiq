-- Standard.Hash.  The SipHash-2-4 values are the paper's and the reference
-- implementation's, for the key 00 to 0f and the messages 00 to n - 1;
-- the SipHash-1-3 values come from the reference in Python that holds
-- those, with its rounds set to one and three.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyFree,
    length as bufferLength,
    insertBack,
    getSpan
);
import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Hash (
    Hashable,
    sipHash13,
    sipHash24,
    hashOf
);
import Standard.Testing (
    assertTrue
);

module body Standard.Hash.Test is
    constant key0: Nat64 := 506097522914230528;
    constant key1: Nat64 := 1084818905618843912;

    -- The bytes 00 to n - 1.
    function counting(n: Index): Buffer[Nat8] is
        var b: Buffer[Nat8] := allocateEmpty();
        var i: Index := 0;
        while i < n do
            case toNat8(i) of
                when Some(value as byte: Nat8) do
                    insertBack(&!b, byte);
                when None do
                    skip;
            end case;
            i := i + 1;
        end while;
        return b;
    end;

    function h24(n: Index): Nat64 is
        let b: Buffer[Nat8] := counting(n);
        var h: Nat64 := 0;
        if n = 0 then
            h := sipHash24(key0, key1, "");
        else
            h := sipHash24(key0, key1, getSpan(&b, 0, n - 1));
        end if;
        destroyFree(b);
        return h;
    end;

    function h13(n: Index): Nat64 is
        let b: Buffer[Nat8] := counting(n);
        var h: Nat64 := 0;
        if n = 0 then
            h := sipHash13(key0, key1, "");
        else
            h := sipHash13(key0, key1, getSpan(&b, 0, n - 1));
        end if;
        destroyFree(b);
        return h;
    end;

    -- the published SipHash-2-4 values hold.
    function testSipHash24(): Unit is
        let v0: Nat64 := 8246050544436514353;
        let v1: Nat64 := 8428550223375919101;
        let v2: Nat64 := 967288799772626778;
        let v15: Nat64 := 11613035633349379557;
        assertTrue(h24(0) = v0, "the empty message");
        assertTrue(h24(1) = v1, "one byte");
        assertTrue(h24(2) = v2, "two bytes");
        assertTrue(h24(15) = v15, "fifteen bytes, the paper's example");
        return nil;
    end;

    -- SipHash-1-3 over lengths around the word of eight.
    function testSipHash13(): Unit is
        let v0: Nat64 := 12370263754033579228;
        let v1: Nat64 := 14552427766023178899;
        let v7: Nat64 := 15245385783003124032;
        let v8: Nat64 := 3931806377309739662;
        let v9: Nat64 := 2712449776846519780;
        let v15: Nat64 := 15213397504630561110;
        let v16: Nat64 := 14722228812742953830;
        let v63: Nat64 := 11320237892036178856;
        assertTrue(h13(0) = v0, "0 bytes");
        assertTrue(h13(1) = v1, "1 byte");
        assertTrue(h13(7) = v7, "7 bytes, one short of a word");
        assertTrue(h13(8) = v8, "8 bytes, a word");
        assertTrue(h13(9) = v9, "9 bytes");
        assertTrue(h13(15) = v15, "15 bytes");
        assertTrue(h13(16) = v16, "16 bytes, two words");
        assertTrue(h13(63) = v63, "63 bytes");
        return nil;
    end;

    -- a string hashes as its bytes; the key changes the hash.
    function testHashable(): Unit is
        let hello: String := fromLiteral("hello");
        let zero: Nat64 := 0;
        let want: Nat64 := 16350172494705860510;
        assertTrue(hashOf(&hello, zero, zero) = want, "hello under the key 0, 0");
        assertTrue(hashOf(&hello, key0, key1) /= want, "another key, another hash");
        destroyString(hello);
        let a: Nat64 := 42;
        let b: Nat64 := 42;
        let c: Nat64 := 43;
        assertTrue(hashOf(&a, key0, key1) = hashOf(&b, key0, key1), "equal numbers, equal hashes");
        assertTrue(hashOf(&a, key0, key1) /= hashOf(&c, key0, key1), "42 and 43 differ");
        let minus_one: Int64 := -1;
        let top: Nat64 := 18446744073709551615;
        assertTrue(hashOf(&minus_one, key0, key1) = hashOf(&top, key0, key1), "-1 hashes as its two's complement");
        return nil;
    end;

    -- The size little-endian bytes of word.
    function littleEndian(word: Nat64, size: Index): Buffer[Nat8] is
        var b: Buffer[Nat8] := allocateEmpty();
        var rest: Nat64 := word;
        let byte_range: Nat64 := 256;
        var i: Index := 0;
        while i < size do
            case toNat8(rem(rest, byte_range)) of
                when Some(value as byte: Nat8) do
                    insertBack(&!b, byte);
                when None do
                    skip;
            end case;
            rest := rest / byte_range;
            i := i + 1;
        end while;
        return b;
    end;

    -- SipHash-1-3 of the size little-endian bytes of word.
    function wordHash(word: Nat64, size: Index): Nat64 is
        let b: Buffer[Nat8] := littleEndian(word, size);
        let h: Nat64 := sipHash13(key0, key1, getSpan(&b, 0, size - 1));
        destroyFree(b);
        return h;
    end;

    -- every integer type hashes as SipHash-1-3 of its little-endian bytes,
    -- a negative one as those of its two's complement.
    function testIntegersHashAsTheirBytes(): Unit is
        let n8: Nat8 := 200;
        let n16: Nat16 := 48879;
        let n32: Nat32 := 3735928559;
        let n64: Nat64 := 18364758544493064720;
        let small64: Nat64 := 7;
        -- An Index is 32 bits on wasm32, so the value fits in 32 bits there.
        let index: Index := 3735928559;
        let i8: Int8 := -1;
        let i16: Int16 := -2;
        let i32: Int32 := -3;
        let i64: Int64 := -9223372036854775807;
        let p32: Int32 := 305419896;
        assertTrue(hashOf(&n8, key0, key1) = wordHash(200, 1), "a Nat8 is one byte");
        assertTrue(hashOf(&n16, key0, key1) = wordHash(48879, 2), "a Nat16 is two bytes");
        assertTrue(hashOf(&n32, key0, key1) = wordHash(3735928559, 4), "a Nat32 is four bytes");
        assertTrue(hashOf(&n64, key0, key1) = wordHash(n64, 8), "a Nat64 is eight bytes");
        assertTrue(hashOf(&small64, key0, key1) = wordHash(7, 8), "a small Nat64 is still eight bytes");
        assertTrue(hashOf(&index, key0, key1) = wordHash(3735928559, 8), "an Index is eight bytes");
        assertTrue(hashOf(&index, key0, key1) /= wordHash(3735928559, 4), "an Index is not four bytes");
        assertTrue(hashOf(&i8, key0, key1) = wordHash(255, 1), "-1 as an Int8 is the byte ff");
        assertTrue(hashOf(&i16, key0, key1) = wordHash(65534, 2), "-2 as an Int16 is fe ff");
        assertTrue(hashOf(&i32, key0, key1) = wordHash(4294967293, 4), "-3 as an Int32 is fd ff ff ff");
        assertTrue(hashOf(&i64, key0, key1) = wordHash(9223372036854775809, 8), "the least Int64 but one");
        assertTrue(hashOf(&p32, key0, key1) = wordHash(305419896, 4), "a positive Int32");
        assertTrue(hashOf(&n8, key0, key1) /= wordHash(200, 2), "a planted wrong length is seen");
        return nil;
    end;
end module body.
