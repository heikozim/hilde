import Standard.Equality (
    partialEq,
    equal
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.Equality.Test is
    -- Unit.
    function testUnit(): Unit is
        let u: Unit := nil;
        assertTrue(partialEq(&u, &u), "nil is partially equivalent to itself.");
        assertTrue(equal(&u, &u), "nil is equal to itself.");
        return nil;
    end;
end module body.
