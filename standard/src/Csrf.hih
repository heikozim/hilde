"""
Protection against cross-site request forgery: a token bound to the session, and origin headers.

- The token is the HMAC-SHA256 of the session token under a key of the server, never stored.
- Another session's token is worth nothing, and an empty session token is never valid.
- A key shorter than csrfKeyBytes gives None from csrfToken and false from csrfValid.
- csrfValid compares in the same time whatever the bytes.
- sameOriginRequest is a second line of defence, from the Sec-Fetch-Site and Origin headers.

    let token: Option[String] := csrfToken(serverKey, session_token);
    if changingMethod(verb) and not csrfValid(serverKey, session_token, submitted) then
        refuse();
    end if;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.Csrf is
    """
    The fewest bytes a key may have: 32.
    """
    function csrfKeyBytes(): Index
        ensures result = 32;

    """
    The token of the session whose token is session_token, as 64
    hexadecimal digits.  None when key is shorter than csrfKeyBytes or
    libcrypto fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, S: Region]
    function csrfToken(key: Span[Nat8, K], session_token: Span[Nat8, S]): Option[String];

    """
    Whether submitted is the token of the session whose token is
    session_token.  False for a short key and for an empty session token.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [K: Region, S: Region, T: Region]
    function csrfValid(key: Span[Nat8, K], session_token: Span[Nat8, S], submitted: Span[Nat8, T]): Bool;

    """
    Whether the method verb changes something and so needs the token:
    every method but the four that RFC 9110 section 9.2.1 calls safe.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function changingMethod(verb: Span[Nat8, R]): Bool;

    """
    Whether a request may be taken by the headers its browser set.
    fetch_site is the value of Sec-Fetch-Site, origin that of Origin, each
    empty when the request had none, and expected_origin the server's own,
    such as https://example.org.  A Sec-Fetch-Site of same-origin or none
    is taken and any other refused; without one, an Origin must be
    expected_origin, compared without regard to case; with neither, which
    only a client that is no browser sends, the request is taken and the
    token has to decide.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [F: Region, O: Region, E: Region]
    function sameOriginRequest(fetch_site: Span[Nat8, F], origin: Span[Nat8, O], expected_origin: Span[Nat8, E]): Bool;
end module.
