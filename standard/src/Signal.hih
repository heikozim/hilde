"""
Signals taken as events, a time limit for shutting down, and PID files.

- A programme that watches a signal is not ended by it; it asks takeSignal or waits with waitSignal.
- No code of the programme runs when a signal arrives; it sees the signal only when it asks.
- A signal that is not watched keeps its default action.
- A process has one watch at a time; stopWatching gives the signals their default action back.
- After limitShutdown the kernel ends a process whose cleaning up takes longer than the limit.
- Hangup is what a rotation of log files sends; the answer is Standard.Log.reopenLog.

    let wanted: Wanted := Wanted(hangup => true, interrupt => true, terminate => true,
                                 user1 => false, user2 => false);
    case watchSignals(wanted) of
        when Some(value as watch: Signals) do
            var signals: Signals := watch;
            while not shutdownRequested(&!signals) do
                let woken: Bool := waitSignal(&!signals, 1000);
            end while;
            let left: Nat32 := limitShutdown(10);
            let restored: Bool := stopWatching(signals);
        when None do
            reportNoWatch();
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Signal is
    """
    The signals a programme can watch: SIGHUP, SIGINT, SIGTERM, SIGUSR1
    and SIGUSR2.
    """
    union SignalKind: Free is
        case Hangup;
        case Interrupt;
        case Terminate;
        case User1;
        case User2;
    end;

    """
    Which signals to watch.
    """
    record Wanted: Free is
        hangup: Bool;
        interrupt: Bool;
        terminate: Bool;
        user1: Bool;
        user2: Bool;
    end;

    """
    The watch over the signals.  Linear: stopWatching gives it back and
    gives the signals their default action again.
    """
    type Signals: Linear;

    """
    Watches the signals wanted.  None when the process watches already,
    when nothing is wanted, or when the kernel refused.
    No contract: an Option result, which an ensures cannot look into.
    """
    function watchSignals(wanted: Wanted): Option[Signals];

    """
    Whether kind arrived since the last takeSignal of kind.  Two arrivals
    in between are one answer true.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function takeSignal(signals: &![Signals, R], kind: SignalKind): Bool;

    """
    Waits until a watched signal arrives that takeSignal has not taken
    yet, or milliseconds have passed, and returns whether there is one;
    takeSignal says which.  Such a signal that arrived before the call
    ends the wait at once.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function waitSignal(signals: &![Signals, R], milliseconds: Nat32): Bool;

    """
    Whether Interrupt or Terminate arrived: takes both.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function shutdownRequested(signals: &![Signals, R]): Bool;

    """
    Stops watching: the default action of every watched signal back.  A
    later watchSignals may watch again.  Returns false when the kernel
    refused to give one back; the watch is over either way.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function stopWatching(signals: Signals): Bool;

    """
    Sends the signal of kind to the process with the number process, as
    kill(2) does: to a daemon whose number a PID file holds, or to this
    process.  Returns false when the number is not above 0 or the kernel
    refused.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function sendSignal(process: Int32, kind: SignalKind): Bool;

    """
    Asks the kernel to end the process with SIGALRM after seconds, for the
    time a shutdown may take; 0 takes a limit back.  Returns the seconds
    that were left of a limit set before, 0 when there was none.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    function limitShutdown(seconds: Nat32): Nat32;

    ---
    --- PID files
    ---

    """
    The number of this process.
    No contract: a number the system or the build gives.
    """
    function processNumber(): Int32;

    """
    Writes the number of this process and a line feed to the file at
    path, created or emptied, mode 0644 so that other processes can read
    it.  Returns false when the path is refused or a write failed.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function writePidFile(path: Span[Nat8, R]): Bool;

    """
    The number in the file at path: decimal digits and at most one line
    feed after them, from 1 to 2147483647.  None when the file cannot be
    read or holds anything else.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readPidFile(path: Span[Nat8, R]): Option[Int32];

    """
    Removes the file at path.  Returns true when it is gone, also when it
    was not there.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function removePidFile(path: Span[Nat8, R]): Bool;
end module.
