--
-- Standard.Map.  Free keys and values,
-- linear keys (String), linear values (String), and the reads through a
-- write borrow.
import Standard.Tuples (
    Pair
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as stringLength
);
import Standard.Order (
    equal
);
import Standard.Map (
    Map,
    makeMap,
    destroyEmpty,
    destroyFree,
    size,
    contains,
    get,
    getRef,
    sizeMut,
    containsMut,
    getMut,
    put,
    replaceValue,
    remove,
    keyAt,
    valueAt,
    removeAt
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.Map.Test is
    function isNone(result: Option[Pair[Int32, Int32]]): Bool is
        case result of
            when Some(value as p: Pair[Int32, Int32]) do
                return false;
            when None do
                return true;
        end case;
    end;

    function isEntry(result: Option[Pair[Int32, Int32]], key: Int32, value: Int32): Bool is
        case result of
            when Some(value as p: Pair[Int32, Int32]) do
                return (p.first = key) and (p.second = value);
            when None do
                return false;
        end case;
    end;

    function isValue(result: Option[Int32], value: Int32): Bool is
        case result of
            when Some(value as v: Int32) do
                return v = value;
            when None do
                return false;
        end case;
    end;

    function isNoValue(result: Option[Int32]): Bool is
        case result of
            when Some(value as v: Int32) do
                return false;
            when None do
                return true;
        end case;
    end;

    function filled(): Map[Int32, Int32] is
        var m: Map[Int32, Int32] := makeMap();
        assertTrue(isNone(put(&!m, 30, 300)), "put 30: new");
        assertTrue(isNone(put(&!m, 10, 100)), "put 10: new");
        assertTrue(isNone(put(&!m, 20, 200)), "put 20: new");
        assertTrue(isNone(put(&!m, 50, 500)), "put 50: new");
        assertTrue(isNone(put(&!m, 40, 400)), "put 40: new");
        return m;
    end;

    -- an empty map.
    function testEmpty(): Unit is
        let m: Map[Int32, Int32] := makeMap();
        let k: Int32 := 1;
        assertTrue(size(&m) = 0, "size 0");
        assertFalse(contains(&m, &k), "contains nothing");
        assertTrue(isNoValue(get(&m, &k)), "get: None");
        destroyEmpty(m);
        return nil;
    end;

    -- put, get, and the entries in the order of the keys.
    function testPutGet(): Unit is
        let m: Map[Int32, Int32] := filled();
        assertTrue(size(&m) = 5, "size 5");
        assertTrue(!keyAt(&m, 0) = 10, "key 0 is 10");
        assertTrue(!keyAt(&m, 1) = 20, "key 1 is 20");
        assertTrue(!keyAt(&m, 2) = 30, "key 2 is 30");
        assertTrue(!keyAt(&m, 3) = 40, "key 3 is 40");
        assertTrue(!keyAt(&m, 4) = 50, "key 4 is 50");
        assertTrue(!valueAt(&m, 2) = 300, "value 2 is 300");
        let twenty: Int32 := 20;
        let twentyFive: Int32 := 25;
        assertTrue(isValue(get(&m, &twenty), 200), "get 20: 200");
        assertTrue(isNoValue(get(&m, &twentyFive)), "get 25: None");
        assertTrue(contains(&m, &twenty), "contains 20");
        assertFalse(contains(&m, &twentyFive), "does not contain 25");
        destroyFree(m);
        return nil;
    end;

    -- put over a key hands back the old entry; replaceValue.
    function testReplace(): Unit is
        var m: Map[Int32, Int32] := filled();
        assertTrue(isEntry(put(&!m, 20, 99), 20, 200), "put 20 again: the old entry 20 -> 200");
        assertTrue(size(&m) = 5, "size still 5");
        let twenty: Int32 := 20;
        assertTrue(isValue(get(&m, &twenty), 99), "get 20: 99");
        case replaceValue(&!m, &twenty, 7) of
            when Right(right as old: Int32) do
                assertTrue(old = 99, "replaceValue 20: Right, the old 99");
            when Left(left as back: Int32) do
                assertTrue(false, "replaceValue 20: Right, the old 99");
        end case;
        let sixty: Int32 := 60;
        case replaceValue(&!m, &sixty, 6) of
            when Right(right as old: Int32) do
                assertTrue(false, "replaceValue 60: Left, the value handed back");
            when Left(left as back: Int32) do
                assertTrue(back = 6, "replaceValue 60: Left, the value handed back");
        end case;
        assertTrue(size(&m) = 5, "replaceValue adds nothing");
        destroyFree(m);
        return nil;
    end;

    -- remove and removeAt.
    function testRemove(): Unit is
        var m: Map[Int32, Int32] := filled();
        let ten: Int32 := 10;
        assertTrue(isEntry(remove(&!m, &ten), 10, 100), "remove 10: the entry");
        assertTrue(isNone(remove(&!m, &ten)), "remove 10 again: None");
        assertTrue(size(&m) = 4, "size 4");
        assertTrue(!keyAt(&m, 0) = 20, "the smallest is now 20");
        let last: Pair[Int32, Int32] := removeAt(&!m, 3);
        assertTrue((last.first = 50) and (last.second = 500), "removeAt 3: 50 -> 500");
        assertTrue(size(&m) = 3, "size 3");
        destroyFree(m);
        return nil;
    end;

    generic [R: Region]
    function stringKeyIs(m: &[Map[String, Index], R], pos: Index, text: Span[Nat8, Static]): Bool is
        let expected: String := fromLiteral(text);
        let same: Bool := equal(keyAt(m, pos), &expected);
        destroyString(expected);
        return same;
    end;

    -- String keys: linear, ordered by their bytes.
    function testStringKeys(): Unit is
        var m: Map[String, Index] := makeMap();
        discardIndexEntry(put(&!m, fromLiteral("pear"), indexOf(1)));
        discardIndexEntry(put(&!m, fromLiteral("apple"), indexOf(2)));
        discardIndexEntry(put(&!m, fromLiteral("fig"), indexOf(3)));
        assertTrue(size(&m) = 3, "size 3");
        assertTrue(stringKeyIs(&m, 0, "apple"), "key 0 apple");
        assertTrue(stringKeyIs(&m, 1, "fig"), "key 1 fig");
        assertTrue(stringKeyIs(&m, 2, "pear"), "key 2 pear");
        let fig: String := fromLiteral("fig");
        case get(&m, &fig) of
            when Some(value as v: Index) do
                assertTrue(v = 3, "get fig: 3");
            when None do
                assertTrue(false, "get fig: 3");
        end case;
        case put(&!m, fromLiteral("fig"), indexOf(30)) of
            when Some(value as old: Pair[String, Index]) do
                let { first: String, second: Index } := old;
                assertTrue(equal(&first, &fig), "put fig again: the old key comes back");
                assertTrue(second = 3, "and the old value 3");
                destroyString(first);
            when None do
                assertTrue(false, "put fig again: the old key comes back");
                assertTrue(false, "and the old value 3");
        end case;
        destroyString(fig);
        while size(&m) > 0 do
            let { first: String, second: Index } := removeAt(&!m, 0);
            destroyString(first);
        end while;
        destroyEmpty(m);
        return nil;
    end;

    function indexOf(n: Index): Index is
        return n;
    end;

    function discardIndexEntry(result: Option[Pair[String, Index]]): Unit is
        case result of
            when Some(value as old: Pair[String, Index]) do
                let { first: String, second: Index } := old;
                destroyString(first);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- String values: getRef, and the old value comes back.
    function testStringValues(): Unit is
        var m: Map[Int32, String] := makeMap();
        discardStringEntry(put(&!m, 1, fromLiteral("one")));
        discardStringEntry(put(&!m, 2, fromLiteral("two")));
        let one: Int32 := 1;
        let three: Int32 := 3;
        assertTrue(lengthIs(getRef(&m, &one), 3), "getRef 1: length 3");
        assertTrue(isAbsent(getRef(&m, &three)), "getRef 3: None");
        let uno: String := fromLiteral("uno");
        let oneText: String := fromLiteral("one");
        case put(&!m, 1, uno) of
            when Some(value as old: Pair[Int32, String]) do
                let { first: Int32, second: String } := old;
                assertTrue(equal(&second, &oneText), "put 1 again: the old value one");
                destroyString(second);
            when None do
                assertTrue(false, "put 1 again: the old value one");
        end case;
        destroyString(oneText);
        while size(&m) > 0 do
            let { first: Int32, second: String } := removeAt(&!m, 0);
            destroyString(second);
        end while;
        destroyEmpty(m);
        return nil;
    end;

    generic [R: Region]
    function lengthIs(found: Option[&[String, R]], n: Index): Bool is
        case found of
            when Some(value as r: &[String, R]) do
                return stringLength(r) = n;
            when None do
                return false;
        end case;
    end;

    generic [R: Region]
    function isAbsent(found: Option[&[String, R]]): Bool is
        case found of
            when Some(value as r: &[String, R]) do
                return false;
            when None do
                return true;
        end case;
    end;

    function discardStringEntry(result: Option[Pair[Int32, String]]): Unit is
        case result of
            when Some(value as old: Pair[Int32, String]) do
                let { first: Int32, second: String } := old;
                destroyString(second);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- A counter raised through a write borrow: read with getMut, written
    -- with replaceValue, a new key with put.
    generic [R: Region]
    function count(m: &![Map[Int32, Int32], R], key: Int32): Unit is
        case getMut(&~m, &key) of
            when Some(value as c: Int32) do
                case replaceValue(&~m, &key, c + 1) of
                    when Right(right as old: Int32) do
                        skip;
                    when Left(left as back: Int32) do
                        skip;
                end case;
            when None do
                case put(&~m, key, 1) of
                    when Some(value as old: Pair[Int32, Int32]) do
                        skip;
                    when None do
                        skip;
                end case;
        end case;
        return nil;
    end;

    -- sizeMut, containsMut, getMut through a write borrow.
    function testWriteBorrow(): Unit is
        var m: Map[Int32, Int32] := makeMap();
        count(&!m, 7);
        count(&!m, 3);
        count(&!m, 7);
        count(&!m, 7);
        let seven: Int32 := 7;
        let three: Int32 := 3;
        let four: Int32 := 4;
        assertTrue(sizeMut(&!m) = 2, "sizeMut 2");
        assertTrue(containsMut(&!m, &seven), "containsMut 7");
        assertFalse(containsMut(&!m, &four), "not containsMut 4");
        assertTrue(isValue(getMut(&!m, &seven), 3), "7 counted 3 times");
        assertTrue(isValue(getMut(&!m, &three), 1), "3 counted once");
        destroyFree(m);
        return nil;
    end;
end module body.
