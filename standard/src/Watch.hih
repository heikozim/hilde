"""
Watching files and directories for changes: inotify on Linux, kqueue on OpenBSD and FreeBSD.

- A watcher holds any number of watches, numbered from 0 in the order they were added.
- A watch of a directory sees a name made, removed or moved in or out of it.
- A watch of a file sees it written, its attributes changed, and it removed or renamed.
- Replacing a watched file with a rename is seen as well, and a symbolic link is followed.
- A wait says which watch changed, within a time limit, and says less than happened, never more.
- Changes that come together may be reported once: look at what is watched, do not count reports.
- On other platforms watchAvailable is false and makeWatcher gives None.

    var watcher: Watcher := made;
    let config: Option[Index] := watchFile(&!watcher, "/etc/app.conf");
    case waitForChange(&!watcher, 5000) of
        when Changed(watch as changed: Index) do
            reload();
        when WaitedOut do
            skip;
        when WatchFailed do
            skip;
    end case;
    destroyWatcher(watcher);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Watch is
    """
    What a wait found.
    """
    union WatchResult: Free is
        """
        The time ran out.
        """
        case WaitedOut;
        """
        The kernel refused the wait.
        """
        case WatchFailed;
        """
        The watch numbered watch changed.
        """
        case Changed is
            watch: Index;
    end;

    """
    A watcher.  Linear: destroyWatcher gives it and its watches back.
    """
    type Watcher: Linear;

    """
    Whether watching is built on this platform: on Linux, OpenBSD and FreeBSD.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function watchAvailable(): Bool;

    """
    A watcher, or None where watching is not built or the kernel refused.
    No contract: an Option result, which an ensures cannot look into.
    """
    function makeWatcher(): Option[Watcher];

    """
    Watches the names of the directory at path.  The watch's number,
    counted from 0 in the order the watches were added; None when the
    path cannot be watched.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function watchDirectory(watcher: &![Watcher, R], path: Span[Nat8, S]): Option[Index];

    """
    Watches the file at path.  The watch's number, as watchDirectory's;
    None when the path cannot be watched.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function watchFile(watcher: &![Watcher, R], path: Span[Nat8, S]): Option[Index];

    """
    Waits at most milliseconds for a change among the watches.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function waitForChange(watcher: &![Watcher, R], milliseconds: Nat32): WatchResult;

    """
    Frees watcher.
    No contract: it only frees or closes what it is given.
    """
    function destroyWatcher(watcher: Watcher): Unit;
end module.
