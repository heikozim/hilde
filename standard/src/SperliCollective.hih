"""
The bytes of the collective frames of Sperli and the reduction of two arrays of numbers.

- The payload of a collective frame is a header of 16 bytes and the data, least significant byte first.
- checkCollective compares a payload with the call it should answer: operation, type, reduce operation, phase, root and sequence.
- combine reduces two arrays element by element; whole numbers wrap around at their width, and no call traps.
- Float numbers are added and multiplied by the rules of the machine; min and max take the second operand only when it is smaller or larger.
- Logical operations read a whole number as true when it is not 0 and give 0 or 1; bitwise operations work on the bits.
- The time of combine is linear in the length of the arrays.

    let payload: String := collectivePayload(bcastOperation(), bytesType(), noReduction(), resultPhase(), 0, 1, "data");
    let verdict: Int32 := checkCollective(asSpan(&payload), bcastOperation(), bytesType(), noReduction(), resultPhase(), 0, 1);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String,
    length
);

module Standard.SperliCollective is
    """
    The type code of a collective frame: 3.
    """
    function collectiveKind(): Nat8
        ensures result = 3;

    """
    The bytes of the header of a collective payload: 16.
    """
    function collectiveHeaderBytes(): Index
        ensures result = 16;

    """
    The most data bytes one collective frame may carry: 16777200.
    """
    function maxCollectiveData(): Index
        ensures result = 16777200;

    """
    The tag a collective frame is kept under while it waits, the first reserved tag: 2147483648.
    """
    function collectiveTag(): Nat32
        ensures result = 2147483648;

    """
    The operation code of barrier: 1.
    """
    function barrierOperation(): Nat8
        ensures result = 1;

    """
    The operation code of bcast: 2.
    """
    function bcastOperation(): Nat8
        ensures result = 2;

    """
    The operation code of reduce: 3.
    """
    function reduceOperation(): Nat8
        ensures result = 3;

    """
    The operation code of allreduce: 4.
    """
    function allreduceOperation(): Nat8
        ensures result = 4;

    """
    The operation code of gather: 5.
    """
    function gatherOperation(): Nat8
        ensures result = 5;

    """
    The operation code of scatter: 6.
    """
    function scatterOperation(): Nat8
        ensures result = 6;

    """
    The element type of plain bytes: 0.
    """
    function bytesType(): Nat8
        ensures result = 0;

    """
    The element type of 32-bit signed whole numbers: 1.
    """
    function int32Type(): Nat8
        ensures result = 1;

    """
    The element type of 64-bit signed whole numbers: 2.
    """
    function int64Type(): Nat8
        ensures result = 2;

    """
    The element type of 32-bit unsigned whole numbers: 3.
    """
    function uint32Type(): Nat8
        ensures result = 3;

    """
    The element type of 64-bit unsigned whole numbers: 4.
    """
    function uint64Type(): Nat8
        ensures result = 4;

    """
    The element type of 32-bit float numbers: 5.
    """
    function float32Type(): Nat8
        ensures result = 5;

    """
    The element type of 64-bit float numbers: 6.
    """
    function float64Type(): Nat8
        ensures result = 6;

    """
    The reduce operation code of no reduction: 0.
    """
    function noReduction(): Nat8
        ensures result = 0;

    """
    The reduce operation code of sum: 1.
    """
    function sumReduction(): Nat8
        ensures result = 1;

    """
    The reduce operation code of min: 2.
    """
    function minReduction(): Nat8
        ensures result = 2;

    """
    The reduce operation code of max: 3.
    """
    function maxReduction(): Nat8
        ensures result = 3;

    """
    The reduce operation code of product: 4.
    """
    function prodReduction(): Nat8
        ensures result = 4;

    """
    The reduce operation code of logical and: 5.
    """
    function landReduction(): Nat8
        ensures result = 5;

    """
    The reduce operation code of logical or: 6.
    """
    function lorReduction(): Nat8
        ensures result = 6;

    """
    The reduce operation code of logical exclusive or: 7.
    """
    function lxorReduction(): Nat8
        ensures result = 7;

    """
    The reduce operation code of bitwise and: 8.
    """
    function bandReduction(): Nat8
        ensures result = 8;

    """
    The reduce operation code of bitwise or: 9.
    """
    function borReduction(): Nat8
        ensures result = 9;

    """
    The reduce operation code of bitwise exclusive or: 10.
    """
    function bxorReduction(): Nat8
        ensures result = 10;

    """
    The phase of a contribution towards the root: 0.
    """
    function contributionPhase(): Nat8
        ensures result = 0;

    """
    The phase of a result from the root: 1.
    """
    function resultPhase(): Nat8
        ensures result = 1;

    """
    The bytes of one element of elementType: 1 for bytes, 4 or 8 for the numbers.
    """
    function elementWidth(elementType: Nat8): Index
        requires elementType <= 6
        ensures (result >= 1) and (result <= 8);

    """
    Whether reduction can be applied to elements of elementType: sum, min,
    max and product to numbers, the logical and bitwise operations to whole
    numbers, the bitwise ones to bytes.  False for no reduction.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function reductionFits(elementType: Nat8, reduction: Nat8): Bool;

    """
    The payload of a collective frame: the 16-byte header for operation,
    elementType, reduction, phase, root and the sequence number of the call,
    then data.
    """
    generic [D: Region]
    function collectivePayload(operation: Nat8, elementType: Nat8, reduction: Nat8, phase: Nat8, root: Nat32, sequence: Nat64, data: Span[Nat8, D]): String
        requires ((operation >= 1) and (operation <= 6)) and ((phase <= 1) and (spanLength(data) <= 16777200))
        ensures length(&result) = (16 + spanLength(data));

    """
    0 when the payload has the header collectivePayload makes for these
    arguments, collectiveMismatch when it is shorter than a header or
    differs in any field.
    No contract: every payload is allowed, a wrong one is an answer.
    """
    generic [P: Region]
    function checkCollective(payload: Span[Nat8, P], operation: Nat8, elementType: Nat8, reduction: Nat8, phase: Nat8, root: Nat32, sequence: Nat64): Int32;

    """
    The data of a collective payload, the bytes behind the header.
    """
    generic [P: Region]
    function collectiveData(payload: Span[Nat8, P]): String
        requires spanLength(payload) >= 16
        ensures length(&result) = (spanLength(payload) - 16);

    """
    The elements of first and second reduced one by one with reduction, the
    first as the left operand.  Left badCollective when the type or
    reduction is unknown or does not fit, the lengths differ, or the length
    is no whole number of elements.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [A: Region, B: Region]
    function combine(elementType: Nat8, reduction: Nat8, first: Span[Nat8, A], second: Span[Nat8, B]): Either[Int32, String];
end module.
