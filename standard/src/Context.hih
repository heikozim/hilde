"""
Cancellation and deadlines that reach a whole chain of calls and tasks.

- A context is done when its canceller or that of any context above it was cancelled.
- It is done as well when its deadline or one of those above it has passed.
- A context is passed down by read reference, into the tasks of a lending scope as well.
- A cancel is seen at once, from any thread.
- A chain of n levels holds at most 2n descriptors and is at most maxDepth deep.
- Context and Canceller are linear: every canceller is cancelled, every context destroyed.

    let root: Context := background();
    case withTimeout(&root, 5000) of
        when Some(value as made: Derived) do
            let { context: Context, canceller: Canceller } := made;
            let budget: Nat32 := remainingMilliseconds(&context, 1000);
            cancel(canceller);
            destroyContext(context);
        when None do
            skip;
    end case;
    destroyContext(root);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Context is
    """
    A place in the chain.  Linear: destroyContext gives back its
    descriptors.
    """
    type Context: Linear;

    """
    What cancels a context made by withCancel or withTimeout and everything
    derived from it.  Linear: it is used up by cancel, which must be called
    when the work is over, as in Go.
    """
    type Canceller: Linear;

    """
    A derived context and its canceller, to be taken apart with a let.
    """
    record Derived: Linear is
        context: Context;
        canceller: Canceller;
    end;

    """
    Why a context is done.
    """
    union Done: Free is
        case NotDone;
        case Cancelled;
        case DeadlineExceeded;
    end;

    """
    The most contexts a chain may have below the background.
    """
    function maxDepth(): Index
        ensures result = 64;

    """
    The root of every chain: never cancelled, without a deadline.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function background(): Context;

    """
    A context below parent that cancel can end.  None when the kernel gave
    no pipe or there was no memory, and when the chain would be deeper
    than maxDepth.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function withCancel(parent: &[Context, R]): Option[Derived];

    """
    As withCancel, with a deadline milliseconds from now as well; the
    parent's deadline stays when it is earlier.  None also where the build
    has no monotonic clock.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function withTimeout(parent: &[Context, R], milliseconds: Nat32): Option[Derived];

    """
    Ends the context of canceller and every context derived from it.
    No contract: its effect is on the system or on what it consumes, which a condition cannot read.
    """
    function cancel(canceller: Canceller): Unit;

    """
    Whether the context is done, and why.  It never waits.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function done(context: &[Context, R]): Done;

    """
    Whether done says anything but NotDone.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isDone(context: &[Context, R]): Bool;

    """
    Waits at most milliseconds until the context is done, and says why it
    is, or NotDone when the time ran out first.  The wait blocks the
    thread; a task that must not block its thread asks done instead.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function waitDone(context: &[Context, R], milliseconds: Nat32): Done;

    """
    The milliseconds a call may take within the context: upTo, or what is
    left of the deadline when that is less, rounded up; 0 when the context
    is done.
    """
    generic [R: Region]
    function remainingMilliseconds(context: &[Context, R], upTo: Nat32): Nat32
        ensures result <= upTo;

    """
    Gives back the context.  Its reading end is closed once no context
    derived from it lives any more; a context derived from it is not
    touched and must be destroyed on its own.
    No contract: it only frees or closes what it is given.
    """
    function destroyContext(context: Context): Unit;
end module.
