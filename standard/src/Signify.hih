"""
Keys and signatures in the files of OpenBSD's signify(1): Ed25519, base64, one comment line.

- A file is a line untrusted comment: and the comment, then one line of base64; the key line alone is taken too.
- A public key is 42 bytes, a secret key 104 and a signature 74, each starting with the algorithm Ed.
- Only a secret key without a passphrase is read or written, as signify -G -n makes it; another is refused.
- A secret key's checksum is checked before it signs, and a signature names the key number it needs.
- A signature is over the bytes of the message, detached, as signify -S writes it without -e.
- Reading refuses rather than guesses: a bad file gives None or false, and nothing aborts on bad input.

    case generateKeys("demo") of
        when Some(value as keys: KeyPair) do
            let { publicKey: String, secretKey: String } := keys;
            case signMessage(asSpan(&secretKey), "text", "verify with demo.pub") of
                when Some(value as signature: String) do
                    let good: Bool := verifyMessage(asSpan(&publicKey), "text", asSpan(&signature));
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String,
    length
);

module Standard.Signify is
    """
    The texts of the two files of a new key, the public key and the secret
    key, each a comment line and a line of base64, ending with a new line.
    """
    record KeyPair: Linear is
        publicKey: String;
        secretKey: String;
    end;

    """
    The length of the base64 line of a public key: 42 bytes give 56
    characters.
    """
    function publicKeyLineLength(): Index
        ensures result = 56;

    """
    A new key from the secure random source, without a passphrase.  The
    comment goes into both files after "untrusted comment: ", the secret
    one with "secret key", the public one with "public key".  None when the
    library fails or the comment holds a new line.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [C: Region]
    function generateKeys(comment: Span[Nat8, C]): Option[KeyPair];

    """
    The signature file of message by the secret key: the comment line and
    the base64 line.  None when the key is not a secret key without a
    passphrase, its checksum does not hold, the comment holds a new line,
    or the library fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, M: Region, C: Region]
    function signMessage(secretKey: Span[Nat8, K], message: Span[Nat8, M], comment: Span[Nat8, C]): Option[String];

    """
    Whether signature is a signature of message by the public key and
    names that key's number.  A text that is no public key or no signature
    gives false.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region, M: Region, G: Region]
    function verifyMessage(publicKey: Span[Nat8, P], message: Span[Nat8, M], signature: Span[Nat8, G]): Bool;

    """
    The base64 line of a public key, from its file or from the line alone,
    when it is a public key of the module's form.  None otherwise.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [P: Region]
    function publicKeyLine(publicKey: Span[Nat8, P]): Option[String];

    """
    The public key of a secret key, as the text of its file with the
    comment given.  None when the secret key is not of the module's form.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, C: Region]
    function publicKeyOf(secretKey: Span[Nat8, K], comment: Span[Nat8, C]): Option[String];

    """
    Frees both texts.
    No contract: it only frees or closes what it is given.
    """
    function destroyKeyPair(keys: KeyPair): Unit;
end module.
