"""
Base64 after RFC 4648, section 4, padded or unpadded.

- The alphabet is A to Z, a to z, 0 to 9, plus and slash; three bytes become four characters.
- The padded form ends with one or two = so that its length is a multiple of four.
- The unpadded form leaves them out, as the strings of password hashes do.
- Decoding refuses rather than guesses: bad input gives None, and nothing aborts on it.

    let text: String := encode(asSpan(&bytes));
    let back: Option[String] := decode(asSpan(&text));
    let salt: Option[String] := decodeUnpadded("c2FsdHNhbHQ");
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String,
    length
);

module Standard.Base64 is
    """
    The bytes in Base64 with padding.  An empty span gives an empty string.
    """
    generic [R: Region]
    function encode(bytes: Span[Nat8, R]): String
        ensures length(&result) = (((spanLength(bytes) + 2) / 3) * 4);

    """
    The bytes in Base64 without padding.  An empty span gives an empty
    string.
    """
    generic [R: Region]
    function encodeUnpadded(bytes: Span[Nat8, R]): String
        ensures length(&result) = (((spanLength(bytes) * 4) + 2) / 3);

    """
    The bytes a padded Base64 text stands for.  None when the text is not
    padded Base64: a byte outside the alphabet, a length that is not a
    multiple of four, padding anywhere but at the end or more of it than
    the length calls for, or bits left over that are not zero.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decode(text: Span[Nat8, R]): Option[String];

    """
    The bytes an unpadded Base64 text stands for.  None for a byte outside
    the alphabet, the padding character among them, a length one more than
    a multiple of four, or bits left over that are not zero.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decodeUnpadded(text: Span[Nat8, R]): Option[String];

    """
    The bytes in the URL alphabet of RFC 4648, section 5, with padding: -
    and _ stand for + and /.
    """
    generic [R: Region]
    function encodeUrl(bytes: Span[Nat8, R]): String
        ensures length(&result) = (((spanLength(bytes) + 2) / 3) * 4);

    """
    The bytes a padded text in the URL alphabet stands for.  None for what
    decode refuses, and for a + or a /, which belong to the other alphabet.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decodeUrl(text: Span[Nat8, R]): Option[String];
end module.
