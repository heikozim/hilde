"""
A builder that collects bytes at its end and hands them over as one String.

- Each write appends at the end; growing aborts when the memory cannot be had.
- writeString copies the bytes of a span, and an empty span adds nothing.
- finalize hands the collected bytes over as a String without copying them.
- A builder is linear: finalize is the only way to end it.
- Nothing here checks that the bytes are UTF-8.

    var builder: StringBuilder := makeStringBuilder();
    writeString(&!builder, "id=");
    writeByte(&!builder, 52);
    let line: String := finalize(builder);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.StringBuilder is
    """
    Bytes being collected.  Linear: finalize ends it.
    """
    type StringBuilder: Linear;

    """
    A builder with no bytes.  Aborts when the memory cannot be had.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function makeStringBuilder(): StringBuilder;

    """
    Appends byte.  Aborts when the memory cannot be had.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region]
    function writeByte(builder: &![StringBuilder, R], byte: Nat8): Unit;

    """
    Appends a copy of the bytes of string; an empty span adds nothing.
    Aborts when the memory cannot be had.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, S: Region]
    function writeString(builder: &![StringBuilder, R], string: Span[Nat8, S]): Unit;

    """
    The collected bytes as a String, without copying them, and the builder
    gone.
    No contract: a text whose length follows its input.
    """
    function finalize(builder: StringBuilder): String;
end module.
