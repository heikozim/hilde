"""
Tables in CSV, as RFC 4180 describes them, read and written.

- A quoted field may hold the separator, a doubled double quote and line breaks; a plain one not.
- Rows end with CR LF or LF, the last one with neither too; an empty line is no row.
- Reading refuses rather than guesses, with the line and the byte where the fault was found.
- Every row has as many fields as the first; text that is not UTF-8 is refused.
- A byte order mark at the start is skipped; nothing aborts on bad input.
- Writing quotes a field only when it has to, and ends every row with CR LF.

    case readCsv(text) of
        when Right(right as table: CsvTable) do
            let rows: Index := rowCount(&table);
            destroyCsv(table);
        when Left(left as error: CsvError) do
            report(error.line, error.offset);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Csv is
    """
    What was wrong with a text readCsv refused.
    """
    union CsvFault: Free is
        """
        A double quote inside a field that did not start with one.
        """
        case QuoteInPlainField;
        """
        Something other than the separator or a line end after the
        closing quote of a field.
        """
        case TextAfterQuote;
        """
        A quoted field the text ends inside.
        """
        case UnclosedQuote;
        """
        Bytes that are not well-formed UTF-8.
        """
        case NotUtf8;
        """
        A row with another number of fields than the first row.
        """
        case RaggedRow;
        """
        A separator that cannot be one: a double quote, a carriage
        return or a line feed.
        """
        case BadSeparator;
    end;

    """
    A refusal: what was wrong, the line it was found on, counting from 1,
    and the byte, counting from 0 in the whole text.
    """
    record CsvError: Free is
        fault: CsvFault;
        line: Index;
        offset: Index;
    end;

    """
    A table that has been read.  Linear: destroyCsv gives it back.
    """
    type CsvTable: Linear;

    """
    Read a whole text with the comma as the separator.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readCsv(text: Span[Nat8, R]): Either[CsvError, CsvTable];

    """
    Read a whole text with the separator given: a comma, a semicolon, a
    tab, or any other byte but a double quote, a carriage return and a
    line feed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readCsvWith(text: Span[Nat8, R], separator: Nat8): Either[CsvError, CsvTable];

    """
    Give a table back.
    No contract: it only frees or closes what it is given.
    """
    function destroyCsv(table: CsvTable): Unit;

    """
    How many rows the table has.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function rowCount(table: &[CsvTable, R]): Index;

    """
    How many fields each row has; 0 for a table without rows.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function columnCount(table: &[CsvTable, R]): Index;

    """
    The field in row and column, counting from 0, with its quotes taken
    off and a doubled quote read as one; None outside the table.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function fieldAt(table: &[CsvTable, R], row: Index, column: Index): Option[Span[Nat8, R]];

    ---
    --- Writing
    ---

    """
    A table being written.  Linear: finishCsv gives it back.
    """
    type CsvWriter: Linear;

    """
    A writer with the comma as the separator.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function makeCsvWriter(): CsvWriter;

    """
    A writer with the separator given; the writer is spoiled by a double
    quote, a carriage return or a line feed.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function makeCsvWriterWith(separator: Nat8): CsvWriter;

    """
    The next field of the current row.  It must be UTF-8.  It is quoted
    only when it holds the separator, a double quote or a line break, or
    is the only field of its row and empty.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, S: Region]
    function writeField(writer: &![CsvWriter, R], field: Span[Nat8, S]): Unit;

    """
    End the current row.  A row without fields spoils the writer, and so
    does one with another number of fields than the first.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region]
    function endRow(writer: &![CsvWriter, R]): Unit;

    """
    The text written.  None when the writer was spoiled, or a row was
    begun and not ended.
    No contract: an Option result, which an ensures cannot look into.
    """
    function finishCsv(writer: CsvWriter): Option[String];
end module.
