"""
A linear, growable array on the heap.

- Every index and every span is checked; one out of range stops the programme with a message.
- Growing aborts when the memory cannot be had; the safe makers give None instead.
- The readers that copy take Free elements; nthRef and swapNth work for linear ones too.
- A buffer is linear: destroyEmpty or destroyFree gives it back.
- insertFront costs time linear in the length of the buffer.

    var prices: Buffer[Nat64] := allocateEmpty();
    insertBack(&!prices, 250);
    let first: Nat64 := nth(&prices, 0);
    destroyFree(prices);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Buffer is
    """
    The buffer type.
    """
    type Buffer[T: Type]: Linear;

    ---
    --- Lifecycle
    ---

    """
    An empty buffer.  Aborts when the memory cannot be had.
    """
    generic [T: Type]
    function allocateEmpty(): Buffer[T]
        ensures length(&result) = 0;

    """
    An empty buffer, or None when the memory cannot be had.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [T: Type]
    function safeAllocateEmpty(): Option[Buffer[T]];

    """
    A buffer of size elements, each a copy of initialElement.  The element
    type is free, so that it can be copied any number of times.  Aborts when
    the memory cannot be had.
    """
    generic [T: Free]
    function initialize(size: Index, initialElement: T): Buffer[T]
        ensures length(&result) = size;

    """
    The same as initialize, but None when the memory cannot be had.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [T: Free]
    function safeInitialize(size: Index, initialElement: T): Option[Buffer[T]];

    """
    Give back a buffer of free elements, whatever it holds.
    No contract: it only frees or closes what it is given.
    """
    generic [T: Free]
    function destroyFree(buffer: Buffer[T]): Unit;

    """
    Give back an empty buffer.  The buffer must be empty: that is the duty of
    the caller, a requires, and a call on a buffer that still holds an element
    stops the programme with the line of the call.
    """
    generic [T: Type]
    function destroyEmpty(buffer: Buffer[T]): Unit
        requires length(&buffer) = 0;

    ---
    --- Retrieve
    ---

    """
    The number of elements.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [T: Type, R: Region]
    function length(buf: &[Buffer[T], R]): Index;

    """
    A copy of the element at pos.
    """
    generic [T: Free, R: Region]
    function nth(buf: &[Buffer[T], R], pos: Index): T
        requires pos < length(buf);

    """
    The same as length, through a write reference.  A caller that holds the
    buffer through a write reference can also write length(&buf): a read
    borrow of a write reference reads what it points to.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [T: Type, R: Region]
    function lengthMut(buf: &![Buffer[T], R]): Index;

    """
    The same as nth, through a write reference.
    """
    generic [T: Free, R: Region]
    function nthMut(buf: &![Buffer[T], R], pos: Index): T
        requires pos < length(&buf);

    """
    A reference to the element at pos, in the region of the borrow of buf.
    Nothing is copied, so it works for a linear element as well.
    """
    generic [T: Type, R: Region]
    function nthRef(buf: &[Buffer[T], R], pos: Index): &[T, R]
        requires pos < length(buf);

    ---
    --- Update
    ---

    """
    Store element at pos.
    """
    generic [T: Free, R: Region]
    function storeNth(buf: &![Buffer[T], R], pos: Index, element: T): Unit
        requires pos < length(&buf)
        ensures length(&buf) = old(length(&buf));

    """
    Store element at pos, and return the element that was there.
    """
    generic [T: Type, R: Region]
    function swapNth(buf: &![Buffer[T], R], pos: Index, element: T): T
        requires pos < length(&buf)
        ensures length(&buf) = old(length(&buf));

    """
    Exchange the elements at a and b.
    """
    generic [T: Type, R: Region]
    function swapIndex(buf: &![Buffer[T], R], a: Index, b: Index): Unit
        requires a < length(&buf)
        requires b < length(&buf)
        ensures length(&buf) = old(length(&buf));

    """
    Replace the element at pos with fn applied to it.
    """
    generic [T: Type, R: Region]
    function swapTransform(buf: &![Buffer[T], R], pos: Index, fn: Fn[T, T]): Unit
        requires pos < length(&buf)
        ensures length(&buf) = old(length(&buf));

    """
    Store element in every position.
    """
    generic [T: Free, R: Region]
    function fill(buf: &![Buffer[T], R], element: T): Unit
        ensures length(&buf) = old(length(&buf));

    ---
    --- Insertion
    ---

    """
    Insert element at pos, from 0 to the length, growing the room when
    needed.  Aborts when the memory cannot be had.
    """
    generic [T: Type, R: Region]
    function insert(buf: &![Buffer[T], R], pos: Index, element: T): Unit
        requires pos <= length(&buf)
        ensures length(&buf) = (old(length(&buf)) + 1);

    """
    Insert element at position zero, moving the others one place up.
    Aborts when the memory cannot be had.
    """
    generic [T: Type, R: Region]
    function insertFront(buf: &![Buffer[T], R], element: T): Unit
        ensures length(&buf) = (old(length(&buf)) + 1);

    """
    Append element.  Aborts when the memory cannot be had.
    """
    generic [T: Type, R: Region]
    function insertBack(buf: &![Buffer[T], R], element: T): Unit
        ensures length(&buf) = (old(length(&buf)) + 1);

    ---
    --- Removal
    ---

    """
    Take the element at pos out and return it.
    """
    generic [T: Type, R: Region]
    function remove(buf: &![Buffer[T], R], pos: Index): T
        requires pos < length(&buf)
        ensures length(&buf) = (old(length(&buf)) - 1);

    """
    Take the first element out and return it.
    """
    generic [T: Type, R: Region]
    function removeFirst(buf: &![Buffer[T], R]): T
        requires length(&buf) > 0
        ensures length(&buf) = (old(length(&buf)) - 1);

    """
    Take the last element out and return it.
    """
    generic [T: Type, R: Region]
    function removeLast(buf: &![Buffer[T], R]): T
        requires length(&buf) > 0
        ensures length(&buf) = (old(length(&buf)) - 1);

    ---
    --- Reversal
    ---

    """
    Reverse the buffer in place.
    """
    generic [T: Type, R: Region]
    function reverse(buf: &![Buffer[T], R]): Unit
        ensures length(&buf) = old(length(&buf));

    ---
    --- Map
    ---

    """
    Replace every element with fn applied to it, in place: swapTransform
    for the whole buffer.
    """
    generic [T: Type, R: Region]
    function inPlaceMap(buf: &![Buffer[T], R], fn: Fn[T, T]): Unit
        ensures length(&buf) = old(length(&buf));

    """
    Consume the buffer and return a new one of the same length, whose
    element at every position is fn applied to the old element there.
    """
    generic [T: Type, U: Type]
    function map(buf: Buffer[T], fn: Fn[T, U]): Buffer[U]
        ensures length(&result) = old(length(&buf));

    """
    The elements from start to final, both included, as a read span.
    """
    generic [T: Type, R: Region]
    function getSpan(buf: &[Buffer[T], R], start: Index, final: Index): Span[T, R]
        requires start <= final
        requires final < length(buf)
        ensures spanLength(result) = ((final - start) + 1);

    """
    The same as a write span.
    """
    generic [T: Type, R: Region]
    function getSpanMut(buf: &![Buffer[T], R], start: Index, final: Index): Span![T, R]
        requires start <= final
        requires final < length(&buf);

    """
    All the elements as a read span.  An empty buffer gives an empty span.
    """
    generic [T: Type, R: Region]
    function wholeSpan(buf: &[Buffer[T], R]): Span[T, R]
        ensures spanLength(result) = length(buf);

    """
    Give back a buffer of free elements after overwriting its storage with
    zeros.  Storage a buffer left when it grew is not overwritten, so a
    buffer for a secret is made at its size and not grown.
    No contract: it only frees or closes what it is given.
    """
    generic [T: Free]
    function destroyWiped(buffer: Buffer[T]): Unit;
end module.
