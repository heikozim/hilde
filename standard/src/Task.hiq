-- A safe module: the fibers, scopes and channels are those of
-- Bindings.Task, wrapped here one record each.  The compiler checks what a
-- task is handed at the calls of this module's spawn and spawnLending.
import Standard.File (
    FileDescriptor
);
import Bindings.Task (
    taskDone as bindTaskDone,
    waitScopeBelow as bindWaitScopeBelow,
    Scope as BindScope,
    openScopeSized as bindOpenScopeSized,
    Task as BindTask,
    Lending as BindLending,
    Sender as BindSender,
    Receiver as BindReceiver,
    Channel as BindChannel,
    tasksAvailable as bindTasksAvailable,
    openScope as bindOpenScope,
    closeScope as bindCloseScope,
    spawn as bindSpawn,
    join as bindJoin,
    yieldNow as bindYieldNow,
    waitReadable as bindWaitReadable,
    waitWritable as bindWaitWritable,
    openLending as bindOpenLending,
    openLendingSized as bindOpenLendingSized,
    closeLending as bindCloseLending,
    spawnLending as bindSpawnLending,
    openChannel as bindOpenChannel,
    send as bindSend,
    receive as bindReceive,
    closeSender as bindCloseSender,
    closeReceiver as bindCloseReceiver,
    Polled as BindPolled,
    tryReceive as bindTryReceive,
    receiveWithin as bindReceiveWithin,
    sleepNanos as bindSleepNanos,
    Selected as BindSelected,
    receiveEither as bindReceiveEither
);

module body Standard.Task is
    function tasksAvailable(): Bool is
        return bindTasksAvailable();
    end;

    ---
    --- Scopes
    ---

    record Scope: Linear is
        inner: BindScope;
    end;

    function openScope(): Option[Scope] is
        case bindOpenScope() of
            when Some(value as scope: BindScope) do
                let some: Option[Scope] := Some(value => Scope(inner => scope));
                return some;
            when None do
                let none: Option[Scope] := None();
                return none;
        end case;
    end;

    function openScopeWithStack(stackBytes: Index): Option[Scope] is
        case bindOpenScopeSized(stackBytes) of
            when Some(value as scope: BindScope) do
                let some: Option[Scope] := Some(value => Scope(inner => scope));
                return some;
            when None do
                let none: Option[Scope] := None();
                return none;
        end case;
    end;

    function closeScope(scope: Scope): Unit is
        let { inner: BindScope } := scope;
        bindCloseScope(inner);
        return nil;
    end;

    ---
    --- Tasks
    ---

    record Task[T: Type]: Linear is
        inner: BindTask[T];
    end;

    generic [A: Type, T: Type, R: Region]
    function spawn(scope: &![Scope, R], work: Fn[A, T], argument: A): Either[A, Task[T]] is
        case bindSpawn(&!(scope->inner), work, argument) of
            when Left(left as back: A) do
                let failed: Either[A, Task[T]] := Left(left => back);
                return failed;
            when Right(right as task: BindTask[T]) do
                let started: Either[A, Task[T]] := Right(right => Task(inner => task));
                return started;
        end case;
    end;

    generic [T: Type]
    function join(task: Task[T]): T is
        let { inner: BindTask[T] } := task;
        return bindJoin(inner);
    end;

    generic [T: Type, R: Region]
    function isDone(task: &[Task[T], R]): Bool is
        return bindTaskDone(&(task->inner));
    end;

    generic [R: Region]
    function awaitFewer(scope: &![Scope, R], count: Index): Unit is
        bindWaitScopeBelow(&!(scope->inner), count);
        return nil;
    end;

    function yieldNow(): Unit is
        bindYieldNow();
        return nil;
    end;

    generic [R: Region]
    function waitReadable(file: &[FileDescriptor, R]): Bool is
        return bindWaitReadable(file);
    end;

    generic [R: Region]
    function waitWritable(file: &[FileDescriptor, R]): Bool is
        return bindWaitWritable(file);
    end;

    ---
    --- Lending scopes
    ---

    record Lending[R: Region]: Linear is
        inner: BindLending[R];
    end;

    generic [T: Type, R: Region]
    function openLending(anchor: &[T, R]): Option[Lending[R]] is
        case bindOpenLending(anchor) of
            when Some(value as scope: BindLending[R]) do
                let some: Option[Lending[R]] := Some(value => Lending(inner => scope));
                return some;
            when None do
                let none: Option[Lending[R]] := None();
                return none;
        end case;
    end;

    generic [T: Type, R: Region]
    function openLendingWithStack(anchor: &[T, R], stackBytes: Index): Option[Lending[R]] is
        case bindOpenLendingSized(anchor, stackBytes) of
            when Some(value as scope: BindLending[R]) do
                let some: Option[Lending[R]] := Some(value => Lending(inner => scope));
                return some;
            when None do
                let none: Option[Lending[R]] := None();
                return none;
        end case;
    end;

    generic [R: Region]
    function closeLending(scope: Lending[R]): Unit is
        let { inner: BindLending[R] } := scope;
        bindCloseLending(inner);
        return nil;
    end;

    generic [A: Type, T: Type, R: Region, S: Region]
    function spawnLending(scope: &![Lending[R], S], work: Fn[A, T], argument: A): Either[A, Task[T]] is
        case bindSpawnLending(&!(scope->inner), work, argument) of
            when Left(left as back: A) do
                let failed: Either[A, Task[T]] := Left(left => back);
                return failed;
            when Right(right as task: BindTask[T]) do
                let started: Either[A, Task[T]] := Right(right => Task(inner => task));
                return started;
        end case;
    end;

    ---
    --- Channels
    ---

    record Sender[T: Type]: Linear is
        inner: BindSender[T];
    end;

    record Receiver[T: Type]: Linear is
        inner: BindReceiver[T];
    end;

    generic [T: Type]
    function openChannel(capacity: Index): Option[Channel[T]] is
        let opened: Option[BindChannel[T]] := bindOpenChannel(capacity);
        case opened of
            when Some(value as ends: BindChannel[T]) do
                let { sender as s: BindSender[T], receiver as r: BindReceiver[T] } := ends;
                let channel: Channel[T] := Channel(sender => Sender(inner => s), receiver => Receiver(inner => r));
                let some: Option[Channel[T]] := Some(value => channel);
                return some;
            when None do
                let none: Option[Channel[T]] := None();
                return none;
        end case;
    end;

    generic [T: Type, R: Region]
    function send(sender: &![Sender[T], R], value: T): Option[T] is
        return bindSend(&!(sender->inner), value);
    end;

    generic [T: Type, R: Region]
    function receive(receiver: &![Receiver[T], R]): Option[T] is
        return bindReceive(&!(receiver->inner));
    end;

    generic [T: Type]
    function closeSender(sender: Sender[T]): Unit is
        let { inner: BindSender[T] } := sender;
        bindCloseSender(inner);
        return nil;
    end;

    generic [T: Type]
    function closeReceiver(receiver: Receiver[T]): Unit is
        let { inner: BindReceiver[T] } := receiver;
        bindCloseReceiver(inner);
        return nil;
    end;

    generic [T: Type, R: Region]
    function tryReceive(receiver: &![Receiver[T], R]): Polled[T] is
        case bindTryReceive(&!(receiver->inner)) of
            when Took(value as v: T) do
                let ready: Polled[T] := Ready(value => v);
                return ready;
            when Nothing do
                let empty: Polled[T] := Empty();
                return empty;
            when Finished do
                let closed: Polled[T] := Closed();
                return closed;
        end case;
    end;

    -- Milliseconds as nanoseconds: every Nat32 fits an Int64 a million
    -- times over.
    function nanosOf(milliseconds: Nat32): Int64 is
        let million: Int64 := 1000000;
        case toInt64(milliseconds) of
            when Some(value as wide: Int64) do
                return wide * million;
            when None do
                return 0;
        end case;
    end;

    generic [T: Type, R: Region]
    function receiveWithin(receiver: &![Receiver[T], R], milliseconds: Nat32): Polled[T] is
        case bindReceiveWithin(&!(receiver->inner), nanosOf(milliseconds)) of
            when Took(value as v: T) do
                let ready: Polled[T] := Ready(value => v);
                return ready;
            when Nothing do
                let empty: Polled[T] := Empty();
                return empty;
            when Finished do
                let closed: Polled[T] := Closed();
                return closed;
        end case;
    end;

    function sleepFor(milliseconds: Nat32): Unit is
        return bindSleepNanos(nanosOf(milliseconds));
    end;

    generic [T: Type, U: Type, R: Region, S: Region]
    function receiveEither(first: &![Receiver[T], R], second: &![Receiver[U], S]): Selected[T, U] is
        case bindReceiveEither(&!(first->inner), &!(second->inner)) of
            when First(value as v: T) do
                let got: Selected[T, U] := FromFirst(value => v);
                return got;
            when Second(value as v: U) do
                let got: Selected[T, U] := FromSecond(value => v);
                return got;
            when Neither do
                let none: Selected[T, U] := AllClosed();
                return none;
        end case;
    end;
end module body.
