"""
Decompositions and the least squares in Float64 over the views of Standard.Array, computed by the routines of the package MircoBlis through the binding of Bindings.Lapack.

- svd gives the thin decomposition of a matrix with at least as many rows as columns: u of the rows by the columns, the singular values in descending order, and vt square of the columns, so that u times the diagonal of the values times vt is the matrix again.
- qr gives the factorization of a matrix with at least as many rows as columns: q of the rows by the columns with orthonormal columns, and r square of the columns and upper triangular, so that q times r is the matrix again.
- lstsq gives the answer of smallest norm of an overdetermined system: a matrix with at least as many rows as columns and a right-hand side of as many elements as the matrix has rows, with the rank of the matrix beside the answer.
- A matrix is read in the row-major order of its view and handed to the routine as a column-major copy; every result comes back as a new owning array in row-major order.
- A rank that is not 2 for a matrix or not 1 for a right-hand side, an element type that is not Float64, fewer rows than columns, a right-hand side that does not match the rows, or a dimension above largestDimension is a requires that fails, and the programme stops there.
- A routine that reports info other than 0 comes back as the Left of the Either with the code of the routine, a negative one for a refused call.  An ensures cannot look into an Either, so the sizes of the answers are held by the invariants of the records and read through accessors whose ensures state them: u carries as many rows as svdRows answers and as many columns as svdColumns answers, the values carry one place per column, vt is square of the columns, q carries as many rows as qrRows answers and as many columns as qrColumns answers, r is square of the columns, and x carries one place per column.
- Importing this module chooses the C backend: a programme that does not import it links no library of the package MircoBlis.

    var a: Array := zeros(float64Type(), shape2(2, 2));
    setFloat64(&!a, 0, 4.0);
    setFloat64(&!a, 1, 3.0);
    setFloat64(&!a, 2, 0.0);
    setFloat64(&!a, 3, 0.0);
    case svd(view(&a)) of
        when Right(right as made: Svd) do
            destroySvd(made);
        when Left(left as code: Int32) do
            skip;
    end case;
    destroy(a);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Array (
    Array,
    View,
    float64Type,
    sameShape,
    shape,
    shape1,
    shape2,
    viewElementType,
    viewExtent,
    viewRank
);

module Standard.ArrayLinalg is
    """
    The largest number of rows or columns a matrix of this module may
    have: the routine of the backend takes every dimension as a 32-bit
    whole number.
    """
    function largestDimension(): Index
        ensures result = 2147483647;

    """
    The thin singular value decomposition of a matrix: u carries as many
    columns as the matrix has columns, the values are the singular values
    in descending order, and vt carries as many rows as the matrix has
    columns, so that u times the diagonal of the values times vt is the
    matrix again.  Linear: destroySvd gives it back.  The record is
    opaque; its sizes are read through svdRows and svdColumns, its
    matrices through uOf, singularValuesOf and vtOf.  Its invariants hold
    the sizes: u has as many rows as svdRows answers and as many columns
    as svdColumns answers, the values carry one place per column, and vt
    is square of the columns.
    """
    type Svd: Linear;

    """
    Give the decomposition back.
    No contract: it only frees or closes what it is given.
    """
    function destroySvd(given: Svd): Unit;

    """
    The rows of the matrix the call decomposed: as many rows as u
    carries.
    """
    generic [R: Region]
    function svdRows(made: &[Svd, R]): Index
        ensures (result >= 1) and (result <= largestDimension());

    """
    The columns of the matrix the call decomposed: as many singular
    values as columns, and vt is square of them.
    """
    generic [R: Region]
    function svdColumns(made: &[Svd, R]): Index
        ensures (result >= 1) and (result <= largestDimension());

    """
    A new array with the elements of u, row major, of as many rows as
    svdRows answers and as many columns as svdColumns answers.
    """
    generic [R: Region]
    function uOf(made: &[Svd, R]): Array
        ensures sameShape(shape(&result), shape2(svdRows(made), svdColumns(made)));

    """
    A new array with the singular values in descending order, of as many
    places as svdColumns answers.
    """
    generic [R: Region]
    function singularValuesOf(made: &[Svd, R]): Array
        ensures sameShape(shape(&result), shape1(svdColumns(made)));

    """
    A new array with the elements of vt, row major, square of as many
    rows and columns as svdColumns answers.
    """
    generic [R: Region]
    function vtOf(made: &[Svd, R]): Array
        ensures sameShape(shape(&result), shape2(svdColumns(made), svdColumns(made)));

    """
    The qr factorization of a matrix: q carries as many columns as the
    matrix has columns and its columns are orthonormal, r is square of
    the columns and upper triangular, so that q times r is the matrix
    again.  Linear: destroyQr gives it back.  The record is opaque; its
    sizes are read through qrRows and qrColumns, its matrices through
    qOf and rOf.  Its invariants hold the sizes: q has as many rows as
    qrRows answers and as many columns as qrColumns answers, and r is
    square of the columns.
    """
    type Qr: Linear;

    """
    Give the factorization back.
    No contract: it only frees or closes what it is given.
    """
    function destroyQr(given: Qr): Unit;

    """
    The rows of the matrix the call factored: as many rows as q carries.
    """
    generic [R: Region]
    function qrRows(made: &[Qr, R]): Index
        ensures (result >= 1) and (result <= largestDimension());

    """
    The columns of the matrix the call factored: as many columns as q
    carries, and r is square of them.
    """
    generic [R: Region]
    function qrColumns(made: &[Qr, R]): Index
        ensures (result >= 1) and (result <= largestDimension());

    """
    A new array with the elements of q, row major, of as many rows as
    qrRows answers and as many columns as qrColumns answers.
    """
    generic [R: Region]
    function qOf(made: &[Qr, R]): Array
        ensures sameShape(shape(&result), shape2(qrRows(made), qrColumns(made)));

    """
    A new array with the elements of r, row major, square of as many
    rows and columns as qrColumns answers, upper triangular.
    """
    generic [R: Region]
    function rOf(made: &[Qr, R]): Array
        ensures sameShape(shape(&result), shape2(qrColumns(made), qrColumns(made)));

    """
    The qr factorization of the matrix a, through geqrf and orgqr.  The
    Left of the Either carries the code of the routine when it reports
    info other than 0, a negative one for a refused call; the Right
    carries the factorization.  The result is an Either, which an
    ensures cannot look into; the sizes of the two answers are held by
    the invariants of Qr and read through qrRows and qrColumns, whose
    ensures state them.
    """
    generic [A: Region]
    function qr(a: View[A]): Either[Int32, Qr]
        requires viewElementType(a) = float64Type()
        requires viewRank(a) = 2
        requires viewExtent(a, 0) >= viewExtent(a, 1)
        requires viewExtent(a, 1) >= 1
        requires viewExtent(a, 0) <= largestDimension();

    """
    The answer of lstsq: x carries one place per column of the matrix
    the call solved, the smallest norm of a x - b over all x, and rank
    carries the rank of that matrix; when the rank is below the column
    count, x is the answer of smallest norm among all.  Linear:
    destroyLstsq gives it back.  The record is opaque; its sizes are
    read through lstsqColumns and lstsqRank, the answer through xOf.
    Its invariants hold the sizes: x carries one place per column, and
    the rank stays at most the column count.
    """
    type Lstsq: Linear;

    """
    Give the answer back.
    No contract: it only frees or closes what it is given.
    """
    function destroyLstsq(given: Lstsq): Unit;

    """
    The columns of the matrix the call solved: as many places as x
    carries.
    """
    generic [R: Region]
    function lstsqColumns(made: &[Lstsq, R]): Index
        ensures (result >= 1) and (result <= largestDimension());

    """
    The rank of the matrix the call solved, at most its column count.
    """
    generic [R: Region]
    function lstsqRank(made: &[Lstsq, R]): Index
        ensures result <= lstsqColumns(made);

    """
    A new array with the answer x, row major, of as many places as
    lstsqColumns answers.
    """
    generic [R: Region]
    function xOf(made: &[Lstsq, R]): Array
        ensures sameShape(shape(&result), shape1(lstsqColumns(made)));

    """
    The least squares answer of the system a x = b, through gelsd: a of
    rank 2 over Float64 with at least as many rows as columns, b of rank
    1 with as many elements as a has rows.  The Left of the Either
    carries the code of the routine when it reports info other than 0, a
    negative one for a refused call; the Right carries the answer with
    the rank.  The result is an Either, which an ensures cannot look
    into; the size of the answer is held by the invariants of Lstsq and
    read through lstsqColumns, whose ensure states it.
    """
    generic [A: Region, B: Region]
    function lstsq(a: View[A], b: View[B]): Either[Int32, Lstsq]
        requires viewElementType(a) = float64Type()
        requires viewElementType(b) = float64Type()
        requires viewRank(a) = 2
        requires viewRank(b) = 1
        requires viewExtent(a, 0) >= viewExtent(a, 1)
        requires viewExtent(a, 1) >= 1
        requires viewExtent(a, 0) <= largestDimension()
        requires viewExtent(b, 0) = viewExtent(a, 0);

    """
    The thin singular value decomposition of the matrix a, through
    gesdd.  The Left of the Either carries the code of the routine when
    it reports info other than 0, a negative one for a refused call; the
    Right carries the decomposition.  The result is an Either, which an
    ensures cannot look into; the sizes of the three answers are held by
    the invariants of Svd and read through svdRows and svdColumns, whose
    ensures state them.
    """
    generic [A: Region]
    function svd(a: View[A]): Either[Int32, Svd]
        requires viewElementType(a) = float64Type()
        requires viewRank(a) = 2
        requires viewExtent(a, 0) >= viewExtent(a, 1)
        requires viewExtent(a, 1) >= 1
        requires viewExtent(a, 0) <= largestDimension();
end module.
