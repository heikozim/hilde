-- A safe module.  Bindings.Sqlite does the work with addresses and C; the
-- handles it gives out are wrapped here, one record each, and the mode of a
-- connection, Writing or Reading, is checked by the types of this module.
import Standard.String (
    String
);
import Bindings.Sqlite (
    libraryVersion as bindLibraryVersion,
    Connection as Handle,
    Transaction as BindTransaction,
    Values as BindValues,
    Cursor as BindCursor,
    SqlError as BindError,
    newer_database as bind_newer_database,
    describe as bindDescribe,
    openWriter as bindOpenWriter,
    openReader as bindOpenReader,
    closeDatabase as bindCloseDatabase,
    migrate as bindMigrate,
    begin as bindBegin,
    commit as bindCommit,
    rollback as bindRollback,
    preparedCount as bindPreparedCount,
    copyText as bindCopyText,
    noValues as bindNoValues,
    withInt64 as bindWithInt64,
    withFloat64 as bindWithFloat64,
    withText as bindWithText,
    withBlob as bindWithBlob,
    withInt64OrNull as bindWithInt64OrNull,
    withFloat64OrNull as bindWithFloat64OrNull,
    withTextOrNull as bindWithTextOrNull,
    withBlobOrNull as bindWithBlobOrNull,
    start as bindStart,
    startWrite as bindStartWrite,
    execute as bindExecute,
    advance as bindAdvance,
    columnKind as bindColumnKind,
    columnCount as bindColumnCount,
    columnInt64 as bindColumnInt64,
    columnFloat64 as bindColumnFloat64,
    columnText as bindColumnText,
    columnBlob as bindColumnBlob,
    columnInt64OrNone as bindColumnInt64OrNone,
    columnFloat64OrNone as bindColumnFloat64OrNone,
    columnTextOrNone as bindColumnTextOrNone,
    columnBlobOrNone as bindColumnBlobOrNone,
    finish as bindFinish
);

module body Standard.Sqlite is
    -- The slot mode carries M so that a constructor can name it.
    record Connection[M: Free]: Linear is
        handle: Handle;
        mode: M;
    end;

    record Transaction: Linear is
        inner: BindTransaction;
    end;

    record Values: Linear is
        inner: BindValues;
    end;

    -- columns is read from SQLite once, when the statement starts, so a
    -- contract can name the column count without calling into C.  It holds
    -- no invariant: advance writes through inner, which uses the reference
    -- up before an invariant could read it again; columnCount ensures the
    -- bound instead.
    record Cursor: Linear is
        inner: BindCursor;
        columns: Int32;
    end;

    constant newer_database: Int32 := bind_newer_database;

    function errorOf(error: BindError): SqlError is
        return SqlError(code => error.code);
    end;

    generic [T: Type]
    function lift(result: Either[BindError, T]): Either[SqlError, T] is
        case result of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as value: T) do
                return Right(right => value);
        end case;
    end;

    function describe(error: SqlError): Span[Nat8, Static] is
        return bindDescribe(BindError(code => error.code));
    end;

    ---
    --- Opening and closing
    ---

    generic [R: Region]
    function openWriter(path: Span[Nat8, R]): Either[SqlError, Connection[Writing]] is
        case bindOpenWriter(path) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as handle: Handle) do
                return Right(right => Connection(handle => handle, mode => Writing()));
        end case;
    end;

    generic [R: Region]
    function openReader(path: Span[Nat8, R]): Either[SqlError, Connection[Reading]] is
        case bindOpenReader(path) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as handle: Handle) do
                return Right(right => Connection(handle => handle, mode => Reading()));
        end case;
    end;

    generic [M: Free]
    function closeDatabase(db: Connection[M]): Unit is
        let { handle: Handle, mode: M } := db;
        bindCloseDatabase(handle);
        return nil;
    end;

    generic [R: Region]
    function migrate(db: &![Connection[Writing], R], migrations: Span[Nat8, Static]): Either[SqlError, Index] is
        return lift(bindMigrate(&!(db->handle), migrations));
    end;

    ---
    --- Transactions
    ---

    generic [M: Free, R: Region]
    function begin(db: &![Connection[M], R]): Either[SqlError, Transaction] is
        case bindBegin(&!(db->handle)) of
            when Left(left as error: BindError) do
                return Left(left => errorOf(error));
            when Right(right as transaction: BindTransaction) do
                return Right(right => Transaction(inner => transaction));
        end case;
    end;

    generic [M: Free, R: Region]
    function commit(db: &![Connection[M], R], transaction: Transaction): Either[SqlError, Unit] is
        let { inner: BindTransaction } := transaction;
        return lift(bindCommit(&!(db->handle), inner));
    end;

    generic [M: Free, R: Region]
    function rollback(db: &![Connection[M], R], transaction: Transaction): Unit is
        let { inner: BindTransaction } := transaction;
        bindRollback(&!(db->handle), inner);
        return nil;
    end;

    generic [M: Free, R: Region]
    function preparedCount(db: &![Connection[M], R]): Index is
        return bindPreparedCount(&!(db->handle));
    end;

    ---
    --- Text
    ---

    generic [R: Region]
    function copyText(text: Span[Nat8, R]): String is
        return bindCopyText(text);
    end;

    ---
    --- Values
    ---

    function noValues(): Values is
        return Values(inner => bindNoValues());
    end;

    function withInt64(values: Values, value: Int64): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithInt64(inner, value));
    end;

    function withFloat64(values: Values, value: Float64): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithFloat64(inner, value));
    end;

    generic [R: Region]
    function withText(values: Values, value: Span[Nat8, R]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithText(inner, value));
    end;

    generic [R: Region]
    function withBlob(values: Values, value: Span[Nat8, R]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithBlob(inner, value));
    end;

    function withInt64OrNull(values: Values, value: Option[Int64]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithInt64OrNull(inner, value));
    end;

    function withFloat64OrNull(values: Values, value: Option[Float64]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithFloat64OrNull(inner, value));
    end;

    generic [R: Region]
    function withTextOrNull(values: Values, value: Option[Span[Nat8, R]]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithTextOrNull(inner, value));
    end;

    generic [R: Region]
    function withBlobOrNull(values: Values, value: Option[Span[Nat8, R]]): Values is
        let { inner: BindValues } := values;
        return Values(inner => bindWithBlobOrNull(inner, value));
    end;

    ---
    --- Statements
    ---

    function withColumns(inner: BindCursor): Cursor is
        var columns: Int32 := 0;
        borrow ref: &[BindCursor, Q] := &inner do
            columns := bindColumnCount(ref);
        end borrow;
        return Cursor(inner => inner, columns => columns);
    end;

    generic [M: Free, R: Region]
    function start(db: &![Connection[M], R], sql: Span[Nat8, Static], values: Values): Cursor is
        let { inner: BindValues } := values;
        return withColumns(bindStart(&!(db->handle), sql, inner));
    end;

    generic [R: Region]
    function startWrite(db: &![Connection[Writing], R], sql: Span[Nat8, Static], values: Values): Cursor is
        let { inner: BindValues } := values;
        return withColumns(bindStartWrite(&!(db->handle), sql, inner));
    end;

    generic [R: Region]
    function execute(db: &![Connection[Writing], R], sql: Span[Nat8, Static], values: Values): Either[SqlError, Nat64] is
        let { inner: BindValues } := values;
        return lift(bindExecute(&!(db->handle), sql, inner));
    end;

    generic [R: Region]
    function advance(cursor: &![Cursor, R]): Bool is
        return bindAdvance(&!(cursor->inner));
    end;

    generic [R: Region]
    function columnCount(cursor: &[Cursor, R]): Int32 is
        return cursor->columns;
    end;

    generic [R: Region]
    function columnStorage(cursor: &[Cursor, R], index: Int32): Storage is
        let kind: Int32 := bindColumnKind(&(cursor->inner), index);
        if kind = 1 then
            return IntegerStorage();
        else if kind = 2 then
            return RealStorage();
        else if kind = 3 then
            return TextStorage();
        else if kind = 4 then
            return BlobStorage();
        end if;
        return NullStorage();
    end;

    generic [R: Region]
    function columnInt64(cursor: &[Cursor, R], index: Int32): Int64 is
        return bindColumnInt64(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnFloat64(cursor: &[Cursor, R], index: Int32): Float64 is
        return bindColumnFloat64(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnText(cursor: &[Cursor, R], index: Int32): Span[Nat8, R] is
        return bindColumnText(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnBlob(cursor: &[Cursor, R], index: Int32): Span[Nat8, R] is
        return bindColumnBlob(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnInt64OrNone(cursor: &[Cursor, R], index: Int32): Option[Int64] is
        return bindColumnInt64OrNone(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnFloat64OrNone(cursor: &[Cursor, R], index: Int32): Option[Float64] is
        return bindColumnFloat64OrNone(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnTextOrNone(cursor: &[Cursor, R], index: Int32): Option[Span[Nat8, R]] is
        return bindColumnTextOrNone(&(cursor->inner), index);
    end;

    generic [R: Region]
    function columnBlobOrNone(cursor: &[Cursor, R], index: Int32): Option[Span[Nat8, R]] is
        return bindColumnBlobOrNone(&(cursor->inner), index);
    end;

    generic [M: Free, R: Region]
    function finish(db: &![Connection[M], R], cursor: Cursor): Option[SqlError] is
        let { inner: BindCursor, columns: Int32 } := cursor;
        case bindFinish(&!(db->handle), inner) of
            when Some(value as error: BindError) do
                return Some(value => errorOf(error));
            when None do
                return None();
        end case;
    end;

    function libraryVersion(): Span[Nat8, Static] is
        return bindLibraryVersion();
    end;
end module body.
