-- The rules of Unicode's Standard Annex 29 for grapheme clusters, applied
-- from left to right between each code point and the next.  Each code
-- point has a class: its Grapheme_Cluster_Break in the low four bits, its
-- Indic_Conjunct_Break in the next two and Extended_Pictographic as the
-- bit of 64.  Three rules look further back than one code point, and a
-- small state carries what they need: whether the run of regional
-- indicators so far is odd, whether a pictograph with extenders and then a
-- zero width joiner came last, and how far a conjunct has got.  The tables
-- at the end hold records of fixed width in string literals, found by
-- binary search; scripts/unicode/make-grapheme-tables.py writes the class
-- table and says its format, scripts/unicode/make-width-tables.py the
-- table of the width a terminal shows for a code point.
import Standard.Utf8 (
    Decoded,
    decodedPoint,
    decodedWidth,
    decodeAt,
    codePointValue
);

module body Standard.Grapheme is
    constant record_width: Index := 14;
    constant sixteen: Index := 16;

    -- The values of Grapheme_Cluster_Break, as the generator numbers them.
    constant gcb_cr: Index := 1;
    constant gcb_lf: Index := 2;
    constant gcb_control: Index := 3;
    constant gcb_extend: Index := 4;
    constant gcb_zwj: Index := 5;
    constant gcb_regional: Index := 6;
    constant gcb_prepend: Index := 7;
    constant gcb_spacing_mark: Index := 8;
    constant gcb_l: Index := 9;
    constant gcb_v: Index := 10;
    constant gcb_t: Index := 11;
    constant gcb_lv: Index := 12;
    constant gcb_lvt: Index := 13;

    -- The values of Indic_Conjunct_Break.
    constant incb_consonant: Index := 1;
    constant incb_extend: Index := 2;
    constant incb_linker: Index := 3;

    -- How far a conjunct has got.
    constant after_consonant: Index := 1;
    constant after_linker: Index := 2;

    -- What the rules that look back need.  conjunct is 0 outside a
    -- conjunct, 1 after its consonant and 2 once a linker followed.
    record State: Free is
        regionalOdd: Bool;
        pictograph: Bool;
        pictographJoined: Bool;
        conjunct: Index;
    end;

    -- The value of count hexadecimal digits of table from at.  The table
    -- holds capital hexadecimal digits there; anything else is a fault of
    -- the generator.
    function hexAt(table: Span[Nat8, Static], at: Index, count: Index): Index is
        var total: Index := 0;
        var i: Index := 0;
        while i < count do
            let byte: Nat8 := table[at + i];
            var digit: Index := 0;
            if (byte >= '0') and (byte <= '9') then
                digit := widen(byte - '0');
            else if (byte >= 'A') and (byte <= 'F') then
                digit := widen((byte - 'A') + 10);
            else
                abort("Standard.Grapheme: the table holds a byte that is not a hexadecimal digit");
            end if;
            total := (total * sixteen) + digit;
            i := i + 1;
        end while;
        return total;
    end;

    function widen(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    -- The class of a code point: the record whose run holds it, or 0.
    function classOf(point: Index): Index is
        let table: Span[Nat8, Static] := classTable();
        let count: Index := spanLength(table) / record_width;
        if (count = 0) or (hexAt(table, 0, 6) > point) then
            return 0;
        end if;
        var low: Index := 0;
        var high: Index := count - 1;
        while low < high do
            let middle: Index := ((low + high) + 1) / 2;
            if hexAt(table, middle * record_width, 6) <= point then
                low := middle;
            else
                high := middle - 1;
            end if;
        end while;
        if point > hexAt(table, (low * record_width) + 6, 6) then
            return 0;
        end if;
        return hexAt(table, (low * record_width) + 12, 2);
    end;

    function breakValue(kind: Index): Index is
        return rem(kind, sixteen);
    end;

    function conjunctValue(kind: Index): Index is
        let four: Index := 4;
        return rem(kind / sixteen, four);
    end;

    function pictographic(kind: Index): Bool is
        let sixty_four: Index := 64;
        return (kind / sixty_four) = 1;
    end;

    -- The state before any code point.
    function initial(): State is
        return State(regionalOdd => false, pictograph => false, pictographJoined => false,
            conjunct => 0);
    end;

    -- The state after a code point of the class.
    function advance(state: State, kind: Index): State is
        let value: Index := breakValue(kind);
        let incb: Index := conjunctValue(kind);
        var odd: Bool := false;
        if value = gcb_regional then
            odd := not state.regionalOdd;
        end if;
        var pictograph: Bool := false;
        var joined: Bool := false;
        if pictographic(kind) then
            pictograph := true;
        else
            if (value = gcb_extend) and state.pictograph then
                pictograph := true;
            else
                if (value = gcb_zwj) and state.pictograph then
                    joined := true;
                end if;
            end if;
        end if;
        var conjunct: Index := 0;
        if incb = incb_consonant then
            conjunct := after_consonant;
        else
            if (incb = incb_linker) and (state.conjunct >= 1) then
                conjunct := after_linker;
            else
                if (incb = incb_extend) and (state.conjunct >= 1) then
                    conjunct := state.conjunct;
                end if;
            end if;
        end if;
        return State(regionalOdd => odd, pictograph => pictograph, pictographJoined => joined,
            conjunct => conjunct);
    end;

    -- Whether the code point of class next stays in the cluster of the code
    -- point of class previous, after which the state is state.  The rules
    -- in the order of the annex, GB3 to GB13; everything else breaks.
    function joins(previous: Index, next: Index, state: State): Bool is
        let before: Index := breakValue(previous);
        let after: Index := breakValue(next);
        if (before = gcb_cr) and (after = gcb_lf) then
            return true;
        end if;
        if ((before = gcb_control) or (before = gcb_cr)) or (before = gcb_lf) then
            return false;
        end if;
        if ((after = gcb_control) or (after = gcb_cr)) or (after = gcb_lf) then
            return false;
        end if;
        if before = gcb_l then
            if ((after = gcb_l) or (after = gcb_v)) or ((after = gcb_lv) or (after = gcb_lvt)) then
                return true;
            end if;
        end if;
        if ((before = gcb_lv) or (before = gcb_v)) and ((after = gcb_v) or (after = gcb_t)) then
            return true;
        end if;
        if ((before = gcb_lvt) or (before = gcb_t)) and (after = gcb_t) then
            return true;
        end if;
        if ((after = gcb_extend) or (after = gcb_zwj)) or (after = gcb_spacing_mark) then
            return true;
        end if;
        if before = gcb_prepend then
            return true;
        end if;
        if (conjunctValue(next) = incb_consonant) and (state.conjunct = after_linker) then
            return true;
        end if;
        if ((before = gcb_zwj) and pictographic(next)) and state.pictographJoined then
            return true;
        end if;
        if ((before = gcb_regional) and (after = gcb_regional)) and state.regionalOdd then
            return true;
        end if;
        return false;
    end;

    -- The code point at at, as an index, and its width in bytes; a width
    -- of 0 when no well-formed UTF-8 begins there.
    record Point: Free is
        value: Index;
        width: Index;
    end;

    generic [R: Region]
    function pointAt(text: Span[Nat8, R], at: Index): Point is
        case decodeAt(text, at) of
            when Some(value as decoded: Decoded) do
                case toIndex(codePointValue(decodedPoint(decoded))) of
                    when Some(value as scalar: Index) do
                        return Point(value => scalar, width => decodedWidth(decoded));
                    when None do
                        return Point(value => 0, width => 0);
                end case;
            when None do
                return Point(value => 0, width => 0);
        end case;
    end;

    generic [R: Region]
    function clusterEnd(text: Span[Nat8, R], start: Index): Option[Index] is
        let size: Index := spanLength(text);
        if start >= size then
            let none: Option[Index] := None();
            return none;
        end if;
        let first: Point := pointAt(text, start);
        if first.width = 0 then
            let none: Option[Index] := None();
            return none;
        end if;
        var previous: Index := classOf(first.value);
        var state: State := advance(initial(), previous);
        var at: Index := start + first.width;
        var going: Bool := true;
        while going and (at < size) do
            let next: Point := pointAt(text, at);
            if next.width = 0 then
                going := false;
            else
                let kind: Index := classOf(next.value);
                if joins(previous, kind, state) then
                    state := advance(state, kind);
                    previous := kind;
                    at := at + next.width;
                else
                    going := false;
                end if;
            end if;
        end while;
        let some: Option[Index] := Some(value => at);
        return some;
    end;

    generic [R: Region]
    function countClusters(text: Span[Nat8, R]): Option[Index] is
        let size: Index := spanLength(text);
        var count: Index := 0;
        var at: Index := 0;
        var valid: Bool := true;
        while valid and (at < size) do
            case clusterEnd(text, at) of
                when Some(value as stop: Index) do
                    count := count + 1;
                    at := stop;
                when None do
                    valid := false;
            end case;
        end while;
        if valid then
            let some: Option[Index] := Some(value => count);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    -- The code points of the variation selectors: 15 asks a terminal for
    -- the text presentation of the cluster, 16 for the emoji presentation.
    constant text_selector: Index := #xFE0E;
    constant emoji_selector: Index := #xFE0F;
    constant two: Index := 2;

    -- The width a terminal shows for a code point: the record whose run
    -- holds it.  The table covers every code point, so the narrow width
    -- of 1 stands only where a fault of the generator would leave a gap.
    function widthOf(point: Index): Index is
        let table: Span[Nat8, Static] := widthTable();
        let count: Index := spanLength(table) / record_width;
        if (count = 0) or (hexAt(table, 0, 6) > point) then
            return 1;
        end if;
        var low: Index := 0;
        var high: Index := count - 1;
        while low < high do
            let middle: Index := ((low + high) + 1) / 2;
            if hexAt(table, middle * record_width, 6) <= point then
                low := middle;
            else
                high := middle - 1;
            end if;
        end while;
        if point > hexAt(table, (low * record_width) + 6, 6) then
            return 1;
        end if;
        return hexAt(table, (low * record_width) + 12, 2);
    end;

    function pointWidth(point: Index): Index is
        return widthOf(point);
    end;

    -- Whether the cluster at at is a carriage return or a line feed,
    -- which ends the line before it and is not part of it.
    generic [R: Region]
    function hardBreakAt(text: Span[Nat8, R], at: Index): Bool is
        let p: Point := pointAt(text, at);
        let value: Index := breakValue(classOf(p.value));
        return (value = gcb_cr) or (value = gcb_lf);
    end;

    generic [R: Region]
    function clusterWidth(text: Span[Nat8, R], start: Index): Option[Index] is
        let size: Index := spanLength(text);
        if start >= size then
            let none: Option[Index] := None();
            return none;
        end if;
        case clusterEnd(text, start) of
            when Some(value as stop: Index) do
                var at: Index := start;
                var w: Index := 0;
                var seen: Bool := false;
                var first_kind: Index := 0;
                var text_form: Bool := false;
                var emoji_form: Bool := false;
                var flags: Index := 0;
                while at < stop do
                    let p: Point := pointAt(text, at);
                    let kind: Index := classOf(p.value);
                    if not seen then
                        seen := true;
                        first_kind := kind;
                        w := widthOf(p.value);
                    end if;
                    if p.value = text_selector then
                        text_form := true;
                    end if;
                    if p.value = emoji_selector then
                        emoji_form := true;
                    end if;
                    if breakValue(kind) = gcb_regional then
                        flags := flags + 1;
                    end if;
                    at := at + p.width;
                end while;
                if w > 0 then
                    if text_form then
                        w := 1;
                    else
                        if emoji_form and pictographic(first_kind) then
                            w := 2;
                        else
                            if flags = two then
                                w := 2;
                            end if;
                        end if;
                    end if;
                end if;
                let some: Option[Index] := Some(value => w);
                return some;
            when None do
                let none: Option[Index] := None();
                return none;
        end case;
    end;

    generic [R: Region]
    function countColumns(text: Span[Nat8, R]): Option[Index] is
        let size: Index := spanLength(text);
        var at: Index := 0;
        var total: Index := 0;
        var valid: Bool := true;
        while valid and (at < size) do
            case clusterEnd(text, at) of
                when Some(value as next: Index) do
                    case clusterWidth(text, at) of
                        when Some(value as w: Index) do
                            total := total + w;
                            at := next;
                        when None do
                            valid := false;
                    end case;
                when None do
                    valid := false;
            end case;
        end while;
        if valid then
            let some: Option[Index] := Some(value => total);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    generic [R: Region]
    function fittingEnd(text: Span[Nat8, R], width: Index): Option[Index] is
        let size: Index := spanLength(text);
        var at: Index := 0;
        var total: Index := 0;
        var stop: Index := 0;
        var going: Bool := true;
        var valid: Bool := true;
        while going and valid and (at < size) do
            case clusterEnd(text, at) of
                when Some(value as next: Index) do
                    case clusterWidth(text, at) of
                        when Some(value as w: Index) do
                            if (total + w) > width then
                                going := false;
                            else
                                total := total + w;
                                stop := next;
                                at := next;
                            end if;
                        when None do
                            valid := false;
                    end case;
                when None do
                    valid := false;
            end case;
        end while;
        if valid then
            let some: Option[Index] := Some(value => stop);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    generic [R: Region]
    function lineEnd(text: Span[Nat8, R], width: Index, start: Index): Option[Index] is
        let size: Index := spanLength(text);
        if start >= size then
            let none: Option[Index] := None();
            return none;
        end if;
        var at: Index := start;
        var total: Index := 0;
        var taken: Index := 0;
        var stop: Index := start;
        var going: Bool := true;
        var valid: Bool := true;
        while going and valid and (at < size) do
            if hardBreakAt(text, at) then
                stop := at;
                going := false;
            else
                case clusterEnd(text, at) of
                    when Some(value as next: Index) do
                        case clusterWidth(text, at) of
                            when Some(value as w: Index) do
                                if (taken > 0) and ((total + w) > width) then
                                    stop := at;
                                    going := false;
                                else
                                    total := total + w;
                                    taken := taken + 1;
                                    at := next;
                                    stop := next;
                                end if;
                            when None do
                                valid := false;
                        end case;
                    when None do
                        valid := false;
                end case;
            end if;
        end while;
        if valid then
            let some: Option[Index] := Some(value => stop);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    generic [R: Region]
    function countLines(text: Span[Nat8, R], width: Index): Option[Index] is
        let size: Index := spanLength(text);
        var at: Index := 0;
        var count: Index := 0;
        var valid: Bool := true;
        while valid and (at < size) do
            case lineEnd(text, width, at) of
                when Some(value as stop: Index) do
                    count := count + 1;
                    if stop >= size then
                        at := size;
                    else
                        if hardBreakAt(text, stop) then
                            case clusterEnd(text, stop) of
                                when Some(value as next: Index) do
                                    at := next;
                                when None do
                                    valid := false;
                            end case;
                        else
                            at := stop;
                        end if;
                    end if;
                when None do
                    valid := false;
            end case;
        end while;
        if valid then
            let some: Option[Index] := Some(value => count);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    ---
    --- The table, written by scripts/unicode/make-grapheme-tables.py
    --- from the Unicode Character Database 17.0.0 and ICU.  Not edited by
    --- hand.
    ---

