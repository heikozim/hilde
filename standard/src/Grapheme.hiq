--
-- The rules of Unicode's Standard Annex 29 for grapheme clusters, applied
-- from left to right between each code point and the next.  Each code
-- point has a class: its Grapheme_Cluster_Break in the low four bits, its
-- Indic_Conjunct_Break in the next two and Extended_Pictographic as the
-- bit of 64.  Three rules look further back than one code point, and a
-- small state carries what they need: whether the run of regional
-- indicators so far is odd, whether a pictograph with extenders and then a
-- zero width joiner came last, and how far a conjunct has got.  The table
-- at the end holds records of fixed width in a string literal, found by
-- binary search; scripts/unicode/make-grapheme-tables.py writes it and
-- says its format.
import Standard.Utf8 (
    Decoded,
    decodedPoint,
    decodedWidth,
    decodeAt,
    codePointValue
);

module body Standard.Grapheme is
    constant recordWidth: Index := 14;
    constant sixteen: Index := 16;

    -- The values of Grapheme_Cluster_Break, as the generator numbers them.
    constant gcbCr: Index := 1;
    constant gcbLf: Index := 2;
    constant gcbControl: Index := 3;
    constant gcbExtend: Index := 4;
    constant gcbZwj: Index := 5;
    constant gcbRegional: Index := 6;
    constant gcbPrepend: Index := 7;
    constant gcbSpacingMark: Index := 8;
    constant gcbL: Index := 9;
    constant gcbV: Index := 10;
    constant gcbT: Index := 11;
    constant gcbLv: Index := 12;
    constant gcbLvt: Index := 13;

    -- The values of Indic_Conjunct_Break.
    constant incbConsonant: Index := 1;
    constant incbExtend: Index := 2;
    constant incbLinker: Index := 3;

    -- How far a conjunct has got.
    constant afterConsonant: Index := 1;
    constant afterLinker: Index := 2;

    -- What the rules that look back need.  conjunct is 0 outside a
    -- conjunct, 1 after its consonant and 2 once a linker followed.
    record State: Free is
        regionalOdd: Bool;
        pictograph: Bool;
        pictographJoined: Bool;
        conjunct: Index;
    end;

    -- The value of count hexadecimal digits of table from at.  The table
    -- holds capital hexadecimal digits there; anything else is a fault of
    -- the generator.
    function hexAt(table: Span[Nat8, Static], at: Index, count: Index): Index is
        var total: Index := 0;
        var i: Index := 0;
        while i < count do
            let byte: Nat8 := table[at + i];
            var digit: Index := 0;
            if (byte >= '0') and (byte <= '9') then
                digit := widen(byte - '0');
            else if (byte >= 'A') and (byte <= 'F') then
                digit := widen((byte - 'A') + 10);
            else
                abort("Standard.Grapheme: the table holds a byte that is not a hexadecimal digit");
            end if;
            total := (total * sixteen) + digit;
            i := i + 1;
        end while;
        return total;
    end;

    function widen(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    -- The class of a code point: the record whose run holds it, or 0.
    function classOf(point: Index): Index is
        let table: Span[Nat8, Static] := classTable();
        let count: Index := spanLength(table) / recordWidth;
        if (count = 0) or (hexAt(table, 0, 6) > point) then
            return 0;
        end if;
        var low: Index := 0;
        var high: Index := count - 1;
        while low < high do
            let middle: Index := ((low + high) + 1) / 2;
            if hexAt(table, middle * recordWidth, 6) <= point then
                low := middle;
            else
                high := middle - 1;
            end if;
        end while;
        if point > hexAt(table, (low * recordWidth) + 6, 6) then
            return 0;
        end if;
        return hexAt(table, (low * recordWidth) + 12, 2);
    end;

    function breakValue(kind: Index): Index is
        return rem(kind, sixteen);
    end;

    function conjunctValue(kind: Index): Index is
        let four: Index := 4;
        return rem(kind / sixteen, four);
    end;

    function pictographic(kind: Index): Bool is
        let sixtyFour: Index := 64;
        return (kind / sixtyFour) = 1;
    end;

    -- The state before any code point.
    function initial(): State is
        return State(regionalOdd => false, pictograph => false, pictographJoined => false,
            conjunct => 0);
    end;

    -- The state after a code point of the class.
    function advance(state: State, kind: Index): State is
        let value: Index := breakValue(kind);
        let incb: Index := conjunctValue(kind);
        var odd: Bool := false;
        if value = gcbRegional then
            odd := not state.regionalOdd;
        end if;
        var pictograph: Bool := false;
        var joined: Bool := false;
        if pictographic(kind) then
            pictograph := true;
        else
            if (value = gcbExtend) and state.pictograph then
                pictograph := true;
            else
                if (value = gcbZwj) and state.pictograph then
                    joined := true;
                end if;
            end if;
        end if;
        var conjunct: Index := 0;
        if incb = incbConsonant then
            conjunct := afterConsonant;
        else
            if (incb = incbLinker) and (state.conjunct >= 1) then
                conjunct := afterLinker;
            else
                if (incb = incbExtend) and (state.conjunct >= 1) then
                    conjunct := state.conjunct;
                end if;
            end if;
        end if;
        return State(regionalOdd => odd, pictograph => pictograph, pictographJoined => joined,
            conjunct => conjunct);
    end;

    -- Whether the code point of class next stays in the cluster of the code
    -- point of class previous, after which the state is state.  The rules
    -- in the order of the annex, GB3 to GB13; everything else breaks.
    function joins(previous: Index, next: Index, state: State): Bool is
        let before: Index := breakValue(previous);
        let after: Index := breakValue(next);
        if (before = gcbCr) and (after = gcbLf) then
            return true;
        end if;
        if ((before = gcbControl) or (before = gcbCr)) or (before = gcbLf) then
            return false;
        end if;
        if ((after = gcbControl) or (after = gcbCr)) or (after = gcbLf) then
            return false;
        end if;
        if before = gcbL then
            if ((after = gcbL) or (after = gcbV)) or ((after = gcbLv) or (after = gcbLvt)) then
                return true;
            end if;
        end if;
        if ((before = gcbLv) or (before = gcbV)) and ((after = gcbV) or (after = gcbT)) then
            return true;
        end if;
        if ((before = gcbLvt) or (before = gcbT)) and (after = gcbT) then
            return true;
        end if;
        if ((after = gcbExtend) or (after = gcbZwj)) or (after = gcbSpacingMark) then
            return true;
        end if;
        if before = gcbPrepend then
            return true;
        end if;
        if (conjunctValue(next) = incbConsonant) and (state.conjunct = afterLinker) then
            return true;
        end if;
        if ((before = gcbZwj) and pictographic(next)) and state.pictographJoined then
            return true;
        end if;
        if ((before = gcbRegional) and (after = gcbRegional)) and state.regionalOdd then
            return true;
        end if;
        return false;
    end;

    -- The code point at at, as an index, and its width in bytes; a width
    -- of 0 when no well-formed UTF-8 begins there.
    record Point: Free is
        value: Index;
        width: Index;
    end;

    generic [R: Region]
    function pointAt(text: Span[Nat8, R], at: Index): Point is
        case decodeAt(text, at) of
            when Some(value as decoded: Decoded) do
                case toIndex(codePointValue(decodedPoint(decoded))) of
                    when Some(value as scalar: Index) do
                        return Point(value => scalar, width => decodedWidth(decoded));
                    when None do
                        return Point(value => 0, width => 0);
                end case;
            when None do
                return Point(value => 0, width => 0);
        end case;
    end;

    generic [R: Region]
    function clusterEnd(text: Span[Nat8, R], start: Index): Option[Index] is
        let size: Index := spanLength(text);
        if start >= size then
            let none: Option[Index] := None();
            return none;
        end if;
        let first: Point := pointAt(text, start);
        if first.width = 0 then
            let none: Option[Index] := None();
            return none;
        end if;
        var previous: Index := classOf(first.value);
        var state: State := advance(initial(), previous);
        var at: Index := start + first.width;
        var going: Bool := true;
        while going and (at < size) do
            let next: Point := pointAt(text, at);
            if next.width = 0 then
                going := false;
            else
                let kind: Index := classOf(next.value);
                if joins(previous, kind, state) then
                    state := advance(state, kind);
                    previous := kind;
                    at := at + next.width;
                else
                    going := false;
                end if;
            end if;
        end while;
        let some: Option[Index] := Some(value => at);
        return some;
    end;

    generic [R: Region]
    function countClusters(text: Span[Nat8, R]): Option[Index] is
        let size: Index := spanLength(text);
        var count: Index := 0;
        var at: Index := 0;
        var valid: Bool := true;
        while valid and (at < size) do
            case clusterEnd(text, at) of
                when Some(value as stop: Index) do
                    count := count + 1;
                    at := stop;
                when None do
                    valid := false;
            end case;
        end while;
        if valid then
            let some: Option[Index] := Some(value => count);
            return some;
        end if;
        let none: Option[Index] := None();
        return none;
    end;

    ---
    --- The table, written by scripts/unicode/make-grapheme-tables.py
    --- from the Unicode Character Database 17.0.0 and ICU.  Not edited by
    --- hand.
    ---

