-- Standard.ArrayLinalg: the singular value decomposition, the qr
-- factorization and the least squares of matrices with more rows than
-- columns, held against the matrix they came from and against the
-- answer of the factorization by Householder reflections.
import Standard.Testing (
    assertTrue
);
import Standard.Array (
    Array,
    destroy,
    float64Type,
    getFloat64,
    setFloat64,
    shape1,
    shape2,
    view,
    zeros
);
import Standard.ArrayLinalg (
    Lstsq,
    Qr,
    destroyLstsq,
    destroyQr,
    destroySvd,
    lstsq,
    lstsqColumns,
    lstsqRank,
    qr,
    qrColumns,
    qrRows,
    qOf,
    rOf,
    singularValuesOf,
    svd,
    svdColumns,
    svdRows,
    Svd,
    uOf,
    vtOf,
    xOf
);

module body Standard.ArrayLinalg.Test is
    -- Whether two Float64 sit within tolerance of each other.  A Float64
    -- holds about 15 decimal places; the tolerance here stays far above
    -- the rounding of one call of the routine.
    function near(x: Float64, y: Float64, t: Float64): Bool is
        let gap: Float64 := x - y;
        if gap < 0.0 then
            return (-gap) <= t;
        end if;
        return gap <= t;
    end;

    function testSvdReconstruction(): Unit is
        -- a is the 4 by 3 matrix, row major:
        -- 2 1 0 / 3 0 1 / 0 4 2 / 1 1 1.  It has the rank 3, so the thin
        -- decomposition carries three singular values above 0.
        var a: Array := zeros(float64Type(), shape2(4, 3));
        setFloat64(&!a, 0, 2.0);
        setFloat64(&!a, 1, 1.0);
        setFloat64(&!a, 2, 0.0);
        setFloat64(&!a, 3, 3.0);
        setFloat64(&!a, 4, 0.0);
        setFloat64(&!a, 5, 1.0);
        setFloat64(&!a, 6, 0.0);
        setFloat64(&!a, 7, 4.0);
        setFloat64(&!a, 8, 2.0);
        setFloat64(&!a, 9, 1.0);
        setFloat64(&!a, 10, 1.0);
        setFloat64(&!a, 11, 1.0);
        case svd(view(&a)) of
            when Right(right as made: Svd) do
                assertTrue(svdRows(&made) = 4, "u has the rows of a");
                assertTrue(svdColumns(&made) = 3, "the values and vt have the columns of a");
                let u: Array := uOf(&made);
                let s: Array := singularValuesOf(&made);
                let vt: Array := vtOf(&made);
                -- The product u times the diagonal of s times vt, one
                -- entry of a at a time: the entry of row i and column j
                -- is the sum over k of u at i and k, times the value k,
                -- times vt at k and j.
                var i: Index := 0;
                while i < 4 do
                    var j: Index := 0;
                    while j < 3 do
                        var sum: Float64 := 0.0;
                        var k: Index := 0;
                        while k < 3 do
                            sum := sum + ((getFloat64(view(&u), (i * 3) + k) * getFloat64(view(&s), k)) * getFloat64(view(&vt), (k * 3) + j));
                            k := k + 1;
                        end while;
                        assertTrue(near(sum, getFloat64(view(&a), (i * 3) + j), 1.0e-9), "u times the values times vt is a again");
                        j := j + 1;
                    end while;
                    i := i + 1;
                end while;
                destroy(vt);
                destroy(s);
                destroy(u);
                destroySvd(made);
            when Left(left as code: Int32) do
                assertTrue(false, "svd decomposed the matrix");
        end case;
        destroy(a);
        return nil;
    end;

    function testQrReconstruction(): Unit is
        -- a is the 5 by 3 matrix, row major:
        -- 2 1 0 / 3 0 1 / 0 4 2 / 1 1 1 / 2 2 1.  It has the rank 3, so
        -- the factorization carries a q of three orthonormal columns and
        -- an r with three places on its diagonal.
        var a: Array := zeros(float64Type(), shape2(5, 3));
        setFloat64(&!a, 0, 2.0);
        setFloat64(&!a, 1, 1.0);
        setFloat64(&!a, 2, 0.0);
        setFloat64(&!a, 3, 3.0);
        setFloat64(&!a, 4, 0.0);
        setFloat64(&!a, 5, 1.0);
        setFloat64(&!a, 6, 0.0);
        setFloat64(&!a, 7, 4.0);
        setFloat64(&!a, 8, 2.0);
        setFloat64(&!a, 9, 1.0);
        setFloat64(&!a, 10, 1.0);
        setFloat64(&!a, 11, 1.0);
        setFloat64(&!a, 12, 2.0);
        setFloat64(&!a, 13, 2.0);
        setFloat64(&!a, 14, 1.0);
        case qr(view(&a)) of
            when Right(right as made: Qr) do
                assertTrue(qrRows(&made) = 5, "q has the rows of a");
                assertTrue(qrColumns(&made) = 3, "r is square of the columns of a");
                let q: Array := qOf(&made);
                let r: Array := rOf(&made);
                -- The product q times r, one entry of a at a time: the
                -- entry of row i and column j is the sum over k of q at
                -- i and k, times r at k and j.
                var i: Index := 0;
                while i < 5 do
                    var j: Index := 0;
                    while j < 3 do
                        var sum: Float64 := 0.0;
                        var k: Index := 0;
                        while k < 3 do
                            sum := sum + (getFloat64(view(&q), (i * 3) + k) * getFloat64(view(&r), (k * 3) + j));
                            k := k + 1;
                        end while;
                        assertTrue(near(sum, getFloat64(view(&a), (i * 3) + j), 1.0e-9), "q times r is a again");
                        j := j + 1;
                    end while;
                    i := i + 1;
                end while;
                destroy(r);
                destroy(q);
                destroyQr(made);
            when Left(left as code: Int32) do
                assertTrue(false, "qr factored the matrix");
        end case;
        destroy(a);
        return nil;
    end;

    function testLstsqAgainstTheBaseline(): Unit is
        -- a is the 6 by 3 matrix, row major:
        -- 1 2 3 / 4 5 6 / 7 8 10 / 2 1 1 / 0 3 2 / 5 1 4, and b is
        -- 1 0 2 3 1 2.  No x solves the system exactly; the answer is
        -- the x of the smallest norm of a x - b.  The three values below
        -- are the ones the factorization by Householder reflections with
        -- the back substitution after it, the way the compute layer of
        -- the arrays takes, gives for this problem; the two ways agree
        -- far within the tolerance of 1e-9 held here.
        var a: Array := zeros(float64Type(), shape2(6, 3));
        setFloat64(&!a, 0, 1.0);
        setFloat64(&!a, 1, 2.0);
        setFloat64(&!a, 2, 3.0);
        setFloat64(&!a, 3, 4.0);
        setFloat64(&!a, 4, 5.0);
        setFloat64(&!a, 5, 6.0);
        setFloat64(&!a, 6, 7.0);
        setFloat64(&!a, 7, 8.0);
        setFloat64(&!a, 8, 10.0);
        setFloat64(&!a, 9, 2.0);
        setFloat64(&!a, 10, 1.0);
        setFloat64(&!a, 11, 1.0);
        setFloat64(&!a, 12, 0.0);
        setFloat64(&!a, 13, 3.0);
        setFloat64(&!a, 14, 2.0);
        setFloat64(&!a, 15, 5.0);
        setFloat64(&!a, 16, 1.0);
        setFloat64(&!a, 17, 4.0);
        var b: Array := zeros(float64Type(), shape1(6));
        setFloat64(&!b, 0, 1.0);
        setFloat64(&!b, 1, 0.0);
        setFloat64(&!b, 2, 2.0);
        setFloat64(&!b, 3, 3.0);
        setFloat64(&!b, 4, 1.0);
        setFloat64(&!b, 5, 2.0);
        case lstsq(view(&a), view(&b)) of
            when Right(right as made: Lstsq) do
                assertTrue(lstsqColumns(&made) = 3, "the answer has the columns of a");
                assertTrue(lstsqRank(&made) = 3, "a has the full column rank");
                let x: Array := xOf(&made);
                assertTrue(near(getFloat64(view(&x), 0), 0.87978142076502808, 1.0e-9), "the first place of the answer");
                assertTrue(near(getFloat64(view(&x), 1), 0.55191256830601099, 1.0e-9), "the second place of the answer");
                assertTrue(near(getFloat64(view(&x), 2), -0.8360655737704924, 1.0e-9), "the third place of the answer");
                destroy(x);
                destroyLstsq(made);
            when Left(left as code: Int32) do
                assertTrue(false, "lstsq solved the system");
        end case;
        destroy(b);
        destroy(a);
        return nil;
    end;
end module body.
