"""
A bump allocator behind a linear handle, for the memory of one unit of work such as one request.

- Only code that asks an arena for memory allocates from it; nothing else does.
- A reference or span it hands out carries the region of its borrow and cannot outlive it.
- The arena cannot be reset or freed while it is borrowed.
- The arena never grows: a request beyond its capacity gives None.
- It holds Free values only, because resetArena releases everything at once.
- resetArena and freeArena overwrite what was used.

    case createArena(65536) of
        when Some(value as made: Arena) do
            var arena: Arena := made;
            borrow r: &![Arena, R] := &!arena do
                let got: Option[Span![Int32, R]] := arenaSpan(r, 100);
            end borrow;
            arena := resetArena(arena);
            freeArena(arena);
        when None do
            abort("No memory for the arena.");
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Arena is
    """
    A block of memory that hands out pieces and takes them all back at
    once.  It is linear: resetArena or freeArena consumes it.
    """
    type Arena: Linear;

    """
    Takes a block of at least capacity bytes from the system, rounded up
    to whole pages.  Returns None when the system says no or capacity is
    zero.
    """
    function createArena(capacity: ByteSize): Option[Arena];

    """
    Takes room for one value of type T from the arena.

    Returns None when the arena is full. The arena never grows.

    T must be Free. A value that needs more than its memory given back,
    such as a file or a connection, cannot live in an arena, because
    resetArena releases everything at once and would skip closing it.
    """
    generic [T: Free, R: Region]
    function arenaAllocate(arena: &![Arena, R]): Option[&![T, R]];

    """
    Takes room for count values of type T in one piece, as a writable
    span whose bytes are zero.  Returns None when the arena is full, when
    count is zero, or when the size would not fit an Index.  T must be
    Free, for the reason arenaAllocate gives.
    """
    generic [T: Free, R: Region]
    function arenaSpan(arena: &![Arena, R], count: Index): Option[Span![T, R]];

    """
    The bytes handed out so far, alignment included.
    """
    generic [R: Region]
    function arenaUsed(arena: &[Arena, R]): ByteSize;

    """
    The bytes the arena can hand out in all: what the system gave, not
    what was asked for.
    """
    generic [R: Region]
    function arenaCapacity(arena: &[Arena, R]): ByteSize;

    """
    Overwrites what was used and starts again at the beginning of the
    same block, for the next unit of work.  Returns the arena.
    """
    function resetArena(arena: Arena): Arena;

    """
    Overwrites what was used and gives the block back to the system.
    """
    function freeArena(arena: Arena): Unit;
end module.
