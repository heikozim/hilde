--
-- Standard.Template: the functions the code that the
-- compiler generates for @template calls.  Nothing here parses a
-- template; that happens in the compiler (lib/Jinja.ml), once.
import Standard.Buffer (
    Buffer,
    length as bufferLength,
    nthRef
);
import Standard.String (
    String,
    makeString,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    storeNth,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);

module body Standard.Template is
    ---
    --- Numbers in decimal
    ---

    function digitByte(digit: Nat64): Nat8 is
        case toNat8(digit) of
            when Some(value as d: Nat8) do
                return d + '0';
            when None do
                return '?';
        end case;
    end;

    -- The digits are written from the end of a scratch string of twenty
    -- bytes -- a Nat64 has at most twenty -- and copied out from where they
    -- start.
    function decimalNat(value: Nat64): String is
        var scratch: String := makeString(20, 0);
        var at: Index := 20;
        var rest: Nat64 := value;
        var going: Bool := true;
        while going do
            let quotient: Nat64 := rest / 10;
            let digit: Nat64 := rest - (quotient * 10);
            at := at - 1;
            storeNth(&!scratch, at, digitByte(digit));
            rest := quotient;
            going := rest > 0;
        end while;
        var out: StringBuilder := makeStringBuilder();
        while at < 20 do
            writeByte(&!out, nthByte(&scratch, at));
            at := at + 1;
        end while;
        destroyString(scratch);
        return finalize(out);
    end;

    -- A negative number's digits come from the negative number itself --
    -- each remainder is between -9 and 0 -- so that the smallest Int64,
    -- which has no positive counterpart, needs no case of its own.
    function decimalInt(value: Int64): String is
        if value >= 0 then
            case toNat64(value) of
                when Some(value as n: Nat64) do
                    return decimalNat(n);
                when None do
                    return fromLiteral("?");
            end case;
        end if;
        var scratch: String := makeString(20, 0);
        var at: Index := 20;
        var rest: Int64 := value;
        while rest /= 0 do
            let quotient: Int64 := rest / 10;
            let remainder: Int64 := rest - (quotient * 10);
            at := at - 1;
            case toNat64(-remainder) of
                when Some(value as d: Nat64) do
                    storeNth(&!scratch, at, digitByte(d));
                when None do
                    storeNth(&!scratch, at, '?');
            end case;
            rest := quotient;
        end while;
        var out: StringBuilder := makeStringBuilder();
        writeByte(&!out, '-');
        while at < 20 do
            writeByte(&!out, nthByte(&scratch, at));
            at := at + 1;
        end while;
        destroyString(scratch);
        return finalize(out);
    end;

    generic [T: Free(ToNat64)]
    function natText(value: T): String is
        case toNat64(value) of
            when Some(value as n: Nat64) do
                return decimalNat(n);
            when None do
                return fromLiteral("?");
        end case;
    end;

    generic [T: Free(ToInt64)]
    function intText(value: T): String is
        case toInt64(value) of
            when Some(value as n: Int64) do
                return decimalInt(n);
            when None do
                return fromLiteral("?");
        end case;
    end;

    ---
    --- Render
    ---

    instance Render(String) is
        generic [R: Region]
        method display(value: &[String, R]): String is
            var out: StringBuilder := makeStringBuilder();
            writeString(&!out, asSpan(value));
            return finalize(out);
        end;
    end;

    instance Render(Bool) is
        generic [R: Region]
        method display(value: &[Bool, R]): String is
            if !value then
                return fromLiteral("True");
            else
                return fromLiteral("False");
            end if;
        end;
    end;

    instance Render(Nat8) is
        generic [R: Region]
        method display(value: &[Nat8, R]): String is
            return natText(!value);
        end;
    end;

    instance Render(Nat16) is
        generic [R: Region]
        method display(value: &[Nat16, R]): String is
            return natText(!value);
        end;
    end;

    instance Render(Nat32) is
        generic [R: Region]
        method display(value: &[Nat32, R]): String is
            return natText(!value);
        end;
    end;

    instance Render(Nat64) is
        generic [R: Region]
        method display(value: &[Nat64, R]): String is
            return decimalNat(!value);
        end;
    end;

    instance Render(Int8) is
        generic [R: Region]
        method display(value: &[Int8, R]): String is
            return intText(!value);
        end;
    end;

    instance Render(Int16) is
        generic [R: Region]
        method display(value: &[Int16, R]): String is
            return intText(!value);
        end;
    end;

    instance Render(Int32) is
        generic [R: Region]
        method display(value: &[Int32, R]): String is
            return intText(!value);
        end;
    end;

    instance Render(Int64) is
        generic [R: Region]
        method display(value: &[Int64, R]): String is
            return decimalInt(!value);
        end;
    end;

    instance Render(Index) is
        generic [R: Region]
        method display(value: &[Index, R]): String is
            return natText(!value);
        end;
    end;

    ---
    --- Truth
    ---

    instance Truth(String) is
        generic [R: Region]
        method truthy(value: &[String, R]): Bool is
            return length(value) > 0;
        end;
    end;

    instance Truth(Bool) is
        generic [R: Region]
        method truthy(value: &[Bool, R]): Bool is
            return !value;
        end;
    end;

    instance Truth(Nat8) is
        generic [R: Region]
        method truthy(value: &[Nat8, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Nat16) is
        generic [R: Region]
        method truthy(value: &[Nat16, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Nat32) is
        generic [R: Region]
        method truthy(value: &[Nat32, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Nat64) is
        generic [R: Region]
        method truthy(value: &[Nat64, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Int8) is
        generic [R: Region]
        method truthy(value: &[Int8, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Int16) is
        generic [R: Region]
        method truthy(value: &[Int16, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Int32) is
        generic [R: Region]
        method truthy(value: &[Int32, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Int64) is
        generic [R: Region]
        method truthy(value: &[Int64, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    instance Truth(Index) is
        generic [R: Region]
        method truthy(value: &[Index, R]): Bool is
            return (!value) /= 0;
        end;
    end;

    generic [U: Type]
    instance Truth(Option[U]) is
        generic [R: Region]
        method truthy(value: &[Option[U], R]): Bool is
            return isPresent(value);
        end;
    end;

    generic [U: Type]
    instance Truth(Buffer[U]) is
        generic [R: Region]
        method truthy(value: &[Buffer[U], R]): Bool is
            return bufferLength(value) > 0;
        end;
    end;

    ---
    --- Sized
    ---

    -- Code points, as Python's len counts them: every byte that is not a
    -- continuation byte (#x80 to #xBF) begins one.
    instance Sized(String) is
        generic [R: Region]
        method size(value: &[String, R]): Index is
            let bytes: Index := length(value);
            var points: Index := 0;
            var i: Index := 0;
            while i < bytes do
                let b: Nat8 := nthByte(value, i);
                if (b < #x80) or (b >= #xC0) then
                    points := points + 1;
                end if;
                i := i + 1;
            end while;
            return points;
        end;
    end;

    generic [U: Type]
    instance Sized(Buffer[U]) is
        generic [R: Region]
        method size(value: &[Buffer[U], R]): Index is
            return bufferLength(value);
        end;
    end;

    ---
    --- Option and Buffer, by reference
    ---

    generic [T: Type, R: Region]
    function isPresent(value: &[Option[T], R]): Bool is
        case value of
            when Some(value as inner: &[T, R]) do
                return true;
            when None do
                return false;
        end case;
    end;

    generic [T: Type, R: Region]
    function present(value: &[Option[T], R]): &[T, R] is
        case value of
            when Some(value as inner: &[T, R]) do
                return inner;
            when None do
                abort("Standard.Template.present: the value is missing");
        end case;
    end;

    generic [T: Type, R: Region]
    function count(sequence: &[Buffer[T], R]): Index is
        return bufferLength(sequence);
    end;

    generic [T: Type, R: Region]
    function element(sequence: &[Buffer[T], R], position: Index): &[T, R] is
        return nthRef(sequence, position);
    end;

    function zero(): Index is
        return 0;
    end;

    function displayIndex(value: Index): String is
        return natText(value);
    end;

    generic [R: Region]
    function textEquals(value: Span[Nat8, R], literal: Span[Nat8, Static]): Bool is
        let total: Index := spanLength(literal);
        if spanLength(value) /= total then
            return false;
        end if;
        var i: Index := 0;
        while i < total do
            if value[i] /= literal[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    ---
    --- Writing
    ---

    generic [B: Region]
    function writeText(out: &![StringBuilder, B], text: Span[Nat8, Static]): Unit is
        let total: Index := spanLength(text);
        var i: Index := 0;
        while i < total do
            writeByte(&~out, text[i]);
            i := i + 1;
        end while;
        return nil;
    end;

    -- MarkupSafe's five, and nothing else: the output has to be Jinja2's
    -- byte for byte, and Jinja2 escapes exactly these.  34 is the double
    -- quote and 39 the single one.
    generic [B: Region]
    function writeHtml(out: &![StringBuilder, B], text: String): Unit is
        let total: Index := length(&text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := nthByte(&text, i);
            if b = '&' then
                writeText(&~out, "&amp;");
            else if b = '<' then
                writeText(&~out, "&lt;");
            else if b = '>' then
                writeText(&~out, "&gt;");
            else if b = 34 then
                writeText(&~out, "&#34;");
            else if b = 39 then
                writeText(&~out, "&#39;");
            else
                writeByte(&~out, b);
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return nil;
    end;

    ---
    --- URLs, as Go's html/template escapes them (measured with Go 1.27.1);
    --- the HTML escaping after it is MarkupSafe's, as above.
    ---

    function isAlnum(b: Nat8): Bool is
        return ((b >= 'a') and (b <= 'z')) or (((b >= 'A') and (b <= 'Z')) or ((b >= '0') and (b <= '9')));
    end;

    -- -._~, which RFC 3986 calls unreserved.
    function isUnreserved(b: Nat8): Bool is
        return isAlnum(b) or (((b = '-') or (b = '.')) or ((b = '_') or (b = '~')));
    end;

    -- The reserved characters that stay in a path, and %.  Not '', ( and
    -- ): Go encodes them, so that the result can stand in a single-quoted
    -- attribute or a CSS url(...).
    function keptInPath(b: Nat8): Bool is
        let kept: Span[Nat8, Static] := "!#$&*+,/:;=?@[]%";
        let total: Index := spanLength(kept);
        var i: Index := 0;
        while i < total do
            if kept[i] = b then
                return true;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    function lowerHex(value: Nat8): Nat8 is
        if value < 10 then
            return value + '0';
        end if;
        return (value - 10) + 'a';
    end;

    -- Percent-encode text; query says whether the reserved characters
    -- are encoded as well.
    generic [T: Region]
    function percentEncoded(text: Span[Nat8, T], query: Bool): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := spanLength(text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := text[i];
            if isUnreserved(b) or ((not query) and keptInPath(b)) then
                writeByte(&!out, b);
            else
                writeByte(&!out, '%');
                writeByte(&!out, lowerHex(b / 16));
                writeByte(&!out, lowerHex(b - ((b / 16) * 16)));
            end if;
            i := i + 1;
        end while;
        return finalize(out);
    end;

    -- Does the value begin with a scheme other than http, https and
    -- mailto?  A scheme is what stands before the first :, when no /
    -- stands before it.
    generic [T: Region]
    function unsafeScheme(text: Span[Nat8, T]): Bool is
        let total: Index := spanLength(text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := text[i];
            if b = '/' then
                return false;
            end if;
            if b = ':' then
                let scheme: String := lower(substringOf(text, i));
                let safe: Bool := (textEquals(asSpan(&scheme), "http") or textEquals(asSpan(&scheme), "https")) or textEquals(asSpan(&scheme), "mailto");
                destroyString(scheme);
                return not safe;
            end if;
            i := i + 1;
        end while;
        return false;
    end;

    -- The first upTo bytes of text, as a new string.
    generic [T: Region]
    function substringOf(text: Span[Nat8, T], upTo: Index): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < upTo do
            writeByte(&!out, text[i]);
            i := i + 1;
        end while;
        return finalize(out);
    end;

    generic [B: Region]
    function writeUrl(out: &![StringBuilder, B], text: String): Unit is
        if unsafeScheme(asSpan(&text)) then
            destroyString(text);
            writeText(&~out, "#ZgotmplZ");
        else
            writeUrlPath(&~out, text);
        end if;
        return nil;
    end;

    generic [B: Region]
    function writeUrlPath(out: &![StringBuilder, B], text: String): Unit is
        let encoded: String := percentEncoded(asSpan(&text), false);
        destroyString(text);
        return writeHtml(&~out, encoded);
    end;

    generic [B: Region]
    function writeUrlQuery(out: &![StringBuilder, B], text: String): Unit is
        let encoded: String := percentEncoded(asSpan(&text), true);
        destroyString(text);
        return writeHtml(&~out, encoded);
    end;

    generic [B: Region]
    function writeRaw(out: &![StringBuilder, B], text: String): Unit is
        writeString(&~out, asSpan(&text));
        destroyString(text);
        return nil;
    end;

    ---
    --- Filters
    ---

    function upper(text: String): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := length(&text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := nthByte(&text, i);
            if (b >= 'a') and (b <= 'z') then
                writeByte(&!out, b - 32);
            else
                writeByte(&!out, b);
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    function lower(text: String): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := length(&text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := nthByte(&text, i);
            if (b >= 'A') and (b <= 'Z') then
                writeByte(&!out, b + 32);
            else
                writeByte(&!out, b);
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    -- Space, tab, line feed, vertical tab, form feed, carriage return.
    function isSpace(b: Nat8): Bool is
        return (b = 32) or ((b >= 9) and (b <= 13));
    end;

    function trim(text: String): String is
        let total: Index := length(&text);
        var first: Index := 0;
        while (first < total) and isSpace(nthByte(&text, first)) do
            first := first + 1;
        end while;
        var last: Index := total;
        while (last > first) and isSpace(nthByte(&text, last - 1)) do
            last := last - 1;
        end while;
        var out: StringBuilder := makeStringBuilder();
        var i: Index := first;
        while i < last do
            writeByte(&!out, nthByte(&text, i));
            i := i + 1;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    ---
    --- More filters, operators and captured text
    ---

    function isAsciiUpper(b: Nat8): Bool is
        return (b >= 'A') and (b <= 'Z');
    end;

    function isAsciiLower(b: Nat8): Bool is
        return (b >= 'a') and (b <= 'z');
    end;

    function toUpperByte(b: Nat8): Nat8 is
        if isAsciiLower(b) then
            return b - 32;
        end if;
        return b;
    end;

    function toLowerByte(b: Nat8): Nat8 is
        if isAsciiUpper(b) then
            return b + 32;
        end if;
        return b;
    end;

    function capitalize(text: String): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := length(&text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := nthByte(&text, i);
            if i = 0 then
                writeByte(&!out, toUpperByte(b));
            else
                writeByte(&!out, toLowerByte(b));
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    -- Where a word of |title begins: after a hyphen, white space or one of
    -- ( { [ <.
    function beginsWord(b: Nat8): Bool is
        return ((b = '-') or isSpace(b)) or (((b = '(') or (b = '{')) or ((b = '[') or (b = '<')));
    end;

    function title(text: String): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := length(&text);
        var start: Bool := true;
        var i: Index := 0;
        while i < total do
            let b: Nat8 := nthByte(&text, i);
            if beginsWord(b) then
                writeByte(&!out, b);
                start := true;
            else
                if start then
                    writeByte(&!out, toUpperByte(b));
                else
                    writeByte(&!out, toLowerByte(b));
                end if;
                start := false;
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    -- Whether the bytes of part stand in value at at.
    generic [R: Region, S: Region]
    function standsAt(value: Span[Nat8, R], at: Index, part: Span[Nat8, S]): Bool is
        let partSize: Index := spanLength(part);
        if (at + partSize) > spanLength(value) then
            return false;
        end if;
        var same: Bool := true;
        var i: Index := 0;
        while i < partSize do
            if value[at + i] /= part[i] then
                same := false;
            end if;
            i := i + 1;
        end while;
        return same;
    end;

    function replaceText(text: String, old: Span[Nat8, Static], new: Span[Nat8, Static],
        limited: Bool, limit: Index): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := length(&text);
        let oldSize: Index := spanLength(old);
        var done: Index := 0;
        var i: Index := 0;
        while i < total do
            var take: Bool := (oldSize > 0) and standsAt(asSpan(&text), i, old);
            if limited and (done >= limit) then
                take := false;
            end if;
            if take then
                writeString(&!out, new);
                done := done + 1;
                i := i + oldSize;
            else
                writeByte(&!out, nthByte(&text, i));
                i := i + 1;
            end if;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    -- The byte where the code point numbered wanted begins, or the length.
    generic [R: Region]
    function codePointOffset(text: Span[Nat8, R], wanted: Index): Index is
        let total: Index := spanLength(text);
        var seen: Index := 0;
        var i: Index := 0;
        var found: Index := total;
        while (i < total) and (found = total) do
            let b: Nat8 := text[i];
            if (b < #x80) or (b >= #xC0) then
                if seen = wanted then
                    found := i;
                end if;
                seen := seen + 1;
            end if;
            i := i + 1;
        end while;
        return found;
    end;

    generic [R: Region]
    function codePoints(text: Span[Nat8, R]): Index is
        let total: Index := spanLength(text);
        var points: Index := 0;
        var i: Index := 0;
        while i < total do
            let b: Nat8 := text[i];
            if (b < #x80) or (b >= #xC0) then
                points := points + 1;
            end if;
            i := i + 1;
        end while;
        return points;
    end;

    function truncate(text: String, limit: Index, killWords: Bool, ending: Span[Nat8, Static],
        leeway: Index): String is
        if codePoints(asSpan(&text)) <= (limit + leeway) then
            return text;
        else
            return truncated(text, limit, killWords, ending);
        end if;
    end;

    -- The compiler has made sure that the ending fits into limit.
    function truncated(text: String, limit: Index, killWords: Bool, ending: Span[Nat8, Static]): String is
        let keep: Index := limit - codePoints(ending);
        var cut: Index := codePointOffset(asSpan(&text), keep);
        if not killWords then
            var last: Index := cut;
            var i: Index := 0;
            while i < cut do
                if nthByte(&text, i) = ' ' then
                    last := i;
                end if;
                i := i + 1;
            end while;
            cut := last;
        end if;
        var out: StringBuilder := makeStringBuilder();
        var j: Index := 0;
        while j < cut do
            writeByte(&!out, nthByte(&text, j));
            j := j + 1;
        end while;
        writeString(&!out, ending);
        destroyString(text);
        return finalize(out);
    end;

    function center(text: String, width: Index): String is
        let points: Index := codePoints(asSpan(&text));
        if points >= width then
            return text;
        else
            return centered(text, width, width - points);
        end if;
    end;

    function centered(text: String, width: Index, pad: Index): String is
        let two: Index := 2;
        var left: Index := pad / two;
        -- As Python's str.center: the odd space goes left when both the
        -- padding and the width are odd.
        if (rem(pad, two) = 1) and (rem(width, two) = 1) then
            left := left + 1;
        end if;
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < left do
            writeByte(&!out, ' ');
            i := i + 1;
        end while;
        writeString(&!out, asSpan(&text));
        i := left;
        while i < pad do
            writeByte(&!out, ' ');
            i := i + 1;
        end while;
        destroyString(text);
        return finalize(out);
    end;

    generic [T: Type(Render), R: Region]
    function joinDisplayed(sequence: &[Buffer[T], R], separator: Span[Nat8, Static]): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := bufferLength(sequence);
        var i: Index := 0;
        while i < total do
            if i > 0 then
                writeString(&!out, separator);
            end if;
            let shown: String := display(nthRef(sequence, i));
            writeString(&!out, asSpan(&shown));
            destroyString(shown);
            i := i + 1;
        end while;
        return finalize(out);
    end;

    function concat(left: String, right: String): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(&left));
        writeString(&!out, asSpan(&right));
        destroyString(left);
        destroyString(right);
        return finalize(out);
    end;

    instance Holds(String) is
        generic [R: Region, S: Region]
        method holds(value: &[String, R], text: Span[Nat8, S]): Bool is
            return textContains(asSpan(value), text);
        end;
    end;

    generic [U: Type(Render)]
    instance Holds(Buffer[U]) is
        generic [R: Region, S: Region]
        method holds(value: &[Buffer[U], R], text: Span[Nat8, S]): Bool is
            let total: Index := bufferLength(value);
            var found: Bool := false;
            var i: Index := 0;
            while i < total do
                let shown: String := display(nthRef(value, i));
                if sameText(asSpan(&shown), text) then
                    found := true;
                end if;
                destroyString(shown);
                i := i + 1;
            end while;
            return found;
        end;
    end;

    generic [R: Region, S: Region]
    function sameText(value: Span[Nat8, R], text: Span[Nat8, S]): Bool is
        return (spanLength(value) = spanLength(text)) and standsAt(value, 0, text);
    end;

    generic [R: Region, S: Region]
    function textContains(value: Span[Nat8, R], part: Span[Nat8, S]): Bool is
        let total: Index := spanLength(value);
        let partSize: Index := spanLength(part);
        if partSize = 0 then
            return true;
        end if;
        var found: Bool := false;
        var i: Index := 0;
        while (i + partSize) <= total do
            if standsAt(value, i, part) then
                found := true;
            end if;
            i := i + 1;
        end while;
        return found;
    end;

    generic [T: Free(Render)]
    function displayValue(value: T): String is
        let held: T := value;
        return display(&held);
    end;

    function makeCapture(): StringBuilder is
        return makeStringBuilder();
    end;

    function captured(capture: StringBuilder): String is
        return finalize(capture);
    end;

    function discard(text: String): Unit is
        destroyString(text);
        return nil;
    end;

    ---
    --- JavaScript and CSS, as Go's html/template escapes them: every table
    --- below was measured byte by byte with Go 1.27.1.
    ---

    -- The length of the valid UTF-8 sequence that starts at at, or 0.
    generic [T: Region]
    function utf8Length(text: Span[Nat8, T], at: Index): Index is
        let total: Index := spanLength(text);
        let b0: Nat8 := text[at];
        var need: Index := 0;
        if (b0 >= #xC2) and (b0 <= #xDF) then
            need := zero() + 2;
        else if (b0 >= #xE0) and (b0 <= #xEF) then
            need := zero() + 3;
        else if (b0 >= #xF0) and (b0 <= #xF4) then
            need := zero() + 4;
        else
            return 0;
        end if;
        if (at + need) > total then
            return 0;
        end if;
        var k: Index := 1;
        while k < need do
            let b: Nat8 := text[at + k];
            if (b < #x80) or (b > #xBF) then
                return 0;
            end if;
            k := k + 1;
        end while;
        let b1: Nat8 := text[at + 1];
        if ((b0 = #xE0) and (b1 < #xA0)) or ((b0 = #xED) and (b1 > #x9F)) then
            return 0;
        end if;
        if ((b0 = #xF0) and (b1 < #x90)) or ((b0 = #xF4) and (b1 > #x8F)) then
            return 0;
        end if;
        return need;
    end;

    -- U+2028 or U+2029 at at (E2 80 A8, E2 80 A9): 8 or 9, else 0.
    generic [T: Region]
    function lineSeparator(text: Span[Nat8, T], at: Index): Nat8 is
        if (at + 3) > spanLength(text) then
            return 0;
        end if;
        if (text[at] /= #xE2) or (text[at + 1] /= #x80) then
            return 0;
        end if;
        let b2: Nat8 := text[at + 2];
        if b2 = #xA8 then
            return 8;
        else if b2 = #xA9 then
            return 9;
        end if;
        return 0;
    end;

    -- \u00xx, lower-case hex.
    generic [B: Region]
    function writeU00(out: &![StringBuilder, B], b: Nat8): Unit is
        writeText(&~out, "\\u00");
        writeByte(&~out, lowerHex(b / 16));
        writeByte(&~out, lowerHex(b - ((b / 16) * 16)));
        return nil;
    end;

    -- quoted says which table: false the literal of a value (JSON's,
    -- with \b and a byte that is not UTF-8 made U+fffd), true the inside of
    -- a quoted string (more characters escaped; \b as \u0008; a byte that
    -- is not UTF-8 left as it is).  Both measured.
    generic [T: Region]
    function jsEscaped(text: Span[Nat8, T], quoted: Bool): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := spanLength(text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := text[i];
            if b >= #x80 then
                let n: Index := utf8Length(text, i);
                let sep: Nat8 := lineSeparator(text, i);
                if sep = 8 then
                    writeText(&!out, "\\u2028");
                    i := i + 3;
                else if sep = 9 then
                    writeText(&!out, "\\u2029");
                    i := i + 3;
                else if n = 0 then
                    if quoted then
                        writeByte(&!out, b);
                    else
                        writeByte(&!out, #xEF);
                        writeByte(&!out, #xBF);
                        writeByte(&!out, #xBD);
                    end if;
                    i := i + 1;
                else
                    var k: Index := 0;
                    while k < n do
                        writeByte(&!out, text[i + k]);
                        k := k + 1;
                    end while;
                    i := i + n;
                end if;
            else
                if b = 92 then
                    writeByte(&!out, 92);
                    writeByte(&!out, 92);
                else if b = 9 then
                    writeText(&!out, "\\t");
                else if b = 10 then
                    writeText(&!out, "\\n");
                else if b = 12 then
                    writeText(&!out, "\\f");
                else if b = 13 then
                    writeText(&!out, "\\r");
                else if (b = 8) and (not quoted) then
                    writeText(&!out, "\\b");
                else if b < 32 then
                    writeU00(&!out, b);
                else if (b = '&') or ((b = '<') or (b = '>')) then
                    writeU00(&!out, b);
                else if b = 34 then
                    if quoted then
                        writeU00(&!out, b);
                    else
                        writeText(&!out, "\\\"");
                    end if;
                else if quoted and (((b = 39) or (b = '+')) or (b = 96)) then
                    writeU00(&!out, b);
                else if quoted and (b = '/') then
                    writeText(&!out, "\\/");
                else
                    writeByte(&!out, b);
                end if;
                i := i + 1;
            end if;
        end while;
        return finalize(out);
    end;

    function jsQuote(text: String): String is
        var out: StringBuilder := makeStringBuilder();
        writeByte(&!out, 34);
        let inner: String := jsEscaped(asSpan(&text), false);
        writeString(&!out, asSpan(&inner));
        destroyString(inner);
        destroyString(text);
        writeByte(&!out, 34);
        return finalize(out);
    end;

    -- A number between spaces, as Go writes one where an expression goes.
    function spaced(digits: String): String is
        var out: StringBuilder := makeStringBuilder();
        writeByte(&!out, ' ');
        writeString(&!out, asSpan(&digits));
        writeByte(&!out, ' ');
        destroyString(digits);
        return finalize(out);
    end;

    function jsIndex(value: Index): String is
        return spaced(displayIndex(value));
    end;

    instance JsValue(String) is
        generic [R: Region]
        method jsValue(value: &[String, R]): String is
            return jsQuote(display(value));
        end;
    end;

    instance JsValue(Bool) is
        generic [R: Region]
        method jsValue(value: &[Bool, R]): String is
            if !value then
                return fromLiteral(" true ");
            else
                return fromLiteral(" false ");
            end if;
        end;
    end;

    instance JsValue(Nat8) is
        generic [R: Region]
        method jsValue(value: &[Nat8, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Nat16) is
        generic [R: Region]
        method jsValue(value: &[Nat16, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Nat32) is
        generic [R: Region]
        method jsValue(value: &[Nat32, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Nat64) is
        generic [R: Region]
        method jsValue(value: &[Nat64, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Int8) is
        generic [R: Region]
        method jsValue(value: &[Int8, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Int16) is
        generic [R: Region]
        method jsValue(value: &[Int16, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Int32) is
        generic [R: Region]
        method jsValue(value: &[Int32, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Int64) is
        generic [R: Region]
        method jsValue(value: &[Int64, R]): String is
            return spaced(display(value));
        end;
    end;

    instance JsValue(Index) is
        generic [R: Region]
        method jsValue(value: &[Index, R]): String is
            return spaced(display(value));
        end;
    end;

    generic [B: Region]
    function writeJsString(out: &![StringBuilder, B], text: String): Unit is
        let escaped: String := jsEscaped(asSpan(&text), true);
        destroyString(text);
        return writeRaw(&~out, escaped);
    end;

    generic [B: Region]
    function writeJsStringAttribute(out: &![StringBuilder, B], text: String): Unit is
        let escaped: String := jsEscaped(asSpan(&text), true);
        destroyString(text);
        return writeHtml(&~out, escaped);
    end;

    -- Go decodes CSS escapes before it judges a value; this refuses any
    -- backslash instead, a difference from Go.  The letters of the value,
    -- lower case and nothing else, may not spell expression or
    -- mozbinding.
    generic [T: Region]
    function cssValueSafe(text: Span[Nat8, T]): Bool is
        -- 92 is the backslash, 34 the double quote.
        let banned: Span[Nat8, Static] := "\\\"'()/;<>@[]`{}";
        let total: Index := spanLength(text);
        var letters: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        var safe: Bool := true;
        while i < total do
            let b: Nat8 := text[i];
            var k: Index := 0;
            while k < spanLength(banned) do
                if banned[k] = b then
                    safe := false;
                end if;
                k := k + 1;
            end while;
            if (b = '-') and ((i + 1) < total) then
                if text[i + 1] = '-' then
                    safe := false;
                end if;
            end if;
            if (b >= 'A') and (b <= 'Z') then
                writeByte(&!letters, b + 32);
            else if (b >= 'a') and (b <= 'z') then
                writeByte(&!letters, b);
            end if;
            i := i + 1;
        end while;
        let word: String := finalize(letters);
        if contains(asSpan(&word), "expression") or contains(asSpan(&word), "mozbinding") then
            safe := false;
        end if;
        destroyString(word);
        return safe;
    end;

    generic [T: Region]
    function contains(text: Span[Nat8, T], part: Span[Nat8, Static]): Bool is
        let total: Index := spanLength(text);
        let n: Index := spanLength(part);
        if n > total then
            return false;
        end if;
        var at: Index := 0;
        while (at + n) <= total do
            var k: Index := 0;
            var same: Bool := true;
            while same and (k < n) do
                if text[at + k] /= part[k] then
                    same := false;
                end if;
                k := k + 1;
            end while;
            if same then
                return true;
            end if;
            at := at + 1;
        end while;
        return false;
    end;

    function cssValue(text: String): String is
        if cssValueSafe(asSpan(&text)) then
            return text;
        else
            destroyString(text);
            return fromLiteral("ZgotmplZ");
        end if;
    end;

    generic [B: Region]
    function writeCssValue(out: &![StringBuilder, B], text: String): Unit is
        return writeRaw(&~out, cssValue(text));
    end;

    generic [B: Region]
    function writeCssValueAttribute(out: &![StringBuilder, B], text: String): Unit is
        return writeHtml(&~out, cssValue(text));
    end;

    -- The hex escape a CSS string writes for b, or an empty span when the
    -- byte stays.  The backslash is the one escape that is not hex.
    function cssEscapeOf(b: Nat8): Span[Nat8, Static] is
        if b = 9 then return "\\9"; end if;
        if b = 10 then return "\\a"; end if;
        if b = 12 then return "\\c"; end if;
        if b = 13 then return "\\d"; end if;
        if b = 34 then return "\\22"; end if;
        if b = '&' then return "\\26"; end if;
        if b = 39 then return "\\27"; end if;
        if b = '(' then return "\\28"; end if;
        if b = ')' then return "\\29"; end if;
        if b = '+' then return "\\2b"; end if;
        if b = '/' then return "\\2f"; end if;
        if b = ':' then return "\\3a"; end if;
        if b = ';' then return "\\3b"; end if;
        if b = '<' then return "\\3c"; end if;
        if b = '>' then return "\\3e"; end if;
        if b = '{' then return "\\7b"; end if;
        if b = '}' then return "\\7d"; end if;
        return "";
    end;

    function isHexDigit(b: Nat8): Bool is
        return ((b >= '0') and (b <= '9')) or (((b >= 'a') and (b <= 'f')) or ((b >= 'A') and (b <= 'F')));
    end;

    generic [T: Region]
    function cssStringEscaped(text: Span[Nat8, T]): String is
        var out: StringBuilder := makeStringBuilder();
        let unsafe: Bool := unsafeScheme(text);
        if unsafe then
            writeText(&!out, "#ZgotmplZ");
        end if;
        let total: Index := spanLength(text);
        var i: Index := 0;
        if unsafe then
            i := total;
        end if;
        while i < total do
            let b: Nat8 := text[i];
            if b = 92 then
                writeByte(&!out, 92);
                writeByte(&!out, 92);
            else
                let escape: Span[Nat8, Static] := cssEscapeOf(b);
                if spanLength(escape) = 0 then
                    writeByte(&!out, b);
                else
                    writeText(&!out, escape);
                    if (i + 1) = total then
                        writeByte(&!out, ' ');
                    else
                        let next: Nat8 := text[i + 1];
                        if isHexDigit(next) or (next = ' ') then
                            writeByte(&!out, ' ');
                        end if;
                    end if;
                end if;
            end if;
            i := i + 1;
        end while;
        return finalize(out);
    end;

    generic [B: Region]
    function writeCssString(out: &![StringBuilder, B], text: String): Unit is
        let escaped: String := cssStringEscaped(asSpan(&text));
        destroyString(text);
        return writeRaw(&~out, escaped);
    end;

    generic [B: Region]
    function writeCssStringAttribute(out: &![StringBuilder, B], text: String): Unit is
        let escaped: String := cssStringEscaped(asSpan(&text));
        destroyString(text);
        return writeHtml(&~out, escaped);
    end;
end module body.
