"""
A hash map whose keys are hashed with SipHash-1-3 under a key of its own.

- makeHashMap keys a map from the secure random source, so nobody outside can make lookups slow.
- makeHashMapKeyed takes the key from the caller, for a map that behaves the same on every run.
- keyAt and valueAt reach every entry by its position, from 0 to the size less one.
- Removing an entry moves the last one into its place; Standard.Map keeps its entries sorted.
- A key type is Hashable and has a TotalOrder, whose equal decides whether two keys are the same.
- An instance is seen only through an import from Standard.Hash or Standard.Order.

    var ages: HashMap[Nat64, Nat32] := makeHashMap();
    let replaced: Option[Pair[Nat64, Nat32]] := put(&!ages, id, 36);
    let age: Option[Nat32] := get(&ages, &id);
    destroyFree(ages);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Hash (
    Hashable
);

module Standard.HashMap is
    """
    The map type.
    """
    type HashMap[K: Type, V: Type]: Linear;

    """
    An empty map keyed from the system's secure random source.  When the
    source fails the key is taken from a counter of the process instead,
    which keeps the map working but lets its slots be guessed.
    """
    generic [K: Type, V: Type]
    function makeHashMap(): HashMap[K, V]
        ensures size(&result) = 0;

    """
    An empty map with the key key0, key1.
    """
    generic [K: Type, V: Type]
    function makeHashMapKeyed(key0: Nat64, key1: Nat64): HashMap[K, V]
        ensures size(&result) = 0;

    """
    Destroy an empty map.  The map must hold no entry: that is the duty of the
    caller, a requires, because the entry would be lost, and a linear key or
    value must not be lost.  A call on a map that holds one stops the
    programme with the line of the call.
    """
    generic [K: Type, V: Type]
    function destroyEmpty(map: HashMap[K, V]): Unit
        requires size(&map) = 0;

    """
    Destroy a map whose keys and values are free, whatever it holds.
    No contract: it only frees or closes what it is given.
    """
    generic [K: Free, V: Free]
    function destroyFree(map: HashMap[K, V]): Unit;

    """
    The number of entries.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [K: Type, V: Type, R: Region]
    function size(map: &[HashMap[K, V], R]): Index;

    """
    Whether the map holds key.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [K: Type(TotalOrder, Hashable), V: Type, R: Region, S: Region]
    function contains(map: &[HashMap[K, V], R], key: &[K, S]): Bool;

    """
    A copy of the value stored under key, for a free value.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder, Hashable), V: Free, R: Region, S: Region]
    function get(map: &[HashMap[K, V], R], key: &[K, S]): Option[V];

    """
    A reference to the value stored under key.  It lives as long as the
    borrow of the map.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder, Hashable), V: Type, R: Region, S: Region]
    function getRef(map: &[HashMap[K, V], R], key: &[K, S]): Option[&[V, R]];

    """
    Store value under key.  When the map held key already, the old key and
    the old value come back and the new ones stay; else None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder, Hashable), V: Type, R: Region]
    function put(map: &![HashMap[K, V], R], key: K, value: V): Option[Pair[K, V]];

    """
    Take the entry of key out of the map and give it back, or None when
    the map does not hold key.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder, Hashable), V: Type, R: Region, S: Region]
    function remove(map: &![HashMap[K, V], R], key: &[K, S]): Option[Pair[K, V]];

    """
    The key at position pos, from 0 to size - 1; None past the last.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type, V: Type, R: Region]
    function keyAt(map: &[HashMap[K, V], R], pos: Index): Option[&[K, R]];

    """
    The value at position pos, from 0 to size - 1; None past the last.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type, V: Type, R: Region]
    function valueAt(map: &[HashMap[K, V], R], pos: Index): Option[&[V, R]];

    """
    Take the entry at position pos out of the map and give it back; None
    past the last.  The last entry moves into its place.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type, V: Type, R: Region]
    function removeAt(map: &![HashMap[K, V], R], pos: Index): Option[Pair[K, V]];
end module.
