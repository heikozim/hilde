"""
The accounts of the system: the numbers of an account by its name, and who the process runs as.

- An account is looked up in the password database, as getpwnam(3) does; nothing is changed.
- A name longer than 255 bytes or holding a zero byte is no account.

    case lookupAccount("_notes") of
        when AccountFound(numbers as n: AccountNumbers) do
            useOwner(n.user, n.group);
        when NoAccount do
            refuse();
        when LookupFailed do
            refuse();
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Account is
    """
    The user number of an account and the number of its group.
    """
    record AccountNumbers: Free is
        user: Nat32;
        group: Nat32;
    end;

    """
    What the password database says of a name.
    """
    union AccountLookup: Free is
        """
        There is no account of that name.
        """
        case NoAccount;
        """
        The database could not be read.
        """
        case LookupFailed;
        """
        The account is there.
        """
        case AccountFound is
            numbers: AccountNumbers;
    end;

    """
    The numbers of the account name.
    No contract: the result depends on the system.
    """
    generic [R: Region]
    function lookupAccount(name: Span[Nat8, R]): AccountLookup;

    """
    The effective user number of the process.
    No contract: the result depends on the process.
    """
    function runningUser(): Nat32;

    """
    Whether the process runs as the superuser, user number 0.
    No contract: the result depends on the process.
    """
    function isSuperuser(): Bool;
end module.
