"""
Upper and lower case of UTF-8 text, and comparison without regard to case.

- The tables are those of the Unicode Character Database, version 17.0.0.
- The mappings are the full ones: the German sharp s maps to two capital letters s.
- A code point maps alone, without rules that look at its neighbours or at a language.
- So the Greek capital sigma always maps to the small sigma, never to the final one.
- The dotted and dotless i of Turkish are not special.
- Text that is not well-formed UTF-8 is refused, not repaired.

    let shout: Option[String] := toUpper("Gruesse aus Koeln");
    let same: Bool := equalIgnoringCase("STRASSE", asSpan(&street));
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);
import Standard.Utf8 (
    CodePoint
);

module Standard.Unicode is
    """
    The text in upper case.  None when it is not well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function toUpper(text: Span[Nat8, R]): Option[String];

    """
    The text in lower case.  None when it is not well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function toLower(text: Span[Nat8, R]): Option[String];

    """
    The text case-folded, the form two texts are compared in when case does
    not count: Strasse in small letters, in capitals and in the German
    spelling with the sharp s fold to the same.  None when it is not
    well-formed UTF-8.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function foldCase(text: Span[Nat8, R]): Option[String];

    """
    Whether the two texts are the same when case does not count, that is
    whether their case foldings are equal.  False when either is not
    well-formed UTF-8.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function equalIgnoringCase(left: Span[Nat8, R], right: Span[Nat8, S]): Bool;

    """
    Whether the code point changes under toUpper, toLower or foldCase.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function hasCase(point: CodePoint): Bool;
end module.
