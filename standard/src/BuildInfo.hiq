-- A safe module over Bindings.BuildInfo.
import Bindings.BuildInfo (
    commitText,
    dirtyFlag,
    buildSeconds,
    compilerText,
    valueTotal,
    nameAt,
    textAt
);
import Standard.Text (
    equal
);

module body Standard.BuildInfo is
    function commit(): Span[Nat8, Static] is
        return commitText();
    end;

    function dirty(): Bool is
        return dirtyFlag() = 1;
    end;

    function builtAt(): Int64 is
        return buildSeconds();
    end;

    function compilerVersion(): Span[Nat8, Static] is
        return compilerText();
    end;

    function valueCount(): Index is
        return valueTotal();
    end;

    function valueName(index: Index): Span[Nat8, Static] is
        if index >= valueTotal() then
            return "";
        end if;
        return nameAt(index);
    end;

    function valueText(index: Index): Span[Nat8, Static] is
        if index >= valueTotal() then
            return "";
        end if;
        return textAt(index);
    end;

    -- The names are few and given on the command line, so a walk over
    -- them is enough.
    generic [R: Region]
    function value(name: Span[Nat8, R]): Option[Span[Nat8, Static]] is
        let total: Index := valueTotal();
        var i: Index := 0;
        while i < total do
            if equal(nameAt(i), name) then
                return Some(value => textAt(i));
            end if;
            i := i + 1;
        end while;
        return None();
    end;
end module body.
