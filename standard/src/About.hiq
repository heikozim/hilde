-- A safe module: the text is put together from Standard.BuildInfo,
-- Standard.Platform, Standard.Time and Standard.Calendar.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyEmpty as destroyEmptyBuffer,
    length as bufferLength,
    nthRef
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Text (
    formatInt,
    endsWith
);
import Standard.BuildInfo (
    commit,
    dirty,
    builtAt,
    compilerVersion
);
import Standard.Platform (
    systemName,
    machineName,
    hostName
);
import Standard.Time (
    wallNanos
);
import Standard.Calendar (
    Instant,
    Civil,
    civilAt
);

module body Standard.About is
    -- The name, padded with blanks to column 13.
    generic [R: Region]
    function field(out: &![StringBuilder, R], name: Span[Nat8, Static]): Unit is
        writeString(&~out, name);
        var n: Index := spanLength(name);
        while n < 12 do
            writeByte(&~out, ' ');
            n := n + 1;
        end while;
        return nil;
    end;

    -- value with at least width digits, zeros in front.
    generic [R: Region]
    function padded(out: &![StringBuilder, R], value: Int64, width: Index): Unit is
        let digits: String := formatInt(value);
        var n: Index := spanLength(asSpan(&digits));
        while n < width do
            writeByte(&~out, '0');
            n := n + 1;
        end while;
        writeString(&~out, asSpan(&digits));
        destroyString(digits);
        return nil;
    end;

    -- A field of a date as Int64; every one fits, so None does not come.
    function wide8(value: Nat8): Int64 is
        case toInt64(value) of
            when Some(value as w: Int64) do
                return w;
            when None do
                return 0;
        end case;
    end;

    function wide32(value: Int32): Int64 is
        case toInt64(value) of
            when Some(value as w: Int64) do
                return w;
            when None do
                return 0;
        end case;
    end;

    generic [R: Region]
    function writeBuilt(out: &![StringBuilder, R], seconds: Int64): Unit is
        let at: Instant := Instant(seconds => seconds, nanos => 0);
        case civilAt(at, 0) of
            when Some(value as c: Civil) do
                padded(&~out, wide32(c.year), 4);
                writeByte(&~out, '-');
                padded(&~out, wide8(c.month), 2);
                writeByte(&~out, '-');
                padded(&~out, wide8(c.day), 2);
                writeByte(&~out, 'T');
                padded(&~out, wide8(c.hour), 2);
                writeByte(&~out, ':');
                padded(&~out, wide8(c.minute), 2);
                writeByte(&~out, ':');
                padded(&~out, wide8(c.second), 2);
                writeByte(&~out, 'Z');
            when None do
                writeString(&~out, "unknown");
        end case;
        return nil;
    end;

    function fullVersion(version: Span[Nat8, Static], notice: Span[Nat8, Static]): String is
        let none: Buffer[String] := allocateEmpty();
        let text: String := fullVersionWith(version, notice, &none);
        destroyEmptyBuffer(none);
        return text;
    end;

    generic [R: Region]
    function fullVersionWith(version: Span[Nat8, Static], notice: Span[Nat8, Static], libraries: &[Buffer[String], R]): String is
        var out: StringBuilder := makeStringBuilder();
        field(&!out, "version");
        writeString(&!out, version);
        writeByte(&!out, '\n');
        field(&!out, "commit");
        if spanLength(commit()) = 0 then
            writeString(&!out, "none");
        else
            writeString(&!out, commit());
            if dirty() then
                writeString(&!out, " (dirty)");
            end if;
        end if;
        writeByte(&!out, '\n');
        field(&!out, "built");
        writeBuilt(&!out, builtAt());
        writeByte(&!out, '\n');
        field(&!out, "compiler");
        writeString(&!out, "hilde ");
        writeString(&!out, compilerVersion());
        writeByte(&!out, '\n');
        field(&!out, "system");
        writeString(&!out, systemName());
        writeByte(&!out, '/');
        writeString(&!out, machineName());
        writeByte(&!out, '\n');
        var i: Index := 0;
        while i < bufferLength(libraries) do
            field(&!out, "library");
            writeString(&!out, asSpan(nthRef(libraries, i)));
            writeByte(&!out, '\n');
            i := i + 1;
        end while;
        if spanLength(notice) > 0 then
            field(&!out, "copyright");
            writeString(&!out, "Copyright (C) ");
            writeString(&!out, notice);
            writeByte(&!out, '\n');
        end if;
        return finalize(out);
    end;

    -- No ensures: the text depends on the clock and on the kernel.
    generic [A: Region, L: Region, C: Region]
    function info(art: Span[Nat8, A], longName: Span[Nat8, L], name: Span[Nat8, Static], version: Span[Nat8, Static], config: Span[Nat8, C]): String is
        var out: StringBuilder := makeStringBuilder();
        let artLength: Index := spanLength(art);
        if artLength > 0 then
            writeString(&!out, art);
            if not endsWith(art, "\n") then
                writeByte(&!out, '\n');
            end if;
        end if;
        if spanLength(longName) > 0 then
            writeString(&!out, longName);
            writeByte(&!out, '\n');
        end if;
        if (artLength > 0) or (spanLength(longName) > 0) then
            writeByte(&!out, '\n');
        end if;
        field(&!out, "name");
        writeString(&!out, name);
        writeByte(&!out, '\n');
        field(&!out, "version");
        writeString(&!out, version);
        writeByte(&!out, '\n');
        field(&!out, "commit");
        if spanLength(commit()) = 0 then
            writeString(&!out, "none");
        else
            writeString(&!out, commit());
            if dirty() then
                writeString(&!out, " (dirty)");
            end if;
        end if;
        writeByte(&!out, '\n');
        field(&!out, "system");
        writeString(&!out, systemName());
        writeByte(&!out, '\n');
        field(&!out, "arch");
        writeString(&!out, machineName());
        writeByte(&!out, '\n');
        field(&!out, "config");
        if spanLength(config) = 0 then
            writeString(&!out, "none");
        else
            writeString(&!out, config);
        end if;
        writeByte(&!out, '\n');
        field(&!out, "binary");
        writeString(&!out, nthArgument(0));
        writeByte(&!out, '\n');
        field(&!out, "compiler");
        writeString(&!out, "hilde ");
        writeString(&!out, compilerVersion());
        writeByte(&!out, '\n');
        field(&!out, "host");
        writeString(&!out, hostName());
        writeByte(&!out, '\n');
        field(&!out, "time");
        let billion: Nat64 := 1000000000;
        case toInt64(wallNanos() / billion) of
            when Some(value as seconds: Int64) do
                writeBuilt(&!out, seconds);
            when None do
                writeString(&!out, "unknown");
        end case;
        writeByte(&!out, '\n');
        return finalize(out);
    end;
end module body.
