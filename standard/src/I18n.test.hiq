import Standard.I18n (
    Category,
    Zero,
    Message,
    Text,
    Plural,
    Forms,
    Language,
    Catalog,
    englishPlural,
    germanPlural,
    languageOf,
    formOf,
    directionOf,
    Direction,
    Rtl,
    Ltr,
    bcp47Tag,
    Arguments,
    makeArguments,
    countArguments,
    addText,
    addNumber,
    destroyArguments,
    render,
    translate
);
import Standard.String (
    String,
    destroyString,
    length as stringLength,
    nthByte
);
import Standard.Testing (
    assertTrue,
    assertFalse
);

module body Standard.I18n.Test is
    union Key: Free is
        case Greeting;
        case Items;
        case Apples;
    end;

    function english(key: Key): Message is
        case key of
            when Greeting do
                return Text(text => "Hello, {name}!");
            when Items do
                return Plural(one => "{count} item", other => "{count} items");
            when Apples do
                return Forms(zero => "no apples", one => "", two => "", few => "", many => "", other => "{count} apples");
        end case;
    end;

    function german(key: Key): Message is
        case key of
            when Greeting do
                return Text(text => "Hallo, {name}!");
            when Items do
                return Plural(one => "{count} Teil", other => "{count} Teile");
            when Apples do
                return Forms(zero => "keine Aepfel", one => "ein Apfel", two => "", few => "", many => "", other => "{count} Aepfel");
        end case;
    end;

    -- Zero for 0, then the rule of English: a rule a catalog brings itself.
    function zeroFirst(count: Int64): Category is
        if count = 0 then
            return Zero();
        end if;
        return englishPlural(count);
    end;

    function germanLanguage(): Language[Key] is
        return Language(code => "de", texts => german, plural => zeroFirst);
    end;

    function others(i: Index): Option[Language[Key]] is
        if i = 0 then
            return Some(value => germanLanguage());
        end if;
        return None();
    end;

    function catalog(): Catalog[Key] is
        return Catalog(default => Language(code => "en", texts => english, plural => zeroFirst), others => others);
    end;

    function counted(n: Int64): Option[Int64] is
        return Some(value => n);
    end;

    function noCount(): Option[Int64] is
        return None();
    end;

    generic [R: Region]
    function sameText(text: &[String, R], other: Span[Nat8, Static]): Bool is
        let size: Index := stringLength(text);
        if size /= spanLength(other) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            if nthByte(text, i) /= other[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    function check(text: String, expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        assertTrue(sameText(&text, expected), message);
        destroyString(text);
        return nil;
    end;

    function testLanguageByCode(): Unit is
        var arguments: Arguments := makeArguments();
        addText(&!arguments, "name", "Ada");
        check(translate(catalog(), "de", Greeting(), noCount(), &arguments), "Hallo, Ada!", "de gives the German text");
        check(translate(catalog(), "DE", Greeting(), noCount(), &arguments), "Hallo, Ada!", "the code is matched without regard to case");
        check(translate(catalog(), "en", Greeting(), noCount(), &arguments), "Hello, Ada!", "en gives the English text");
        check(translate(catalog(), "fr", Greeting(), noCount(), &arguments), "Hello, Ada!", "a code no language has gives the default");
        check(translate(catalog(), "", Greeting(), noCount(), &arguments), "Hello, Ada!", "the empty code gives the default");
        check(translate(catalog(), "d", Greeting(), noCount(), &arguments), "Hello, Ada!", "a code is matched whole, not by its start");
        destroyArguments(arguments);
        let found: Language[Key] := languageOf(catalog(), "De");
        assertTrue(spanLength(found.code) = 2, "languageOf finds the language of a code");
        return nil;
    end;

    function testPlural(): Unit is
        var arguments: Arguments := makeArguments();
        addNumber(&!arguments, "count", 1);
        check(translate(catalog(), "en", Items(), counted(1), &arguments), "1 item", "one item");
        destroyArguments(arguments);
        var more: Arguments := makeArguments();
        addNumber(&!more, "count", 3);
        check(translate(catalog(), "de", Items(), counted(3), &more), "3 Teile", "three in German");
        check(translate(catalog(), "de", Items(), noCount(), &more), "3 Teile", "no count gives the other form");
        check(translate(catalog(), "de", Greeting(), counted(1), &more), "Hallo, {name}!", "a Text is the text for any count");
        destroyArguments(more);
        return nil;
    end;

    function testForms(): Unit is
        var arguments: Arguments := makeArguments();
        addNumber(&!arguments, "count", 0);
        check(translate(catalog(), "en", Apples(), counted(0), &arguments), "no apples", "the zero form of a rule that has it");
        check(translate(catalog(), "de", Apples(), counted(0), &arguments), "keine Aepfel", "zero in German");
        destroyArguments(arguments);
        var one: Arguments := makeArguments();
        addNumber(&!one, "count", 1);
        check(translate(catalog(), "en", Apples(), counted(1), &one), "1 apples", "an empty form stands for other");
        check(translate(catalog(), "de", Apples(), counted(1), &one), "ein Apfel", "a form that is there is taken");
        destroyArguments(one);
        assertTrue(spanLength(formOf(english(Apples()), englishPlural, counted(0))) = 14, "English's rule has no zero: 0 is other");
        assertTrue(spanLength(formOf(german(Items()), germanPlural, counted(1))) = 12, "German's rule: 1 is one");
        return nil;
    end;

    function testPlaceholders(): Unit is
        var arguments: Arguments := makeArguments();
        addText(&!arguments, "a", "x");
        addText(&!arguments, "long_name2", "y");
        check(render("{a}{long_name2}", &arguments), "xy", "two placeholders side by side");
        check(render("{missing} stays", &arguments), "{missing} stays", "a placeholder without an argument stays as written");
        check(render("{{a}} and }}", &arguments), "{a} and }", "doubled braces are single ones");
        check(render("{ a} {} {a", &arguments), "{ a} {} {a", "braces that open no name stay");
        check(render("", &arguments), "", "the empty text");
        destroyArguments(arguments);
        return nil;
    end;

    function testArguments(): Unit is
        var arguments: Arguments := makeArguments();
        assertTrue(countArguments(&arguments) = 0, "no arguments at first");
        addText(&!arguments, "n", "first");
        addText(&!arguments, "n", "second");
        assertTrue(countArguments(&arguments) = 2, "two arguments");
        check(render("{n}", &arguments), "first", "a name given twice keeps the first");
        destroyArguments(arguments);
        var numbers: Arguments := makeArguments();
        addNumber(&!numbers, "zero", 0);
        addNumber(&!numbers, "big", 1234567);
        addNumber(&!numbers, "negative", -7);
        addNumber(&!numbers, "low", -9223372036854775807);
        check(render("{zero} {big} {negative} {low}", &numbers), "0 1234567 -7 -9223372036854775807", "numbers in decimal digits");
        destroyArguments(numbers);
        return nil;
    end;

    function testPluralRules(): Unit is
        assertTrue(spanLength(formOf(Plural(one => "a", other => "bb"), englishPlural, counted(1))) = 1, "English: 1 is one");
        assertTrue(spanLength(formOf(Plural(one => "a", other => "bb"), englishPlural, counted(0))) = 2, "English: 0 is other");
        assertTrue(spanLength(formOf(Plural(one => "a", other => "bb"), englishPlural, counted(2))) = 2, "English: 2 is other");
        assertTrue(spanLength(formOf(Plural(one => "a", other => "bb"), germanPlural, counted(-1))) = 2, "German: -1 is other");
        assertFalse(spanLength(formOf(Plural(one => "a", other => "bb"), germanPlural, counted(1))) = 2, "German: 1 is not other");
        return nil;
    end;

    -- Says whether a direction is right to left; a union has no equality.
    function rtlDirection(d: Direction): Bool is
        case d of
            when Rtl do
                return true;
            when Ltr do
                return false;
        end case;
    end;

    function testDirection(): Unit is
        assertTrue(rtlDirection(directionOf("ar")), "ar is right to left");
        assertTrue(rtlDirection(directionOf("ar-EG")), "ar-EG is right to left");
        assertTrue(rtlDirection(directionOf("he_IL")), "he_IL is right to left");
        assertTrue(rtlDirection(directionOf("fa-IR")), "fa-IR is right to left");
        assertTrue(rtlDirection(directionOf("ur")), "ur is right to left");
        assertTrue(rtlDirection(directionOf("ps")), "ps is right to left");
        assertTrue(rtlDirection(directionOf("dv")), "dv is right to left");
        assertTrue(rtlDirection(directionOf("yi")), "yi is right to left");
        assertTrue(rtlDirection(directionOf("sd")), "sd is right to left");
        assertTrue(rtlDirection(directionOf("ug")), "ug is right to left");
        assertTrue(rtlDirection(directionOf("ckb")), "ckb is right to left");
        assertTrue(rtlDirection(directionOf("ks")), "ks is right to left");
        assertTrue(rtlDirection(directionOf("nqo")), "nqo is right to left");
        assertTrue(rtlDirection(directionOf("iw")), "the legacy code iw is right to left");
        assertTrue(rtlDirection(directionOf("AR_eg")), "the language is matched without regard to case");
        assertFalse(rtlDirection(directionOf("en")), "en is left to right");
        assertFalse(rtlDirection(directionOf("de-DE")), "de-DE is left to right");
        assertFalse(rtlDirection(directionOf("zh-Hant-TW")), "Chinese is left to right");
        assertFalse(rtlDirection(directionOf("art")), "a language that only starts like ar is left to right");
        assertFalse(rtlDirection(directionOf("")), "the empty locale is left to right");
        return nil;
    end;

    function testBcp47(): Unit is
        check(bcp47Tag("zh_hant_tw"), "zh-Hant-TW", "a script and a region, separators of both kinds");
        check(bcp47Tag("EN-us"), "en-US", "the case of language and region is normalised");
        check(bcp47Tag("sr-latn"), "sr-Latn", "a script alone takes its capital first letter");
        check(bcp47Tag("de_de"), "de-DE", "a region alone");
        check(bcp47Tag("ar-EG"), "ar-EG", "a right to left locale keeps its tag");
        check(bcp47Tag("iw_IL"), "iw-IL", "the legacy code keeps its region");
        check(bcp47Tag("en_US_POSIX"), "en-US-posix", "a variant comes out in small letters");
        check(bcp47Tag("de-DE-1999"), "de-DE-1999", "three digits come out as they are");
        check(bcp47Tag("en--us"), "en-US", "doubled separators come out as one");
        check(bcp47Tag("en-"), "en", "a separator left over at the end comes out not at all");
        check(bcp47Tag("abc"), "abc", "a lone language stays in small letters");
        check(bcp47Tag(""), "", "the empty locale gives the empty string");
        return nil;
    end;
end module body.
