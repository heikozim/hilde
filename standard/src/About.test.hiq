import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Text (
    contains,
    startsWith,
    endsWith
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    length,
    removeLast,
    destroyEmpty
);
import Standard.About (
    fullVersion,
    fullVersionWith,
    info
);
import Standard.Platform (
    hostName
);

module body Standard.About.Test is
    function testLines(): Unit is
        let text: String := fullVersion("1.2.0", "2026 Example");
        let s: Span[Nat8, Static] := "";
        assertTrue(startsWith(asSpan(&text), "version     1.2.0\n"), "the version first, the value at column 13");
        assertTrue(contains(asSpan(&text), "\ncommit      "), "the commit");
        assertTrue(contains(asSpan(&text), "\nbuilt       "), "the build time");
        assertTrue(contains(asSpan(&text), "Z\ncompiler    hilde "), "the time in UTC, then the compiler");
        assertTrue(contains(asSpan(&text), "\nsystem      "), "the system");
        assertTrue(endsWith(asSpan(&text), "\ncopyright   Copyright (C) 2026 Example\n"), "the copyright last");
        destroyString(text);
        let plain: String := fullVersion("1.2.0", s);
        assertTrue(not contains(asSpan(&plain), "copyright"), "no notice, no copyright line");
        destroyString(plain);
        return nil;
    end;

    function testLibraries(): Unit is
        var libraries: Buffer[String] := allocateEmpty();
        insertBack(&!libraries, fromLiteral("sqlite 3.46.1"));
        insertBack(&!libraries, fromLiteral("pcre2 10.45"));
        let text: String := fullVersionWith("1.2.0", "2026 Example", &libraries);
        assertTrue(contains(asSpan(&text), "\nlibrary     sqlite 3.46.1\nlibrary     pcre2 10.45\ncopyright   Copyright (C) 2026 Example\n"), "the libraries in their order, before the copyright");
        destroyString(text);
        destroyStrings(libraries);
        return nil;
    end;

    function destroyStrings(strings: Buffer[String]): Unit is
        var rest: Buffer[String] := strings;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function testInfo(): Unit is
        let empty: Span[Nat8, Static] := "";
        let text: String := info("  *\n ***", "Some Tool Of Mine", "stom", "1.2.0", "/etc/stom.conf");
        assertTrue(startsWith(asSpan(&text), "  *\n ***\nSome Tool Of Mine\n\nname        stom\nversion     1.2.0\n"), "the art, a line feed added, the long name, a blank line, then the fields");
        assertTrue(contains(asSpan(&text), "\ncommit      "), "the commit");
        assertTrue(contains(asSpan(&text), "\nsystem      "), "the system");
        assertTrue(contains(asSpan(&text), "\narch        "), "the arch");
        assertTrue(contains(asSpan(&text), "\nconfig      /etc/stom.conf\n"), "the config");
        assertTrue(contains(asSpan(&text), "\nbinary      "), "the binary");
        assertTrue(contains(asSpan(&text), "\ncompiler    hilde "), "the compiler");
        assertTrue(contains(asSpan(&text), "\nhost        "), "the host");
        assertTrue(contains(asSpan(&text), "\ntime        2"), "the time, this century");
        assertTrue(endsWith(asSpan(&text), "Z\n"), "in UTC, last");
        destroyString(text);
        let plain: String := info(empty, empty, "stom", "1.2.0", empty);
        assertTrue(startsWith(asSpan(&plain), "name        stom\n"), "no art, no long name: the fields first");
        assertTrue(contains(asSpan(&plain), "\nconfig      none\n"), "no config");
        destroyString(plain);
        assertTrue(spanLength(hostName()) > 0, "a host name");
        assertTrue(spanLength(hostName()) < 256, "at most 255 bytes");
        return nil;
    end;
end module body.
