"""
Questions about an HTTP header block, answered from the text of the block as it stands.

- A block is lines separated by CRLF or a bare LF, ending at the first empty line or at the end.
- Each question takes time linear in the length of the block and keeps nothing of it.
- Header names are compared without regard to case, as RFC 9110 defines them.
- A line without a colon has neither a name nor a value.
- A header value that is a list is read item by item, with white space around each item allowed.

    let length: Option[String] := headerValue(asSpan(&headers), "Content-Length");
    let upgrade: Bool := valueHasToken(asSpan(&connection), "upgrade");
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Http is
    """
    How many header lines the block has.

    Counting stops at the first empty line, which is where the headers end
    and the body begins.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function headerCount(block: Span[Nat8, R]): Index;

    """
    The name of header n, counting from 0, with no trailing colon and no
    surrounding whitespace.  None when there is no such header, or when
    the line carries no colon.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function nthHeaderName(block: Span[Nat8, R], n: Index): Option[String];

    """
    The value of header n, with the whitespace either side removed.
    None under the same conditions as nthHeaderName.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function nthHeaderValue(block: Span[Nat8, R], n: Index): Option[String];

    """
    The value of the first header whose name matches name, ignoring case.
    None when there is none.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function headerValue(block: Span[Nat8, R], name: Span[Nat8, S]): Option[String];

    """
    Is token one of the comma-separated items of value?

    The headers that carry a list -- Connection, Upgrade, TE -- have to
    be read this way.  RFC 9110 5.6.1 allows whitespace around every item and
    more than one item, so comparing the whole value answers a question about
    spelling instead of one about content: websocket and
    websocket, foo say the same thing about websocket, and only the first
    survives a whole-value compare.

    The comparison ignores case, which is what the tokens of those headers
    are defined to be.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function valueHasToken(value: Span[Nat8, R], token: Span[Nat8, S]): Bool;
end module.
