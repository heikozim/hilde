"""
Assertions for tests run by hilde test.

- Each assertion prints a line that names what it checks and ends it with ok when it holds.
- A check that fails ends the programme with a message on standard error, and with it the test.
- assertFailure marks a step the test must not reach; assertSuccess one it reached.
- underValgrind is true only under hilde test --valgrind, to allow for its slowdown.

    assertTrue(isLeapYear(2024), "2024 is a leap year");
    assertFalse(isLeapYear(1900), "1900, divided by 100 but not by 400, is not");
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Testing is
    """
    Checks that value is true.  Prints the message and ok, or ends the
    programme when value is false.
    No contract: its effect is on the system or on what it consumes, which a condition cannot read.
    """
    function assertTrue(value: Bool, message: Span[Nat8, Static]): Unit;

    """
    Checks that value is false.  Prints the message and ok, or ends the
    programme when value is true.
    No contract: its effect is on the system or on what it consumes, which a condition cannot read.
    """
    function assertFalse(value: Bool, message: Span[Nat8, Static]): Unit;

    """
    Records a step the test reached.  Prints the message and ok; it never
    fails.
    No contract: its effect is on the system or on what it consumes, which a condition cannot read.
    """
    function assertSuccess(message: Span[Nat8, Static]): Unit;

    """
    Records a step the test must not reach.  Prints the message and ends
    the programme.
    No contract: its effect is on the system or on what it consumes, which a condition cannot read.
    """
    function assertFailure(message: Span[Nat8, Static]): Unit;

    """
    Whether the test runs under valgrind, as hilde test --valgrind runs
    it; false in every other run.  A test that bounds a time uses it to
    allow for valgrind's slowdown, and for nothing else.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    function underValgrind(): Bool;
end module.
