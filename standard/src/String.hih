"""
The String type, a linear byte string on the heap that owns its bytes.

- A String is bytes; nothing here checks that they are UTF-8.
- It is linear: destroyString gives it back.
- Every position is checked, and one out of range stops the programme.
- Making a string aborts when the memory cannot be had.
- A function that only reads text takes a span; asSpan gives all the bytes, even of an empty string.
- A span keeps the reference to its string; fromSpan copies the bytes into a string of their own.

    var line: String := fromLiteral("hello, world");
    storeNth(&!line, 0, 72);
    let head: String := fromSpan(getSpan(&line, 0, 4));
    let size: Index := length(&line);
    destroyString(head);
    destroyString(line);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.Buffer (
    Buffer,
    length as bufferLength
);

module Standard.String is
    type String: Linear;

    ---
    --- Lifecycle
    ---

    """
    Allocate and return an empty string.
    """
    function makeEmpty(): String
        ensures length(&result) = 0;

    """
    Allocate and return a string with the given size, where all bytes have
    the value of initial.
    """
    function makeString(size: Index, initial: Nat8): String
        ensures length(&result) = size;

    """
    Deallocate a string.
    No contract: it only frees or closes what it is given.
    """
    function destroyString(str: String): Unit;

    """
    Allocate and return a string from a string literal.
    """
    function fromLiteral(arr: Span[Nat8, Static]): String
        ensures length(&result) = spanLength(arr);

    """
    A fresh string holding a copy of the bytes of span, for text a function
    gave as a span -- a part of another string -- that has to be kept after
    that string is gone.
    """
    generic [R: Region]
    function fromSpan(span: Span[Nat8, R]): String
        ensures length(&result) = spanLength(span);

    """
    Turn a byte buffer into a string.
    """
    function fromByteBuffer(buffer: Buffer[Nat8]): String
        ensures length(&result) = old(bufferLength(&buffer));

    ---
    --- Retrieve
    ---

    """
    Return the length of the string.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function length(string: &[String, R]): Index;

    """
    Return the nth byte of the string.
    """
    generic [R: Region]
    function nthByte(string: &[String, R], pos: Index): Nat8
        requires pos < length(string);

    ---
    --- Update
    ---

    """
    Write a byte to the given position in the string.
    """
    generic [R: Region]
    function storeNth(string: &![String, R], pos: Index, byte: Nat8): Unit
        requires pos < length(&string)
        ensures length(&string) = old(length(&string));

    ---
    --- Spans
    ---

    """
    The bytes from start to final, both included, as a span.  Stops the
    programme when start is greater than final or final is not less than
    the length; an empty string has no such pair, and asSpan is the way to
    all of its bytes.
    """
    generic [R: Region]
    function getSpan(string: &[String, R], start: Index, final: Index): Span[Nat8, R]
        requires start <= final
        requires final < length(string)
        ensures spanLength(result) = ((final - start) + 1);

    """
    All the bytes of the string as a span, the way a function that only
    reads text takes it.  An empty string gives an empty span, so this
    never stops the programme.
    """
    generic [R: Region]
    function asSpan(string: &[String, R]): Span[Nat8, R]
        ensures spanLength(result) = length(string);

    """
    Get a mutable span from the string.
    """
    generic [R: Region]
    function getSpanMut(string: &![String, R], start: Index, final: Index): Span![Nat8, R]
        requires start <= final
        requires final < length(&string);

    """
    Deallocate a string after overwriting its bytes with zeros, for a
    secret.  A string that grew left its earlier storage behind unwiped.
    No contract: it only frees or closes what it is given.
    """
    function destroyWiped(str: String): Unit;
end module.
