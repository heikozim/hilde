--
-- The tables are held by one digest over every code point, the one
-- scripts/unicode/make-property-tables.py --digests prints for Unicode
-- 17.0.0; the other tests name single code points whose properties are
-- plain.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyFree,
    length as bufferLength,
    nth
);
import Standard.Testing (
    assertTrue,
    assertFalse
);
import Standard.UnicodeProperties (
    generalCategory,
    scriptOf,
    appendProperty,
    nextInFoldOrbit,
    appendFoldPartners
);

module body Standard.UnicodeProperties.Test is
    generic [R: Region, S: Region]
    function same(left: Span[Nat8, R], right: Span[Nat8, S]): Bool is
        if spanLength(left) /= spanLength(right) then
            return false;
        end if;
        var i: Index := 0;
        while i < spanLength(left) do
            if left[i] /= right[i] then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    function testCategories(): Unit is
        assertTrue(same(generalCategory(65), "Lu"), "A is Lu");
        assertTrue(same(generalCategory(97), "Ll"), "a is Ll");
        assertTrue(same(generalCategory(49), "Nd"), "1 is Nd");
        assertTrue(same(generalCategory(32), "Zs"), "the space is Zs");
        assertTrue(same(generalCategory(8364), "Sc"), "the euro sign is Sc");
        assertTrue(same(generalCategory(888), "Cn"), "U+0378 is not assigned");
        assertTrue(same(generalCategory(1114112), "Cn"), "one past U+10FFFF");
        assertTrue(same(generalCategory(0), "Cc"), "U+0000 is Cc");
        assertTrue(same(generalCategory(1114109), "Co"), "U+10FFFD is Co, in a range of UnicodeData.txt");
        return nil;
    end;

    function testScripts(): Unit is
        assertTrue(same(scriptOf(65), "Latin"), "A is Latin");
        assertTrue(same(scriptOf(945), "Greek"), "alpha is Greek");
        assertTrue(same(scriptOf(19968), "Han"), "U+4E00 is Han");
        assertTrue(same(scriptOf(49), "Common"), "1 is Common");
        assertTrue(same(scriptOf(768), "Inherited"), "U+0300 is Inherited");
        assertTrue(same(scriptOf(888), "Unknown"), "U+0378 is Unknown");
        return nil;
    end;

    -- Whether ranges holds point, and whether its pairs are sorted and do
    -- not touch.
    generic [R: Region]
    function holds(ranges: &[Buffer[Index], R], point: Index): Bool is
        var i: Index := 0;
        while i < bufferLength(ranges) do
            if (nth(ranges, i) <= point) and (point <= nth(ranges, i + 1)) then
                return true;
            end if;
            i := i + 2;
        end while;
        return false;
    end;

    generic [R: Region]
    function ordered(ranges: &[Buffer[Index], R]): Bool is
        var i: Index := 2;
        while i < bufferLength(ranges) do
            if (nth(ranges, i - 1) + 1) >= nth(ranges, i) then
                return false;
            end if;
            i := i + 2;
        end while;
        return true;
    end;

    function testProperties(): Unit is
        var upper: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("Lu", &!upper), "Lu is a name");
        assertTrue(holds(&upper, 65) and holds(&upper, 913), "Lu holds A and capital alpha");
        assertFalse(holds(&upper, 97), "Lu does not hold a");
        assertTrue(ordered(&upper), "the pairs of Lu are sorted and do not touch");
        destroyFree(upper);
        var letters: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("L", &!letters), "L is a name");
        assertTrue(holds(&letters, 97) and holds(&letters, 19968), "L holds a and U+4E00");
        assertFalse(holds(&letters, 49), "L does not hold 1");
        assertTrue(ordered(&letters), "the pairs of L are sorted and do not touch");
        destroyFree(letters);
        var greek: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("Greek", &!greek), "Greek is a name");
        assertTrue(holds(&greek, 945) and (not holds(&greek, 65)), "Greek holds alpha, not A");
        assertTrue(ordered(&greek), "the pairs of Greek are sorted and do not touch");
        destroyFree(greek);
        var any: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("Any", &!any), "Any is a name");
        assertTrue(bufferLength(&any) = 2, "Any is one pair");
        destroyFree(any);
        var none: Buffer[Index] := allocateEmpty();
        assertFalse(appendProperty("Foo", &!none), "Foo is not a name");
        assertFalse(appendProperty("", &!none), "the empty name is not one");
        assertFalse(appendProperty("Latn", &!none), "a script's short alias is not one");
        assertFalse(appendProperty("L&", &!none), "L& is not one");
        assertFalse(appendProperty("Unknown", &!none), "Unknown is not one");
        assertTrue(bufferLength(&none) = 0, "a name refused appends nothing");
        destroyFree(none);
        return nil;
    end;

    function testLooseNames(): Unit is
        var latin: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("latin", &!latin), "latin, small");
        assertTrue(holds(&latin, 97), "latin holds a");
        destroyFree(latin);
        var italic: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("old italic", &!italic), "old italic with a space");
        assertTrue(holds(&italic, 66304), "Old_Italic holds U+10300");
        destroyFree(italic);
        var upper: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("l-u", &!upper), "l-u with a hyphen");
        assertTrue(holds(&upper, 65) and (not holds(&upper, 97)), "l-u is Lu");
        destroyFree(upper);
        var letter: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("Uppercase_Letter", &!letter), "a long name");
        assertTrue(holds(&letter, 65) and (not holds(&letter, 97)), "Uppercase_Letter is Lu");
        destroyFree(letter);
        return nil;
    end;

    function testSets(): Unit is
        var unassigned: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("Cn", &!unassigned), "Cn is a name");
        assertTrue(holds(&unassigned, 888) and (not holds(&unassigned, 97)), "Cn holds U+0378, not a");
        assertTrue(ordered(&unassigned), "the pairs of Cn are sorted and do not touch");
        destroyFree(unassigned);
        var other: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("C", &!other), "C is a name");
        assertTrue(holds(&other, 888) and holds(&other, 0), "C holds U+0378 and U+0000");
        assertTrue(holds(&other, 57344) and (not holds(&other, 97)), "C holds U+E000, not a");
        assertTrue(ordered(&other), "the pairs of C are sorted and do not touch");
        destroyFree(other);
        var cased: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("LC", &!cased), "LC is a name");
        assertTrue(holds(&cased, 97) and holds(&cased, 453), "LC holds a and the title case U+01C5");
        assertFalse(holds(&cased, 688), "LC does not hold the modifier letter U+02B0");
        destroyFree(cased);
        var assigned: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("Assigned", &!assigned), "Assigned is a name");
        assertTrue(holds(&assigned, 97) and (not holds(&assigned, 888)), "Assigned holds a, not U+0378");
        destroyFree(assigned);
        var ascii: Buffer[Index] := allocateEmpty();
        assertTrue(appendProperty("ASCII", &!ascii), "ASCII is a name");
        assertTrue((bufferLength(&ascii) = 2) and (nth(&ascii, 1) = 127), "ASCII is 0 to 127");
        destroyFree(ascii);
        return nil;
    end;

    function testOrbits(): Unit is
        assertTrue(nextInFoldOrbit(75) = 107, "K goes to k");
        assertTrue(nextInFoldOrbit(107) = 8490, "k goes to the Kelvin sign");
        assertTrue(nextInFoldOrbit(8490) = 75, "the Kelvin sign goes back to K");
        assertTrue(nextInFoldOrbit(49) = 49, "1 folds with nothing");
        var partners: Buffer[Index] := allocateEmpty();
        appendFoldPartners(115, 115, &!partners);
        assertTrue(holds(&partners, 83) and holds(&partners, 383), "s folds with S and the long s");
        assertFalse(holds(&partners, 115), "the code point itself is not appended");
        destroyFree(partners);
        var sigma: Buffer[Index] := allocateEmpty();
        appendFoldPartners(931, 931, &!sigma);
        assertTrue(holds(&sigma, 962) and holds(&sigma, 963), "capital sigma folds with both small ones");
        destroyFree(sigma);
        return nil;
    end;

    function hashSpan(hash: Nat32, text: Span[Nat8, Static]): Nat32 is
        let prime: Nat32 := 16777619;
        var h: Nat32 := hash;
        var i: Index := 0;
        while i < spanLength(text) do
            case toNat32(text[i]) of
                when Some(value as byte: Nat32) do
                    h := modularMultiply(bitwiseXor(h, byte), prime);
                when None do
                    abort("Standard.UnicodeProperties.Test: a byte did not fit a Nat32");
            end case;
            i := i + 1;
        end while;
        return h;
    end;

    function hashIndexByte(hash: Nat32, value: Index): Nat32 is
        let prime: Nat32 := 16777619;
        let byte: Index := value - ((value / 256) * 256);
        case toNat32(byte) of
            when Some(value as wide: Nat32) do
                return modularMultiply(bitwiseXor(hash, wide), prime);
            when None do
                abort("Standard.UnicodeProperties.Test: a byte did not fit a Nat32");
        end case;
    end;

    -- The FNV-1a hash over every code point of its category, its script and
    -- the three bytes of the next code point of its orbit, lowest first, as
    -- make-property-tables.py --digests computes it.
    function testDigest(): Unit is
        let limit: Index := #x110000;
        var hash: Nat32 := 2166136261;
        var point: Index := 0;
        while point < limit do
            hash := hashSpan(hash, generalCategory(point));
            hash := hashSpan(hash, scriptOf(point));
            let next: Index := nextInFoldOrbit(point);
            hash := hashIndexByte(hash, next);
            hash := hashIndexByte(hash, next / 256);
            hash := hashIndexByte(hash, next / 65536);
            point := point + 1;
        end while;
        let want: Nat32 := 3765915005;
        assertTrue(hash = want, "the digest of every code point is the one of Unicode 17.0.0");
        return nil;
    end;
end module body.
