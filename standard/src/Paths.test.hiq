import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.Text (
    equal
);
import Standard.Platform (
    systemName,
    machineName
);
import Standard.Paths (
    AppKind,
    Service,
    UserTool,
    PathKind,
    ConfigFile,
    EnvFile,
    PepperFile,
    DataDirectory,
    CacheDirectory,
    LogDirectory,
    RuntimeDirectory,
    SocketFile,
    isAppName,
    serviceAccount,
    variableName,
    pathMode,
    defaultPathOn,
    choosePath
);

module body Standard.Paths.Test is
    -- Whether found is Some of exactly expected; the string is given back.
    function holds(found: Option[String], expected: Span[Nat8, Static]): Bool is
        case found of
            when Some(value as text: String) do
                let same: Bool := equal(asSpan(&text), expected);
                destroyString(text);
                return same;
            when None do
                return false;
        end case;
    end;

    function absent(found: Option[String]): Bool is
        case found of
            when Some(value as text: String) do
                destroyString(text);
                return false;
            when None do
                return true;
        end case;
    end;

    -- Whether found is Some and ends with tail.
    function endsWith(found: Option[String], tail: Span[Nat8, Static]): Bool is
        case found of
            when Some(value as text: String) do
                let size: Index := length(&text);
                var ok: Bool := (size > spanLength(tail)) and (nthByte(&text, 0) = '/');
                var i: Index := 0;
                while ok and (i < spanLength(tail)) do
                    if nthByte(&text, (size - spanLength(tail)) + i) /= tail[i] then
                        ok := false;
                    end if;
                    i := i + 1;
                end while;
                destroyString(text);
                return ok;
            when None do
                return false;
        end case;
    end;

    function testNames(): Unit is
        assertTrue(isAppName("notes"), "a plain name");
        assertTrue(isAppName("my-app2"), "hyphen and digit");
        assertTrue(not isAppName(""), "empty");
        assertTrue(not isAppName("2app"), "a digit first");
        assertTrue(not isAppName("App"), "a capital");
        assertTrue(not isAppName("my_app"), "an underscore");
        assertTrue(isAppName("abcdefghijklmnopqrstuvwxyzabcde"), "31 bytes");
        assertTrue(not isAppName("abcdefghijklmnopqrstuvwxyzabcdef"), "32 bytes");
        assertTrue(holds(serviceAccount("notes"), "_notes"), "the account");
        assertTrue(absent(serviceAccount("No")), "no account for a bad name");
        assertTrue(holds(variableName("my-app", PepperFile()), "MY_APP_PEPPER"), "the pepper variable");
        assertTrue(holds(variableName("notes", EnvFile()), "NOTES_ENV"), "the env variable");
        assertTrue(holds(variableName("notes", ConfigFile()), "NOTES_CONFIG"), "the config variable");
        assertTrue(holds(variableName("notes", SocketFile()), "NOTES_SOCKET"), "the socket variable");
        assertTrue(absent(variableName("notes", LogDirectory())), "no variable for the log");
        return nil;
    end;

    function testModes(): Unit is
        assertTrue(pathMode(EnvFile()) = 384, "env 0600");
        assertTrue(pathMode(PepperFile()) = 384, "pepper 0600");
        assertTrue(pathMode(ConfigFile()) = 416, "config 0640");
        assertTrue(pathMode(SocketFile()) = 432, "socket 0660");
        assertTrue(pathMode(RuntimeDirectory()) = 488, "directory 0750");
        return nil;
    end;

    function testServices(): Unit is
        assertTrue(holds(defaultPathOn("linux", "notes", Service(), ConfigFile()), "/etc/notes/notes.yaml"), "linux config");
        assertTrue(holds(defaultPathOn("linux", "notes", Service(), EnvFile()), "/etc/notes/secret/.notes.env"), "linux env");
        assertTrue(holds(defaultPathOn("linux", "notes", Service(), PepperFile()), "/var/lib/notes/.notes.pepper"), "linux pepper");
        assertTrue(holds(defaultPathOn("linux", "notes", Service(), SocketFile()), "/run/notes/notes.sock"), "linux socket");
        assertTrue(holds(defaultPathOn("linux", "notes", Service(), LogDirectory()), "/var/log/notes"), "linux log");
        assertTrue(holds(defaultPathOn("openbsd", "notes", Service(), PepperFile()), "/var/notes/.notes.pepper"), "openbsd pepper");
        assertTrue(holds(defaultPathOn("openbsd", "notes", Service(), SocketFile()), "/var/run/notes/notes.sock"), "openbsd socket");
        assertTrue(holds(defaultPathOn("openbsd", "notes", Service(), ConfigFile()), "/etc/notes/notes.yaml"), "openbsd config");
        assertTrue(holds(defaultPathOn("freebsd", "notes", Service(), ConfigFile()), "/usr/local/etc/notes/notes.yaml"), "freebsd config");
        assertTrue(holds(defaultPathOn("freebsd", "notes", Service(), EnvFile()), "/usr/local/etc/notes/secret/.notes.env"), "freebsd env");
        assertTrue(holds(defaultPathOn("freebsd", "notes", Service(), PepperFile()), "/var/db/notes/.notes.pepper"), "freebsd pepper");
        assertTrue(holds(defaultPathOn("freebsd", "notes", Service(), DataDirectory()), "/var/db/notes"), "freebsd data");
        assertTrue(holds(defaultPathOn("plan9", "notes", Service(), CacheDirectory()), "/var/cache/notes"), "an unknown system as linux");
        assertTrue(absent(defaultPathOn("linux", "No", Service(), ConfigFile())), "a bad name");
        return nil;
    end;

    -- The home directory is the test's own; only the part after it is known.
    function testUserTools(): Unit is
        assertTrue(endsWith(defaultPathOn("linux", "notes", UserTool(), ConfigFile()), "/notes/notes.yaml"), "a user config");
        assertTrue(endsWith(defaultPathOn("linux", "notes", UserTool(), EnvFile()), "/notes/.notes.env"), "a user env, no secret directory");
        assertTrue(endsWith(defaultPathOn("macos", "notes", UserTool(), LogDirectory()), "/Library/Logs/notes"), "a macos log");
        assertTrue(endsWith(defaultPathOn("macos", "notes", UserTool(), ConfigFile()), "/Library/Application Support/notes/notes.yaml"), "a macos config");
        return nil;
    end;

    function testChoice(): Unit is
        let flag: Option[Span[Nat8, Static]] := Some(value => "/srv/flag.yaml");
        let configured: Option[Span[Nat8, Static]] := Some(value => "/srv/configured.yaml");
        let none: Option[Span[Nat8, Static]] := None();
        let empty: Option[Span[Nat8, Static]] := Some(value => "");
        assertTrue(holds(choosePath("hilde-paths-test", Service(), ConfigFile(), flag, configured), "/srv/flag.yaml"), "the flag first");
        assertTrue(holds(choosePath("hilde-paths-test", Service(), ConfigFile(), none, configured), "/srv/configured.yaml"), "then the configuration");
        assertTrue(holds(choosePath("hilde-paths-test", Service(), ConfigFile(), empty, configured), "/srv/configured.yaml"), "an empty flag is not given");
        assertTrue(endsWith(choosePath("hilde-paths-test", Service(), ConfigFile(), none, none), "/hilde-paths-test/hilde-paths-test.yaml"), "then the default");
        return nil;
    end;

    function testPlatform(): Unit is
        let system: Span[Nat8, Static] := systemName();
        let known: Bool := equal(system, "linux") or equal(system, "openbsd") or equal(system, "freebsd") or equal(system, "macos") or equal(system, "wasi");
        assertTrue(known, "a known system");
        assertTrue(spanLength(machineName()) > 0, "a machine");
        return nil;
    end;
end module body.
