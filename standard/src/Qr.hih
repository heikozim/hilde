"""
QR codes of ISO/IEC 18004, model 2, made from text in Hilde.

- The text is one segment: numeric when all digits, else alphanumeric when it can, else bytes.
- The smallest of the 40 versions that holds the text at the level asked for is taken.
- Of the eight masks the one with the lowest penalty is taken, the first of equal ones.
- So the same text at the same level gives the same code on every run.
- A code is a square of dark and light modules, without the quiet zone.
- qrToImage draws a code as an image of Standard.Png and adds the quiet zone.
- A code is Linear and goes back through destroyQr.

    case encodeQr("https://example.org/ticket/4711", QrMedium()) of
        when Some(value as code: QrCode) do
            let image: Option[Image] := qrToImage(&code, 8, 4);
            destroyQr(code);
            showImage(image);
        when None do
            reportTooLong();
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);
import Standard.Png (
    Image
);

module Standard.Qr is
    """
    How much of a code may be lost and still be read: about 7, 15, 25 and
    30 percent.
    """
    union QrLevel: Free is
        case QrLow;
        case QrMedium;
        case QrQuartile;
        case QrHigh;
    end;

    """
    A QR code.  Linear: destroyQr gives it back.
    """
    type QrCode: Linear;

    """
    The code of text at level, or None when the text does not fit version
    40 at that level: 7089 digits, 4296 alphanumeric characters or 2953
    bytes at level low.  Alphanumeric are the 45 characters digits, capital
    letters, space and $%*+-./:.  The mask is chosen by the four penalty
    rules of the standard.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function encodeQr(text: Span[Nat8, R], level: QrLevel): Option[QrCode];

    """
    The version, 1 to 40.
    """
    generic [R: Region]
    function qrVersion(code: &[QrCode, R]): Index
        ensures (result >= 1) and (result <= 40);

    """
    The number of modules on a side: 17 plus 4 for each version.
    """
    generic [R: Region]
    function qrSize(code: &[QrCode, R]): Index
        ensures result = ((qrVersion(code) * 4) + 17);

    """
    The mask that was taken, 0 to 7.
    """
    generic [R: Region]
    function qrMask(code: &[QrCode, R]): Index
        ensures result <= 7;

    """
    Whether the module at column x and row y, from 0 at the top left, is
    dark; false outside the code.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function qrModule(code: &[QrCode, R], x: Index, y: Index): Bool;

    """
    The code as an image of grey: each module scale by scale pixels, black
    on white, with border light modules around it (the standard asks for
    4).  None when scale is 0 or the image would have a side above 16384
    pixels.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function qrToImage(code: &[QrCode, R], scale: Index, border: Index): Option[Image];

    """
    The codewords of the code of text at level as they are placed, data
    and error correction interleaved by block, or None as for encodeQr.
    It is the step before the drawing, for a test against the examples of
    the standard.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function qrCodewords(text: Span[Nat8, R], level: QrLevel): Option[String];

    """
    Frees code.
    No contract: it only frees or closes what it is given.
    """
    function destroyQr(code: QrCode): Unit;
end module.
