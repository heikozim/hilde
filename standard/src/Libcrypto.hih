"""
Authenticated encryption, key agreement, signatures, hashes and secure random bytes.

- Every function calls the system's libcrypto.
- Keys of the ciphers and curves are 32 bytes and nonces 12, 24 for XChaCha20; an HMAC key may have any length.
- A sealed message is the ciphertext followed by a 16-byte tag.
- A wrong input length or a failure of the library gives None or false, without saying which.
- A nonce must never be used twice with one key, and the caller counts them.
- Opening a message whose tag does not match gives None and nothing of the message.
- A code from an HMAC is checked with Standard.Text.constantTimeEqual, never a plain compare.

    case randomBytes(12) of
        when Some(value as nonce: String) do
            let sealed: Option[String] :=
                sealChaCha20Poly1305(asSpan(&key), asSpan(&nonce), asSpan(&message), "");
            destroyString(nonce);
        when None do
            printLn("no random bytes");
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.Libcrypto is
    """
    Encrypts plaintext and authenticates it together with aad, with
    AES-256-GCM.  Returns the ciphertext followed by the tag.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, N: Region, P: Region, A: Region]
    function sealAes256Gcm(key: Span[Nat8, K], nonce: Span[Nat8, N], plaintext: Span[Nat8, P], aad: Span[Nat8, A]): Option[String];

    """
    Checks the tag of sealed and aad, then decrypts, with AES-256-GCM.
    Returns the plaintext; when the tag does not match, None and nothing of
    the message.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, N: Region, S: Region, A: Region]
    function openAes256Gcm(key: Span[Nat8, K], nonce: Span[Nat8, N], sealed: Span[Nat8, S], aad: Span[Nat8, A]): Option[String];

    """
    Encrypts plaintext and authenticates it together with aad, with
    ChaCha20-Poly1305.  Returns the ciphertext followed by the tag.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, N: Region, P: Region, A: Region]
    function sealChaCha20Poly1305(key: Span[Nat8, K], nonce: Span[Nat8, N], plaintext: Span[Nat8, P], aad: Span[Nat8, A]): Option[String];

    """
    Checks the tag of sealed and aad, then decrypts, with
    ChaCha20-Poly1305.  Returns the plaintext; when the tag does not match,
    None and nothing of the message.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, N: Region, S: Region, A: Region]
    function openChaCha20Poly1305(key: Span[Nat8, K], nonce: Span[Nat8, N], sealed: Span[Nat8, S], aad: Span[Nat8, A]): Option[String];

    """
    The X25519 public key of a 32-byte private key.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region]
    function x25519PublicKey(privateKey: Span[Nat8, K]): Option[String];

    """
    The 32-byte secret two X25519 keys share.  None as well when the peer's
    key is one of the few that make the secret all zero, which the library
    refuses.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, P: Region]
    function x25519SharedSecret(privateKey: Span[Nat8, K], peerPublicKey: Span[Nat8, P]): Option[String];

    """
    The Ed25519 public key of a 32-byte seed.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [S: Region]
    function ed25519PublicKey(seed: Span[Nat8, S]): Option[String];

    """
    The 64-byte Ed25519 signature of message by the key of seed.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [S: Region, M: Region]
    function ed25519Sign(seed: Span[Nat8, S], message: Span[Nat8, M]): Option[String];

    """
    Whether signature is the signature of message by publicKey.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region, M: Region, G: Region]
    function ed25519Verify(publicKey: Span[Nat8, P], message: Span[Nat8, M], signature: Span[Nat8, G]): Bool;

    """
    count bytes from the library's secure random source, fit for keys,
    nonces and salts.  None when the library fails, or for a count above
    the largest C int the library takes.  Zero gives an empty string.
    No contract: an Option result, which an ensures cannot look into.
    """
    function randomBytes(count: Index): Option[String];

    """
    The SHA-256 digest of message, 32 bytes.  None only when the library
    fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [M: Region]
    function sha256(message: Span[Nat8, M]): Option[String];

    """
    The HMAC of message under key with SHA-256, 32 bytes.  A key of any
    length is taken, as RFC 2104 says; one longer than the largest C int is
    None, as is a failure of the library.  To check a code a caller was
    given, compare it with Standard.Text.constantTimeEqual, never with a
    comparison that stops at the first difference.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, M: Region]
    function hmacSha256(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The SHA-384 digest of message, 48 bytes.  None only when the library
    fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [M: Region]
    function sha384(message: Span[Nat8, M]): Option[String];

    """
    The SHA-512 digest of message, 64 bytes.  None only when the library
    fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [M: Region]
    function sha512(message: Span[Nat8, M]): Option[String];

    """
    The SHA3-256 digest of message, 32 bytes.  None only when the library
    fails, or has no SHA-3.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [M: Region]
    function sha3_256(message: Span[Nat8, M]): Option[String];

    """
    The SHA3-512 digest of message, 64 bytes.  None only when the library
    fails, or has no SHA-3.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [M: Region]
    function sha3_512(message: Span[Nat8, M]): Option[String];

    """
    The HMAC of message under key with SHA-384, 48 bytes, taken as
    hmacSha256 takes its key; compare a code with constantTimeEqual.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, M: Region]
    function hmacSha384(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The HMAC of message under key with SHA-512, 64 bytes, taken as
    hmacSha256 takes its key; compare a code with constantTimeEqual.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, M: Region]
    function hmacSha512(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The HMAC of message under key with SHA-1, 20 bytes, taken as
    hmacSha256 takes its key.  Only for the protocols that name it, HOTP
    and TOTP after RFC 4226 and RFC 6238, which authenticator apps speak:
    HMAC-SHA1 is still a sound pseudorandom function, SHA-1 alone is not
    a sound hash, and none is offered.  A new design takes hmacSha256.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Region, M: Region]
    function hmacSha1(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The HChaCha20 subkey of a 32-byte key and a 16-byte nonce, 32 bytes:
    the first and the last row of the ChaCha20 state after its 20 rounds.
    None when a length is wrong.
    No contract: the result is an Option.
    """
    generic [K: Region, N: Region]
    function hchacha20(key: Span[Nat8, K], nonce: Span[Nat8, N]): Option[String];

    """
    Encrypts plaintext and authenticates it together with aad, with
    XChaCha20-Poly1305: a 24-byte nonce, the subkey of HChaCha20 over its
    first 16 bytes, and ChaCha20-Poly1305 under that subkey with four zero
    bytes and the last 8 bytes of the nonce.  A random nonce of this size
    may be drawn for every message.  Returns the ciphertext and the tag.
    No contract: the result is an Option.
    """
    generic [K: Region, N: Region, P: Region, A: Region]
    function sealXChaCha20Poly1305(key: Span[Nat8, K], nonce: Span[Nat8, N], plaintext: Span[Nat8, P], aad: Span[Nat8, A]): Option[String];

    """
    Checks the tag of sealed and aad, then decrypts, with
    XChaCha20-Poly1305.  None, and nothing of the message, when the tag does
    not match or a length is wrong.
    No contract: the result is an Option.
    """
    generic [K: Region, N: Region, S: Region, A: Region]
    function openXChaCha20Poly1305(key: Span[Nat8, K], nonce: Span[Nat8, N], sealed: Span[Nat8, S], aad: Span[Nat8, A]): Option[String];

    """
    The HMAC of message under key with SHA3-512, 64 bytes; compare a code
    with constantTimeEqual.
    No contract: the result is an Option.
    """
    generic [K: Region, M: Region]
    function hmacSha3_512(key: Span[Nat8, K], message: Span[Nat8, M]): Option[String];

    """
    The version of libcrypto the programme runs with, OpenSSL or
    LibreSSL, for version --full.
    No contract: the library answers.
    """
    function libraryVersion(): Span[Nat8, Static];
end module.
