--
-- The tables at the end are records of fixed width in string literals,
-- sorted by code point, found by binary search; nothing is parsed ahead of
-- time.  scripts/unicode/make-property-tables.py writes them and says
-- their format.
import Standard.Buffer (
    Buffer,
    insertBack,
    lengthMut,
    nthMut,
    storeNth
);

module body Standard.UnicodeProperties is
    constant runWidth: Index := 14;
    constant orbitWidth: Index := 12;
    constant firstPoint: Index := 0;
    constant lastPoint: Index := #x10FFFF;
    constant noIndex: Index := 4294967295;
    constant sixteen: Index := 16;

    -- The value of count hexadecimal digits of table from at.  The tables
    -- hold capital hexadecimal digits there; anything else is a fault of
    -- the generator.
    function hexAt(table: Span[Nat8, Static], at: Index, count: Index): Index is
        var total: Index := 0;
        var i: Index := 0;
        while i < count do
            let byte: Nat8 := table[at + i];
            var digit: Index := 0;
            if (byte >= '0') and (byte <= '9') then
                digit := widen(byte - '0');
            else if (byte >= 'A') and (byte <= 'F') then
                digit := widen((byte - 'A') + 10);
            else
                abort("Standard.UnicodeProperties: a table holds a byte that is not a hexadecimal digit");
            end if;
            total := (total * sixteen) + digit;
            i := i + 1;
        end while;
        return total;
    end;

    function widen(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    -- The record of a table of runs that holds point, or noIndex.
    function findRun(table: Span[Nat8, Static], point: Index): Index is
        let count: Index := spanLength(table) / runWidth;
        if (count = 0) or (hexAt(table, 0, 6) > point) then
            return noIndex;
        end if;
        -- The last run that starts at or before point.
        var low: Index := 0;
        var high: Index := count - 1;
        while low < high do
            let middle: Index := ((low + high) + 1) / 2;
            if hexAt(table, middle * runWidth, 6) <= point then
                low := middle;
            else
                high := middle - 1;
            end if;
        end while;
        if point > hexAt(table, (low * runWidth) + 6, 6) then
            return noIndex;
        end if;
        return low;
    end;

    function generalCategory(point: Index): Span[Nat8, Static] is
        let table: Span[Nat8, Static] := categoryTable();
        let at: Index := findRun(table, point);
        if at = noIndex then
            return "Cn";
        end if;
        return spanPart(table, (at * runWidth) + 12, 2);
    end;

    -- The script name at position index of the list of names.
    function scriptName(index: Index): Span[Nat8, Static] is
        let names: Span[Nat8, Static] := scriptNames();
        let size: Index := spanLength(names);
        var seen: Index := 0;
        var start: Index := 0;
        var i: Index := 0;
        while i < size do
            if names[i] = ',' then
                if seen = index then
                    return spanPart(names, start, i - start);
                end if;
                seen := seen + 1;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return "Unknown";
    end;

    function scriptOf(point: Index): Span[Nat8, Static] is
        let table: Span[Nat8, Static] := scriptTable();
        let at: Index := findRun(table, point);
        if at = noIndex then
            return "Unknown";
        end if;
        return scriptName(hexAt(table, (at * runWidth) + 12, 2));
    end;

    -- A byte of a name as the loose matching of Unicode compares it: a
    -- capital ASCII letter as its small one.
    function lowered(byte: Nat8): Nat8 is
        if (byte >= 'A') and (byte <= 'Z') then
            return byte + 32;
        end if;
        return byte;
    end;

    -- Whether a byte is one the loose matching skips: a space, an
    -- underscore or a hyphen.
    function skipped(byte: Nat8): Bool is
        return (byte = ' ') or ((byte = '_') or (byte = '-'));
    end;

    -- The first position from at on whose byte the loose matching does not
    -- skip, or the length of text.
    generic [R: Region]
    function pastSkipped(text: Span[Nat8, R], at: Index): Index is
        var k: Index := at;
        var going: Bool := k < spanLength(text);
        while going do
            if skipped(text[k]) then
                k := k + 1;
                going := k < spanLength(text);
            else
                going := false;
            end if;
        end while;
        return k;
    end;

    -- Whether two names are the same by the loose matching of Unicode that
    -- Go's regexp applies: without regard to the case of ASCII letters,
    -- and with spaces, underscores and hyphens left out.
    generic [R: Region, S: Region]
    function looseEqual(left: Span[Nat8, R], right: Span[Nat8, S]): Bool is
        let leftSize: Index := spanLength(left);
        let rightSize: Index := spanLength(right);
        var i: Index := 0;
        var j: Index := 0;
        var going: Bool := true;
        while going do
            i := pastSkipped(left, i);
            j := pastSkipped(right, j);
            if (i >= leftSize) or (j >= rightSize) then
                going := false;
            else if lowered(left[i]) /= lowered(right[j]) then
                return false;
            else
                i := i + 1;
                j := j + 1;
            end if;
        end while;
        return (i >= leftSize) and (j >= rightSize);
    end;

    -- The names of the general categories and of the three sets Go's regexp
    -- takes besides, each with the code it stands for; measured against Go
    -- 1.27.1.  An entry is a name, an equals sign, a code and a semicolon.
    function categoryNames(): Span[Nat8, Static] is
        return "C=C;Other=C;Cc=Cc;Control=Cc;cntrl=Cc;Cf=Cf;Format=Cf;Cn=Cn;Unassigned=Cn;\
            \Co=Co;Private_Use=Co;Cs=Cs;Surrogate=Cs;L=L;Letter=L;LC=LC;Cased_Letter=LC;\
            \Ll=Ll;Lowercase_Letter=Ll;Lm=Lm;Modifier_Letter=Lm;Lo=Lo;Other_Letter=Lo;\
            \Lt=Lt;Titlecase_Letter=Lt;Lu=Lu;Uppercase_Letter=Lu;M=M;Mark=M;\
            \Combining_Mark=M;Mc=Mc;Spacing_Mark=Mc;Me=Me;Enclosing_Mark=Me;Mn=Mn;\
            \Nonspacing_Mark=Mn;N=N;Number=N;Nd=Nd;Decimal_Number=Nd;digit=Nd;Nl=Nl;\
            \Letter_Number=Nl;No=No;Other_Number=No;P=P;Punctuation=P;punct=P;Pc=Pc;\
            \Connector_Punctuation=Pc;Pd=Pd;Dash_Punctuation=Pd;Pe=Pe;\
            \Close_Punctuation=Pe;Pf=Pf;Final_Punctuation=Pf;Pi=Pi;\
            \Initial_Punctuation=Pi;Po=Po;Other_Punctuation=Po;Ps=Ps;\
            \Open_Punctuation=Ps;S=S;Symbol=S;Sc=Sc;Currency_Symbol=Sc;Sk=Sk;\
            \Modifier_Symbol=Sk;Sm=Sm;Math_Symbol=Sm;So=So;Other_Symbol=So;Z=Z;\
            \Separator=Z;Zl=Zl;Line_Separator=Zl;Zp=Zp;Paragraph_Separator=Zp;Zs=Zs;\
            \Space_Separator=Zs;Any=Any;Assigned=Assigned;ASCII=ASCII;";
    end;

    -- The code a category name stands for, or the empty span when name is
    -- none of them.
    generic [R: Region]
    function categoryCode(name: Span[Nat8, R]): Span[Nat8, Static] is
        let table: Span[Nat8, Static] := categoryNames();
        let size: Index := spanLength(table);
        var start: Index := 0;
        var equals: Index := 0;
        var i: Index := 0;
        while i < size do
            if table[i] = '=' then
                equals := i;
            else if table[i] = ';' then
                if looseEqual(name, spanPart(table, start, equals - start)) then
                    return spanPart(table, equals + 1, i - (equals + 1));
                end if;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return "";
    end;

    -- The position of name in the list of script names, by loose matching,
    -- or noIndex.
    generic [R: Region]
    function scriptIndex(name: Span[Nat8, R]): Index is
        let names: Span[Nat8, Static] := scriptNames();
        let size: Index := spanLength(names);
        var seen: Index := 0;
        var start: Index := 0;
        var i: Index := 0;
        while i < size do
            if names[i] = ',' then
                if looseEqual(name, spanPart(names, start, i - start)) then
                    return seen;
                end if;
                seen := seen + 1;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return noIndex;
    end;

    -- Appends the pair low, high, joined with the last pair from first on
    -- when it continues it.
    generic [G: Region]
    function appendRun(ranges: &![Buffer[Index], G], first: Index, low: Index, high: Index): Unit is
        let size: Index := lengthMut(&~ranges);
        var joined: Bool := false;
        if size > (first * 2) then
            if (nthMut(&~ranges, size - 1) + 1) = low then
                joined := true;
            end if;
        end if;
        if joined then
            storeNth(&~ranges, size - 1, high);
        else
            insertBack(&~ranges, low);
            insertBack(&~ranges, high);
        end if;
        return nil;
    end;

    -- Whether the record at of the category table belongs to code: every
    -- record for Assigned; the record's category, or the first letter of
    -- it for a code of one letter; Lu, Ll and Lt for LC.  Cn has no record.
    generic [R: Region]
    function recordBelongs(table: Span[Nat8, Static], at: Index, code: Span[Nat8, R]): Bool is
        let offset: Index := (at * runWidth) + 12;
        let first: Nat8 := table[offset];
        let second: Nat8 := table[offset + 1];
        let size: Index := spanLength(code);
        if size = 8 then
            return true;
        end if;
        if size = 1 then
            return first = code[0];
        end if;
        if (code[0] = 'L') and (code[1] = 'C') then
            return (first = 'L') and ((second = 'u') or ((second = 'l') or (second = 't')));
        end if;
        return (first = code[0]) and (second = code[1]);
    end;

    -- Appends the code points of a category code: the records that belong
    -- to it, and the gaps between the records, the unassigned code points,
    -- for C and for Cn.  The table is walked in order, so the pairs come
    -- sorted and joined.
    generic [R: Region, G: Region]
    function appendCategory(code: Span[Nat8, R], ranges: &![Buffer[Index], G]): Unit is
        let table: Span[Nat8, Static] := categoryTable();
        let count: Index := spanLength(table) / runWidth;
        let first: Index := lengthMut(&~ranges) / 2;
        var gaps: Bool := false;
        if code[0] = 'C' then
            if spanLength(code) = 1 then
                gaps := true;
            else
                gaps := code[1] = 'n';
            end if;
        end if;
        var next: Index := 0;
        var i: Index := 0;
        while i < count do
            let low: Index := hexAt(table, i * runWidth, 6);
            let high: Index := hexAt(table, (i * runWidth) + 6, 6);
            if gaps and (low > next) then
                appendRun(&~ranges, first, next, low - 1);
            end if;
            if recordBelongs(table, i, code) then
                appendRun(&~ranges, first, low, high);
            end if;
            next := high + 1;
            i := i + 1;
        end while;
        if gaps and (next <= lastPoint) then
            appendRun(&~ranges, first, next, lastPoint);
        end if;
        return nil;
    end;

    -- Appends the runs of the script numbered index.
    generic [G: Region]
    function appendScript(index: Index, ranges: &![Buffer[Index], G]): Unit is
        let table: Span[Nat8, Static] := scriptTable();
        let count: Index := spanLength(table) / runWidth;
        let first: Index := lengthMut(&~ranges) / 2;
        var i: Index := 0;
        while i < count do
            if hexAt(table, (i * runWidth) + 12, 2) = index then
                appendRun(&~ranges, first, hexAt(table, i * runWidth, 6), hexAt(table, (i * runWidth) + 6, 6));
            end if;
            i := i + 1;
        end while;
        return nil;
    end;

    generic [R: Region, G: Region]
    function appendProperty(name: Span[Nat8, R], ranges: &![Buffer[Index], G]): Bool is
        let code: Span[Nat8, Static] := categoryCode(name);
        let size: Index := spanLength(code);
        if size = 3 then
            -- Any: every code point.
            insertBack(&~ranges, firstPoint);
            insertBack(&~ranges, lastPoint);
            return true;
        end if;
        if size = 5 then
            -- ASCII.
            let lastAscii: Index := 127;
            insertBack(&~ranges, firstPoint);
            insertBack(&~ranges, lastAscii);
            return true;
        end if;
        if size > 0 then
            appendCategory(code, &~ranges);
            return true;
        end if;
        let index: Index := scriptIndex(name);
        if index = noIndex then
            return false;
        end if;
        appendScript(index, &~ranges);
        return true;
    end;

    -- The record of the orbit table for point, or noIndex.
    function findOrbit(point: Index): Index is
        let table: Span[Nat8, Static] := orbitTable();
        var low: Index := 0;
        var high: Index := spanLength(table) / orbitWidth;
        while low < high do
            let middle: Index := (low + high) / 2;
            let found: Index := hexAt(table, middle * orbitWidth, 6);
            if found = point then
                return middle;
            end if;
            if found < point then
                low := middle + 1;
            else
                high := middle;
            end if;
        end while;
        return noIndex;
    end;

    function nextInFoldOrbit(point: Index): Index is
        let at: Index := findOrbit(point);
        if at = noIndex then
            return point;
        end if;
        return hexAt(orbitTable(), (at * orbitWidth) + 6, 6);
    end;

    generic [G: Region]
    function appendFoldPartners(low: Index, high: Index, ranges: &![Buffer[Index], G]): Unit is
        let table: Span[Nat8, Static] := orbitTable();
        let count: Index := spanLength(table) / orbitWidth;
        -- The first record at or after low.
        var lowAt: Index := 0;
        var highAt: Index := count;
        while lowAt < highAt do
            let middle: Index := (lowAt + highAt) / 2;
            if hexAt(table, middle * orbitWidth, 6) < low then
                lowAt := middle + 1;
            else
                highAt := middle;
            end if;
        end while;
        var i: Index := lowAt;
        var going: Bool := i < count;
        while going do
            let point: Index := hexAt(table, i * orbitWidth, 6);
            if point > high then
                going := false;
            else
                -- The other members of the orbit; an orbit has at most a
                -- few, and the walk ends where it began.
                var other: Index := hexAt(table, (i * orbitWidth) + 6, 6);
                var steps: Index := 0;
                while (other /= point) and (steps < 8) do
                    insertBack(&~ranges, other);
                    insertBack(&~ranges, other);
                    other := nextInFoldOrbit(other);
                    steps := steps + 1;
                end while;
                i := i + 1;
                going := i < count;
            end if;
        end while;
        return nil;
    end;

    ---
    --- The tables, written by scripts/unicode/make-property-tables.py
    --- from the Unicode Character Database 17.0.0.  Not edited by hand.
    ---

    -- Runs of one general category: start, end, the category.
    function categoryTable(): Span[Nat8, Static] is
        return "00000000001FCc000020000020Zs000021000023Po000024000024Sc0000\
            \25000027Po000028000028Ps000029000029Pe00002A00002APo00002B00\
            \002BSm00002C00002CPo00002D00002DPd00002E00002FPo000030000039\
            \Nd00003A00003BPo00003C00003ESm00003F000040Po00004100005ALu00\
            \005B00005BPs00005C00005CPo00005D00005DPe00005E00005ESk00005F\
            \00005FPc000060000060Sk00006100007ALl00007B00007BPs00007C0000\
            \7CSm00007D00007DPe00007E00007ESm00007F00009FCc0000A00000A0Zs\
            \0000A10000A1Po0000A20000A5Sc0000A60000A6So0000A70000A7Po0000\
            \A80000A8Sk0000A90000A9So0000AA0000AALo0000AB0000ABPi0000AC00\
