import Standard.Testing (
    assertTrue,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.Text (
    hexToBytes,
    bytesToHex
);
import Standard.Png (
    PngColor,
    PngError,
    Image,
    Gray,
    Rgb,
    Rgba,
    makeImage,
    filledImage,
    imageWidth,
    imageHeight,
    imageColor,
    imagePixels,
    setPixel,
    encodePng,
    decodePng,
    destroyImage,
    bytesPerPixel
);

module body Standard.Png.Test is
    -- The bytes written in hexadecimal by text.
    function bytesOf(text: Span[Nat8, Static]): String is
        case hexToBytes(text) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                abort("not hexadecimal");
        end case;
    end;

    generic [R: Region]
    function hexIs(bytes: Span[Nat8, R], expected: Span[Nat8, Static]): Bool is
        let hex: String := bytesToHex(bytes);
        let size: Index := length(&hex);
        var same: Bool := size = spanLength(expected);
        var i: Index := 0;
        while same and (i < size) do
            same := nthByte(&hex, i) = expected[i];
            i := i + 1;
        end while;
        destroyString(hex);
        return same;
    end;

    function errorNumber(error: PngError): Int32 is
        case error of
            when NotPng do
                return 1;
            when BadChecksum do
                return 2;
            when BadData do
                return 3;
            when Unsupported do
                return 4;
            when TooLarge do
                return 5;
        end case;
    end;

    -- The file written in hexadecimal by text is refused with the error
    -- numbered expected.
    function refused(text: Span[Nat8, Static], maxPixels: Index, expected: Int32, message: Span[Nat8, Static]): Unit is
        let file: String := bytesOf(text);
        case decodePng(asSpan(&file), maxPixels) of
            when Right(right as image: Image) do
                destroyImage(image);
                assertFailure(message);
            when Left(left as error: PngError) do
                assertTrue(errorNumber(error) = expected, message);
        end case;
        destroyString(file);
        return nil;
    end;

    function testFilters(): Unit is
        let file: String := bytesOf("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455874436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec20000000049454e44ae426082");
        case decodePng(asSpan(&file), 15) of
            when Right(right as image: Image) do
                assertTrue(imageWidth(&image) = 3, "the width");
                assertTrue(imageHeight(&image) = 5, "the height");
                assertTrue(bytesPerPixel(imageColor(&image)) = 3, "RGB");
                assertTrue(hexIs(imagePixels(&image), "000d1a25323f4a5764475461717e8b9ba8b58e9ba8bdcad7ecf906d5e2ef0916\
        \233d4a571c293655626f8e9ba8"), "the five filters undone, a text chunk skipped, the data in two chunks");
                destroyImage(image);
            when Left(left as error: PngError) do
                assertFailure("a file of Python's zlib");
        end case;
        destroyString(file);
        return nil;
    end;

    function testRefusals(): Unit is
        refused("00", 100, 1, "one byte");
        refused("89504e470d0a1a0b", 100, 1, "a wrong signature");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455874436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec20000000049454e44ae426082", 14, 5, "one pixel more than allowed");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455875436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec20000000049454e44ae426082", 100, 2, "a byte of a chunk changed");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f5000000074944415478da6360e09552e0711e980000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020022e20d1d23109e540000000049454e44ae426082", 100, 2, "the checksum of zlib wrong");
        refused("89504e470d0a1a0a0000000d4948445200000003000000050803000000b7afa6\
        \90000000074944415478da6360e09552e0711e980000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020022e20d1c5417aec20000000049454e44ae426082", 100, 4, "a palette");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000141424344782abb56c4000000074944415478da6360e09552e0711e\
        \980000002c4944415435b2f70a4f61740f49d40203267777771f1f9fc0c040e6\
        \bea9b31d1c1c0e1f76668188595a5a020022e20d1c5417aec20000000049454e\
        \44ae426082", 100, 4, "an unknown critical chunk");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000017814f1\
        \63000000074944415478da6360e09552e0711e980000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020022e20d1c5417aec20000000049454e44ae426082", 100, 4, "interlaced");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455874436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec2", 100, 3, "no IEND");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f5000000074944415478da6365e09552d7afeeaa0000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020023dc0d219a364d2c0000000049454e44ae426082", 100, 3, "a filter numbered 5");
        return nil;
    end;

    function testRoundTrip(): Unit is
        case filledImage(4, 3, Rgba(), "abcd") of
            when Some(value as filled: Image) do
                var image: Image := filled;
                assertTrue(setPixel(&!image, 3, 2, "WXYZ"), "the last pixel set");
                assertTrue(not setPixel(&!image, 4, 0, "WXYZ"), "a pixel outside refused");
                assertTrue(not setPixel(&!image, 0, 0, "WXY"), "a pixel of the wrong size refused");
                let file: String := encodePng(&image);
                case decodePng(asSpan(&file), 12) of
                    when Right(right as back: Image) do
                        assertTrue(hexIs(imagePixels(&back), "61626364616263646162636461626364616263646162636461626364616263646162636461626364616263645758595a"), "the pixels come back");
                        destroyImage(back);
                    when Left(left as error: PngError) do
                        assertFailure("what encodePng wrote is read");
                end case;
                destroyString(file);
                destroyImage(image);
            when None do
                assertFailure("a filled image");
        end case;
        assertTrue(isNone(filledImage(0, 3, Gray(), "a")), "a width of 0");
        assertTrue(isNone(filledImage(16385, 1, Gray(), "a")), "a width above 16384");
        assertTrue(isNone(filledImage(2, 2, Rgb(), "ab")), "a pixel of the wrong size");
        return nil;
    end;

    function isNone(image: Option[Image]): Bool is
        case image of
            when Some(value as made: Image) do
                destroyImage(made);
                return false;
            when None do
                return true;
        end case;
    end;

    function testMakeImage(): Unit is
        let gray: String := bytesOf("000102030405");
        case makeImage(3, 2, Gray(), gray) of
            when Right(right as image: Image) do
                let file: String := encodePng(&image);
                case decodePng(asSpan(&file), 6) of
                    when Right(right as back: Image) do
                        assertTrue(hexIs(imagePixels(&back), "000102030405"), "grey comes back");
                        destroyImage(back);
                    when Left(left as error: PngError) do
                        assertFailure("grey read");
                end case;
                destroyString(file);
                destroyImage(image);
            when Left(left as given: String) do
                destroyString(given);
                assertFailure("a grey image");
        end case;
        let short: String := bytesOf("0001");
        case makeImage(3, 2, Gray(), short) of
            when Right(right as image: Image) do
                destroyImage(image);
                assertFailure("too few pixels refused");
            when Left(left as given: String) do
                assertTrue(length(&given) = 2, "too few pixels refused, the bytes given back");
                destroyString(given);
        end case;
        return nil;
    end;
end module body.
