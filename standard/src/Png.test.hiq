import Standard.Testing (
    assertTrue,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.Text (
    hexToBytes,
    bytesToHex
);
import Standard.Png (
    PngColor,
    PngError,
    Image,
    Gray,
    Rgb,
    Rgba,
    makeImage,
    filledImage,
    imageWidth,
    imageHeight,
    imageColor,
    imagePixels,
    setPixel,
    encodePng,
    decodePng,
    destroyImage,
    bytesPerPixel
);

module body Standard.Png.Test is
    -- The bytes written in hexadecimal by text.
    function bytesOf(text: Span[Nat8, Static]): String is
        case hexToBytes(text) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                abort("not hexadecimal");
        end case;
    end;

    generic [R: Region]
    function hexIs(bytes: Span[Nat8, R], expected: Span[Nat8, Static]): Bool is
        let hex: String := bytesToHex(bytes);
        let size: Index := length(&hex);
        var same: Bool := size = spanLength(expected);
        var i: Index := 0;
        while same and (i < size) do
            same := nthByte(&hex, i) = expected[i];
            i := i + 1;
        end while;
        destroyString(hex);
        return same;
    end;

    function errorNumber(error: PngError): Int32 is
        case error of
            when NotPng do
                return 1;
            when BadChecksum do
                return 2;
            when BadData do
                return 3;
            when Unsupported do
                return 4;
            when TooLarge do
                return 5;
        end case;
    end;

    -- The file written in hexadecimal by text is refused with the error
    -- numbered expected.
    function refused(text: Span[Nat8, Static], max_pixels: Index, expected: Int32, message: Span[Nat8, Static]): Unit is
        let file: String := bytesOf(text);
        case decodePng(asSpan(&file), max_pixels) of
            when Right(right as image: Image) do
                destroyImage(image);
                assertFailure(message);
            when Left(left as error: PngError) do
                assertTrue(errorNumber(error) = expected, message);
        end case;
        destroyString(file);
        return nil;
    end;

    function testFilters(): Unit is
        let file: String := bytesOf("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455874436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec20000000049454e44ae426082");
        case decodePng(asSpan(&file), 15) of
            when Right(right as image: Image) do
                assertTrue(imageWidth(&image) = 3, "the width");
                assertTrue(imageHeight(&image) = 5, "the height");
                assertTrue(bytesPerPixel(imageColor(&image)) = 3, "RGB");
                assertTrue(hexIs(imagePixels(&image), "000d1a25323f4a5764475461717e8b9ba8b58e9ba8bdcad7ecf906d5e2ef0916\
        \233d4a571c293655626f8e9ba8"), "the five filters undone, a text chunk skipped, the data in two chunks");
                destroyImage(image);
            when Left(left as error: PngError) do
                assertFailure("a file of Python's zlib");
        end case;
        destroyString(file);
        return nil;
    end;

    -- The file in hexadecimal decodes to an RGBA image of width times
    -- height whose pixels are rgba in hexadecimal.
    function decodesTo(file_hex: Span[Nat8, Static], width: Index, height: Index, rgba: Span[Nat8, Static]): Bool is
        let file: String := bytesOf(file_hex);
        var same: Bool := false;
        case decodePng(asSpan(&file), 64) of
            when Right(right as image: Image) do
                let sides: Bool := (imageWidth(&image) = width) and (imageHeight(&image) = height);
                same := (sides and (bytesPerPixel(imageColor(&image)) = 4)) and hexIs(imagePixels(&image), rgba);
                destroyImage(image);
            when Left(left as error: PngError) do
                same := false;
        end case;
        destroyString(file);
        return same;
    end;

    function testPalette(): Unit is
        assertTrue(decodesTo("89504e470d0a1a0a0000000d494844520000000a0000000201030000005bafdf\
        \9300000006504c5445ff00000000ff6ca1fd8e0000000e49444154789c63c838\
        \c034c10100067401fbbadab9550000000049454e44ae426082", 10, 2, "ff0000ff0000ffff0000ffffff0000ff0000ffffff0000ffff0000ffff0000ff\
        \0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffffff0000ff\
        \ff0000ffff0000ffff0000ffff0000ff"), "bit depth 1, ten pixels a row padded to two bytes, the second row through Up");
        assertTrue(decodesTo("89504e470d0a1a0a0000000d4948445200000005000000020203000000ed04fe\
        \ce0000000c504c5445ff00000000ff008000ffffff209e9a430000000274524e\
        \5300809b2b4e180000000e49444154789c63947ecaf0c40100062f0226d18651\
        \5e0000000049454e44ae426082", 5, 2, "ff0000000000ff80008000ffffffffffff000000ffffffff008000ff0000ff80\
        \ff0000000000ff80"), "bit depth 2, a tRNS shorter than the palette: the other colours opaque");
        assertTrue(decodesTo("89504e470d0a1a0a0000000d49484452000000030000000204030000006f5a7b\
        \2900000030504c544500ff0010ef2520df4a30cf6f40bf9450afb9609fde708f\
        \03807f28906f4da05f72b04f97c03fbcd02fe1e01f06f00f2b06c2f338000000\
        \1074524e53ffeeddccbbaa99887766554433221100a59d8c5a0000000e494441\
        \54789c63f850c0327301000854029eef6216040000000049454e44ae426082", 3, 2, "f00f2b0000ff00ff708f0388807f2877906f4d6610ef25ee"), "bit depth 4, sixteen colours, a full tRNS, the Paeth filter");
        assertTrue(decodesTo("89504e470d0a1a0a0000000d49484452000000020000000208030000004568fd\
        \1600000009504c5445ff00000080000000ff56c8ba940000000e49444154789c\
        \6360606461fa0700011801069c029c4f0000000049454e44ae426082", 2, 2, "ff0000ff008000ff0000ffffff0000ff"), "bit depth 8, three colours, no tRNS: all opaque");
        return nil;
    end;

    function testPaletteRefusals(): Unit is
        refused("89504e470d0a1a0a0000000d4948445200000002000000010803000000c3fc8f\
        \b800000009504c5445ff00000080000000ff56c8ba940000000b49444154789c\
        \6360600500000800067a51d1920000000049454e44ae426082", 64, 3, "an index past the palette");
        refused("89504e470d0a1a0a0000000d4948445200000002000000010803000000c3fc8f\
        \b80000000b49444154789c636060000000030001b8ad3a630000000049454e44\
        \ae426082", 64, 3, "a palette image without PLTE");
        refused("89504e470d0a1a0a0000000d4948445200000002000000010803000000c3fc8f\
        \b800000006504c5445ff00000080007a208a480000000374524e53010203508b\
        \9dd10000000b49444154789c636060040000040002bf7a3f4a0000000049454e\
        \44ae426082", 64, 3, "a tRNS with more entries than the palette has colours");
        refused("89504e470d0a1a0a0000000d4948445200000002000000010803000000c3fc8f\
        \b80000000174524e5309393a60c200000006504c5445ff00000080007a208a48\
        \0000000b49444154789c636060040000040002bf7a3f4a0000000049454e44ae\
        \426082", 64, 3, "a tRNS before the PLTE");
        refused("89504e470d0a1a0a0000000d4948445200000002000000010803000000c3fc8f\
        \b80000000b49444154789c636060040000040002bf7a3f4a00000006504c5445\
        \ff00000080007a208a480000000049454e44ae426082", 64, 3, "a PLTE after the image data");
        refused("89504e470d0a1a0a0000000d4948445200000001000000011003000000785be8\
        \f800000003504c5445ff000019e209370000000b49444154789c636060000000\
        \030001b8ad3a630000000049454e44ae426082", 64, 3, "bit depth 16 with a palette");
        refused("89504e470d0a1a0a0000000d494844520000000100000001080300000028cb34\
        \bb00000004504c54450102030423db8aab0000000a49444154789c6360000000\
        \02000148afa4710000000049454e44ae426082", 64, 3, "a PLTE of four bytes");
        refused("89504e470d0a1a0a0000000d4948445200000002000000010800000000d14920\
        \5600000003504c5445ff000019e209370000000b49444154789c6360e7000000\
        \1900108e1de84b0000000049454e44ae426082", 64, 3, "a PLTE in a grey image");
        -- An RGB image may suggest a palette; the decoder skips it.
        let suggested: String := bytesOf("89504e470d0a1a0a0000000d49484452000000020000000108020000007b40e8\
        \dd00000006504c5445ff00000000ff6ca1fd8e0000000f49444154789c636064\
        \626661650300003f001621bad4540000000049454e44ae426082");
        case decodePng(asSpan(&suggested), 64) of
            when Right(right as image: Image) do
                assertTrue((bytesPerPixel(imageColor(&image)) = 3) and hexIs(imagePixels(&image), "010203040506"), "RGB with a suggested palette as RGB");
                destroyImage(image);
            when Left(left as error: PngError) do
                assertFailure("RGB with a suggested palette");
        end case;
        destroyString(suggested);
        return nil;
    end;

    function testRefusals(): Unit is
        refused("00", 100, 1, "one byte");
        refused("89504e470d0a1a0b", 100, 1, "a wrong signature");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455874436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec20000000049454e44ae426082", 14, 5, "one pixel more than allowed");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455875436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec20000000049454e44ae426082", 100, 2, "a byte of a chunk changed");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f5000000074944415478da6360e09552e0711e980000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020022e20d1d23109e540000000049454e44ae426082", 100, 2, "the checksum of zlib wrong");
        refused("89504e470d0a1a0a0000000d4948445200000003000000050803000000b7afa6\
        \90000000074944415478da6360e09552e0711e980000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020022e20d1c5417aec20000000049454e44ae426082", 100, 3, "colour type 3 written into the header of an RGB file, without PLTE");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000141424344782abb56c4000000074944415478da6360e09552e0711e\
        \980000002c4944415435b2f70a4f61740f49d40203267777771f1f9fc0c040e6\
        \bea9b31d1c1c0e1f76668188595a5a020022e20d1c5417aec20000000049454e\
        \44ae426082", 100, 4, "an unknown critical chunk");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000017814f1\
        \63000000074944415478da6360e09552e0711e980000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020022e20d1c5417aec20000000049454e44ae426082", 100, 4, "interlaced");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f50000000d74455874436f6d6d656e740068656c6c6fe6ffae24000000074944\
        \415478da6360e09552e0711e980000002c4944415435b2f70a4f61740f49d402\
        \03267777771f1f9fc0c040e6bea9b31d1c1c0e1f76668188595a5a020022e20d\
        \1c5417aec2", 100, 3, "no IEND");
        refused("89504e470d0a1a0a0000000d49484452000000030000000508020000000f13c1\
        \f5000000074944415478da6365e09552d7afeeaa0000002c4944415435b2f70a\
        \4f61740f49d40203267777771f1f9fc0c040e6bea9b31d1c1c0e1f7666818859\
        \5a5a020023dc0d219a364d2c0000000049454e44ae426082", 100, 3, "a filter numbered 5");
        return nil;
    end;

    function testRoundTrip(): Unit is
        case filledImage(4, 3, Rgba(), "abcd") of
            when Some(value as filled: Image) do
                var image: Image := filled;
                assertTrue(setPixel(&!image, 3, 2, "WXYZ"), "the last pixel set");
                assertTrue(not setPixel(&!image, 4, 0, "WXYZ"), "a pixel outside refused");
                assertTrue(not setPixel(&!image, 0, 0, "WXY"), "a pixel of the wrong size refused");
                let file: String := encodePng(&image);
                case decodePng(asSpan(&file), 12) of
                    when Right(right as back: Image) do
                        assertTrue(hexIs(imagePixels(&back), "61626364616263646162636461626364616263646162636461626364616263646162636461626364616263645758595a"), "the pixels come back");
                        destroyImage(back);
                    when Left(left as error: PngError) do
                        assertFailure("what encodePng wrote is read");
                end case;
                destroyString(file);
                destroyImage(image);
            when None do
                assertFailure("a filled image");
        end case;
        assertTrue(isNone(filledImage(0, 3, Gray(), "a")), "a width of 0");
        assertTrue(isNone(filledImage(16385, 1, Gray(), "a")), "a width above 16384");
        assertTrue(isNone(filledImage(2, 2, Rgb(), "ab")), "a pixel of the wrong size");
        return nil;
    end;

    function isNone(image: Option[Image]): Bool is
        case image of
            when Some(value as made: Image) do
                destroyImage(made);
                return false;
            when None do
                return true;
        end case;
    end;

    function testMakeImage(): Unit is
        let gray: String := bytesOf("000102030405");
        case makeImage(3, 2, Gray(), gray) of
            when Right(right as image: Image) do
                let file: String := encodePng(&image);
                case decodePng(asSpan(&file), 6) of
                    when Right(right as back: Image) do
                        assertTrue(hexIs(imagePixels(&back), "000102030405"), "grey comes back");
                        destroyImage(back);
                    when Left(left as error: PngError) do
                        assertFailure("grey read");
                end case;
                destroyString(file);
                destroyImage(image);
            when Left(left as given: String) do
                destroyString(given);
                assertFailure("a grey image");
        end case;
        let short: String := bytesOf("0001");
        case makeImage(3, 2, Gray(), short) of
            when Right(right as image: Image) do
                destroyImage(image);
                assertFailure("too few pixels refused");
            when Left(left as given: String) do
                assertTrue(length(&given) = 2, "too few pixels refused, the bytes given back");
                destroyString(given);
        end case;
        return nil;
    end;
end module body.
