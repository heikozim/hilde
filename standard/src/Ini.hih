"""
Configuration files in the INI form: lines of name = value grouped under [section] headers.

- Names before the first header belong to the section with the empty name.
- A line whose first byte past white space is # or ; is a comment.
- A value that ends with a backslash goes on in the next line.
- Names and values lose the white space around them; a # inside a value is part of it.
- The same name twice in one section: the later one counts.
- Nothing is refused: a line of no known form is skipped and counted by skippedLines.
- A local value wins over a default even when it is empty, which switches the default off.
- A switch is on for yes and true, in any case, and off for everything else.

    let file: IniFile := readIni(asSpan(&text));
    let defaults: IniFile := readIni(asSpan(&shipped));
    let port: Option[String] := iniValueWith(&file, &defaults, "server", "port");
    let verbose: Bool := iniSwitch(&file, "log", "verbose");
    destroyIni(defaults);
    destroyIni(file);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Ini is
    """
    A file that has been read.  Linear: destroyIni gives it back.
    """
    type IniFile: Linear;

    """
    Read a whole text.  It cannot fail; see skippedLines.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function readIni(text: Span[Nat8, R]): IniFile;

    """
    Give a file back.
    No contract: it only frees or closes what it is given.
    """
    function destroyIni(file: IniFile): Unit;

    """
    How many lines were skipped because they were none of the forms
    above.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function skippedLines(file: &[IniFile, R]): Index;

    """
    The value of name in section, or None when the file does not have it.
    An empty value is Some of an empty span.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region, N: Region]
    function iniValue(file: &[IniFile, R], section: Span[Nat8, S], name: Span[Nat8, N]): Option[Span[Nat8, R]];

    """
    A copy of the value of name in section, from file, or from defaults
    when file does not have it at all.  A copy, since the two files are
    borrowed apart and a span could belong to only one of them.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, D: Region, S: Region, N: Region]
    function iniValueWith(file: &[IniFile, R], defaults: &[IniFile, D], section: Span[Nat8, S], name: Span[Nat8, N]): Option[String];

    """
    Whether the value is a switch that is on: yes or true, in any case,
    with white space around it or not.  1, on and everything else are off.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isOn(value: Span[Nat8, R]): Bool;

    """
    Whether name in section is a switch that is on; false when it is not
    there.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region, N: Region]
    function iniSwitch(file: &[IniFile, R], section: Span[Nat8, S], name: Span[Nat8, N]): Bool;

    """
    How many entries the file holds, counting each name once per section.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function entryCount(file: &[IniFile, R]): Index;

    """
    The section of entry n, in the order the names first appeared; None
    past the last.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function entrySection(file: &[IniFile, R], n: Index): Option[Span[Nat8, R]];

    """
    The name of entry n; None past the last.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function entryName(file: &[IniFile, R], n: Index): Option[Span[Nat8, R]];

    """
    The value of entry n; None past the last.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function entryValue(file: &[IniFile, R], n: Index): Option[Span[Nat8, R]];
end module.
