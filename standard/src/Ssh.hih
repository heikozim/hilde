"""
Commands run on another host by the ssh client of OpenSSH, and any child run within a time and size.

- There is no SSH here: the connection, its keys and the check of the host key are left to OpenSSH.
- sshCommand runs ssh in batch mode, with a limit to connect and no terminal: no password is asked.
- The host's key must already be known, so that a new key is a failure and not a question.
- Host and user are checked before they reach ssh, so that neither can be an option of it.
- Each remote word is single-quoted for the remote shell: no word reads as more than one or as code.
- A child that runs longer or writes more than allowed is sent SIGTERM and waited for, and fails.
- Nothing is written to the child: a SIGPIPE would end the programme, not the call.

    case sshCommand("/usr/bin/ssh", "backup.example.org", "deploy", 22, 10) of
        when Right(right as base: Command) do
            let command: Command := addRemoteWord(addRemoteWord(base, "df"), "-h");
            case runCommand(command, 30000, 65536) of
                when Right(right as result: CommandResult) do
                    showResult(result);
                when Left(left as error: SshError) do
                    reportFailure(error);
            end case;
        when Left(left as error: SshError) do
            reportFailure(error);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);
import Standard.File (
    Command
);

module Standard.Ssh is
    """
    Why a call did not do its work.
    """
    union SshError: Free is
        """
        A host, a user or a port that sshCommand does not take.
        """
        case BadTarget;
        """
        The command could not be started.
        """
        case NotStarted;
        """
        The time ran out; the child was ended.
        """
        case CommandTimedOut;
        """
        The child wrote more than allowed; it was ended.
        """
        case OutputTooLarge;
        """
        Reading the output failed.
        """
        case PipeFailed;
    end;

    """
    How a command ended and what it wrote.  Linear: destroyResult gives it
    back.
    """
    record CommandResult: Linear is
        """
        The exit code, 0 to 255, or -1 when a signal ended the child.
        """
        code: Int32;
        output: String;
        errors: String;
    end;

    """
    Frees result.
    No contract: it only frees or closes what it is given.
    """
    function destroyResult(result: CommandResult): Unit;

    """
    The command line of ssh, the binary at program, that runs a command
    on host as user, on port, connecting within connectSeconds; the words
    of the remote command are added with addRemoteWord.  host is a name
    of letters, digits, dots and hyphens or an IPv4 address, user letters,
    digits, underscores, dots and hyphens and empty for the default; neither
    may begin with a hyphen.  Left BadTarget otherwise, or for a port of 0
    or above 65535, or connectSeconds of 0 or above 3600.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [P: Region, H: Region, U: Region]
    function sshCommand(program: Span[Nat8, P], host: Span[Nat8, H], user: Span[Nat8, U], port: Index, connectSeconds: Index): Either[SshError, Command];

    """
    word added to the remote command, in single quotes for the remote
    shell.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function addRemoteWord(command: Command, word: Span[Nat8, R]): Command;

    """
    word in single quotes for a POSIX shell: a single quote inside it
    written as quote, backslash, quote, quote.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function shellQuote(word: Span[Nat8, R]): String;

    """
    Runs command with its input closed and reads its output and errors
    together until both end, within milliseconds and at most outputBytes
    of each.  A child that goes on longer or writes more is sent SIGTERM
    and waited for, and Left says why.  Nothing is written to the child,
    because a write into a pipe whose reader ended raises SIGPIPE.
    No contract: an Either result, which an ensures cannot look into.
    """
    function runCommand(command: Command, milliseconds: Nat32, outputBytes: Index): Either[SshError, CommandResult];
end module.
