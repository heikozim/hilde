"""
PNG images of 8 bits per channel, written and read.

- An image is width, height, kind of colour and pixels, row after row from the top.
- A pixel is one byte of grey, three of red, green and blue, or four with alpha after them.
- encodePng writes one IDAT chunk and no filter, so the same image gives the same bytes.
- decodePng reads bit depth 8, grey, RGB or RGBA, not interlaced, any of the five filters.
- Every chunk's CRC is checked; ancillary chunks are skipped.
- A critical chunk it does not know, such as a palette, is Unsupported rather than ignored.
- The caller limits the pixels before decompressing, so a small file cannot make a huge image.
- An image is Linear and goes back through destroyImage.

    case decodePng(asSpan(&data), 4194304) of
        when Right(right as image: Image) do
            let file: String := encodePng(&image);
            destroyImage(image);
        when Left(left as error: PngError) do
            reportBadImage(error);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Png is
    """
    The colour of a pixel.
    """
    union PngColor: Free is
        """
        One byte of grey.
        """
        case Gray;
        """
        Three bytes: red, green, blue.
        """
        case Rgb;
        """
        Four bytes: red, green, blue, alpha.
        """
        case Rgba;
    end;

    """
    Why decodePng refused.
    """
    union PngError: Free is
        """
        The bytes do not begin with the signature of PNG.
        """
        case NotPng;
        """
        A chunk's CRC or the checksum of the compressed data is wrong.
        """
        case BadChecksum;
        """
        The chunks or the data break a rule of PNG.
        """
        case BadData;
        """
        A valid PNG this module does not read: another bit depth, a
        palette, interlacing, or an unknown critical chunk.
        """
        case Unsupported;
        """
        The image has more pixels than the caller allowed.
        """
        case TooLarge;
    end;

    """
    An image.  Linear: destroyImage gives it back.
    """
    type Image: Linear;

    """
    The bytes of one pixel of color: 1, 3 or 4.
    """
    function bytesPerPixel(color: PngColor): Index
        ensures (result >= 1) and (result <= 4);

    """
    An image of width times height pixels of color, whose pixels are the
    bytes of pixels.  Left gives pixels back when width or height is 0 or
    above 16384, or pixels does not have exactly the bytes they need.
    No contract: an Either result, which an ensures cannot look into.
    """
    function makeImage(width: Index, height: Index, color: PngColor, pixels: String): Either[String, Image];

    """
    An image of one colour: every pixel is the bytes of pixel, which must
    have the size of a pixel of color.  None when the sizes are wrong as
    for makeImage.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [P: Region]
    function filledImage(width: Index, height: Index, color: PngColor, pixel: Span[Nat8, P]): Option[Image];

    """
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function imageWidth(image: &[Image, R]): Index;
    """
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function imageHeight(image: &[Image, R]): Index;
    """
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function imageColor(image: &[Image, R]): PngColor;

    """
    All the pixels, row after row.
    """
    generic [R: Region]
    function imagePixels(image: &[Image, R]): Span[Nat8, R]
        ensures spanLength(result) = ((imageWidth(image) * imageHeight(image)) * bytesPerPixel(imageColor(image)));

    """
    Sets the pixel at column x and row y, from 0 at the top left, to the
    bytes of pixel.  false, and nothing changed, when x or y is outside or
    pixel has the wrong size.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, P: Region]
    function setPixel(image: &![Image, R], x: Index, y: Index, pixel: Span[Nat8, P]): Bool;

    """
    The image as the bytes of a PNG file.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function encodePng(image: &[Image, R]): String;

    """
    The image in data, which may have at most maxPixels pixels.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function decodePng(data: Span[Nat8, R], maxPixels: Index): Either[PngError, Image];

    """
    Frees image.
    No contract: it only frees or closes what it is given.
    """
    function destroyImage(image: Image): Unit;
end module.
