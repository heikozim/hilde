import Standard.Array (
    Array,
    Shape,
    View,
    broadcast,
    broadcastShapes,
    count,
    destroy,
    elementType,
    extent,
    float32Type,
    float64Type,
    getInt32,
    getInt64,
    getFloat32,
    getFloat64,
    int32Type,
    int64Type,
    rank,
    sameShape,
    setInt32,
    setInt64,
    setFloat32,
    setFloat64,
    shape,
    shape1,
    shape2,
    shape3,
    size,
    view,
    viewElementType,
    viewExtent,
    viewShape,
    viewSize,
    zeros
);
import Standard.Bits (
    int32Bits,
    int32FromBits,
    int64Bits,
    int64FromBits
);

module body Standard.ArrayCompute is
    ---
    --- Limits and element types
    ---

    function isNumberType(code: Nat8): Bool is
        return (((code = 1) or (code = 2)) or (code = 5)) or (code = 6);
    end;

    function sumReduction(): Nat8 is
        return 1;
    end;

    function minReduction(): Nat8 is
        return 2;
    end;

    function maxReduction(): Nat8 is
        return 3;
    end;

    function productReduction(): Nat8 is
        return 4;
    end;

    ---
    --- Bit helpers for wrapping whole-number joins
    ---

    -- The bit pattern of a 32-bit whole number, widened for the modular
    -- arithmetic of the pervasive operations.
    function wide32(value: Nat32): Nat64 is
        case toNat64(value) of
            when Some(value as at: Nat64) do
                return at;
            when None do
                abort("a Nat32 did not fit a Nat64");
        end case;
    end;

    -- The low 32 bits of a 64-bit bit pattern.
    function low32(value: Nat64): Nat32 is
        case toNat32(bitwiseAnd(value, 4294967295)) of
            when Some(value as at: Nat32) do
                return at;
            when None do
                abort("a number did not fit a Nat32");
        end case;
    end;

    ---
    --- The joins of the element types
    ---

    function addInt32(x: Int32, y: Int32): Int32 is
        return x + y;
    end;

    function subtractInt32(x: Int32, y: Int32): Int32 is
        return x - y;
    end;

    function multiplyInt32(x: Int32, y: Int32): Int32 is
        return x * y;
    end;

    function divideInt32(x: Int32, y: Int32): Int32 is
        return x / y;
    end;

    function negateInt32(x: Int32, unused: Int32): Int32 is
        return -x;
    end;

    function absoluteInt32(x: Int32, unused: Int32): Int32 is
        if x < 0 then
            return -x;
        end if;
        return x;
    end;

    function minimumInt32(x: Int32, y: Int32): Int32 is
        if y < x then
            return y;
        end if;
        return x;
    end;

    function maximumInt32(x: Int32, y: Int32): Int32 is
        if y > x then
            return y;
        end if;
        return x;
    end;

    function addInt64(x: Int64, y: Int64): Int64 is
        return x + y;
    end;

    function subtractInt64(x: Int64, y: Int64): Int64 is
        return x - y;
    end;

    function multiplyInt64(x: Int64, y: Int64): Int64 is
        return x * y;
    end;

    function divideInt64(x: Int64, y: Int64): Int64 is
        return x / y;
    end;

    function negateInt64(x: Int64, unused: Int64): Int64 is
        return -x;
    end;

    function absoluteInt64(x: Int64, unused: Int64): Int64 is
        if x < 0 then
            return -x;
        end if;
        return x;
    end;

    function minimumInt64(x: Int64, y: Int64): Int64 is
        if y < x then
            return y;
        end if;
        return x;
    end;

    function maximumInt64(x: Int64, y: Int64): Int64 is
        if y > x then
            return y;
        end if;
        return x;
    end;

    function addFloat32(x: Float32, y: Float32): Float32 is
        return x + y;
    end;

    function subtractFloat32(x: Float32, y: Float32): Float32 is
        return x - y;
    end;

    function multiplyFloat32(x: Float32, y: Float32): Float32 is
        return x * y;
    end;

    function divideFloat32(x: Float32, y: Float32): Float32 is
        return x / y;
    end;

    function negateFloat32(x: Float32, unused: Float32): Float32 is
        return -x;
    end;

    function absoluteFloat32(x: Float32, unused: Float32): Float32 is
        if x < 0.0 then
            return -x;
        end if;
        return x;
    end;

    function minimumFloat32(x: Float32, y: Float32): Float32 is
        if y < x then
            return y;
        end if;
        return x;
    end;

    function maximumFloat32(x: Float32, y: Float32): Float32 is
        if y > x then
            return y;
        end if;
        return x;
    end;

    function addFloat64(x: Float64, y: Float64): Float64 is
        return x + y;
    end;

    function subtractFloat64(x: Float64, y: Float64): Float64 is
        return x - y;
    end;

    function multiplyFloat64(x: Float64, y: Float64): Float64 is
        return x * y;
    end;

    function divideFloat64(x: Float64, y: Float64): Float64 is
        return x / y;
    end;

    function negateFloat64(x: Float64, unused: Float64): Float64 is
        return -x;
    end;

    function absoluteFloat64(x: Float64, unused: Float64): Float64 is
        if x < 0.0 then
            return -x;
        end if;
        return x;
    end;

    function minimumFloat64(x: Float64, y: Float64): Float64 is
        if y < x then
            return y;
        end if;
        return x;
    end;

    function maximumFloat64(x: Float64, y: Float64): Float64 is
        if y > x then
            return y;
        end if;
        return x;
    end;

    ---
    --- The wrapping joins of the protocol
    ---

    -- The sum of two Int32, wrapped at 32 bits.
    function wrappedSumInt32(x: Int32, y: Int32): Int32 is
        let joined: Nat64 := modularAdd(wide32(int32Bits(x)), wide32(int32Bits(y)));
        return int32FromBits(low32(joined));
    end;

    -- The product of two Int32, wrapped at 32 bits.
    function wrappedProductInt32(x: Int32, y: Int32): Int32 is
        let joined: Nat64 := modularMultiply(wide32(int32Bits(x)), wide32(int32Bits(y)));
        return int32FromBits(low32(joined));
    end;

    -- The sum of two Int64, wrapped at 64 bits.
    function wrappedSumInt64(x: Int64, y: Int64): Int64 is
        return int64FromBits(modularAdd(int64Bits(x), int64Bits(y)));
    end;

    -- The product of two Int64, wrapped at 64 bits.
    function wrappedProductInt64(x: Int64, y: Int64): Int64 is
        return int64FromBits(modularMultiply(int64Bits(x), int64Bits(y)));
    end;

    -- The join of the reduction of code reduction over Int32.
    function combineJoinInt32(reduction: Nat8): Fn[Int32, Int32, Int32] is
        if reduction = 2 then
            return minimumInt32;
        end if;
        if reduction = 3 then
            return maximumInt32;
        end if;
        if reduction = 4 then
            return wrappedProductInt32;
        end if;
        return wrappedSumInt32;
    end;

    -- The join of the reduction of code reduction over Int64.
    function combineJoinInt64(reduction: Nat8): Fn[Int64, Int64, Int64] is
        if reduction = 2 then
            return minimumInt64;
        end if;
        if reduction = 3 then
            return maximumInt64;
        end if;
        if reduction = 4 then
            return wrappedProductInt64;
        end if;
        return wrappedSumInt64;
    end;

    -- The join of the reduction of code reduction over Float32.
    function combineJoinFloat32(reduction: Nat8): Fn[Float32, Float32, Float32] is
        if reduction = 2 then
            return minimumFloat32;
        end if;
        if reduction = 3 then
            return maximumFloat32;
        end if;
        if reduction = 4 then
            return multiplyFloat32;
        end if;
        return addFloat32;
    end;

    -- The join of the reduction of code reduction over Float64.
    function combineJoinFloat64(reduction: Nat8): Fn[Float64, Float64, Float64] is
        if reduction = 2 then
            return minimumFloat64;
        end if;
        if reduction = 3 then
            return maximumFloat64;
        end if;
        if reduction = 4 then
            return multiplyFloat64;
        end if;
        return addFloat64;
    end;

    ---
    --- Shape helpers
    ---

    -- The shape two views are stretched to; the requires of the caller has
    -- checked that they broadcast.
    generic [A: Region, B: Region]
    function joinedShape(a: View[A], b: View[B]): Shape is
        case broadcastShapes(viewShape(a), viewShape(b)) of
            when Some(value as form: Shape) do
                return form;
            when None do
                abort("two views that do not broadcast reached a join");
        end case;
    end;

    -- The shape with one axis taken out: a rank of one leaves a vector of
    -- one element.
    function reducedShape(form: Shape, axis: Index): Shape is
        let axes: Index := rank(form);
        if axes = 1 then
            return shape1(1);
        end if;
        if axes = 2 then
            return shape1(extent(form, 1 - axis));
        end if;
        if axes = 3 then
            if axis = 0 then
                return shape2(extent(form, 1), extent(form, 2));
            end if;
            if axis = 1 then
                return shape2(extent(form, 0), extent(form, 2));
            end if;
            return shape2(extent(form, 0), extent(form, 1));
        end if;
        if axis = 0 then
            return shape3(extent(form, 1), extent(form, 2), extent(form, 3));
        end if;
        if axis = 1 then
            return shape3(extent(form, 0), extent(form, 2), extent(form, 3));
        end if;
        if axis = 2 then
            return shape3(extent(form, 0), extent(form, 1), extent(form, 3));
        end if;
        return shape3(extent(form, 0), extent(form, 1), extent(form, 2));
    end;

    -- The ordinal of the element at position o along the reduced shape of
    -- form, in the view the reduction writes, at the place m along the
    -- reduced axis.  The position o is taken apart over the kept axes,
    -- from the last one down, and the place m takes the slot of the
    -- reduced axis.
    function reducedOrdinal(form: Shape, axis: Index, o: Index, m: Index): Index is
        var value: Index := 0;
        var scale: Index := 1;
        var rest: Index := o;
        var i: Index := rank(form);
        while i > 0 do
            i := i - 1;
            let width: Index := extent(form, i);
            var part: Index := 0;
            if i = axis then
                part := m;
            else
                part := rem(rest, width);
                rest := rest / width;
            end if;
            value := value + (part * scale);
            scale := scale * width;
        end while;
        return value;
    end;

    ---
    --- The loops of the element types
    ---

    -- Join two views element by element into out, from 0 up to their size.
    generic [A: Region, B: Region, O: Region]
    function zipInt32(a: View[A], b: View[B], out: &![Array, O], join: Fn[Int32, Int32, Int32]): Unit is
        var k: Index := 0;
        while k < viewSize(a) do
            setInt32(&~out, k, join(getInt32(a, k), getInt32(b, k)));
            k := k + 1;
        end while;
        return nil;
    end;

    generic [A: Region, B: Region, O: Region]
    function zipInt64(a: View[A], b: View[B], out: &![Array, O], join: Fn[Int64, Int64, Int64]): Unit is
        var k: Index := 0;
        while k < viewSize(a) do
            setInt64(&~out, k, join(getInt64(a, k), getInt64(b, k)));
            k := k + 1;
        end while;
        return nil;
    end;

    generic [A: Region, B: Region, O: Region]
    function zipFloat32(a: View[A], b: View[B], out: &![Array, O], join: Fn[Float32, Float32, Float32]): Unit is
        var k: Index := 0;
        while k < viewSize(a) do
            setFloat32(&~out, k, join(getFloat32(a, k), getFloat32(b, k)));
            k := k + 1;
        end while;
        return nil;
    end;

    generic [A: Region, B: Region, O: Region]
    function zipFloat64(a: View[A], b: View[B], out: &![Array, O], join: Fn[Float64, Float64, Float64]): Unit is
        var k: Index := 0;
        while k < viewSize(a) do
            setFloat64(&~out, k, join(getFloat64(a, k), getFloat64(b, k)));
            k := k + 1;
        end while;
        return nil;
    end;

    -- Fold a view into the one element of out, in row-major order.
    generic [A: Region, O: Region]
    function foldInt32(a: View[A], out: &![Array, O], join: Fn[Int32, Int32, Int32]): Unit is
        var value: Int32 := getInt32(a, 0);
        var k: Index := 1;
        while k < viewSize(a) do
            value := join(value, getInt32(a, k));
            k := k + 1;
        end while;
        setInt32(&~out, 0, value);
        return nil;
    end;

    generic [A: Region, O: Region]
    function foldInt64(a: View[A], out: &![Array, O], join: Fn[Int64, Int64, Int64]): Unit is
        var value: Int64 := getInt64(a, 0);
        var k: Index := 1;
        while k < viewSize(a) do
            value := join(value, getInt64(a, k));
            k := k + 1;
        end while;
        setInt64(&~out, 0, value);
        return nil;
    end;

    generic [A: Region, O: Region]
    function foldFloat32(a: View[A], out: &![Array, O], join: Fn[Float32, Float32, Float32]): Unit is
        var value: Float32 := getFloat32(a, 0);
        var k: Index := 1;
        while k < viewSize(a) do
            value := join(value, getFloat32(a, k));
            k := k + 1;
        end while;
        setFloat32(&~out, 0, value);
        return nil;
    end;

    generic [A: Region, O: Region]
    function foldFloat64(a: View[A], out: &![Array, O], join: Fn[Float64, Float64, Float64]): Unit is
        var value: Float64 := getFloat64(a, 0);
        var k: Index := 1;
        while k < viewSize(a) do
            value := join(value, getFloat64(a, k));
            k := k + 1;
        end while;
        setFloat64(&~out, 0, value);
        return nil;
    end;

    -- Reduce a view along one axis into out, one result for each place
    -- along the other axes, in row-major order.
    generic [A: Region, O: Region]
    function reduceAxisInt32(a: View[A], axis: Index, out: &![Array, O], join: Fn[Int32, Int32, Int32]): Unit is
        let form: Shape := viewShape(a);
        let along: Index := viewExtent(a, axis);
        var value: Int32 := 0;
        var o: Index := 0;
        while o < (viewSize(a) / along) do
            value := getInt32(a, reducedOrdinal(form, axis, o, 0));
            var m: Index := 1;
            while m < along do
                value := join(value, getInt32(a, reducedOrdinal(form, axis, o, m)));
                m := m + 1;
            end while;
            setInt32(&~out, o, value);
            o := o + 1;
        end while;
        return nil;
    end;

    generic [A: Region, O: Region]
    function reduceAxisInt64(a: View[A], axis: Index, out: &![Array, O], join: Fn[Int64, Int64, Int64]): Unit is
        let form: Shape := viewShape(a);
        let along: Index := viewExtent(a, axis);
        var value: Int64 := 0;
        var o: Index := 0;
        while o < (viewSize(a) / along) do
            value := getInt64(a, reducedOrdinal(form, axis, o, 0));
            var m: Index := 1;
            while m < along do
                value := join(value, getInt64(a, reducedOrdinal(form, axis, o, m)));
                m := m + 1;
            end while;
            setInt64(&~out, o, value);
            o := o + 1;
        end while;
        return nil;
    end;

    generic [A: Region, O: Region]
    function reduceAxisFloat32(a: View[A], axis: Index, out: &![Array, O], join: Fn[Float32, Float32, Float32]): Unit is
        let form: Shape := viewShape(a);
        let along: Index := viewExtent(a, axis);
        var value: Float32 := 0.0;
        var o: Index := 0;
        while o < (viewSize(a) / along) do
            value := getFloat32(a, reducedOrdinal(form, axis, o, 0));
            var m: Index := 1;
            while m < along do
                value := join(value, getFloat32(a, reducedOrdinal(form, axis, o, m)));
                m := m + 1;
            end while;
            setFloat32(&~out, o, value);
            o := o + 1;
        end while;
        return nil;
    end;

    generic [A: Region, O: Region]
    function reduceAxisFloat64(a: View[A], axis: Index, out: &![Array, O], join: Fn[Float64, Float64, Float64]): Unit is
        let form: Shape := viewShape(a);
        let along: Index := viewExtent(a, axis);
        var value: Float64 := 0.0;
        var o: Index := 0;
        while o < (viewSize(a) / along) do
            value := getFloat64(a, reducedOrdinal(form, axis, o, 0));
            var m: Index := 1;
            while m < along do
                value := join(value, getFloat64(a, reducedOrdinal(form, axis, o, m)));
                m := m + 1;
            end while;
            setFloat64(&~out, o, value);
            o := o + 1;
        end while;
        return nil;
    end;

    ---
    --- The division of the means
    ---

    -- Every element of sums divided by by, as a new array.
    generic [S: Region]
    function dividedInt32(sums: &[Array, S], by: Int32): Array is
        var out: Array := zeros(int32Type(), shape(sums));
        var k: Index := 0;
        while k < size(sums) do
            setInt32(&!out, k, getInt32(view(sums), k) / by);
            k := k + 1;
        end while;
        return out;
    end;

    generic [S: Region]
    function dividedInt64(sums: &[Array, S], by: Int64): Array is
        var out: Array := zeros(int64Type(), shape(sums));
        var k: Index := 0;
        while k < size(sums) do
            setInt64(&!out, k, getInt64(view(sums), k) / by);
            k := k + 1;
        end while;
        return out;
    end;

    generic [S: Region]
    function dividedFloat32(sums: &[Array, S], by: Float32): Array is
        var out: Array := zeros(float32Type(), shape(sums));
        var k: Index := 0;
        while k < size(sums) do
            setFloat32(&!out, k, getFloat32(view(sums), k) / by);
            k := k + 1;
        end while;
        return out;
    end;

    generic [S: Region]
    function dividedFloat64(sums: &[Array, S], by: Float64): Array is
        var out: Array := zeros(float64Type(), shape(sums));
        var k: Index := 0;
        while k < size(sums) do
            setFloat64(&!out, k, getFloat64(view(sums), k) / by);
            k := k + 1;
        end while;
        return out;
    end;

    ---
    --- Elementwise operations
    ---

    -- Join two views under the join of the type of a, both stretched to
    -- the shape they broadcast to.
    generic [A: Region, B: Region]
    function zip(a: View[A], b: View[B], join_int32: Fn[Int32, Int32, Int32], join_int64: Fn[Int64, Int64, Int64], join_float32: Fn[Float32, Float32, Float32], join_float64: Fn[Float64, Float64, Float64]): Array is
        let form: Shape := joinedShape(a, b);
        let x: View[A] := broadcast(a, form);
        let y: View[B] := broadcast(b, form);
        var out: Array := zeros(viewElementType(a), form);
        if viewElementType(a) = int32Type() then
            zipInt32(x, y, &!out, join_int32);
        else if viewElementType(a) = int64Type() then
            zipInt64(x, y, &!out, join_int64);
        else if viewElementType(a) = float32Type() then
            zipFloat32(x, y, &!out, join_float32);
        else
            zipFloat64(x, y, &!out, join_float64);
        end if;
        return out;
    end;

    -- Map every element of a under the join of its type; the second
    -- operand of each join is unused.
    generic [A: Region]
    function map(a: View[A], join_int32: Fn[Int32, Int32, Int32], join_int64: Fn[Int64, Int64, Int64], join_float32: Fn[Float32, Float32, Float32], join_float64: Fn[Float64, Float64, Float64]): Array is
        let unit: View[A] := a;
        return zip(a, unit, join_int32, join_int64, join_float32, join_float64);
    end;

    generic [A: Region, B: Region]
    function add(a: View[A], b: View[B]): Array is
        return zip(a, b, addInt32, addInt64, addFloat32, addFloat64);
    end;

    generic [A: Region, B: Region]
    function subtract(a: View[A], b: View[B]): Array is
        return zip(a, b, subtractInt32, subtractInt64, subtractFloat32, subtractFloat64);
    end;

    generic [A: Region, B: Region]
    function multiply(a: View[A], b: View[B]): Array is
        return zip(a, b, multiplyInt32, multiplyInt64, multiplyFloat32, multiplyFloat64);
    end;

    generic [A: Region, B: Region]
    function divide(a: View[A], b: View[B]): Array is
        return zip(a, b, divideInt32, divideInt64, divideFloat32, divideFloat64);
    end;

    generic [A: Region]
    function negate(a: View[A]): Array is
        return map(a, negateInt32, negateInt64, negateFloat32, negateFloat64);
    end;

    generic [A: Region]
    function absolute(a: View[A]): Array is
        return map(a, absoluteInt32, absoluteInt64, absoluteFloat32, absoluteFloat64);
    end;

    ---
    --- Reductions over the whole array
    ---

    -- Fold a view into one element under the join of its type.
    generic [A: Region]
    function fold(a: View[A], join_int32: Fn[Int32, Int32, Int32], join_int64: Fn[Int64, Int64, Int64], join_float32: Fn[Float32, Float32, Float32], join_float64: Fn[Float64, Float64, Float64]): Array is
        var out: Array := zeros(viewElementType(a), shape1(1));
        if viewElementType(a) = int32Type() then
            foldInt32(a, &!out, join_int32);
        else if viewElementType(a) = int64Type() then
            foldInt64(a, &!out, join_int64);
        else if viewElementType(a) = float32Type() then
            foldFloat32(a, &!out, join_float32);
        else
            foldFloat64(a, &!out, join_float64);
        end if;
        return out;
    end;

    generic [A: Region]
    function sum(a: View[A]): Array is
        return fold(a, addInt32, addInt64, addFloat32, addFloat64);
    end;

    generic [A: Region]
    function product(a: View[A]): Array is
        return fold(a, multiplyInt32, multiplyInt64, multiplyFloat32, multiplyFloat64);
    end;

    generic [A: Region]
    function minimum(a: View[A]): Array is
        return fold(a, minimumInt32, minimumInt64, minimumFloat32, minimumFloat64);
    end;

    generic [A: Region]
    function maximum(a: View[A]): Array is
        return fold(a, maximumInt32, maximumInt64, maximumFloat32, maximumFloat64);
    end;

    -- The sums of a, each divided by along: the count of the divisor for
    -- the whole array, the length of the axis for one axis.
    function meanFrom(sums: Array, along: Index): Array is
        let kind: Nat8 := elementType(&sums);
        if kind = int32Type() then
            case toInt32(along) of
                when Some(value as divisor: Int32) do
                    let made: Array := dividedInt32(&sums, divisor);
                    destroy(sums);
                    return made;
                when None do
                    abort("the length of a reduced axis does not fit an Int32");
            end case;
        end if;
        if kind = int64Type() then
            case toInt64(along) of
                when Some(value as divisor: Int64) do
                    let made: Array := dividedInt64(&sums, divisor);
                    destroy(sums);
                    return made;
                when None do
                    abort("the length of a reduced axis does not fit an Int64");
            end case;
        end if;
        if kind = float32Type() then
            case toFloat32(along) of
                when Some(value as divisor: Float32) do
                    let made: Array := dividedFloat32(&sums, divisor);
                    destroy(sums);
                    return made;
                when None do
                    abort("the length of a reduced axis does not fit a Float32");
            end case;
        end if;
        case toFloat64(along) of
            when Some(value as divisor: Float64) do
                let made: Array := dividedFloat64(&sums, divisor);
                destroy(sums);
                return made;
            when None do
                abort("the length of a reduced axis does not fit a Float64");
        end case;
    end;

    generic [A: Region]
    function mean(a: View[A]): Array is
        var sums: Array := sum(a);
        return meanFrom(sums, viewSize(a));
    end;

    ---
    --- Reductions along one axis
    ---

    -- Reduce a view along one axis under the join of its type.
    generic [A: Region]
    function reduceAxis(a: View[A], axis: Index, join_int32: Fn[Int32, Int32, Int32], join_int64: Fn[Int64, Int64, Int64], join_float32: Fn[Float32, Float32, Float32], join_float64: Fn[Float64, Float64, Float64]): Array is
        var out: Array := zeros(viewElementType(a), reducedShape(viewShape(a), axis));
        if viewElementType(a) = int32Type() then
            reduceAxisInt32(a, axis, &!out, join_int32);
        else if viewElementType(a) = int64Type() then
            reduceAxisInt64(a, axis, &!out, join_int64);
        else if viewElementType(a) = float32Type() then
            reduceAxisFloat32(a, axis, &!out, join_float32);
        else
            reduceAxisFloat64(a, axis, &!out, join_float64);
        end if;
        return out;
    end;

    generic [A: Region]
    function sumAxis(a: View[A], axis: Index): Array is
        return reduceAxis(a, axis, addInt32, addInt64, addFloat32, addFloat64);
    end;

    generic [A: Region]
    function productAxis(a: View[A], axis: Index): Array is
        return reduceAxis(a, axis, multiplyInt32, multiplyInt64, multiplyFloat32, multiplyFloat64);
    end;

    generic [A: Region]
    function minimumAxis(a: View[A], axis: Index): Array is
        return reduceAxis(a, axis, minimumInt32, minimumInt64, minimumFloat32, minimumFloat64);
    end;

    generic [A: Region]
    function maximumAxis(a: View[A], axis: Index): Array is
        return reduceAxis(a, axis, maximumInt32, maximumInt64, maximumFloat32, maximumFloat64);
    end;

    generic [A: Region]
    function meanAxis(a: View[A], axis: Index): Array is
        var sums: Array := sumAxis(a, axis);
        return meanFrom(sums, viewExtent(a, axis));
    end;

    ---
    --- The joining of partial results
    ---

    generic [A: Region, B: Region]
    function combine(first: View[A], second: View[B], reduction: Nat8): Option[Array] is
        if viewElementType(first) /= viewElementType(second) then
            let none: Option[Array] := None();
            return none;
        end if;
        if not isNumberType(viewElementType(first)) then
            let none: Option[Array] := None();
            return none;
        end if;
        if not sameShape(viewShape(first), viewShape(second)) then
            let none: Option[Array] := None();
            return none;
        end if;
        var out: Array := zeros(viewElementType(first), viewShape(first));
        if viewElementType(first) = int32Type() then
            zipInt32(first, second, &!out, combineJoinInt32(reduction));
        else if viewElementType(first) = int64Type() then
            zipInt64(first, second, &!out, combineJoinInt64(reduction));
        else if viewElementType(first) = float32Type() then
            zipFloat32(first, second, &!out, combineJoinFloat32(reduction));
        else
            zipFloat64(first, second, &!out, combineJoinFloat64(reduction));
        end if;
        let some: Option[Array] := Some(value => out);
        return some;
    end;
end module body.
