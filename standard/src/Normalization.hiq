--
-- The algorithm of Unicode's Standard Annex 15: decompose every code point
-- fully, sort each run of accents by their combining class, and for NFC
-- and NFKC compose again from left to right, a code point composing with the
-- last starter unless something between them blocks it.  Hangul syllables
-- are decomposed and composed by arithmetic.  The tables at the end are
-- records of fixed width in string literals, found by binary search;
-- scripts/unicode/make-normalization-tables.py writes them and says their
-- format.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyFree,
    insertBack,
    lengthMut,
    nthMut,
    storeNth
);
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Utf8 (
    CodePoint,
    makeCodePoint,
    codePointValue,
    Decoded,
    decodedPoint,
    decodedWidth,
    decodeAt,
    appendCodePoint
);

module body Standard.Normalization is
    constant classWidth: Index := 14;
    constant indexWidth: Index := 14;
    constant pairWidth: Index := 18;
    constant noIndex: Index := 4294967295;
    constant sixteen: Index := 16;
    constant sBase: Index := #xAC00;
    constant lBase: Index := #x1100;
    constant vBase: Index := #x1161;
    constant tBase: Index := #x11A7;
    constant lCount: Index := 19;
    constant vCount: Index := 21;
    constant tCount: Index := 28;
    constant nCount: Index := 588;
    constant sCount: Index := 11172;
    constant blocked: Index := 256;

    -- The value of count hexadecimal digits of table from at.  The tables
    -- hold capital hexadecimal digits there; anything else is a fault of
    -- the generator.
    function hexAt(table: Span[Nat8, Static], at: Index, count: Index): Index is
        var total: Index := 0;
        var i: Index := 0;
        while i < count do
            let byte: Nat8 := table[at + i];
            var digit: Index := 0;
            if (byte >= '0') and (byte <= '9') then
                digit := widen(byte - '0');
            else if (byte >= 'A') and (byte <= 'F') then
                digit := widen((byte - 'A') + 10);
            else
                abort("Standard.Normalization: a table holds a byte that is not a hexadecimal digit");
            end if;
            total := (total * sixteen) + digit;
            i := i + 1;
        end while;
        return total;
    end;

    function widen(byte: Nat8): Index is
        case toIndex(byte) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    function combiningClass(point: Index): Index is
        let table: Span[Nat8, Static] := classTable();
        let count: Index := spanLength(table) / classWidth;
        if (count = 0) or (hexAt(table, 0, 6) > point) then
            return 0;
        end if;
        var low: Index := 0;
        var high: Index := count - 1;
        while low < high do
            let middle: Index := ((low + high) + 1) / 2;
            if hexAt(table, middle * classWidth, 6) <= point then
                low := middle;
            else
                high := middle - 1;
            end if;
        end while;
        if point > hexAt(table, (low * classWidth) + 6, 6) then
            return 0;
        end if;
        return hexAt(table, (low * classWidth) + 12, 2);
    end;

    -- The record of the decomposition table for point, or noIndex.
    function findDecomposition(point: Index): Index is
        let table: Span[Nat8, Static] := decomposeTable();
        var low: Index := 0;
        var high: Index := spanLength(table) / indexWidth;
        while low < high do
            let middle: Index := (low + high) / 2;
            let found: Index := hexAt(table, middle * indexWidth, 6);
            if found = point then
                return middle;
            end if;
            if found < point then
                low := middle + 1;
            else
                high := middle;
            end if;
        end while;
        return noIndex;
    end;

    -- Appends the full decomposition of point to out: canonical only, or
    -- the compatibility decompositions as well.
    generic [G: Region]
    function decomposeInto(point: Index, compat: Bool, out: &![Buffer[Index], G]): Unit is
        if (point >= sBase) and (point < (sBase + sCount)) then
            let s: Index := point - sBase;
            insertBack(&~out, lBase + (s / nCount));
            insertBack(&~out, vBase + ((s - ((s / nCount) * nCount)) / tCount));
            let t: Index := s - ((s / tCount) * tCount);
            if t /= 0 then
                insertBack(&~out, tBase + t);
            end if;
            return nil;
        end if;
        let at: Index := findDecomposition(point);
        if at = noIndex then
            insertBack(&~out, point);
            return nil;
        end if;
        let table: Span[Nat8, Static] := decomposeTable();
        let kind: Nat8 := table[(at * indexWidth) + 13];
        if (kind = 'K') and (not compat) then
            insertBack(&~out, point);
            return nil;
        end if;
        let start: Index := hexAt(table, (at * indexWidth) + 6, 5);
        let size: Index := hexAt(table, (at * indexWidth) + 11, 2);
        let list: Span[Nat8, Static] := decompositionList();
        var k: Index := 0;
        while k < size do
            let part: Index := hexAt(list, (start + k) * 6, 6);
            if compat and (kind = 'C') then
                -- A part of a canonical decomposition has no canonical
                -- decomposition left, but it may have a compatibility one,
                -- as the long s in U+1E9B has; its record holds that one
                -- in full.
                decomposeInto(part, compat, &~out);
            else
                insertBack(&~out, part);
            end if;
            k := k + 1;
        end while;
        return nil;
    end;

    -- Sorts every run of code points of a combining class other than 0 by
    -- that class, keeping the order of equal classes: the canonical order.
    generic [G: Region]
    function orderCanonically(points: &![Buffer[Index], G]): Unit is
        let size: Index := lengthMut(&~points);
        var i: Index := 1;
        while i < size do
            let point: Index := nthMut(&~points, i);
            let cc: Index := combiningClass(point);
            if cc /= 0 then
                var j: Index := i;
                var moving: Bool := true;
                while moving do
                    if j = 0 then
                        moving := false;
                    else
                        let before: Index := nthMut(&~points, j - 1);
                        let beforeClass: Index := combiningClass(before);
                        if beforeClass > cc then
                            storeNth(&~points, j, before);
                            j := j - 1;
                        else
                            moving := false;
                        end if;
                    end if;
                end while;
                storeNth(&~points, j, point);
            end if;
            i := i + 1;
        end while;
        return nil;
    end;

    -- What first and second compose to, or noIndex: Hangul by arithmetic,
    -- the rest by the table of pairs.
    function composePair(first: Index, second: Index): Index is
        if (first >= lBase) and ((first < (lBase + lCount)) and ((second >= vBase) and (second < (vBase + vCount)))) then
            return sBase + ((((first - lBase) * vCount) + (second - vBase)) * tCount);
        end if;
        if (first >= sBase) and ((first < (sBase + sCount)) and ((second > tBase) and (second < (tBase + tCount)))) then
            let s: Index := first - sBase;
            if (s - ((s / tCount) * tCount)) = 0 then
                return first + (second - tBase);
            end if;
            return noIndex;
        end if;
        let table: Span[Nat8, Static] := composeTable();
        var low: Index := 0;
        var high: Index := spanLength(table) / pairWidth;
        while low < high do
            let middle: Index := (low + high) / 2;
            let a: Index := hexAt(table, middle * pairWidth, 6);
            let b: Index := hexAt(table, (middle * pairWidth) + 6, 6);
            if (a = first) and (b = second) then
                return hexAt(table, (middle * pairWidth) + 12, 6);
            end if;
            if (a < first) or ((a = first) and (b < second)) then
                low := middle + 1;
            else
                high := middle;
            end if;
        end while;
        return noIndex;
    end;

    -- Composes points in place, from the left, as the canonical
    -- composition algorithm says; returns how many code points remain.
    generic [G: Region]
    function composeAll(points: &![Buffer[Index], G]): Index is
        let size: Index := lengthMut(&~points);
        if size = 0 then
            return 0;
        end if;
        var starterAt: Index := 0;
        var starter: Index := nthMut(&~points, 0);
        -- The class of the last code point kept after the starter; 256 when
        -- the text begins with an accent, which has no starter to join.
        var lastClass: Index := combiningClass(starter);
        if lastClass /= 0 then
            lastClass := blocked;
        end if;
        var kept: Index := 1;
        var i: Index := 1;
        while i < size do
            let point: Index := nthMut(&~points, i);
            let cc: Index := combiningClass(point);
            let composite: Index := composePair(starter, point);
            if (composite /= noIndex) and ((lastClass < cc) or (lastClass = 0)) then
                storeNth(&~points, starterAt, composite);
                starter := composite;
            else
                if cc = 0 then
                    starterAt := kept;
                    starter := point;
                end if;
                lastClass := cc;
                storeNth(&~points, kept, point);
                kept := kept + 1;
            end if;
            i := i + 1;
        end while;
        return kept;
    end;

    -- The text normalized: decomposed, canonical or with compatibility,
    -- ordered, and composed when compose is true.
    generic [R: Region]
    function normalize(text: Span[Nat8, R], compat: Bool, compose: Bool): Option[String] is
        var points: Buffer[Index] := allocateEmpty();
        let size: Index := spanLength(text);
        var at: Index := 0;
        var valid: Bool := true;
        while valid and (at < size) do
            case decodeAt(text, at) of
                when Some(value as decoded: Decoded) do
                    case toIndex(codePointValue(decodedPoint(decoded))) of
                        when Some(value as scalar: Index) do
                            decomposeInto(scalar, compat, &!points);
                        when None do
                            valid := false;
                    end case;
                    at := at + decodedWidth(decoded);
                when None do
                    valid := false;
            end case;
        end while;
        if not valid then
            destroyFree(points);
            let none: Option[String] := None();
            return none;
        else
            let result: Option[String] := Some(value => rendered(points, compose));
            return result;
        end if;
    end;

    -- The decomposed code points ordered, composed when compose is true,
    -- and written as UTF-8.  The buffer is used up.
    function rendered(decomposed: Buffer[Index], compose: Bool): String is
        var points: Buffer[Index] := decomposed;
        orderCanonically(&!points);
        var count: Index := lengthMut(&!points);
        if compose then
            count := composeAll(&!points);
        end if;
        var out: StringBuilder := makeStringBuilder();
        var k: Index := 0;
        while k < count do
            case toNat32(nthMut(&!points, k)) of
                when Some(value as scalar: Nat32) do
                    case makeCodePoint(scalar) of
                        when Some(value as point: CodePoint) do
                            appendCodePoint(&!out, point);
                        when None do
                            abort("Standard.Normalization: a table gave a value that is not a code point");
                    end case;
                when None do
                    abort("Standard.Normalization: a table gave a value past Nat32");
            end case;
            k := k + 1;
        end while;
        destroyFree(points);
        return finalize(out);
    end;

    generic [R: Region]
    function toNfd(text: Span[Nat8, R]): Option[String] is
        return normalize(text, false, false);
    end;

    generic [R: Region]
    function toNfc(text: Span[Nat8, R]): Option[String] is
        return normalize(text, false, true);
    end;

    generic [R: Region]
    function toNfkd(text: Span[Nat8, R]): Option[String] is
        return normalize(text, true, false);
    end;

    generic [R: Region]
    function toNfkc(text: Span[Nat8, R]): Option[String] is
        return normalize(text, true, true);
    end;

    ---
    --- The tables, written by scripts/unicode/make-normalization-tables.py
    --- from the Unicode Character Database 17.0.0.  Not edited by hand.
    ---

