"""
The part of YAML that configuration files use, read into the values of Standard.Json.

- Block mappings, block sequences, plain and quoted scalars and block scalars are read.
- A flow sequence or a flow mapping is read when it ends on its line.
- A plain scalar is null, a boolean, a number as JSON writes one, or else a string, as yes is.
- Anchors, aliases, tags, directives and a second document are refused, not ignored.
- So no small text can expand through aliases into a huge value.
- A tab in the indentation, a scalar over several lines and a key twice in a mapping are refused.
- Nesting deeper than 64 is refused; every refusal names the line where reading stopped.

    case readYaml(asSpan(&text)) of
        when Right(right as config: Json) do
            apply(config);
        when Left(left as error: YamlError) do
            report(error.line);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);
import Standard.Json (
    Json
);

module Standard.Yaml is
    """
    Why a text was refused.
    """
    union YamlProblem: Free is
        """
        The text is not YAML, or not the part of it this module reads.
        """
        case NotYaml;
        """
        An anchor, an alias, a tag, a directive or a second document.
        """
        case YamlUnsupported;
        """
        Nesting deeper than 64.
        """
        case YamlTooDeep;
        """
        The value has no JSON form: a key twice in one mapping.
        """
        case YamlNotJson;
    end;

    """
    What went wrong and the line, from 1, where reading stopped.
    """
    record YamlError: Free is
        problem: YamlProblem;
        line: Index;
    end;

    """
    The document in text as JSON text, without spaces.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function yamlToJson(text: Span[Nat8, R]): Either[YamlError, String];

    """
    The document in text as a value of Standard.Json.  A double-quoted scalar takes the
    escapes of JSON and \x.  A block scalar of a bar keeps the line breaks, one of an angle
    bracket folds them; a minus after either drops the final ones, a plus keeps them all.
    A plain scalar is null when empty, a tilde or null; true and false may have a capital or
    be in capitals.  Comments, blank lines, a first line of three dashes and a last of three
    dots are skipped.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readYaml(text: Span[Nat8, R]): Either[YamlError, Json];
end module.
