"""
Passwords stored as Argon2id hashes in the PHC string form, and checked against them.

- A hash reads $argon2id$v=19$m=65536,t=3,p=4$, then salt, $ and tag in Base64 without padding.
- A new hash takes 65536 kibibytes, 3 passes, 4 lanes, a 16-byte random salt and a 32-byte tag.
- No caller chooses weaker values.
- A stored hash is checked with the values it names, within bounds this module sets.
- The tags are compared in constant time.
- A broken stored string is an answer, Unreadable, never an abort.
- An old bcrypt hash, marked 2a, 2b or 2y, is checked through the system's library, never made.
- A matching bcrypt hash gives MatchesStoreAgain, and the caller stores a new hash.
- A peppered hash reads $argon2id-hmac$v=19$m=65536,t=3,p=4$, then salt, $ and the HMAC-SHA256 of the tag under the pepper.
- A pepper has 32 bytes at least and is kept apart from the stored hashes.

    let stored: Option[String] := hashPassword(asSpan(&typed));
    let check: PasswordCheck := checkPassword(asSpan(&typed), asSpan(&saved));
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);

module Standard.Password is
    """
    What checkPassword found.
    """
    union PasswordCheck: Free is
        """
        The password is the one the hash was made from.
        """
        case Matches;
        """
        The password matches an old bcrypt hash.  Store a new one, made
        with hashPassword, in its place.
        """
        case MatchesStoreAgain;
        """
        The password is not the one the hash was made from.
        """
        case DoesNotMatch;
        """
        The stored string is not a hash this module reads: another form,
        another variant or version, or a value outside the bounds.
        """
        case Unreadable;
        """
        The hash could not be computed: the library failed, for lack of
        memory for one.
        """
        case Failed;
    end;

    """
    A new stored hash of password, with the values above and a fresh salt.
    None when the random source or the library fails.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function hashPassword(password: Span[Nat8, R]): Option[String];

    """
    Whether password is the one the stored hash was made from.  The memory,
    passes and lanes are read from the stored string, never assumed.  A
    bcrypt hash must be 60 bytes with a cost from 4 to 16; one that matches
    is MatchesStoreAgain, never Matches.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [P: Region, S: Region]
    function checkPassword(password: Span[Nat8, P], stored: Span[Nat8, S]): PasswordCheck;

    """
    A new peppered hash of password: the Argon2id tag of the values above
    under a fresh salt, and in its place the HMAC-SHA256 of the tag under
    pepper.  None when pepper has fewer than 32 bytes, password is empty or
    longer than 128 bytes, or the random source or the library fails.
    No contract: an Option over the random source.
    """
    generic [P: Region, Q: Region]
    function hashPepperedPassword(password: Span[Nat8, P], pepper: Span[Nat8, Q]): Option[String];

    """
    Whether password is the one the stored peppered hash was made from
    under pepper.  Only the values above are read; any other is Unreadable,
    as is a salt of another size than 16 bytes or a code of another size
    than 32.  An empty password or one longer than 128 bytes is
    DoesNotMatch, a pepper of fewer than 32 bytes Failed.
    No contract: the answer is the work of Argon2id.
    """
    generic [P: Region, S: Region, Q: Region]
    function checkPepperedPassword(password: Span[Nat8, P], stored: Span[Nat8, S], pepper: Span[Nat8, Q]): PasswordCheck;
end module.
