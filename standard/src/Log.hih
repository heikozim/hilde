"""
Log entries with a level, a message and named fields, one line each.

- A line goes to the standard error, to a file or to the system log.
- A line is text, time=... level=... msg=... and name=value fields, or one JSON object.
- The time is UTC with milliseconds.
- A text value is quoted when it is empty or holds a space, an equals sign, a quote or a backslash.
- In message, names and values a tab or a line feed becomes a space.
- Other C0 and C1 controls, the delete character and malformed UTF-8 become a full stop.
- A byte of a name outside letters, digits and _ . - becomes _.
- A line is written only once it is complete; a log file is opened for appending, with mode 0640.

    var log: Log := logToError(acquireError(&!terminal), Info(), TextLines());
    let entry: Entry := addInteger(makeEntry(Warning(), "slow request"), "millis", millis);
    let written: Bool := writeEntry(&!log, entry);
    let closed: Bool := closeLog(log);
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String
);
import Standard.IO.Terminal (
    StandardError
);
import Standard.Calendar (
    Instant
);

module Standard.Log is
    """
    How urgent an entry is.  A log writes the entries of its least level
    and those more urgent: Debug is the least urgent, Error the most.
    """
    union Level: Free is
        case Debug;
        case Info;
        case Warning;
        case Error;
    end;

    """
    The form of a line: text of name=value pairs, or a JSON object.
    """
    union Format: Free is
        case TextLines;
        case JsonLines;
    end;

    """
    The facility the system log files an entry under.
    """
    union Facility: Free is
        case User;
        case Daemon;
        case Local0;
        case Local1;
        case Local2;
        case Local3;
        case Local4;
        case Local5;
        case Local6;
        case Local7;
    end;

    """
    Where the lines go.  Linear: closeLog gives it back.
    """
    type Log: Linear;

    """
    A log to standard error.  It keeps stream until closeLog.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function logToError(stream: StandardError, least: Level, format: Format): Log;

    """
    A log appended to the file at path, which is created if missing; its
    directory is not.  The open file is set to mode 0640 whatever the
    umask, so under pledge
    on OpenBSD the programme needs the promise fattr.  None when the path
    is empty, holds a zero byte, or the kernel refused.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function logToFile(path: Span[Nat8, R], least: Level, format: Format): Option[Log];

    """
    A log to the system log through syslog(3), under the name and facility
    given.  The system log adds the time itself, so a line holds the
    message and the fields only.  The process has one connection to the
    system log: a second log to it takes the connection over.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function logToSystem(name: Span[Nat8, R], facility: Facility, least: Level): Log;

    """
    A log that writes nothing.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function logToNothing(): Log;

    """
    Whether log writes entries of level.  A caller can skip building an
    entry nobody reads.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function logsLevel(log: &[Log, R], level: Level): Bool;

    """
    Closes a log file and opens its path again under the same descriptor,
    for a rotation that renamed it.  Returns false when the path could not be opened; the log
    then writes nothing until a later reopenLog succeeds.  For the other
    logs it does nothing and returns true.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function reopenLog(log: &![Log, R]): Bool;

    """
    Closes a log.  Returns false when closing the file reported an error.
    No contract: it only frees or closes what it is given.
    """
    function closeLog(log: Log): Bool;

    ---
    --- Entries
    ---

    """
    An entry being built.  Linear: writeEntry or discardEntry gives it
    back.
    """
    type Entry: Linear;

    """
    An entry of level with message and no fields.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function makeEntry(level: Level, message: Span[Nat8, R]): Entry;

    """
    entry with a field of text added.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region, S: Region]
    function addText(entry: Entry, name: Span[Nat8, R], value: Span[Nat8, S]): Entry;

    """
    entry with a field of an integer added.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function addInteger(entry: Entry, name: Span[Nat8, R], value: Int64): Entry;

    """
    entry with a field of true or false added.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function addBool(entry: Entry, name: Span[Nat8, R], value: Bool): Entry;

    """
    Writes entry as one line to log, with the time of the system clock, if
    log writes its level.  Returns false when the write failed; an entry
    below the log's level is dropped and true returned.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function writeEntry(log: &![Log, R], entry: Entry): Bool;

    """
    Drops an entry without writing it.
    No contract: it only frees or closes what it is given.
    """
    function discardEntry(entry: Entry): Unit;

    """
    The line entry gives at the time at in format, without the line feed.
    It is what writeEntry writes.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function formatEntry(entry: &[Entry, R], at: Instant, format: Format): String;

    """
    Writes an entry of level with message and no fields.  Returns what
    writeEntry returns.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region, S: Region]
    function logLine(log: &![Log, R], level: Level, message: Span[Nat8, S]): Bool;
end module.
