"""
A typeclass for the smallest and the largest value of a type.

- minBound and maxBound take nothing and cannot fail.
- Instances: Bool, Nat8 to Nat64, Int8 to Int64 and Index.
- For Bool the smallest is false and the largest true.
- For a natural type the smallest is 0.

    let top: Nat32 := maxBound();
    let bottom: Int64 := minBound();
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Bounded is
    typeclass Bounded(A: Type) is
        """
        No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
        """
        method minBound(): A;

        """
        No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
        """
        method maxBound(): A;
    end;

    instance Bounded(Bool);
    instance Bounded(Nat8);
    instance Bounded(Nat16);
    instance Bounded(Nat32);
    instance Bounded(Nat64);
    instance Bounded(Int8);
    instance Bounded(Int16);
    instance Bounded(Int32);
    instance Bounded(Int64);
    instance Bounded(Index);
end module.
