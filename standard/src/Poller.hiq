-- A safe module: the calls into the runtime go through Bindings.Poller.
import Bindings.Poller (
    Handle,
    backendCode,
    createHandle,
    destroyHandle,
    addDescriptor,
    modifyDescriptor,
    dropDescriptor,
    registeredCount,
    waitHandle,
    eventDescriptorAt,
    eventFlagsAt
);
import Standard.File (
    FileDescriptor,
    fileNumber
);
import Standard.String (
    String,
    fromLiteral
);

module body Standard.Poller is
    record Backend: Free is
        code: Int32;
    end;

    constant code_none: Int32 := 0;
    constant code_epoll: Int32 := 1;
    constant code_kqueue: Int32 := 2;

    constant backend_none: Backend := Backend(code => code_none);
    constant backend_epoll: Backend := Backend(code => code_epoll);
    constant backend_kqueue: Backend := Backend(code => code_kqueue);

    function backendAvailable(): Backend is
        return Backend(code => backendCode());
    end;

    function sameBackend(left: Backend, right: Backend): Bool is
        return left.code = right.code;
    end;

    function describeBackend(backend: Backend): String is
        if backend.code = code_epoll then
            return fromLiteral("poller:      epoll");
        end if;
        if backend.code = code_kqueue then
            return fromLiteral("poller:      kqueue");
        end if;
        return fromLiteral("poller:      none");
    end;

    ---
    --- Interest
    ---

    record Interest: Free is
        bits: Int32;
    end;

    -- The same three numbers the runtime uses.  They are written here
    -- rather than fetched, because a constant fetched through a foreign
    -- call is one nobody can fold; and they are the runtime's own, not the
    -- platform's: the runtime translates them for the backend.
    constant interest_read: Interest := Interest(bits => 1);
    constant interest_write: Interest := Interest(bits => 2);
    constant interest_read_write: Interest := Interest(bits => 3);

    ---
    --- The poller
    ---

    record Poller: Linear is
        handle: Handle;
    end;

    function createPoller(): Option[Poller] is
        case createHandle() of
            when Some(value as handle: Handle) do
                let poller: Poller := Poller(handle => handle);
                let some: Option[Poller] := Some(value => poller);
                return some;
            when None do
                -- Either there is no backend on this platform or the kernel
                -- refused.  backendAvailable tells the two apart, and it can
                -- be asked before this call.
                let none: Option[Poller] := None();
                return none;
        end case;
    end;

    function destroyPoller(poller: Poller): Unit is
        let { handle: Handle } := poller;
        destroyHandle(handle);
        return nil;
    end;

    generic [R: Region, S: Region]
    function watchFile(poller: &![Poller, R],
        file: &[FileDescriptor, S],
        interest: Interest): Bool is
        return addDescriptor(&!(poller->handle), fileNumber(file), interest.bits);
    end;

    generic [R: Region, S: Region]
    function rewatchFile(poller: &![Poller, R],
        file: &[FileDescriptor, S],
        interest: Interest): Bool is
        return modifyDescriptor(&!(poller->handle), fileNumber(file), interest.bits);
    end;

    generic [R: Region, S: Region]
    function unwatchFile(poller: &![Poller, R],
        file: &[FileDescriptor, S]): Bool is
        return dropDescriptor(&!(poller->handle), fileNumber(file));
    end;

    generic [R: Region]
    function watchedCount(poller: &[Poller, R]): Index is
        return registeredCount(&(poller->handle));
    end;

    ---
    --- Waiting
    ---

    generic [R: Region]
    function waitFor(poller: &![Poller, R],
        timeout_millis: Int32): Option[Index] is
        let ready: Int32 := waitHandle(&!(poller->handle), timeout_millis);
        if ready < 0 then
            let none: Option[Index] := None();
            return none;
        end if;
        -- Zero is the timeout, and it is an answer, so it goes through the
        -- same Some the other counts do.
        return toIndex(ready);
    end;

    record Event: Free is
        descriptor: Int32;
        flags: Int32;
    end;

    constant flag_read: Int32 := 1;
    constant flag_write: Int32 := 2;
    constant flag_error: Int32 := 4;

    generic [R: Region]
    function nthEvent(poller: &[Poller, R], index: Index): Option[Event] is
        let descriptor: Int32 := eventDescriptorAt(&(poller->handle), index);
        if descriptor < 0 then
            -- Past the end of what the last wait reported, which is how a
            -- caller walks the events without counting them twice.
            let none: Option[Event] := None();
            return none;
        end if;
        let flags: Int32 := eventFlagsAt(&(poller->handle), index);
        let event: Event := Event(descriptor => descriptor, flags => flags);
        let some: Option[Event] := Some(value => event);
        return some;
    end;

    function eventDescriptor(event: Event): Int32 is
        return event.descriptor;
    end;

    -- The three questions are asked with bitwiseAnd rather than equality:
    -- an event can carry more than one answer at a time, and a reader that
    -- compared the whole word would miss every one of those.
    function eventReadable(event: Event): Bool is
        return bitwiseAnd(event.flags, flag_read) = flag_read;
    end;

    function eventWritable(event: Event): Bool is
        return bitwiseAnd(event.flags, flag_write) = flag_write;
    end;

    function eventFailed(event: Event): Bool is
        return bitwiseAnd(event.flags, flag_error) = flag_error;
    end;
end module body.
