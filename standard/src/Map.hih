"""
A map from keys to values, ordered by the TotalOrder of the keys from Standard.Order.

- A lookup takes O(log n) comparisons; put and remove take time O(n) in the number of entries.
- Entries come in the order of the keys, the same on every run and every platform.
- Keys and values may be linear, and whatever leaves the map comes back to the caller.
- A put over a key the map holds hands back the old key and the old value.
- A map is destroyed only when empty, or when both types are Free.
- A user of String or integer keys imports from Standard.Order, or the call fails with H3061.

    var stock: Map[Nat64, Nat64] := makeMap();
    let old: Option[Pair[Nat64, Nat64]] := put(&!stock, item, 12);
    let count: Option[Nat64] := get(&stock, &item);
    destroyFree(stock);
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);

module Standard.Map is
    """
    The map type.
    """
    type Map[K: Type, V: Type]: Linear;

    ---
    --- Lifecycle
    ---

    """
    An empty map.  Aborts when memory runs out, as Standard.Buffer does.
    """
    generic [K: Type, V: Type]
    function makeMap(): Map[K, V]
        ensures size(&result) = 0;

    """
    Destroy an empty map.  The map must hold no entry: that is the duty of the
    caller, a requires, because the entry would be lost, and a linear key or
    value must not be lost.  A call on a map that holds one stops the
    programme with the line of the call.
    """
    generic [K: Type, V: Type]
    function destroyEmpty(map: Map[K, V]): Unit
        requires size(&map) = 0;

    """
    Destroy a map whose keys and values are free, whatever it holds.
    No contract: it only frees or closes what it is given.
    """
    generic [K: Free, V: Free]
    function destroyFree(map: Map[K, V]): Unit;

    ---
    --- Asking
    ---

    """
    The number of entries.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [K: Type, V: Type, R: Region]
    function size(map: &[Map[K, V], R]): Index;

    """
    Whether the map holds key.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [K: Type(TotalOrder), V: Type, R: Region, S: Region]
    function contains(map: &[Map[K, V], R], key: &[K, S]): Bool;

    """
    A copy of the value stored under key, for a free value.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder), V: Free, R: Region, S: Region]
    function get(map: &[Map[K, V], R], key: &[K, S]): Option[V];

    """
    A reference to the value stored under key, for any value.  It lives as
    long as the borrow of the map.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder), V: Type, R: Region, S: Region]
    function getRef(map: &[Map[K, V], R], key: &[K, S]): Option[&[V, R]];

    ---
    --- Asking through a write reference
    ---

    """
    The same as size, asked through a write reference.  A caller that holds
    the map through a write reference can also write size(&map): a read
    borrow of a write reference reads what it points to.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [K: Type, V: Type, R: Region]
    function sizeMut(map: &![Map[K, V], R]): Index;

    """
    The same as contains, asked through a write reference.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [K: Type(TotalOrder), V: Type, R: Region, S: Region]
    function containsMut(map: &![Map[K, V], R], key: &[K, S]): Bool;

    """
    The same as get, asked through a write reference.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder), V: Free, R: Region, S: Region]
    function getMut(map: &![Map[K, V], R], key: &[K, S]): Option[V];

    ---
    --- Changing
    ---

    """
    Store value under key.  When the map held the key already, the entry is
    replaced, and the old key and the old value come back in Some.
    Otherwise the result is None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder), V: Type, R: Region]
    function put(map: &![Map[K, V], R], key: K, value: V): Option[Pair[K, V]];

    """
    Replace the value stored under key and keep the stored key.  Right
    carries the old value.  Left hands value back when the map does not hold
    the key.  Left is the failure and Right the success, as everywhere in
    the standard library.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder), V: Type, R: Region, S: Region]
    function replaceValue(map: &![Map[K, V], R], key: &[K, S], value: V): Either[V, V];

    """
    Take the entry stored under key out of the map.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [K: Type(TotalOrder), V: Type, R: Region, S: Region]
    function remove(map: &![Map[K, V], R], key: &[K, S]): Option[Pair[K, V]];

    ---
    --- In the order of the keys
    ---

    """
    The key at pos, counted from the smallest.  pos must be less than the
    size: that is the duty of the caller, a requires, and a call with a
    greater pos stops the programme with the line of the call.
    """
    generic [K: Type, V: Type, R: Region]
    function keyAt(map: &[Map[K, V], R], pos: Index): &[K, R]
        requires pos < size(map);

    """
    The value at pos, the value of keyAt(map, pos), with the same duty.
    """
    generic [K: Type, V: Type, R: Region]
    function valueAt(map: &[Map[K, V], R], pos: Index): &[V, R]
        requires pos < size(map);

    """
    Take the entry at pos out of the map.  This is how a map of linear keys
    or values is emptied before destroyEmpty.
    """
    generic [K: Type, V: Type, R: Region]
    function removeAt(map: &![Map[K, V], R], pos: Index): Pair[K, V]
        requires pos < size(&map)
        ensures size(&map) = (old(size(&map)) - 1);
end module.
