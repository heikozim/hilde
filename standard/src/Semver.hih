"""
Release versions of the form vX.Y.Z, as git tags carry them, read, written and ordered.

- A version is a small v and three decimal numbers joined by dots, such as v1.12.0; nothing may follow.
- A number has no leading zero, except the number 0 itself, and at most nine digits.
- The order is by major, then minor, then patch, each as a number.
- Reading refuses rather than guesses: anything else gives None, and nothing aborts on bad input.
- A change of the major number is a break; within one major a greater version stays compatible.

    case parseVersion("v1.4.2") of
        when Some(value as version: Version) do
            let text: String := formatVersion(version);
            printLn(asSpan(&text));
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String,
    length
);
import Standard.Order (
    Ordering,
    TotalOrder
);

module Standard.Semver is
    """
    A version: its major, minor and patch numbers, each from 0 to
    mostNumber.
    """
    record Version: Free is
        major: Int64;
        minor: Int64;
        patch: Int64;
    end;

    """
    The greatest number a version may carry, nine digits.
    """
    function mostNumber(): Int64
        ensures result = 999999999;

    """
    The version of the three numbers.
    """
    function makeVersion(major: Int64, minor: Int64, patch: Int64): Version
        requires (((major >= 0) and (minor >= 0)) and (patch >= 0)) and (((major <= mostNumber()) and (minor <= mostNumber())) and (patch <= mostNumber()))
        ensures ((result.major = major) and (result.minor = minor)) and (result.patch = patch);

    """
    The version the text stands for, such as v1.4.2.  None when the text is
    not of that form, as the module's text says.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseVersion(text: Span[Nat8, R]): Option[Version];

    """
    The version as text, a v and the three numbers joined by dots.
    """
    function formatVersion(version: Version): String
        ensures length(&result) >= 6;

    """
    The next patch, minor or major version: the number raised by one, the
    numbers after it set to 0.
    """
    function nextPatch(version: Version): Version
        requires version.patch < mostNumber()
        ensures ((result.major = version.major) and (result.minor = version.minor)) and (result.patch = (version.patch + 1));

    """
    The next minor version; see nextPatch.
    """
    function nextMinor(version: Version): Version
        requires version.minor < mostNumber()
        ensures ((result.major = version.major) and (result.minor = (version.minor + 1))) and (result.patch = 0);

    """
    The next major version; see nextPatch.
    """
    function nextMajor(version: Version): Version
        requires version.major < mostNumber()
        ensures ((result.major = (version.major + 1)) and (result.minor = 0)) and (result.patch = 0);

    """
    Whether both versions have the same major number, so that the greater
    can stand for the smaller.
    """
    function sameMajor(left: Version, right: Version): Bool
        ensures result = (left.major = right.major);

    """
    The greater of the two versions.
    No contract: which of the two comes back depends on all three numbers, which a condition cannot say in O(1) without the comparison itself.
    """
    function greaterVersion(left: Version, right: Version): Version;

    """
    Versions in the order of the module's text.
    """
    instance TotalOrder(Version);
end module.
