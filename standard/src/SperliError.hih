"""
The codes with which a Sperli job refuses a peer, a frame or a token, and their words.

- A code is a number from 1601 on, written H1601, and names one kind of refusal.
- Zero is no refusal.
- A code is never given to another refusal.
- describe gives a short sentence for every code, and for no other number the empty one.

    let why: Span[Nat8, Static] := describe(badToken());
"""
pragma Targets(Names => "linux openbsd freebsd darwin");

module Standard.SperliError is
    """
    The peer showed no certificate, or one the job CA does not vouch for: 1601.
    """
    function badCertificate(): Int32
        ensures result = 1601;

    """
    The subject of the certificate is not the job and rank of the peer: 1602.
    """
    function subjectMismatch(): Int32
        ensures result = 1602;

    """
    The host is refused by hostRefused of Standard.SperliWire, or is on
    the operator's deny list: 1603.
    """
    function refusedHost(): Int32
        ensures result = 1603;

    """
    The join token has expired: 1604.
    """
    function tokenExpired(): Int32
        ensures result = 1604;

    """
    The join token was made for another job: 1605.
    """
    function tokenForeignJob(): Int32
        ensures result = 1605;

    """
    The join token was made for another rank, size, incarnation or host: 1606.
    """
    function tokenWrongRank(): Int32
        ensures result = 1606;

    """
    The join token is malformed or its signature does not hold: 1607.
    """
    function tokenBadSignature(): Int32
        ensures result = 1607;

    """
    The frame says it carries more payload than the limit: 1608.
    """
    function oversizedFrame(): Int32
        ensures result = 1608;

    """
    The frame belongs to an older incarnation and is dropped: 1609.
    """
    function staleIncarnation(): Int32
        ensures result = 1609;

    """
    The header of a frame breaks a rule of the protocol: 1610.
    """
    function badFrame(): Int32
        ensures result = 1610;

    """
    The peer was lost: the connection closed or no frame came in time: 1611.
    """
    function peerLost(): Int32
        ensures result = 1611;

    """
    The peer sent an abort frame: 1612.
    """
    function peerAborted(): Int32
        ensures result = 1612;

    """
    The hello frame of the peer is missing, repeated or not acceptable: 1613.
    """
    function badHello(): Int32
        ensures result = 1613;

    """
    The command line or the host list of the launcher is wrong: 1614.
    """
    function badLaunch(): Int32
        ensures result = 1614;

    """
    A rank could not be started or the job could not be set up: 1615.
    """
    function startFailed(): Int32
        ensures result = 1615;

    """
    The job description a rank was given is malformed: 1616.
    """
    function badJob(): Int32
        ensures result = 1616;

    """
    A collective frame does not match the call it answers: another operation, type, reduce operation, phase, root or sequence number, or a cut header: 1617.
    """
    function collectiveMismatch(): Int32
        ensures result = 1617;

    """
    The arguments of a collective call are wrong: a root outside the job, an element type or reduce operation that does not go together, data that is not whole elements or blocks, or too large: 1618.
    """
    function badCollective(): Int32
        ensures result = 1618;

    """
    A checkpoint file has another magic or version, or a job, epoch, rank, size or length that is not the one expected: 1619.
    """
    function badCheckpointFile(): Int32
        ensures result = 1619;

    """
    The SHA-256 of a checkpoint file is not the one its header or the COMMIT file gives: 1620.
    """
    function digestMismatch(): Int32
        ensures result = 1620;

    """
    A COMMIT file is malformed, is of another job or epoch, or its signature does not hold: 1621.
    """
    function badCommit(): Int32
        ensures result = 1621;

    """
    No epoch can be resumed: none has a valid COMMIT, or a rank file is lost and its buddy has no valid copy: 1622.
    """
    function resumeRefused(): Int32
        ensures result = 1622;

    """
    The job has another number of ranks than the checkpoint it should resume: 1623.
    """
    function sizeMismatch(): Int32
        ensures result = 1623;

    """
    A checkpoint was asked for while a send or receive was still open: 1624.
    """
    function openHandles(): Int32
        ensures result = 1624;

    """
    A checkpoint could not be written or sent, or no checkpoint directory was named: 1625.
    """
    function checkpointFailed(): Int32
        ensures result = 1625;

    """
    The exit status of a rank that leaves because the job is lost, a peer
    is gone or aborted or a checkpoint failed: 75.  The launcher restarts
    the job without moving such a rank.
    """
    function restartStatus(): Int32
        ensures result = 75;

    """
    A short sentence for code, the empty one for a number that is no code.
    """
    function describe(code: Int32): Span[Nat8, Static]
        ensures spanLength(result) <= 80;
end module.
