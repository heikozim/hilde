import Bindings.Bulk (
    fillBytes as bindFillBytes,
    fillElements as bindFillElements,
    copyElements as bindCopyElements
);

-- The requires of the interface hold every range inside its span, so the
-- bindings are called without a check of their own.
module body Standard.Bulk is
    generic [R: Region]
    function fillBytes(target: Span![Nat8, R], start: Index, count: Index, value: Nat8): Unit is
        bindFillBytes(target, start, count, value);
        return nil;
    end;

    generic [T: Free, R: Region]
    function fillSpan(target: Span![T, R], start: Index, count: Index, value: T): Unit is
        bindFillElements(target, start, count, value);
        return nil;
    end;

    generic [T: Free, S: Region, R: Region]
    function copySpan(source: Span[T, S], target: Span![T, R], at: Index): Unit is
        bindCopyElements(source, 0, target, at, spanLength(source));
        return nil;
    end;

    generic [T: Free, S: Region, R: Region]
    function copyRange(source: Span[T, S], first: Index, target: Span![T, R], at: Index, count: Index): Unit is
        bindCopyElements(source, first, target, at, count);
        return nil;
    end;
end module body.
