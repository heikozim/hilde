import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    nthByte,
    length,
    fromLiteral,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Buffer (
    Buffer,
    destroyFree,
    length as bufferLength,
    nth as bufferNth
);
import Standard.Text (
    parseInt,
    parseNat,
    parseHex,
    parseDuration,
    indexOfByte,
    substring,
    trim,
    indexOf,
    contains,
    startsWith,
    endsWith,
    countOf,
    split,
    lines,
    isBinary,
    join,
    replace,
    toUpper,
    toLower,
    urlEncode,
    urlDecode,
    bytesToHex,
    hexToBytes,
    formatNat,
    formatInt,
    equal,
    constantTimeEqual
);

module body Standard.Text.Test is
    -- A reading function takes a literal as it stands, with no String made
    -- for it: the empty one, one of a single byte, and a longer one.
    -- a literal passed straight to a reading function.
    function testLiterals(): Unit is
        assertNat(parseNat("42"), 42, "parseNat of 42");
        assertNat(parseNat("7"), 7, "parseNat of one byte");
        assertNoNat(parseNat(""), "parseNat of the empty literal");
        assertIndex(indexOfByte("a", 'a'), 0, "indexOfByte in one byte");
        assertNoIndex(indexOfByte("", 'a'), "indexOfByte in the empty literal");
        assertTrue(constantTimeEqual(trim("  x  "), "x"), "trim of a literal");
        assertTrue(spanLength(trim("")) = 0, "trim of the empty literal");
        assertTrue(constantTimeEqual("", ""), "two empty literals are equal");
        assertTrue(not constantTimeEqual("a", ""), "one byte against none");
        return nil;
    end;

    ---
    --- Parsing
    ---

    -- parseNat.
    function testParseNat(): Unit is
        assertNat(literalParseNat("1234"), 1234, "1234");
        assertNat(literalParseNat("0"), 0, "0");
        -- The largest Nat64 there is, and the first value above it.
        assertNat(literalParseNat("18446744073709551615"),
            18446744073709551615, "the largest Nat64");
        assertNoNat(literalParseNat("18446744073709551616"), "one past it");
        assertNoNat(literalParseNat(""), "the empty string");
        assertNoNat(literalParseNat("12a"), "a digit string with a letter");
        assertNoNat(literalParseNat("-1"), "a minus sign");
        return nil;
    end;

    -- parseHex.
    function testParseHex(): Unit is
        assertNat(literalParseHex("ff"), 255, "ff");
        assertNat(literalParseHex("FF"), 255, "FF");
        assertNat(literalParseHex("00"), 0, "00");
        assertNat(literalParseHex("deadBEEF"), 3735928559, "mixed case");
        assertNoNat(literalParseHex("gg"), "not hexadecimal");
        assertNoNat(literalParseHex(""), "the empty string");
        assertNoNat(literalParseHex("10000000000000000"), "seventeen digits");
        return nil;
    end;

    -- parseDuration.
    function testParseDuration(): Unit is
        assertNat(literalParseDuration("90"), 90, "a bare number is seconds");
        assertNat(literalParseDuration("5m"), 300, "5m");
        assertNat(literalParseDuration("2h"), 7200, "2h");
        assertNat(literalParseDuration("1d"), 86400, "1d");
        assertNoNat(literalParseDuration("m"), "a suffix with no number");
        assertNoNat(literalParseDuration(""), "the empty string");
        assertNoNat(literalParseDuration("5x"), "an unknown suffix");
        assertNoNat(literalParseDuration("999999999999999d"),
            "a product that leaves Nat64");
        return nil;
    end;

    ---
    --- Taking apart
    ---

    -- indexOfByte, substring, trim, toLower.
    function testTakingApart(): Unit is
        let colon: String := fromLiteral("a:b");
        assertIndex(indexOfByte(asSpan(&colon), ':'), 1, "indexOfByte finds it");
        assertNoIndex(indexOfByte(asSpan(&colon), '?'), "indexOfByte misses");
        destroyString(colon);

        let hello: String := fromLiteral("hello");
        assertSpan(substring(asSpan(&hello), 1, 3), "el", "substring 1..3");
        assertSpan(substring(asSpan(&hello), 0, 99), "hello", "substring clamps");
        assertSpan(substring(asSpan(&hello), 3, 1), "", "substring backwards is empty");
        assertSpan(substring(asSpan(&hello), 99, 120), "", "substring past the end is empty");
        destroyString(hello);

        let padded: String := fromLiteral("  ab  ");
        assertSpan(trim(asSpan(&padded)), "ab", "trim");
        destroyString(padded);

        let blank: String := fromLiteral("    ");
        assertSpan(trim(asSpan(&blank)), "", "trim of only spaces");
        destroyString(blank);

        let mixed: String := fromLiteral("AbC-9");
        assertText(toLower(asSpan(&mixed)), "abc-9", "toLower");
        destroyString(mixed);
        return nil;
    end;

    ---
    --- Searching
    ---

    -- indexOf, contains, startsWith, endsWith and countOf, the empty part
    -- among them.
    function testSearching(): Unit is
        assertIndex(indexOf("hello world", "o w"), 4, "indexOf finds a part");
        assertIndex(indexOf("hello", "l"), 2, "indexOf finds the first");
        assertIndex(indexOf("hello", ""), 0, "the empty part is at 0");
        assertNoIndex(indexOf("hello", "hello!"), "a part longer than the text");
        assertNoIndex(indexOf("", "a"), "nothing in the empty text");
        assertTrue(contains("hello", "ell"), "contains");
        assertTrue(not contains("hello", "elo"), "does not contain");
        assertTrue(contains("", ""), "the empty text contains the empty part");
        assertTrue(startsWith("hello", "he"), "startsWith");
        assertTrue(startsWith("hello", ""), "every text starts with nothing");
        assertTrue(not startsWith("he", "hello"), "a prefix longer than the text");
        assertTrue(endsWith("hello", "llo"), "endsWith");
        assertTrue(not endsWith("hello", "hel"), "does not end with");
        assertTrue(not endsWith("lo", "hello"), "a suffix longer than the text");
        assertTrue(countOf("hello world hello", "hello") = 2, "two occurrences");
        assertTrue(countOf("hello", "xyz") = 0, "none");
        assertTrue(countOf("aaaa", "aa") = 2, "counted without overlapping");
        assertTrue(countOf("abc", "") = 0, "the empty part is not counted");
        return nil;
    end;

    -- A text of count bytes a and then one b.
    function runOfA(count: Index): String is
        var builder: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < count do
            writeByte(&!builder, 'a');
            i := i + 1;
        end while;
        writeByte(&!builder, 'b');
        return finalize(builder);
    end;

    -- The search after a mismatch goes on with the part of the pattern
    -- that still matches: a start inside the failed attempt is found.
    function testSearchingAfterAMismatch(): Unit is
        assertIndex(indexOf("abaabab", "abab"), 3, "a start inside the failed attempt");
        assertIndex(indexOf("aabaabaaab", "aabaaab"), 3, "a longer border");
        assertNoIndex(indexOf("abababa", "abababb"), "the last byte differs");
        assertTrue(countOf("abababab", "abab") = 2, "two without overlapping");
        assertTrue(countOf("aaaaa", "aa") = 2, "an odd run");
        let pieces: Buffer[Span[Nat8, Static]] := split("xabababx", "abab");
        assertTrue(bufferLength(&pieces) = 2, "split once");
        assertPiece(&pieces, 0, "x", "before");
        assertPiece(&pieces, 1, "abx", "after, not searched from inside");
        destroyFree(pieces);
        assertText(replace("abaabab", "abab", "-"), "aba-", "replaced after a mismatch");
        let text: String := runOfA(3000);
        let part: String := runOfA(300);
        assertIndex(indexOf(asSpan(&text), asSpan(&part)), 2700, "a long run");
        assertTrue(countOf(asSpan(&text), asSpan(&part)) = 1, "counted once");
        destroyString(part);
        destroyString(text);
        return nil;
    end;

    ---
    --- Splitting and joining
    ---

    function testSplitAndJoin(): Unit is
        let pieces: Buffer[Span[Nat8, Static]] := split("a,b,,c", ",");
        assertTrue(bufferLength(&pieces) = 4, "four pieces");
        assertPiece(&pieces, 0, "a", "the first piece");
        assertPiece(&pieces, 1, "b", "the second piece");
        assertPiece(&pieces, 2, "", "two separators give an empty piece");
        assertPiece(&pieces, 3, "c", "the last piece");
        let joined: String := join(&pieces, " + ");
        assertTrue(constantTimeEqual(asSpan(&joined), "a + b +  + c"), "joined again");
        destroyString(joined);
        destroyFree(pieces);
        let ends: Buffer[Span[Nat8, Static]] := split(",x,", ",");
        assertTrue(bufferLength(&ends) = 3, "a separator at either end");
        assertPiece(&ends, 0, "", "empty before");
        assertPiece(&ends, 2, "", "empty after");
        destroyFree(ends);
        let longer: Buffer[Span[Nat8, Static]] := split("one::two", "::");
        assertTrue(bufferLength(&longer) = 2, "a separator of two bytes");
        assertPiece(&longer, 1, "two", "after the separator");
        destroyFree(longer);
        let none: Buffer[Span[Nat8, Static]] := split("", ",");
        assertTrue(bufferLength(&none) = 1, "the empty text is one piece");
        assertPiece(&none, 0, "", "and it is empty");
        let nothing: String := join(&none, ",");
        assertTrue(length(&nothing) = 0, "one empty piece joins to nothing");
        destroyString(nothing);
        destroyFree(none);
        let whole: Buffer[Span[Nat8, Static]] := split("a,b", "");
        assertTrue(bufferLength(&whole) = 1, "an empty separator gives the text whole");
        assertPiece(&whole, 0, "a,b", "whole");
        destroyFree(whole);
        return nil;
    end;

    -- Reading lines, and the ends around them.
    function testLines(): Unit is
        let three: Buffer[Span[Nat8, Static]] := lines("line1\nline2\nline3");
        assertTrue(bufferLength(&three) = 3, "a last line without its line feed counts");
        assertPiece(&three, 2, "line3", "the last line");
        destroyFree(three);
        let crlf: Buffer[Span[Nat8, Static]] := lines("line1\r\nline2\r\n");
        assertTrue(bufferLength(&crlf) = 2, "a final line feed starts no line");
        assertPiece(&crlf, 0, "line1", "no carriage return in the first line");
        assertPiece(&crlf, 1, "line2", "nor in the second");
        destroyFree(crlf);
        let none: Buffer[Span[Nat8, Static]] := lines("");
        assertTrue(bufferLength(&none) = 0, "the empty text has no lines");
        destroyFree(none);
        let blank: Buffer[Span[Nat8, Static]] := lines("a\n\nb");
        assertTrue(bufferLength(&blank) = 3, "an empty line in the middle");
        assertPiece(&blank, 1, "", "is empty");
        destroyFree(blank);
        let lone: Buffer[Span[Nat8, Static]] := lines("\n");
        assertTrue(bufferLength(&lone) = 1, "a line feed alone is one empty line");
        destroyFree(lone);
        let inner: Buffer[Span[Nat8, Static]] := lines("a\rb\n");
        assertTrue(bufferLength(&inner) = 1, "a carriage return inside a line");
        assertPiece(&inner, 0, "a\rb", "stays");
        destroyFree(inner);
        return nil;
    end;

    -- Binary files, with the window's edge.
    function testIsBinary(): Unit is
        assertTrue(not isBinary("hello world\n"), "text is not binary");
        assertTrue(not isBinary(""), "the empty text is not binary");
        let zero: String := withZeroAt(5);
        assertTrue(isBinary(asSpan(&zero)), "a zero byte makes it binary");
        destroyString(zero);
        let last: String := withZeroAt(511);
        assertTrue(isBinary(asSpan(&last)), "a zero byte at 511 is inside the window");
        destroyString(last);
        let past: String := withZeroAt(512);
        assertTrue(not isBinary(asSpan(&past)), "a zero byte at 512 is past it");
        destroyString(past);
        return nil;
    end;

    -- at bytes of a, a zero byte, and one more a.
    function withZeroAt(at: Index): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < at do
            writeByte(&!out, 'a');
            i := i + 1;
        end while;
        let zero: Nat8 := 0;
        writeByte(&!out, zero);
        writeByte(&!out, 'a');
        return finalize(out);
    end;

    ---
    --- Building
    ---

    -- Search and replace, and what a replacement does with what
    -- it wrote.
    function testReplace(): Unit is
        assertText(replace("hello world hello", "hello", "hi"), "hi world hi", "two replaced");
        assertText(replace("hello", "xyz", "abc"), "hello", "nothing to replace");
        assertText(replace("aaa", "aa", "b"), "ba", "found from the start without overlapping");
        assertText(replace("aaaa", "aa", "a"), "aa", "what was written is not searched again");
        assertText(replace("abc", "", "x"), "abc", "an empty old replaces nothing");
        assertText(replace("a.b.c", ".", ""), "abc", "replaced by nothing");
        assertText(toUpper("AbC-9 z"), "ABC-9 Z", "toUpper");
        return nil;
    end;

    -- parseInt at its edges, with the sign.
    function testParseInt(): Unit is
        assertInt(parseInt("42"), 42, "a positive number");
        assertInt(parseInt("-5"), -5, "a negative number");
        assertInt(parseInt("0"), 0, "zero");
        assertInt(parseInt("-0"), 0, "minus zero is zero");
        assertInt(parseInt("9223372036854775807"), maximum_int64, "the largest Int64");
        assertInt(parseInt("-9223372036854775808"), minimum_int64, "the smallest Int64");
        assertNoInt(parseInt("9223372036854775808"), "one past the largest");
        assertNoInt(parseInt("-9223372036854775809"), "one past the smallest");
        assertNoInt(parseInt(""), "the empty text");
        assertNoInt(parseInt("-"), "a sign alone");
        assertNoInt(parseInt("+5"), "a plus sign is not read");
        assertNoInt(parseInt("--1"), "two signs");
        assertNoInt(parseInt("4-2"), "a sign inside");
        assertNoInt(parseInt(" 1"), "a space");
        return nil;
    end;

    ---
    --- Encoding
    ---

    -- urlEncode, urlDecode, bytesToHex.
    function testEncoding(): Unit is
        let spaced: String := fromLiteral("a b");
        assertText(urlEncode(asSpan(&spaced)), "a%20b", "urlEncode a space");
        destroyString(spaced);

        let plain: String := fromLiteral("abcXYZ019");
        assertText(urlEncode(asSpan(&plain)), "abcXYZ019", "urlEncode leaves letters");
        destroyString(plain);

        let encoded: String := fromLiteral("a%20b");
        assertText(urlDecode(asSpan(&encoded)), "a b", "urlDecode");
        destroyString(encoded);

        -- A % that is not an escape is kept, byte for byte.
        let broken: String := fromLiteral("a%zzb");
        assertText(urlDecode(asSpan(&broken)), "a%zzb", "urlDecode keeps a bad escape");
        destroyString(broken);

        let trailing: String := fromLiteral("ab%");
        assertText(urlDecode(asSpan(&trailing)), "ab%", "urlDecode keeps a trailing %");
        destroyString(trailing);

        -- Encode then decode is the identity, which is the property that
        -- matters and the one a single direction cannot show.
        let awkward: String := fromLiteral("a b&c=d?e#f");
        let there: String := urlEncode(asSpan(&awkward));
        assertText(urlDecodeOf(&there), "a b&c=d?e#f", "encode then decode");
        destroyString(there);
        destroyString(awkward);

        let ab: String := fromLiteral("AB");
        assertText(bytesToHex(asSpan(&ab)), "4142", "bytesToHex");
        destroyString(ab);
        return nil;
    end;

    -- hexToBytes, and the way there and back with bytesToHex.
    function testHexToBytes(): Unit is
        assertHexBytes("4142", "AB", "hexToBytes of 4142");
        assertHexBytes("", "", "hexToBytes of the empty text");
        case hexToBytes("00fF") of
            when Some(value as bytes: String) do
                assertTrue(length(&bytes) = 2, "00fF gives two bytes");
                assertTrue(nthByte(&bytes, 0) = 0, "the first is 0");
                assertTrue(nthByte(&bytes, 1) = 255, "the second is 255, read in either case");
                destroyString(bytes);
            when None do
                assertTrue(false, "00fF decodes");
        end case;
        let digest: String := fromLiteral("any bytes at all");
        let hex: String := bytesToHex(asSpan(&digest));
        case hexToBytes(asSpan(&hex)) of
            when Some(value as back: String) do
                assertTrue(constantTimeEqual(asSpan(&back), asSpan(&digest)), "bytesToHex then hexToBytes gives the bytes back");
                destroyString(back);
            when None do
                assertTrue(false, "the text bytesToHex made decodes");
        end case;
        destroyString(hex);
        destroyString(digest);
        assertNoHexBytes("414", "an odd number of digits is refused");
        assertNoHexBytes("4g", "a byte that is not a digit is refused");
        assertNoHexBytes("0x41", "a 0x in front is refused");
        assertNoHexBytes("41 42", "a space between is refused");
        return nil;
    end;

    function assertHexBytes(text: Span[Nat8, Static], expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case hexToBytes(text) of
            when Some(value as bytes: String) do
                assertTrue(constantTimeEqual(asSpan(&bytes), expected), message);
                destroyString(bytes);
            when None do
                assertTrue(false, message);
        end case;
        return nil;
    end;

    function assertNoHexBytes(text: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case hexToBytes(text) of
            when Some(value as bytes: String) do
                destroyString(bytes);
                assertTrue(false, message);
            when None do
                assertTrue(true, message);
        end case;
        return nil;
    end;

    ---
    --- Integers as decimal text
    ---

    -- formatNat at the edges, and parseNat reads every one back.
    function natIs(value: Nat64, expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        let text: String := formatNat(value);
        assertTrue(equal(asSpan(&text), expected), message);
        case parseNat(asSpan(&text)) of
            when Some(value as back: Nat64) do
                assertTrue(back = value, "parseNat reads it back");
            when None do
                assertFailure("parseNat refused it");
        end case;
        destroyString(text);
        return nil;
    end;

    function intIs(value: Int64, expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        let text: String := formatInt(value);
        assertTrue(equal(asSpan(&text), expected), message);
        case parseInt(asSpan(&text)) of
            when Some(value as back: Int64) do
                assertTrue(back = value, "parseInt reads it back");
            when None do
                assertFailure("parseInt refused it");
        end case;
        destroyString(text);
        return nil;
    end;

    function testFormatNat(): Unit is
        natIs(0, "0", "zero");
        natIs(9, "9", "nine");
        natIs(10, "10", "ten");
        natIs(12345, "12345", "five digits");
        natIs(18446744073709551615, "18446744073709551615", "the largest Nat64");
        return nil;
    end;

    function testFormatInt(): Unit is
        intIs(0, "0", "zero");
        intIs(-1, "-1", "minus one");
        intIs(42, "42", "forty-two");
        intIs(-42, "-42", "minus forty-two");
        intIs(maximum_int64, "9223372036854775807", "the largest Int64");
        intIs(minimum_int64, "-9223372036854775808", "the smallest Int64");
        return nil;
    end;

    ---
    --- Comparison
    ---

    -- equal: the same bytes, a byte that differs at the start, in the
    -- middle and at the end, a prefix either way, and the empty span.
    function testEqual(): Unit is
        let text: String := fromLiteral("session-token");
        assertTrue(equal(asSpan(&text), "session-token"), "the same bytes");
        assertTrue(not equal(asSpan(&text), "Session-token"), "the first byte differs");
        assertTrue(not equal(asSpan(&text), "session_token"), "a middle byte differs");
        assertTrue(not equal(asSpan(&text), "session-tokem"), "the last byte differs");
        assertTrue(not equal(asSpan(&text), "session"), "a prefix of the left");
        assertTrue(not equal("session", asSpan(&text)), "a prefix of the right");
        assertTrue(not equal(asSpan(&text), ""), "against the empty span");
        assertTrue(equal("", ""), "two empty spans");
        destroyString(text);
        return nil;
    end;

    -- constantTimeEqual.
    function testConstantTimeEqual(): Unit is
        let secret: String := fromLiteral("s3cr3t-token");
        let same: String := fromLiteral("s3cr3t-token");
        let otherSameLength: String := fromLiteral("s3cr3t-toker");
        let shorter: String := fromLiteral("s3cr3t");
        let empty: String := fromLiteral("");
        let alsoEmpty: String := fromLiteral("");

        assertTrue(constantTimeEqual(asSpan(&secret), asSpan(&same)), "equal");
        assertTrue(not constantTimeEqual(asSpan(&secret), asSpan(&otherSameLength)),
            "one byte differs");
        assertTrue(not constantTimeEqual(asSpan(&secret), asSpan(&shorter)),
            "a prefix is not equal");
        assertTrue(not constantTimeEqual(asSpan(&shorter), asSpan(&secret)),
            "and the other way round");
        assertTrue(constantTimeEqual(asSpan(&empty), asSpan(&alsoEmpty)), "both empty");
        assertTrue(not constantTimeEqual(asSpan(&secret), asSpan(&empty)), "one empty");
        assertTrue(not constantTimeEqual(asSpan(&empty), asSpan(&secret)), "the other empty");

        destroyString(secret);
        destroyString(same);
        destroyString(otherSameLength);
        destroyString(shorter);
        destroyString(empty);
        destroyString(alsoEmpty);
        return nil;
    end;

    ---
    --- Utilities
    ---

    function literalParseNat(text: Span[Nat8, Static]): Option[Nat64] is
        let string: String := fromLiteral(text);
        let answer: Option[Nat64] := parseNat(asSpan(&string));
        destroyString(string);
        return answer;
    end;

    function literalParseHex(text: Span[Nat8, Static]): Option[Nat64] is
        let string: String := fromLiteral(text);
        let answer: Option[Nat64] := parseHex(asSpan(&string));
        destroyString(string);
        return answer;
    end;

    function literalParseDuration(text: Span[Nat8, Static]): Option[Nat64] is
        let string: String := fromLiteral(text);
        let answer: Option[Nat64] := parseDuration(asSpan(&string));
        destroyString(string);
        return answer;
    end;

    generic [R: Region]
    function urlDecodeOf(string: &[String, R]): String is
        return urlDecode(asSpan(string));
    end;

    function assertNat(got: Option[Nat64], want: Nat64,
        message: Span[Nat8, Static]): Unit is
        case got of
            when Some(value: Nat64) do
                assertTrue(value = want, message);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function assertNoNat(got: Option[Nat64], message: Span[Nat8, Static]): Unit is
        case got of
            when Some(value: Nat64) do
                assertFailure(message);
            when None do
                assertSuccess(message);
        end case;
        return nil;
    end;

    function assertIndex(got: Option[Index], want: Index,
        message: Span[Nat8, Static]): Unit is
        case got of
            when Some(value: Index) do
                assertTrue(value = want, message);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function assertNoIndex(got: Option[Index], message: Span[Nat8, Static]): Unit is
        case got of
            when Some(value: Index) do
                assertFailure(message);
            when None do
                assertSuccess(message);
        end case;
        return nil;
    end;

    generic [R: Region, S: Region]
    function sameBytes(left: &[String, R], right: &[String, S]): Bool is
        let size: Index := length(left);
        if size /= length(right) then
            return false;
        end if;
        var i: Index := 0;
        var same: Bool := true;
        while i < size do
            if nthByte(left, i) /= nthByte(right, i) then
                same := false;
            end if;
            i := i + 1;
        end while;
        return same;
    end;

    function assertText(produced: String, expected: Span[Nat8, Static],
        message: Span[Nat8, Static]): Unit is
        var made: String := produced;
        let want: String := fromLiteral(expected);
        assertTrue(sameBytes(&made, &want), message);
        destroyString(want);
        destroyString(made);
        return nil;
    end;

    function assertInt(got: Option[Int64], want: Int64, message: Span[Nat8, Static]): Unit is
        case got of
            when Some(value: Int64) do
                assertTrue(value = want, message);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function assertNoInt(got: Option[Int64], message: Span[Nat8, Static]): Unit is
        case got of
            when Some(value: Int64) do
                assertFailure(message);
            when None do
                assertSuccess(message);
        end case;
        return nil;
    end;

    generic [R: Region, S: Region]
    function assertSpan(got: Span[Nat8, R], expected: Span[Nat8, S], message: Span[Nat8, Static]): Unit is
        assertTrue(constantTimeEqual(got, expected), message);
        return nil;
    end;

    generic [R: Region, P: Region]
    function assertPiece(pieces: &[Buffer[Span[Nat8, R]], P], n: Index, expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        if n >= bufferLength(pieces) then
            assertFailure(message);
        else
            assertSpan(bufferNth(pieces, n), expected, message);
        end if;
        return nil;
    end;
end module body.
