--
-- Tests for the filters and operators of Standard.Template that the
-- compiler calls for @template.  Each expected text is what Jinja2 3.1.6
-- renders for the same filter on the same text, before the escaping that
-- the generated code does afterwards.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeLast,
    destroyEmpty,
    length
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as textLength,
    nthByte,
    asSpan
);
import Standard.Testing (
    assertTrue
);
import Standard.Template (
    capitalize,
    title,
    replaceText,
    truncate,
    center,
    joinDisplayed,
    concat,
    holds,
    displayValue
);

module body Standard.Template.Test is
    -- Whether text is expected; the text is used up.
    function equalsText(text: String, expected: Span[Nat8, Static]): Bool is
        let size: Index := spanLength(expected);
        var same: Bool := textLength(&text) = size;
        var i: Index := 0;
        while same and (i < size) do
            if nthByte(&text, i) /= expected[i] then
                same := false;
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        return same;
    end;

    function sentence(): String is
        return fromLiteral("The quick brown fox jumps over the lazy dog");
    end;

    function testCase(): Unit is
        assertTrue(equalsText(capitalize(fromLiteral("hello world")), "Hello world"), "capitalize");
        assertTrue(equalsText(capitalize(fromLiteral("ABC dEF")), "Abc def"), "capitalize lowers the rest");
        assertTrue(equalsText(title(fromLiteral("hello world")), "Hello World"), "title");
        assertTrue(equalsText(title(fromLiteral("x-y z(w")), "X-Y Z(W"), "title after a hyphen and a bracket");
        return nil;
    end;

    function testReplace(): Unit is
        let two: Index := 2;
        let none: Index := 0;
        assertTrue(equalsText(replaceText(fromLiteral("hello world"), "o", "0", false, none), "hell0 w0rld"), "replace every o");
        assertTrue(equalsText(replaceText(fromLiteral("hello world"), "l", "L", true, two), "heLLo world"), "replace the first two");
        assertTrue(equalsText(replaceText(fromLiteral("aaa"), "aa", "b", false, none), "ba"), "replace from the left, without overlap");
        return nil;
    end;

    function testTruncate(): Unit is
        let twenty: Index := 20;
        let forty: Index := 40;
        let fortyThree: Index := 43;
        let ten: Index := 10;
        let five: Index := 5;
        let none: Index := 0;
        assertTrue(equalsText(truncate(sentence(), twenty, false, "...", five), "The quick brown..."), "truncate at a space");
        assertTrue(equalsText(truncate(sentence(), twenty, true, "...", five), "The quick brown f..."), "truncate a word");
        assertTrue(equalsText(truncate(sentence(), twenty, false, "..", five), "The quick brown.."), "truncate with another ending");
        assertTrue(equalsText(truncate(sentence(), forty, false, "...", five), "The quick brown fox jumps over the lazy dog"), "within the leeway");
        assertTrue(equalsText(truncate(sentence(), fortyThree, false, "...", five), "The quick brown fox jumps over the lazy dog"), "as long as the text");
        assertTrue(equalsText(truncate(sentence(), ten, false, "...", none), "The..."), "no leeway");
        return nil;
    end;

    function testCenter(): Unit is
        let fifteen: Index := 15;
        let four: Index := 4;
        let five: Index := 5;
        assertTrue(equalsText(center(fromLiteral("hello world"), fifteen), "  hello world  "), "center");
        assertTrue(equalsText(center(fromLiteral("hello world"), four), "hello world"), "center, narrower than the text");
        assertTrue(equalsText(center(fromLiteral("ab"), five), "  ab "), "center, the odd space on the left");
        return nil;
    end;

    function testJoinAndConcat(): Unit is
        var items: Buffer[String] := allocateEmpty();
        insertBack(&!items, fromLiteral("a"));
        insertBack(&!items, fromLiteral("b<"));
        insertBack(&!items, fromLiteral("c"));
        assertTrue(equalsText(joinDisplayed(&items, ", "), "a, b<, c"), "join with a separator");
        assertTrue(equalsText(joinDisplayed(&items, ""), "ab<c"), "join without one");
        assertTrue(holds(&items, "b<"), "the buffer holds b<");
        assertTrue(not holds(&items, "b"), "and not b alone");
        while length(&items) > 0 do
            destroyString(removeLast(&!items));
        end while;
        destroyEmpty(items);
        assertTrue(equalsText(concat(fromLiteral("a"), fromLiteral("7")), "a7"), "concat");
        let word: String := fromLiteral("hello world");
        assertTrue(holds(&word, "ll"), "ll stands in hello world");
        assertTrue(not holds(&word, "zz"), "zz does not");
        assertTrue(holds(&word, ""), "the empty text stands in every string");
        destroyString(word);
        let seven: Int32 := -7;
        assertTrue(equalsText(displayValue(seven), "-7"), "a computed number");
        return nil;
    end;
end module body.
