import Standard.Testing (
    assertTrue
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Text (
    constantTimeEqual,
    contains
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree
);
import Standard.Svg (
    Builder,
    LineChart,
    Step,
    Frame,
    makeBuilder,
    render,
    elementDepth,
    escapeText,
    escapeAttribute,
    beginSvg,
    endSvg,
    beginElement,
    endElement,
    attribute,
    rect,
    textAt,
    tickStep,
    stepValue,
    firstTick,
    lastTick,
    formatTick,
    mapX,
    mapY,
    pixelX,
    pixelY,
    makeLineChart,
    destroyLineChart,
    seriesCount,
    addSeries,
    renderLineChart
);

module body Standard.Svg.Test is
    -- Compares the document with the expected bytes and frees it.
    function sameAs(made: String, expected: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        assertTrue(constantTimeEqual(asSpan(&made), expected), message);
        destroyString(made);
        return nil;
    end;

    function testEscape(): Unit is
        sameAs(escapeText("a<b>&\"c\"'d"), "a&lt;b&gt;&amp;&quot;c&quot;&#39;d",
            "the five characters escaped in text");
        sameAs(escapeAttribute("\"&'<>\""), "&quot;&amp;&#39;&lt;&gt;&quot;",
            "the five characters escaped in a value");
        sameAs(escapeText("nothing to do"), "nothing to do",
            "text without a special byte stays as it stands");
        sameAs(escapeText(""), "", "the empty text stays empty");
        return nil;
    end;

    function testBuilderGolden(): Unit is
        var b: Builder := makeBuilder();
        assertTrue(elementDepth(&b) = 0, "a new builder has no element open");
        beginSvg(&!b, 200, 100);
        assertTrue(elementDepth(&b) = 1, "the root element is open");
        attribute(&!b, "class", "chart");
        rect(&!b, 0, 0, 10, 20);
        textAt(&!b, 5, 6, "a<b>&\"c\"");
        beginElement(&!b, "g");
        assertTrue(elementDepth(&b) = 2, "the group is open inside the root");
        endElement(&!b);
        assertTrue(elementDepth(&b) = 1, "the group is closed");
        endSvg(&!b);
        assertTrue(elementDepth(&b) = 0, "the document is finished");
        sameAs(render(b),
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"100\" viewBox=\"0 0 200 100\" class=\"chart\"><rect x=\"0\" y=\"0\" width=\"10\" height=\"20\" /><text x=\"5\" y=\"6\">a&lt;b&gt;&amp;&quot;c&quot;</text><g /></svg>",
            "the document holds the elements in the order of the calls");
        return nil;
    end;

    function testEmptyElementForm(): Unit is
        var b: Builder := makeBuilder();
        beginSvg(&!b, 10, 10);
        endSvg(&!b);
        sameAs(render(b),
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"10\" height=\"10\" viewBox=\"0 0 10 10\" />",
            "a root with nothing in it is an empty element");
        return nil;
    end;

    function testTickMaths(): Unit is
        let small: Step := tickStep(0, 5);
        assertTrue((small.multiple = 1) and (small.exponent = 0), "0 to 5 goes in steps of 1");
        assertTrue(stepValue(small) = 1, "the step of 1 is worth 1");
        let tens: Step := tickStep(0, 10);
        assertTrue((tens.multiple = 2) and (tens.exponent = 0), "0 to 10 goes in steps of 2");
        let hundreds: Step := tickStep(0, 100);
        assertTrue((hundreds.multiple = 2) and (hundreds.exponent = 1), "0 to 100 goes in steps of 20");
        assertTrue(stepValue(hundreds) = 20, "the step of 20 is worth 20");
        let thousands: Step := tickStep(0, 1000);
        assertTrue(stepValue(thousands) = 200, "0 to 1000 goes in steps of 200");
        let fives: Step := tickStep(0, 40);
        assertTrue((fives.multiple = 5) and (fives.exponent = 0), "0 to 40 goes in steps of 5");
        let ones: Step := tickStep(0, 7);
        assertTrue((ones.multiple = 1) and (ones.exponent = 0), "0 to 7 goes in steps of 1");
        assertTrue(firstTick(3, tens) = 4, "the first tick at or after 3 in steps of 2 is 4");
        assertTrue(firstTick(4, tens) = 4, "a value on a tick is its own first tick");
        assertTrue(lastTick(9, tens) = 8, "the last tick at or before 9 in steps of 2 is 8");
        assertTrue(lastTick(8, tens) = 8, "a value on a tick is its own last tick");
        assertTrue(firstTick(-3, tens) = -2, "the first tick at or after -3 in steps of 2 is -2");
        assertTrue(lastTick(-9, tens) = -10, "the last tick at or before -9 in steps of 2 is -10");
        sameAs(formatTick(42), "42", "a tick is written in plain decimal");
        sameAs(formatTick(-7), "-7", "a negative tick carries its minus sign");
        assertTrue(mapX(5, 0, 10, 0, 100) = 50, "the middle of the data is the middle of the pixels");
        assertTrue(mapX(0, 0, 10, 0, 100) = 0, "the low end of the data is the low end of the pixels");
        assertTrue(mapX(10, 0, 10, 0, 100) = 100, "the high end of the data is the high end of the pixels");
        assertTrue(mapY(0, 0, 10, 0, 100) = 100, "the low end of the data is at the bottom");
        assertTrue(mapY(10, 0, 10, 0, 100) = 0, "the high end of the data is at the top");
        assertTrue(mapY(5, 0, 10, 0, 100) = 50, "the middle of the data is in the middle");
        let frame: Frame := Frame(left => 60, top => 30, width => 120, height => 30,
            xLow => 0, xHigh => 10, yLow => 0, yHigh => 10);
        assertTrue(pixelX(frame, 0) = 60, "the left edge of the data is at the left of the plot");
        assertTrue(pixelX(frame, 10) = 180, "the right edge of the data is at the right of the plot");
        assertTrue(pixelY(frame, 0) = 60, "the bottom of the data is at the bottom of the plot");
        assertTrue(pixelY(frame, 10) = 30, "the top of the data is at the top of the plot");
        return nil;
    end;

    -- A chart of 200 by 100 with one series through 0,0 and 10,10, over a
    -- plot from 60,30 to 180,60, in steps of 2 on both axes.
    function testChartGolden(): Unit is
        var chart: LineChart := makeLineChart(200, 100, "", "", "");
        assertTrue(seriesCount(&chart) = 0, "a new chart holds no series");
        var xs: Buffer[Int64] := allocateEmpty();
        var ys: Buffer[Int64] := allocateEmpty();
        insertBack(&!xs, 0);
        insertBack(&!xs, 10);
        insertBack(&!ys, 0);
        insertBack(&!ys, 10);
        addSeries(&!chart, &xs, &ys, "s1");
        assertTrue(seriesCount(&chart) = 1, "the series is in the chart");
        sameAs(renderLineChart(&chart),
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"100\" viewBox=\"0 0 200 100\" class=\"svg-chart\"><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"60\" y1=\"60\" x2=\"180\" y2=\"60\" /><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"60\" y=\"78\">0</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"84\" y1=\"60\" x2=\"84\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"84\" y=\"78\">2</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"108\" y1=\"60\" x2=\"108\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"108\" y=\"78\">4</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"132\" y1=\"60\" x2=\"132\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"132\" y=\"78\">6</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"156\" y1=\"60\" x2=\"156\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"156\" y=\"78\">8</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"180\" y1=\"60\" x2=\"180\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"180\" y=\"78\">10</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"60\" y1=\"30\" x2=\"60\" y2=\"60\" /><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"60\" x2=\"55\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"64\">0</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"54\" x2=\"55\" y2=\"59\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"58\">2</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"48\" x2=\"55\" y2=\"53\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"52\">4</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"42\" x2=\"55\" y2=\"47\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"46\">6</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"36\" x2=\"55\" y2=\"41\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"40\">8</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"30\" x2=\"55\" y2=\"35\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"34\">10</text><polyline class=\"s1\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" points=\"60,60 180,30\" /></svg>",
            "the chart is the same bytes on every run");
        destroyLineChart(chart);
        destroyFree(xs);
        destroyFree(ys);
        return nil;
    end;

    function testEmptyAndSinglePointSeries(): Unit is
        var xs: Buffer[Int64] := allocateEmpty();
        var ys: Buffer[Int64] := allocateEmpty();
        var chart: LineChart := makeLineChart(200, 100, "", "", "");
        addSeries(&!chart, &xs, &ys, "empty");
        assertTrue(seriesCount(&chart) = 1, "an empty series is counted");
        let bare: String := renderLineChart(&chart);
        assertTrue(not contains(asSpan(&bare), "<polyline"), "an empty series draws no polyline");
        assertTrue(not contains(asSpan(&bare), "<circle"), "an empty series draws no circle");
        destroyString(bare);
        destroyLineChart(chart);
        insertBack(&!xs, 5);
        insertBack(&!ys, 5);
        var one: LineChart := makeLineChart(200, 100, "", "", "");
        addSeries(&!one, &xs, &ys, "pt");
        let single: String := renderLineChart(&one);
        assertTrue(contains(asSpan(&single),
            "<circle class=\"pt\" cx=\"120\" cy=\"45\" r=\"3\" fill=\"currentColor\" />"),
            "a single point is a circle at its place");
        assertTrue(not contains(asSpan(&single), "<polyline"), "a single point draws no polyline");
        destroyString(single);
        destroyLineChart(one);
        destroyFree(xs);
        destroyFree(ys);
        return nil;
    end;

    function testChartTexts(): Unit is
        var chart: LineChart := makeLineChart(200, 100, "T&", "days", "count");
        var xs: Buffer[Int64] := allocateEmpty();
        var ys: Buffer[Int64] := allocateEmpty();
        insertBack(&!xs, 0);
        insertBack(&!ys, 0);
        addSeries(&!chart, &xs, &ys, "");
        let made: String := renderLineChart(&chart);
        assertTrue(contains(asSpan(&made), "<title>T&amp;</title>"), "the title is escaped");
        assertTrue(contains(asSpan(&made), "<text class=\"svg-title\""), "the title carries its class");
        assertTrue(contains(asSpan(&made), ">days</text>"), "the label of x stands below the axis");
        assertTrue(contains(asSpan(&made), "transform=\"translate(14 "), "the label of y stands on its side");
        assertTrue(contains(asSpan(&made), ">count</text>"), "the label of y is escaped and drawn");
        assertTrue(not contains(asSpan(&made), "class=\"\""), "an empty class draws no class");
        destroyString(made);
        destroyLineChart(chart);
        destroyFree(xs);
        destroyFree(ys);
        return nil;
    end;

    function testEmptyChartGolden(): Unit is
        var chart: LineChart := makeLineChart(200, 100, "", "", "");
        sameAs(renderLineChart(&chart),
            "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"200\" height=\"100\" viewBox=\"0 0 200 100\" class=\"svg-chart\"><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"60\" y1=\"60\" x2=\"180\" y2=\"60\" /><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"60\" y1=\"60\" x2=\"60\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"60\" y=\"78\">0</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"180\" y1=\"60\" x2=\"180\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"middle\" x=\"180\" y=\"78\">1</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"60\" y1=\"30\" x2=\"60\" y2=\"60\" /><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"60\" x2=\"55\" y2=\"65\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"64\">0</text><line class=\"svg-axis\" stroke=\"currentColor\" x1=\"55\" y1=\"30\" x2=\"55\" y2=\"35\" /><text class=\"svg-tick\" text-anchor=\"end\" x=\"52\" y=\"34\">1</text></svg>",
            "a chart without points is drawn over 0 to 1");
        destroyLineChart(chart);
        return nil;
    end;

    -- The scale helpers take the whole range of Int64: a difference that
    -- does not fit is held at an end of the type, not stopped.
    function testExtremeRangeHolds(): Unit is
        let step: Step := tickStep(-9223372036854775808, 9223372036854775807);
        assertTrue(stepValue(step) > 0, "a step over the whole range is positive");
        assertTrue(firstTick(-9223372036854775808, step) >= -9223372036854775808,
            "the first tick of the whole range lies at or after its low end");
        assertTrue(lastTick(9223372036854775807, step) <= 9223372036854775807,
            "the last tick of the whole range lies at or before its high end");
        assertTrue(mapX(-9223372036854775808, -9223372036854775808, 9223372036854775807, 0, 100) = 0,
            "the low end of the whole range maps to the first pixel");
        assertTrue(mapX(9223372036854775807, -9223372036854775808, 9223372036854775807, 0, 100) = 100,
            "the high end of the whole range maps to the last pixel");
        assertTrue(mapY(0, -9223372036854775808, 9223372036854775807, 0, 100) = 50,
            "the middle of the whole range maps to the middle pixel");
        assertTrue(mapX(4000000000000000000, 0, 5000000000000000000, 0, 100) = 80,
            "a product past Int64 in the middle of a range maps to its place");
        assertTrue(mapY(4000000000000000000, 0, 5000000000000000000, 0, 100) = 20,
            "a product past Int64 in the middle of a range maps to its place on y");
        let far: Step := Step(multiple => 5, exponent => 1000);
        assertTrue(stepValue(far) > 0, "a step of a far power of ten stays positive");
        assertTrue(firstTick(-9223372036854775808, far) >= -9223372036854775808,
            "the first tick of a far step stays at or above its low end");
        return nil;
    end;

    -- A chart over the whole range of Int64 and a chart of one point at
    -- an end of it are drawn, not stopped.
    function testChartOverExtremeValues(): Unit is
        var xs: Buffer[Int64] := allocateEmpty();
        var ys: Buffer[Int64] := allocateEmpty();
        insertBack(&!xs, -9223372036854775808);
        insertBack(&!ys, -9223372036854775808);
        insertBack(&!xs, 9223372036854775807);
        insertBack(&!ys, 9223372036854775807);
        var chart: LineChart := makeLineChart(200, 100, "", "", "");
        addSeries(&!chart, &xs, &ys, "all");
        let made: String := renderLineChart(&chart);
        assertTrue(contains(asSpan(&made), "<polyline class=\"all\""),
            "the series over the whole range is drawn");
        destroyString(made);
        destroyLineChart(chart);
        var px: Buffer[Int64] := allocateEmpty();
        var py: Buffer[Int64] := allocateEmpty();
        insertBack(&!px, 9223372036854775807);
        insertBack(&!py, 9223372036854775807);
        var one: LineChart := makeLineChart(200, 100, "", "", "");
        addSeries(&!one, &px, &py, "");
        let single: String := renderLineChart(&one);
        assertTrue(contains(asSpan(&single), "<circle"),
            "a chart of one point at the top of Int64 is drawn");
        destroyString(single);
        destroyLineChart(one);
        destroyFree(px);
        destroyFree(py);
        var mx: Buffer[Int64] := allocateEmpty();
        var my: Buffer[Int64] := allocateEmpty();
        insertBack(&!mx, 9223372036854775807);
        insertBack(&!my, 0);
        insertBack(&!mx, -9223372036854775808);
        insertBack(&!my, 1);
        var mixed: LineChart := makeLineChart(200, 100, "", "", "");
        addSeries(&!mixed, &mx, &my, "mix");
        let drawn: String := renderLineChart(&mixed);
        assertTrue(contains(asSpan(&drawn), "<polyline class=\"mix\""),
            "a series from the top of Int64 down to its bottom is drawn");
        destroyString(drawn);
        destroyLineChart(mixed);
        destroyFree(mx);
        destroyFree(my);
        destroyFree(xs);
        destroyFree(ys);
        return nil;
    end;

    -- A range from the bottom of Int64 to nought is wider than Int64
    -- itself, though its high end is nought: it is brought down a bit,
    -- not overflowed.
    function testRangeFromMinimumToZero(): Unit is
        assertTrue(mapX(-9223372036854775808, -9223372036854775808, 0, 0, 100) = 0,
            "the bottom of Int64 maps to the first pixel when the range ends at nought");
        assertTrue(mapX(0, -9223372036854775808, 0, 0, 100) = 100,
            "nought maps to the last pixel when the range starts at the bottom of Int64");
        assertTrue(mapY(-9223372036854775808, -9223372036854775808, 0, 0, 100) = 100,
            "the bottom of Int64 is at the bottom of the pixels when the range ends at nought");
        assertTrue(mapY(0, -9223372036854775808, 0, 0, 100) = 0,
            "nought is at the top of the pixels when the range starts at the bottom of Int64");
        var xs: Buffer[Int64] := allocateEmpty();
        var ys: Buffer[Int64] := allocateEmpty();
        insertBack(&!xs, -9223372036854775808);
        insertBack(&!ys, 0);
        insertBack(&!xs, 0);
        insertBack(&!ys, 100);
        var chart: LineChart := makeLineChart(200, 100, "", "", "");
        addSeries(&!chart, &xs, &ys, "half");
        let made: String := renderLineChart(&chart);
        assertTrue(contains(asSpan(&made), "<polyline class=\"half\""),
            "a series from the bottom of Int64 to nought is drawn");
        destroyString(made);
        destroyLineChart(chart);
        destroyFree(xs);
        destroyFree(ys);
        return nil;
    end;
end module body.
