"""
XML 1.0 read into tokens, without a document type, and text escaped for it.

- A document must be well formed and valid UTF-8; nothing is repaired.
- Each element gives a start, with its attributes, and an end, an empty one too; text is a token.
- The five predefined entities and every character reference are decoded; CDATA is text.
- Comments, processing instructions and the XML declaration are read and dropped.
- A document type declaration is refused, so no external entity (XXE) and no expansion exists.
- A reference to any entity but the five is refused, and so is nesting deeper than 256.
- Every refusal names the byte offset where reading stopped.

    case parseXml(asSpan(&text)) of
        when Right(right as parsed: XmlDocument) do
            let feed: Option[Index] := xmlFindStart(&parsed, 0, "feed");
            destroyXmlDocument(parsed);
        when Left(left as error: XmlError) do
            report(error.offset);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Xml is
    """
    What a token is.
    """
    union XmlKind: Free is
        case XmlStart;
        case XmlEnd;
        case XmlText;
    end;

    """
    Why parseXml refused.
    """
    union XmlProblem: Free is
        """
        A rule of well-formed XML is broken.
        """
        case NotWellFormed;
        """
        The bytes are not UTF-8.
        """
        case NotUtf8;
        """
        The document has a document type declaration.
        """
        case DoctypeRefused;
        """
        A reference to an entity that is not one of the five.
        """
        case UnknownEntity;
        """
        Elements nested deeper than 256.
        """
        case TooDeep;
    end;

    """
    What went wrong and the byte offset where reading stopped.
    """
    record XmlError: Free is
        problem: XmlProblem;
        offset: Index;
    end;

    """
    The tokens of a document.  Linear: destroyXmlDocument gives it back.
    """
    type XmlDocument: Linear;

    """
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function parseXml(text: Span[Nat8, R]): Either[XmlError, XmlDocument];

    """
    Frees document.
    No contract: it only frees or closes what it is given.
    """
    function destroyXmlDocument(document: XmlDocument): Unit;

    """
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function xmlTokenCount(document: &[XmlDocument, R]): Index;

    """
    The kind of token n, counting from 0, or None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function xmlTokenKind(document: &[XmlDocument, R], n: Index): Option[XmlKind];

    """
    The name of token n when it is a start or an end, its decoded text when
    it is text; empty when there is no such token.
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function xmlTokenText(document: &[XmlDocument, R], n: Index): Span[Nat8, R];

    """
    How many attributes start n has, and the name and the decoded value of
    attribute a of it; 0 and empty for a token that is no start.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function xmlAttributeCount(document: &[XmlDocument, R], n: Index): Index;
    """
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function xmlAttributeName(document: &[XmlDocument, R], n: Index, a: Index): Span[Nat8, R];
    """
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function xmlAttributeValue(document: &[XmlDocument, R], n: Index, a: Index): Span[Nat8, R];

    """
    The value of the attribute called name of start n, or None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function xmlAttributeOf(document: &[XmlDocument, R], n: Index, name: Span[Nat8, S]): Option[String];

    """
    The token of the end of the element that start n begins, or None when
    n is no start.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function xmlElementEnd(document: &[XmlDocument, R], n: Index): Option[Index];

    """
    All the text inside the element that start n begins, its children's
    included, joined; empty when n is no start.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function xmlInnerText(document: &[XmlDocument, R], n: Index): String;

    """
    The first start from token after on whose name is name, or None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function xmlFindStart(document: &[XmlDocument, R], after: Index, name: Span[Nat8, S]): Option[Index];

    """
    text with the ampersand, both angle brackets and both quotes written as
    references, for text and for attribute values.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function escapeXml(text: Span[Nat8, R]): String;
end module.
