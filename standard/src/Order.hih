"""
Type classes for partial and total orders, with the total orders of integers and strings.

- Every integer type and Standard.String has a TotalOrder here, for sorts and ordered maps.
- The order of String is byte by byte, unsigned; a prefix comes before the longer string.
- That order knows no locale and no case; for valid UTF-8 it is the order of the code points.
- A module that orders String or integer keys imports something from here to see the instances.

    case compare(&left, &right) of
        when LessThan do
            printLn("before");
        when Equal do
            printLn("same");
        when GreaterThan do
            printLn("after");
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Order is
    """
    Represents the result of comparing the order of two values.
    """
    union Ordering: Free is
        case LessThan;
        case Equal;
        case GreaterThan;
    end;

    """
    Represents the result of comparing two values for (partial) order.
    """
    union PartialOrdering: Free is
        case Comparable is
            order: Ordering;
        case Incomparable;
    end;

    """
    Represents a partial order.
    """
    typeclass PartialOrder(T: Type) is
        """
        No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
        """
        generic [R: Region, S: Region]
        method partialCompare(a: &[T, R], b: &[T, S]): PartialOrdering;
    end;

    """
    Represents a total order.
    """
    typeclass TotalOrder(T: Type) is
        """
        No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
        """
        generic [R: Region, S: Region]
        method compare(a: &[T, R], b: &[T, S]): Ordering;
    end;

    """
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [T: Type(TotalOrder), R: Region, S: Region]
    function equal(a: &[T, R], b: &[T, S]): Bool;

    instance PartialOrder(Nat8);
    instance TotalOrder(Nat8);
    instance TotalOrder(Nat16);
    instance TotalOrder(Nat32);
    instance TotalOrder(Nat64);
    instance TotalOrder(Int8);
    instance TotalOrder(Int16);
    instance TotalOrder(Int32);
    instance TotalOrder(Int64);
    instance TotalOrder(ByteSize);
    instance TotalOrder(Index);

    """
    Byte by byte, each byte as an unsigned number; when one string is a
    prefix of the other, the shorter comes first.  No locale, no case
    folding, no notion of UTF-8: the order of the bytes, which is the order
    of the code points for valid UTF-8.
    """
    instance TotalOrder(String);
end module.
