"""
Passwords and other secrets read from the terminal without echo, held in memory that is wiped when they go.

- readSecret reads from the terminal of the process, never from standard input or an argument.
- The echo is off while the line is typed and nothing is shown in its place.
- A signal that ends or stops the programme while the echo is off finds it switched back on first.
- Without a terminal the answer is NoTerminal at once; nothing waits.
- readSecretFromInput reads standard input, for a flag such as --password-stdin the programme names.
- A secret is linear; destroySecret wipes all its memory, and there is no other way to drop it.
- A secret holds at most 1024 bytes; a longer line is TooLong and is wiped.

    case readNewSecret("New password: ", "Again: ") of
        when Right(right as secret: Secret) do
            store(secretBytes(&secret));
            destroySecret(secret);
        when Left(left as error: SecretError) do
            refuse(error);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
module Standard.Secret is
    """
    A secret in wiped memory.  Give it back with destroySecret.
    """
    type Secret: Linear;

    """
    Why no secret came.
    """
    union SecretError: Free is
        """
        The process has no terminal to ask.
        """
        case NoTerminal;
        """
        The line was longer than 1024 bytes.
        """
        case TooLong;
        """
        The line was empty.
        """
        case Empty;
        """
        The two lines of readNewSecret differ.
        """
        case Mismatch;
        """
        The memory could not be had, or reading failed.
        """
        case Failed;
    end;

    """
    Writes prompt to the terminal and reads a line there with the echo off.
    No contract: the result is I/O.
    """
    generic [P: Region]
    function readSecret(prompt: Span[Nat8, P]): Either[SecretError, Secret];

    """
    Asks twice, with prompt and then with again, for a new secret; Mismatch
    when the two lines differ, compared in constant time.
    No contract: the result is I/O.
    """
    generic [P: Region, A: Region]
    function readNewSecret(prompt: Span[Nat8, P], again: Span[Nat8, A]): Either[SecretError, Secret];

    """
    Reads one line from standard input, without a prompt.
    No contract: the result is I/O.
    """
    function readSecretFromInput(): Either[SecretError, Secret];

    """
    The bytes of the secret, without the line feed.
    """
    generic [R: Region]
    function secretBytes(secret: &[Secret, R]): Span[Nat8, R]
        ensures spanLength(result) <= 1024;

    """
    Wipes the memory of the secret and gives it back.
    No contract: it only frees or closes what it is given.
    """
    function destroySecret(secret: Secret): Unit;
end module.
