"""
Host names resolved to addresses through the hosts file and DNS, as the system sets them up.

- A literal address comes back as it is, without asking anyone.
- So does an IPv4 address in its mapped IPv6 form, ::ffff: and four groups.
- Anything else must be a host name by RFC 1123 before it is handed to the resolver.
- An answer holds every address once, in the order the resolver gave them, at most 64.
- The call waits until the resolver answers; a task that resolves keeps its worker meanwhile.

    case resolveHost("mail.example.org", AnyFamily()) of
        when Right(right as addresses: Buffer[IpAddress]) do
            connectToFirst(addresses);
        when Left(left as failure: ResolveFailure) do
            reportFailure(failure);
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.Buffer (
    Buffer
);
import Standard.Ip (
    IpAddress
);

module Standard.Resolve is
    """
    Which addresses an answer keeps.
    """
    union Family: Free is
        """
        IPv4 and IPv6.
        """
        case AnyFamily;
        """
        IPv4 only.
        """
        case OnlyIpv4;
        """
        IPv6 only.
        """
        case OnlyIpv6;
    end;

    """
    Why a name has no answer.
    """
    union ResolveFailure: Free is
        """
        The name is neither a literal address nor a host name by RFC 1123;
        the resolver was not asked.
        """
        case NotAHostName;
        """
        The resolver knows no address for the name.
        """
        case UnknownName;
        """
        The resolver could not be asked or did not answer in time.  Asking
        again later may succeed.
        """
        case ResolverUnavailable;
        """
        The name has addresses, but none of the family asked for.
        """
        case NoAddressOfFamily;
        """
        The resolution failed otherwise: no memory, an error of the system.
        """
        case ResolveFailed;
    end;

    """
    Whether name is a host name by RFC 1123: 1 to 253 bytes, labels of 1 to
    63 letters, digits and hyphens separated by dots, none beginning or
    ending with a hyphen.  A trailing dot is refused, and so is a name in
    Unicode: an international name is written in its xn-- form first.
    Nothing is resolved.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function validHostname(name: Span[Nat8, R]): Bool;

    """
    The addresses of name of the family asked for, each once, in the order
    the resolver gave them.  An IPv6 address that maps an IPv4 one is
    counted and given as IPv4.  Left with the reason when there is none.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function resolveHost(name: Span[Nat8, R], family: Family): Either[ResolveFailure, Buffer[IpAddress]];
end module.
