import Bindings.Bulk (
    fillPixels,
    blendCoverage,
    copyElements
);

-- The requires hold the picture inside its span; the rectangle is clipped
-- here, in Hilde, to the picture and to the mask, so the loops of the
-- binding touch only bytes inside both spans.
module body Standard.Raster is
    function mostSide(): Index is
        return 65536;
    end;

    -- Whether a corner at value can reach a picture: one past mostSide
    -- is right of or below every picture, and one before -2 to the 40 is
    -- left of or above it, since no rectangle or mask is that large.  Inside
    -- these bounds no sum or difference below overflows an Int64.
    function onPicture(value: Int64): Bool is
        return (value <= 65536) and (value >= -1099511627776);
    end;

    -- A value below 0 is 0; no value here exceeds what an Index holds.
    function nonNegative(value: Int64): Index is
        if value < 0 then
            return 0;
        end if;
        case toIndex(value) of
            when Some(value as wide: Index) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    -- The column or row after the last of a run from start, size long,
    -- inside 0 to limit; 0 when the run ends before 0.
    function clipStop(start: Int64, size: Index, limit: Index): Index is
        case toInt64(size) of
            when Some(value as wide: Int64) do
                let stop: Index := nonNegative(start + wide);
                if stop > limit then
                    return limit;
                end if;
                return stop;
            when None do
                return limit;
        end case;
    end;

    generic [R: Region]
    function fillRect(pixels: Span![Nat8, R], width: Index, height: Index, x: Int64, y: Int64, w: Index, h: Index, color: Nat32): Unit is
        if not (onPicture(x) and onPicture(y)) then
            return nil;
        end if;
        let left: Index := nonNegative(x);
        let right: Index := clipStop(x, w, width);
        let top: Index := nonNegative(y);
        let bottom: Index := clipStop(y, h, height);
        if (left < right) and (top < bottom) then
            fillPixels(&~pixels, width, top, bottom, left, right, color);
        end if;
        return nil;
    end;

    -- The part of the mask that lands inside the picture: columns left to
    -- right and rows top to bottom of the picture, which start at mx and my
    -- in the mask.
    generic [R: Region, M: Region]
    function blendMask(pixels: Span![Nat8, R], width: Index, height: Index, mask: Span[Nat8, M], mask_width: Index, x: Int64, y: Int64, color: Nat32): Unit is
        if not (onPicture(x) and onPicture(y)) then
            return nil;
        end if;
        let rows: Index := spanLength(mask) / mask_width;
        let left: Index := nonNegative(x);
        let right: Index := clipStop(x, mask_width, width);
        let top: Index := nonNegative(y);
        let bottom: Index := clipStop(y, rows, height);
        if (left < right) and (top < bottom) then
            let mx: Index := nonNegative(0 - x);
            let my: Index := nonNegative(0 - y);
            blendCoverage(&~pixels, width, left, top, mask, mask_width, mx, my, right - left, bottom - top, color);
        end if;
        return nil;
    end;

    generic [S: Region, R: Region]
    function copyRows(source: Span[Nat8, S], target: Span![Nat8, R], width: Index, top: Index, bottom: Index): Unit is
        let first: Index := (top * width) * 4;
        copyElements(source, first, target, first, ((bottom * width) * 4) - first);
        return nil;
    end;
end module body.
