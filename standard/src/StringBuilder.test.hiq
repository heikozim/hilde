import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    nthByte,
    length,
    fromLiteral,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);

module body Standard.StringBuilder.Test is
    -- Writing an empty string must not abort the programme: a loop bound
    -- of length(string) - 1 would, since an Index traps rather than going
    -- below zero, and a caller that writes a record with no content
    -- writes such a string.
    -- an empty string is written without aborting.
    function testEmptyString(): Unit is
        var sb: StringBuilder := makeStringBuilder();
        let nothing: String := fromLiteral("");
        writeString(&!sb, asSpan(&nothing));
        writeByte(&!sb, 'x');
        writeString(&!sb, asSpan(&nothing));
        let out: String := finalize(sb);
        assertLength(&out, 1);
        assertTrue(nthByte(&out, 0) = 'x', "the one byte that was written");
        destroyString(nothing);
        destroyString(out);
        return nil;
    end;

    -- basic.
    function testBasic(): Unit is
        var sb: StringBuilder := makeStringBuilder();
        writeByte(&!sb, 'a');
        writeByte(&!sb, 'b');
        writeByte(&!sb, 'c');
        let str: String := fromLiteral("def");
        writeString(&!sb, asSpan(&str));
        let last: String := finalize(sb);
        assertLength(&last, 6);
        assertTrue(nthByte(&last, 0) = 'a', "[0] = a");
        assertTrue(nthByte(&last, 1) = 'b', "[1] = b");
        assertTrue(nthByte(&last, 2) = 'c', "[2] = c");
        assertTrue(nthByte(&last, 3) = 'd', "[3] = d");
        assertTrue(nthByte(&last, 4) = 'e', "[4] = e");
        assertTrue(nthByte(&last, 5) = 'f', "[5] = f");
        destroyString(str);
        destroyString(last);
        return nil;
    end;

    ---
    --- Utilities
    ---

    generic [R: Region]
    function assertLength(ref: &[String, R], len: Index): Unit is
        assertTrue(length(ref) = len, "length");
        return nil;
    end;
end module body.
