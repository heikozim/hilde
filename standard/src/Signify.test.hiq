import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Text (
    startsWith,
    equal
);
import Standard.Signify (
    KeyPair,
    generateKeys,
    signMessage,
    verifyMessage,
    publicKeyLine,
    publicKeyOf,
    publicKeyLineLength,
    destroyKeyPair
);

module body Standard.Signify.Test is
    -- A key made for this test with signify -G -n -c vector, and its
    -- signature of the text hello and a new line by signify -S.  Ed25519
    -- signatures are deterministic, so this module must write the same.
    constant knownPublic: Span[Nat8, Static] := "untrusted comment: vector public key\nRWSgBGDjdJGlv/Ssv2UqfdZ9kfEYS1czgn4S5ReDnx9m1cPHwyT0GMWY\n";
    constant knownSecret: Span[Nat8, Static] := "untrusted comment: vector secret key\nRWRCSwAAAAB9ytINuJv4loSbiL9gyDjXeTYbeq2DwUGgBGDjdJGlvwkyYUHIR8suYKiYd9oqtvwubop4QUDFg7Wcztw+BgH09Ky/ZSp91n2R8RhLVzOCfhLlF4OfH2bVw8fDJPQYxZg=\n";
    constant knownSignature: Span[Nat8, Static] := "untrusted comment: verify with k.pub\nRWSgBGDjdJGlvxjn9KXUBdyQ28aVFwO0NyCM4Y2oo2kx12DKKSfNADmMAHml34BRKNB9ByYUg5wIVdAQsulmxXgr+evXdvaEhQY=\n";

    function testKnown(): Unit is
        assertTrue(verifyMessage(knownPublic, "hello\n", knownSignature), "the signature of signify holds");
        assertTrue(not verifyMessage(knownPublic, "hello", knownSignature), "not for another message");
        case signMessage(knownSecret, "hello\n", "verify with k.pub") of
            when Some(value as signature: String) do
                assertTrue(equal(asSpan(&signature), knownSignature), "the same signature as signify");
                destroyString(signature);
            when None do
                assertFailure("the key of signify did not sign");
        end case;
        case publicKeyOf(knownSecret, "vector public key") of
            when Some(value as public: String) do
                assertTrue(equal(asSpan(&public), knownPublic), "the same public key as signify");
                destroyString(public);
            when None do
                assertFailure("no public key of the key of signify");
        end case;
        return nil;
    end;

    function testRoundTrip(): Unit is
        case generateKeys("test") of
            when Some(value as keys: KeyPair) do
                let { publicKey: String, secretKey: String } := keys;
                assertTrue(startsWith(asSpan(&publicKey), "untrusted comment: test public key\n"), "the public comment");
                assertTrue(startsWith(asSpan(&secretKey), "untrusted comment: test secret key\n"), "the secret comment");
                case signMessage(asSpan(&secretKey), "hello\n", "verify with test.pub") of
                    when Some(value as signature: String) do
                        assertTrue(verifyMessage(asSpan(&publicKey), "hello\n", asSpan(&signature)), "the signature holds");
                        assertTrue(not verifyMessage(asSpan(&publicKey), "hello!\n", asSpan(&signature)), "another message fails");
                        assertTrue(not verifyMessage(knownPublic, "hello\n", asSpan(&signature)), "another key fails");
                        assertTrue(not verifyMessage(asSpan(&publicKey), "hello\n", "untrusted comment: x\nRWQ=\n"), "a short signature fails");
                        destroyString(signature);
                    when None do
                        assertFailure("the key did not sign");
                end case;
                case publicKeyLine(asSpan(&publicKey)) of
                    when Some(value as line: String) do
                        assertTrue(length(&line) = publicKeyLineLength(), "the key line has 56 characters");
                        case publicKeyLine(asSpan(&line)) of
                            when Some(value as again: String) do
                                assertTrue(equal(asSpan(&again), asSpan(&line)), "the line alone is a key");
                                destroyString(again);
                            when None do
                                assertFailure("the line alone was refused");
                        end case;
                        destroyString(line);
                    when None do
                        assertFailure("no key line");
                end case;
                case publicKeyOf(asSpan(&secretKey), "test public key") of
                    when Some(value as derived: String) do
                        assertTrue(equal(asSpan(&derived), asSpan(&publicKey)), "the public key of the secret");
                        destroyString(derived);
                    when None do
                        assertFailure("no public key of the secret");
                end case;
                destroyString(publicKey);
                destroyString(secretKey);
            when None do
                assertFailure("no keys");
        end case;
        return nil;
    end;

    function testRefused(): Unit is
        case generateKeys("two\nlines") of
            when Some(value as keys: KeyPair) do
                destroyKeyPair(keys);
                assertFailure("a comment with a new line was taken");
            when None do
                assertSuccess("a comment with a new line is refused");
        end case;
        case signMessage(knownPublic, "hello\n", "x") of
            when Some(value as signature: String) do
                destroyString(signature);
                assertFailure("a public key signed");
            when None do
                assertSuccess("a public key does not sign");
        end case;
        case publicKeyLine("untrusted comment: x\nnot base64\n") of
            when Some(value as line: String) do
                destroyString(line);
                assertFailure("a bad key line was taken");
            when None do
                assertSuccess("a bad key line is refused");
        end case;
        return nil;
    end;
end module body.
