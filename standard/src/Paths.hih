"""
Where a service or a user tool keeps its configuration, secrets, data, logs and socket on each system.

- A service follows hier(7) on OpenBSD and FreeBSD and the Filesystem Hierarchy Standard on Linux; a user tool the base directories of freedesktop.org, or ~/Library on macOS.
- An app name is 1 to 31 bytes of small letters, digits and hyphens, starting with a letter; its account is _ and the name.
- A path is chosen from the flag, then the variable APP_ENV, APP_PEPPER, APP_CONFIG or APP_SOCKET, then the configuration, then the default.
- A base directory variable that does not hold an absolute path is ignored, as the specification asks.
- The modes are 0600 for the env file and the pepper, 0640 for the configuration, 0660 for the socket, 0750 for directories.
- Nothing is made on the disk; the programme makes what it needs with the modes given here.

    case choosePath("notes", Service(), PepperFile(), flag, configured) of
        when Some(value as path: String) do
            usePepper(asSpan(&path));
        when None do
            refuse();
    end case;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Paths is
    """
    Whether the programme runs as a service of the system or as a tool of
    one user.
    """
    union AppKind: Free is
        case Service;
        case UserTool;
    end;

    """
    What a path is for.
    """
    union PathKind: Free is
        case ConfigFile;
        case EnvFile;
        case PepperFile;
        case DataDirectory;
        case CacheDirectory;
        case LogDirectory;
        case RuntimeDirectory;
        case SocketFile;
    end;

    """
    Whether app is a valid app name: 1 to 31 bytes of small letters,
    digits and hyphens, the first a letter.
    """
    generic [A: Region]
    function isAppName(app: Span[Nat8, A]): Bool
        ensures (not result) or ((spanLength(app) >= 1) and (spanLength(app) <= 31));

    """
    The account a service runs as: _ and the app name.  None for a name
    that is not valid.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [A: Region]
    function serviceAccount(app: Span[Nat8, A]): Option[String];

    """
    The name of the variable that sets the path of what, the app name in
    capitals with hyphens as underscores, then _ENV, _PEPPER, _CONFIG or
    _SOCKET.  None for a kind no variable sets, and for a name that is not
    valid.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [A: Region]
    function variableName(app: Span[Nat8, A], what: PathKind): Option[String];

    """
    The mode a file or directory of that kind is made with.
    """
    function pathMode(what: PathKind): Nat32
        ensures result <= 511;

    """
    The default path of what for app on the system named, as
    Standard.Platform names it; an unknown system gets the Linux layout.
    A user tool reads the home directory and the base directory
    variables.  None for a name that is not valid, and for a user tool
    without an absolute home directory.
    No contract: the result depends on the environment.
    """
    generic [S: Region, A: Region]
    function defaultPathOn(system: Span[Nat8, S], app: Span[Nat8, A], kind: AppKind, what: PathKind): Option[String];

    """
    The default path of what for app on the system the programme was
    compiled for.
    No contract: the result depends on the environment.
    """
    generic [A: Region]
    function defaultPath(app: Span[Nat8, A], kind: AppKind, what: PathKind): Option[String];

    """
    The path of what: flag when it is Some, else the variable of
    variableName when it is set and not empty, else configured when it is
    Some, else defaultPath.  An empty flag or configured value counts as
    not given.  None as defaultPath gives None.
    No contract: the result depends on the environment.
    """
    generic [A: Region, F: Region, C: Region]
    function choosePath(app: Span[Nat8, A], kind: AppKind, what: PathKind, flag: Option[Span[Nat8, F]], configured: Option[Span[Nat8, C]]): Option[String];
end module.
