-- A safe module.  The tables at the end are written by
-- scripts/unicode/make-case-tables.py and are not edited by hand: each is
-- a string of fixed-width hexadecimal records sorted by code point, found
-- by binary search, so nothing is parsed ahead of time and nothing is
-- kept between calls.  A run maps every code point from its start to its
-- end, stride apart, to itself plus a difference; a special maps one code
-- point to up to three.  The generator makes sure no run holds a code
-- point of another between its ends, which is what lets the search stop
-- at the last run that starts at or before a code point.
import Standard.String (
    String,
    length as stringLength,
    nthByte,
    asSpan,
    destroyString
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Utf8 (
    CodePoint,
    Decoded,
    makeCodePoint,
    codePointValue,
    decodeAt,
    decodedPoint,
    decodedWidth,
    appendCodePoint
);

module body Standard.Unicode is
    constant runWidth: Index := 20;
    constant specialWidth: Index := 24;
    constant zeroIndex: Index := 0;
    constant zero: Int64 := 0;
    constant one: Int64 := 1;
    constant sixteen: Int64 := 16;
    -- The generator adds this to a difference, so that it is written
    -- without a sign.
    constant differenceOffset: Int64 := 33554432;
    constant upperKind: Nat8 := 0;
    constant lowerKind: Nat8 := 1;
    constant foldKind: Nat8 := 2;

    -- The value of count hexadecimal digits of table from at.  The tables
    -- hold capital hexadecimal digits only; anything else is a fault of the
    -- generator.
    function hexAt(table: Span[Nat8, Static], at: Index, count: Index): Int64 is
        var total: Int64 := zero;
        var i: Index := zeroIndex;
        while i < count do
            let byte: Nat8 := table[at + i];
            var digit: Nat8 := 0;
            if (byte >= '0') and (byte <= '9') then
                digit := byte - '0';
            else if (byte >= 'A') and (byte <= 'F') then
                digit := (byte - 'A') + 10;
            else
                abort("Standard.Unicode: a table holds a byte that is not a hexadecimal digit");
            end if;
            case toInt64(digit) of
                when Some(value as wide: Int64) do
                    total := (total * sixteen) + wide;
                when None do
                    abort("Standard.Unicode: a digit did not fit an Int64");
            end case;
            i := i + 1;
        end while;
        return total;
    end;

    function runsOf(kind: Nat8): Span[Nat8, Static] is
        if kind = upperKind then
            return upperRuns();
        end if;
        if kind = lowerKind then
            return lowerRuns();
        end if;
        return foldRuns();
    end;

    function specialsOf(kind: Nat8): Span[Nat8, Static] is
        if kind = upperKind then
            return upperSpecials();
        end if;
        if kind = lowerKind then
            return lowerSpecials();
        end if;
        return foldSpecials();
    end;

    -- The index of the record of the special for scalar, or None.
    function findSpecial(table: Span[Nat8, Static], scalar: Int64): Option[Index] is
        let count: Index := spanLength(table) / specialWidth;
        var low: Index := zeroIndex;
        var high: Index := count;
        while low < high do
            let middle: Index := (low + high) / 2;
            let found: Int64 := hexAt(table, middle * specialWidth, 6);
            if found = scalar then
                return Some(value => middle);
            end if;
            if found < scalar then
                low := middle + 1;
            else
                high := middle;
            end if;
        end while;
        let none: Option[Index] := None();
        return none;
    end;

    -- What the runs map scalar to: scalar itself when no run holds it.
    function mapByRuns(table: Span[Nat8, Static], scalar: Int64): Int64 is
        let count: Index := spanLength(table) / runWidth;
        if (count = zeroIndex) or (hexAt(table, zeroIndex, 6) > scalar) then
            return scalar;
        end if;
        -- The last run that starts at or before scalar.
        var low: Index := zeroIndex;
        var high: Index := count - 1;
        while low < high do
            let middle: Index := ((low + high) + 1) / 2;
            if hexAt(table, middle * runWidth, 6) <= scalar then
                low := middle;
            else
                high := middle - 1;
            end if;
        end while;
        let at: Index := low * runWidth;
        let start: Int64 := hexAt(table, at, 6);
        let stop: Int64 := hexAt(table, at + 6, 6);
        let stride: Int64 := hexAt(table, at + 12, 1);
        if (scalar > stop) or (rem(scalar - start, stride) /= zero) then
            return scalar;
        end if;
        return scalar + (hexAt(table, at + 13, 7) - differenceOffset);
    end;

    -- The code point of a scalar value a table holds.
    function pointOf(scalar: Int64): CodePoint is
        case toNat32(scalar) of
            when Some(value as narrow: Nat32) do
                case makeCodePoint(narrow) of
                    when Some(value as point: CodePoint) do
                        return point;
                    when None do
                        abort("Standard.Unicode: a table holds a value that is no scalar value");
                end case;
            when None do
                abort("Standard.Unicode: a table holds a value that is no scalar value");
        end case;
    end;

    function scalarOf(point: CodePoint): Int64 is
        case toInt64(codePointValue(point)) of
            when Some(value as wide: Int64) do
                return wide;
            when None do
                abort("Standard.Unicode: a Nat32 did not fit an Int64");
        end case;
    end;

    -- The mapping of point by kind, appended to out.
    generic [B: Region]
    function appendMapped(out: &![StringBuilder, B], kind: Nat8, point: CodePoint): Unit is
        let scalar: Int64 := scalarOf(point);
        let specials: Span[Nat8, Static] := specialsOf(kind);
        case findSpecial(specials, scalar) of
            when Some(value as entry: Index) do
                var k: Index := zeroIndex;
                while k < 3 do
                    let target: Int64 := hexAt(specials, ((entry * specialWidth) + 6) + (k * 6), 6);
                    if target /= zero then
                        appendCodePoint(&~out, pointOf(target));
                    end if;
                    k := k + 1;
                end while;
            when None do
                appendCodePoint(&~out, pointOf(mapByRuns(runsOf(kind), scalar)));
        end case;
        return nil;
    end;

    -- The text mapped by kind, or None when it is not well-formed UTF-8.
    generic [R: Region]
    function mapText(text: Span[Nat8, R], kind: Nat8): Option[String] is
        let size: Index := spanLength(text);
        var out: StringBuilder := makeStringBuilder();
        var at: Index := zeroIndex;
        var good: Bool := true;
        while good and (at < size) do
            case decodeAt(text, at) of
                when Some(value as decoded: Decoded) do
                    appendMapped(&!out, kind, decodedPoint(decoded));
                    at := at + decodedWidth(decoded);
                when None do
                    good := false;
            end case;
        end while;
        let mapped: String := finalize(out);
        if good then
            return Some(value => mapped);
        else
            destroyString(mapped);
            let none: Option[String] := None();
            return none;
        end if;
    end;

    generic [R: Region]
    function toUpper(text: Span[Nat8, R]): Option[String] is
        return mapText(text, upperKind);
    end;

    generic [R: Region]
    function toLower(text: Span[Nat8, R]): Option[String] is
        return mapText(text, lowerKind);
    end;

    generic [R: Region]
    function foldCase(text: Span[Nat8, R]): Option[String] is
        return mapText(text, foldKind);
    end;

    generic [R: Region, S: Region]
    function sameBytes(left: &[String, R], right: &[String, S]): Bool is
        let size: Index := stringLength(left);
        if size /= stringLength(right) then
            return false;
        end if;
        var i: Index := zeroIndex;
        while i < size do
            if nthByte(left, i) /= nthByte(right, i) then
                return false;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    generic [R: Region, S: Region]
    function equalIgnoringCase(left: Span[Nat8, R], right: Span[Nat8, S]): Bool is
        case foldCase(left) of
            when Some(value as leftFolded: String) do
                case foldCase(right) of
                    when Some(value as rightFolded: String) do
                        let same: Bool := sameBytes(&leftFolded, &rightFolded);
                        destroyString(leftFolded);
                        destroyString(rightFolded);
                        return same;
                    when None do
                        destroyString(leftFolded);
                        return false;
                end case;
            when None do
                return false;
        end case;
    end;

    -- Whether kind changes scalar.
    function changedBy(kind: Nat8, scalar: Int64): Bool is
        case findSpecial(specialsOf(kind), scalar) of
            when Some(value as entry: Index) do
                return true;
            when None do
                return mapByRuns(runsOf(kind), scalar) /= scalar;
        end case;
    end;

    function hasCase(point: CodePoint): Bool is
        let scalar: Int64 := scalarOf(point);
        return changedBy(upperKind, scalar) or (changedBy(lowerKind, scalar) or changedBy(foldKind, scalar));
    end;

