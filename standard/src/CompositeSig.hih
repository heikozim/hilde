"""
Signs and verifies with the composite of ML-DSA-44 and Ed25519 of the IETF draft for composite signatures.

- The signed message is M' = prefix, label, the length of the context, the context and the SHA-512 of the message.
- The signature is the one of ML-DSA-44 over M' with the label as its context, then the one of Ed25519 over M'.
- verify holds only when both hold: either scheme alone breaking does not forge a signature.
- The label names the use; openSshLabel is the one of OpenSSH's ssh-mldsa44-ed25519.
- A key is two seeds of 32 bytes, ML-DSA first, as OpenSSH keeps it; the public key is the two public keys.

    let signed: Option[String] := sign(&key, openSshLabel(), asSpan(&message), "");
"""
pragma Targets(Names => "linux openbsd freebsd darwin");
import Standard.String (
    String,
    length
);

module Standard.CompositeSig is
    """
    A key pair of ML-DSA-44 and Ed25519.
    """
    type CompositeKey: Linear;

    """
    The bytes of a public key: 1312 of ML-DSA-44 and 32 of Ed25519.
    """
    function publicKeyBytes(): Index
        ensures result = 1344;

    """
    The bytes of a signature: 2420 of ML-DSA-44 and 64 of Ed25519.
    """
    function signatureBytes(): Index
        ensures result = 2484;

    """
    The prefix of M', CompositeAlgorithmSignatures2025.
    """
    function prefix(): Span[Nat8, Static]
        ensures spanLength(result) = 32;

    """
    The label of OpenSSH's composite of ML-DSA-44 and Ed25519, 30 bytes.
    """
    function openSshLabel(): Span[Nat8, Static]
        ensures spanLength(result) = 30;

    """
    The key of the two seeds, 32 bytes each.  None only when a backend
    refuses.  No contract on the result: it is an Option.
    """
    generic [M: Region, E: Region]
    function keypairFromSeeds(mlDsaSeed: Span[Nat8, M], ed25519Seed: Span[Nat8, E]): Option[CompositeKey]
        requires (spanLength(mlDsaSeed) = 32) and (spanLength(ed25519Seed) = 32);

    """
    A new key from 64 random bytes.  None when no random bytes could be
    had.
    No contract: the result is an Option.
    """
    function generateKeyPair(): Option[CompositeKey];

    """
    The public key: that of ML-DSA-44, then that of Ed25519.
    """
    generic [R: Region]
    function publicKeyOf(key: &[CompositeKey, R]): String
        ensures length(&result) = publicKeyBytes();

    """
    The two seeds, ML-DSA first, as OpenSSH keeps the secret.  The caller
    wipes them.
    """
    generic [R: Region]
    function seedsOf(key: &[CompositeKey, R]): String
        ensures length(&result) = 64;

    """
    The composite signature of message with context under key and label;
    the ML-DSA part is hedged with 32 random bytes.  None when no random
    bytes could be had or a backend refuses.  No contract on the result:
    it is an Option.
    """
    generic [R: Region, L: Region, M: Region, C: Region]
    function sign(key: &[CompositeKey, R], label: Span[Nat8, L], message: Span[Nat8, M], context: Span[Nat8, C]): Option[String]
        requires (spanLength(label) <= 255) and (spanLength(context) <= 255);

    """
    sign with the given 32 bytes of randomness for the ML-DSA part, for test
    vectors; 32 zero bytes make it deterministic.  No contract on the
    result: it is an Option.
    """
    generic [R: Region, L: Region, M: Region, C: Region, N: Region]
    function signWithRandomness(key: &[CompositeKey, R], label: Span[Nat8, L], message: Span[Nat8, M], context: Span[Nat8, C], randomness: Span[Nat8, N]): Option[String]
        requires ((spanLength(label) <= 255) and (spanLength(context) <= 255)) and (spanLength(randomness) = 32);

    """
    Whether signature is a composite signature of message with context
    under publicKey and label: both parts must hold.  False for any length
    that does not fit.
    No contract: every input is allowed, a wrong one is an answer.
    """
    generic [P: Region, L: Region, M: Region, C: Region, G: Region]
    function verify(publicKey: Span[Nat8, P], label: Span[Nat8, L], message: Span[Nat8, M], context: Span[Nat8, C], signature: Span[Nat8, G]): Bool;

    """
    Wipes the seeds and the secret key and gives the key back.
    No contract: it only frees or closes what it is given.
    """
    function destroyCompositeKey(key: CompositeKey): Unit;
end module.
