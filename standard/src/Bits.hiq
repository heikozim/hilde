import Bindings.Bits (
    float64Bits as bindFloat64Bits,
    float64FromBits as bindFloat64FromBits,
    float32Bits as bindFloat32Bits,
    float32FromBits as bindFloat32FromBits,
    int64Bits as bindInt64Bits,
    int64FromBits as bindInt64FromBits,
    int32Bits as bindInt32Bits,
    int32FromBits as bindInt32FromBits
);

module body Standard.Bits is
    function float64Bits(value: Float64): Nat64 is
        return bindFloat64Bits(value);
    end;

    function float64FromBits(bits: Nat64): Float64 is
        return bindFloat64FromBits(bits);
    end;

    function float32Bits(value: Float32): Nat32 is
        return bindFloat32Bits(value);
    end;

    function float32FromBits(bits: Nat32): Float32 is
        return bindFloat32FromBits(bits);
    end;

    function int64Bits(value: Int64): Nat64 is
        return bindInt64Bits(value);
    end;

    function int64FromBits(bits: Nat64): Int64 is
        return bindInt64FromBits(bits);
    end;

    function int32Bits(value: Int32): Nat32 is
        return bindInt32Bits(value);
    end;

    function int32FromBits(bits: Nat32): Int32 is
        return bindInt32FromBits(bits);
    end;
end module body.
