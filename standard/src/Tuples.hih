"""
Records of two to six values of any types, with fields named by their position.

- Pair holds two values, Triple three, and Tuple4, Tuple5 and Tuple6 four to six.
- The fields are first, second, third, fourth, fifth and sixth, in that order.
- Every field is public: a tuple is made with named arguments and taken apart with a let.
- A field may be of a Linear type, such as String.

    let old: Pair[String, Nat64] := Pair(first => word, second => seen);
    let { first: String, second: Nat64 } := old;
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
module Standard.Tuples is
    record Pair[A: Type, B: Type]: Type is
        first: A;
        second: B;
    end;

    record Triple[A: Type, B: Type, C: Type]: Type is
        first: A;
        second: B;
        third: C;
    end;

    record Tuple4[
        A: Type,
        B: Type,
        C: Type,
        D: Type
    ]: Type is
        first: A;
        second: B;
        third: C;
        fourth: D;
    end;

    record Tuple5[
        A: Type,
        B: Type,
        C: Type,
        D: Type,
        E: Type
    ]: Type is
        first: A;
        second: B;
        third: C;
        fourth: D;
        fifth: E;
    end;

    record Tuple6[
        A: Type,
        B: Type,
        C: Type,
        D: Type,
        E: Type,
        F: Type
    ]: Type is
        first: A;
        second: B;
        third: C;
        fourth: D;
        fifth: E;
        sixth: F;
    end;
end module.
