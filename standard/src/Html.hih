"""
HTML read into tokens after the tokenizer of the HTML standard, its text taken out, or cleaned.

- A document is the list of its tokens: text, start and end tags, comments and doctypes.
- Tag and attribute names are in small letters; character references are decoded into UTF-8.
- The content of script, style, textarea and title is one text token: a tag in a script is none.
- sanitize keeps only what a policy allows, and drops elements of code, frames and forms whole.
- Other content of an element that is not allowed stays, as escaped text.
- A URL is kept only with the scheme http, https or mailto, or with none.
- sanitize closes every element in the order it was opened, and holds at most 100 open at once.
- The output of sanitize is well formed and escaped, whatever the input was.

    let clean: String := sanitize(asSpan(&comment), basicPolicy());
    let plain: String := textOf(asSpan(&page));
"""
pragma Targets(Names => "linux openbsd freebsd darwin wasm");
import Standard.String (
    String
);

module Standard.Html is
    """
    What a token is.
    """
    union TokenKind: Free is
        case TextToken;
        case StartTag;
        case EndTag;
        case CommentToken;
        case DoctypeToken;
    end;

    """
    The tokens of a text.  Linear: destroyDocument gives it back.
    """
    type Document: Linear;

    """
    The tokens of html.  Reading never fails: what the standard calls a
    parse error is read the way it says, so any bytes give a document.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [R: Region]
    function parseHtml(html: Span[Nat8, R]): Document;

    """
    Frees document.
    No contract: it only frees or closes what it is given.
    """
    function destroyDocument(document: Document): Unit;

    """
    How many tokens the document has.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function tokenCount(document: &[Document, R]): Index;

    """
    The kind of token n, counting from 0.  None when there is no such
    token.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region]
    function tokenKind(document: &[Document, R], n: Index): Option[TokenKind];

    """
    The name of token n when it is a tag, the text of a text or a comment,
    and the name of a doctype, decoded.  Empty when there is no such token.
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function tokenText(document: &[Document, R], n: Index): Span[Nat8, R];

    """
    Whether start tag n ends with a slash, as br/ does.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function tokenSelfClosing(document: &[Document, R], n: Index): Bool;

    """
    How many attributes token n has; 0 for a token that is no start tag.
    The first of two attributes of the same name is the one kept, and the
    first 64 attributes of a tag; the others are read and dropped.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function attributeCount(document: &[Document, R], n: Index): Index;

    """
    The name of attribute a of token n, and its decoded value.  Empty when
    there is no such attribute.
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function attributeName(document: &[Document, R], n: Index, a: Index): Span[Nat8, R];
    """
    No contract: a view into its argument, whose length depends on it.
    """
    generic [R: Region]
    function attributeValue(document: &[Document, R], n: Index, a: Index): Span[Nat8, R];

    """
    The value of the attribute called name of token n, or None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, S: Region]
    function attributeOf(document: &[Document, R], n: Index, name: Span[Nat8, S]): Option[String];

    """
    The text of html without its tags, comments, scripts and styles, its
    character references decoded.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function textOf(html: Span[Nat8, R]): String;

    """
    text with the five characters that HTML gives a meaning written as
    character references: the ampersand, the two angle brackets and the two
    quotes.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function escapeHtml(text: Span[Nat8, R]): String;

    """
    Which elements and which attributes sanitize keeps.  Free, so it
    copies.
    """
    type Policy: Free;

    """
    Paragraphs, line breaks, emphasis, code, quotes, lists, headings and
    links with href and title; every link gets rel="nofollow noopener".
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function basicPolicy(): Policy;

    """
    A policy of its own: elements and attributes are lists of names
    separated by commas, links says whether a gets rel="nofollow noopener".
    The elements a policy can name are a abbr b bdi bdo blockquote br caption
    cite code col colgroup dd del dfn div dl dt em figcaption figure h1 to h6
    hr i img ins kbd li mark ol p pre q s samp small span strong sub sup table
    tbody td tfoot th thead time tr u ul var wbr; the attributes are title,
    class, lang and dir on any element, href on a, src, alt, width and height
    on img, colspan and rowspan on td and th, start and reversed on ol, cite
    on blockquote, q, del and ins, datetime on time, del and ins.  None for a
    name that is not one of these, or an empty name.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [E: Region, A: Region]
    function makePolicy(elements: Span[Nat8, E], attributes: Span[Nat8, A], links: Bool): Option[Policy];

    """
    html with only what policy allows, well formed and escaped.  The
    content of script, style and the elements that hold code, foreign
    markup, frames or forms goes with them.  A URL in href, src or cite is
    kept only with the scheme http, https or mailto, or with none, after
    its character references are decoded and its control bytes and spaces
    taken out.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function sanitize(html: Span[Nat8, R], policy: Policy): String;
end module.
