import Standard.Buffer (
    Buffer,
    length,
    nthRef,
    removeLast,
    destroyEmpty
);
import Standard.String (
    String,
    destroyString
);
import Standard.Arguments (
    processArguments
);
import Standard.SperliError (
    badLaunch,
    describe
);
import Standard.SperliLaunch (
    RunOptions,
    parseRunArguments,
    runJob
);

module body Run.Main is
    function destroyWords(words: Buffer[String]): Unit is
        var rest: Buffer[String] := words;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    -- A refusal code of the launcher is status 1, an exit status of a rank
    -- is kept up to 125, the largest a programme may give.
    function exitByte(status: Int32): Nat8 is
        if (status < 1) or (status >= 1000) then
            return 1;
        end if;
        if status > 125 then
            return 125;
        end if;
        case toNat8(status) of
            when Some(value as byte: Nat8) do
                return byte;
            when None do
                return 1;
        end case;
    end;

    function main(root: RootCapability): ExitCode is
        let words: Buffer[String] := processArguments();
        var status: Int32 := 0;
        case parseRunArguments(&words) of
            when Left(left as code: Int32) do
                print("hilde run: H");
                print(code);
                print(" ");
                printLn(describe(code));
                printLn("usage: hilde run -n N --hosts FILE [--deny-hosts FILE] [--checkpoint-dir DIR] [--checkpoint-every SECONDS] [--restart-max K] [--resume JOB] programme [arguments...]");
                status := 2;
            when Right(right as options: RunOptions) do
                status := runJob(options);
        end case;
        destroyWords(words);
        surrenderRoot(root);
        if status = 0 then
            return ExitSuccess();
        end if;
        return ExitStatus(status => exitByte(status));
    end;
end module body.
