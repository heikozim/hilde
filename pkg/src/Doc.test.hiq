import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.Buffer (
    Buffer,
    length as bufferLength
);
import Standard.Text (
    equal,
    contains,
    startsWith
);
import Standard.Arguments (
    destroyArguments
);
import Pkg.Api (
    Declaration,
    declarationsOf,
    destroyDeclarations
);
import Pkg.Doc (
    describe,
    llmsText,
    moduleNames,
    manualPage,
    exampleOf
);

module body Pkg.Doc.Test is
    constant source: Span[Nat8, Static] := "\"\"\"\nDoubling numbers.  A second sentence.\n\n- At most a thousand.\n- No overflow: the result fits.\n\n    let n: Int64 := double(21);\n    printLn(n);\n\"\"\"\nmodule Acme.M is\n    \"\"\"\n    Twice the number.  It never fails.\n    \"\"\"\n    function double(n: Int64): Int64\n        requires n < 1000\n        ensures result = (n * 2);\n\n    \"\"\"\n    A path with a back\\slash.\n    \"\"\"\n    function half(n: Int64): Int64;\nend module.\n";

    function testDescribe(): Unit is
        let all: Buffer[Declaration] := declarationsOf(source);
        case describe(&all, "Acme.M.double") of
            when Some(value as text: String) do
                assertTrue(startsWith(asSpan(&text), "Acme.M: function double(n: Int64): Int64\n    requires n < 1000\n    ensures result = (n * 2)\n"), "signature and contracts");
                assertTrue(contains(asSpan(&text), "Twice the number."), "the docstring");
                destroyString(text);
            when None do
                assertFailure("double was not found");
        end case;
        case describe(&all, "Acme.M") of
            when Some(value as text: String) do
                assertTrue(contains(asSpan(&text), "function half(n: Int64): Int64"), "the module lists its functions");
                destroyString(text);
            when None do
                assertFailure("the module was not found");
        end case;
        case describe(&all, "Acme.M.triple") of
            when Some(value as text: String) do
                destroyString(text);
                assertFailure("a name that is not there was found");
            when None do
                assertSuccess("a name that is not there is None");
        end case;
        let names: Buffer[String] := moduleNames(&all);
        assertTrue(bufferLength(&names) = 1, "one module");
        destroyArguments(names);
        let llms: String := llmsText(&all, "Acme.M", "v1.0.0");
        assertTrue(startsWith(asSpan(&llms), "# Acme.M v1.0.0\n"), "llms.txt names the package");
        assertTrue(contains(asSpan(&llms), "## Acme.M\n"), "and its module");
        destroyString(llms);
        let example: String := exampleOf("Head.\n\n    let a: Int64 := 1;\n    printLn(a);\n");
        assertTrue(equal(asSpan(&example), "let a: Int64 := 1;\nprintLn(a);"), "the example without its indent");
        destroyString(example);
        destroyDeclarations(all);
        return nil;
    end;

    function testManual(): Unit is
        let all: Buffer[Declaration] := declarationsOf(source);
        case manualPage(&all, "Acme.M", "October 26, 2026") of
            when Some(value as page: String) do
                assertTrue(startsWith(asSpan(&page), ".Dd October 26, 2026\n.Dt ACME.M 3\n.Os\n.Sh NAME\n.Nm Acme.M\n.Nd Doubling numbers\n"), "the head of the page");
                assertTrue(contains(asSpan(&page), "Doubling numbers.\nA second sentence."), "a new line after each sentence");
                assertTrue(contains(asSpan(&page), ".It requires\n.Li n < 1000\n"), "the contracts");
                assertTrue(contains(asSpan(&page), "back\\eslash"), "a backslash escaped");
                assertTrue(contains(asSpan(&page), ".Sh EXAMPLES\n.Bd -literal -offset indent\nlet n: Int64 := double(21);\n"), "the example");
                destroyString(page);
            when None do
                assertFailure("no page");
        end case;
        destroyDeclarations(all);
        return nil;
    end;
end module body.
