import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    fromLiteral,
    asSpan
);
import Standard.Text (
    equal,
    startsWith,
    contains
);
import Standard.File (
    kindOf,
    kindRegular,
    sameKind
);
import Pkg.Report (
    Problem,
    destroyProblem
);
import Pkg.Manifest (
    Manifest,
    readManifest,
    nameOf,
    destroyManifest
);
import Pkg.Files (
    readText,
    isThere
);
import Pkg.Tree (
    removeTree
);
import Pkg.New (
    NewPlan,
    newPackage,
    newModule,
    destroyPlan
);

module body Pkg.New.Test is
    function plan(name: Span[Nat8, Static], binary: Bool, packaging: Bool): NewPlan is
        return NewPlan(name => fromLiteral(name), binary => binary, packaging => packaging, author => fromLiteral("A. Author <a@example.org>"), seconds => 1793000000);
    end;

    function cleared(path: Span[Nat8, Static]): Unit is
        case removeTree(path) of
            when Right(right as done: Unit) do
                skip;
            when Left(left as p: Problem) do
                destroyProblem(p);
                assertFailure("a tree was not removed");
        end case;
        return nil;
    end;

    function holds(path: Span[Nat8, Static], start: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case readText(path) of
            when Some(value as text: String) do
                assertTrue(startsWith(asSpan(&text), start), message);
                destroyString(text);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function has(path: Span[Nat8, Static], part: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case readText(path) of
            when Some(value as text: String) do
                assertTrue(contains(asSpan(&text), part), message);
                destroyString(text);
            when None do
                assertFailure(message);
        end case;
        return nil;
    end;

    function testLibrary(): Unit is
        cleared("_new-test");
        cleared("_new-test-bin");
        let p: NewPlan := plan("Acme.Json", false, true);
        case newPackage(&p, "_new-test") of
            when Right(right as count: Index) do
                assertTrue(count = 13, "thirteen files with packaging");
            when Left(left as problem: Problem) do
                destroyProblem(problem);
                assertFailure("the package was not made");
        end case;
        case readText("_new-test/Acme.Json/hilde.toml") of
            when Some(value as toml: String) do
                case readManifest(asSpan(&toml)) of
                    when Right(right as m: Manifest) do
                        assertTrue(equal(nameOf(&m), "Acme.Json"), "the manifest names the package");
                        destroyManifest(m);
                    when Left(left as problem: Problem) do
                        destroyProblem(problem);
                        assertFailure("the manifest written does not read");
                end case;
                destroyString(toml);
            when None do
                assertFailure("no hilde.toml");
        end case;
        holds("_new-test/Acme.Json/CHANGELOG", "acme-json (0.1.0) unstable; urgency=medium\n\n  * First version.\n\n -- A. Author <a@example.org>  Mon, 26 Oct 2026 07:33:20 +0000\n", "the changelog in the form of Debian");
        holds("_new-test/Acme.Json/LICENSE", "Copyright (c) 2026 A. Author <a@example.org>\n", "the licence names year and author");
        holds("_new-test/Acme.Json/src/Json.hih", "--\n-- SPDX-FileCopyrightText: 2026 A. Author <a@example.org>\n-- SPDX-License-Identifier: ISC\n--\n", "the SPDX header");
        has("_new-test/Acme.Json/src/Json.hih", "module Acme.Json is", "the module line");
        has("_new-test/Acme.Json/src/Json.test.hiq", "module body Acme.Json.Test is", "the test module");
        has("_new-test/Acme.Json/packaging/make_openbsd_package", "@name acme-json-%s", "the OpenBSD packing list");
        assertTrue(sameKind(kindOf("_new-test/Acme.Json/hilde.sum"), kindRegular), "an empty hilde.sum");
        case newPackage(&p, "_new-test") of
            when Right(right as count: Index) do
                assertFailure("a package was written over one that is there");
            when Left(left as problem: Problem) do
                assertTrue(problem.code = 1521, "a package that is there is H1521");
                destroyProblem(problem);
        end case;
        destroyPlan(p);
        let m: NewPlan := plan("Acme.Json.Parse.Lexer", false, false);
        case newModule(&m, "_new-test/Acme.Json") of
            when Right(right as count: Index) do
                assertTrue(count = 3, "three files of a module");
                has("_new-test/Acme.Json/src/Parse/Lexer.hih", "module Acme.Json.Parse.Lexer is", "the module below src/Parse");
            when Left(left as problem: Problem) do
                destroyProblem(problem);
                assertFailure("the module was not made");
        end case;
        destroyPlan(m);
        let other: NewPlan := plan("Other.Thing", false, false);
        case newModule(&other, "_new-test/Acme.Json") of
            when Right(right as count: Index) do
                assertFailure("a module of another prefix was made");
            when Left(left as problem: Problem) do
                assertTrue(problem.code = 1505, "a module of another prefix is H1505");
                destroyProblem(problem);
        end case;
        destroyPlan(other);
        cleared("_new-test");
        return nil;
    end;

    function testBinary(): Unit is
        cleared("_new-test-bin");
        let p: NewPlan := plan("Tool", true, false);
        case newPackage(&p, "_new-test-bin") of
            when Right(right as count: Index) do
                assertTrue(count = 9, "nine files without packaging");
                has("_new-test-bin/Tool/src/Tool.hih", "function main(): ExitCode;", "a programme has main");
                assertTrue(not isThere("_new-test-bin/Tool/packaging"), "no packaging asked for");
            when Left(left as problem: Problem) do
                destroyProblem(problem);
                assertFailure("the programme was not made");
        end case;
        destroyPlan(p);
        let bad: NewPlan := plan("acme", false, false);
        case newPackage(&bad, "_new-test-bin") of
            when Right(right as count: Index) do
                assertFailure("a name that is no prefix was taken");
            when Left(left as problem: Problem) do
                assertTrue(problem.code = 1505, "a bad name is H1505");
                destroyProblem(problem);
        end case;
        destroyPlan(bad);
        cleared("_new-test-bin");
        return nil;
    end;
end module body.
