"""
hilde get: the required packages fetched with git, their versions chosen by minimal version selection, vendor/ and hilde.sum written.

- Every version any selected package requires is visited; each prefix gets the greatest of them, never a newer one.
- Versions of one prefix with another major are refused with H1516: a new major is a new prefix.
- One prefix from two git URLs is refused with H1506, and so is a package whose own name is not the prefix it was required by.
- A release is signed when its tree has signatures/vX.Y.Z.sig, a signify signature of the line h1: and its checksum.
- The key is the one hilde.sum holds for the prefix, else the one the requirement names, else the package's own; it is taken on first use.
- A signature that fails, or a release without one where the key was used before, is H1512; without one under require-signatures H1511.
- Nothing in vendor/ or hilde.sum changes unless every package was fetched and checked.

    let got: Got := getPackages(".", None());
"""
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);
import Standard.Semver (
    Version
);
import Pkg.Report (
    Problem
);

module Pkg.Get is
    """
    What get did: the packages now in vendor/, a line to print, and the
    problems, none when it worked.
    """
    record Got: Linear is
        count: Index;
        summary: String;
        problems: Buffer[Problem];
    end;

    """
    One package and version asked for on the command line, with the git
    URL for a prefix the manifest does not require yet; an empty git keeps
    the URL of the manifest.
    """
    record Wanted: Linear is
        prefix: String;
        version: Version;
        git: String;
    end;

    """
    Reads Prefix@vX.Y.Z.  The Left is H1505 when the text is not of that
    form.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [T: Region, G: Region]
    function readWanted(text: Span[Nat8, T], git: Span[Nat8, G]): Either[Problem, Wanted];

    """
    Runs get in the package at root, with the package asked for, if any.
    The cache of the clones, root/.hilde-cache, is removed at the end.
    No contract: an I/O result: what git fetched and what is on the disk.
    """
    generic [R: Region]
    function getPackages(root: Span[Nat8, R], wanted: Option[Wanted]): Got;

    """
    Frees what get gave back.
    No contract: it only frees or closes what it is given.
    """
    function destroyGot(got: Got): Unit;
end module.
