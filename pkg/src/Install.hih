"""
hilde install: the package put into a staging tree, as a system package wraps it.

- Every path is destdir followed by prefix; nothing is written outside destdir.
- A programme, a package whose main module declares main, is built into bin under the name in small letters.
- A library is installed as its sources into share/hilde and its name, for packages that build on it.
- The manual pages of man/man1 and man/man3 go to share/man, on OpenBSD to man unless the prefix is /usr.
- The licence and the changelog go to share/doc and the name in small letters.

    let done: Got := installPackage(".", "/usr/local", "stage", "/usr/local/bin/hilde");
"""
import Pkg.Get (
    Got
);

module Pkg.Install is
    """
    Installs the package at root below destdir and prefix, building a
    programme with the compiler at compiler.
    No contract: an I/O result: what the compiler and the disk said.
    """
    generic [R: Region, P: Region, D: Region, C: Region]
    function installPackage(root: Span[Nat8, R], prefix: Span[Nat8, P], destdir: Span[Nat8, D], compiler: Span[Nat8, C]): Got;
end module.
