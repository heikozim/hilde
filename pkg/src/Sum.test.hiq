import Standard.Testing (
    assertTrue,
    assertSuccess,
    assertFailure
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    length as bufferLength
);
import Standard.Text (
    equal
);
import Standard.Semver (
    makeVersion
);
import Pkg.Report (
    Problem,
    destroyProblem
);
import Pkg.Sum (
    SumEntry,
    makeEntry,
    readSum,
    formatSum,
    findEntry,
    destroyEntries
);

module body Pkg.Sum.Test is
    constant two: Span[Nat8, Static] := "Acme.Io v2.0.1 h1:AAAA key:-\nAcme.Json v1.2.3 h1:0sun7IhfChLljPygSUAzTwodjRy1DIkk5dSyTgM3A1M= key:RWSgBGDjdJGlv/Ssv2UqfdZ9kfEYS1czgn4S5ReDnx9m1cPHwyT0GMWY\n";

    function testRoundTrip(): Unit is
        case readSum(two) of
            when Right(right as entries: Buffer[SumEntry]) do
                assertTrue(bufferLength(&entries) = 2, "two entries");
                let text: String := formatSum(&entries);
                assertTrue(equal(asSpan(&text), two), "written back as read");
                destroyString(text);
                case findEntry(&entries, "Acme.Json") of
                    when Some(value as at: Index) do
                        assertTrue(at = 1, "the second line");
                    when None do
                        assertFailure("Acme.Json was not found");
                end case;
                destroyEntries(entries);
            when Left(left as p: Problem) do
                destroyProblem(p);
                assertFailure("a good file was refused");
        end case;
        case readSum("") of
            when Right(right as entries: Buffer[SumEntry]) do
                assertTrue(bufferLength(&entries) = 0, "an empty file has no entries");
                destroyEntries(entries);
            when Left(left as p: Problem) do
                destroyProblem(p);
                assertFailure("the empty file was refused");
        end case;
        return nil;
    end;

    function testSorted(): Unit is
        var entries: Buffer[SumEntry] := allocateEmpty();
        insertBack(&!entries, makeEntry("Acme.Json", makeVersion(1, 2, 3), "h1:B", ""));
        insertBack(&!entries, makeEntry("Acme.Io", makeVersion(2, 0, 1), "h1:A", "RWS"));
        let text: String := formatSum(&entries);
        assertTrue(equal(asSpan(&text), "Acme.Io v2.0.1 h1:A key:RWS\nAcme.Json v1.2.3 h1:B key:-\n"), "written sorted, a dash for no key");
        destroyString(text);
        destroyEntries(entries);
        return nil;
    end;

    function refused(text: Span[Nat8, Static], message: Span[Nat8, Static]): Unit is
        case readSum(text) of
            when Right(right as entries: Buffer[SumEntry]) do
                destroyEntries(entries);
                assertFailure(message);
            when Left(left as p: Problem) do
                assertTrue(p.code = 1514, message);
                destroyProblem(p);
        end case;
        return nil;
    end;

    function testRefused(): Unit is
        refused("Acme.Io v2.0.1 h1:A\n", "three fields");
        refused("Acme.Io 2.0.1 h1:A key:-\n", "a version without v");
        refused("acme v2.0.1 h1:A key:-\n", "no prefix");
        refused("Acme.Io v2.0.1 sha:A key:-\n", "no h1:");
        refused("Acme.Io v2.0.1 h1:A -\n", "no key:");
        refused("Acme.Json v1.0.0 h1:A key:-\nAcme.Io v1.0.0 h1:A key:-\n", "not sorted");
        refused("Acme.Io v1.0.0 h1:A key:-\nAcme.Io v1.0.1 h1:A key:-\n", "a prefix twice");
        return nil;
    end;
end module body.
