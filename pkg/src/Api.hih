"""
The difference between two versions of a package's interfaces, and the version it calls for: patch, minor or major.

- A declaration is known by its module, its kind and its name; its text is compared with runs of blanks made one.
- A declaration removed, or one whose signature changed, is major; one added is minor; nothing changed is patch.
- A requires added or changed is major, one removed minor; an ensures removed or changed is major, one added minor.
- A changed clause counts as major, since which of two conditions is stricter is not decided by its text.
- Docstrings and comments are not part of the interface.
- The places that call a function that broke are listed by file and line.

    let diff: ApiDiff := diffTrees("old", "new", "src");
    if diff.level = 2 then
        printLn("a new major version");
"""
import Standard.String (
    String
);
import Standard.Buffer (
    Buffer
);
import Pkg.Report (
    Problem
);

module Pkg.Api is
    """
    One public declaration of an interface: the module and name it is
    known by, the text of its signature, its requires as needs and its ensures as
    gives, and its docstring.
    """
    record Declaration: Linear is
        key: String;
        name: String;
        signature: String;
        needs: Buffer[String];
        gives: Buffer[String];
        docstring: String;
    end;

    """
    What changed: the level, 0 for patch, 1 for minor, 2 for major; a line
    for each change; and the places that call what broke.
    """
    record ApiDiff: Linear is
        level: Nat8;
        changes: Buffer[String];
        sites: Buffer[String];
    end;

    """
    The public declarations of the text of one .hih file, in their order,
    and the module's own docstring as the first, with the key module and
    the name of the module.
    No contract: the count of declarations is that of the text, which costs a pass over it.
    """
    generic [R: Region]
    function declarationsOf(text: Span[Nat8, R]): Buffer[Declaration];

    """
    The declarations of every .hih file below the directory, by the path
    from it in sorted order.  The Left as in Pkg.Tree.treeFiles.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [D: Region]
    function declarationsIn(directory: Span[Nat8, D]): Either[Problem, Buffer[Declaration]];

    """
    The difference of the interfaces below old and new, and the places
    below sites, a directory of sources, that call what broke.  The Left as
    in declarationsIn.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [O: Region, N: Region, S: Region]
    function diffTrees(old: Span[Nat8, O], new: Span[Nat8, N], sites: Span[Nat8, S]): Either[Problem, ApiDiff];

    """
    The word of a level: patch, minor or major.
    """
    function levelName(level: Nat8): Span[Nat8, Static]
        requires level <= 2
        ensures spanLength(result) = 5;

    """
    Frees the declarations.
    No contract: it only frees or closes what it is given.
    """
    function destroyDeclarations(declarations: Buffer[Declaration]): Unit;

    """
    Frees the difference.
    No contract: it only frees or closes what it is given.
    """
    function destroyDiff(diff: ApiDiff): Unit;
end module.
