"""
The file tree of a package: its files in order, its checksum, and copying and removing it.

- The files are the regular files below the root, by their path from the root, sorted byte by byte.
- At the top the directories .git, signatures, vendor, dist and .hilde-cache are left out.
- A symbolic link or a special file in the tree is refused with H1510, a tree deeper than 64 with H1517.
- The checksum is h1: and the base64 of the SHA-256 of the lines sha256-in-hex, two spaces, path, new line.
- The same files with the same bytes give the same checksum, wherever the tree came from.

    case treeSum("vendor/Acme.Json") of
        when Right(right as sum: String) do
            printLn(asSpan(&sum));
"""
import Standard.String (
    String
);
import Standard.Buffer (
    Buffer
);
import Pkg.Report (
    Problem
);

module Pkg.Tree is
    """
    How deep a tree may be: 64 directories.
    """
    function mostDepth(): Index
        ensures result = 64;

    """
    The paths of the files of the tree at root, sorted.  The Left is H1510
    for a link or a special file, H1517 for a tree too deep, H1518 for a
    directory that cannot be read.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function treeFiles(root: Span[Nat8, R]): Either[Problem, Buffer[String]];

    """
    The checksum of the tree at root, h1: and base64.  The Left as in
    treeFiles, or H1518 for a file that cannot be read.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function treeSum(root: Span[Nat8, R]): Either[Problem, String];

    """
    Copies the files of the tree at source into target, which must not be
    there yet; the directories are made as needed.  The Left as in
    treeFiles, or H1519 for a file or directory that cannot be written.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [S: Region, T: Region]
    function copyTree(source: Span[Nat8, S], target: Span[Nat8, T]): Either[Problem, Unit];

    """
    Removes the tree at path, everything below it, links themselves and
    not what they lead to.  Nothing there is no failure.  The Left is H1519
    when something could not be removed.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [P: Region]
    function removeTree(path: Span[Nat8, P]): Either[Problem, Unit];
end module.
