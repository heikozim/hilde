"""
The manifest of a package, hilde.toml: its name, version, key, capabilities, requirements, targets and policy.

- Only the tables package, require, c-source and policy and the array targets are taken; any other key is refused.
- A name is a module prefix: parts of a capital letter and letters or digits, joined by dots.
- A version is vX.Y.Z as Standard.Semver reads it.
- Text values hold no quote, no backslash and no control character, so they are written back as they were read.
- The text written is the canonical form, the tables in a fixed order; read again it gives the same manifest.

    case readManifest(asSpan(&text)) of
        when Right(right as manifest: Manifest) do
            let again: String := formatManifest(&manifest);
"""
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);
import Standard.Semver (
    Version
);
import Pkg.Report (
    Problem
);

module Pkg.Manifest is
    """
    One requirement: the prefix of the package, where git finds it, the
    least version it needs, and the public key it must be signed by, or an
    empty text when none is named.
    """
    record Requirement: Linear is
        prefix: String;
        git: String;
        version: Version;
        key: String;
    end;

    """
    The whole manifest.  key and cDir may be empty; cDir is c when the
    table c-source does not name one.
    """
    record Manifest: Linear is
        name: String;
        version: Version;
        key: String;
        capabilities: Buffer[String];
        needs: Buffer[Requirement];
        targets: Buffer[String];
        commitC: Bool;
        cDir: String;
        requireSignatures: Bool;
    end;

    """
    Whether the text is a module prefix: one or more parts, each a capital
    letter and then letters and digits, joined by single dots.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isPrefix(text: Span[Nat8, R]): Bool;

    """
    Whether the text may stand as a value of the manifest: no quote, no
    backslash, no byte below a space and no delete.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function isPlainValue(text: Span[Nat8, R]): Bool;

    """
    The name of the manifest, its module prefix.
    """
    generic [R: Region]
    function nameOf(manifest: &[Manifest, R]): Span[Nat8, R]
        ensures spanLength(result) = length(&(manifest->name));

    """
    The length of the name of the manifest.
    """
    generic [R: Region]
    function nameLength(manifest: &[Manifest, R]): Index
        ensures result = length(&(manifest->name));

    """
    The length of the prefix of the requirement.
    """
    generic [R: Region]
    function prefixLength(requirement: &[Requirement, R]): Index
        ensures result = length(&(requirement->prefix));

    """
    The prefix of the requirement.
    """
    generic [R: Region]
    function prefixOf(requirement: &[Requirement, R]): Span[Nat8, R]
        ensures spanLength(result) = length(&(requirement->prefix));

    """
    A manifest with the name and version and nothing else, as hilde new
    writes it.
    """
    generic [N: Region]
    function makeManifest(name: Span[Nat8, N], version: Version): Manifest
        requires isPrefix(name)
        ensures nameLength(&result) = spanLength(name);

    """
    The requirement of the three values, the texts copied.
    """
    generic [P: Region, G: Region, K: Region]
    function makeRequirement(prefix: Span[Nat8, P], git: Span[Nat8, G], version: Version, key: Span[Nat8, K]): Requirement
        requires (isPrefix(prefix) and isPlainValue(git)) and isPlainValue(key)
        ensures prefixLength(&result) = spanLength(prefix);

    """
    The manifest the text stands for.  The Left says what was wrong: H1502
    for text that is not TOML, with its line and column, H1503 for a key
    the manifest does not have, H1504 for a missing name or version, H1505
    for a value of the wrong kind or form.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readManifest(text: Span[Nat8, R]): Either[Problem, Manifest];

    """
    The manifest as the text of hilde.toml, in the canonical form.
    """
    generic [R: Region]
    function formatManifest(manifest: &[Manifest, R]): String
        ensures length(&result) > 0;

    """
    Where the requirement of the prefix stands among the requirements, or
    None when there is none.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function findRequirement(manifest: &[Manifest, R], prefix: Span[Nat8, P]): Option[Index];

    """
    Sets the requirement of its prefix: the one there is replaced, or the
    new one is added at the end.  The manifest is taken and given back.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function setRequirement(manifest: Manifest, requirement: Requirement): Manifest;

    """
    Frees a requirement.
    No contract: it only frees or closes what it is given.
    """
    function destroyRequirement(requirement: Requirement): Unit;

    """
    Frees the manifest.
    No contract: it only frees or closes what it is given.
    """
    function destroyManifest(manifest: Manifest): Unit;
end module.
