"""
The targets a package can be built for: those every module it reaches through its imports names in pragma Targets.

- The modules are found in the package's src, in each tree of vendor/ and in the standard library beside the compiler.
- A module without pragma Targets limits nothing.
- The walk starts at the modules of src and follows every import, each module once.
- A target the package names in hilde.toml and a module it reaches does not name is a problem, with the module named.

    let reach: Reach := reachTargets(&dirs);
    let problems: Buffer[Problem] := targetProblems(&wanted, &reach);
"""
import Standard.String (
    String
);
import Standard.Buffer (
    Buffer
);
import Pkg.Report (
    Problem
);

module Pkg.Targets is
    """
    What the walk found: the targets every reached module allows, all of
    linux openbsd freebsd darwin wasm when none limits them, and for each
    target that some module leaves out, the first such module, as lines of
    target, a blank and module.
    """
    record Reach: Linear is
        allowed: Buffer[String];
        limits: Buffer[String];
    end;

    """
    Walks the imports from the modules of the first directory through all
    the directories, which are searched in their order for a module.
    No contract: an I/O result: what is on the disk.
    """
    generic [D: Region]
    function reachTargets(dirs: &[Buffer[String], D]): Reach;

    """
    H1523 for each target of wanted that the reach does not allow, naming
    the module that leaves it out.
    No contract: the count is that of the targets left out, which costs a pass.
    """
    generic [W: Region, R: Region]
    function targetProblems(wanted: &[Buffer[String], W], reach: &[Reach, R]): Buffer[Problem];

    """
    The directories of the walk for the package at root: its src, the src
    of each tree of vendor/, and the directory library, the standard
    library beside the compiler.
    No contract: an I/O result: what is on the disk.
    """
    generic [R: Region, L: Region]
    function packageDirs(root: Span[Nat8, R], library: Span[Nat8, L]): Buffer[String];

    """
    The allowed targets of the reach as one text, each followed by a blank.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function allowedText(reach: &[Reach, R]): String;

    """
    Frees the reach.
    No contract: it only frees or closes what it is given.
    """
    function destroyReach(reach: Reach): Unit;
end module.
