"""
The documentation of a package from its interfaces: the text of hilde doc, the file llms.txt and manual pages in mdoc.

- Everything comes from the .hih files: the module head, each declaration with its contracts and its docstring.
- hilde doc names a module, or a module, a dot and a declaration, and reads no network.
- llms.txt lists every module of the package with its head and every declaration with its signature.
- A manual page is mdoc(7) of section 3: the name, the synopsis, a description with each declaration and its contracts, and the example.
- Text in a manual page has its backslashes and a leading dot or quote escaped, so mandoc reads it as text.

    let page: String := manualPage(&declarations, "Acme.Json", "October 25, 2026");
"""
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);
import Pkg.Api (
    Declaration
);

module Pkg.Doc is
    """
    The text hilde doc prints for what, a module or Module.name, found
    among the declarations, or None when there is none of that name.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [D: Region, W: Region]
    function describe(declarations: &[Buffer[Declaration], D], what: Span[Nat8, W]): Option[String];

    """
    The text of llms.txt for the package of the name and version, from its
    declarations.
    """
    generic [D: Region, N: Region, V: Region]
    function llmsText(declarations: &[Buffer[Declaration], D], name: Span[Nat8, N], version: Span[Nat8, V]): String
        ensures length(&result) > spanLength(name);

    """
    The names of the modules among the declarations, in their order.
    No contract: the count is that of the modules, which costs a pass.
    """
    generic [D: Region]
    function moduleNames(declarations: &[Buffer[Declaration], D]): Buffer[String];

    """
    The manual page of the module owner, in mdoc of section 3, dated by date as
    mdoc writes it, such as October 25, 2026.  None when the module is not
    among the declarations.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [D: Region, M: Region, T: Region]
    function manualPage(declarations: &[Buffer[Declaration], D], owner: Span[Nat8, M], date: Span[Nat8, T]): Option[String];

    """
    The date of a manual page for the time in seconds since the epoch, in
    UTC, as mdoc writes it: October 26, 2026.
    """
    function mdocDate(seconds: Int64): String
        ensures length(&result) >= 11;

    """
    The example of a docstring: its lines indented by four blanks, the
    indent taken off, joined by new lines; empty when it has none.
    No contract: a text whose length follows its input.
    """
    generic [S: Region]
    function exampleOf(docstring: Span[Nat8, S]): String;
end module.
