"""
hilde verify: the vendored trees of a package held against hilde.sum and its manifest, without the network.

- Every requirement of hilde.toml has a line in hilde.sum, at its version or a greater one of the same major.
- Every line of hilde.sum has its tree in vendor/ under its prefix, and the checksum of that tree is the one of the line.
- vendor/ holds no tree that hilde.sum does not name.
- Every target of hilde.toml is allowed by the pragma Targets of every module the package reaches.
- Every problem is reported, not only the first.

    let report: Verified := verifyPackage(".", "/usr/local/share/hilde/standard/src");
    if length(&report.problems) = 0 then
        printLn("vendor/ is what hilde.sum says");
"""
import Standard.Buffer (
    Buffer
);
import Pkg.Report (
    Problem
);

module Pkg.Verify is
    """
    What verify found: how many trees it held against hilde.sum, and the
    problems, none when everything holds.
    """
    record Verified: Linear is
        checked: Index;
        problems: Buffer[Problem];
    end;

    """
    Holds the package at root as the module's text says.  The targets of
    hilde.toml are held against the modules it reaches, with the standard
    library at library: H1523 for one that a module leaves out.  A missing or bad
    hilde.toml is H1501 or the code readManifest gives, a missing or bad
    hilde.sum or a requirement without its line H1514, a tree that is
    missing, stray or not of its checksum H1515.
    No contract: an I/O result: what is on the disk.
    """
    generic [R: Region, L: Region]
    function verifyPackage(root: Span[Nat8, R], library: Span[Nat8, L]): Verified;

    """
    Frees the report.
    No contract: it only frees or closes what it is given.
    """
    function destroyVerified(verified: Verified): Unit;
end module.
