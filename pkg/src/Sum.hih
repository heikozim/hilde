"""
The checksum file of a package, hilde.sum: one line per dependency with its version, tree checksum and key.

- A line is the prefix, the version, the checksum h1: and base64, and key: with a signify public key or a dash.
- The fields are separated by one space and the line ends with a new line; the lines are sorted by prefix.
- A prefix stands at most once; reading refuses a second line for it with H1514, as any other bad line.
- An empty file is a package without dependencies.

    case readSum(asSpan(&text)) of
        when Right(right as entries: Buffer[SumEntry]) do
            let again: String := formatSum(&entries);
"""
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);
import Standard.Semver (
    Version
);
import Pkg.Report (
    Problem
);

module Pkg.Sum is
    """
    One line: the prefix, its version, the checksum of its tree, and the
    base64 line of its signify key, or an empty text when it has none.
    """
    record SumEntry: Linear is
        prefix: String;
        version: Version;
        sum: String;
        key: String;
    end;

    """
    The entry of the four values, the texts copied.
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    generic [P: Region, S: Region, K: Region]
    function makeEntry(prefix: Span[Nat8, P], version: Version, sum: Span[Nat8, S], key: Span[Nat8, K]): SumEntry;

    """
    The entries of the text of hilde.sum, in the order of their lines.  The
    Left is H1514 with the number of the line that is not of the form, or
    that names a prefix a second time, or whose lines are not sorted.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [R: Region]
    function readSum(text: Span[Nat8, R]): Either[Problem, Buffer[SumEntry]];

    """
    The text of hilde.sum of the entries, sorted by prefix; empty for no
    entries.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function formatSum(entries: &[Buffer[SumEntry], R]): String;

    """
    Where the entry of the prefix stands, or None.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [R: Region, P: Region]
    function findEntry(entries: &[Buffer[SumEntry], R], prefix: Span[Nat8, P]): Option[Index];

    """
    Frees one entry.
    No contract: it only frees or closes what it is given.
    """
    function destroyEntry(entry: SumEntry): Unit;

    """
    Frees the entries.
    No contract: it only frees or closes what it is given.
    """
    function destroyEntries(entries: Buffer[SumEntry]): Unit;
end module.
