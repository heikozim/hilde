"""
hilde new: the files of a new package, or of a new module in a package, written from templates.

- A package is a directory of its name with hilde.toml, hilde.sum, the changelog, the licence, README.md and .gitignore.
- Its sources are src/Last.hih, src/Last.hiq and src/Last.test.hiq, Last being the last part of the name.
- Every source starts with an SPDX header naming the ISC licence, the year and the author.
- The changelog has the form of a Debian changelog, the first entry version 0.1.0.
- With packaging, packaging/ gets scripts that wrap hilde install into a package for Debian, OpenBSD and FreeBSD, and a source archive.
- Nothing is written over a file that is there: a directory or a module file that exists is refused with H1521.

    let plan: NewPlan := NewPlan(name => fromLiteral("Acme.Json"), binary => false, packaging => true, author => fromLiteral("A. Author"), seconds => 1793000000);
    case newPackage(&plan, ".") of
"""
import Standard.String (
    String
);
import Pkg.Report (
    Problem
);

module Pkg.New is
    """
    What to make: the name of the package or module, whether it is a
    programme with a main function, whether packaging scripts come with it,
    the author for the licence and the changelog, and the time of the
    first changelog entry in seconds since the epoch.
    """
    record NewPlan: Linear is
        name: String;
        binary: Bool;
        packaging: Bool;
        author: String;
        seconds: Int64;
    end;

    """
    Writes the new package below parent, in a directory of its name, and
    gives the number of files written.  The Left is H1505 for a name that
    is no module prefix, H1521 when the directory is there, H1519 when a
    file cannot be written.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [P: Region, D: Region]
    function newPackage(plan: &[NewPlan, P], parent: Span[Nat8, D]): Either[Problem, Index];

    """
    Writes the three files of a new module of the package at root, whose
    name is the name of the plan.  The module name must start with the
    name of the package and a dot; its file is below src/ by the parts
    after that, such as src/Parse/Lexer.hih for Acme.Json.Parse.Lexer.  The
    Left as for newPackage, and H1501 when root has no hilde.toml.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [P: Region, R: Region]
    function newModule(plan: &[NewPlan, P], root: Span[Nat8, R]): Either[Problem, Index];

    """
    Frees the plan.
    No contract: it only frees or closes what it is given.
    """
    function destroyPlan(plan: NewPlan): Unit;
end module.
