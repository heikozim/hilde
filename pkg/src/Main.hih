"""
hilde-pkg, the package commands of Hilde: the compiler hands the words get, update, verify, export, new, install, doc and api-diff to it.

- Every command takes --json and then prints one JSON object with the command, ok and the problems.
- In text, what was done goes to standard output, each problem with its code and suggestion to standard error.
- The exit status is 0 when the command did what it was asked, 1 when it found a problem, 2 for a command line it does not take.
- Only get and update reach the network, through git.

    hilde new Acme.Json --packaging
    hilde verify --json
"""
module Pkg.Main is
    """
    The version of the package commands, the version of the compiler they
    come with.
    """
    function toolVersion(): Span[Nat8, Static]
        ensures spanLength(result) = 5;

    """
    The programme: reads the command line and runs the command.
    No contract: the exit code is the work of the programme.
    """
    function main(root: RootCapability): ExitCode;
end module.
