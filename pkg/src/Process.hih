"""
Running another programme for the package tool: found on PATH, started without a shell, its output read.

- A programme is looked up in the directories of PATH, in order, as a shell does; an empty part of PATH is skipped.
- The child gets its arguments as given; nothing is quoted, split or expanded.
- Its standard input is closed at once; its standard output and then its standard error are read to the end.
- The exit code is that of the child, or -1 when it ended by a signal.

    case findProgram("git") of
        when Some(value as git: String) do
            case runProgram(asSpan(&git), &arguments) of
"""
import Standard.String (
    String
);
import Standard.Buffer (
    Buffer
);
import Pkg.Report (
    Problem
);

module Pkg.Process is
    """
    What a programme left behind: its exit code and the bytes of its
    standard output and standard error.
    """
    record Ran: Linear is
        exitCode: Int32;
        output: String;
        errors: String;
    end;

    """
    The absolute path of the programme of the name in the directories of
    PATH, or None when it is in none of them or PATH is not set.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [N: Region]
    function findProgram(name: Span[Nat8, N]): Option[String];

    """
    Runs the programme at path with the arguments and waits for it.  The
    Left is H1508 when it could not be started.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [P: Region, A: Region]
    function runProgram(path: Span[Nat8, P], arguments: &[Buffer[String], A]): Either[Problem, Ran];

    """
    Frees what a run left.
    No contract: it only frees or closes what it is given.
    """
    function destroyRan(ran: Ran): Unit;
end module.
