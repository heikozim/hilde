import Standard.String (
    String,
    destroyString,
    fromSpan,
    asSpan,
    length
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString as writeText,
    finalize
);
import Standard.Text (
    formatInt
);
import Standard.Json (
    JsonWriter,
    beginObject,
    endObject,
    writeName,
    writeString
);

module body Pkg.Report is
    function lowestCode(): Int64 is
        return 1500;
    end;

    function highestCode(): Int64 is
        return 1599;
    end;

    generic [M: Region, S: Region]
    function makeProblem(code: Int64, message: Span[Nat8, M], suggestion: Span[Nat8, S]): Problem is
        return Problem(code => code, message => fromSpan(message), suggestion => fromSpan(suggestion));
    end;

    function problemOf(code: Int64, message: String, suggestion: String): Problem is
        return Problem(code => code, message => message, suggestion => suggestion);
    end;

    -- The code as H and four digits.
    function codeText(code: Int64): String is
        var out: StringBuilder := makeStringBuilder();
        writeByte(&!out, 'H');
        let digits: String := formatInt(code);
        writeText(&!out, asSpan(&digits));
        destroyString(digits);
        return finalize(out);
    end;

    generic [R: Region]
    function describeProblem(problem: &[Problem, R]): String is
        var out: StringBuilder := makeStringBuilder();
        let code: String := codeText(problem->code);
        writeText(&!out, asSpan(&code));
        destroyString(code);
        writeText(&!out, ": ");
        writeText(&!out, asSpan(&(problem->message)));
        writeByte(&!out, '\n');
        if length(&(problem->suggestion)) > 0 then
            writeText(&!out, "    suggestion: ");
            writeText(&!out, asSpan(&(problem->suggestion)));
            writeByte(&!out, '\n');
        end if;
        return finalize(out);
    end;

    generic [R: Region, W: Region]
    function writeProblem(writer: &![JsonWriter, W], problem: &[Problem, R]): Unit is
        beginObject(&~writer);
        writeName(&~writer, "code");
        let code: String := codeText(problem->code);
        writeString(&~writer, asSpan(&code));
        destroyString(code);
        writeName(&~writer, "message");
        writeString(&~writer, asSpan(&(problem->message)));
        writeName(&~writer, "suggestion");
        writeString(&~writer, asSpan(&(problem->suggestion)));
        endObject(&~writer);
        return nil;
    end;

    function destroyProblem(problem: Problem): Unit is
        let { code: Int64, message: String, suggestion: String } := problem;
        destroyString(message);
        destroyString(suggestion);
        return nil;
    end;
end module body.
