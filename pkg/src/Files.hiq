import Standard.String (
    String,
    destroyString,
    asSpan,
    length
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.File (
    FileDescriptor,
    openRead,
    readAll,
    closeFile,
    Directory,
    openDirectory,
    nextEntry,
    directoryFailed,
    closeDirectory,
    kindOf,
    kindUnknown,
    kindDirectory,
    sameKind,
    createDirectory
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack
);
import Standard.Order (
    TotalOrder
);
import Standard.Sort (
    sort
);
import Standard.Arguments (
    destroyArguments
);
import Standard.AtomicFile (
    AtomicFailure,
    writeAtomically,
    describeAtomicFailure
);

module body Pkg.Files is
    generic [P: Region]
    function directoryNames(path: Span[Nat8, P]): Option[Buffer[String]] is
        case openDirectory(path) of
            when Some(value as opened: Directory) do
                var directory: Directory := opened;
                var names: Buffer[String] := allocateEmpty();
                var more: Bool := true;
                while more do
                    case nextEntry(&!directory) of
                        when Some(value as name: String) do
                            insertBack(&!names, name);
                        when None do
                            more := false;
                    end case;
                end while;
                let failed: Bool := directoryFailed(&directory);
                let closed: Bool := closeDirectory(directory);
                if failed or (not closed) then
                    destroyArguments(names);
                    return None();
                end if;
                return Some(value => sort(names));
            when None do
                return None();
        end case;
    end;

    generic [P: Region]
    function readText(path: Span[Nat8, P]): Option[String] is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let bytes: Option[String] := readAll(&!file);
                let closed: Bool := closeFile(file);
                return bytes;
            when None do
                return None();
        end case;
    end;

    generic [P: Region, T: Region]
    function writeWithMode(path: Span[Nat8, P], text: Span[Nat8, T], mode: Nat32): Bool is
        case writeAtomically(path, text, mode) of
            when Right(right as done: Unit) do
                return true;
            when Left(left as failure: AtomicFailure) do
                let why: String := describeAtomicFailure(failure);
                destroyString(why);
                return false;
        end case;
    end;

    generic [P: Region, T: Region]
    function writeText(path: Span[Nat8, P], text: Span[Nat8, T]): Bool is
        return writeWithMode(path, text, 420);
    end;

    generic [P: Region, T: Region]
    function writeSecret(path: Span[Nat8, P], text: Span[Nat8, T]): Bool is
        return writeWithMode(path, text, 384);
    end;

    generic [P: Region, T: Region]
    function writeScript(path: Span[Nat8, P], text: Span[Nat8, T]): Bool is
        return writeWithMode(path, text, 493);
    end;

    generic [P: Region]
    function isThere(path: Span[Nat8, P]): Bool is
        return not sameKind(kindOf(path), kindUnknown);
    end;

    generic [P: Region]
    function isDirectory(path: Span[Nat8, P]): Bool is
        return sameKind(kindOf(path), kindDirectory);
    end;

    generic [A: Region, B: Region]
    function joinPath(a: Span[Nat8, A], b: Span[Nat8, B]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, a);
        if (spanLength(a) > 0) and (spanLength(b) > 0) then
            writeByte(&!out, '/');
        end if;
        writeString(&!out, b);
        return finalize(out);
    end;

    generic [P: Region]
    function makeDirectories(path: Span[Nat8, P]): Bool is
        var i: Index := 1;
        while i <= spanLength(path) do
            if (i = spanLength(path)) or (path[i] = '/') then
                var out: StringBuilder := makeStringBuilder();
                var j: Index := 0;
                while j < i do
                    writeByte(&!out, path[j]);
                    j := j + 1;
                end while;
                let part: String := finalize(out);
                if not isDirectory(asSpan(&part)) then
                    let made: Bool := createDirectory(asSpan(&part));
                end if;
                destroyString(part);
            end if;
            i := i + 1;
        end while;
        return isDirectory(path);
    end;
end module body.
