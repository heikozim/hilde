"""
The two questions the package tool asks git: which versions a repository has, and the tree of one of them.

- The versions are the tags of the form vX.Y.Z; every other tag is ignored.
- git is asked never to prompt for a password; a repository that wants one fails instead of waiting.
- A clone takes only the tagged commit, without history, into a directory that must not be there yet.
- A failure of git says what git said on its first line of errors.

    case listTags(asSpan(&git), "https://example.org/json.git") of
        when Right(right as tags: Buffer[Version]) do
            let newest: Version := nth(&tags, length(&tags) - 1);
"""
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);
import Standard.Semver (
    Version
);
import Pkg.Report (
    Problem
);

module Pkg.Git is
    """
    The versions the repository at url has as tags, sorted from the
    oldest, each once.  The Left is H1508 when git fails, with what git
    said.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [G: Region, U: Region]
    function listTags(git: Span[Nat8, G], url: Span[Nat8, U]): Either[Problem, Buffer[Version]];

    """
    Clones the tag of the version from url into directory.  The Left is
    H1509 when the repository has no such tag, with the tags nearest to
    it, and H1508 when git fails otherwise.
    No contract: an Either result, which an ensures cannot look into.
    """
    generic [G: Region, U: Region, D: Region]
    function cloneTag(git: Span[Nat8, G], url: Span[Nat8, U], version: Version, directory: Span[Nat8, D]): Either[Problem, Unit];

    """
    Up to three versions of tags around want, for a message: the greatest
    below it and the least above it, joined by commas; the empty text when
    there are no tags.
    No contract: a text whose length follows its input.
    """
    generic [R: Region]
    function nearestTags(tags: &[Buffer[Version], R], want: Version): String;
end module.
