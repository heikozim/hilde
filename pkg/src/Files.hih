"""
Reading and writing the small text files of a package: whole, and written so that a crash leaves the old or the new.

- A file is read whole into memory; the files here are manifests, sums and sources.
- A file is written beside itself and renamed into place, with mode 0644, or 0755 when asked.
- A path is joined from parts with single slashes; an empty part adds nothing.

    case readText("hilde.toml") of
        when Some(value as text: String) do
            let written: Bool := writeText("hilde.toml.new", asSpan(&text));
"""
import Standard.String (
    String,
    length
);
import Standard.Buffer (
    Buffer
);

module Pkg.Files is
    """
    The names in the directory at path, sorted, without dot and dot-dot;
    None when it cannot be read.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [P: Region]
    function directoryNames(path: Span[Nat8, P]): Option[Buffer[String]];

    """
    The bytes of the file at path, or None when it cannot be read.
    No contract: an Option result, which an ensures cannot look into.
    """
    generic [P: Region]
    function readText(path: Span[Nat8, P]): Option[String];

    """
    Writes text to path atomically with mode 0644, and says whether it
    worked.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region, T: Region]
    function writeText(path: Span[Nat8, P], text: Span[Nat8, T]): Bool;

    """
    Writes text to path atomically with mode 0600, for a secret key.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region, T: Region]
    function writeSecret(path: Span[Nat8, P], text: Span[Nat8, T]): Bool;

    """
    Writes text to path atomically with mode 0755, for a script.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region, T: Region]
    function writeScript(path: Span[Nat8, P], text: Span[Nat8, T]): Bool;

    """
    Whether something is at path, not following a link.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region]
    function isThere(path: Span[Nat8, P]): Bool;

    """
    Whether path is a directory.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region]
    function isDirectory(path: Span[Nat8, P]): Bool;

    """
    The two parts joined by a slash; one empty part gives the other.
    """
    generic [A: Region, B: Region]
    function joinPath(a: Span[Nat8, A], b: Span[Nat8, B]): String
        ensures length(&result) <= ((spanLength(a) + spanLength(b)) + 1);

    """
    Makes the directory and every directory above it that is missing, and
    says whether it is there afterwards.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [P: Region]
    function makeDirectories(path: Span[Nat8, P]): Bool;
end module.
