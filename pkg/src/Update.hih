"""
hilde update: each requirement raised to the newest tag of its major, kept only when the tests and guard still pass.

- A requirement is raised within its major only, never to a new one.
- With check nothing is changed: the raises there would be are listed.
- Each raise is tried alone, in the order of hilde.toml: get, then hilde test src and hilde guard; a raise that fails is taken back.
- The lines of the changelog of each package between the old and the new version are printed with it.
- At the end the text of a commit is printed that names every raise kept.

    let done: Got := updatePackages(".", false, "/usr/local/bin/hilde");
"""
import Pkg.Get (
    Got
);

module Pkg.Update is
    """
    Runs update in the package at root with the compiler at compiler; only
    lists what it would do when check is true.
    No contract: an I/O result: what git, the tests and the disk said.
    """
    generic [R: Region, C: Region]
    function updatePackages(root: Span[Nat8, R], check: Bool, compiler: Span[Nat8, C]): Got;
end module.
