"""
The messages of the package tool: a code from H1500 to H1599, what went wrong, and what to do.

- Every message carries its code, its text and a suggestion; the suggestion may be empty.
- As text a message is the line H15nn: text, then the suggestion indented under it.
- As JSON it is an object with the fields code, message and suggestion.

    let problem: Problem := makeProblem(1501, "hilde.toml was not found", "run hilde new Name");
    let text: String := describeProblem(&problem);
"""
import Standard.String (
    String,
    length
);
import Standard.Json (
    JsonWriter
);

module Pkg.Report is
    """
    One message: its code, what went wrong, and what to do about it.
    """
    record Problem: Linear is
        code: Int64;
        message: String;
        suggestion: String;
    end;

    """
    The lowest code of the package tool.
    """
    function lowestCode(): Int64
        ensures result = 1500;

    """
    The highest code of the package tool.
    """
    function highestCode(): Int64
        ensures result = 1599;

    """
    A message with its code, text and suggestion, each text copied.
    """
    generic [M: Region, S: Region]
    function makeProblem(code: Int64, message: Span[Nat8, M], suggestion: Span[Nat8, S]): Problem
        requires (code >= lowestCode()) and (code <= highestCode())
        ensures result.code = code;

    """
    A message whose texts are already strings, which it takes.
    """
    function problemOf(code: Int64, message: String, suggestion: String): Problem
        requires (code >= lowestCode()) and (code <= highestCode())
        ensures result.code = code;

    """
    The message as text: the line H15nn and the text, and when there is a
    suggestion a second line with it, each ending with a new line.
    """
    generic [R: Region]
    function describeProblem(problem: &[Problem, R]): String
        ensures length(&result) >= 7;

    """
    Writes the message as one JSON object with code, message and
    suggestion into writer.
    No contract: it changes its argument in place; the accessors of its type say what holds afterwards.
    """
    generic [R: Region, W: Region]
    function writeProblem(writer: &![JsonWriter, W], problem: &[Problem, R]): Unit;

    """
    Frees the message.
    No contract: it only frees or closes what it is given.
    """
    function destroyProblem(problem: Problem): Unit;
end module.
