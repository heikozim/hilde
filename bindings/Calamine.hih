"""
The layer over Bindings.C.Calamine, the bridge of the spreadsheet pilot.
A workbook is opened from the bytes of a file the caller holds; nothing
of Rust reaches Hilde, every string is copied into a buffer of the
caller, and a file the crate cannot read comes back as an error code and
no abort.  It hands addresses to C, so it is an unsafe module.
"""
import Hilde.Memory (
    Pointer,
    spanToPointer,
    spanWriteToPointer
);

import Bindings.C.Calamine (
    CalamineSheet as RawSheet,
    CalamineCell as RawCell,
    CalamineBytes as RawBytes,
    calamine_new,
    calamine_open,
    calamine_error,
    calamine_sheet_count,
    calamine_sheet_name,
    calamine_sheet_rows,
    calamine_sheet_columns,
    calamine_cell,
    calamine_cell_text,
    calamine_destroy
);

module Bindings.Calamine is
    """
    A workbook the C side owns.  The type is linear: freeSheet consumes
    the value, and nothing uses it afterwards.
    """
    type Sheet: Linear;

    """
    One cell of a workbook.  kind says which field is live; the values
    of the kinds stand in the kindEmpty and kindText functions.
    """
    record Cell: Free is
        kind: Int32;
        intValue: Int32;
        floatValue: Float64;
        boolValue: Bool;
    end;

    """
    The cell is empty.
    """
    function kindEmpty(): Int32
        ensures result = 0;

    """
    The cell holds text; read it with cellText.
    """
    function kindText(): Int32
        ensures result = 1;

    """
    The cell holds a number; read floatValue.
    """
    function kindFloat(): Int32
        ensures result = 2;

    """
    The cell holds an integer; read intValue.
    """
    function kindInteger(): Int32
        ensures result = 3;

    """
    The cell holds a truth value; read boolValue.
    """
    function kindTruth(): Int32
        ensures result = 4;

    """
    The cell holds an error of the spreadsheet.
    """
    function kindError(): Int32
        ensures result = 5;

    """
    The cell holds a date and time, as its serial number in floatValue.
    """
    function kindDateTime(): Int32
        ensures result = 6;

    """
    Makes a sheet that has opened no workbook yet.  The value owns the C
    object until freeSheet takes it.
    No contract: the value it gives back has no property but its type.
    """
    function newSheet(): Sheet;

    """
    Reads the workbook of bytes and gives the sheet back, so it can be
    used with the reads below.  The bytes are copied by the crate before
    this returns, so the span is free again after the call.  A file the
    crate cannot read opens nothing; sheetError then says why.
    """
    generic [R: Region]
    function openSheet(sheet: Sheet, bytes: Span[Nat8, R]): Sheet
        requires spanLength(bytes) > 0;

    """
    The error code of the last call that failed, 0 after one that did
    not.
    No contract: the answer is the work of C.
    """
    generic [R: Region]
    function sheetError(sheet: &[Sheet, R]): Int32;

    """
    The number of sheets of the workbook.
    No contract: the answer is the work of C.
    """
    generic [R: Region]
    function sheetCount(sheet: &[Sheet, R]): Index;

    """
    Copies the name of the sheet at index into buffer, at most room
    bytes, and gives the number of bytes written.  room is at most
    the length of buffer, which the caller reads with
    spanWriteLength(&buffer).  A call with no room is refused here, before C is
    reached.
    """
    generic [R: Region, B: Region]
    function sheetName(sheet: &[Sheet, R], index: Index, buffer: Span![Nat8, B], room: Index): Index
        requires room > 0;

    """
    The number of rows of the sheet at index.
    No contract: the answer is the work of C.
    """
    generic [R: Region]
    function sheetRows(sheet: &[Sheet, R], index: Index): Index;

    """
    The number of columns of the sheet at index.
    No contract: the answer is the work of C.
    """
    generic [R: Region]
    function sheetColumns(sheet: &[Sheet, R], index: Index): Index;

    """
    The cell at row and column of the sheet at index.
    No contract: the value it gives back has no property but its type.
    """
    generic [R: Region]
    function cellAt(sheet: &[Sheet, R], index: Index, row: Index, column: Index): Cell;

    """
    Copies the text of the cell at row and column into buffer, at most
    room bytes, and gives the number of bytes written, 0 for a cell that
    holds no text.  room is the length of buffer, as for sheetName, and a
    call with no room is refused here.
    """
    generic [R: Region, B: Region]
    function cellText(sheet: &[Sheet, R],
        index: Index,
        row: Index,
        column: Index,
        buffer: Span![Nat8, B],
        room: Index): Index
        requires room > 0;

    """
    Frees the C object.  The value is gone with it.
    No contract: a close function; what it does is the work of C.
    """
    function freeSheet(sheet: Sheet): Unit;
end module.
