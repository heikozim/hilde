"""
The layer over Bindings.C.Diag, the probe of a Diplomat-style C header.
It takes spans where the binding takes pointers, and it says in contracts
what the binding only says in words: the buffer for a message holds at
least one byte, and the handle comes back so it can be used again.
It hands addresses to C, so it is an unsafe module; a caller that needs
more holds on to the handle and the buffer it owns.
"""
import Hilde.Memory (
    Pointer,
    spanWriteToPointer
);

import Bindings.C.Diag (
    Diag as RawDiag,
    diag_new,
    diag_write,
    diag_destroy
);

module Bindings.Diag is
    """
    A diagnostic message the C side owns.  The type is linear: freeDiag
    consumes the value, and nothing uses it afterwards.
    """
    type Diag: Linear;

    """
    Makes one.  The value owns the C object until freeDiag takes it.
    No contract: the value it gives back has no property but its type.
    """
    function newDiag(): Diag;

    """
    Writes the message of the C object into buffer, at most room bytes,
    and gives the handle back, so it can be used again.  room is at most
    the length of buffer, which the caller reads with
    spanWriteLength(&buffer).  The C side takes at least one byte, so room
    of zero is refused here, before C is reached.
    """
    generic [R: Region]
    function writeDiag(message: Diag, buffer: Span![Nat8, R], room: Index): Diag
        requires room > 0;

    """
    Frees the C object.  The value is gone with it.
    No contract: a close function; what it does is the work of C.
    """
    function freeDiag(message: Diag): Unit;
end module.
