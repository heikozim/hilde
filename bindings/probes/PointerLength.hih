-- A negative control for the note the generator writes on a buffer and
-- its length.  The binding holds the buffer as a pointer, and a pointer
-- carries no length of its own, so the one way to name the duty that the
-- buffer holds n bytes is to read a span over it.  That call is C
-- written into the source, and a condition may not reach C: the compiler
-- refuses the contract with H3098.  The safe layer states the duty over
-- a span, where spanLength is free.
import Hilde.Memory (
    Pointer,
    span as makeSpan
);

module Bindings.Probe.PointerLength is
    """
    Takes the bytes behind out, at most n of them.
    """
    function takes(out: Pointer[Nat8], n: Index): Unit
        requires n <= spanLength(makeSpan(&out, 0, n));
end module.
