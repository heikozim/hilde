pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    spanToPointer,
    spanWriteToPointer
);

import Bindings.C.Calamine (
    CalamineSheet as RawSheet,
    CalamineCell as RawCell,
    CalamineBytes as RawBytes,
    calamine_new,
    calamine_open,
    calamine_error,
    calamine_sheet_count,
    calamine_sheet_name,
    calamine_sheet_rows,
    calamine_sheet_columns,
    calamine_cell,
    calamine_cell_text,
    calamine_destroy
);

module body Bindings.Calamine is
    record Sheet: Linear is
        inner: RawSheet;
    end;

    record Cell: Free is
        kind: Int32;
        intValue: Int32;
        floatValue: Float64;
        boolValue: Bool;
    end;

    function kindEmpty(): Int32 is
        return 0;
    end;

    function kindText(): Int32 is
        return 1;
    end;

    function kindFloat(): Int32 is
        return 2;
    end;

    function kindInteger(): Int32 is
        return 3;
    end;

    function kindTruth(): Int32 is
        return 4;
    end;

    function kindError(): Int32 is
        return 5;
    end;

    function kindDateTime(): Int32 is
        return 6;
    end;

    function newSheet(): Sheet is
        let made: RawSheet := calamine_new();
        return Sheet(inner => made);
    end;

    generic [R: Region]
    function openSheet(sheet: Sheet, bytes: Span[Nat8, R]): Sheet is
        if spanLength(bytes) = 0 then
            abort("openSheet: the file is empty");
        end if;
        let { inner: RawSheet } := sheet;
        let given: RawBytes := RawBytes(data => spanToPointer(bytes), len => spanLength(bytes));
        let opened: RawSheet := calamine_open(inner, given);
        return Sheet(inner => opened);
    end;

    generic [R: Region]
    function sheetError(sheet: &[Sheet, R]): Int32 is
        let inner: &[RawSheet, R] := &(sheet->inner);
        return calamine_error(inner);
    end;

    generic [R: Region]
    function sheetCount(sheet: &[Sheet, R]): Index is
        let inner: &[RawSheet, R] := &(sheet->inner);
        return calamine_sheet_count(inner);
    end;

    generic [R: Region, B: Region]
    function sheetName(sheet: &[Sheet, R], index: Index, buffer: Span![Nat8, B], room: Index): Index is
        if room = 0 then
            abort("sheetName: room is zero");
        end if;
        let inner: &[RawSheet, R] := &(sheet->inner);
        let out: Pointer[Nat8] := spanWriteToPointer(buffer);
        return calamine_sheet_name(inner, index, out, room);
    end;

    generic [R: Region]
    function sheetRows(sheet: &[Sheet, R], index: Index): Index is
        let inner: &[RawSheet, R] := &(sheet->inner);
        return calamine_sheet_rows(inner, index);
    end;

    generic [R: Region]
    function sheetColumns(sheet: &[Sheet, R], index: Index): Index is
        let inner: &[RawSheet, R] := &(sheet->inner);
        return calamine_sheet_columns(inner, index);
    end;

    generic [R: Region]
    function cellAt(sheet: &[Sheet, R], index: Index, row: Index, column: Index): Cell is
        let inner: &[RawSheet, R] := &(sheet->inner);
        let raw: RawCell := calamine_cell(inner, index, row, column);
        let { kind: Int32,
            int_value as number: Int32,
            float_value as value: Float64,
            bool_value as truth: Bool } := raw;
        return Cell(kind => kind,
            intValue => number,
            floatValue => value,
            boolValue => truth);
    end;

    generic [R: Region, B: Region]
    function cellText(sheet: &[Sheet, R],
        index: Index,
        row: Index,
        column: Index,
        buffer: Span![Nat8, B],
        room: Index): Index is
        if room = 0 then
            abort("cellText: room is zero");
        end if;
        let inner: &[RawSheet, R] := &(sheet->inner);
        let out: Pointer[Nat8] := spanWriteToPointer(buffer);
        return calamine_cell_text(inner, index, row, column, out, room);
    end;

    function freeSheet(sheet: Sheet): Unit is
        let { inner: RawSheet } := sheet;
        calamine_destroy(inner);
        return nil;
    end;
end module body.
