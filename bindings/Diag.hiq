pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    spanWriteToPointer
);

import Bindings.C.Diag (
    Diag as RawDiag,
    diag_new,
    diag_write,
    diag_destroy
);

module body Bindings.Diag is
    record Diag: Linear is
        inner: RawDiag;
    end;

    function newDiag(): Diag is
        let made: RawDiag := diag_new();
        return Diag(inner => made);
    end;

    generic [R: Region]
    function writeDiag(message: Diag, buffer: Span![Nat8, R], room: Index): Diag is
        if room = 0 then
            abort("writeDiag: room is zero");
        end if;
        let { inner: RawDiag } := message;
        let out: Pointer[Nat8] := spanWriteToPointer(buffer);
        let written: RawDiag := diag_write(inner, out, room);
        return Diag(inner => written);
    end;

    function freeDiag(message: Diag): Unit is
        let { inner: RawDiag } := message;
        diag_destroy(inner);
        return nil;
    end;
end module body.
