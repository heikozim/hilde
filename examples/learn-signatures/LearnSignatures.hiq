import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Base32 (
    encodeBase32,
    decodeBase32
);
import Standard.Otp (
    OtpSha1,
    totp,
    verifyTotp,
    otpauthUri
);
import Standard.X509 (
    PrivateKey,
    KeyKind,
    Rsa2048,
    MlDsa65,
    EcP256,
    generateKey,
    publicKeyDer,
    destroyPrivateKey
);
import Standard.Jws (
    algorithmOf,
    signCompact,
    verifyCompact,
    jwkOfPublicKey,
    publicKeyFromJwk,
    claimsProblem
);

module body Example.LearnSignatures is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    -- A token signed with a key of kind and verified with its public key.
    function token(kind: KeyKind): Unit is
        case generateKey(kind) of
            when Some(value as key: PrivateKey) do
                case publicKeyDer(&key) of
                    when Some(value as public: String) do
                        case signCompact(&key, "{\"sub\":\"ann\"}", "") of
                            when Some(value as jws: String) do
                                print(algorithmOf(kind));
                                print(": the token verifies: ");
                                case verifyCompact(asSpan(&jws), asSpan(&public)) of
                                    when Some(value as payload: String) do
                                        printLn(true);
                                        destroyString(payload);
                                    when None do
                                        printLn(false);
                                end case;
                                destroyString(jws);
                            when None do
                                printLn("no token");
                        end case;
                        destroyString(public);
                    when None do
                        printLn("no public key");
                end case;
                destroyPrivateKey(key);
            when None do
                printLn("no key");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        -- The secret of RFC 6238, as an authenticator app takes it.
        let secret: Span[Nat8, Static] := "12345678901234567890";
        let encoded: String := encodeBase32(secret);
        print("the secret in base32: ");
        printText(&encoded);
        printLn("");
        case decodeBase32(asSpan(&encoded)) of
            when Some(value as back: String) do
                print("and back: ");
                printText(&back);
                printLn("");
                destroyString(back);
            when None do
                printLn("not base32");
        end case;
        let uri: String := otpauthUri("Example", "ann@example.org", asSpan(&encoded), OtpSha1(), 6, 30);
        print("for the app: ");
        printText(&uri);
        printLn("");
        destroyString(uri);
        destroyString(encoded);
        case totp(secret, 59, 30, 8, OtpSha1()) of
            when Some(value as code: String) do
                print("the code at 59 seconds: ");
                printText(&code);
                printLn("");
                print("taken a step later with a window of one: ");
                printLn(verifyTotp(secret, asSpan(&code), 89, 30, 8, OtpSha1(), 1));
                print("taken two steps later: ");
                printLn(verifyTotp(secret, asSpan(&code), 119, 30, 8, OtpSha1(), 1));
                destroyString(code);
            when None do
                printLn("no code");
        end case;
        token(EcP256());
        token(Rsa2048());
        token(MlDsa65());
        print("claims of an ID token at 1000: ");
        case claimsProblem("{\"iss\":\"https://id.example\",\"aud\":\"wiki\",\"exp\":999}", "https://id.example", "wiki", "", 1000, 0) of
            when Some(value as why: String) do
                printText(&why);
                printLn("");
                destroyString(why);
            when None do
                printLn("they hold");
        end case;
        return ExitSuccess();
    end;
end module body.
