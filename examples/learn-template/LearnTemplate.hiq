import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeLast,
    destroyEmpty,
    length
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as textLength,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Example.LearnTemplate is
    record Line: Linear is
        name: String;
        count: Int32;
    end;

    record Order: Linear is
        customer: String;
        lines: Buffer[Line];
        rush: Bool;
    end;

    -- The template order.jinja, in the syntax of Jinja2, is read by the
    -- compiler and turned into code here: a name in the template that the
    -- record does not have, or a filter that does not exist, is a compile
    -- error, not a surprise at run time.
    generic [R: Region]
    function render(order: &[Order, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("order.jinja", order, out);
        return finalize(out);
    end;

    function destroyLines(lines: Buffer[Line]): Unit is
        var rest: Buffer[Line] := lines;
        while length(&rest) > 0 do
            let line: Line := removeLast(&!rest);
            let { name: String, count: Int32 } := line;
            destroyString(name);
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function main(): ExitCode is
        var lines: Buffer[Line] := allocateEmpty();
        insertBack(&!lines, Line(name => fromLiteral("apples"), count => 6));
        insertBack(&!lines, Line(name => fromLiteral("pears"), count => 2));
        insertBack(&!lines, Line(name => fromLiteral("plums"), count => 12));
        let order: Order := Order(
            customer => fromLiteral("Ann"),
            lines => lines,
            rush => true
        );
        let text: String := render(&order);
        printLn(getSpan(&text, 0, textLength(&text) - 1));
        destroyString(text);
        let { customer: String, lines as rest: Buffer[Line], rush: Bool } := order;
        destroyString(customer);
        destroyLines(rest);
        return ExitSuccess();
    end;
end module body.
