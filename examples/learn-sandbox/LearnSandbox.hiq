-- A programme that gives up what it does not need.  On OpenBSD the policy
-- becomes pledge, which leaves only the system calls of the promises, and
-- unveil, which hides every path but the ones named.  On macOS it becomes
-- a Seatbelt profile, under which the programme starts again, and on
-- FreeBSD capability mode with the working directory opened.  Linux has
-- neither; there Standard.Sandbox uses Landlock and seccomp where it can,
-- and this programme only says what is missing.
import Standard.File (
    FileDescriptor,
    openRead,
    closeFile
);
import Standard.Sandbox (
    Policy,
    makePolicy,
    allowPromises,
    allowPath,
    Report,
    applyPolicy,
    reportHas,
    mechanism_pledge,
    mechanism_unveil,
    mechanism_seatbelt,
    mechanism_capsicum
);

module body Example.LearnSandbox is
    function main(): ExitCode is
        -- Standard output and reading files, and of the file system only
        -- the working directory, for reading.
        let policy: Policy := allowPath(allowPromises(makePolicy(), "stdio rpath"), ".", "r");
        let report: Report := applyPolicy(policy);
        let pledged: Bool := reportHas(report, mechanism_pledge);
        let unveiled: Bool := reportHas(report, mechanism_unveil);
        let profiled: Bool := reportHas(report, mechanism_seatbelt);
        let capable: Bool := reportHas(report, mechanism_capsicum);
        print("pledge applied: ");
        printLn(pledged);
        print("unveil applied: ");
        printLn(unveiled);
        if profiled then
            printLn("seatbelt applied: true");
        end if;
        if capable then
            printLn("capsicum applied: true");
        end if;
        if ((pledged and unveiled) or profiled) or capable then
            -- A file outside the working directory no longer exists for
            -- this programme.
            case openRead("/etc/hosts") of
                when Some(value as opened: FileDescriptor) do
                    printLn("reading /etc/hosts: allowed, which must not happen");
                    let closed: Bool := closeFile(opened);
                when None do
                    printLn("reading /etc/hosts: refused");
            end case;
        else
            printLn("pledge and unveil are OpenBSD's; this system has neither");
        end if;
        return ExitSuccess();
    end;
end module body.
