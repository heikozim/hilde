import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    writeByte,
    finalize
);

module body Example.LearnText is
    -- print takes a span, not a String.  The last index is inclusive,
    -- and an empty string has no span, so it is asked first.
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    function main(): ExitCode is
        let hello: String := fromLiteral("Hello, ");
        let name: String := fromLiteral("Hilde");
        var builder: StringBuilder := makeStringBuilder();
        writeString(&!builder, asSpan(&hello));
        writeString(&!builder, asSpan(&name));
        writeByte(&!builder, '!');
        -- finalize consumes the builder and hands out the String.
        let greeting: String := finalize(builder);
        printText(&greeting);
        printLn("");
        print("length: ");
        printLn(length(&greeting));
        -- A String owns memory: it is Linear, and destroyed by name.
        destroyString(greeting);
        destroyString(hello);
        destroyString(name);
        return ExitSuccess();
    end;
end module body.
