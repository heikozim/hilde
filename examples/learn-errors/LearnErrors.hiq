module body Example.LearnErrors is
    -- Half of an even number, and nothing for an odd one.
    function halve(n: Int32): Option[Int32] is
        if (n - ((n / 2) * 2)) = 0 then
            let half: Int32 := n / 2;
            let some: Option[Int32] := Some(value => half);
            return some;
        else
            let none: Option[Int32] := None();
            return none;
        end if;
    end;

    -- ? after a call, as the whole right side of a let: a None makes
    -- this function return None at once, a Some gives its value.
    function eighth(n: Int32): Option[Int32] is
        let a: Int32 := halve(n)?;
        let b: Int32 := halve(a)?;
        let c: Int32 := halve(b)?;
        let some: Option[Int32] := Some(value => c);
        return some;
    end;

    function show(result: Option[Int32]): Unit is
        case result of
            when Some(value as v: Int32) do
                printLn(v);
            when None do
                printLn("odd on the way");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        show(eighth(40));
        show(eighth(12));
        -- An Option or Either nobody looks at is a compile error; a
        -- result that really does not matter is thrown away by name.
        ignore(halve(7));
        return ExitSuccess();
    end;
end module body.
