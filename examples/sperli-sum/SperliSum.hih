module Example.SperliSum is
    """
    The number of rows of the table: 3000000.  Row i holds the number i + 1.
    """
    function tableRows(): Nat64
        ensures result = 3000000;

    """
    The index of the first row that rank holds when rows rows are cut into
    size parts: the first rows mod size ranks get one row more, and the
    parts follow each other from row 0.
    """
    function shareFirst(rows: Nat64, size: Nat32, rank: Nat32): Nat64
        requires ((size >= 1) and (rank < size)) and (rows <= 2147483648)
        ensures result <= rows;

    """
    The number of rows that rank holds.
    """
    function shareCount(rows: Nat64, size: Nat32, rank: Nat32): Nat64
        requires ((size >= 1) and (rank < size)) and (rows <= 2147483648)
        ensures result <= rows;

    """
    The sum of the numbers first + 1 to first + count, the rows first to
    first + count - 1 of the table.
    """
    function rowSum(first: Nat64, count: Nat64): Nat64
        requires (first + count) <= 2147483648
        ensures result <= 2305843010287435776;

    """
    The total the whole table must give: rows * (rows + 1) / 2.
    """
    function expectedTotal(rows: Nat64): Nat64
        requires rows <= 2147483648
        ensures result <= 2305843010287435776;

    """
    Joins the job on the first line of the standard input, sums the share
    of this rank and takes part in the reduction to rank 0, which prints
    one line with the total.  The status is 0 when the total is right.
    No contract: the exit code of the programme, the result of what it did.
    """
    function main(root: RootCapability): ExitCode;
end module.
