--
-- Two engines for regular expressions.  Standard.Regex is written in Hilde
-- and takes the syntax of RE2: it runs in time proportional to the text
-- and has no lookaround and no back references.  Standard.Pcre calls the
-- PCRE2 library and takes its larger syntax, with a limit on the work a
-- single search may do.  The names of the two modules are kept apart by
-- the imports below, so every call says which engine it is.  Both know
-- the classes of Unicode, such as the letters of one script, and
-- Standard.UnicodeProperties, where Standard.Regex reads them, answers for
-- a single code point as well.  The source is plain ASCII, so the Greek
-- and German text below is written as the hexadecimal of its UTF-8.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Regex (
    Regex,
    compile,
    destroyRegex,
    replace,
    match,
    Found,
    find,
    foundStart,
    foundEnd,
    destroyFound
);
import Standard.Text (
    hexToBytes
);
import Standard.UnicodeProperties (
    generalCategory,
    scriptOf
);
import Standard.Pcre (
    Regex as PcreRegex,
    compile as pcreCompile,
    destroyRegex as pcreDestroyRegex,
    Found as PcreFound,
    find as pcreFind,
    foundStart as pcreFoundStart,
    foundEnd as pcreFoundEnd,
    destroyFound as pcreDestroyFound,
    replace as pcreReplace
);

module body Example.LearnRegex is
    -- The most work one search with PCRE2 may do before it gives up.
    constant limit: Nat32 := 1000000;

    function printText(text: String): Unit is
        let size: Index := length(&text);
        if size > 0 then
            printLn(getSpan(&text, 0, size - 1));
        else
            printLn("");
        end if;
        destroyString(text);
        return nil;
    end;

    -- The bytes of a text given as hexadecimal; the empty string when the
    -- hexadecimal is not well formed, which the texts below are.
    function fromHex(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as bytes: String) do
                return bytes;
            when None do
                return fromLiteral("");
        end case;
    end;

    function unicode(): Unit is
        -- "abc ", three Greek letters, " def".
        let mixed: String := fromHex("61626320ceb1ceb2ceb320646566");
        print("Standard.Regex: the Greek letters ");
        case compile("\\p{Greek}+") of
            when Right(right as re: Regex) do
                case find(&re, asSpan(&mixed)) of
                    when Some(value as hit: Found) do
                        print("from byte ");
                        print(foundStart(&hit));
                        print(" to ");
                        printLn(foundEnd(&hit));
                        destroyFound(hit);
                    when None do
                        printLn("no match");
                end case;
                destroyRegex(re);
            when Left(left as message: String) do
                printText(message);
        end case;
        -- The word Strasse in capitals, written with the capital sharp s,
        -- U+1E9E, against a pattern with the small one, U+00DF.
        let upperStreet: String := fromHex("53545241e1ba9e45");
        print("Standard.Regex: (?i) folds the sharp s: ");
        case compile("(?i)stra\\x{df}e") of
            when Right(right as re: Regex) do
                printLn(match(&re, asSpan(&upperStreet)));
                destroyRegex(re);
            when Left(left as message: String) do
                printText(message);
        end case;
        destroyString(upperStreet);
        -- One code point asked directly: alpha, U+03B1.
        let alpha: Index := 945;
        print("U+03B1: ");
        print(generalCategory(alpha));
        print(" ");
        printLn(scriptOf(alpha));
        destroyString(mixed);
        return nil;
    end;

    function main(): ExitCode is
        let text: String := fromLiteral("width=80 height=24 depth=x");
        -- The same pattern and the same rewrite for both engines: a name,
        -- an equals sign and a number become the number and the name.
        let pattern: String := fromLiteral("(\\w+)=(\\d+)");
        let rewrite: String := fromLiteral("\\2:\\1");

        print("Standard.Regex: ");
        case compile(asSpan(&pattern)) of
            when Right(right as re: Regex) do
                printText(replace(&re, asSpan(&text), asSpan(&rewrite)));
                destroyRegex(re);
            when Left(left as message: String) do
                printText(message);
        end case;

        print("Standard.Pcre:  ");
        case pcreCompile(asSpan(&pattern), limit) of
            when Right(right as re: PcreRegex) do
                case pcreReplace(&re, asSpan(&text), asSpan(&rewrite)) of
                    when Right(right as out: String) do
                        printText(out);
                    when Left(left as message: String) do
                        printText(message);
                end case;
                pcreDestroyRegex(re);
            when Left(left as message: String) do
                printText(message);
        end case;

        -- A lookahead: digits followed by " px", without taking the " px".
        -- PCRE2 has it; RE2's syntax does not, and the compiler refuses
        -- such a literal for Standard.Regex before the programme runs.
        let sizes: String := fromLiteral("40 em and 12 px");
        print("Standard.Pcre:  ");
        case pcreCompile("\\d+(?= px)", limit) of
            when Right(right as re: PcreRegex) do
                case pcreFind(&re, asSpan(&sizes)) of
                    when Right(right as found: Option[PcreFound]) do
                        case found of
                            when Some(value as hit: PcreFound) do
                                let start: Index := pcreFoundStart(&hit);
                                let stop: Index := pcreFoundEnd(&hit);
                                printLn(getSpan(&sizes, start, stop - 1));
                                pcreDestroyFound(hit);
                            when None do
                                printLn("no match");
                        end case;
                    when Left(left as message: String) do
                        printText(message);
                end case;
                pcreDestroyRegex(re);
            when Left(left as message: String) do
                printText(message);
        end case;

        destroyString(sizes);
        unicode();
        destroyString(rewrite);
        destroyString(pattern);
        destroyString(text);
        return ExitSuccess();
    end;
end module body.
