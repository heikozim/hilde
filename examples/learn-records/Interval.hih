"""
A closed interval of whole numbers whose low end is never above its high
end.  The type is opaque, so only this module builds and changes one, and
its invariant is checked whenever a value leaves the module.
"""
module Example.Interval is
    """
    An interval from low to high, both included.
    """
    type Interval: Linear;

    """
    The interval from low to high, or None when low is above high.
    No contract: an Option result, which an ensures cannot look into.
    """
    function makeInterval(low: Nat32, high: Nat32): Option[Interval];

    """
    How many numbers the interval holds: high minus low plus one.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function width(interval: &[Interval, R]): Nat32;

    """
    Moves the high end up by amount.  Returns false and leaves the interval
    as it was when the high end would pass the largest Nat32.
    No contract: the answer is a Bool, nothing cheaper holds.
    """
    generic [R: Region]
    function stretch(interval: &![Interval, R], amount: Nat32): Bool;

    """
    The high end of the interval.
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function highEnd(interval: &[Interval, R]): Nat32;

    """
    Ends the interval.
    No contract: it only frees or closes what it is given.
    """
    function destroyInterval(interval: Interval): Unit;
end module.
