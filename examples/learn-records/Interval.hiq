--
-- The invariant low <= high is checked at each return of a public
-- function, for a result of the type and for a write reference to it.  A
-- function that is not public may pass through a broken state; every
-- public one here keeps the rule, so the check never fires.
module body Example.Interval is
    record Interval: Linear is
        low: Nat32;
        high: Nat32;
        invariant low <= high;
    end;

    function makeInterval(low: Nat32, high: Nat32): Option[Interval] is
        if low > high then
            return None();
        else
            return Some(value => Interval(low => low, high => high));
        end if;
    end;

    generic [R: Region]
    function width(interval: &[Interval, R]): Nat32 is
        return (interval->high - interval->low) + 1;
    end;

    generic [R: Region]
    function stretch(interval: &![Interval, R], amount: Nat32): Bool is
        let largest: Nat32 := maximum_nat32;
        if amount > (largest - interval->high) then
            return false;
        else
            interval->high := interval->high + amount;
            return true;
        end if;
    end;

    generic [R: Region]
    function highEnd(interval: &[Interval, R]): Nat32 is
        return interval->high;
    end;

    function destroyInterval(interval: Interval): Unit is
        let { low: Nat32, high: Nat32 } := interval;
        return nil;
    end;
end module body.
