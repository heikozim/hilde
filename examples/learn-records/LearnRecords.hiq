--
-- Records and the references into them.  Example.Interval, beside this
-- file, has an opaque type with an invariant.  A Day holds two intervals;
-- a write reference to one of them is made with an ampersand, an
-- exclamation mark and the path in parentheses, and a borrow statement
-- names the region a reference lives in, for as long as its block runs.
import Example.Interval (
    Interval,
    makeInterval,
    width,
    stretch,
    highEnd,
    destroyInterval
);

module body Example.LearnRecords is
    record Day: Linear is
        morning: Interval;
        evening: Interval;
    end;

    -- A write reference to the evening alone, from a write reference to
    -- the whole day.  It uses up the reference to the day.
    generic [R: Region]
    function stretchEvening(day: &![Day, R], amount: Nat32): Bool is
        return stretch(&!(day->evening), amount);
    end;

    generic [R: Region]
    function hours(day: &[Day, R]): Nat32 is
        return width(&(day->morning)) + width(&(day->evening));
    end;

    function makeDay(morning: Interval, evening: Interval): Day is
        return Day(morning => morning, evening => evening);
    end;

    function main(): ExitCode is
        case makeInterval(9, 5) of
            when Some(value as wrong: Interval) do
                printLn("an interval from 9 to 5, which must not be");
                destroyInterval(wrong);
            when None do
                printLn("an interval from 9 to 5: refused, the low end is above the high end");
        end case;
        case makeInterval(8, 11) of
            when Some(value as morning: Interval) do
                case makeInterval(17, 19) of
                    when Some(value as evening: Interval) do
                        var day: Day := makeDay(morning, evening);
                        print("hours in the day: ");
                        printLn(hours(&day));
                        print("the evening stretched by two: ");
                        printLn(stretchEvening(&!day, 2));
                        print("stretched past the largest number: ");
                        printLn(stretchEvening(&!day, maximum_nat32));
                        borrow view: &[Day, V] := &day do
                            print("the evening ends at: ");
                            printLn(highEnd(&(view->evening)));
                            print("hours now: ");
                            printLn(hours(view));
                        end borrow;
                        let { morning as m: Interval, evening as e: Interval } := day;
                        destroyInterval(m);
                        destroyInterval(e);
                    when None do
                        printLn("no evening");
                        destroyInterval(morning);
                end case;
            when None do
                printLn("no morning");
        end case;
        return ExitSuccess();
    end;
end module body.
