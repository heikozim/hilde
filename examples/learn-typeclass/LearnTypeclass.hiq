--
-- A type class of its own: Shape names what every shape can say, its area
-- and its name.  Two records have an instance each; a generic instance
-- gives a pair of shapes of one kind an area too, from the instance of its
-- parts.  A generic function takes any type that has an instance, and the
-- compiler picks the instance from the argument; a type without one is
-- refused when the programme is compiled, not when it runs.
module body Example.LearnTypeclass is
    record Square: Free is
        side: Nat32;
    end;

    record Rectangle: Free is
        width: Nat32;
        height: Nat32;
    end;

    record Pair[T: Free]: Free is
        first: T;
        second: T;
    end;

    typeclass Shape(T: Free) is
        method area(shape: T): Nat32;
        method name(shape: T): Span[Nat8, Static];
    end;

    instance Shape(Square) is
        method area(shape: Square): Nat32 is
            return shape.side * shape.side;
        end;

        method name(shape: Square): Span[Nat8, Static] is
            return "square";
        end;
    end;

    instance Shape(Rectangle) is
        method area(shape: Rectangle): Nat32 is
            return shape.width * shape.height;
        end;

        method name(shape: Rectangle): Span[Nat8, Static] is
            return "rectangle";
        end;
    end;

    generic [U: Free(Shape)]
    instance Shape(Pair[U]) is
        method area(shape: Pair[U]): Nat32 is
            return area(shape.first) + area(shape.second);
        end;

        method name(shape: Pair[U]): Span[Nat8, Static] is
            return "pair";
        end;
    end;

    generic [T: Free(Shape)]
    function report(shape: T): Unit is
        print(name(shape));
        print(": ");
        printLn(area(shape));
        return nil;
    end;

    function main(): ExitCode is
        let three: Nat32 := 3;
        let four: Nat32 := 4;
        let five: Nat32 := 5;
        let square: Square := Square(side => three);
        let rectangle: Rectangle := Rectangle(width => four, height => five);
        report(square);
        report(rectangle);
        report(Pair(first => square, second => Square(side => four)));
        report(Pair(first => rectangle, second => rectangle));
        return ExitSuccess();
    end;
end module body.
