import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Buffer (
    Buffer,
    length as bufferLength,
    nthRef
);
import Standard.File (
    removeFile
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    closeDatabase
);
import Standard.Database.Sqlite (
    openSqlite
);
import Standard.Search (
    SearchError,
    SearchHit,
    prepareSearch,
    indexDocument,
    removeDocument,
    searchQuery,
    search,
    countMatches,
    destroyHits
);

module body Example.LearnSearch is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    function removeDatabase(): Unit is
        let path: String := fromLiteral("learn-search.db");
        let removed: Bool := removeFile(asSpan(&path));
        destroyString(path);
        let wal: String := fromLiteral("learn-search.db-wal");
        let walRemoved: Bool := removeFile(asSpan(&wal));
        destroyString(wal);
        let shm: String := fromLiteral("learn-search.db-shm");
        let shmRemoved: Bool := removeFile(asSpan(&shm));
        destroyString(shm);
        return nil;
    end;

    generic [R: Region]
    function add(db: &![Database[Writing], R], key: Span[Nat8, Static], title: Span[Nat8, Static], text: Span[Nat8, Static]): Unit is
        case indexDocument(&~db, key, title, text) of
            when Right(right as done: Unit) do
                skip;
            when Left(left as error: SearchError) do
                printLn("not indexed");
        end case;
        return nil;
    end;

    -- A search as a visitor types it, and what a page would show.
    generic [R: Region]
    function find(db: &![Database[Writing], R], text: Span[Nat8, Static]): Unit is
        print("search: ");
        printLn(text);
        case searchQuery(text) of
            when Some(value as query: String) do
                print("  the query of FTS5: ");
                printText(&query);
                printLn("");
                destroyString(query);
            when None do
                printLn("  no words");
        end case;
        case search(&~db, text, 10, 0, "<mark>", "</mark>") of
            when Right(right as hits: Buffer[SearchHit]) do
                showHits(&hits);
                destroyHits(hits);
            when Left(left as error: SearchError) do
                printLn("  nothing searched");
        end case;
        return nil;
    end;

    generic [R: Region]
    function showHits(hits: &[Buffer[SearchHit], R]): Unit is
        var n: Index := 0;
        while n < bufferLength(hits) do
            let hit: &[SearchHit, R] := nthRef(hits, n);
            print("  ");
            printText(&(hit->key));
            print(": ");
            printText(&(hit->snippet));
            printLn("");
            n := n + 1;
        end while;
        return nil;
    end;

    function main(): ExitCode is
        removeDatabase();
        case openSqlite("learn-search.db") of
            when Right(right as opened: Database[Writing]) do
                var db: Database[Writing] := opened;
                case prepareSearch(&!db) of
                    when Right(right as done: Unit) do
                        add(&!db, "/menu", "Menu", "Coffee, tea and cakes. The coffee is roasted <here>.");
                        add(&!db, "/hours", "Opening hours", "The cafe opens at seven; coffee from eight.");
                        add(&!db, "/about", "About the Coffee House", "A house for coffee since 1904.");
                        find(&!db, "coffee");
                        find(&!db, "Coffee cake*");
                        find(&!db, "title:menu OR about");
                        find(&!db, "?!");
                        case countMatches(&!db, "coffee") of
                            when Right(right as count: Int64) do
                                print("documents with coffee: ");
                                printLn(count);
                            when Left(left as error: SearchError) do
                                printLn("no count");
                        end case;
                        case removeDocument(&!db, "/menu") of
                            when Right(right as removed: Bool) do
                                print("menu removed: ");
                                printLn(removed);
                            when Left(left as error: SearchError) do
                                printLn("not removed");
                        end case;
                        find(&!db, "cakes");
                    when Left(left as error: SearchError) do
                        printLn("no index: this SQLite has no FTS5");
                end case;
                closeDatabase(db);
            when Left(left as error: DbError) do
                printLn("no database");
        end case;
        removeDatabase();
        return ExitSuccess();
    end;
end module body.
