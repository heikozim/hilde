-- A library for wasm32-wasi whose host is JavaScript, in a browser or in a
-- worker of Cloudflare: the host writes text into the module's memory with
-- hilde_wasm_alloc and calls the two exported functions on it, and what
-- one writes for the host goes into memory the host gave it as well.

module body Example.TextStats is
    constant tab: Nat8 := 9;
    constant line_feed: Nat8 := 10;
    constant carriage_return: Nat8 := 13;
    constant space: Nat8 := 32;
    constant small_a: Nat8 := 97;
    constant small_z: Nat8 := 122;
    constant case_distance: Nat8 := 32;

    -- Whether a byte ends a word.
    function isSpace(byte: Nat8): Bool is
        return (byte = space) or (byte = tab) or (byte = line_feed) or (byte = carriage_return);
    end;

    -- The words of text: runs of bytes that are no space.
    pragma Foreign_Export(External_Name => "stats_words");
    generic [R: Region]
    function countWords(text: Span[Nat8, R]): Nat32 is
        var words: Nat32 := 0;
        var in_word: Bool := false;
        var i: Index := 0;
        while i < spanLength(text) do
            if isSpace(text[i]) then
                in_word := false;
            else if not in_word then
                words := words + 1;
                in_word := true;
            end if;
            i := i + 1;
        end while;
        return words;
    end;

    -- Writes text into out with the letters a to z made A to Z, and gives
    -- back how many it turned.  out is at least as long as text; a shorter
    -- one stops the module at its first byte past the end.
    pragma Foreign_Export(External_Name => "stats_upper");
    generic [R: Region, S: Region]
    function upperAscii(text: Span[Nat8, R], out: Span![Nat8, S]): Nat32 is
        var target: Span![Nat8, S] := out;
        var turned: Nat32 := 0;
        var i: Index := 0;
        while i < spanLength(text) do
            let byte: Nat8 := text[i];
            if (byte >= small_a) and (byte <= small_z) then
                target[i] := byte - case_distance;
                turned := turned + 1;
            else
                target[i] := byte;
            end if;
            i := i + 1;
        end while;
        return turned;
    end;
end module body.
