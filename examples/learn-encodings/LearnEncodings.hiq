--
-- Text in its encodings: Standard.Base64 and Standard.Text turn bytes into
-- text and back, Standard.Utf8 counts and checks code points,
-- Standard.Unicode changes case by the tables of Unicode,
-- Standard.Normalization brings text to one of its normal forms and
-- Standard.Grapheme counts the characters a reader sees.  Every function
-- that can meet bad input answers None, never a stop.
import Standard.Buffer (
    Buffer,
    destroyFree,
    length as bufferLength
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.Base64 (
    encode,
    decode
);
import Standard.Text (
    bytesToHex,
    hexToBytes,
    urlEncode,
    urlDecode,
    trim,
    split,
    join,
    replace,
    parseInt,
    constantTimeEqual
);
import Standard.Utf8 (
    isValid,
    countCodePoints
);
import Standard.Unicode (
    toUpper,
    foldCase,
    equalIgnoringCase
);
import Standard.Normalization (
    toNfc
);
import Standard.Grapheme (
    countClusters
);

module body Example.LearnEncodings is
    function printOption(label: Span[Nat8, Static], found: Option[String]): Unit is
        print(label);
        case found of
            when Some(value as s: String) do
                printLn(asSpan(&s));
                destroyString(s);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function printString(label: Span[Nat8, Static], s: String): Unit is
        print(label);
        printLn(asSpan(&s));
        destroyString(s);
        return nil;
    end;

    function main(): ExitCode is
        -- Base64, as RFC 4648 writes it, and back.
        let encoded: String := encode("Hilde");
        printString("base64 of Hilde: ", copyOf(&encoded));
        printOption("and back: ", decode(asSpan(&encoded)));
        destroyString(encoded);
        printOption("base64 with a byte out of place: ", decode("SGl*ZGU="));
        -- Hexadecimal and the escapes of a URL.
        printString("hex: ", bytesToHex("ok!"));
        printOption("from hex: ", hexToBytes("6f6b21"));
        printOption("odd hex: ", hexToBytes("6f6"));
        printString("url: ", urlEncode("a b&c=d"));
        printString("back: ", urlDecode("a%20b%26c%3Dd"));
        -- Pieces of text, without copying.
        let words: Buffer[Span[Nat8, Static]] := split("red, green, blue", ", ");
        print("words: ");
        printLn(bufferLength(&words));
        printString("joined with |: ", join(&words, "|"));
        destroyFree(words);
        print("trimmed: [");
        print(trim("  spaced  "));
        printLn("]");
        printString("replaced: ", replace("one two one", "one", "1"));
        case parseInt("-42") of
            when Some(value as n: Int64) do
                print("parsed: ");
                printLn(n);
            when None do
                printLn("parsed: none");
        end case;
        print("equal in constant time: ");
        printLn(constantTimeEqual("secret", "secret"));
        -- UTF-8: bytes against code points.
        var cafe: StringBuilder := makeStringBuilder();
        writeString(&!cafe, "caf");
        let c3: Nat8 := 195;
        let a9: Nat8 := 169;
        writeByte(&!cafe, c3);
        writeByte(&!cafe, a9);
        let word: String := finalize(cafe);
        print("bytes of cafe with an accent: ");
        printLn(spanLength(asSpan(&word)));
        case countCodePoints(asSpan(&word)) of
            when Some(value as n: Index) do
                print("code points: ");
                printLn(n);
            when None do
                printLn("code points: none");
        end case;
        print("well-formed: ");
        printLn(isValid(asSpan(&word)));
        -- Case by the tables of Unicode: the sharp s becomes two letters s.
        -- In upper case, as hexadecimal, so that the output stays ASCII: the
        -- e with an accent is two bytes in both cases.
        case toUpper(asSpan(&word)) of
            when Some(value as up: String) do
                printString("upper case, as hex: ", bytesToHex(asSpan(&up)));
                destroyString(up);
            when None do
                printLn("upper case: none");
        end case;
        destroyString(word);
        var strasse: StringBuilder := makeStringBuilder();
        writeString(&!strasse, "Stra");
        let c39f1: Nat8 := 195;
        let c39f2: Nat8 := 159;
        writeByte(&!strasse, c39f1);
        writeByte(&!strasse, c39f2);
        writeString(&!strasse, "e");
        let street: String := finalize(strasse);
        printOption("upper case of the street: ", toUpper(asSpan(&street)));
        printOption("folded: ", foldCase(asSpan(&street)));
        print("the same as STRASSE without regard to case: ");
        printLn(equalIgnoringCase(asSpan(&street), "STRASSE"));
        destroyString(street);
        -- An e and a combining acute are two code points; NFC makes them
        -- the one of the e with an acute, and a reader sees one character
        -- either way.  Two regional indicators are the flag of a country.
        showText("65cc81", true, "e with a combining acute, in NFC as hex: ");
        showText("f09f87a9f09f87aa", false, "regional indicators D and E, ");
        return ExitSuccess();
    end;

    -- The text given as the hexadecimal of its UTF-8: its NFC when nfc is
    -- true, the number of its code points and of its characters.
    function showText(hex: Span[Nat8, Static], nfc: Bool, label: Span[Nat8, Static]): Unit is
        case hexToBytes(hex) of
            when Some(value as text: String) do
                print(label);
                if nfc then
                    case toNfc(asSpan(&text)) of
                        when Some(value as composed: String) do
                            printString("", bytesToHex(asSpan(&composed)));
                            destroyString(composed);
                        when None do
                            printLn("none");
                    end case;
                end if;
                case countCodePoints(asSpan(&text)) of
                    when Some(value as n: Index) do
                        print("code points: ");
                        printLn(n);
                    when None do
                        printLn("code points: none");
                end case;
                case countClusters(asSpan(&text)) of
                    when Some(value as n: Index) do
                        print("characters a reader sees: ");
                        printLn(n);
                    when None do
                        printLn("characters a reader sees: none");
                end case;
                destroyString(text);
            when None do
                printLn("the hexadecimal is not well formed");
        end case;
        return nil;
    end;

    generic [R: Region]
    function copyOf(s: &[String, R]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(s));
        return finalize(out);
    end;
end module body.
