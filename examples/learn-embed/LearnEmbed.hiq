--
-- Two forms that begin with an at sign.  @bytes puts the bytes of a file
-- into the programme when it is compiled, here motto.txt beside this
-- file; the programme needs the file no more when it runs.  @embed pastes
-- a C expression into the programme, with $1 and so on for its arguments.
-- It can do anything C can, so only a module marked unsafe may use it.
pragma Unsafe_Module;

module body Example.LearnEmbed is
    function main(): ExitCode is
        let motto: Span[Nat8, Static] := @bytes("motto.txt");
        print("the motto, read when the programme was compiled: ");
        print(motto);
        print("its bytes: ");
        printLn(spanLength(motto));
        let a: Int32 := 6;
        let b: Int32 := 7;
        let product: Int32 := @embed(Int32, "$1 * $2", a, b);
        print("6 times 7, computed by C: ");
        printLn(product);
        let bits: Nat32 := @embed(Nat32, "(uint32_t) (sizeof(void*) * 8)");
        print("a pointer has 32 or 64 bits: ");
        printLn((bits = 32) or (bits = 64));
        return ExitSuccess();
    end;
end module body.
