--
-- Time and the calendar.  Standard.Time reads the clocks of the system;
-- Standard.Calendar turns an instant into a date and a time of day, in
-- UTC and in a zone, reads and writes RFC 3339, and finds the hour a
-- clock skips when summer time begins.  The zone comes from a POSIX rule,
-- so that the programme does not depend on the zone files of the system
-- and prints the same on every run.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Time (
    wallNanos,
    hasMonotonic,
    monotonicNanos
);
import Standard.Calendar (
    Instant,
    Civil,
    Zone,
    ZoneFailure,
    Offset,
    Resolved,
    Exactly,
    Twice,
    Skipped,
    NotACivil,
    Stamp,
    civilAt,
    weekday,
    zoneOfRule,
    destroyZone,
    offsetAt,
    abbreviationAt,
    localAt,
    resolveLocal,
    formatRfc3339,
    parseRfc3339
);

module body Example.LearnTime is
    function printCivil(label: Span[Nat8, Static], found: Option[Civil]): Unit is
        print(label);
        case found of
            when Some(value as c: Civil) do
                print(c.year);
                print("-");
                printTwo(c.month);
                print("-");
                printTwo(c.day);
                print(" ");
                printTwo(c.hour);
                print(":");
                printTwo(c.minute);
                print(":");
                printTwo(c.second);
                printLn("");
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function printTwo(n: Nat8): Unit is
        let ten: Nat8 := 10;
        if n < ten then
            print("0");
        end if;
        print(n);
        return nil;
    end;

    function printStamp(label: Span[Nat8, Static], instant: Instant, offset: Int32): Unit is
        print(label);
        case formatRfc3339(instant, offset) of
            when Some(value as text: String) do
                printLn(asSpan(&text));
                destroyString(text);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        -- The clocks: their values change from run to run, so only
        -- whether they answer is printed.
        let zeroNanos: Nat64 := 0;
        print("the wall clock runs: ");
        printLn(wallNanos() > zeroNanos);
        print("a monotonic clock: ");
        printLn(hasMonotonic());
        -- One instant, 2026-09-28 at 01:00 UTC.
        let noNanos: Nat32 := 0;
        let moment: Int64 := 1790557200;
        let instant: Instant := Instant(seconds => moment, nanos => noNanos);
        let utc: Int32 := 0;
        printCivil("in UTC: ", civilAt(instant, utc));
        case civilAt(instant, utc) of
            when Some(value as c: Civil) do
                print("the weekday, 1 for Monday: ");
                printLn(weekday(c));
            when None do
                printLn("no weekday");
        end case;
        printStamp("as RFC 3339: ", instant, utc);
        let twoHours: Int32 := 7200;
        printStamp("with a clock two hours east: ", instant, twoHours);
        case parseRfc3339("2026-09-28T03:00:00.5+02:00") of
            when Some(value as s: Stamp) do
                print("read back, seconds since 1970: ");
                printLn(s.instant.seconds);
                print("and nanoseconds: ");
                printLn(s.instant.nanos);
            when None do
                printLn("not RFC 3339");
        end case;
        case parseRfc3339("2026-02-30T00:00:00Z") of
            when Some(value as s: Stamp) do
                printLn("February 30 was read");
            when None do
                printLn("February 30 is refused");
        end case;
        -- A zone by its POSIX rule: Central European Time.
        case zoneOfRule("CET-1CEST,M3.5.0,M10.5.0/3") of
            when Right(right as zone: Zone) do
                printCivil("in Berlin: ", localAt(&zone, instant));
                let offset: Offset := offsetAt(&zone, instant);
                print("offset in seconds: ");
                printLn(offset.seconds);
                print("summer time: ");
                printLn(offset.daylight);
                let abbreviation: String := abbreviationAt(&zone, instant);
                print("abbreviation: ");
                printLn(asSpan(&abbreviation));
                destroyString(abbreviation);
                -- 02:30 on 2026-03-29 never shows on a clock in Berlin.
                let march: Nat8 := 3;
                let day: Nat8 := 29;
                let two: Nat8 := 2;
                let thirty: Nat8 := 30;
                let none: Nat8 := 0;
                let skipped: Civil := Civil(year => 2026, month => march, day => day, hour => two, minute => thirty, second => none, nanos => noNanos);
                case resolveLocal(&zone, skipped) of
                    when Exactly(instant as i: Instant) do
                        printLn("02:30 on 2026-03-29: once");
                    when Twice(earlier as e: Instant, later as l: Instant) do
                        printLn("02:30 on 2026-03-29: twice");
                    when Skipped(before as b: Instant, after as a: Instant) do
                        printLn("02:30 on 2026-03-29: skipped, the clocks go from 02:00 to 03:00");
                    when NotACivil do
                        printLn("02:30 on 2026-03-29: no time of day");
                end case;
                destroyZone(zone);
            when Left(left as f: ZoneFailure) do
                printLn("the rule was refused");
        end case;
        return ExitSuccess();
    end;
end module body.
