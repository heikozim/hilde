import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Time (
    wallNanos
);
import Standard.X509 (
    PrivateKey,
    Certificate,
    EcP256,
    EcP384,
    Ed25519Key,
    generateKey,
    destroyPrivateKey,
    certificateToPem,
    subjectName,
    issuerName,
    dnsNamesOf,
    isAuthority,
    destroyCertificate,
    isDnsNameList,
    selfSigned,
    certificateRequest,
    issueFromRequest,
    verifyChain,
    signMessage
);
import Standard.Acme (
    base64Url,
    joseSignature
);

module body Example.LearnPki is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    function printName(name: Option[String]): Unit is
        case name of
            when Some(value as text: String) do
                printText(&text);
                printLn("");
                destroyString(text);
            when None do
                printLn("(none)");
        end case;
        return nil;
    end;

    function now(): Int64 is
        case toInt64(wallNanos() / 1000000000) of
            when Some(value as seconds: Int64) do
                return seconds;
            when None do
                return 0;
        end case;
    end;

    generic [A: Region, K: Region]
    function leaf(ca: &[Certificate, A], caKey: &[PrivateKey, K]): Unit is
        case generateKey(Ed25519Key()) of
            when Some(value as key: PrivateKey) do
                case certificateRequest(&key, "", "www.example.org,example.org") of
                    when Some(value as request: String) do
                        case issueFromRequest(ca, caKey, asSpan(&request), 90) of
                            when Some(value as issued: Certificate) do
                                print("the server certificate: ");
                                printName(subjectName(&issued));
                                print("issued by: ");
                                printName(issuerName(&issued));
                                let names: String := dnsNamesOf(&issued);
                                print("for the names: ");
                                printText(&names);
                                printLn("");
                                destroyString(names);
                                print("a CA itself: ");
                                printLn(isAuthority(&issued));
                                case certificateToPem(&issued) of
                                    when Some(value as leafPem: String) do
                                        case certificateToPem(ca) of
                                            when Some(value as caPem: String) do
                                                case verifyChain(asSpan(&leafPem), asSpan(&caPem), "example.org", now()) of
                                                    when Some(value as why: String) do
                                                        printLn("does not verify");
                                                        destroyString(why);
                                                    when None do
                                                        printLn("the chain verifies for example.org");
                                                end case;
                                                case verifyChain(asSpan(&leafPem), asSpan(&caPem), "example.net", now()) of
                                                    when Some(value as why: String) do
                                                        -- The words differ between OpenSSL and LibreSSL.
                                                        printLn("for example.net it does not verify");
                                                        destroyString(why);
                                                    when None do
                                                        printLn("verifies for example.net");
                                                end case;
                                                destroyString(caPem);
                                            when None do
                                                printLn("no CA PEM");
                                        end case;
                                        destroyString(leafPem);
                                    when None do
                                        printLn("no PEM");
                                end case;
                                destroyCertificate(issued);
                            when None do
                                printLn("nothing issued");
                        end case;
                        destroyString(request);
                    when None do
                        printLn("no request");
                end case;
                destroyPrivateKey(key);
            when None do
                printLn("no key");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        print("www.example.org,example.org is a list of names: ");
        printLn(isDnsNameList("www.example.org,example.org"));
        print("example.org,IP:192.0.2.1 is a list of names: ");
        printLn(isDnsNameList("example.org,IP:192.0.2.1"));
        case generateKey(EcP384()) of
            when Some(value as caKey: PrivateKey) do
                case selfSigned(&caKey, "Example Root", "", 3650, true) of
                    when Some(value as ca: Certificate) do
                        print("the CA: ");
                        printName(subjectName(&ca));
                        print("a CA: ");
                        printLn(isAuthority(&ca));
                        leaf(&ca, &caKey);
                        destroyCertificate(ca);
                    when None do
                        printLn("no CA");
                end case;
                destroyPrivateKey(caKey);
            when None do
                printLn("no key");
        end case;
        -- What an ACME client signs with: a P-256 key, ES256, base64url.
        case generateKey(EcP256()) of
            when Some(value as key: PrivateKey) do
                case signMessage(&key, "protected.payload") of
                    when Some(value as der: String) do
                        case joseSignature(asSpan(&der)) of
                            when Some(value as raw: String) do
                                let encoded: String := base64Url(asSpan(&raw));
                                print("an ES256 signature in a JWS: ");
                                print(length(&encoded));
                                printLn(" characters");
                                destroyString(encoded);
                                destroyString(raw);
                            when None do
                                printLn("no JOSE signature");
                        end case;
                        destroyString(der);
                    when None do
                        printLn("no signature");
                end case;
                destroyPrivateKey(key);
            when None do
                printLn("no key");
        end case;
        return ExitSuccess();
    end;
end module body.
