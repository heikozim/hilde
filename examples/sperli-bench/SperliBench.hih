module Example.SperliBench is
    """
    The mean time of one round in microseconds, rounded down, for count
    rounds that took nanoseconds together.
    """
    function meanMicroseconds(nanoseconds: Nat64, count: Nat64): Nat64
        requires (count > 0) and (nanoseconds <= 18446744073709);

    """
    The rate in tenths of a megabyte a second (a megabyte is 10^6 bytes) for
    bytes sent in nanoseconds.
    """
    function tenthsOfMegabytes(bytes: Nat64, nanoseconds: Nat64): Nat64
        requires (nanoseconds > 0) and (bytes <= 1844674407370955);

    """
    Joins a job of two ranks on the first line of the standard input and
    runs the mode named by the arguments: mode, count and message size.
    Rank 0 of a pair uses ping or stream, rank 1 echo or sink, which are
    also the modes of the Go rank.  Prints one line of numbers.
    No contract: the exit code of the programme, the result of what it did.
    """
    function main(root: RootCapability): ExitCode;
end module.
