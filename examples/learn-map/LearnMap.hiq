--
-- A stock of fruit, counted as the boxes come in.  Standard.Sort puts the
-- boxes in the order of their names and finds a name among them;
-- Standard.Map keeps one count per name, and its entries always come in
-- the order of their keys.
import Standard.Tuples (
    Pair
);
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyEmpty as destroyEmptyBuffer,
    length as bufferLength,
    nthRef,
    insertBack,
    removeFirst
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
-- The order of strings lives in Standard.Order, and a module sees it only
-- through an import from there.
import Standard.Order (
    TotalOrder
);
import Standard.Sort (
    Search,
    sort,
    isSorted,
    binarySearch
);
import Standard.Map (
    Map,
    makeMap,
    destroyEmpty,
    size,
    getMut,
    put,
    replaceValue,
    keyAt,
    valueAt,
    removeAt
);

module body Example.LearnMap is
    -- The names of the boxes on one line, in the order they stand.
    generic [R: Region]
    function printBoxes(boxes: &[Buffer[String], R]): Unit is
        print("sorted:");
        for i from 0 to bufferLength(boxes) - 1 do
            print(" ");
            print(asSpan(nthRef(boxes, i)));
        end for;
        printLn("");
        return nil;
    end;

    -- Where name stands among the sorted boxes, or where it would go.
    generic [R: Region]
    function search(boxes: &[Buffer[String], R], name: Span[Nat8, Static]): Unit is
        let key: String := fromLiteral(name);
        print(name);
        case binarySearch(boxes, &key) of
            when Found(position as p: Index) do
                print(": found at ");
                printLn(p);
            when Missing(insertAt as p: Index) do
                print(": missing, it would go at ");
                printLn(p);
        end case;
        destroyString(key);
        return nil;
    end;

    -- One more box of name: its count is read and raised, or the name is
    -- put in with a count of one when it is new.  The map takes the name
    -- over; a name it already holds is destroyed here.
    generic [R: Region]
    function count(stock: &![Map[String, Index], R], name: String): Unit is
        case getMut(&~stock, &name) of
            when Some(value as c: Index) do
                case replaceValue(&~stock, &name, c + 1) of
                    when Right(right as old: Index) do
                        skip;
                    when Left(left as back: Index) do
                        skip;
                end case;
                destroyString(name);
            when None do
                let one: Index := 1;
                case put(&~stock, name, one) of
                    when Some(value as old: Pair[String, Index]) do
                        let { first: String, second: Index } := old;
                        destroyString(first);
                    when None do
                        skip;
                end case;
        end case;
        return nil;
    end;

    function main(): ExitCode is
        -- The boxes in the order they come in.
        var boxes: Buffer[String] := allocateEmpty();
        insertBack(&!boxes, fromLiteral("pear"));
        insertBack(&!boxes, fromLiteral("apple"));
        insertBack(&!boxes, fromLiteral("plum"));
        insertBack(&!boxes, fromLiteral("apple"));
        insertBack(&!boxes, fromLiteral("fig"));
        insertBack(&!boxes, fromLiteral("pear"));
        insertBack(&!boxes, fromLiteral("apple"));
        -- sort takes the buffer and hands it back in order.
        var sorted: Buffer[String] := sort(boxes);
        printBoxes(&sorted);
        print("in order: ");
        printLn(isSorted(&sorted));
        search(&sorted, "pear");
        search(&sorted, "kiwi");
        -- Every box counted under its name.
        var stock: Map[String, Index] := makeMap();
        while bufferLength(&sorted) > 0 do
            count(&!stock, removeFirst(&!sorted));
        end while;
        destroyEmptyBuffer(sorted);
        print("kinds of fruit: ");
        printLn(size(&stock));
        for k from 0 to size(&stock) - 1 do
            print(asSpan(keyAt(&stock, k)));
            print(" ");
            printLn(!valueAt(&stock, k));
        end for;
        -- A map of strings is emptied before it ends, so that no name is
        -- lost.
        while size(&stock) > 0 do
            let { first: String, second: Index } := removeAt(&!stock, 0);
            destroyString(first);
        end while;
        destroyEmpty(stock);
        return ExitSuccess();
    end;
end module body.
