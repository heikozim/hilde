--
-- The assertions of Standard.Testing, used here in a plain programme.  A
-- test file of the standard library is written the same way, as a file
-- named after its module with .test.hiq, and run by hilde test, which
-- also runs it under the thread checker or the memory checkers when asked.
-- Every assertion prints what it checks and ok; one that fails ends the
-- programme with a message, so a failing test cannot pass unnoticed.
import Standard.Testing (
    assertTrue,
    assertFalse,
    assertSuccess
);

module body Example.LearnTesting is
    -- Whether n divides year without a remainder; the language has no
    -- remainder operator, so it is found through the division.
    function divides(n: Nat32, year: Nat32): Bool is
        return year = ((year / n) * n);
    end;

    -- The function under test: a year of the Gregorian calendar is a leap
    -- year when four divides it, except a century that 400 does not divide.
    function isLeapYear(year: Nat32): Bool is
        if divides(400, year) then
            return true;
        else
            if divides(100, year) then
                return false;
            else
                return divides(4, year);
            end if;
        end if;
    end;

    function main(): ExitCode is
        assertTrue(isLeapYear(2024), "2024 is a leap year");
        assertFalse(isLeapYear(2026), "2026 is not");
        assertFalse(isLeapYear(1900), "1900, a century, is not");
        assertTrue(isLeapYear(2000), "2000, divided by 400, is");
        assertSuccess("every case of the rule reached");
        return ExitSuccess();
    end;
end module body.
