module Example.LearnContracts is
    -- An account holds a balance.  It is linear: it is opened once and
    -- closed once, and nothing else can make one disappear.
    record Account: Linear is
        balance: Nat64;
    end;

    """
    No contract: a value of its own type built from its arguments; no property cheaper than its type holds.
    """
    function open(amount: Nat64): Account;

    """
    No contract: a number read from its argument; its type gives its range, and nothing cheaper holds.
    """
    generic [R: Region]
    function balance(account: &[Account, R]): Nat64;

    -- A deposit adds a positive amount, and the balance afterwards is the
    -- old balance plus the amount.
    generic [R: Region]
    function deposit(account: &![Account, R], amount: Nat64): Unit
        requires amount > 0
        ensures balance(&account) = (old(balance(&account)) + amount);

    -- A withdrawal takes a positive amount the account holds.  The caller
    -- has to make sure of that: a call that does not is stopped before the
    -- function runs, and the message names this line and the call.
    generic [R: Region]
    function withdraw(account: &![Account, R], amount: Nat64): Unit
        requires (amount > 0) and (amount <= balance(&account))
        ensures balance(&account) = (old(balance(&account)) - amount);

    """
    Closes the handle it is given.
    No contract: it only frees or closes what it is given.
    """
    function close(account: Account): Nat64;

    """
    No contract: the exit code of the programme, the result of what it did.
    """
    function main(): ExitCode;
end module.
