import Example.LearnContracts (
    Account,
    open,
    balance,
    withdraw,
    close
);

module body Example.LearnContractsBroken is
    -- The second withdrawal asks for more than the account holds.  The
    -- requires of withdraw does not hold, so the programme stops before
    -- withdraw runs, and the message names the contract in
    -- LearnContracts.hih and this call.  The last two lines never run.
    function main(): ExitCode is
        var account: Account := open(100);
        withdraw(&!account, 30);
        printLn(balance(&account));
        withdraw(&!account, 71);
        printLn(balance(&account));
        printLn(close(account));
        return ExitSuccess();
    end;
end module body.
