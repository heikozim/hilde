module body Example.LearnContracts is
    function open(amount: Nat64): Account is
        return Account(balance => amount);
    end;

    generic [R: Region]
    function balance(account: &[Account, R]): Nat64 is
        return account->balance;
    end;

    -- The contract stands in the interface; the body only does the work.
    -- The compiler adds the checks at the start and at every return.
    generic [R: Region]
    function deposit(account: &![Account, R], amount: Nat64): Unit is
        account->balance := account->balance + amount;
        return nil;
    end;

    generic [R: Region]
    function withdraw(account: &![Account, R], amount: Nat64): Unit is
        account->balance := account->balance - amount;
        return nil;
    end;

    function close(account: Account): Nat64 is
        let { balance as amount: Nat64 } := account;
        return amount;
    end;

    -- Every call here keeps the contracts, so the programme runs to its
    -- end.  LearnContractsBroken.hiq makes the one call that does not.
    function main(): ExitCode is
        var account: Account := open(100);
        deposit(&!account, 50);
        printLn(balance(&account));
        withdraw(&!account, 120);
        printLn(balance(&account));
        printLn(close(account));
        return ExitSuccess();
    end;
end module body.
