--
-- Machine code for a pattern of PCRE2.  A program that imports
-- Standard.PcreJit says by that import that it makes machine code at run
-- time; one that imports only Standard.Pcre never does.  The pattern
-- compile gives back is a Regex of Standard.Pcre and is searched with that
-- module's functions, so the searches below do not change with the JIT.
-- When the JIT cannot compile a pattern, the interpreter of PCRE2 searches
-- it and fallBack says why.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Buffer (
    Buffer,
    destroyFree,
    length as bufferLength,
    nth
);
import Standard.Pcre (
    Regex,
    destroyRegex,
    Hit,
    find_all
);
import Standard.PcreJit (
    Compiled,
    compile,
    jitBuiltIn
);

module body Example.LearnJit is
    -- The most work one search may do before it gives up.
    constant limit: Nat32 := 1000000;

    function printText(text: String): Unit is
        let size: Index := length(&text);
        if size > 0 then
            printLn(getSpan(&text, 0, size - 1));
        else
            printLn("");
        end if;
        destroyString(text);
        return nil;
    end;

    -- Compiles pattern, says whether it runs as machine code, and prints
    -- every match in text.
    generic [R: Region]
    function scan(name: Span[Nat8, Static], pattern: Span[Nat8, Static], text: &[String, R]): Unit is
        print(name);
        case compile(pattern, limit) of
            when Right(right as compiled: Compiled) do
                let { regex: Regex, fallBack: Option[String] } := compiled;
                case fallBack of
                    when None do
                        printLn(": machine code");
                    when Some(value as reason: String) do
                        print(": the interpreter, because ");
                        printText(reason);
                end case;
                case find_all(&regex, asSpan(text)) of
                    when Right(right as hits: Buffer[Hit]) do
                        var i: Index := 0;
                        while i < bufferLength(&hits) do
                            let hit: Hit := nth(&hits, i);
                            print("  ");
                            printLn(getSpan(text, hit.start, hit.stop - 1));
                            i := i + 1;
                        end while;
                        destroyFree(hits);
                    when Left(left as message: String) do
                        printText(message);
                end case;
                destroyRegex(regex);
            when Left(left as message: String) do
                print(": ");
                printText(message);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        print("the JIT is built in: ");
        printLn(jitBuiltIn());
        let log: String := fromLiteral("12:00 ok\n12:01 Warning: disk\n12:02 ok\n12:03 FATAL: disk\n");
        -- The time at the start of a line that holds a warning or a fatal
        -- error, in any case.
        scan("warnings", "(?im)^\\d\\d:\\d\\d(?= .*(warning|fatal))", &log);
        -- A callout right before the assertion of a condition is one of
        -- the two things the JIT of PCRE2 does not compile.  The condition
        -- takes the first word where a capital F follows, the second
        -- everywhere else.
        scan("with a callout", "(?(?C1)(?=F)FATAL|Warning)", &log);
        destroyString(log);
        return ExitSuccess();
    end;
end module body.
