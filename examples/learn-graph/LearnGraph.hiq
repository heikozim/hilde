--
-- A small road map as a graph: the towns are nodes that hold their names,
-- the roads are edges that hold their length in kilometres.  A node or an
-- edge is named by an id that also carries a generation, so an id of a
-- removed node is never taken for a node added later.
import Standard.Tuples (
    Pair
);
import Standard.Buffer (
    Buffer,
    length,
    nth,
    destroyFree as destroyFreeBuffer
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as stringLength,
    getSpan
);
import Standard.Graph (
    Graph,
    NodeId,
    EdgeId,
    NoPath,
    makeGraph,
    destroyEmpty,
    nodeRef,
    edgeSource,
    edgeTarget,
    addNode,
    addEdge,
    removeNode,
    nodes,
    shortestPath,
    lightestPath
);

module body Example.LearnGraph is
    generic [R: Region]
    function road(g: &![Graph[String, Nat32], R], source: NodeId, target: NodeId, kilometres: Nat32): Unit is
        case addEdge(g, source, target, kilometres) of
            when Right(right as edge: EdgeId) do
                skip;
            when Left(left as back: Nat32) do
                abort("addEdge refused two towns of the map");
        end case;
        return nil;
    end;

    generic [R: Region]
    function printName(g: &[Graph[String, Nat32], R], node: NodeId): Unit is
        case nodeRef(g, node) of
            when Some(value as name: &[String, R]) do
                print(getSpan(name, 0, stringLength(name) - 1));
            when None do
                print("none");
        end case;
        return nil;
    end;

    -- A path: the town each road leaves, then the town the last one enters.
    generic [R: Region, S: Region]
    function printWalk(g: &[Graph[String, Nat32], R], ids: &[Buffer[EdgeId], S]): Unit is
        var i: Index := 0;
        while i < length(ids) do
            print(" ");
            case edgeSource(g, nth(ids, i)) of
                when Some(value as node: NodeId) do
                    printName(g, node);
                when None do
                    print("none");
            end case;
            i := i + 1;
        end while;
        if length(ids) > 0 then
            print(" ");
            case edgeTarget(g, nth(ids, length(ids) - 1)) of
                when Some(value as node: NodeId) do
                    printName(g, node);
                when None do
                    print("none");
            end case;
        end if;
        return nil;
    end;

    -- The path with the fewest roads, whatever their lengths.
    generic [R: Region]
    function printFewest(g: &[Graph[String, Nat32], R], found: Option[Buffer[EdgeId]]): Unit is
        print("fewest roads:");
        case found of
            when Some(value as path: Buffer[EdgeId]) do
                printWalk(g, &path);
                destroyFreeBuffer(path);
            when None do
                print(" none");
        end case;
        printLn("");
        return nil;
    end;

    -- The path of the fewest kilometres, and the kilometres.
    generic [R: Region]
    function printLightest(g: &[Graph[String, Nat32], R], found: Either[NoPath, Pair[Nat64, Buffer[EdgeId]]]): Unit is
        print("fewest kilometres:");
        case found of
            when Right(right as p: Pair[Nat64, Buffer[EdgeId]]) do
                let { first: Nat64, second: Buffer[EdgeId] } := p;
                printWalk(g, &second);
                print(", ");
                print(first);
                print(" km");
                destroyFreeBuffer(second);
            when Left(left as reason: NoPath) do
                print(" none");
        end case;
        printLn("");
        return nil;
    end;

    -- The graph holds strings, which are linear: every node is taken out
    -- with its name and the lengths of its roads before the graph ends.
    generic [R: Region]
    function empty(g: &![Graph[String, Nat32], R]): Unit is
        let all: Buffer[NodeId] := nodes(&g);
        var i: Index := 0;
        while i < length(&all) do
            case removeNode(&~g, nth(&all, i)) of
                when Some(value as p: Pair[String, Buffer[Nat32]]) do
                    let { first: String, second: Buffer[Nat32] } := p;
                    destroyString(first);
                    destroyFreeBuffer(second);
                when None do
                    abort("a listed town was not on the map");
            end case;
            i := i + 1;
        end while;
        destroyFreeBuffer(all);
        return nil;
    end;

    function main(): ExitCode is
        var g: Graph[String, Nat32] := makeGraph();
        let aachen: NodeId := addNode(&!g, fromLiteral("Aachen"));
        let bonn: NodeId := addNode(&!g, fromLiteral("Bonn"));
        let cologne: NodeId := addNode(&!g, fromLiteral("Cologne"));
        let dortmund: NodeId := addNode(&!g, fromLiteral("Dortmund"));
        let frankfurt: NodeId := addNode(&!g, fromLiteral("Frankfurt"));
        road(&!g, aachen, cologne, 70);
        road(&!g, aachen, bonn, 90);
        road(&!g, cologne, bonn, 30);
        road(&!g, cologne, dortmund, 95);
        road(&!g, bonn, frankfurt, 175);
        road(&!g, cologne, frankfurt, 200);
        printFewest(&g, shortestPath(&g, aachen, frankfurt));
        printLightest(&g, lightestPath(&g, aachen, frankfurt));
        empty(&!g);
        destroyEmpty(g);
        return ExitSuccess();
    end;
end module body.
