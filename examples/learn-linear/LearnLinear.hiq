module body Example.LearnLinear is
    -- A ticket is good for one use.  Linear says so to the compiler: a
    -- ticket cannot be copied, and a function cannot end still holding
    -- one it did not hand on.
    record Ticket: Linear is
        seat: Nat32;
    end;

    function issue(seat: Nat32): Ticket is
        return Ticket(seat => seat);
    end;

    -- Taking a ticket by value consumes it: after the call, the caller
    -- has no ticket any more.  Taking it apart is how it ends.
    function use(ticket: Ticket): Nat32 is
        let { seat: Nat32 } := ticket;
        return seat;
    end;

    -- A read reference only looks: the caller keeps the ticket.
    generic [R: Region]
    function peek(ticket: &[Ticket, R]): Nat32 is
        return ticket->seat;
    end;

    function main(): ExitCode is
        let ticket: Ticket := issue(12);
        printLn(peek(&ticket));
        printLn(peek(&ticket));
        -- The last use: ticket is consumed here, and any use after this
        -- line is a compile error.
        printLn(use(ticket));
        return ExitSuccess();
    end;
end module body.
