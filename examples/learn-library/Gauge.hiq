--
-- A small library for a C programme: readings of a gauge, one byte each,
-- handed over as a span of bytes, which C sees as a pointer and a length.
-- Each exported function is callable from C under the name its pragma
-- gives.  The compiler writes the library and a header with the C
-- declarations beside it.
module body Example.Gauge is
    function widen(value: Nat8): Nat64 is
        case toNat64(value) of
            when Some(value as wide: Nat64) do
                return wide;
            when None do
                return 0;
        end case;
    end;

    pragma Foreign_Export(External_Name => "gauge_sum");
    generic [R: Region]
    function gaugeSum(readings: Span[Nat8, R]): Nat64 is
        var sum: Nat64 := 0;
        var i: Index := 0;
        while i < spanLength(readings) do
            sum := sum + widen(readings[i]);
            i := i + 1;
        end while;
        return sum;
    end;

    pragma Foreign_Export(External_Name => "gauge_count_above");
    generic [R: Region]
    function countAbove(readings: Span[Nat8, R], limit: Nat8): Index is
        var count: Index := 0;
        var i: Index := 0;
        while i < spanLength(readings) do
            if readings[i] > limit then
                count := count + 1;
            end if;
            i := i + 1;
        end while;
        return count;
    end;

    pragma Foreign_Export(External_Name => "gauge_in_range");
    function inRange(reading: Int32): Bool is
        return (reading >= 0) and (reading <= 255);
    end;
end module body.
