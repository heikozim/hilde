-- The lines, words and bytes of the standard input, as wc counts them.  The
-- same source is built as a binary and as a module for wasm32-wasi; it
-- holds nothing for one target only.
import Standard.IO (
    acquireTerminal,
    releaseTerminal,
    TerminalCapability,
    readByte
);
import Standard.IO.Terminal (
    StandardInput,
    acquireInput,
    releaseInput
);

module body Example.WordCount is
    constant tab: Nat8 := 9;
    constant line_feed: Nat8 := 10;
    constant carriage_return: Nat8 := 13;
    constant space: Nat8 := 32;

    -- Whether a byte ends a word.
    function isSpace(byte: Nat8): Bool is
        return (byte = space) or (byte = tab) or (byte = line_feed) or (byte = carriage_return);
    end;

    function main(root: RootCapability): ExitCode is
        var mut_root: RootCapability := root;
        var terminal: TerminalCapability := acquireTerminal(&!mut_root);
        var input: StandardInput := acquireInput(&!terminal);
        var lines: Nat64 := 0;
        var words: Nat64 := 0;
        var bytes: Nat64 := 0;
        var in_word: Bool := false;
        var reading: Bool := true;
        while reading do
            case readByte(&!input) of
                when Some(value as byte: Nat8) do
                    bytes := bytes + 1;
                    if byte = line_feed then
                        lines := lines + 1;
                    end if;
                    if isSpace(byte) then
                        in_word := false;
                    else if not in_word then
                        words := words + 1;
                        in_word := true;
                    end if;
                when None do
                    reading := false;
            end case;
        end while;
        print(lines);
        print(" ");
        print(words);
        print(" ");
        printLn(bytes);
        releaseInput(input);
        releaseTerminal(terminal);
        surrenderRoot(mut_root);
        return ExitSuccess();
    end;
end module body.
