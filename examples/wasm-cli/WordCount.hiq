--
-- The lines, words and bytes of the standard input, as wc counts them.  The
-- same source is built as a binary and as a module for wasm32-wasi; it
-- holds nothing for one target only.
import Standard.IO (
    acquireTerminal,
    releaseTerminal,
    TerminalCapability,
    readByte
);
import Standard.IO.Terminal (
    StandardInput,
    acquireInput,
    releaseInput
);

module body Example.WordCount is
    constant tab: Nat8 := 9;
    constant lineFeed: Nat8 := 10;
    constant carriageReturn: Nat8 := 13;
    constant space: Nat8 := 32;

    -- Whether a byte ends a word.
    function isSpace(byte: Nat8): Bool is
        return (byte = space) or (byte = tab) or (byte = lineFeed) or (byte = carriageReturn);
    end;

    function main(root: RootCapability): ExitCode is
        var mutRoot: RootCapability := root;
        var terminal: TerminalCapability := acquireTerminal(&!mutRoot);
        var input: StandardInput := acquireInput(&!terminal);
        var lines: Nat64 := 0;
        var words: Nat64 := 0;
        var bytes: Nat64 := 0;
        var inWord: Bool := false;
        var reading: Bool := true;
        while reading do
            case readByte(&!input) of
                when Some(value as byte: Nat8) do
                    bytes := bytes + 1;
                    if byte = lineFeed then
                        lines := lines + 1;
                    end if;
                    if isSpace(byte) then
                        inWord := false;
                    else if not inWord then
                        words := words + 1;
                        inWord := true;
                    end if;
                when None do
                    reading := false;
            end case;
        end while;
        print(lines);
        print(" ");
        print(words);
        print(" ");
        printLn(bytes);
        releaseInput(input);
        releaseTerminal(terminal);
        surrenderRoot(mutRoot);
        return ExitSuccess();
    end;
end module body.
