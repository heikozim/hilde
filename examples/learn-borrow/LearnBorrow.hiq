module body Example.LearnBorrow is
    record Counter: Linear is
        count: Nat32;
    end;

    -- A write reference, &!, lets the callee change the caller's value.
    generic [R: Region]
    function bump(counter: &![Counter, R]): Unit is
        counter->count := counter->count + 1;
        return nil;
    end;

    -- A write reference passed on is used up.  &~ passes on a new one
    -- and keeps the old one usable; the last use may pass it on itself.
    generic [R: Region]
    function bumpTwice(counter: &![Counter, R]): Unit is
        bump(&~counter);
        bump(counter);
        return nil;
    end;

    function main(): ExitCode is
        -- var, because a write reference is taken from it.
        var counter: Counter := Counter(count => 0);
        bumpTwice(&!counter);
        bump(&!counter);
        let { count: Nat32 } := counter;
        printLn(count);
        return ExitSuccess();
    end;
end module body.
