--
-- Small values of the standard library, and a typeclass of one's own
-- type: Standard.Box keeps a value on the heap, Standard.Bounded knows
-- the least and the largest value of a number type, Standard.Equality is
-- the typeclass of equal, given here an instance for a point, and
-- Standard.Failure carries what went wrong, wrapped by each caller.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Box (
    Box,
    makeBox,
    unbox,
    readFree,
    boxSwap
);
import Standard.Bounded (
    Bounded,
    minBound,
    maxBound
);
import Standard.Equality (
    Equality,
    equal
);
import Standard.Failure (
    Failure,
    FailureKind,
    NotFound,
    makeFailure,
    wrapFailure,
    chainLength,
    describeFailure,
    kindOf,
    httpStatus,
    destroyFailure
);

module body Example.LearnValues is
    -- A point of the plane.  Two points are equal when both coordinates
    -- are: the instance of Equality says so, and equal works for points.
    record Point: Free is
        x: Int32;
        y: Int32;
    end;

    instance Equality(Point) is
        generic [R: Region, S: Region]
        method equal(a: &[Point, R], b: &[Point, S]): Bool is
            return (a->x = b->x) and (a->y = b->y);
        end;
    end;

    -- The first step of loading a configuration fails, and each caller
    -- adds what it was doing.
    function openFile(): Failure is
        return makeFailure("open", NotFound(), "no file named server.toml");
    end;

    function loadConfiguration(): Failure is
        return wrapFailure("load the configuration", openFile());
    end;

    function main(): ExitCode is
        -- A Box: a value on the heap, swapped and taken back out.
        let start: Int64 := 7;
        case makeBox(start) of
            when Right(right as box: Box[Int64]) do
                var b: Box[Int64] := box;
                print("in the box: ");
                printLn(readFree(&b));
                let eleven: Int64 := 11;
                let old: Int64 := boxSwap(&!b, eleven);
                print("swapped out: ");
                printLn(old);
                print("taken out: ");
                printLn(unbox(b));
            when Left(left as back: Int64) do
                printLn("no memory for the box");
        end case;
        -- Bounded: the ends of a number type, from the type alone.
        let smallest: Int8 := minBound();
        let largest: Nat16 := maxBound();
        print("the smallest Int8: ");
        printLn(smallest);
        print("the largest Nat16: ");
        printLn(largest);
        -- Equality through an instance of one's own.
        let p: Point := Point(x => 1, y => 2);
        let q: Point := Point(x => 1, y => 2);
        let r: Point := Point(x => 2, y => 1);
        print("(1, 2) equals (1, 2): ");
        printLn(equal(&p, &q));
        print("(1, 2) equals (2, 1): ");
        printLn(equal(&p, &r));
        -- A failure, wrapped once, described in one line.
        let failure: Failure := loadConfiguration();
        let text: String := describeFailure(&failure);
        print("failure: ");
        printLn(asSpan(&text));
        destroyString(text);
        print("steps in the chain: ");
        printLn(chainLength(&failure));
        print("as an HTTP status: ");
        printLn(httpStatus(kindOf(&failure)));
        destroyFailure(failure);
        return ExitSuccess();
    end;
end module body.
