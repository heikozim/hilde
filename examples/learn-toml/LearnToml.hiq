--
-- A server's configuration in TOML, read with Standard.Toml and asked by
-- paths; then two configurations that are refused, each with the line and
-- the column of what is wrong.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Toml (
    Toml,
    TomlError,
    TomlFault,
    CutShort,
    ByteOutOfPlace,
    BadString,
    BadNumber,
    BadDateTime,
    NotUtf8,
    DefinedTwice,
    NestedTooDeep,
    readToml,
    destroyToml,
    stringAt,
    integerAt,
    boolAt,
    dateTimeAt,
    countAt,
    keyAt
);

module body Example.LearnToml is
    function printText(label: Span[Nat8, Static], found: Option[String]): Unit is
        print(label);
        case found of
            when Some(value as s: String) do
                printLn(asSpan(&s));
                destroyString(s);
            when None do
                printLn("(none)");
        end case;
        return nil;
    end;

    function printWhole(label: Span[Nat8, Static], found: Option[Int64]): Unit is
        print(label);
        case found of
            when Some(value as v: Int64) do
                printLn(v);
            when None do
                printLn("(none)");
        end case;
        return nil;
    end;

    function faultName(fault: TomlFault): Span[Nat8, Static] is
        case fault of
            when CutShort do
                return "the text ends too soon";
            when ByteOutOfPlace do
                return "a byte out of place";
            when BadString do
                return "a bad string";
            when BadNumber do
                return "a bad number";
            when BadDateTime do
                return "a bad date or time";
            when NotUtf8 do
                return "bytes that are not UTF-8";
            when DefinedTwice do
                return "something defined twice";
            when NestedTooDeep do
                return "nested too deep";
        end case;
    end;

    function tryText(text: Span[Nat8, Static]): Unit is
        case readToml(text) of
            when Left(left as e: TomlError) do
                print("refused: ");
                print(faultName(e.fault));
                print(" at line ");
                print(e.line);
                print(", column ");
                printLn(e.column);
            when Right(right as d: Toml) do
                printLn("read");
                destroyToml(d);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        let config: Span[Nat8, Static] := "# The server\ntitle = \"example\"\n\n[server]\nhost = \"0.0.0.0\"\nport = 8_080\ntls = true\nstarted = 2026-09-28T01:00:00Z\n\n[[server.route]]\npath = \"/\"\nroot = '/var/www'\n\n[[server.route]]\npath = \"/api\"\nupstream = { host = \"127.0.0.1\", port = 9000 }\n";
        case readToml(config) of
            when Right(right as d: Toml) do
                printText("title: ", stringAt(&d, "title"));
                printText("host: ", stringAt(&d, "server.host"));
                printWhole("port: ", integerAt(&d, "server.port"));
                case boolAt(&d, "server.tls") of
                    when Some(value as b: Bool) do
                        print("tls: ");
                        printLn(b);
                    when None do
                        printLn("tls: (none)");
                end case;
                printText("started: ", dateTimeAt(&d, "server.started"));
                case countAt(&d, "server.route") of
                    when Some(value as n: Index) do
                        print("routes: ");
                        printLn(n);
                    when None do
                        printLn("routes: (none)");
                end case;
                printText("first route: ", stringAt(&d, "server.route[0].path"));
                printText("its root: ", stringAt(&d, "server.route[0].root"));
                printText("second route goes to: ", stringAt(&d, "server.route[1].upstream.host"));
                printWhole("on port: ", integerAt(&d, "server.route[1].upstream.port"));
                printText("the second key of server: ", keyAt(&d, "server", 1));
                printText("a key that is not there: ", stringAt(&d, "server.user"));
                destroyToml(d);
            when Left(left as e: TomlError) do
                printLn("the configuration was refused");
        end case;
        tryText("port = 8080\nport = 9090\n");
        tryText("[server]\nport = 080\n");
        return ExitSuccess();
    end;
end module body.
