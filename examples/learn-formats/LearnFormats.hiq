import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Png (
    Image,
    PngError,
    imageWidth,
    imageHeight,
    encodePng,
    decodePng,
    destroyImage
);
import Standard.Qr (
    QrCode,
    QrMedium,
    encodeQr,
    qrVersion,
    qrSize,
    qrModule,
    qrToImage,
    destroyQr
);
import Standard.Xml (
    XmlDocument,
    XmlError,
    parseXml,
    destroyXmlDocument,
    xmlFindStart,
    xmlInnerText,
    xmlAttributeOf,
    escapeXml
);
import Standard.Yaml (
    YamlError,
    yamlToJson
);
import Standard.Ssh (
    SshError,
    CommandResult,
    shellQuote,
    runCommand,
    destroyResult
);
import Standard.File (
    Command,
    makeCommand,
    addArgument
);

module body Example.LearnFormats is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    generic [R: Region]
    function printLine(label: Span[Nat8, Static], text: &[String, R]): Unit is
        print(label);
        printText(text);
        printLn("");
        return nil;
    end;

    generic [R: Region]
    function outputOf(result: &[CommandResult, R]): Unit is
        printLine("the remote shell would print: ", &(result->output));
        return nil;
    end;

    function qrPart(): Unit is
        case encodeQr("https://example.org/hilde", QrMedium()) of
            when Some(value as code: QrCode) do
                print("QR version ");
                print(qrVersion(&code));
                print(", ");
                print(qrSize(&code));
                printLn(" modules on a side");
                -- The top row, dark as a hash sign.
                var x: Index := 0;
                while x < qrSize(&code) do
                    if qrModule(&code, x, 0) then
                        print("#");
                    else
                        print(".");
                    end if;
                    x := x + 1;
                end while;
                printLn("");
                case qrToImage(&code, 4, 4) of
                    when Some(value as image: Image) do
                        let file: String := encodePng(&image);
                        case decodePng(asSpan(&file), 1000000) of
                            when Right(right as back: Image) do
                                print("the PNG reads back as ");
                                print(imageWidth(&back));
                                print(" by ");
                                print(imageHeight(&back));
                                printLn(" pixels");
                                destroyImage(back);
                            when Left(left as error: PngError) do
                                printLn("the PNG does not read back");
                        end case;
                        destroyString(file);
                        destroyImage(image);
                    when None do
                        printLn("no image");
                end case;
                destroyQr(code);
            when None do
                printLn("no code");
        end case;
        return nil;
    end;

    function xmlPart(): Unit is
        case parseXml("<feed><entry id=\"7\"><title>Fish &amp; chips</title></entry></feed>") of
            when Right(right as document: XmlDocument) do
                case xmlFindStart(&document, 0, "entry") of
                    when Some(value as entry: Index) do
                        case xmlAttributeOf(&document, entry, "id") of
                            when Some(value as id: String) do
                                printLine("entry id: ", &id);
                                destroyString(id);
                            when None do
                                printLn("no id");
                        end case;
                        let text: String := xmlInnerText(&document, entry);
                        printLine("its text: ", &text);
                        destroyString(text);
                    when None do
                        printLn("no entry");
                end case;
                destroyXmlDocument(document);
            when Left(left as error: XmlError) do
                printLn("not well formed");
        end case;
        case parseXml("<!DOCTYPE x [<!ENTITY e SYSTEM \"file:///etc/passwd\">]><x>&e;</x>") of
            when Right(right as document: XmlDocument) do
                destroyXmlDocument(document);
                printLn("an external entity was read");
            when Left(left as error: XmlError) do
                print("a document type is refused at byte ");
                printLn(error.offset);
        end case;
        let escaped: String := escapeXml("<a & b>");
        printLine("escaped: ", &escaped);
        destroyString(escaped);
        return nil;
    end;

    function yamlPart(): Unit is
        case yamlToJson("server:\n  port: 8443\n  hosts: [a.example.org, b.example.org]\nversion: 1.2.3\n") of
            when Right(right as json: String) do
                printLine("the YAML as JSON: ", &json);
                destroyString(json);
            when Left(left as error: YamlError) do
                printLn("not read");
        end case;
        case yamlToJson("a: &x 1\nb: *x\n") of
            when Right(right as json: String) do
                destroyString(json);
                printLn("an alias was read");
            when Left(left as error: YamlError) do
                print("an anchor is refused in line ");
                printLn(error.line);
        end case;
        return nil;
    end;

    function sshPart(): Unit is
        let word: String := shellQuote("a b; rm -rf /");
        printLine("one word for the remote shell: ", &word);
        -- /bin/sh in place of the remote shell runs the quoted word as
        -- echo's argument.
        let script: Span[Nat8, Static] := "echo 'a b; rm -rf /'";
        let command: Command := addArgument(addArgument(makeCommand("/bin/sh"), "-c"), script);
        case runCommand(command, 5000, 4096) of
            when Right(right as result: CommandResult) do
                outputOf(&result);
                destroyResult(result);
            when Left(left as error: SshError) do
                printLn("the shell did not run");
        end case;
        destroyString(word);
        return nil;
    end;

    function main(): ExitCode is
        qrPart();
        xmlPart();
        yamlPart();
        sshPart();
        return ExitSuccess();
    end;
end module body.
