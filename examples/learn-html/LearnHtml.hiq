import Standard.String (
    String,
    destroyString,
    length,
    getSpan
);
import Standard.Html (
    TokenKind,
    Document,
    Policy,
    parseHtml,
    destroyDocument,
    tokenCount,
    tokenKind,
    tokenText,
    attributeOf,
    textOf,
    escapeHtml,
    basicPolicy,
    makePolicy,
    sanitize
);

module body Example.LearnHtml is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    function kindName(kind: Option[TokenKind]): Span[Nat8, Static] is
        case kind of
            when Some(value as found: TokenKind) do
                case found of
                    when TextToken do
                        return "text";
                    when StartTag do
                        return "start";
                    when EndTag do
                        return "end";
                    when CommentToken do
                        return "comment";
                    when DoctypeToken do
                        return "doctype";
                end case;
            when None do
                return "none";
        end case;
    end;

    function main(): ExitCode is
        let comment: Span[Nat8, Static] := "<p class=note>Fish &amp; chips<a href=\"https://example.org/\" onclick=\"steal()\">menu</a><script>steal()</script></p>";
        -- The tokens of a comment a visitor wrote.
        let document: Document := parseHtml(comment);
        var n: Index := 0;
        while n < tokenCount(&document) do
            print(kindName(tokenKind(&document, n)));
            print(" ");
            printLn(tokenText(&document, n));
            n := n + 1;
        end while;
        case attributeOf(&document, 2, "href") of
            when Some(value as href: String) do
                print("the link goes to ");
                printText(&href);
                printLn("");
                destroyString(href);
            when None do
                printLn("no link");
        end case;
        destroyDocument(document);
        -- Its text, for a search index or a mail.
        let text: String := textOf(comment);
        print("text: ");
        printText(&text);
        printLn("");
        destroyString(text);
        -- What a page may show of it.
        let clean: String := sanitize(comment, basicPolicy());
        print("shown: ");
        printText(&clean);
        printLn("");
        destroyString(clean);
        let attack: String := sanitize("<a href=\"java&#x09;script:alert(1)\">x</a><img src=x onerror=alert(1)>", basicPolicy());
        print("an attack: ");
        printText(&attack);
        printLn("");
        destroyString(attack);
        -- A policy that also takes pictures.
        case makePolicy("p,img", "src,alt", false) of
            when Some(value as pictures: Policy) do
                let shown: String := sanitize("<p><img src=\"/cat.png\" alt=\"a cat\" width=900></p>", pictures);
                print("with pictures: ");
                printText(&shown);
                printLn("");
                destroyString(shown);
            when None do
                printLn("no policy");
        end case;
        let escaped: String := escapeHtml("<b>&\"'");
        print("escaped: ");
        printText(&escaped);
        printLn("");
        destroyString(escaped);
        return ExitSuccess();
    end;
end module body.
