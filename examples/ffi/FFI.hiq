pragma Unsafe_Module;

module body Example.FFI is
    -- The two C functions bound here live in the runtime prelude, not in
    -- libc, and that is the point of the example: a binding is written in
    -- the types the language can spell, and the C side does whatever
    -- conversion the abi wants.  Binding libc's puts directly is not
    -- possible -- it takes a const char* and Hilde has no type that
    -- renders as one -- and binding putchar directly was a declaration
    -- that did not match the one the C compiler already knows.
    pragma Foreign_Import(External_Name => "hilde_put_character");
    function Put_Character(character: Nat8): Int32 is
    end;

    pragma Foreign_Import(External_Name => "hilde_put_string");
    function Put_String_Bytes(str: Span[Nat8, Static], size: Index): Int32 is
    end;

    function Put_String(str: Span[Nat8, Static]): Int32 is
        return Put_String_Bytes(str, spanLength(str));
    end;

    function main(): ExitCode is
        Put_Character(97);
        Put_String("Hello, world!");
        return ExitSuccess();
    end;
end module body.
