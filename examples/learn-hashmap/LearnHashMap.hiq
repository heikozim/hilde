--
-- The words of a sentence counted in a hash map.  Standard.HashMap hashes
-- its keys with SipHash-1-3 under a key the system's random source gives
-- every map, so the slots differ from run to run; the entries themselves
-- stand one after another, in the order they came in, so what the
-- programme prints is the same on every run.
import Standard.Tuples (
    Pair
);
import Standard.String (
    String,
    fromLiteral,
    fromSpan,
    destroyString,
    asSpan
);
-- A key must be Hashable and have a TotalOrder; a module sees the
-- instances for String only through imports from their modules.
import Standard.Order (
    TotalOrder
);
import Standard.Hash (
    Hashable
);
import Standard.Text (
    substring
);
import Standard.HashMap (
    HashMap,
    makeHashMap,
    destroyEmpty,
    size,
    getRef,
    put,
    remove,
    keyAt,
    valueAt,
    removeAt
);

module body Example.LearnHashMap is
    -- One more of word: its count raised, or word put in with a count of
    -- one.  The map takes the word over; one it holds already is destroyed.
    generic [R: Region]
    function count(words: &![HashMap[String, Nat64], R], word: String): Unit is
        let seen: Nat64 := countOf(&words, &word);
        case put(&~words, word, seen + 1) of
            when Some(value as old: Pair[String, Nat64]) do
                let { first: String, second: Nat64 } := old;
                destroyString(first);
            when None do
                skip;
        end case;
        return nil;
    end;

    -- How often word was counted, 0 when it is not in the map.
    generic [R: Region, S: Region]
    function countOf(words: &[HashMap[String, Nat64], R], word: &[String, S]): Nat64 is
        case getRef(words, word) of
            when Some(value as c: &[Nat64, R]) do
                return !c;
            when None do
                return 0;
        end case;
    end;

    -- Every entry by its position, from 0 until keyAt says None.
    generic [R: Region]
    function printAll(words: &[HashMap[String, Nat64], R]): Unit is
        var pos: Index := 0;
        var going: Bool := true;
        while going do
            case keyAt(words, pos) of
                when Some(value as k: &[String, R]) do
                    print("  ");
                    print(asSpan(k));
                    print(" ");
                    case valueAt(words, pos) of
                        when Some(value as v: &[Nat64, R]) do
                            printLn(!v);
                        when None do
                            printLn("?");
                    end case;
                    pos := pos + 1;
                when None do
                    going := false;
            end case;
        end while;
        return nil;
    end;

    function main(): ExitCode is
        let sentence: Span[Nat8, Static] := "the cat saw the dog and the dog saw the cat";
        var words: HashMap[String, Nat64] := makeHashMap();
        var start: Index := 0;
        var i: Index := 0;
        let n: Index := spanLength(sentence);
        while i <= n do
            var ends: Bool := i = n;
            if not ends then
                ends := sentence[i] = ' ';
            end if;
            if ends then
                var word: String := fromLiteral("");
                if i > start then
                    destroyString(word);
                    word := sliceOf(sentence, start, i);
                end if;
                count(&!words, word);
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        print("different words: ");
        printLn(size(&words));
        printAll(&words);
        let saw: String := fromLiteral("saw");
        case remove(&!words, &saw) of
            when Some(value as p: Pair[String, Nat64]) do
                let { first: String, second: Nat64 } := p;
                print("removed saw, counted ");
                printLn(second);
                destroyString(first);
            when None do
                printLn("saw was not there");
        end case;
        destroyString(saw);
        printLn("after the removal, the last entry in its place:");
        printAll(&words);
        let bird: String := fromLiteral("bird");
        print("bird: ");
        printLn(countOf(&words, &bird));
        destroyString(bird);
        while size(&words) > 0 do
            case removeAt(&!words, 0) of
                when Some(value as p: Pair[String, Nat64]) do
                    let { first: String, second: Nat64 } := p;
                    destroyString(first);
                when None do
                    skip;
            end case;
        end while;
        destroyEmpty(words);
        return ExitSuccess();
    end;

    function sliceOf(text: Span[Nat8, Static], start: Index, stop: Index): String is
        return fromSpan(substring(text, start, stop));
    end;
end module body.
