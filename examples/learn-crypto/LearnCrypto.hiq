--
-- Cryptography through the system's libcrypto, with Standard.Libcrypto:
-- a digest, a message authentication code, a message sealed and opened
-- with ChaCha20-Poly1305, a signature with Ed25519, and random bytes.
-- The keys here are fixed so that the output is the same on every run; a
-- real key comes from randomBytes and is never written into a programme.
import Standard.String (
    String,
    destroyString,
    length as stringLength,
    asSpan
);
import Standard.Text (
    bytesToHex,
    hexToBytes
);
import Standard.Libcrypto (
    randomBytes,
    sha256,
    hmacSha256,
    sealChaCha20Poly1305,
    openChaCha20Poly1305,
    ed25519PublicKey,
    ed25519Sign,
    ed25519Verify
);

module body Example.LearnCrypto is
    function printHex(label: Span[Nat8, Static], found: Option[String]): Unit is
        print(label);
        case found of
            when Some(value as bytes: String) do
                let hex: String := bytesToHex(asSpan(&bytes));
                printLn(asSpan(&hex));
                destroyString(hex);
                destroyString(bytes);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function bytesOf(hex: Span[Nat8, Static]): String is
        case hexToBytes(hex) of
            when Some(value as b: String) do
                return b;
            when None do
                abort("a key that is no hexadecimal");
        end case;
    end;

    function main(): ExitCode is
        printHex("SHA-256 of abc: ", sha256("abc"));
        printHex("HMAC-SHA256: ", hmacSha256("key", "The quick brown fox jumps over the lazy dog"));
        -- Seal and open with a fixed key and nonce; a changed byte is refused.
        let key: String := bytesOf("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f");
        let nonce: String := bytesOf("000000000000004a00000000");
        case sealChaCha20Poly1305(asSpan(&key), asSpan(&nonce), "attack at dawn", "header") of
            when Some(value as sealed: String) do
                print("sealed: ");
                print(stringLength(&sealed));
                printLn(" bytes, the text and a tag of 16");
                case openChaCha20Poly1305(asSpan(&key), asSpan(&nonce), asSpan(&sealed), "header") of
                    when Some(value as opened: String) do
                        print("opened: ");
                        printLn(asSpan(&opened));
                        destroyString(opened);
                    when None do
                        printLn("opened: refused");
                end case;
                case openChaCha20Poly1305(asSpan(&key), asSpan(&nonce), asSpan(&sealed), "another header") of
                    when Some(value as opened: String) do
                        printLn("opened under another header, which it must not");
                        destroyString(opened);
                    when None do
                        printLn("opened under another header: refused");
                end case;
                destroyString(sealed);
            when None do
                printLn("not sealed");
        end case;
        destroyString(key);
        destroyString(nonce);
        -- Ed25519: a fixed seed, its public key, a signature and its check.
        let seed: String := bytesOf("9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60");
        printHex("public key: ", ed25519PublicKey(asSpan(&seed)));
        case ed25519Sign(asSpan(&seed), "") of
            when Some(value as signature: String) do
                case ed25519PublicKey(asSpan(&seed)) of
                    when Some(value as public: String) do
                        print("the signature holds: ");
                        printLn(ed25519Verify(asSpan(&public), "", asSpan(&signature)));
                        print("for another message: ");
                        printLn(ed25519Verify(asSpan(&public), "x", asSpan(&signature)));
                        destroyString(public);
                    when None do
                        printLn("no public key");
                end case;
                destroyString(signature);
            when None do
                printLn("not signed");
        end case;
        destroyString(seed);
        -- Random bytes: only their number is the same on every run.
        case randomBytes(32) of
            when Some(value as r: String) do
                print("random bytes: ");
                printLn(stringLength(&r));
                destroyString(r);
            when None do
                printLn("no random bytes");
        end case;
        return ExitSuccess();
    end;
end module body.
