module body Example.LearnMatch is
    -- A key of a keyboard: a character by its code, or one of two keys
    -- that are not characters.
    union Key: Free is
        case Char is
            code: Nat8;
        case Enter;
        case Escape;
    end;

    -- What a programme is told: a key was pressed, with or without shift,
    -- or some time has passed.
    union Event: Free is
        case Press is
            key: Key;
            shift: Bool;
        case Tick is
            millis: Nat32;
    end;

    -- The patterns look two levels deep: into the event and into its key.
    -- A range such as 97 .. 122 takes every value from 97 to 122, the
    -- small letters a to z.  A bar joins patterns that have the same
    -- answer, and an underscore takes any value without a name.  The first
    -- pattern that fits is taken, and the compiler refuses a case that
    -- leaves out a value.
    function describe(event: Event): Unit is
        case event of
            when Press(Char(97 .. 122), false) do
                printLn("a small letter");
            when Press(Char(97 .. 122), true) | Press(Char(65 .. 90), _) do
                printLn("a capital letter");
            when Press(Char(48 .. 57), _) do
                printLn("a digit");
            when Press(Char(_), _) do
                printLn("another character");
            when Press(Enter, _) | Press(Escape, _) do
                printLn("a key that is not a character");
            when Tick(0) do
                printLn("no time at all");
            when Tick(millis) do
                print("a tick of ");
                print(millis);
                printLn(" ms");
        end case;
        return nil;
    end;

    function press(code: Nat8, shift: Bool): Event is
        return Press(key => Char(code => code), shift => shift);
    end;

    function main(): ExitCode is
        describe(press('q', false));
        describe(press('q', true));
        describe(press('Q', false));
        describe(press('7', false));
        describe(press('!', true));
        describe(Press(key => Enter(), shift => false));
        let none: Nat32 := 0;
        let quarter: Nat32 := 250;
        describe(Tick(millis => none));
        describe(Tick(millis => quarter));
        return ExitSuccess();
    end;
end module body.
