--
-- Passwords are stored as Argon2id hashes, never as they were typed.  A new
-- hash has a random salt, so it is different every time; only its start,
-- which names the method and its costs, is the same, and only that is
-- printed.  Checking a password against a stored hash says more than yes
-- or no: an old bcrypt hash that matches asks for a new hash to be stored.
import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Password (
    PasswordCheck,
    hashPassword,
    checkPassword
);

module body Example.LearnPassword is
    function printCheck(what: Span[Nat8, Static], result: PasswordCheck): Unit is
        print(what);
        print(": ");
        case result of
            when Matches do
                printLn("matches");
            when MatchesStoreAgain do
                printLn("matches, store a new hash");
            when DoesNotMatch do
                printLn("does not match");
            when Unreadable do
                printLn("not a hash this module can read");
            when Failed do
                printLn("the check failed");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case hashPassword("correct horse") of
            when Some(value as stored: String) do
                -- The method and its costs: Argon2id, 64 MiB of memory,
                -- three passes, four lanes.
                print("a new hash starts with: ");
                printLn(getSpan(&stored, 0, 30));
                printCheck("the right password", checkPassword("correct horse", asSpan(&stored)));
                printCheck("a wrong password", checkPassword("correct house", asSpan(&stored)));
                destroyString(stored);
            when None do
                printLn("no hash could be made");
        end case;
        -- A hash made by another programme with the same method.
        printCheck("a stored Argon2id hash",
            checkPassword("hilde-cross-check", "$argon2id$v=19$m=65536,t=3,p=4$WFdChB+rfrsq/IdBtloWFQ$Dyh1ObjtdpMVu8ssmCtUd7Hy1VJ5Bt+sOzq0Zecu4BY"));
        -- An old bcrypt hash, the known test vector for the password U*U.
        printCheck("an old bcrypt hash",
            checkPassword("U*U", "$2b$05$CCCCCCCCCCCCCCCCCCCCC.E5YPO9kmyuRGyh0XouQYb4YMJKvyOeW"));
        printCheck("a broken string", checkPassword("anything", "$argon2id$broken"));
        return ExitSuccess();
    end;
end module body.
