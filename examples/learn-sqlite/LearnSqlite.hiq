--
-- SQLite in memory: no file is made.  The table comes from the files under
-- migrations, and each query is checked by the compiler against it: a
-- column that does not exist, or a row type whose slots do not fit the
-- columns, is a compile error.
import Standard.Sqlite (
    Connection,
    Writing,
    SqlError,
    describe,
    openWriter,
    closeDatabase,
    migrate
);

module body Example.LearnSqlite is
    -- A row of the query below; the text points into the row while the
    -- loop body runs.
    record Note[R: Region]: Free is
        id: Int64;
        content: Span[Nat8, R];
    end;

    function failed(what: Span[Nat8, Static], error: SqlError): Unit is
        print(what);
        print(": failed, code ");
        print(error.code);
        print(", ");
        printLn(describe(error));
        return nil;
    end;

    function report(what: Span[Nat8, Static], result: Either[SqlError, Nat64]): Unit is
        case result of
            when Left(left as error: SqlError) do
                failed(what, error);
            when Right(right as changed: Nat64) do
                print(what);
                print(": ");
                print(changed);
                printLn(" row");
        end case;
        return nil;
    end;

    generic [R: Region]
    function run(db: &![Connection[Writing], R]): Unit is
        case migrate(&~db, @migrations) of
            when Left(left as error: SqlError) do
                failed("migrate", error);
            when Right(right as applied: Index) do
                print("migrations applied: ");
                printLn(applied);
        end case;
        -- The values go to SQLite as parameters, never into the text of
        -- the statement.
        report("insert", @execute(&~db, "INSERT INTO notes (content) VALUES (?)", "buy bread"));
        report("insert", @execute(&~db, "INSERT INTO notes (content) VALUES (?)", "call Ann"));
        report("insert", @execute(&~db, "INSERT INTO notes (content) VALUES (?)", "water the plants"));
        @query(&~db, "SELECT id, content FROM notes ORDER BY id")
            for note: Note[Q] do
            print(note.id);
            print(" ");
            printLn(note.content);
        else error do
            failed("select", error);
        end for;
        return nil;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                failed("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                run(&!db);
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
