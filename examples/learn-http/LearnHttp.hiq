--
-- The web server's side, in memory.  Standard.Http reads the header lines
-- of a request; Standard.Fcgi reads and writes the records a web server
-- such as Hiawatha sends a FastCGI application, and turns a header's name
-- into the variable a CGI program would see.  No socket is opened.
import Standard.String (
    String,
    destroyString,
    length as stringLength,
    asSpan
);
import Standard.Http (
    headerCount,
    nthHeaderName,
    headerValue,
    valueHasToken
);
import Standard.Fcgi (
    RecordHeader,
    readHeader,
    headerKind,
    headerRequestId,
    headerContentLength,
    recordLength,
    makeRecord,
    makeEndRequest,
    makePair,
    pairCount,
    nthPairName,
    nthPairValue,
    headerToVariable
);

module body Example.LearnHttp is
    function printOption(label: Span[Nat8, Static], found: Option[String]): Unit is
        print(label);
        case found of
            when Some(value as s: String) do
                printLn(asSpan(&s));
                destroyString(s);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        -- The header lines of a request; they end at the empty line.
        let request: Span[Nat8, Static] := "Host: example.org\r\nConnection: keep-alive, Upgrade\r\nUpgrade: websocket\r\nContent-Type: text/plain\r\n\r\nthe body";
        print("header lines: ");
        printLn(headerCount(request));
        printOption("the first name: ", nthHeaderName(request, 0));
        printOption("Host: ", headerValue(request, "host"));
        case headerValue(request, "connection") of
            when Some(value as c: String) do
                print("the connection is to be upgraded: ");
                printLn(valueHasToken(asSpan(&c), "upgrade"));
                destroyString(c);
            when None do
                printLn("no connection header");
        end case;
        printOption("as a CGI variable: ", headerToVariable("Content-Type: text/plain"));
        printOption("a name with a byte out of place: ", headerToVariable("Content_Type: x"));
        -- FastCGI: parameters as name-value pairs in one record.
        case makePair("SCRIPT_NAME", "/index.hiq") of
            when Some(value as pair: String) do
                print("pairs in the block: ");
                printLn(pairCount(asSpan(&pair)));
                printOption("its name: ", nthPairName(asSpan(&pair), 0));
                printOption("its value: ", nthPairValue(asSpan(&pair), 0));
                let paramsKind: Nat8 := 4;
                let requestId: Nat64 := 1;
                case makeRecord(paramsKind, requestId, asSpan(&pair)) of
                    when Some(value as framed: String) do
                        print("the record: ");
                        print(stringLength(&framed));
                        printLn(" bytes, a multiple of eight");
                        case readHeader(asSpan(&framed), 0) of
                            when Some(value as header: RecordHeader) do
                                print("kind ");
                                print(headerKind(header));
                                print(", request ");
                                print(headerRequestId(header));
                                print(", content ");
                                print(headerContentLength(header));
                                print(" bytes, the whole record ");
                                printLn(recordLength(header));
                            when None do
                                printLn("the header could not be read");
                        end case;
                        destroyString(framed);
                    when None do
                        printLn("no record");
                end case;
                destroyString(pair);
            when None do
                printLn("no pair");
        end case;
        -- The end of a request, as the application says it.
        let endId: Nat64 := 1;
        let appStatus: Nat64 := 0;
        let complete: Nat8 := 0;
        let ending: String := makeEndRequest(endId, appStatus, complete);
        print("the end of the request: ");
        print(stringLength(&ending));
        printLn(" bytes");
        destroyString(ending);
        return ExitSuccess();
    end;
end module body.
