module body Example.Union is
    function main(): ExitCode is
        let c: Color := Red();
        case c of
            when Red do
                skip;
            when Green do
                skip;
            when Blue do
                skip;
        end case;
        let n: Number := Integer(value => 10);
        case n of
            when Integer(value: Int32) do
                skip;
            when Float(value: Float64) do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
