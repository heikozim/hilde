--
-- Prints the descriptions of all ranks of one job on this host, one line a
-- rank, rank 0 first, each as hexadecimal digits as a launcher hands it to a
-- rank.  The one argument is the number of ranks, 1 to 16.  The lines hold
-- secret keys of a throw-away job: keep them out of the repository.
import Standard.Arguments (
    processArguments
);
import Standard.Buffer (
    Buffer,
    length,
    nthRef,
    removeLast,
    destroyEmpty
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Text (
    bytesToHex,
    parseNat
);
import Standard.SperliLaunch (
    HostList,
    Launch,
    parseHostList,
    destroyHostList,
    newLaunch,
    describeRank,
    destroyLaunch
);

module body Mixed.Describe is
    function destroyWords(words: Buffer[String]): Unit is
        var rest: Buffer[String] := words;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    -- The number the only argument holds, or 0 when it is none or not 1 to 16.
    function rankCount(): Nat64 is
        let words: Buffer[String] := processArguments();
        var ranks: Nat64 := 0;
        if length(&words) = 1 then
            case parseNat(asSpan(nthRef(&words, 0))) of
                when Some(value as number: Nat64) do
                    if (number >= 1) and (number <= 16) then
                        ranks := number;
                    end if;
                when None do
                    ranks := 0;
            end case;
        end if;
        destroyWords(words);
        return ranks;
    end;

    generic [R: Region]
    function printRank(launch: &[Launch, R], rank: Nat32): Int32 is
        case describeRank(launch, rank) of
            when Some(value as description: String) do
                let text: String := bytesToHex(asSpan(&description));
                printLn(asSpan(&text));
                destroyString(text);
                destroyString(description);
                return 0;
            when None do
                return 1;
        end case;
    end;

    generic [R: Region]
    function describeAll(hosts: &[HostList, R], ranks: Nat32): Int32 is
        case newLaunch(hosts, ranks, 1, 600) of
            when Right(right as launch: Launch) do
                var status: Int32 := 0;
                var rank: Nat32 := 0;
                while (status = 0) and (rank < ranks) do
                    status := printRank(&launch, rank);
                    rank := rank + 1;
                end while;
                destroyLaunch(launch);
                return status;
            when Left(left as code: Int32) do
                return 1;
        end case;
    end;

    function main(root: RootCapability): ExitCode is
        surrenderRoot(root);
        let ranks: Nat64 := rankCount();
        if ranks = 0 then
            return ExitFailure();
        end if;
        case parseHostList("localhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\nlocalhost\n", "") of
            when Right(right as hosts: HostList) do
                var status: Int32 := 1;
                case toNat32(ranks) of
                    when Some(value as count: Nat32) do
                        status := describeAll(&hosts, count);
                    when None do
                        status := 1;
                end case;
                destroyHostList(hosts);
                if status = 0 then
                    return ExitSuccess();
                end if;
                return ExitFailure();
            when Left(left as code: Int32) do
                return ExitFailure();
        end case;
    end;
end module body.
