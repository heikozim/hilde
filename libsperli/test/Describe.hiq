--
-- Prints the description of rank 0 of a job of one rank on this host, as
-- hexadecimal digits on one line, as a launcher hands it to a rank.  The
-- tests of libsperli read it to join a job of their own.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Text (
    bytesToHex
);
import Standard.SperliLaunch (
    HostList,
    Launch,
    parseHostList,
    destroyHostList,
    newLaunch,
    describeRank,
    destroyLaunch
);

module body Libsperli.Describe is
    generic [R: Region]
    function printRank(launch: &[Launch, R]): Int32 is
        case describeRank(launch, 0) of
            when Some(value as description: String) do
                let text: String := bytesToHex(asSpan(&description));
                printLn(asSpan(&text));
                destroyString(text);
                destroyString(description);
                return 0;
            when None do
                return 1;
        end case;
    end;

    generic [R: Region]
    function describeOne(hosts: &[HostList, R]): Int32 is
        case newLaunch(hosts, 1, 1, 600) of
            when Right(right as launch: Launch) do
                let status: Int32 := printRank(&launch);
                destroyLaunch(launch);
                return status;
            when Left(left as code: Int32) do
                return 1;
        end case;
    end;

    function main(root: RootCapability): ExitCode is
        surrenderRoot(root);
        case parseHostList("localhost\n", "") of
            when Right(right as hosts: HostList) do
                let status: Int32 := describeOne(&hosts);
                destroyHostList(hosts);
                if status = 0 then
                    return ExitSuccess();
                end if;
                return ExitFailure();
            when Left(left as code: Int32) do
                return ExitFailure();
        end case;
    end;
end module body.
