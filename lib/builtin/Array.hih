"""
Hilde.Array: a growable array on the heap, built into the compiler.

It is the one place outside the bindings of C libraries where memory is
asked for, grown and given back.  Standard.Buffer and Standard.Box are
built on it and are safe modules.  Every operation checks what it is
given: an index outside the elements, or a span whose bounds are out of
order or outside the elements, stops the programme with a message.
Nothing hands out a pointer.

An array holds its elements from position 0 to its length minus 1.  Its
room grows by doubling when an insert needs it, and never shrinks.  The
elements may be linear: whatever leaves the array comes back to the
caller, and an array is given back only empty, or whole when its elements
are free.
"""
module Hilde.Array is
    """
    The array type.  Linear: it must be given back.
    """
    type Array[T: Type]: Linear;

    """
    An empty array with room for capacity elements, at least one.  None
    when the memory cannot be had.
    """
    generic [T: Type]
    function allocateArray(capacity: Index): Option[Array[T]];

    """
    The number of elements.
    """
    generic [T: Type, R: Region]
    function arrayLength(array: &[Array[T], R]): Index;

    """
    A copy of the element at pos, for a free element.  Stops the programme
    when pos is not less than the length.
    """
    generic [T: Free, R: Region]
    function arrayNth(array: &[Array[T], R], pos: Index): T;

    """
    A reference to the element at pos.  It lives as long as the borrow of
    the array, so the array cannot change while it is held.  Stops the
    programme when pos is not less than the length.
    """
    generic [T: Type, R: Region]
    function arrayNthRef(array: &[Array[T], R], pos: Index): &[T, R];

    """
    Replace the free element at pos with value.  Stops the programme when
    pos is not less than the length.
    """
    generic [T: Free, R: Region]
    function arrayStore(array: &![Array[T], R], pos: Index, value: T): Unit;

    """
    Put value at pos and hand back the element that was there.  Stops the
    programme when pos is not less than the length.
    """
    generic [T: Type, R: Region]
    function arraySwap(array: &![Array[T], R], pos: Index, value: T): T;

    """
    Exchange the elements at a and b.  Stops the programme when either is
    not less than the length.
    """
    generic [T: Type, R: Region]
    function arraySwapIndex(array: &![Array[T], R], a: Index, b: Index): Unit;

    """
    Replace the element at pos with fn applied to it.  Stops the programme
    when pos is not less than the length.
    """
    generic [T: Type, R: Region]
    function arrayApply(array: &![Array[T], R], pos: Index, fn: Fn[T, T]): Unit;

    """
    Insert value at pos, moving the elements from pos on one place up.  pos
    may be the length, which appends.  Stops the programme when pos is
    greater than the length, or when the room cannot grow.
    """
    generic [T: Type, R: Region]
    function arrayInsert(array: &![Array[T], R], pos: Index, value: T): Unit;

    """
    Take the element at pos out, moving the elements after it one place
    down.  Stops the programme when pos is not less than the length.
    """
    generic [T: Type, R: Region]
    function arrayRemove(array: &![Array[T], R], pos: Index): T;

    """
    The elements from start to final, both included, as a read span.  Stops
    the programme when start is greater than final or final is not less
    than the length.
    """
    generic [T: Type, R: Region]
    function arraySpan(array: &[Array[T], R], start: Index, final: Index): Span[T, R];

    """
    The same as a write span.
    """
    generic [T: Type, R: Region]
    function arraySpanMut(array: &![Array[T], R], start: Index, final: Index): Span![T, R];

    """
    All the elements as a read span.  An empty array gives an empty span, so
    this never stops the programme.
    """
    generic [T: Type, R: Region]
    function arrayWholeSpan(array: &[Array[T], R]): Span[T, R];

    """
    Give back an empty array.  Stops the programme when an element is still
    in it: the element would be lost, and a linear one must not be.
    """
    generic [T: Type]
    function destroyEmptyArray(array: Array[T]): Unit;

    """
    Give back an array of free elements, whatever it holds.
    """
    generic [T: Free]
    function destroyFreeArray(array: Array[T]): Unit;

    """
    Give back an array of free elements after overwriting all its storage,
    the whole capacity, with zeros, in a way the C compiler does not drop.
    """
    generic [T: Free]
    function destroyWipedArray(array: Array[T]): Unit;
end module.
