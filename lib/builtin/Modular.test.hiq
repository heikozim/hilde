-- SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
--
-- Tests for the ModularArithmetic instances of Hilde.Pervasive.
--
-- Modular arithmetic is arithmetic modulo 2^w, where w is the width of the
-- type: the mathematical result is reduced into the range of the type. For
-- a signed type of width w that range is -2^(w-1) .. 2^(w-1)-1, for an
-- unsigned type 0 .. 2^w-1. Every expected value below is derived by hand
-- in the comment above it, so the test says what the answer should be
-- instead of recording what the implementation happens to produce.
--
-- These tests exist because the meaning of the signed cases once depended
-- on how the C compiler was invoked: the generated C did the arithmetic in
-- the signed type, where overflow is undefined behaviour. It no longer
-- does -- the bodies compute in an unsigned type -- so the answers below
-- hold whatever the C compiler is told.
--
import Standard.Testing (
    assertTrue
);

module body Hilde.Modular.Test is
    ---
    --- Signed types. Modulus 2^w; a result r outside the range is the
    --- unique value in the range with r congruent modulo 2^w.
    ---

    -- Int8, modulus 256, range -128 .. 127.
    function testInt8(): Unit is
        let max: Int8 := maximum_int8;
        let min: Int8 := minimum_int8;
        let one: Int8 := 1;
        let two: Int8 := 2;
        let negOne: Int8 := -1;
        let negTwo: Int8 := -2;
        let zero: Int8 := 0;
        -- 127 + 1 = 128, and 128 - 256 = -128
        assertTrue(modularAdd(max, one) = min, "Int8: 127 + 1 = -128");
        -- 127 + 127 = 254, and 254 - 256 = -2
        assertTrue(modularAdd(max, max) = negTwo, "Int8: 127 + 127 = -2");
        -- -128 + -1 = -129, and -129 + 256 = 127
        assertTrue(modularAdd(min, negOne) = max, "Int8: -128 + -1 = 127");
        -- -128 - 1 = -129, and -129 + 256 = 127
        assertTrue(modularSubtract(min, one) = max, "Int8: -128 - 1 = 127");
        -- 127 - -1 = 128, and 128 - 256 = -128
        assertTrue(modularSubtract(max, negOne) = min, "Int8: 127 - -1 = -128");
        -- 127 * 2 = 254, and 254 - 256 = -2
        assertTrue(modularMultiply(max, two) = negTwo, "Int8: 127 * 2 = -2");
        -- -128 * -1 = 128, and 128 - 256 = -128
        assertTrue(modularMultiply(min, negOne) = min, "Int8: -128 * -1 = -128");
        -- -128 * 2 = -256, and -256 + 256 = 0
        assertTrue(modularMultiply(min, two) = zero, "Int8: -128 * 2 = 0");
        return nil;
    end;

    -- Int16, modulus 65536, range -32768 .. 32767.
    function testInt16(): Unit is
        let max: Int16 := maximum_int16;
        let min: Int16 := minimum_int16;
        let one: Int16 := 1;
        let two: Int16 := 2;
        let negOne: Int16 := -1;
        let negTwo: Int16 := -2;
        let zero: Int16 := 0;
        -- 32767 + 1 = 32768, and 32768 - 65536 = -32768
        assertTrue(modularAdd(max, one) = min, "Int16: 32767 + 1 = -32768");
        -- 32767 + 32767 = 65534, and 65534 - 65536 = -2
        assertTrue(modularAdd(max, max) = negTwo, "Int16: 32767 + 32767 = -2");
        -- -32768 + -1 = -32769, and -32769 + 65536 = 32767
        assertTrue(modularAdd(min, negOne) = max, "Int16: -32768 + -1 = 32767");
        -- -32768 - 1 = -32769, and -32769 + 65536 = 32767
        assertTrue(modularSubtract(min, one) = max, "Int16: -32768 - 1 = 32767");
        -- 32767 - -1 = 32768, and 32768 - 65536 = -32768
        assertTrue(modularSubtract(max, negOne) = min, "Int16: 32767 - -1 = -32768");
        -- 32767 * 2 = 65534, and 65534 - 65536 = -2
        assertTrue(modularMultiply(max, two) = negTwo, "Int16: 32767 * 2 = -2");
        -- -32768 * -1 = 32768, and 32768 - 65536 = -32768
        assertTrue(modularMultiply(min, negOne) = min, "Int16: -32768 * -1 = -32768");
        -- -1 * -1 = 1, which is in range and needs no reduction
        assertTrue(modularMultiply(negOne, negOne) = one, "Int16: -1 * -1 = 1");
        return nil;
    end;

    -- Int32, modulus 4294967296, range -2147483648 .. 2147483647.
    function testInt32(): Unit is
        let max: Int32 := maximum_int32;
        let min: Int32 := minimum_int32;
        let one: Int32 := 1;
        let two: Int32 := 2;
        let negOne: Int32 := -1;
        let negTwo: Int32 := -2;
        let zero: Int32 := 0;
        -- 2147483647 + 1 = 2147483648, minus 4294967296 = -2147483648
        assertTrue(modularAdd(max, one) = min, "Int32: maximum + 1 = minimum");
        -- 2147483647 + 2147483647 = 4294967294, minus 4294967296 = -2
        assertTrue(modularAdd(max, max) = negTwo, "Int32: maximum + maximum = -2");
        -- -2147483648 + -1 = -2147483649, plus 4294967296 = 2147483647
        assertTrue(modularAdd(min, negOne) = max, "Int32: minimum + -1 = maximum");
        -- -2147483648 - 1 = -2147483649, plus 4294967296 = 2147483647
        assertTrue(modularSubtract(min, one) = max, "Int32: minimum - 1 = maximum");
        -- 2147483647 - -1 = 2147483648, minus 4294967296 = -2147483648
        assertTrue(modularSubtract(max, negOne) = min, "Int32: maximum - -1 = minimum");
        -- 2147483647 * 2 = 4294967294, minus 4294967296 = -2
        assertTrue(modularMultiply(max, two) = negTwo, "Int32: maximum * 2 = -2");
        -- -2147483648 * -1 = 2147483648, minus 4294967296 = -2147483648
        assertTrue(modularMultiply(min, negOne) = min, "Int32: minimum * -1 = minimum");
        -- -2147483648 * 2 = -4294967296, plus 4294967296 = 0
        assertTrue(modularMultiply(min, two) = zero, "Int32: minimum * 2 = 0");
        return nil;
    end;

    -- Int64, modulus 2^64, range -2^63 .. 2^63-1.
    function testInt64(): Unit is
        let max: Int64 := maximum_int64;
        let min: Int64 := minimum_int64;
        let one: Int64 := 1;
        let two: Int64 := 2;
        let negOne: Int64 := -1;
        let negTwo: Int64 := -2;
        let zero: Int64 := 0;
        -- (2^63 - 1) + 1 = 2^63, minus 2^64 = -2^63
        assertTrue(modularAdd(max, one) = min, "Int64: maximum + 1 = minimum");
        -- (2^63 - 1) + (2^63 - 1) = 2^64 - 2, minus 2^64 = -2
        assertTrue(modularAdd(max, max) = negTwo, "Int64: maximum + maximum = -2");
        -- -2^63 + -1 = -(2^63 + 1), plus 2^64 = 2^63 - 1
        assertTrue(modularAdd(min, negOne) = max, "Int64: minimum + -1 = maximum");
        -- -2^63 - 1 = -(2^63 + 1), plus 2^64 = 2^63 - 1
        assertTrue(modularSubtract(min, one) = max, "Int64: minimum - 1 = maximum");
        -- (2^63 - 1) - -1 = 2^63, minus 2^64 = -2^63
        assertTrue(modularSubtract(max, negOne) = min, "Int64: maximum - -1 = minimum");
        -- (2^63 - 1) * 2 = 2^64 - 2, minus 2^64 = -2
        assertTrue(modularMultiply(max, two) = negTwo, "Int64: maximum * 2 = -2");
        -- -2^63 * -1 = 2^63, minus 2^64 = -2^63
        assertTrue(modularMultiply(min, negOne) = min, "Int64: minimum * -1 = minimum");
        -- -2^63 * 2 = -2^64, plus 2^64 = 0
        assertTrue(modularMultiply(min, two) = zero, "Int64: minimum * 2 = 0");
        return nil;
    end;

    ---
    --- Division. The only quotient that leaves the range is
    --- minimum / -1: the mathematical result is 2^(w-1), which is one past
    --- the maximum and wraps to the minimum.
    ---

    -- signed modularDivide at minimum / -1.
    function testSignedDivide(): Unit is
        let min8: Int8 := minimum_int8;
        let negOne8: Int8 := -1;
        let min16: Int16 := minimum_int16;
        let negOne16: Int16 := -1;
        let min32: Int32 := minimum_int32;
        let negOne32: Int32 := -1;
        let min64: Int64 := minimum_int64;
        let negOne64: Int64 := -1;
        -- -128 / -1 = 128, and 128 - 256 = -128
        assertTrue(modularDivide(min8, negOne8) = min8, "Int8: -128 / -1 = -128");
        -- -32768 / -1 = 32768, and 32768 - 65536 = -32768
        assertTrue(modularDivide(min16, negOne16) = min16, "Int16: minimum / -1 = minimum");
        -- 2147483648 - 4294967296 = -2147483648
        assertTrue(modularDivide(min32, negOne32) = min32, "Int32: minimum / -1 = minimum");
        -- 2^63 - 2^64 = -2^63
        assertTrue(modularDivide(min64, negOne64) = min64, "Int64: minimum / -1 = minimum");
        return nil;
    end;

    ---
    --- Unsigned types. Modulus 2^w, range 0 .. 2^w-1. Unsigned arithmetic
    --- wraps by definition in C, so these cases are here as the control
    --- that the signed ones are compared against.
    ---

    -- unsigned wraparound.
    function testUnsigned(): Unit is
        let max8: Nat8 := maximum_nat8;
        let one8: Nat8 := 1;
        let zero8: Nat8 := 0;
        let max16: Nat16 := maximum_nat16;
        let one16: Nat16 := 1;
        let max32: Nat32 := maximum_nat32;
        let one32: Nat32 := 1;
        let zero32: Nat32 := 0;
        let max64: Nat64 := maximum_nat64;
        let one64: Nat64 := 1;
        -- 255 + 1 = 256, and 256 - 256 = 0
        assertTrue(modularAdd(max8, one8) = zero8, "Nat8: 255 + 1 = 0");
        -- 0 - 1 = -1, and -1 + 256 = 255
        assertTrue(modularSubtract(zero8, one8) = max8, "Nat8: 0 - 1 = 255");
        -- 65535 = -1 modulo 65536, so 65535 * 65535 = (-1) * (-1) = 1
        assertTrue(modularMultiply(max16, max16) = one16, "Nat16: 65535 * 65535 = 1");
        -- 4294967295 + 1 = 4294967296, and 4294967296 - 4294967296 = 0
        assertTrue(modularAdd(max32, one32) = zero32, "Nat32: maximum + 1 = 0");
        -- 2^64 - 1 = -1 modulo 2^64, so the square is 1
        assertTrue(modularMultiply(max64, max64) = one64, "Nat64: maximum * maximum = 1");
        return nil;
    end;
end module body.
