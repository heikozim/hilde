            return @embed(Int8, "($1 % $2)", lhs, rhs);
        end;
    end;

    instance Remainder(Int16) is
        method rem(lhs: Int16, rhs: Int16): Int16 is
            if rhs = 0 then
                abort("Division by zero in rem(Int16)");
            end if;
            if (lhs = minimum_int16) and (rhs = -1) then
                abort("Overflow in rem(Int16)");
