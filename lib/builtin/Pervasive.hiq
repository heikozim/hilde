    ---
    --- Printable
    ---

    instance Printable(Unit) is
        method print(value: Unit): Unit is
            return @embed(Unit, "hilde_printf(\"nil\")");
            return value;
        end;

        generic [R: Region]
        method printSpan(array: Span[Unit, R]): Unit is
            if @embed(Index, "$1.size", array) > 0 then
                for i from 0 to @embed(Index, "$1.size", array) - 1 do
                    print(array[i]);
                end for;
            end if;
            return nil;
        end;
    end;

    instance Printable(Bool) is
        method print(value: Bool): Unit is
            if value then
                @embed(Unit, "hilde_printf(\"true\")");
            else
                @embed(Unit, "hilde_printf(\"false\")");
            end if;
            return nil;
        end;

        generic [R: Region]
        method printSpan(array: Span[Bool, R]): Unit is
            if @embed(Index, "$1.size", array) > 0 then
                for i from 0 to @embed(Index, "$1.size", array) - 1 do
                    print(array[i]);
                end for;
            end if;
            return nil;
        end;
    end;

