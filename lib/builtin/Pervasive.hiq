    ---
    --- Modular Arithmetic
    ---
    --- Negation is its own operation, not a subtraction from zero. It has
    --- to mean the same thing at every width, and for a signed type there
    --- is exactly one value it cannot produce: the opposite of the minimum
    --- is one past the maximum. That value is refused before the negation
    --- runs, so the generated C never computes it. The guard compares
    --- against the minimum of the type itself, not against the int that C
    --- would promote a narrow operand to.
    ---
    --- Float64 has no such value: negation there is the sign flip of ieee
    --- 754, and -(0.0) is -0.0, which a subtraction from zero would not
    --- give.
    ---

    instance TrappingNegation(Int8) is
        method trappingNegate(value: Int8): Int8 is
            if value = minimum_int8 then
                onOverflow("Overflow in trappingNegate (Int8)");
            end if;
            return @embed(Int8, "-($1)", value);
        end;
    end;

    instance TrappingNegation(Int16) is
        method trappingNegate(value: Int16): Int16 is
            if value = minimum_int16 then
                onOverflow("Overflow in trappingNegate (Int16)");
            end if;
            return @embed(Int16, "-($1)", value);
        end;
    end;

    instance TrappingNegation(Int32) is
        method trappingNegate(value: Int32): Int32 is
            if value = minimum_int32 then
                onOverflow("Overflow in trappingNegate (Int32)");
            end if;
            return @embed(Int32, "-($1)", value);
        end;
    end;

    instance TrappingNegation(Int64) is
        method trappingNegate(value: Int64): Int64 is
            if value = minimum_int64 then
                onOverflow("Overflow in trappingNegate (Int64)");
            end if;
            return @embed(Int64, "-($1)", value);
        end;
    end;

    instance TrappingNegation(Float64) is
        method trappingNegate(value: Float64): Float64 is
            return @embed(Float64, "-($1)", value);
        end;
    end;

    instance TrappingNegation(Float32) is
        method trappingNegate(value: Float32): Float32 is
            return @embed(Float32, "-($1)", value);
        end;
    end;

    ---
    --- Modular arithmetic is arithmetic modulo 2^w, w the width of the
    --- type. In C only unsigned arithmetic has that meaning; signed
    --- overflow is undefined behaviour. These bodies do not leave that
    --- to a switch on the C compiler: every signed body below does the
    --- arithmetic in an unsigned
    --- type and converts the result back, which is the same value, because
    --- the low w bits of a sum, difference or product depend only on the
    --- low w bits of its operands.
    ---
    --- The unsigned type is the equally wide one for Int32 and Int64, and
    --- hilde_nat32_t for Int8 and Int16: a type narrower than int is
    --- promoted back to signed int before the operation, and a product of
    --- two 16 bit values does not fit there. That is not a hypothetical --
    --- it is how the Nat16 multiplication below was undefined.
    ---
    --- Division is the exception: unsigned division is a different
    --- operation, so those bodies keep the signed division and guard the
    --- one case that leaves the range, minimum / -1.
    ---

    instance ModularArithmetic(Nat8) is
        method modularAdd(lhs: Nat8, rhs: Nat8): Nat8 is
            return @embed(Nat8, "$1 + $2", lhs, rhs);
        end;

        method modularSubtract(lhs: Nat8, rhs: Nat8): Nat8 is
            return @embed(Nat8, "$1 - $2", lhs, rhs);
        end;

        method modularMultiply(lhs: Nat8, rhs: Nat8): Nat8 is
            return @embed(Nat8, "$1 * $2", lhs, rhs);
        end;

        method modularDivide(lhs: Nat8, rhs: Nat8): Nat8 is
            if rhs = 0 then
                abort("Division by zero in modularDivide (Nat8)");
            end if;
            return @embed(Nat8, "$1 / $2", lhs, rhs);
        end;
    end;

    instance ModularArithmetic(Int8) is
        method modularAdd(lhs: Int8, rhs: Int8): Int8 is
            return @embed(Int8, "(hilde_int8_t)((hilde_nat32_t)$1 + (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularSubtract(lhs: Int8, rhs: Int8): Int8 is
            return @embed(Int8, "(hilde_int8_t)((hilde_nat32_t)$1 - (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularMultiply(lhs: Int8, rhs: Int8): Int8 is
            return @embed(Int8, "(hilde_int8_t)((hilde_nat32_t)$1 * (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularDivide(lhs: Int8, rhs: Int8): Int8 is
            if rhs = 0 then
                abort("Division by zero in modularDivide (Int8)");
            end if;
            -- minimum_int8 / -1 is the one quotient outside the range: the
            -- mathematical result is one past the maximum, and modulo the
            -- width of the type that is the minimum again. In C the
            -- division itself would overflow, so the answer is returned
            -- rather than computed.
            if (lhs = minimum_int8) and (rhs = -1) then
                return minimum_int8;
            end if;
            return @embed(Int8, "$1 / $2", lhs, rhs);
        end;
    end;

    instance ModularArithmetic(Nat16) is
        method modularAdd(lhs: Nat16, rhs: Nat16): Nat16 is
            return @embed(Nat16, "$1 + $2", lhs, rhs);
        end;

        method modularSubtract(lhs: Nat16, rhs: Nat16): Nat16 is
            return @embed(Nat16, "$1 - $2", lhs, rhs);
        end;

        method modularMultiply(lhs: Nat16, rhs: Nat16): Nat16 is
            return @embed(Nat16, "(hilde_nat16_t)((hilde_nat32_t)$1 * (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularDivide(lhs: Nat16, rhs: Nat16): Nat16 is
            if rhs = 0 then
                abort("Division by zero in modularDivide (Nat16)");
            end if;
            return @embed(Nat16, "$1 / $2", lhs, rhs);
        end;
    end;

    instance ModularArithmetic(Int16) is
        method modularAdd(lhs: Int16, rhs: Int16): Int16 is
            return @embed(Int16, "(hilde_int16_t)((hilde_nat32_t)$1 + (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularSubtract(lhs: Int16, rhs: Int16): Int16 is
            return @embed(Int16, "(hilde_int16_t)((hilde_nat32_t)$1 - (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularMultiply(lhs: Int16, rhs: Int16): Int16 is
            return @embed(Int16, "(hilde_int16_t)((hilde_nat32_t)$1 * (hilde_nat32_t)$2)", lhs, rhs);
        end;

        method modularDivide(lhs: Int16, rhs: Int16): Int16 is
            if rhs = 0 then
                abort("Division by zero in modularDivide (Int16)");
            end if;
            -- minimum_int16 / -1 is the one quotient outside the range: the
            -- mathematical result is one past the maximum, and modulo the
            -- width of the type that is the minimum again. In C the
            -- division itself would overflow, so the answer is returned
            -- rather than computed.
            if (lhs = minimum_int16) and (rhs = -1) then
                return minimum_int16;
            end if;
            return @embed(Int16, "$1 / $2", lhs, rhs);
        end;
    end;

