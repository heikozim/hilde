            if (value <= @embed(Nat64, "SIZE_MAX")) then
                return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
            else
                return None();
            end if;
        end;
    end;

    instance ToIndex(Int8) is
        method toIndex(value: Int8): Option[Index] is
            if (value >= 0) then
                return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
            else
                return None();
            end if;
        end;
    end;

    instance ToIndex(Int16) is
        method toIndex(value: Int16): Option[Index] is
            if (value >= 0) then
                return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
            else
                return None();
            end if;
        end;
    end;

    instance ToIndex(Int32) is
        method toIndex(value: Int32): Option[Index] is
            let cast: Index := @embed(Index, "((hilde_index_t)($1))", value);
            if (value >= 0) and (cast <= @embed(Index, "SIZE_MAX")) then
                return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
            else
                return None();
            end if;
        end;
    end;

    instance ToIndex(Int64) is
        method toIndex(value: Int64): Option[Index] is
            -- The upper bound is tested by casting down and back rather
            -- than by embedding SIZE_MAX as an Int64: on every platform
            -- where size_t is as wide as int64_t, (hilde_int64_t)(SIZE_MAX)
            -- is -1, so the test that stood here read value <= -1 and
            -- this conversion could never return Some.  Measured
            -- 2026-09-22: toIndex of the Int64 19 was None, while toIndex
            -- of the Int32 19 -- whose instance tests the same thing the
            -- other way round -- was Some.
            --
            -- The round trip is exact where the value fits and is not where
            -- it does not, which is the question being asked, and it needs
            -- no platform constant at all.
            if value >= 0 then
                let narrowed: Index := @embed(Index, "((hilde_index_t)($1))", value);
                if @embed(Int64, "((hilde_int64_t)($1))", narrowed) = value then
                    return Some(value => narrowed);
                else
                    return None();
                end if;
            else
                return None();
            end if;
        end;
    end;

    instance ToIndex(Index) is
        method toIndex(value: Index): Option[Index] is
            return Some(value => value);
        end;
    end;

