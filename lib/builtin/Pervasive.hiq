    -- ToIndex

    instance ToIndex(Nat8) is
        method toIndex(value: Nat8): Option[Index] is
            return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
        end;
    end;

    instance ToIndex(Nat16) is
        method toIndex(value: Nat16): Option[Index] is
            -- No bound test.  The old one read value <= SIZE_MAX with
            -- SIZE_MAX embedded as a Nat16, so C truncated it to 65535 and
            -- compared a Nat16 against its own maximum: always true, and
            -- reported as such in every generated file.  It is always true
            -- for a reason, not by accident -- C requires SIZE_MAX to be at
            -- least 65535, so every Nat16 fits in an Index.
            return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
        end;
    end;

    instance ToIndex(Nat32) is
        method toIndex(value: Nat32): Option[Index] is
            if (value <= @embed(Nat32, "SIZE_MAX")) then
                return Some(value => @embed(Index, "((hilde_index_t)($1))", value));
            else
