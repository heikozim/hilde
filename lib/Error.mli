(** Error reporting infrastructure. *)
open Identifier
open Span
open SourceContext
open ErrorText

(** Represents a category of errors. *)
type error_kind =
  | GenericError
  (** A generic error. This should be gradually phased out. *)
  | ParseError
  (** A parse error. *)
  | CliError
  (** An error with the user's command line arguments. *)
  | TypeError
  (** A type error. *)
  | LinearityError
  (** Signalled when code breaks the linearity rules. *)
  | DeclarationError
  (** An error in the structure of a declaration. *)
  | EntrypointError
  (** An error with the definition of the program entrypoint. *)
  | InternalError
  (** An internal error in the compiler. *)

(** A stable code per raise site, `H' and four digits.  The code
    is a literal where the error is raised; `docs/error-codes.md' lists
    every one, generated by `scripts/error-codes.py'.  An internal error
    has H9999. *)
type error_code = H of int

(** The code as it is printed: `H' and four digits. *)
val code_string : error_code -> string

(** A Hilde compiler error. The module name, span, and source context rarely
    have to be passed in explicitly: they are added where the error is throw in
    the context of {!adorn_error_with_span}. *)
type hilde_error = HildeError of {
      module_name: module_name option;
      (** The name of the module where the error occurred, if available. *)
      code: error_code;
      (** The stable code of the place that raised the error. *)
      kind: error_kind;
      (** The error kind. *)
      text: err_text;
      (** The error text. *)
      span: span option;
      (** The source span where the error happened, if available. *)
      source_ctx: source_ctx option;
      (** The source code where the error happened, if available. *)
    }

(** The exception that carries the compiler's errors. *)
exception Hilde_error of hilde_error

(** Raise a compiler error given the kind and text. *)
val hilde_raise : error_code -> error_kind -> err_text -> 'a

(** Add a source context to an error if it doesn't have one. *)
val add_source_ctx : hilde_error -> source_ctx -> hilde_error

(** Run the callback, and if it throws an error that doesn't have a module name,
    put the given module name in the error and rethrow it. *)
val adorn_error_with_module_name : module_name -> (unit -> 'a) -> 'a

(** Run the callback, and if it throws an error that doesn't have a span, put
    the given span in the error and rethrow it. *)
val adorn_error_with_span : span -> (unit -> 'a) -> 'a

(** Render an error kind to a title. *)
val error_title : error_kind -> string

(** Render an error to plain text, for display to the terminal. *)
val render_error_to_plain : hilde_error -> string

(** Render an error to JSON, for tools or the end to end tests. *)
val render_error_to_json : hilde_error -> Yojson.Basic.t

(** Render an error as one line of JSON for --error-format=json-lines:
    code, kind, module, file, line, column, end_line, end_column, message
    and hint, the place flat and the text plain. *)
val render_error_to_json_line : hilde_error -> string

(** Render an error as rustc renders a diagnostic for --error-format=json:
    one line of JSON with message, code, level, spans and children, a
    suggested fix as a child of level help.  The function gives the source
    of a file by its name, for byte offsets and the text of the line; a
    file it does not know has offsets 0 and no text. *)
val render_error_to_rustc : (string -> string option) -> hilde_error -> string

(** A span as the JSON error has it -- `filename', `startp', `end' -- for
    anything else that reports a place (`hilde query'). *)
val span_json : span -> Yojson.Basic.t

(** Utility: raise a generic error. *)
val err : error_code -> string -> 'a

(** Utility: raise an internal error. *)
val internal_err : string -> 'a

(** Utility: raise an internal error whose message names code or types. *)
val internal_raise : err_text -> 'a
