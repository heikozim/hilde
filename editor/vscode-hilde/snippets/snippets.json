{
  "Module interface": {
    "scope": "hilde",
    "prefix": "module",
    "body": [
      "module $1 is",
      "\t$2",
      "end module."
    ],
    "description": "Empty module interface declaration"
  },
  "Module body": {
    "scope": "hilde",
    "prefix": "module body",
    "body": [
      "module body $1 is",
      "\t$2",
      "end module body."
    ],
    "description": "Empty module body declaration"
  },
  "Main module body": {
    "scope": "hilde",
    "prefix": "module body",
    "body": [
      "module body $1 is",
      "\tfunction main(): ExitCode is",
      "\t\t$2",
      "\t\treturn ExitSuccess();",
      "\tend;",
      "end module body."
    ],
    "description": "Module body declaration with main function"
  },
  "Generic function body": {
    "scope": "hilde",
    "prefix": "generic",
    "body": [
      "generic [R: Region]",
      "function $1($2): $3 is",
      "\t$4",
      "end;"
    ],
    "description": "Empty generic function declaration."
  },
  "Function body": {
    "scope": "hilde",
    "prefix": "function",
    "body": [
      "function $1($2): $3 is",
      "\t$4",
      "end;"
    ],
    "description": "Empty function declaration."
  },
  "C FFI function pattern": {
    "scope": "hilde",
    "prefix": "function C_",
    "body": [
      "function C_$1($2): $3 is",
      "\tpragma Foreign_Import(External_Name => \"$1\");",
      "end;"
    ],
    "description": "A C FFI function declaration"
  },
  "Case statement": {
    "scope": "hilde",
    "prefix": "case",
    "body": [
      "case $1 of",
      "\twhen $2 do",
      "\t\t$3",
      "end case;"
    ],
    "description": "Case statement"
  },
  "Case with patterns": {
    "scope": "hilde",
    "prefix": "case when",
    "body": [
      "case $1 of",
      "\twhen $2 | $3 do",
      "\t\t$4",
      "\twhen _ do",
      "\t\t$5",
      "end case;"
    ],
    "description": "Case statement with patterns and a wildcard"
  },
  "Function with contract": {
    "scope": "hilde",
    "prefix": "function requires",
    "body": [
      "function $1($2): $3",
      "\trequires $4",
      "\tensures $5",
      "is",
      "\t$6",
      "end;"
    ],
    "description": "Function with requires and ensures clauses"
  },
  "Record with invariant": {
    "scope": "hilde",
    "prefix": "record",
    "body": [
      "record $1: ${2|Free,Linear|} is",
      "\t$3: $4;",
      "\tinvariant $5;",
      "end;"
    ],
    "description": "Record with a slot and an invariant"
  },
  "Union": {
    "scope": "hilde",
    "prefix": "union",
    "body": [
      "union $1: ${2|Free,Linear|} is",
      "\tcase $3;",
      "\tcase $4 is",
      "\t\t$5: $6;",
      "end;"
    ],
    "description": "Union with two cases"
  }
}
