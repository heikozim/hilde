{
  "name": "hilde",
  "displayName": "hilde",
  "description": "Hilde language support for VS Code",
  "version": "1.1.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/heikozim/hilde",
    "directory": "editor/vscode-hilde"
  },
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "contributes": {
    "languages": [
      {
        "id": "hilde",
        "aliases": [
          "Hilde",
          "hilde"
        ],
        "extensions": [
          ".hiq",
          ".hih"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hilde",
        "scopeName": "source.hilde",
        "path": "./syntaxes/hilde.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "hilde",
        "path": "./snippets/snippets.json"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.2.5",
    "@vscode/vsce": "^2.23.0",
    "ts-node": "^10.9.1"
  },
  "scripts": {
    "build": "vsce package",
    "syntax": "ts-node src/generate-syntaxes.ts"
  }
}
