{
    "name": "Hilde",
    "scopeName": "source.hilde",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#docstring"
        },
        {
            "include": "#string"
        },
        {
            "include": "#character"
        },
        {
            "include": "#module"
        },
        {
            "include": "#declaration"
        },
        {
            "include": "#directive"
        },
        {
            "include": "#keyword"
        },
        {
            "include": "#universe"
        },
        {
            "include": "#constant"
        },
        {
            "include": "#number"
        },
        {
            "include": "#operator"
        },
        {
            "include": "#call"
        },
        {
            "include": "#named_argument"
        },
        {
            "include": "#type"
        },
        {
            "include": "#punctuation"
        }
    ],
    "repository": {
        "comment": {
            "match": "(--).*$",
            "name": "comment.line.double-dash.hilde",
            "captures": {
                "1": {
                    "name": "punctuation.definition.comment.hilde"
                }
            }
        },
        "docstring": {
            "name": "string.quoted.triple.hilde",
            "begin": "\"\"\"",
            "end": "\"\"\"",
            "patterns": [
                {
                    "name": "constant.character.escape.hilde",
                    "match": "\\\\\"\"\""
                }
            ]
        },
        "string": {
            "name": "string.quoted.double.hilde",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.hilde",
                    "match": "\\\\."
                }
            ]
        },
        "character": {
            "name": "string.quoted.single.hilde",
            "match": "'(?:[ -\\[\\]-~]|\\\\[nrt\\\\])'"
        },
        "module": {
            "patterns": [
                {
                    "match": "\\b(module)(?:\\s+(body))?\\s+([a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)*)\\s+(is)\\b",
                    "captures": {
                        "1": {
                            "name": "keyword.other.module.hilde"
                        },
                        "2": {
                            "name": "keyword.other.module.hilde"
                        },
                        "3": {
                            "name": "entity.name.namespace.hilde"
                        },
                        "4": {
                            "name": "keyword.other.is.hilde"
                        }
                    }
                },
                {
                    "match": "\\b(end)\\s+(module)(?:\\s+(body))?\\s*(\\.)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.end.hilde"
                        },
                        "2": {
                            "name": "keyword.other.module.hilde"
                        },
                        "3": {
                            "name": "keyword.other.module.hilde"
                        },
                        "4": {
                            "name": "punctuation.terminator.module.hilde"
                        }
                    }
                },
                {
                    "match": "\\b(import)\\s+([a-zA-Z][a-zA-Z0-9_]*(?:\\.[a-zA-Z][a-zA-Z0-9_]*)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.import.hilde"
                        },
                        "2": {
                            "name": "entity.name.namespace.hilde"
                        }
                    }
                }
            ]
        },
        "declaration": {
            "patterns": [
                {
                    "match": "\\b(function|method)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.function.hilde"
                        },
                        "2": {
                            "name": "entity.name.function.hilde"
                        }
                    }
                },
                {
                    "match": "\\b(record|union|typeclass|type|instance)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.$1.hilde"
                        },
                        "2": {
                            "name": "entity.name.type.hilde"
                        }
                    }
                },
                {
                    "match": "\\b(constant)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "storage.type.constant.hilde"
                        },
                        "2": {
                            "name": "variable.other.constant.hilde"
                        }
                    }
                },
                {
                    "match": "\\b(pragma)\\s+([a-zA-Z][a-zA-Z0-9_]*)",
                    "captures": {
                        "1": {
                            "name": "keyword.other.pragma.hilde"
                        },
                        "2": {
                            "name": "entity.name.function.preprocessor.hilde"
                        }
                    }
                },
                {
                    "match": "\\b(raises?)\\s+([a-zA-Z][a-zA-Z0-9_]*(?:\\s*,\\s*[a-zA-Z][a-zA-Z0-9_]*)*)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.raise.hilde"
                        },
                        "2": {
                            "name": "entity.name.type.error.hilde"
                        }
                    }
                }
            ]
        },
        "directive": {
            "match": "@(?:embed|bytes|template|query|execute|migrations)\\b",
            "name": "keyword.other.directive.hilde"
        },
        "keyword": {
            "patterns": [
                {
                    "match": "\\bend\\s+(?:if|case|while|for|borrow)\\b",
                    "name": "keyword.control.end.hilde"
                },
                {
                    "match": "\\belse[ \\t]+if\\b",
                    "name": "keyword.control.conditional.hilde"
                },
                {
                    "match": "\\b(?:if|then|else|case|of|when)\\b",
                    "name": "keyword.control.conditional.hilde"
                },
                {
                    "match": "\\b(?:while|for|from|to|do)\\b",
                    "name": "keyword.control.loop.hilde"
                },
                {
                    "match": "\\b(?:return|skip|raise)\\b",
                    "name": "keyword.control.flow.hilde"
                },
                {
                    "match": "\\b(?:requires|ensures|invariant|raises)\\b",
                    "name": "keyword.other.contract.hilde"
                },
                {
                    "match": "\\b(?:let|var|constant|function|method|generic|record|union|type|typeclass|instance)\\b",
                    "name": "storage.type.hilde"
                },
                {
                    "match": "\\b(?:module|body|is|end|import|as|borrow|pragma|sizeof)\\b",
                    "name": "keyword.other.hilde"
                },
                {
                    "match": "\\b(?:and|or|not)\\b",
                    "name": "keyword.operator.logical.hilde"
                }
            ]
        },
        "universe": {
            "match": "\\b(?:Free|Linear|Type|Region)\\b|\\bSpan\\b!?",
            "name": "support.type.builtin.hilde"
        },
        "constant": {
            "patterns": [
                {
                    "match": "\\b(?:true|false)\\b",
                    "name": "constant.language.boolean.hilde"
                },
                {
                    "match": "\\bnil\\b",
                    "name": "constant.language.nil.hilde"
                }
            ]
        },
        "number": {
            "patterns": [
                {
                    "match": "#x[0-9a-fA-F][0-9a-fA-F']*",
                    "name": "constant.numeric.integer.hexadecimal.hilde"
                },
                {
                    "match": "#o[0-7][0-7']*",
                    "name": "constant.numeric.integer.octal.hilde"
                },
                {
                    "match": "#b[01][01']*",
                    "name": "constant.numeric.integer.binary.hilde"
                },
                {
                    "match": "(?<![a-zA-Z0-9_])[0-9][0-9']*\\.[0-9][0-9']*(?:[eE][+-]?[0-9][0-9']*)?",
                    "name": "constant.numeric.float.hilde"
                },
                {
                    "match": "(?<![a-zA-Z0-9_])[0-9][0-9']*",
                    "name": "constant.numeric.integer.decimal.hilde"
                }
            ]
        },
        "operator": {
            "patterns": [
                {
                    "match": ":=",
                    "name": "keyword.operator.assignment.hilde"
                },
                {
                    "match": "=>",
                    "name": "keyword.operator.arrow.hilde"
                },
                {
                    "match": "->",
                    "name": "keyword.operator.pointer.hilde"
                },
                {
                    "match": "&!\\(|&\\(|&!|&~|&",
                    "name": "keyword.operator.borrow.hilde"
                },
                {
                    "match": "/=|<=|>=|=|<|>",
                    "name": "keyword.operator.comparison.hilde"
                },
                {
                    "match": "\\+|-|\\*|/",
                    "name": "keyword.operator.arithmetic.hilde"
                },
                {
                    "match": "\\.\\.",
                    "name": "keyword.operator.range.hilde"
                },
                {
                    "match": "\\|",
                    "name": "keyword.operator.alternative.hilde"
                },
                {
                    "match": "\\?",
                    "name": "keyword.operator.propagate.hilde"
                },
                {
                    "match": "!",
                    "name": "keyword.operator.dereference.hilde"
                }
            ]
        },
        "call": {
            "match": "\\b([a-z][a-zA-Z0-9_]*)\\s*(?=\\()",
            "captures": {
                "1": {
                    "name": "entity.name.function.call.hilde"
                }
            }
        },
        "named_argument": {
            "match": "\\b([a-zA-Z][a-zA-Z0-9_]*)\\s*(?==>)",
            "captures": {
                "1": {
                    "name": "variable.parameter.hilde"
                }
            }
        },
        "type": {
            "match": "\\b[A-Z][a-zA-Z0-9_]*\\b",
            "name": "entity.name.type.hilde"
        },
        "punctuation": {
            "patterns": [
                {
                    "match": ";",
                    "name": "punctuation.terminator.statement.hilde"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.hilde"
                },
                {
                    "match": ":",
                    "name": "punctuation.separator.colon.hilde"
                },
                {
                    "match": "\\.",
                    "name": "punctuation.accessor.hilde"
                },
                {
                    "match": "_",
                    "name": "variable.language.wildcard.hilde"
                }
            ]
        }
    }
}
