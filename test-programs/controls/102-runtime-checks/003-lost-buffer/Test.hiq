pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    store
);

module body Test is
    -- Allocates a buffer, writes into it and loses it: the only pointer to
    -- it ends with this function.
    function loseBuffer(): Unit is
        let address: Address[Int64] := allocateBuffer(8);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int64]) do
                let one: Int64 := 1;
                store(buffer, one);
            when None do
                abort("no memory");
        end case;
        return nil;
    end;

    -- A negative control of the runtime checks: a buffer that is never
    -- freed.  The leak check of AddressSanitizer and valgrind's must each
    -- fail it.
    function main(): ExitCode is
        loseBuffer();
        printLn("lost");
        return ExitSuccess();
    end;
end module body.
