pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    load,
    store,
    positiveOffset,
    deallocate
);

module body Test is
    -- The clean control of the runtime checks: a buffer of four is filled,
    -- read inside its bounds and freed.  It passes with every instrument and
    -- without one.
    function main(): ExitCode is
        let address: Address[Int32] := allocateBuffer(4);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int32]) do
                var i: Index := 0;
                while i < 4 do
                    let seven: Int32 := 7;
                    store(positiveOffset(buffer, i), seven);
                    i := i + 1;
                end while;
                printLn(load(positiveOffset(buffer, 3)));
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return ExitSuccess();
    end;
end module body.
