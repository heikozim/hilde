pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    store,
    wipe,
    deallocate
);

module body Test is
    -- A negative control of the runtime checks: a buffer given back twice.
    -- AddressSanitizer, valgrind and the checks of OpenBSD's malloc must
    -- each fail it.  A plain build may run it to the end, so it prints 0
    -- before the second free and nothing after it.  The buffer is wiped
    -- before it is given back: the wipe calls a function the C compiler
    -- cannot see into, so clang at -O1 keeps the allocation and both frees,
    -- which it removes when the buffer never leaves the function.
    function main(): ExitCode is
        let address: Address[Nat8] := allocateBuffer(16);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Nat8]) do
                let zero: Nat8 := 0;
                let bytes: ByteSize := 16;
                store(buffer, zero);
                printLn(zero);
                wipe(buffer, bytes);
                deallocate(buffer);
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return ExitSuccess();
    end;
end module body.
