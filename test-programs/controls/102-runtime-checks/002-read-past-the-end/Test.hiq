pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    load,
    store,
    positiveOffset,
    deallocate
);

module body Test is
    -- A negative control of the runtime checks: a read one element past the
    -- end of a buffer of four.  AddressSanitizer and valgrind must each fail
    -- it.  The value read decides a branch, so that the read is not dropped,
    -- and both branches print a line nobody compares against the value.
    function main(): ExitCode is
        let address: Address[Int32] := allocateBuffer(4);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int32]) do
                var i: Index := 0;
                while i < 4 do
                    let seven: Int32 := 7;
                    store(positiveOffset(buffer, i), seven);
                    i := i + 1;
                end while;
                let past: Int32 := load(positiveOffset(buffer, 4));
                if past = 123456789 then
                    printLn("read a value nobody wrote");
                else
                    printLn("read");
                end if;
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return ExitSuccess();
    end;
end module body.
