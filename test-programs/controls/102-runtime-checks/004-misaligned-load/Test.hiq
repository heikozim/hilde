pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    load,
    store,
    positiveOffset,
    pointerCast,
    deallocate
);

module body Test is
    -- A negative control of the runtime checks: an Int32 loaded from an odd
    -- address, which the C standard leaves undefined.  UndefinedBehaviorSanitizer
    -- must fail it.  The machines of the gates load such a value without a
    -- fault, so without an instrument it prints 0.
    function main(): ExitCode is
        let address: Address[Nat8] := allocateBuffer(16);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Nat8]) do
                var i: Index := 0;
                while i < 16 do
                    let zero: Nat8 := 0;
                    store(positiveOffset(buffer, i), zero);
                    i := i + 1;
                end while;
                let odd: Pointer[Int32] := pointerCast(positiveOffset(buffer, 1));
                printLn(load(odd));
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return ExitSuccess();
    end;
end module body.
