"""
The fake ACME server of scripts/acme/fake-ca.py for the tests of suite
083-acme: started as a child process that prints its port, and an account
opened at it with a fresh P-256 key.  The server ends when its input
closes, so a test that stops on a contract leaves no server behind.
"""
import Standard.Acme (
    Account
);

module AcmeFake is
    """
    A running server and the pipes to it.  Linear: stopFake ends it.
    """
    type Fake: Linear;

    """
    Starts the server; None when it could not be started or printed no
    port.
    """
    function startFake(): Option[Fake];

    """
    An account at the server, with a new P-256 key and no contact; None
    when the server refused it.
    """
    generic [R: Region]
    function openFakeAccount(fake: &[Fake, R]): Option[Account];

    """
    Closes the input of the server, reads what it wrote and waits for it.
    """
    function stopFake(fake: Fake): Unit;
end module.
