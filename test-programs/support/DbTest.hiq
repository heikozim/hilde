import Standard.String (
    String,
    destroyString,
    fromLiteral,
    asSpan,
    length
);
import Standard.File (
    environmentValue
);
import Standard.Database (
    Database,
    Writing,
    Reading,
    DbError
);
import Standard.Database.Postgres (
    openPostgres,
    openPostgresReader
);
import Standard.Database.MariaDB (
    openMariaDB,
    openMariaDBReader
);

module body DbTest is
    function setting(name: Span[Nat8, Static]): String is
        case environmentValue(name) of
            when Some(value as text: String) do
                return text;
            when None do
                print(name);
                printLn(" is not set: the test runs only with the server of server.txt");
                abort("DbTest: no server");
        end case;
    end;

    generic [R: Region]
    function nthByte(text: &[String, R], i: Index): Nat8 is
        let bytes: Span[Nat8, R] := asSpan(text);
        return bytes[i];
    end;

    function port(name: Span[Nat8, Static]): Nat16 is
        let text: String := setting(name);
        var total: Nat64 := 0;
        var good: Bool := (length(&text) > 0) and (length(&text) <= 5);
        var i: Index := 0;
        while good and (i < length(&text)) do
            let b: Nat8 := nthByte(&text, i);
            if (b < '0') or (b > '9') then
                good := false;
            else
                case toNat64(b - '0') of
                    when Some(value as d: Nat64) do
                        total := (total * 10) + d;
                    when None do
                        good := false;
                end case;
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        if not good then
            abort("DbTest: the port is not a number");
        end if;
        case toNat16(total) of
            when Some(value as number: Nat16) do
                if number = 0 then
                    abort("DbTest: the port is 0");
                end if;
                return number;
            when None do
                abort("DbTest: the port is past 65535");
        end case;
    end;

    function releaseAll(a: String, b: String, c: String, d: String, e: String): Unit is
        destroyString(a);
        destroyString(b);
        destroyString(c);
        destroyString(d);
        destroyString(e);
        return nil;
    end;

    function openTestPostgres(): Either[DbError, Database[Writing]] is
        let host: String := setting("HILDE_PG_HOST");
        let database: String := setting("HILDE_PG_DATABASE");
        let user: String := setting("HILDE_PG_USER");
        let secret: String := setting("HILDE_PG_PASSWORD");
        let ca: String := setting("HILDE_PG_CA");
        let number: Nat16 := port("HILDE_PG_PORT");
        let result: Either[DbError, Database[Writing]] := openPostgres(asSpan(&host), number, asSpan(&database), asSpan(&user), asSpan(&secret), asSpan(&ca));
        releaseAll(host, database, user, secret, ca);
        return result;
    end;

    function openTestPostgresReader(): Either[DbError, Database[Reading]] is
        let host: String := setting("HILDE_PG_HOST");
        let database: String := setting("HILDE_PG_DATABASE");
        let user: String := setting("HILDE_PG_USER");
        let secret: String := setting("HILDE_PG_PASSWORD");
        let ca: String := setting("HILDE_PG_CA");
        let number: Nat16 := port("HILDE_PG_PORT");
        let result: Either[DbError, Database[Reading]] := openPostgresReader(asSpan(&host), number, asSpan(&database), asSpan(&user), asSpan(&secret), asSpan(&ca));
        releaseAll(host, database, user, secret, ca);
        return result;
    end;

    function openTestMariaDB(): Either[DbError, Database[Writing]] is
        let host: String := setting("HILDE_MARIA_HOST");
        let database: String := setting("HILDE_MARIA_DATABASE");
        let user: String := setting("HILDE_MARIA_USER");
        let secret: String := setting("HILDE_MARIA_PASSWORD");
        let ca: String := setting("HILDE_MARIA_CA");
        let number: Nat16 := port("HILDE_MARIA_PORT");
        let result: Either[DbError, Database[Writing]] := openMariaDB(asSpan(&host), number, asSpan(&database), asSpan(&user), asSpan(&secret), asSpan(&ca));
        releaseAll(host, database, user, secret, ca);
        return result;
    end;

    function openTestMariaDBReader(): Either[DbError, Database[Reading]] is
        let host: String := setting("HILDE_MARIA_HOST");
        let database: String := setting("HILDE_MARIA_DATABASE");
        let user: String := setting("HILDE_MARIA_USER");
        let secret: String := setting("HILDE_MARIA_PASSWORD");
        let ca: String := setting("HILDE_MARIA_CA");
        let number: Nat16 := port("HILDE_MARIA_PORT");
        let result: Either[DbError, Database[Reading]] := openMariaDBReader(asSpan(&host), number, asSpan(&database), asSpan(&user), asSpan(&secret), asSpan(&ca));
        releaseAll(host, database, user, secret, ca);
        return result;
    end;
end module body.
