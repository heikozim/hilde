"""
Connections to the server test-programs/runner.py starts for a test of
suite 090-mariadb that carries server.txt.  The server's host, port,
database, user, password and CA file come from the environment variables
that scripts/db/server.sh prints.  A variable that is missing stops the
programme with a message: the test was run without its server.
"""
import Standard.MariaDB (
    Connection,
    Writing,
    Reading,
    MariaError
);

module MariaTest is
    """
    A writing connection with the right password and the right CA.
    """
    function openTest(): Either[MariaError, Connection[Writing]];

    """
    A reading connection with the right password and the right CA.
    """
    function openTestReader(): Either[MariaError, Connection[Reading]];

    """
    A writing connection with the password given instead of the server's.
    """
    function openWithPassword(password: Span[Nat8, Static]): Either[MariaError, Connection[Writing]]
        requires spanLength(password) > 0;

    """
    A writing connection that trusts the second CA of the run, which did
    not sign the server's certificate.
    """
    function openWithOtherCa(): Either[MariaError, Connection[Writing]];
end module.
