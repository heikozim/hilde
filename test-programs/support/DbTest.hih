"""
Standard.Database on the PostgreSQL or MariaDB server
test-programs/runner.py starts for a test that carries server.txt, with the settings scripts/db/server.sh
prints into the environment.  A setting that is missing stops the
programme with a message.
"""
import Standard.Database (
    Database,
    Writing,
    Reading,
    DbError
);

module DbTest is
    function openTestPostgres(): Either[DbError, Database[Writing]];
    function openTestPostgresReader(): Either[DbError, Database[Reading]];
    function openTestMariaDB(): Either[DbError, Database[Writing]];
    function openTestMariaDBReader(): Either[DbError, Database[Reading]];
end module.
