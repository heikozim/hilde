import Standard.String (
    String,
    destroyString,
    fromLiteral,
    asSpan,
    length
);
import Standard.File (
    environmentValue
);
import Standard.MariaDB (
    Connection,
    Writing,
    Reading,
    MariaError,
    openWriter,
    openReader
);

module body MariaTest is
    -- The value of the variable, which must be set.
    function setting(name: Span[Nat8, Static]): String is
        case environmentValue(name) of
            when Some(value as text: String) do
                return text;
            when None do
                print(name);
                printLn(" is not set: the test runs only with the server of server.txt");
                abort("MariaTest: no server");
        end case;
    end;

    -- The port, decimal digits that must make a number from 1 to 65535.
    function port(): Nat16 is
        let text: String := setting("HILDE_MARIA_PORT");
        var total: Nat64 := 0;
        var good: Bool := (length(&text) > 0) and (length(&text) <= 5);
        var i: Index := 0;
        while good and (i < length(&text)) do
            let b: Nat8 := nthDigit(&text, i);
            if (b < '0') or (b > '9') then
                good := false;
            else
                total := (total * 10) + digitValue(b);
            end if;
            i := i + 1;
        end while;
        destroyString(text);
        if not good then
            abort("MariaTest: HILDE_MARIA_PORT is not a number");
        end if;
        case toNat16(total) of
            when Some(value as number: Nat16) do
                if number = 0 then
                    abort("MariaTest: HILDE_MARIA_PORT is 0");
                end if;
                return number;
            when None do
                abort("MariaTest: HILDE_MARIA_PORT is past 65535");
        end case;
    end;

    generic [R: Region]
    function nthDigit(text: &[String, R], i: Index): Nat8 is
        let bytes: Span[Nat8, R] := asSpan(text);
        return bytes[i];
    end;

    function digitValue(b: Nat8): Nat64 is
        case toNat64(b - '0') of
            when Some(value as d: Nat64) do
                return d;
            when None do
                return 0;
        end case;
    end;

    -- Open with the password given, or the server's when it is None, and
    -- the CA file of the variable caVariable.
    function openWith(password: Option[Span[Nat8, Static]], caVariable: Span[Nat8, Static]): Either[MariaError, Connection[Writing]] is
        let host: String := setting("HILDE_MARIA_HOST");
        let database: String := setting("HILDE_MARIA_DATABASE");
        let user: String := setting("HILDE_MARIA_USER");
        let secret: String := setting("HILDE_MARIA_PASSWORD");
        let ca: String := setting(caVariable);
        let number: Nat16 := port();
        case password of
            when Some(value as given: Span[Nat8, Static]) do
                let result: Either[MariaError, Connection[Writing]] := openWriter(asSpan(&host), number, asSpan(&database), asSpan(&user), given, asSpan(&ca));
                releaseAll(host, database, user, secret, ca);
                return result;
            when None do
                let result: Either[MariaError, Connection[Writing]] := openWriter(asSpan(&host), number, asSpan(&database), asSpan(&user), asSpan(&secret), asSpan(&ca));
                releaseAll(host, database, user, secret, ca);
                return result;
        end case;
    end;

    function releaseAll(a: String, b: String, c: String, d: String, e: String): Unit is
        destroyString(a);
        destroyString(b);
        destroyString(c);
        destroyString(d);
        destroyString(e);
        return nil;
    end;

    function openTest(): Either[MariaError, Connection[Writing]] is
        let none: Option[Span[Nat8, Static]] := None();
        return openWith(none, "HILDE_MARIA_CA");
    end;

    function openTestReader(): Either[MariaError, Connection[Reading]] is
        let host: String := setting("HILDE_MARIA_HOST");
        let database: String := setting("HILDE_MARIA_DATABASE");
        let user: String := setting("HILDE_MARIA_USER");
        let secret: String := setting("HILDE_MARIA_PASSWORD");
        let ca: String := setting("HILDE_MARIA_CA");
        let number: Nat16 := port();
        let result: Either[MariaError, Connection[Reading]] := openReader(asSpan(&host), number, asSpan(&database), asSpan(&user), asSpan(&secret), asSpan(&ca));
        releaseAll(host, database, user, secret, ca);
        return result;
    end;

    function openWithPassword(password: Span[Nat8, Static]): Either[MariaError, Connection[Writing]] is
        return openWith(Some(value => password), "HILDE_MARIA_CA");
    end;

    function openWithOtherCa(): Either[MariaError, Connection[Writing]] is
        let none: Option[Span[Nat8, Static]] := None();
        return openWith(none, "HILDE_MARIA_OTHER_CA");
    end;
end module body.
