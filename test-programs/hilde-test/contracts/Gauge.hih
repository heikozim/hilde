"""
Functions whose bodies keep their contracts, the module hilde test
--contracts tests.  scale takes a Float64, which is not drawn, so it is
passed by with its reason.
"""
module Example.Gauge is
    function clamp(value: Int32, low: Int32, high: Int32): Int32
        requires low <= high
        ensures (low <= result) and (result <= high);

    function half(n: Nat32): Nat32
        ensures (result * 2) <= n;

    function either(a: Bool, b: Bool): Bool
        ensures result = (a /= b);

    function scale(value: Float64): Float64
        ensures result = value;
end module.
