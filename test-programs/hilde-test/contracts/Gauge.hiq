module body Example.Gauge is
    function clamp(value: Int32, low: Int32, high: Int32): Int32 is
        if value < low then
            return low;
        end if;
        if value > high then
            return high;
        end if;
        return value;
    end;

    function half(n: Nat32): Nat32 is
        return n / 2;
    end;

    function either(a: Bool, b: Bool): Bool is
        return a /= b;
    end;

    function scale(value: Float64): Float64 is
        return value;
    end;
end module body.
