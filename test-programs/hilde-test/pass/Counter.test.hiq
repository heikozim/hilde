"""
The positive control of hilde test: two tests that pass, one of each form.
"""
import Example.Counter (Counter, make, next, finish);

module body Example.Counter.Test is
    function testTwoSteps(): Unit is
        let counter: Counter := next(next(make()));
        if finish(counter) /= 2 then
            abort("two steps did not give 2");
        end if;
        return nil;
    end;

    generic [R: Region]
    function testWithTheRoot(root: &![RootCapability, R]): Unit is
        let counter: Counter := make();
        if finish(counter) /= 0 then
            abort("a new counter is not 0");
        end if;
        return nil;
    end;

    function helperIsNoTest(): Nat32 is
        return 1;
    end;
end module body.
