"""
The negative control of the leak checks of hilde test --memory and
--valgrind: a test that allocates a buffer and never frees it.  Without an
instrument the loss goes unseen and the test passes; with either of the two
it fails.  The second test frees what it allocates and passes under every
instrument.
"""
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    store,
    deallocate
);

module body Leak.Test is
    function testLosesItsBuffer(): Unit is
        let address: Address[Int64] := allocateBuffer(8);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int64]) do
                let one: Int64 := 1;
                store(buffer, one);
            when None do
                abort("no memory");
        end case;
        return nil;
    end;

    function testFreesItsBuffer(): Unit is
        let address: Address[Int64] := allocateBuffer(8);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int64]) do
                let one: Int64 := 1;
                store(buffer, one);
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return nil;
    end;
end module body.
