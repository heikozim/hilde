"""
The control of hilde test --fresh-dirs: both tests make the file marker.txt
in the working directory and fail when it was there already.  In one
working directory the second test finds the file of the first and fails; with
a directory of its own for each test both pass, also when they run at once.
"""
import Standard.File (
    FileDescriptor,
    openRead,
    openWrite,
    closeFile
);

module body Fresh.Test is
    function claimMarker(): Unit is
        case openRead("marker.txt") of
            when Some(value as old: FileDescriptor) do
                let closedOld: Bool := closeFile(old);
                abort("marker.txt was there before this test");
            when None do
                skip;
        end case;
        case openWrite("marker.txt") of
            when Some(value as made: FileDescriptor) do
                let closedMade: Bool := closeFile(made);
            when None do
                abort("marker.txt could not be made");
        end case;
        return nil;
    end;

    function testFirst(): Unit is
        claimMarker();
        return nil;
    end;

    function testSecond(): Unit is
        claimMarker();
        return nil;
    end;
end module body.
