"""
The negative control of hilde test --cppcheck: a function that no test
calls divides by a literal zero in its C, which cppcheck reports.  Without
the flag nothing runs the division and the one test passes; with it the
file fails by the cppcheck test beside it.
"""
pragma Unsafe_Module;

module body Cppcheck.Test is
    function divideByZero(): Int32 is
        return @embed(Int32, "(int32_t)(1 / 0)");
    end;

    function testNothing(): Unit is
        return nil;
    end;
end module body.
