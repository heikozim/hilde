"""
The negative control of hilde test --memory and --valgrind: a read one
element past the end of a buffer of four.  Without an instrument the read
goes unseen and the test passes; with either of the two it fails.  The
second test reads inside the buffer and passes under every instrument.
"""
pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck,
    allocateBuffer,
    load,
    store,
    positiveOffset,
    deallocate
);

module body Bounds.Test is
    function fill(buffer: Pointer[Int32]): Unit is
        var i: Index := 0;
        while i < 4 do
            let value: Int32 := 7;
            store(positiveOffset(buffer, i), value);
            i := i + 1;
        end while;
        return nil;
    end;

    function testReadsPastTheEnd(): Unit is
        let address: Address[Int32] := allocateBuffer(4);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int32]) do
                fill(buffer);
                printLn(load(positiveOffset(buffer, 4)));
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return nil;
    end;

    function testReadsInside(): Unit is
        let address: Address[Int32] := allocateBuffer(4);
        case nullCheck(address) of
            when Some(value as buffer: Pointer[Int32]) do
                fill(buffer);
                printLn(load(positiveOffset(buffer, 3)));
                deallocate(buffer);
            when None do
                abort("no memory");
        end case;
        return nil;
    end;
end module body.
