"""
Three functions whose contract tests must fail, each for its own reason.
The body of edge breaks its ensures for every value but the boundaries, so
the first drawn input finds it.  No drawn input meets the requires of
exact, so nothing of it is tested.  The body of wrap breaks its ensures
only for the least Int32, which only the boundary values reach.
"""
module Example.Edge is
    function edge(x: Nat32): Nat32
        ensures (result < 2) or (result > 4294967294);

    function exact(x: Nat32): Nat32
        requires x = 12345
        ensures result = x;

    function wrap(value: Int32): Int32
        ensures result > ((-2147483647) - 1);
end module.
