"""
The first negative control of hilde test: of two tests one fails, so the
run reports that test and the file as failed, the other test still runs,
and the run ends with exit 1.
"""
module body Fail.Test is
    function testFailsOnPurpose(): Unit is
        abort("this test fails on purpose");
        return nil;
    end;

    function testPassesAfterIt(): Unit is
        return nil;
    end;
end module body.
