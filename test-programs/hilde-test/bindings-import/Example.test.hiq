"""
The negative control of the Bindings.* import rule: a test file is ordinary
code, and ordinary code may not import a module that binds C, so this
programme is not built and the refusal is H2045.  Only the programme that
hilde test --contracts generates for a Bindings.* module imports one.
"""
import Bindings.Sandbox (
    platform
);

module body Example.Test is
    function testPlatform(): Unit is
        let answer: Int32 := platform();
        return nil;
    end;
end module body.
