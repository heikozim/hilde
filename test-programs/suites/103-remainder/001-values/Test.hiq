module body Test is
    function main(): ExitCode is
        let seven: Int32 := 7;
        let three: Int32 := 3;
        printLn(seven % three);
        printLn((-seven) % three);
        printLn(seven % (-three));
        printLn((-seven) % (-three));
        let tab: Index := 13;
        printLn(tab % 4);
        printLn((tab + 4) - (tab % 4));
        printLn(100 % tab);
        let big: Nat64 := 18446744073709551615;
        let ten: Nat64 := 10;
        printLn(big % ten);
        let low: Int8 := minimum_int8;
        let minus: Int8 := -1;
        printLn(low % minus);
        let low64: Int64 := minimum_int64;
        let minus64: Int64 := -1;
        printLn(low64 % minus64);
        let folded: Int32 := 17 % 5;
        printLn(folded);
        let byte: Nat8 := 250;
        let size: ByteSize := 4097;
        printLn(byte % 7);
        printLn(size % 4096);
        let a: Int64 := -1234567;
        let b: Int64 := 89;
        if (((a / b) * b) + (a % b)) = a then
            printLn("identity holds");
        end if;
        return ExitSuccess();
    end;
end module body.
