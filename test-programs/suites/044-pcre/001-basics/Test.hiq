-- Standard.Pcre: what it finds, with PCRE2 syntax that Standard.Regex
-- refuses among it.  The numbers the binding copies from pcre2.h
-- (bindings/fixtures/pcre2.h, held against the real header by
-- scripts/pcre/check-header.sh) are exercised here as well: a search that
-- finds nothing must be Right(None) -- with the wrong "no match" code it
-- would be a Left -- and groupCount must be what the pattern says, which it
-- is only with the right pattern-info key.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Buffer (
    Buffer,
    destroyFree,
    length as bufferLength,
    nth
);
import Standard.Pcre (
    Regex,
    compile,
    destroyRegex,
    groupCount,
    match,
    Found,
    find,
    foundStart,
    foundEnd,
    groupStart,
    groupEnd,
    destroyFound,
    Hit,
    find_all,
    replace
);

module body Test is
    constant limit: Nat32 := 1000000;

    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        let size: Index := length(text);
        print("[");
        if size > 0 then
            print(getSpan(text, 0, size - 1));
        end if;
        printLn("]");
        return nil;
    end;

    function printOption(value: Option[Index]): Unit is
        case value of
            when Some(value as v: Index) do
                print(v);
            when None do
                print("-");
        end case;
        return nil;
    end;

    function check(pattern: Span[Nat8, Static], subject: Span[Nat8, Static], rewrite: Span[Nat8, Static]): Unit is
        print("pattern ");
        printLn(pattern);
        let text: String := fromLiteral(subject);
        let compiled: Either[String, Regex] := compile(pattern, limit);
        case compiled of
            when Right(right as re: Regex) do
                print("groups ");
                printLn(groupCount(&re));
                case match(&re, asSpan(&text)) of
                    when Right(right as yes: Bool) do
                        print("match ");
                        printLn(yes);
                    when Left(left as message: String) do
                        print("match failed ");
                        printText(&message);
                        destroyString(message);
                end case;
                case find(&re, asSpan(&text)) of
                    when Right(right as result: Option[Found]) do
                        case result of
                            when Some(value as f: Found) do
                                print("find ");
                                print(foundStart(&f));
                                print(" ");
                                print(foundEnd(&f));
                                var g: Index := 1;
                                while g <= groupCount(&re) do
                                    print(" ");
                                    printOption(groupStart(&f, g));
                                    print(",");
                                    printOption(groupEnd(&f, g));
                                    g := g + 1;
                                end while;
                                printLn("");
                                destroyFound(f);
                            when None do
                                printLn("find none");
                        end case;
                    when Left(left as message: String) do
                        print("find failed ");
                        printText(&message);
                        destroyString(message);
                end case;
                case find_all(&re, asSpan(&text)) of
                    when Right(right as hits: Buffer[Hit]) do
                        print("all ");
                        print(bufferLength(&hits));
                        var i: Index := 0;
                        while i < bufferLength(&hits) do
                            let hit: Hit := nth(&hits, i);
                            print(" ");
                            print(hit.start);
                            print(",");
                            print(hit.stop);
                            i := i + 1;
                        end while;
                        printLn("");
                        destroyFree(hits);
                    when Left(left as message: String) do
                        print("all failed ");
                        printText(&message);
                        destroyString(message);
                end case;
                let with: String := fromLiteral(rewrite);
                case replace(&re, asSpan(&text), asSpan(&with)) of
                    when Right(right as out: String) do
                        print("replace ");
                        printText(&out);
                        destroyString(out);
                    when Left(left as message: String) do
                        print("replace failed ");
                        printText(&message);
                        destroyString(message);
                end case;
                destroyString(with);
                destroyRegex(re);
            when Left(left as message: String) do
                print("error ");
                printText(&message);
                destroyString(message);
        end case;
        destroyString(text);
        return nil;
    end;

    function main(): ExitCode is
        check("b(c+)d", "abcccde", "<\\1>");
        check("xyz", "abc", "-");
        check("(a)(b)(c)", "abc", "\\3\\2\\1");
        check("(a)|(b)", "b", "\\1-\\2");
        -- What only PCRE2 has.
        check("(a)\\1", "xaay", "<\\0>");
        check("a(?=b)", "ac ab", "<\\0>");
        check("(?<=a)b", "cb ab", "<\\0>");
        check("a++b", "aaab", "<\\0>");
        -- Empty matches: after one, the next search starts a byte on.
        check("a*", "baa", "-");
        check("x*", "ab", "-");
        -- A pattern PCRE2 refuses, with its message and offset.
        check("(abc", "abc", "-");
        check("a{2,1}", "a", "-");
        return ExitSuccess();
    end;
end module body.
