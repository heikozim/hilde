-- The match limit of Standard.Pcre: part of compile, never omitted, and
-- reaching it is a Left, not a trap and not a hang.
import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Pcre (
    Regex,
    compile,
    destroyRegex,
    match
);

module body Test is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        let size: Index := length(text);
        print("[");
        if size > 0 then
            print(getSpan(text, 0, size - 1));
        end if;
        printLn("]");
        return nil;
    end;

    -- count a's and then a b.
    function repeated(count: Index): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < count do
            writeByte(&!out, 'a');
            i := i + 1;
        end while;
        writeByte(&!out, 'b');
        return finalize(out);
    end;

    function run(pattern: Span[Nat8, Static], limit: Nat32, count: Index): Unit is
        let subject: String := repeated(count);
        case compile(pattern, limit) of
            when Right(right as re: Regex) do
                case match(&re, asSpan(&subject)) of
                    when Right(right as yes: Bool) do
                        print("match ");
                        printLn(yes);
                    when Left(left as message: String) do
                        print("failed ");
                        printText(&message);
                        destroyString(message);
                end case;
                destroyRegex(re);
            when Left(left as message: String) do
                print("error ");
                printText(&message);
                destroyString(message);
        end case;
        destroyString(subject);
        return nil;
    end;

    function main(): ExitCode is
        -- Exponential for a backtracking engine: (a+)+$ against a's and a b.
        -- Short, under a generous limit: PCRE2 answers.
        run("(a+)+$", 1000000, 10);
        -- Long, under a small limit: the limit is reached, and it is a Left.
        run("(a+)+$", 1000, 30);
        -- The same text through a pattern with no such blow-up, same limit.
        run("a+$", 1000, 30);
        -- A limit of zero is refused by compile.
        run("a", 0, 1);
        return ExitSuccess();
    end;
end module body.
