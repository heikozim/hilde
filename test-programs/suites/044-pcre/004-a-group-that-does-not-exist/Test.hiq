-- groupStart and groupEnd for a group number the pattern does not have:
-- None, also for the largest Index, whose double does not fit an Index.
-- The groups that exist answer first, so that None below is a finding.
import Standard.String (
    String,
    destroyString
);
import Standard.Pcre (
    Regex,
    compile,
    destroyRegex,
    Found,
    find,
    groupStart,
    groupEnd,
    destroyFound
);

module body Test is
    constant limit: Nat32 := 1000000;

    function show(label: Span[Nat8, Static], answer: Option[Index]): Unit is
        print(label);
        case answer of
            when Some(value as at: Index) do
                printLn(at);
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case compile("b(c)", limit) of
            when Right(right as regex: Regex) do
                case find(&regex, "abcd") of
                    when Right(right as answer: Option[Found]) do
                        case answer of
                            when Some(value as found: Found) do
                                show("group 0 starts at ", groupStart(&found, 0));
                                show("group 1 ends at ", groupEnd(&found, 1));
                                show("group 2 starts at ", groupStart(&found, 2));
                                show("the largest group starts at ", groupStart(&found, maximum_index));
                                show("the largest group ends at ", groupEnd(&found, maximum_index));
                                show("half the largest ends at ", groupEnd(&found, maximum_index / 2));
                                destroyFound(found);
                            when None do
                                printLn("no match");
                        end case;
                    when Left(left as message: String) do
                        printLn("the search failed");
                        destroyString(message);
                end case;
                destroyRegex(regex);
            when Left(left as message: String) do
                printLn("not compiled");
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
