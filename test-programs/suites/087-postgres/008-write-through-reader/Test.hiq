-- execute takes a writing connection only: a write through a reading one
-- does not compile.
import Standard.Postgres (
    Connection,
    Reading,
    PgError,
    closeDatabase,
    noValues,
    execute
);

module body Test is
    generic [R: Region]
    function write(db: &![Connection[Reading], R]): Unit is
        case execute(db, "DELETE FROM items", noValues()) of
            when Left(left as error: PgError) do
                skip;
            when Right(right as count: Nat64) do
                skip;
        end case;
        return nil;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
