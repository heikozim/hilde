-- The classes of a refused write: a unique key, a foreign key, not null and
-- a check are each a constraint violation, only the first a unique one, and
-- none of them busy.  The rows that broke them are not in the tables.
import Standard.Postgres (
    Connection,
    Writing,
    PgError,
    Values,
    Cursor,
    describe,
    isUniqueViolation,
    isConstraintViolation,
    isBusy,
    stateClass,
    closeDatabase,
    migrate,
    noValues,
    withInt64,
    withText,
    start,
    execute,
    advance,
    columnInt64,
    finish
);
import PgTest (
    openTest
);

module body Test is
    constant migrations: Span[Nat8, Static] := "172\nCREATE TABLE owners (id int8 PRIMARY KEY, name text NOT NULL UNIQUE, age int8 CHECK (age >= 0)); CREATE TABLE pets (id int8 PRIMARY KEY, owner int8 REFERENCES owners (id));";

    function classify(label: Span[Nat8, Static], result: Either[PgError, Nat64]): Unit is
        print(label);
        print(": ");
        case result of
            when Left(left as error: PgError) do
                print(describe(error));
                print(", unique ");
                print(isUniqueViolation(error));
                print(", constraint ");
                print(isConstraintViolation(error));
                print(", busy ");
                print(isBusy(error));
                print(", class ");
                printLn(stateClass(error));
            when Right(right as count: Nat64) do
                print("written ");
                printLn(count);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openTest() of
            when Left(left as error: PgError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case migrate(&!db, migrations) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as count: Index) do
                        skip;
                end case;
                classify("first owner", execute(&!db, "INSERT INTO owners (id, name, age) VALUES ($1, $2, $3)", withInt64(withText(withInt64(noValues(), 1), "Ada"), 36)));
                classify("same name", execute(&!db, "INSERT INTO owners (id, name, age) VALUES ($1, $2, $3)", withInt64(withText(withInt64(noValues(), 2), "Ada"), 40)));
                classify("no name", execute(&!db, "INSERT INTO owners (id, age) VALUES ($1, $2)", withInt64(withInt64(noValues(), 3), 40)));
                classify("negative age", execute(&!db, "INSERT INTO owners (id, name, age) VALUES ($1, $2, $3)", withInt64(withText(withInt64(noValues(), 4), "Bob"), -1)));
                classify("unknown owner", execute(&!db, "INSERT INTO pets (id, owner) VALUES ($1, $2)", withInt64(withInt64(noValues(), 1), 99)));
                var cursor: Cursor := start(&!db, "SELECT count(*) FROM owners", noValues());
                while advance(&!cursor) do
                    print("owners: ");
                    printLn(columnInt64(&cursor, 0));
                end while;
                case finish(&!db, cursor) of
                    when Some(value as error: PgError) do
                        printLn(describe(error));
                    when None do
                        skip;
                end case;
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
