-- A statement fails inside a transaction; the commit then fails too, with
-- 25P02, and the row written before the failure is not in the table.  A
-- transaction rolled back by hand leaves nothing either, and one committed
-- leaves its row.
import Standard.Postgres (
    Connection,
    Writing,
    PgError,
    Transaction,
    Cursor,
    describe,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    noValues,
    withInt64,
    start,
    execute,
    advance,
    columnInt64,
    finish
);
import PgTest (
    openTest
);

module body Test is
    constant migrations: Span[Nat8, Static] := "41\nCREATE TABLE items (id int8 PRIMARY KEY);";

    generic [R: Region]
    function insert(db: &![Connection[Writing], R], id: Int64): Unit is
        case execute(db, "INSERT INTO items (id) VALUES ($1)", withInt64(noValues(), id)) of
            when Left(left as error: PgError) do
                print("insert ");
                print(id);
                print(": ");
                printLn(describe(error));
            when Right(right as count: Nat64) do
                print("insert ");
                printLn(id);
        end case;
        return nil;
    end;

    generic [R: Region]
    function count(db: &![Connection[Writing], R]): Unit is
        var rows: Cursor := start(&~db, "SELECT count(*) FROM items", noValues());
        while advance(&!rows) do
            print("items: ");
            printLn(columnInt64(&rows, 0));
        end while;
        case finish(&~db, rows) of
            when Some(value as error: PgError) do
                printLn(describe(error));
            when None do
                skip;
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openTest() of
            when Left(left as error: PgError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case migrate(&!db, migrations) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as applied: Index) do
                        skip;
                end case;
                case begin(&!db) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as transaction: Transaction) do
                        insert(&!db, 1);
                        insert(&!db, 1);
                        case commit(&!db, transaction) of
                            when Left(left as error: PgError) do
                                print("commit: ");
                                printLn(describe(error));
                            when Right(right as done: Unit) do
                                printLn("commit: COMMITTED");
                        end case;
                end case;
                count(&!db);
                case begin(&!db) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as transaction: Transaction) do
                        insert(&!db, 2);
                        rollback(&!db, transaction);
                        printLn("rolled back");
                end case;
                count(&!db);
                case begin(&!db) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as transaction: Transaction) do
                        insert(&!db, 3);
                        case commit(&!db, transaction) of
                            when Left(left as error: PgError) do
                                printLn(describe(error));
                            when Right(right as done: Unit) do
                                printLn("commit: committed");
                        end case;
                end case;
                count(&!db);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
