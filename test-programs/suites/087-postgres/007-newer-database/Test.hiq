-- A programme with two migrations applies both; one with only the first
-- finds the database newer than itself and says so, and changes nothing.
import Standard.Postgres (
    Connection,
    Writing,
    PgError,
    describe,
    closeDatabase,
    migrate
);
import PgTest (
    openTest
);

module body Test is
    constant both: Span[Nat8, Static] := "38\nCREATE TABLE one (id int8 PRIMARY KEY)38\nCREATE TABLE two (id int8 PRIMARY KEY)";
    constant first: Span[Nat8, Static] := "38\nCREATE TABLE one (id int8 PRIMARY KEY)";

    generic [R: Region]
    function run(db: &![Connection[Writing], R], label: Span[Nat8, Static], migrations: Span[Nat8, Static]): Unit is
        print(label);
        print(": ");
        case migrate(db, migrations) of
            when Left(left as error: PgError) do
                printLn(describe(error));
            when Right(right as count: Index) do
                print("applied ");
                printLn(count);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openTest() of
            when Left(left as error: PgError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                run(&!db, "both", both);
                run(&!db, "first only", first);
                run(&!db, "both again", both);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
