-- A wrong password is refused: no connection, the code of a connection
-- that could not be made.  The right password then works, so the refusal
-- is the password's and not a server that is not there.
import Standard.Postgres (
    Connection,
    Writing,
    PgError,
    describe,
    usesTls,
    closeDatabase
);
import PgTest (
    openTest,
    openWithPassword
);

module body Test is
    function main(): ExitCode is
        case openWithPassword("not-the-password") of
            when Left(left as error: PgError) do
                print("wrong password: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                printLn("wrong password: CONNECTED");
                closeDatabase(db);
        end case;
        case openTest() of
            when Left(left as error: PgError) do
                print("right password: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                print("right password: connected, tls ");
                printLn(usesTls(&db));
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
