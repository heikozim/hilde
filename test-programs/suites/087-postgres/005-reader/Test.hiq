-- A reading connection reads, and a write sent through it anyway, with
-- start, which takes any connection, is refused by the server as a write
-- in a read only transaction.
import Standard.Postgres (
    Connection,
    Writing,
    Reading,
    PgError,
    Cursor,
    describe,
    closeDatabase,
    migrate,
    noValues,
    withInt64,
    start,
    execute,
    advance,
    columnInt64,
    finish
);
import PgTest (
    openTest,
    openTestReader
);

module body Test is
    constant migrations: Span[Nat8, Static] := "42\nCREATE TABLE counts (id int8 PRIMARY KEY);";

    function main(): ExitCode is
        case openTest() of
            when Left(left as error: PgError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var writer: Connection[Writing] := opened;
                case migrate(&!writer, migrations) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as count: Index) do
                        skip;
                end case;
                case execute(&!writer, "INSERT INTO counts (id) VALUES ($1)", withInt64(noValues(), 7)) of
                    when Left(left as error: PgError) do
                        printLn(describe(error));
                    when Right(right as count: Nat64) do
                        skip;
                end case;
                closeDatabase(writer);
        end case;
        case openTestReader() of
            when Left(left as error: PgError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Connection[Reading]) do
                var reader: Connection[Reading] := opened;
                var rows: Cursor := start(&!reader, "SELECT id FROM counts", noValues());
                while advance(&!rows) do
                    print("read: ");
                    printLn(columnInt64(&rows, 0));
                end while;
                case finish(&!reader, rows) of
                    when Some(value as error: PgError) do
                        printLn(describe(error));
                    when None do
                        printLn("read: done");
                end case;
                var write: Cursor := start(&!reader, "INSERT INTO counts (id) VALUES ($1)", withInt64(noValues(), 8));
                while advance(&!write) do
                    skip;
                end while;
                case finish(&!reader, write) of
                    when Some(value as error: PgError) do
                        print("write through the reader: ");
                        printLn(describe(error));
                    when None do
                        printLn("write through the reader: WRITTEN");
                end case;
                closeDatabase(reader);
                return ExitSuccess();
        end case;
    end;
end module body.
