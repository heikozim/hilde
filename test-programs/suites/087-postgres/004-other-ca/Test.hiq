-- A client that trusts a CA which did not sign the server's certificate
-- does not connect: verify-full holds.  The right CA then works.
import Standard.Postgres (
    Connection,
    Writing,
    PgError,
    describe,
    closeDatabase
);
import PgTest (
    openTest,
    openWithOtherCa
);

module body Test is
    function main(): ExitCode is
        case openWithOtherCa() of
            when Left(left as error: PgError) do
                print("other CA: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                printLn("other CA: CONNECTED");
                closeDatabase(db);
        end case;
        case openTest() of
            when Left(left as error: PgError) do
                print("right CA: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                printLn("right CA: connected");
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
