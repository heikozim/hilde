pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    Address,
    allocateBuffer,
    nullCheck,
    deallocate,
    store,
    load,
    positiveOffset,
    wipe
);

module body Test is
    function allocateOrDie(): Pointer[Nat8] is
        let addr: Address[Nat8] := allocateBuffer(4);
        case nullCheck(addr) of
            when Some(value: Pointer[Nat8]) do
                return value;
            when None do
                abort("Allocation failed.");
        end case;
    end;

    function main(): ExitCode is
        let ptr: Pointer[Nat8] := allocateOrDie();
        let marker: Nat8 := 170;
        let bytes: ByteSize := 4;
        store(positiveOffset(ptr, 0), marker);
        store(positiveOffset(ptr, 1), marker);
        store(positiveOffset(ptr, 2), marker);
        store(positiveOffset(ptr, 3), marker);
        printLn(load(positiveOffset(ptr, 0)));
        printLn(load(positiveOffset(ptr, 3)));
        wipe(ptr, bytes);
        printLn(load(positiveOffset(ptr, 0)));
        printLn(load(positiveOffset(ptr, 3)));
        deallocate(ptr);
        return ExitSuccess();
    end;
end module body.
