-- A case over a read reference binds references to the payload, and a read
-- reference is Free whatever it points to: a binding the branch does not
-- use is not a linear value left unconsumed.  Earlier the linearity
-- check gave the binding the payload's type and refused both functions
-- below with "The variable ... is not consumed" (LinearityCheck,
-- check_when).
module body Test is
    record Box: Linear is
        n: Int32;
    end;

    union Holder: Linear is
        case Full is
            box: Box;
        case Empty;
    end;

    -- A linear payload, and the binding goes unused.
    generic [R: Region]
    function isFull(holder: &[Holder, R]): Bool is
        case holder of
            when Full(box as inner: &[Box, R]) do
                return true;
            when Empty do
                return false;
        end case;
    end;

    -- A payload of a type parameter, which may be linear: the shape of
    -- Standard.Template.isPresent.
    generic [T: Type, R: Region]
    function isSome(value: &[Option[T], R]): Bool is
        case value of
            when Some(value as inner: &[T, R]) do
                return true;
            when None do
                return false;
        end case;
    end;

    function main(): ExitCode is
        let full: Holder := Full(box => Box(n => 7));
        let empty: Holder := Empty();
        let some: Option[Box] := Some(value => Box(n => 8));
        if isFull(&full) then
            printLn("full: yes");
        end if;
        if not isFull(&empty) then
            printLn("empty: no");
        end if;
        if isSome(&some) then
            printLn("some: yes");
        end if;
        case full of
            when Full(box as b: Box) do
                let { n: Int32 } := b;
            when Empty do
                skip;
        end case;
        case empty of
            when Full(box as b: Box) do
                let { n: Int32 } := b;
            when Empty do
                skip;
        end case;
        case some of
            when Some(value as b: Box) do
                let { n: Int32 } := b;
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
