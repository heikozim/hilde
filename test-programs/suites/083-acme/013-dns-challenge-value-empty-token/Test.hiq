import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.X509 (
    destroyPrivateKey
);
import Standard.Acme (
    AcmeError,
    Account,
    Order,
    Challenge,
    destroyAcmeError,
    destroyOrder,
    destroyChallenge,
    closeAccount,
    accountUrl,
    thumbprint,
    keyAuthorization,
    dnsChallengeValue,
    newOrder,
    fetchOrder,
    challengeOf,
    respond,
    authorizationStatus,
    finalizeOrder,
    downloadCertificate
);
import AcmeFake (
    Fake,
    startFake,
    openFakeAccount,
    stopFake
);

module body Test is
    -- dnsChallengeValue of no token.
    function main(): ExitCode is
        case startFake() of
            when Some(value as fake: Fake) do
                case openFakeAccount(&fake) of
                    when Some(value as opened: Account) do
                        var account: Account := opened;
                        printLn("before");
                        let text: String := dnsChallengeValue(&!account, ""); -- violates
                        printLn("after");
                        destroyString(text);
                        destroyPrivateKey(closeAccount(account));
                    when None do
                        printLn("no account");
                end case;
                stopFake(fake);
            when None do
                printLn("no server");
        end case;
        return ExitSuccess();
    end;
end module body.
