import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.X509 (
    destroyPrivateKey
);
import Standard.Acme (
    AcmeError,
    Account,
    Order,
    Challenge,
    destroyAcmeError,
    destroyOrder,
    destroyChallenge,
    closeAccount,
    accountUrl,
    thumbprint,
    keyAuthorization,
    dnsChallengeValue,
    newOrder,
    fetchOrder,
    challengeOf,
    respond,
    authorizationStatus,
    finalizeOrder,
    downloadCertificate
);
import AcmeFake (
    Fake,
    startFake,
    openFakeAccount,
    stopFake
);

module body Test is
    -- The ensures of accountUrl, thumbprint, keyAuthorization and dnsChallengeValue
    -- and the invariants of Account hold at the fake server.
    function main(): ExitCode is
        case startFake() of
            when Some(value as fake: Fake) do
                case openFakeAccount(&fake) of
                    when Some(value as opened: Account) do
                        var account: Account := opened;
                        let url: String := accountUrl(&!account);
                        print("account url not empty: ");
                        printLn(length(&url) > 0);
                        destroyString(url);
                        let print43: String := thumbprint(&!account);
                        print("thumbprint: ");
                        printLn(length(&print43));
                        destroyString(print43);
                        let keyAuth: String := keyAuthorization(&!account, "token");
                        print("key authorization of a token of 5: ");
                        printLn(length(&keyAuth));
                        destroyString(keyAuth);
                        let value: String := dnsChallengeValue(&!account, "token");
                        print("dns value: ");
                        printLn(length(&value));
                        destroyString(value);
                        destroyPrivateKey(closeAccount(account));
                    when None do
                        printLn("no account");
                end case;
                stopFake(fake);
            when None do
                printLn("no server");
        end case;
        return ExitSuccess();
    end;
end module body.
