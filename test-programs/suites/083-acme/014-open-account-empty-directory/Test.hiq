import Standard.HttpClient (
    defaultLimits
);
import Standard.X509 (
    PrivateKey,
    EcP256,
    generateKey,
    destroyPrivateKey
);
import Standard.Acme (
    AcmeError,
    Account,
    destroyAcmeError,
    closeAccount,
    openAccount
);

module body Test is
    -- openAccount with no directory URL: there is no server to ask.
    function main(): ExitCode is
        case generateKey(EcP256()) of
            when Some(value as key: PrivateKey) do
                printLn("before");
                case openAccount("", key, "", "server-cert.pem", defaultLimits()) of -- violates
                    when Right(right as account: Account) do
                        destroyPrivateKey(closeAccount(account));
                    when Left(left as error: AcmeError) do
                        destroyAcmeError(error);
                end case;
                printLn("after");
            when None do
                printLn("no key");
        end case;
        return ExitSuccess();
    end;
end module body.
