import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyFree,
    insertBack
);
import Standard.Sort (
    sort
);

module body Test is
    -- A record with no TotalOrder instance anywhere: sort must refuse it
    -- where it is called, not fail later in the generated code.
    record Point: Free is
        x: Int32;
        y: Int32;
    end;

    function main(): ExitCode is
        var b: Buffer[Point] := allocateEmpty();
        insertBack(&!b, Point(x => 1, y => 2));
        let s: Buffer[Point] := sort(b);
        destroyFree(s);
        return ExitSuccess();
    end;
end module body.
