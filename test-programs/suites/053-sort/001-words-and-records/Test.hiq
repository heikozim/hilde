import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyEmpty,
    destroyFree,
    length,
    nth,
    nthRef,
    insertBack,
    removeLast
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as stringLength,
    getSpan
);
import Standard.Order (
    Ordering,
    TotalOrder,
    compare
);
import Standard.Sort (
    Search,
    sort,
    isSorted,
    binarySearch
);

module body Test is
    -- A record of this module's own, with an order of this module's own:
    -- the higher priority first.  Standard.Sort does not import this
    -- module, so sorting a Job reaches an instance the generic code's
    -- module cannot see, which the monomorphizer searches for.
    record Job: Free is
        priority: Int32;
        id: Int32;
    end;

    instance TotalOrder(Job) is
        generic [R: Region, S: Region]
        method compare(a: &[Job, R], b: &[Job, S]): Ordering is
            let ap: Int32 := a->priority;
            let bp: Int32 := b->priority;
            return compare(&bp, &ap);
        end;
    end;

    generic [R: Region]
    function printString(s: &[String, R]): Unit is
        let n: Index := stringLength(s);
        if n > 0 then
            printLn(getSpan(s, 0, n - 1));
        else
            printLn("(empty)");
        end if;
        return nil;
    end;

    function printSearch(label: Span[Nat8, Static], result: Search): Unit is
        print(label);
        case result of
            when Found(position as p: Index) do
                print("found at ");
                printLn(p);
            when Missing(insertAt as p: Index) do
                print("missing, goes to ");
                printLn(p);
        end case;
        return nil;
    end;

    function words(): Unit is
        var b: Buffer[String] := allocateEmpty();
        insertBack(&!b, fromLiteral("pear"));
        insertBack(&!b, fromLiteral("fig"));
        insertBack(&!b, fromLiteral("apple"));
        insertBack(&!b, fromLiteral("banana"));
        insertBack(&!b, fromLiteral("fig"));
        insertBack(&!b, fromLiteral("cherry"));
        insertBack(&!b, fromLiteral("app"));
        print("sorted before: ");
        printLn(isSorted(&b));
        var s: Buffer[String] := sort(b);
        print("sorted after: ");
        printLn(isSorted(&s));
        for i from 0 to length(&s) - 1 do
            printString(nthRef(&s, i));
        end for;
        let cherry: String := fromLiteral("cherry");
        let date: String := fromLiteral("date");
        printSearch("cherry: ", binarySearch(&s, &cherry));
        printSearch("date: ", binarySearch(&s, &date));
        destroyString(cherry);
        destroyString(date);
        while length(&s) > 0 do
            destroyString(removeLast(&!s));
        end while;
        destroyEmpty(s);
        return nil;
    end;

    function jobs(): Unit is
        var b: Buffer[Job] := allocateEmpty();
        insertBack(&!b, Job(priority => 1, id => 10));
        insertBack(&!b, Job(priority => 3, id => 11));
        insertBack(&!b, Job(priority => 2, id => 12));
        insertBack(&!b, Job(priority => 3, id => 13));
        insertBack(&!b, Job(priority => 1, id => 14));
        let s: Buffer[Job] := sort(b);
        for i from 0 to length(&s) - 1 do
            let j: Job := nth(&s, i);
            print("job ");
            print(j.id);
            print(" priority ");
            printLn(j.priority);
        end for;
        destroyFree(s);
        return nil;
    end;

    function main(): ExitCode is
        words();
        jobs();
        return ExitSuccess();
    end;
end module body.
