import Hilde.Array (
    Array,
    allocateArray,
    arrayLength,
    arrayNth,
    arrayNthRef,
    arrayStore,
    arraySwap,
    arraySwapIndex,
    arrayApply,
    arrayInsert,
    arrayRemove,
    arraySpan,
    arraySpanMut,
    destroyEmptyArray,
    destroyFreeArray
);

module body Test is
    function double(x: Int32): Int32 is
        return x * 2;
    end;

    function main(): ExitCode is
        let opt: Option[Array[Int32]] := allocateArray(4);
        case opt of
            when Some(value as a0: Array[Int32]) do
                var a: Array[Int32] := a0;
                arrayInsert(&!a, 0, 10);
                arrayInsert(&!a, 1, 20);
                arrayInsert(&!a, 2, 30);
                -- The first index is past the last element.
                arraySwapIndex(&!a, 3, 0);
                destroyFreeArray(a);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
