import Hilde.Array (
    Array,
    allocateArray,
    arrayInsert,
    destroyFreeArray
);

module body Test is
    record Token: Linear is
        id: Int32;
    end;

    -- destroyFreeArray gives back an array whatever it holds, so it takes
    -- only free elements.  An array of linear tokens is refused.
    function main(): ExitCode is
        let opt: Option[Array[Token]] := allocateArray(1);
        case opt of
            when Some(value as a0: Array[Token]) do
                var a: Array[Token] := a0;
                arrayInsert(&!a, 0, Token(id => 1));
                destroyFreeArray(a);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
