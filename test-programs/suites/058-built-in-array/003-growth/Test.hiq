import Hilde.Array (
    Array,
    allocateArray,
    arrayLength,
    arrayNth,
    arrayInsert,
    arrayRemove,
    destroyEmptyArray
);

module body Test is
    -- A thousand inserts, alternately at the front and at the back, into
    -- room for one: the room doubles ten times, and every element must
    -- still be where it was put.
    function main(): ExitCode is
        let opt: Option[Array[Int64]] := allocateArray(1);
        case opt of
            when Some(value as a0: Array[Int64]) do
                var a: Array[Int64] := a0;
                var i: Int64 := 0;
                var front: Bool := true;
                while i < 1000 do
                    if front then
                        arrayInsert(&!a, 0, i);
                    else
                        let n: Index := arrayLength(&a);
                        arrayInsert(&!a, n, i);
                    end if;
                    i := i + 1;
                    front := not front;
                end while;
                printLn(arrayLength(&a));
                printLn(arrayNth(&a, 0));
                printLn(arrayNth(&a, 499));
                printLn(arrayNth(&a, 500));
                printLn(arrayNth(&a, 999));
                var total: Int64 := 0;
                while arrayLength(&a) > 0 do
                    let n: Index := arrayLength(&a);
                    total := total + arrayRemove(&!a, n - 1);
                end while;
                printLn(total);
                destroyEmptyArray(a);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
