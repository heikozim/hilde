import Hilde.Array (
    Array,
    allocateArray,
    arrayInsert,
    destroyEmptyArray
);

module body Test is
    function main(): ExitCode is
        let opt: Option[Array[Int32]] := allocateArray(4);
        case opt of
            when Some(value as a0: Array[Int32]) do
                var a: Array[Int32] := a0;
                arrayInsert(&!a, 0, 10);
                arrayInsert(&!a, 1, 20);
                arrayInsert(&!a, 2, 30);
                -- Giving back as empty an array that still holds three
                -- elements: they would be lost.
                destroyEmptyArray(a);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
