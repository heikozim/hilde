import Hilde.Array (
    Array,
    allocateArray,
    arrayLength,
    arrayNthRef,
    arraySwap,
    arraySwapIndex,
    arrayApply,
    arrayInsert,
    arrayRemove,
    destroyEmptyArray
);

module body Test is
    -- A linear element: it must be taken apart, so nothing can drop one.
    record Token: Linear is
        id: Int32;
    end;

    function spend(t: Token): Int32 is
        let { id: Int32 } := t;
        return id;
    end;

    function renumber(t: Token): Token is
        let { id: Int32 } := t;
        return Token(id => id + 100);
    end;

    function main(): ExitCode is
        let opt: Option[Array[Token]] := allocateArray(1);
        case opt of
            when Some(value as a0: Array[Token]) do
                var a: Array[Token] := a0;
                arrayInsert(&!a, 0, Token(id => 1));
                arrayInsert(&!a, 1, Token(id => 2));
                arrayInsert(&!a, 2, Token(id => 3));
                borrow r: &[Array[Token], rho] := &a do
                    let second: &[Token, rho] := arrayNthRef(r, 1);
                    printLn(second->id);
                end borrow;
                let old: Token := arraySwap(&!a, 0, Token(id => 4));
                printLn(spend(old));
                arraySwapIndex(&!a, 0, 2);
                arrayApply(&!a, 1, renumber);
                var total: Int32 := 0;
                while arrayLength(&a) > 0 do
                    let t: Token := arrayRemove(&!a, 0);
                    let id: Int32 := spend(t);
                    printLn(id);
                    total := total + id;
                end while;
                printLn(total);
                destroyEmptyArray(a);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
