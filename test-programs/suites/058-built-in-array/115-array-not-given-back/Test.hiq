import Hilde.Array (
    Array,
    allocateArray,
    arrayInsert
);

module body Test is
    -- The array is linear: leaving it without giving it back is refused.
    function main(): ExitCode is
        let opt: Option[Array[Int32]] := allocateArray(1);
        case opt of
            when Some(value as a0: Array[Int32]) do
                var a: Array[Int32] := a0;
                arrayInsert(&!a, 0, 1);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
