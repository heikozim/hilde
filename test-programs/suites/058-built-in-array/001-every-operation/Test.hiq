import Hilde.Array (
    Array,
    allocateArray,
    arrayLength,
    arrayNth,
    arrayNthRef,
    arrayStore,
    arraySwap,
    arraySwapIndex,
    arrayApply,
    arrayInsert,
    arrayRemove,
    arraySpan,
    arraySpanMut,
    destroyEmptyArray,
    destroyFreeArray
);

module body Test is
    function double(x: Int32): Int32 is
        return x * 2;
    end;

    generic [R: Region]
    function sumSpan(s: Span[Int32, R]): Int32 is
        var total: Int32 := 0;
        for i from 0 to spanLength(s) - 1 do
            total := total + s[i];
        end for;
        return total;
    end;

    function main(): ExitCode is
        let opt: Option[Array[Int32]] := allocateArray(2);
        case opt of
            when Some(value as a0: Array[Int32]) do
                var a: Array[Int32] := a0;
                -- Five inserts into room for two: the room grows twice.
                arrayInsert(&!a, 0, 10);
                arrayInsert(&!a, 1, 30);
                arrayInsert(&!a, 1, 20);
                arrayInsert(&!a, 3, 40);
                arrayInsert(&!a, 0, 0);
                printLn(arrayLength(&a));
                printLn(arrayNth(&a, 0));
                printLn(arrayNth(&a, 4));
                borrow r: &[Array[Int32], rho] := &a do
                    let third: &[Int32, rho] := arrayNthRef(r, 2);
                    printLn(!third);
                end borrow;
                arrayStore(&!a, 0, 5);
                printLn(arrayNth(&a, 0));
                let old: Int32 := arraySwap(&!a, 1, 11);
                printLn(old);
                arraySwapIndex(&!a, 0, 4);
                printLn(arrayNth(&a, 0));
                printLn(arrayNth(&a, 4));
                arrayApply(&!a, 2, double);
                printLn(arrayNth(&a, 2));
                let removed: Int32 := arrayRemove(&!a, 1);
                printLn(removed);
                printLn(arrayLength(&a));
                borrow s: &[Array[Int32], sigma] := &a do
                    printLn(sumSpan(arraySpan(s, 0, 3)));
                    printLn(sumSpan(arraySpan(s, 1, 2)));
                end borrow;
                borrow w: &![Array[Int32], tau] := &!a do
                    var m: Span![Int32, tau] := arraySpanMut(w, 0, 0);
                    m[0] := 99;
                end borrow;
                printLn(arrayNth(&a, 0));
                let e0: Int32 := arrayRemove(&!a, 0);
                let e1: Int32 := arrayRemove(&!a, 0);
                let e2: Int32 := arrayRemove(&!a, 0);
                let e3: Int32 := arrayRemove(&!a, 0);
                printLn(((e0 + e1) + e2) + e3);
                destroyEmptyArray(a);
            when None do
                abort("allocation failed");
        end case;
        let opt2: Option[Array[Int32]] := allocateArray(0);
        case opt2 of
            when Some(value as b0: Array[Int32]) do
                var b: Array[Int32] := b0;
                arrayInsert(&!b, 0, 7);
                arrayInsert(&!b, 1, 8);
                printLn(arrayLength(&b));
                destroyFreeArray(b);
            when None do
                abort("allocation failed");
        end case;
        return ExitSuccess();
    end;
end module body.
