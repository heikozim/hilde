-- A programme that imports Standard.Sqlite and Standard.SqlCipher does not
-- compile (H2044): the two libraries export the same
-- functions, and a link against both would take each from whichever came
-- first.
import Standard.Sqlite (
    SqlError
);
import Standard.SqlCipher (
    SqlError as CipherError
);

module body Test is
    function main(): ExitCode is
        let a: SqlError := SqlError(code => 0);
        let b: CipherError := CipherError(code => 0);
        print(a.code);
        printLn(b.code);
        return ExitSuccess();
    end;
end module body.
