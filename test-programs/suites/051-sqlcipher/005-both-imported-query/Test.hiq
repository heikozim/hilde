-- A module that imports Standard.Sqlite and Standard.SqlCipher and uses
-- @query does not compile, and the refusal is the link check's (H2044,
-- lib/Compiler.ml), not a check of @query's own: the module's imports are
-- compiled before it -- before it is even parsed -- and the second binding
-- is refused there first.  So a check at @query (it would be H8117)
-- cannot be reached.  With the link check taken out, this module
-- compiles.
--
import Standard.Sqlite (
    SqlError
);
import Standard.SqlCipher (
    Connection,
    Reading,
    SqlError as CipherError
);

module body Test is
    record Note[R: Region]: Free is
        content: Span[Nat8, R];
    end;

    generic [R: Region]
    function read(db: &![Connection[Reading], R]): Unit is
        @query(&~db, "SELECT content FROM notes")
            for note: Note[Q] do
            printLn(note.content);
        else error do
            printLn(error.code);
        end for;
        return nil;
    end;

    function main(): ExitCode is
        let a: SqlError := SqlError(code => 0);
        printLn(a.code);
        return ExitSuccess();
    end;
end module body.
