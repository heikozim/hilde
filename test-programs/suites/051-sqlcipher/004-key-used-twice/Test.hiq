-- The key is linear: the open consumes it, and a second use of
-- the same key does not compile.
import Standard.SqlCipher (
    Connection,
    Writing,
    SqlError,
    Key,
    makeKey,
    openWriter,
    closeDatabase
);

module body Test is
    function main(): ExitCode is
        let key: Key := makeKey("once");
        case openWriter("a.db", key) of
            when Left(left as error: SqlError) do
                skip;
            when Right(right as db: Connection[Writing]) do
                closeDatabase(db);
        end case;
        case openWriter("b.db", key) of
            when Left(left as error: SqlError) do
                skip;
            when Right(right as db: Connection[Writing]) do
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
