-- A wrong key is an error of the open:
-- SQLCipher itself notices it only at the first read, and Standard.SqlCipher
-- reads the schema once before it returns.  The right key afterwards still
-- opens the file, so the refusal was the key and not the file.
import Standard.SqlCipher (
    Connection,
    Writing,
    Reading,
    SqlError,
    makeKey,
    describe,
    openWriter,
    openReader,
    closeDatabase,
    execute,
    noValues
);

module body Test is
    function main(): ExitCode is
        case openWriter("locked.db", makeKey("the right key")) of
            when Left(left as error: SqlError) do
                print("create: failed, code ");
                printLn(error.code);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case execute(&!db, "CREATE TABLE t (x INTEGER) STRICT", noValues()) of
                    when Left(left as error: SqlError) do
                        print("create table: failed, code ");
                        printLn(error.code);
                    when Right(right as changed: Nat64) do
                        printLn("created");
                end case;
                closeDatabase(db);
        end case;
        case openReader("locked.db", makeKey("a wrong key")) of
            when Left(left as error: SqlError) do
                print("wrong key: refused by the open, code ");
                print(error.code);
                print(", ");
                printLn(describe(error));
            when Right(right as opened: Connection[Reading]) do
                printLn("wrong key: OPENED");
                closeDatabase(opened);
        end case;
        case openReader("locked.db", makeKey("the right key")) of
            when Left(left as error: SqlError) do
                print("right key: failed, code ");
                printLn(error.code);
            when Right(right as opened: Connection[Reading]) do
                printLn("right key: opened");
                closeDatabase(opened);
        end case;
        return ExitSuccess();
    end;
end module body.
