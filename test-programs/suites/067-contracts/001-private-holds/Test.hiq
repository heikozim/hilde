module body Test is
    function half(n: Nat32): Nat32
        requires (n > 0) and (n < 100)
        ensures ((result * 2) <= n) and (((result * 2) + 1) >= n)
    is
        return n / 2;
    end;

    function main(): ExitCode is
        printLn(half(7));
        printLn(half(10));
        return ExitSuccess();
    end;
end module body.
