module body Test is
    record Box: Linear is
        value: Nat32;
    end;

    generic [R: Region]
    function peek(box: &[Box, R]): Nat32 is
        return box->value;
    end;

    function make(n: Nat32): Box
        ensures peek(&result) = n
    is
        return Box(value => n);
    end;

    function open(box: Box): Nat32 is
        let { value: Nat32 } := box;
        return value;
    end;

    function main(): ExitCode is
        printLn(open(make(5)));
        return ExitSuccess();
    end;
end module body.
