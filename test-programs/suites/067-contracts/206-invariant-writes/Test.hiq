module body Test is
    record Counter: Linear is
        count: Nat32;
    end;

    generic [R: Region]
    function bump(counter: &![Counter, R]): Nat32 is
        counter->count := counter->count + 1;
        return counter->count;
    end;

    function countedTwice(n: Nat32): Nat32 is
        var c: Counter := Counter(count => n);
        let first: Nat32 := bump(&!c);
        let { count: Nat32 } := c;
        return first + count;
    end;

    record Box: Free is
        size: Nat32;
        invariant countedTwice(size) > 0;
    end;

    function make(): Box is
        return Box(size => 3);
    end;

    function main(): ExitCode is
        let b: Box := make();
        printLn(b.size);
        return ExitSuccess();
    end;
end module body.
