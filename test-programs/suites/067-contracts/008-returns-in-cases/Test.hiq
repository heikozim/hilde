module body Test is
    function score(n: Nat32): Nat32
        ensures result < 100
    is
        case n of
            when 1 | 2 do
                return 10;
            when 3 do
                return 30;
            when _ do
                if n > 50 then
                    return n * 2;
                end if;
                return n;
        end case;
    end;

    function main(): ExitCode is
        printLn(score(1));
        printLn(score(2));
        printLn(score(3));
        printLn(score(40));
        printLn(score(60));
        return ExitSuccess();
    end;
end module body.
