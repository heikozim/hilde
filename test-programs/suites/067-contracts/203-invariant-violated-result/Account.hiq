module body Account is
    record Account: Linear is
        balance: Nat64;
        limit: Nat64;
        invariant balance <= limit;
    end;

    function open(amount: Nat64, limit: Nat64): Account is
        return Account(balance => amount, limit => limit);
    end;

    generic [R: Region]
    function balance(account: &[Account, R]): Nat64 is
        return account->balance;
    end;

    generic [R: Region]
    function deposit(account: &![Account, R], amount: Nat64): Unit is
        account->balance := account->balance + amount;
        return nil;
    end;

    function close(account: Account): Nat64 is
        let { balance as amount: Nat64, limit as ceiling: Nat64 } := account;
        return amount;
    end;
end module body.
