import Account (
    Account,
    open,
    balance,
    deposit,
    close
);

module body Test is
    function main(): ExitCode is
        var a: Account := open(10, 100);
        deposit(&!a, 50);
        printLn(balance(&a));
        deposit(&!a, 30);
        printLn(close(a));
        return ExitSuccess();
    end;
end module body.
