module body Test is
    function loud(n: Int32): Int32 is
        printLn(n);
        return n;
    end;

    function positive(n: Int32): Int32
        requires loud(n) > 0
    is
        return n;
    end;

    function main(): ExitCode is
        printLn(positive(5));
        return ExitSuccess();
    end;
end module body.
