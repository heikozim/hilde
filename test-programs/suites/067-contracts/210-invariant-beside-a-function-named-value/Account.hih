module Account is
    type Account: Linear;

    function open(amount: Nat64, limit: Nat64): Account;

    generic [R: Region]
    function balance(account: &[Account, R]): Nat64;

    generic [R: Region]
    function deposit(account: &![Account, R], amount: Nat64): Unit;

    generic [R: Region]
    function value(account: &[Account, R]): Nat64;

    function close(account: Account): Nat64;
end module.
