import Account (
    Account,
    tryOpen,
    openChecked,
    balance,
    close
);

module body Test is
    function main(): ExitCode is
        case tryOpen(10, 100) of
            when Some(value as a: Account) do
                print("some ");
                printLn(close(a));
            when None do
                printLn("none");
        end case;
        case tryOpen(200, 100) of
            when Some(value as a: Account) do
                print("some ");
                printLn(close(a));
            when None do
                printLn("none");
        end case;
        case openChecked(20, 100) of
            when Right(right as a: Account) do
                print("right ");
                printLn(close(a));
            when Left(left as refused: Nat64) do
                print("left ");
                printLn(refused);
        end case;
        case openChecked(300, 100) of
            when Right(right as a: Account) do
                print("right ");
                printLn(close(a));
            when Left(left as refused: Nat64) do
                print("left ");
                printLn(refused);
        end case;
        return ExitSuccess();
    end;
end module body.
