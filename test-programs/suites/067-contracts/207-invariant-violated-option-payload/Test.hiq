import Account (
    Account,
    tryOpen,
    close
);

module body Test is
    function main(): ExitCode is
        case tryOpen(200, 100) of
            when Some(value as a: Account) do
                printLn(close(a));
            when None do
                printLn("none");
        end case;
        return ExitSuccess();
    end;
end module body.
