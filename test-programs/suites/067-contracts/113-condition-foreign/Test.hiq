pragma Unsafe_Module;

module body Test is
    pragma Foreign_Import(External_Name => "abs");
    function cAbs(value: Int32): Int32 is
    end;

    function positive(n: Int32): Int32
        requires cAbs(n) > 0
    is
        return n;
    end;

    function main(): ExitCode is
        printLn(positive(5));
        return ExitSuccess();
    end;
end module body.
