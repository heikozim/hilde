module body Test is
    function isSmall(n: Nat32): Bool
        requires n < 1000
    is
        return n < 10;
    end;

    function half(n: Nat32): Nat32
        requires isSmall(n)
    is
        return n / 2;
    end;

    function main(): ExitCode is
        printLn(half(8));
        printLn(half(5000));
        return ExitSuccess();
    end;
end module body.
