module body Test is
    record Counter: Linear is
        count: Nat32;
    end;

    generic [R: Region]
    function peek(counter: &[Counter, R]): Nat32 is
        return counter->count;
    end;

    generic [R: Region]
    function bump(counter: &![Counter, R]): Unit
        requires peek(&counter) < 3
        ensures peek(&counter) = (old(peek(&counter)) + 1)
    is
        counter->count := counter->count + 1;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 0);
        bump(&!c);
        bump(&!c);
        bump(&!c);
        printLn(peek(&c));
        bump(&!c);
        let { count: Nat32 } := c;
        printLn(count);
        return ExitSuccess();
    end;
end module body.
