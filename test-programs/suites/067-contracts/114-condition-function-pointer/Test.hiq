module body Test is
    function double(n: Nat32): Nat32 is
        return n * 2;
    end;

    function apply(f: Fn[Nat32, Nat32], n: Nat32): Nat32
        requires f(n) > 0
    is
        return f(n);
    end;

    function main(): ExitCode is
        printLn(apply(double, 4));
        return ExitSuccess();
    end;
end module body.
