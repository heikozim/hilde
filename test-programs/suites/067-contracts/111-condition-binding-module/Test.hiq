import Standard.Resource (
    Resource,
    OpenFiles,
    Limit,
    readLimit
);

module body Test is
    function hasLimit(): Bool is
        case readLimit(OpenFiles()) of
            when Some(value as limit: Limit) do
                return limit.soft <= limit.hard;
            when None do
                return false;
        end case;
    end;

    function half(n: Nat32): Nat32
        requires hasLimit()
    is
        return n / 2;
    end;

    function main(): ExitCode is
        printLn(half(8));
        return ExitSuccess();
    end;
end module body.
