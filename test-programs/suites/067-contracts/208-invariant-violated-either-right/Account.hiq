module body Account is
    record Account: Linear is
        balance: Nat64;
        limit: Nat64;
        invariant balance <= limit;
    end;

    function tryOpen(amount: Nat64, limit: Nat64): Option[Account] is
        if amount > limit then
            return None();
        end if;
        return Some(value => Account(balance => amount, limit => limit));
    end;

    function openChecked(amount: Nat64, limit: Nat64): Either[Nat64, Account] is
        return Right(right => Account(balance => amount, limit => limit));
    end;

    generic [R: Region]
    function balance(account: &[Account, R]): Nat64 is
        return account->balance;
    end;

    function close(account: Account): Nat64 is
        let { balance as amount: Nat64, limit as ceiling: Nat64 } := account;
        return amount;
    end;
end module body.
