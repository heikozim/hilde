import Account (
    Account,
    openChecked,
    close
);

module body Test is
    function main(): ExitCode is
        case openChecked(200, 100) of
            when Right(right as a: Account) do
                printLn(close(a));
            when Left(left as refused: Nat64) do
                printLn(refused);
        end case;
        return ExitSuccess();
    end;
end module body.
