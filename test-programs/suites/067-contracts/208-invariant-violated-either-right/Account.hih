module Account is
    type Account: Linear;

    function tryOpen(amount: Nat64, limit: Nat64): Option[Account];

    function openChecked(amount: Nat64, limit: Nat64): Either[Nat64, Account];

    generic [R: Region]
    function balance(account: &[Account, R]): Nat64;

    function close(account: Account): Nat64;
end module.
