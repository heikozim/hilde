module body Test is
    generic [T: Free]
    function pick(first: T, second: T, takeFirst: Bool, limit: Nat32): T
        requires limit > 0
    is
        if takeFirst then
            return first;
        end if;
        return second;
    end;

    function main(): ExitCode is
        let a: Nat32 := 7;
        let b: Nat32 := 8;
        printLn(pick(first => a, second => b, takeFirst => false, limit => 3));
        printLn(pick(first => a, second => b, takeFirst => true, limit => 0));
        return ExitSuccess();
    end;
end module body.
