import Bank (
    Account,
    open,
    balance,
    withdraw,
    close
);

module body Test is
    function main(): ExitCode is
        var a: Account := open(100);
        withdraw(&!a, 30);
        printLn(balance(&a));
        withdraw(&!a, 71);
        printLn(close(a));
        return ExitSuccess();
    end;
end module body.
