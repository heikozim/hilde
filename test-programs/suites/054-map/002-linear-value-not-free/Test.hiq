import Standard.Tuples (
    Pair
);
import Standard.String (
    String,
    fromLiteral
);
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyFree,
    put
);

module body Test is
    -- A map of Strings dropped whole with destroyFree: the Strings would be
    -- lost, and String is linear, so it must not compile.
    function main(): ExitCode is
        var m: Map[Int32, String] := makeMap();
        case put(&!m, 1, fromLiteral("one")) of
            when Some(value as old: Pair[Int32, String]) do
                abort("not reached");
            when None do
                skip;
        end case;
        destroyFree(m);
        return ExitSuccess();
    end;
end module body.
