import Standard.Tuples (
    Pair
);
import Standard.String (
    String,
    fromLiteral,
    makeString,
    destroyString,
    length as stringLength,
    nthByte,
    storeNth,
    getSpan
);
-- The instance TotalOrder(String) lives in Standard.Order; a module sees
-- an instance only through an import from the module that holds it.
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyEmpty,
    size,
    getMut,
    put,
    replaceValue,
    keyAt,
    valueAt,
    removeAt
);

module body Test is
    generic [R: Region]
    function slice(s: &[String, R], start: Index, stop: Index): String is
        var out: String := makeString(stop - start, 0);
        if stop > start then
            for i from start to stop - 1 do
                storeNth(&!out, i - start, nthByte(s, i));
            end for;
        end if;
        return out;
    end;

    -- One more of word, through a write borrow: read with getMut, raised
    -- with replaceValue, or put when it is new.
    generic [R: Region]
    function count(m: &![Map[String, Index], R], word: String): Unit is
        case getMut(&~m, &word) of
            when Some(value as c: Index) do
                case replaceValue(&~m, &word, c + 1) of
                    when Right(right as old: Index) do
                        skip;
                    when Left(left as back: Index) do
                        skip;
                end case;
                destroyString(word);
            when None do
                let one: Index := 1;
                case put(&~m, word, one) of
                    when Some(value as old: Pair[String, Index]) do
                        let { first: String, second: Index } := old;
                        destroyString(first);
                    when None do
                        skip;
                end case;
        end case;
        return nil;
    end;

    -- The key and the value at k, in the order of the keys.
    generic [R: Region]
    function printEntry(m: &[Map[String, Index], R], k: Index): Unit is
        let word: &[String, R] := keyAt(m, k);
        print(getSpan(word, 0, stringLength(word) - 1));
        print(" ");
        printLn(!valueAt(m, k));
        return nil;
    end;

    function main(): ExitCode is
        let text: String := fromLiteral("the cat and the dog and the bird");
        var m: Map[String, Index] := makeMap();
        let n: Index := stringLength(&text);
        var start: Index := 0;
        for i from 0 to n - 1 do
            if nthByte(&text, i) = ' ' then
                if i > start then
                    count(&!m, slice(&text, start, i));
                end if;
                start := i + 1;
            end if;
        end for;
        if n > start then
            count(&!m, slice(&text, start, n));
        end if;
        destroyString(text);
        print("distinct words: ");
        printLn(size(&m));
        for k from 0 to size(&m) - 1 do
            printEntry(&m, k);
        end for;
        while size(&m) > 0 do
            let { first: String, second: Index } := removeAt(&!m, 0);
            destroyString(first);
        end while;
        destroyEmpty(m);
        return ExitSuccess();
    end;
end module body.
