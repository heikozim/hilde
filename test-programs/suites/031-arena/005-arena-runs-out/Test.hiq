import Standard.Arena (
    Arena,
    createArena,
    arenaAllocate,
    freeArena
);

module body Test is
    record Cell: Free is
        n: Int32;
    end;

    -- A ceiling, so that a defect in the budget cannot hang the suite: an
    -- arena of one page can never hand out this many, so reaching it is a
    -- failure and prints 0.
    constant ceiling: Int32 := 100000;

    -- A case binding is immutable, so value->n := 1; in the branch is
    -- refused with "Cannot borrow the variable value mutably".  A write
    -- through a returned reference goes through a function parameter --
    -- the shape standard/src/Buffer.hiq:285 uses.
    generic [R: Region]
    function poke(cell: &![Cell, R]): Unit is
        cell->n := 1;
        return nil;
    end;

    function openArena(): Arena is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value: Arena) do
                return value;
            when None do
                abort("Arena creation failed.");
        end case;
    end;

    function main(): ExitCode is
        var arena: Arena := openArena();
        var count: Int32 := 0;
        var going: Bool := true;
        while going do
            borrow r: &![Arena, R] := &!arena do
                let slot: Option[&![Cell, R]] := arenaAllocate(r);
                case slot of
                    when Some(value: &![Cell, R]) do
                        poke(value);
                        count := count + 1;
                    when None do
                        going := false;
                end case;
            end borrow;
            if count = ceiling then
                going := false;
            end if;
        end while;
        -- The arena handed something out ...
        if count > 0 then
            printLn(1);
        else
            printLn(0);
        end if;
        -- ... and it ran out rather than growing for ever.
        if count < ceiling then
            printLn(1);
        else
            printLn(0);
        end if;
        freeArena(arena);
        return ExitSuccess();
    end;
end module body.
