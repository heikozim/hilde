import Standard.Arena (
    Arena,
    createArena,
    arenaAllocate,
    arenaUsed,
    resetArena,
    freeArena
);

module body Test is
    record Cell: Free is
        value: Int32;
    end;

    -- A write reference is linear: it is consumed by the first use, so
    -- filling and reading back happen in one function and not in two.
    generic [R: Region]
    function fillAndShow(cell: &![Cell, R], v: Int32): Unit is
        cell->value := v;
        printLn(cell->value);
        return nil;
    end;

    function useOnce(arena: Arena, v: Int32): Arena is
        var a: Arena := arena;
        borrow r: &![Arena, R] := &!a do
            let slot: Option[&![Cell, R]] := arenaAllocate(r);
            case slot of
                when Some(value: &![Cell, R]) do
                    fillAndShow(value, v);
                when None do
                    printLn(0);
            end case;
        end borrow;
        return a;
    end;

    function main(): ExitCode is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value: Arena) do
                var arena: Arena := value;
                arena := useOnce(arena, 7);
                borrow r: &[Arena, R] := &arena do
                    printLn(arenaUsed(r));
                end borrow;
                arena := resetArena(arena);
                borrow r2: &[Arena, R] := &arena do
                    printLn(arenaUsed(r2));
                end borrow;
                arena := useOnce(arena, 9);
                freeArena(arena);
            when None do
                printLn(0);
        end case;
        return ExitSuccess();
    end;
end module body.
