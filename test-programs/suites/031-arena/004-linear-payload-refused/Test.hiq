import Standard.Arena (
    Arena,
    createArena,
    arenaAllocate,
    freeArena
);

module body Test is
    -- A resource whose release does more than give memory back: it is
    -- Linear, so it has to be consumed by name.  resetArena drops the
    -- whole region at once and would skip that close, which is why
    -- arenaAllocate constrains its payload to Free.
    record Handle: Linear is
        n: Int32;
    end;

    -- A case binding is immutable, so value->n := 1; in the branch is
    -- refused with "Cannot borrow the variable value mutably".  A write
    -- through a returned reference goes through a function parameter --
    -- the shape standard/src/Buffer.hiq:285 uses.
    generic [R: Region]
    function poke(cell: &![Handle, R]): Unit is
        cell->n := 1;
        return nil;
    end;

    function openArena(): Arena is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value: Arena) do
                return value;
            when None do
                abort("Arena creation failed.");
        end case;
    end;

    function main(): ExitCode is
        var arena: Arena := openArena();
        borrow r: &![Arena, R] := &!arena do
            let slot: Option[&![Handle, R]] := arenaAllocate(r);
            case slot of
                when Some(value: &![Handle, R]) do
                    poke(value);
                when None do
                    printLn(0);
            end case;
        end borrow;
        freeArena(arena);
        return ExitSuccess();
    end;
end module body.
