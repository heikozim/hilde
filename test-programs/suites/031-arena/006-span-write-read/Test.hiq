import Standard.Arena (
    Arena,
    createArena,
    arenaSpan,
    arenaUsed,
    resetArena,
    freeArena
);

module body Test is
    -- The sum of what the span holds, then 1 to n written into it, then the
    -- sum read back through it: 0 and n(n+1)/2.  Printed, both.  n is
    -- handed in: a writable span is Linear, and asking it its length would
    -- consume it.
    generic [R: Region]
    function zeroThenFill(span: Span![Int32, R], n: Index): Unit is
        var sp: Span![Int32, R] := span;
        var before: Int32 := 0;
        for i from 0 to n - 1 do
            before := before + sp[i];
        end for;
        printLn(before);
        var k: Int32 := 1;
        for i from 0 to n - 1 do
            sp[i] := k;
            k := k + 1;
        end for;
        var after: Int32 := 0;
        for i from 0 to n - 1 do
            after := after + sp[i];
        end for;
        printLn(after);
        return nil;
    end;

    -- Ten Int32 from the arena: 0, then 55.
    function ten(arena: Arena): Arena is
        var a: Arena := arena;
        borrow r: &![Arena, R] := &!a do
            let got: Option[Span![Int32, R]] := arenaSpan(r, 10);
            case got of
                when Some(value as sp: Span![Int32, R]) do
                    zeroThenFill(sp, 10);
                when None do
                    printLn(-9);
            end case;
        end borrow;
        return a;
    end;

    function used(arena: Arena): Arena is
        var a: Arena := arena;
        borrow r: &[Arena, R] := &a do
            printLn(arenaUsed(r));
        end borrow;
        return a;
    end;

    -- None for a count of 0, prints -1.
    function none(arena: Arena): Arena is
        var a: Arena := arena;
        borrow r: &![Arena, R] := &!a do
            let got: Option[Span![Nat8, R]] := arenaSpan(r, 0);
            case got of
                when Some(value as sp: Span![Nat8, R]) do
                    printLn(spanWriteLength(sp));
                when None do
                    printLn(-1);
            end case;
        end borrow;
        return a;
    end;

    -- None for more than the block holds, prints -2.
    function tooMany(arena: Arena): Arena is
        var a: Arena := arena;
        borrow r: &![Arena, R] := &!a do
            let got: Option[Span![Nat8, R]] := arenaSpan(r, 5000);
            case got of
                when Some(value as sp: Span![Nat8, R]) do
                    printLn(spanWriteLength(sp));
                when None do
                    printLn(-2);
            end case;
        end borrow;
        return a;
    end;

    -- None when count * 8 wraps: 2^61 Int64 values are 2^64 bytes,
    -- which is 0 in a 64-bit Index.  Prints -3; a check that multiplied
    -- without looking would hand out a span of 2^61 over an empty piece.
    function wraps(arena: Arena): Arena is
        var a: Arena := arena;
        let huge: Index := 2305843009213693952;
        borrow r: &![Arena, R] := &!a do
            let got: Option[Span![Int64, R]] := arenaSpan(r, huge);
            case got of
                when Some(value as sp: Span![Int64, R]) do
                    printLn(spanWriteLength(sp));
                when None do
                    printLn(-3);
            end case;
        end borrow;
        return a;
    end;

    -- A span of the arena -- written, read back, the
    -- bytes zero when handed out, used counting them, the refusals, and
    -- after a reset the same place zero again (the reset overwrote it).
    function main(): ExitCode is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value: Arena) do
                var arena: Arena := value;
                arena := ten(arena);
                arena := used(arena);
                arena := none(arena);
                arena := tooMany(arena);
                arena := wraps(arena);
                arena := resetArena(arena);
                arena := used(arena);
                arena := ten(arena);
                freeArena(arena);
            when None do
                printLn(0);
        end case;
        return ExitSuccess();
    end;
end module body.
