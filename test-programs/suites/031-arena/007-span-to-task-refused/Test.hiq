import Standard.Arena (
    Arena,
    createArena,
    arenaSpan,
    freeArena
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    generic [R: Region]
    function first(span: Span![Int32, R]): Int32 is
        return span[0];
    end;

    -- must not compile: a span of an arena handed to a task.  The task
    -- could run after the borrow the span comes from has ended -- and
    -- after the arena was freed -- so the span is refused exactly as a
    -- reference is (H3002).  Arena memory reaches another task only by a
    -- copy.
    function main(): ExitCode is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value: Arena) do
                var arena: Arena := value;
                case openScope() of
                    when Some(value as opened: Scope) do
                        var scope: Scope := opened;
                        borrow r: &![Arena, R] := &!arena do
                            let got: Option[Span![Int32, R]] := arenaSpan(r, 4);
                            case got of
                                when Some(value as sp: Span![Int32, R]) do
                                    let work: Fn[Span![Int32, R], Int32] := first;
                                    case spawn(&!scope, work, sp) of
                                        when Right(right as task: Task[Int32]) do
                                            printLn(join(task));
                                        when Left(left as back: Span![Int32, R]) do
                                            printLn(-1);
                                    end case;
                                when None do
                                    printLn(-2);
                            end case;
                        end borrow;
                        closeScope(scope);
                    when None do
                        printLn(-3);
                end case;
                freeArena(arena);
            when None do
                printLn(0);
        end case;
        return ExitSuccess();
    end;
end module body.
