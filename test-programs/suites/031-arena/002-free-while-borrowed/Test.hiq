import Standard.Arena (
    Arena,
    createArena,
    arenaAllocate,
    freeArena
);

module body Test is
    record Cell: Free is
        n: Int32;
    end;

    -- A case binding must carry the slot's own name, so the two Options of
    -- this programme are unwrapped in two different functions rather than
    -- nested, where the second value would shadow the first.
    -- A case binding is immutable, so value->n := 1; in the branch is
    -- refused with "Cannot borrow the variable value mutably".  A write
    -- through a returned reference goes through a function parameter --
    -- the shape standard/src/Buffer.hiq:285 uses.
    generic [R: Region]
    function poke(cell: &![Cell, R]): Unit is
        cell->n := 1;
        return nil;
    end;

    function openArena(): Arena is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value: Arena) do
                return value;
            when None do
                abort("Arena creation failed.");
        end case;
    end;

    function main(): ExitCode is
        var arena: Arena := openArena();
        borrow r: &![Arena, R] := &!arena do
            let slot: Option[&![Cell, R]] := arenaAllocate(r);
            -- The arena is borrowed right here, and a reference into it is
            -- alive.  Freeing it now is exactly the use after free the
            -- point asks to be refused.
            freeArena(arena);
            case slot of
                when Some(value: &![Cell, R]) do
                    poke(value);
                when None do
                    printLn(0);
            end case;
        end borrow;
        return ExitSuccess();
    end;
end module body.
