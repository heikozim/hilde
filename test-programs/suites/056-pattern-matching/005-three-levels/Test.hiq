-- Pattern matching: patterns three levels deep through Free unions, _ on a Free
-- place, and a when with alternatives at depth.
module body Test is
    union Leaf: Free is
        case A;
        case B;
        case N is
            n: Int32;
    end;

    union Mid: Free is
        case M1 is
            l: Leaf;
        case M2 is
            l: Leaf;
            k: Int32;
    end;

    union Top: Free is
        case T1 is
            m: Mid;
        case T2;
    end;

    function f(t: Top): Int32 is
        case t of
            when T1(M1(A)) | T1(M2(A, _)) do
                return 1;
            when T1(M1(N(7))) do
                return 2;
            when T1(M1(N(n))) | T1(M2(N(n), 0)) do
                return n;
            when T1(M1(B)) do
                return 3;
            when T1(M2(l, k)) do
                return k;
            when T2 do
                return 4;
        end case;
    end;

    function main(): ExitCode is
        let seven: Int32 := 7;
        let eight: Int32 := 8;
        let zero: Int32 := 0;
        let nine: Int32 := 9;
        printLn(f(T1(m => M1(l => A()))));
        printLn(f(T1(m => M2(l => A(), k => nine))));
        printLn(f(T1(m => M1(l => N(n => seven)))));
        printLn(f(T1(m => M1(l => N(n => eight)))));
        printLn(f(T1(m => M2(l => N(n => eight), k => zero))));
        printLn(f(T1(m => M1(l => B()))));
        printLn(f(T1(m => M2(l => B(), k => nine))));
        printLn(f(T2()));
        return ExitSuccess();
    end;
end module body.
