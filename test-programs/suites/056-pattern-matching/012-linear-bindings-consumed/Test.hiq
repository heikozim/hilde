import Standard.Box (
    Box,
    makeBox,
    unbox
);

-- Pattern matching: every linear value a pattern binds is
-- consumed by the body, in every alternative, and the body may hand it
-- on.  The programme gives back every box it made.
module body Test is
    union Expr: Linear is
        case Int is
            value: Int64;
        case Neg is
            inner: Box[Expr];
        case Add is
            left: Box[Expr];
            right: Box[Expr];
    end;

    function boxed(e: Expr): Box[Expr] is
        case makeBox(e) of
            when Right(right as b: Box[Expr]) do
                return b;
            when Left(left as back: Expr) do
                abort("no memory for a box");
                return boxed(back);
        end case;
    end;

    function eval(e: Expr): Int64 is
        case e of
            when Int(v) do
                return v;
            when Neg(x) do
                let zero: Int64 := 0;
                return zero - eval(unbox(x));
            when Add(l, r) do
                let a: Int64 := eval(unbox(l));
                return a + eval(unbox(r));
        end case;
    end;

    function lit(v: Int64): Expr is
        return Int(value => v);
    end;

    function keep(b: Box[Expr]): Box[Expr] is
        return b;
    end;

    function f(e: Expr): Int64 is
        case e of
            when Neg(Neg(x)) | Add(Int(0), x) do
                let y: Box[Expr] := keep(x);
                return eval(unbox(y));
            when Neg(x) do
                let zero: Int64 := 0;
                return zero - eval(unbox(x));
            when Add(l, r) do
                let a: Int64 := eval(unbox(r));
                return a + eval(unbox(l));
            when Int(v) do
                return v;
        end case;
    end;

    function main(): ExitCode is
        let zero: Int64 := 0;
        let four: Int64 := 4;
        printLn(f(Neg(inner => boxed(Neg(inner => boxed(lit(four)))))));
        printLn(f(Add(left => boxed(lit(zero)), right => boxed(lit(four)))));
        printLn(f(Neg(inner => boxed(lit(four)))));
        return ExitSuccess();
    end;
end module body.
