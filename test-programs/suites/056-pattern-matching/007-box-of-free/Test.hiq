import Standard.Box (
    Box,
    makeBox,
    unbox
);

-- Pattern matching: a literal looks through a box of a Free type; a
-- variable binds the box itself, which the body then gives back.
module body Test is
    union Cell: Linear is
        case Full is
            b: Box[Int64];
        case Empty;
    end;

    function boxed(v: Int64): Box[Int64] is
        case makeBox(v) of
            when Right(right as b: Box[Int64]) do
                return b;
            when Left(left as back: Int64) do
                abort("no memory for a box");
                return boxed(back);
        end case;
    end;

    function f(c: Cell): Int64 is
        case c of
            when Full(0) do
                return 1000;
            when Full(b) do
                return unbox(b);
            when Empty do
                return -1;
        end case;
    end;

    function main(): ExitCode is
        let zero: Int64 := 0;
        let six: Int64 := 6;
        printLn(f(Full(b => boxed(zero))));
        printLn(f(Full(b => boxed(six))));
        printLn(f(Empty()));
        return ExitSuccess();
    end;
end module body.
