-- A case over integers is a switch: the last when of a
-- switch, its default, leaves a linear value that the arms consume.
module body Test is
    record Token: Linear is
        id: Int32;
    end;

    function spend(t: Token): Int32 is
        let { id: Int32 } := t;
        return id;
    end;

    function main(): ExitCode is
        let t: Token := Token(id => 7);
        let code: Nat8 := 1;
        var r: Int32 := 0;
        case code of
            when 0 do
                r := spend(t);
            when 1 .. 9 do
                r := spend(t);
            when n do
                r := 2;
        end case;
        printLn(r);
        return ExitSuccess();
    end;
end module body.
