-- A range two earlier ranges cover together.
module body Test is
    function main(): ExitCode is
        let x: Int32 := 5;
        case x of
            when 0 .. 5 do
                skip;
            when 6 .. 10 do
                skip;
            when 2 .. 8 do
                skip;
            when _ do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
