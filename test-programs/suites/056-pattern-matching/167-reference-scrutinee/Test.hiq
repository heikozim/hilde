-- A case with patterns over a reference.
module body Test is
    union Shape: Free is
        case Dot;
        case Circle is
            r: Int32;
        case Rect is
            w: Int32;
            h: Int32;
    end;

    function main(): ExitCode is
        let s: Shape := Dot();
        case &s of
            when Dot do
                skip;
            when Circle(r) do
                skip;
            when Rect(w, h) do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
