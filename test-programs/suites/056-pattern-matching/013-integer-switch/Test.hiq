-- A case over integers is a switch: a case over an integer
-- whose whens before the last have only literals and ranges is a switch.
-- A dispatch on fourteen codes, alternatives in one when, ranges that
-- overlap in part, a last when that binds the value, a last when that is
-- a range and closes the type, the ends of the widest types, a case in a
-- loop, and a case whose ranges are too wide for a switch and stay an if
-- chain.  Every value takes the when it would take in an if chain.
module body Test is
    function name(code: Int32): Span[Nat8, Static] is
        case code of
            when 0 do
                return "ok";
            when 1 do
                return "usage";
            when 2 do
                return "missing";
            when 3 do
                return "unknown";
            when 4 do
                return "twice";
            when 5 do
                return "value";
            when 6 do
                return "range";
            when 7 do
                return "file";
            when 8 do
                return "read";
            when 9 do
                return "write";
            when 10 do
                return "parse";
            when 11 do
                return "limit";
            when 12 do
                return "time";
            when 13 do
                return "other";
            when n do
                return "outside";
        end case;
    end;

    function overlap(v: Nat8): Int32 is
        case v of
            when 0 .. 9 do
                return 1;
            when 5 .. 20 | 30 do
                return 2;
            when 25 | 21 .. 26 do
                return 3;
            when n do
                let w: Int32 := 100;
                return w;
        end case;
    end;

    function half(v: Nat8): Int32 is
        case v of
            when 0 .. 127 do
                return 0;
            when 128 .. 255 do
                return 1;
        end case;
    end;

    function wide(v: Int64): Int32 is
        case v of
            when -9223372036854775808 do
                return -2;
            when -1 do
                return -1;
            when 9223372036854775807 do
                return 2;
            when _ do
                return 0;
        end case;
    end;

    function widest(v: Nat64): Int32 is
        case v of
            when 18446744073709551615 do
                return 1;
            when 0 do
                return -1;
            when _ do
                return 0;
        end case;
    end;

    function chain(v: Int32): Int32 is
        case v of
            when 0 .. 5000 do
                return 1;
            when -5000 .. -1 do
                return -1;
            when _ do
                return 0;
        end case;
    end;

    function count(): Int32 is
        var total: Int32 := 0;
        var i: Int32 := 0;
        while i < 20 do
            case i of
                when 0 | 2 | 4 | 6 | 8 do
                    total := total + 1;
                when 1 .. 9 do
                    total := total + 10;
                when _ do
                    total := total + 100;
            end case;
            i := i + 1;
        end while;
        return total;
    end;

    function main(): ExitCode is
        let codes: Int32 := 0;
        printLn(name(codes));
        printLn(name(7));
        printLn(name(13));
        printLn(name(14));
        printLn(name(-1));
        printLn(overlap(3));
        printLn(overlap(9));
        printLn(overlap(10));
        printLn(overlap(20));
        printLn(overlap(21));
        printLn(overlap(25));
        printLn(overlap(26));
        printLn(overlap(30));
        printLn(overlap(31));
        printLn(half(127));
        printLn(half(128));
        printLn(wide(-9223372036854775808));
        printLn(wide(-1));
        printLn(wide(9223372036854775807));
        printLn(wide(5));
        printLn(widest(18446744073709551615));
        printLn(widest(0));
        printLn(widest(7));
        printLn(chain(5000));
        printLn(chain(-5000));
        printLn(chain(5001));
        printLn(count());
        return ExitSuccess();
    end;
end module body.
