-- Pattern matching: a range that an earlier one covers only in part is
-- reachable -- by the values the earlier one leaves -- and a later range
-- takes only those.
module body Test is
    function f(v: Nat8): Int32 is
        case v of
            when 0 .. 10 do
                return 1;
            when 5 .. 20 do
                return 2;
            when 0 .. 255 do
                return 3;
        end case;
    end;

    function main(): ExitCode is
        let a: Nat8 := 7;
        let b: Nat8 := 15;
        let c: Nat8 := 21;
        printLn(f(a));
        printLn(f(b));
        printLn(f(c));
        return ExitSuccess();
    end;
end module body.
