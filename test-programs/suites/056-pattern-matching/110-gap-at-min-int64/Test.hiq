-- Int64: every value but the smallest, -9223372036854775808.
module body Test is
    function main(): ExitCode is
        let x: Int64 := -9223372036854775807;
        case x of
            when -9223372036854775807 .. 9223372036854775807 do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
