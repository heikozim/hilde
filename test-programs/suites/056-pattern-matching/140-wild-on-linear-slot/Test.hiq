-- _ on a box, which is linear: the box would be dropped unconsumed.
import Standard.Box (
    Box,
    makeBox,
    unbox
);

module body Test is
    union Expr: Linear is
        case Int is
            value: Int64;
        case Neg is
            inner: Box[Expr];
        case Add is
            left: Box[Expr];
            right: Box[Expr];
    end;

    function boxed(e: Expr): Box[Expr] is
        case makeBox(e) of
            when Right(right as b: Box[Expr]) do
                return b;
            when Left(left as back: Expr) do
                abort("no memory for a box");
                return boxed(back);
        end case;
    end;

    function eval(e: Expr): Int64 is
        case e of
            when Int(v) do
                return v;
            when Neg(x) do
                let zero: Int64 := 0;
                return zero - eval(unbox(x));
            when Add(l, r) do
                let a: Int64 := eval(unbox(l));
                return a + eval(unbox(r));
        end case;
    end;

    function f(e: Expr): Int64 is
        case e of
            when Int(v) do
                return v;
            when Neg(_) do
                return 0;
            when Add(l, r) do
                return eval(unbox(l)) + eval(unbox(r));
        end case;
    end;

    function main(): ExitCode is
        let one: Int64 := 1;
        printLn(f(Int(value => one)));
        return ExitSuccess();
    end;
end module body.
