-- A case over integers is a switch: the linearity check
-- holds for a switch as for any case.  A linear value made before the case
-- is consumed in every arm, the default too, in arms that return and in
-- arms that go on after the case.
module body Test is
    record Token: Linear is
        id: Int32;
    end;

    function spend(t: Token): Int32 is
        let { id: Int32 } := t;
        return id;
    end;

    function pick(code: Nat8): Int32 is
        let t: Token := Token(id => 7);
        var r: Int32 := 0;
        case code of
            when 0 do
                r := spend(t);
            when 1 | 2 do
                r := spend(t) + 1;
            when 3 .. 5 do
                return spend(t) + 2;
            when other do
                let k: Int32 := spend(t);
                r := k + 3;
        end case;
        return r;
    end;

    function main(): ExitCode is
        printLn(pick(0));
        printLn(pick(2));
        printLn(pick(4));
        printLn(pick(200));
        return ExitSuccess();
    end;
end module body.
