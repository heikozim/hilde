-- Pattern matching: a generic union of the Pervasive module, the type argument
-- applied to the slot.
module body Test is
    function f(o: Option[Int32]): Int32 is
        case o of
            when Some(0) do
                return 100;
            when Some(1 .. 9) do
                return 101;
            when Some(n) do
                return n;
            when None do
                return -1;
        end case;
    end;

    function main(): ExitCode is
        let zero: Int32 := 0;
        let five: Int32 := 5;
        let big: Int32 := 42;
        printLn(f(Some(value => zero)));
        printLn(f(Some(value => five)));
        printLn(f(Some(value => big)));
        let nothing: Option[Int32] := None();
        printLn(f(nothing));
        return ExitSuccess();
    end;
end module body.
