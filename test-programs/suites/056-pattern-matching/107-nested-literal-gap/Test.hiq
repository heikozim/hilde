-- A range inside a variant leaves exactly one value: Byte(128).
module body Test is
    union Code: Free is
        case Byte is
            b: Nat8;
        case Pair is
            x: Nat8;
            y: Nat8;
    end;

    function main(): ExitCode is
        let z: Nat8 := 0;
        let c: Code := Byte(b => z);
        case c of
            when Byte(0 .. 127) | Byte(129 .. 255) do
                skip;
            when Pair(x, y) do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
