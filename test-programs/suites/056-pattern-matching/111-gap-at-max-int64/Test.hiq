-- Int64: every value but the largest, 9223372036854775807.
module body Test is
    function main(): ExitCode is
        let x: Int64 := -9223372036854775808;
        case x of
            when -9223372036854775808 .. 9223372036854775806 do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
