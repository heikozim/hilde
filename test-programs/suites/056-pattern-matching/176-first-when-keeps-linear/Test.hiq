-- A case over integers is a switch: every branch of a
-- case is held to the one beside it.  The first when of this case over a
-- union keeps the linear value and the other two consume it; the check
-- compared the branches only in pairs before and let this through.
module body Test is
    record Token: Linear is
        id: Int32;
    end;

    union Shape: Free is
        case Dot;
        case Line;
        case Square;
    end;

    function spend(t: Token): Int32 is
        let { id: Int32 } := t;
        return id;
    end;

    function main(): ExitCode is
        let t: Token := Token(id => 7);
        let s: Shape := Square();
        var r: Int32 := 0;
        case s of
            when Dot do
                r := 3;
            when Line do
                r := spend(t);
            when Square do
                r := spend(t);
        end case;
        printLn(r);
        return ExitSuccess();
    end;
end module body.
