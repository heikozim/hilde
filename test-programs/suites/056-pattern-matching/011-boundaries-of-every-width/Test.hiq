-- Pattern matching: for every integer type the smallest and the
-- largest value are patterns, and two literals and a range between them
-- cover the type without a variable or _.
module body Test is
    function edgeNat8(v: Nat8): Int32 is
        case v of
            when 0 do
                return 1;
            when 255 do
                return 3;
            when 1 .. 254 do
                return 2;
        end case;
    end;

    function edgeNat16(v: Nat16): Int32 is
        case v of
            when 0 do
                return 1;
            when 65535 do
                return 3;
            when 1 .. 65534 do
                return 2;
        end case;
    end;

    function edgeNat32(v: Nat32): Int32 is
        case v of
            when 0 do
                return 1;
            when 4294967295 do
                return 3;
            when 1 .. 4294967294 do
                return 2;
        end case;
    end;

    function edgeNat64(v: Nat64): Int32 is
        case v of
            when 0 do
                return 1;
            when 18446744073709551615 do
                return 3;
            when 1 .. 18446744073709551614 do
                return 2;
        end case;
    end;

    function edgeInt8(v: Int8): Int32 is
        case v of
            when -128 do
                return 1;
            when 127 do
                return 3;
            when -127 .. 126 do
                return 2;
        end case;
    end;

    function edgeInt16(v: Int16): Int32 is
        case v of
            when -32768 do
                return 1;
            when 32767 do
                return 3;
            when -32767 .. 32766 do
                return 2;
        end case;
    end;

    function edgeInt32(v: Int32): Int32 is
        case v of
            when -2147483648 do
                return 1;
            when 2147483647 do
                return 3;
            when -2147483647 .. 2147483646 do
                return 2;
        end case;
    end;

    function edgeInt64(v: Int64): Int32 is
        case v of
            when -9223372036854775808 do
                return 1;
            when 9223372036854775807 do
                return 3;
            when -9223372036854775807 .. 9223372036854775806 do
                return 2;
        end case;
    end;

    function edgeIndex(v: Index): Int32 is
        case v of
            when 0 do
                return 1;
            when 18446744073709551615 do
                return 3;
            when 1 .. 18446744073709551614 do
                return 2;
        end case;
    end;

    function edgeByteSize(v: ByteSize): Int32 is
        case v of
            when 0 do
                return 1;
            when 18446744073709551615 do
                return 3;
            when 1 .. 18446744073709551614 do
                return 2;
        end case;
    end;

    function main(): ExitCode is
        let v0: Nat8 := 0;
        printLn(edgeNat8(v0));
        let v1: Nat8 := 1;
        printLn(edgeNat8(v1));
        let v2: Nat8 := 254;
        printLn(edgeNat8(v2));
        let v3: Nat8 := 255;
        printLn(edgeNat8(v3));
        let v4: Nat16 := 0;
        printLn(edgeNat16(v4));
        let v5: Nat16 := 1;
        printLn(edgeNat16(v5));
        let v6: Nat16 := 65534;
        printLn(edgeNat16(v6));
        let v7: Nat16 := 65535;
        printLn(edgeNat16(v7));
        let v8: Nat32 := 0;
        printLn(edgeNat32(v8));
        let v9: Nat32 := 1;
        printLn(edgeNat32(v9));
        let v10: Nat32 := 4294967294;
        printLn(edgeNat32(v10));
        let v11: Nat32 := 4294967295;
        printLn(edgeNat32(v11));
        let v12: Nat64 := 0;
        printLn(edgeNat64(v12));
        let v13: Nat64 := 1;
        printLn(edgeNat64(v13));
        let v14: Nat64 := 18446744073709551614;
        printLn(edgeNat64(v14));
        let v15: Nat64 := 18446744073709551615;
        printLn(edgeNat64(v15));
        let v16: Int8 := -128;
        printLn(edgeInt8(v16));
        let v17: Int8 := -127;
        printLn(edgeInt8(v17));
        let v18: Int8 := 126;
        printLn(edgeInt8(v18));
        let v19: Int8 := 127;
        printLn(edgeInt8(v19));
        let v20: Int16 := -32768;
        printLn(edgeInt16(v20));
        let v21: Int16 := -32767;
        printLn(edgeInt16(v21));
        let v22: Int16 := 32766;
        printLn(edgeInt16(v22));
        let v23: Int16 := 32767;
        printLn(edgeInt16(v23));
        let v24: Int32 := -2147483648;
        printLn(edgeInt32(v24));
        let v25: Int32 := -2147483647;
        printLn(edgeInt32(v25));
        let v26: Int32 := 2147483646;
        printLn(edgeInt32(v26));
        let v27: Int32 := 2147483647;
        printLn(edgeInt32(v27));
        let v28: Int64 := -9223372036854775808;
        printLn(edgeInt64(v28));
        let v29: Int64 := -9223372036854775807;
        printLn(edgeInt64(v29));
        let v30: Int64 := 9223372036854775806;
        printLn(edgeInt64(v30));
        let v31: Int64 := 9223372036854775807;
        printLn(edgeInt64(v31));
        let v32: Index := 0;
        printLn(edgeIndex(v32));
        let v33: Index := 1;
        printLn(edgeIndex(v33));
        let v34: Index := 18446744073709551614;
        printLn(edgeIndex(v34));
        let v35: Index := 18446744073709551615;
        printLn(edgeIndex(v35));
        let v36: ByteSize := 0;
        printLn(edgeByteSize(v36));
        let v37: ByteSize := 1;
        printLn(edgeByteSize(v37));
        let v38: ByteSize := 18446744073709551614;
        printLn(edgeByteSize(v38));
        let v39: ByteSize := 18446744073709551615;
        printLn(edgeByteSize(v39));
        return ExitSuccess();
    end;
end module body.
