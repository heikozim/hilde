-- The example of pattern matching, on a real
-- recursive, linear Expr whose children are boxes.  Add(Int(0), x) looks
-- through the left box, checks the Int without binding it, and binds the
-- right box to x; the Int it drops is one Int64, nothing linear.  Every box
-- the match looks through is freed by the match, every box bound to a
-- variable is unboxed by the body, so the programme leaks nothing under
-- AddressSanitizer.
import Standard.Box (
    Box,
    makeBox,
    unbox
);

module body Test is
    union Expr: Linear is
        case Int is
            value: Int64;
        case Neg is
            inner: Box[Expr];
        case Add is
            left: Box[Expr];
            right: Box[Expr];
    end;

    function boxed(e: Expr): Box[Expr] is
        case makeBox(e) of
            when Right(right as b: Box[Expr]) do
                return b;
            when Left(left as back: Expr) do
                abort("no memory for a box");
                return boxed(back);
        end case;
    end;

    function lit(v: Int64): Expr is
        return Int(value => v);
    end;

    function neg(e: Expr): Expr is
        return Neg(inner => boxed(e));
    end;

    function add(l: Expr, r: Expr): Expr is
        return Add(left => boxed(l), right => boxed(r));
    end;

    function simplify(e: Expr): Expr is
        case e of
            when Add(Int(0), x) | Add(x, Int(0)) do
                return simplify(unbox(x));
            when Neg(Neg(x)) do
                return simplify(unbox(x));
            when Neg(x) do
                return neg(simplify(unbox(x)));
            when Add(l, r) do
                return add(simplify(unbox(l)), simplify(unbox(r)));
            when Int(v) do
                return lit(v);
        end case;
    end;

    -- The value, and the tree is given back.
    function eval(e: Expr): Int64 is
        case e of
            when Int(v) do
                return v;
            when Neg(x) do
                let zero: Int64 := 0;
                return zero - eval(unbox(x));
            when Add(l, r) do
                let a: Int64 := eval(unbox(l));
                return a + eval(unbox(r));
        end case;
    end;

    -- The number of nodes, and the tree is given back.
    function size(e: Expr): Int64 is
        let one: Int64 := 1;
        case e of
            when Int(v) do
                return one;
            when Neg(x) do
                return one + size(unbox(x));
            when Add(l, r) do
                let a: Int64 := size(unbox(l));
                return one + (a + size(unbox(r)));
        end case;
    end;

    function show(e: Expr): Unit is
        let s: Expr := simplify(e);
        case s of
            when Int(v) do
                printLn(v);
            when Neg(x) do
                let n: Int64 := size(unbox(x));
                printLn(n);
            when Add(l, r) do
                let a: Int64 := size(unbox(l));
                let b: Int64 := size(unbox(r));
                printLn(a + b);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        let zero: Int64 := 0;
        let five: Int64 := 5;
        let seven: Int64 := 7;
        -- 0 + --(5 + 0): the first alternative, then Neg(Neg(x)), then the
        -- second alternative; 5.
        show(add(lit(zero), neg(neg(add(lit(five), lit(zero))))));
        -- (7 + 0) + 0: the second alternative twice; 7.
        show(add(add(lit(seven), lit(zero)), lit(zero)));
        -- -(0 + 7): Neg(x) keeps its node; simplify gives -(7), whose
        -- child has one node.
        show(neg(add(lit(zero), lit(seven))));
        -- (5 + 7) stays an Add: two leaves.
        show(add(lit(five), lit(seven)));
        -- The value of a larger tree after simplify: 5 + -(7) = -2.
        let t: Expr := simplify(add(add(lit(five), lit(zero)), neg(neg(neg(add(lit(zero), lit(seven)))))));
        printLn(size(simplify(add(lit(zero), lit(five)))));
        printLn(eval(t));
        return ExitSuccess();
    end;
end module body.
