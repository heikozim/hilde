import Standard.Box (
    Box,
    makeBox,
    unbox
);

-- Pattern matching: the first alternative looks deep into the value
-- and fails; the second needs that same value whole.  Nothing may have
-- been moved or freed while deciding.
module body Test is
    union Expr: Linear is
        case Int is
            value: Int64;
        case Neg is
            inner: Box[Expr];
        case Add is
            left: Box[Expr];
            right: Box[Expr];
    end;

    function boxed(e: Expr): Box[Expr] is
        case makeBox(e) of
            when Right(right as b: Box[Expr]) do
                return b;
            when Left(left as back: Expr) do
                abort("no memory for a box");
                return boxed(back);
        end case;
    end;

    function eval(e: Expr): Int64 is
        case e of
            when Int(v) do
                return v;
            when Neg(x) do
                let zero: Int64 := 0;
                return zero - eval(unbox(x));
            when Add(l, r) do
                let a: Int64 := eval(unbox(l));
                return a + eval(unbox(r));
        end case;
    end;

    function lit(v: Int64): Expr is
        return Int(value => v);
    end;

    function pick(e: Expr): Int64 is
        case e of
            when Add(Int(0), Int(1)) do
                return 1;
            when Add(Neg(Int(2)), x) | Add(x, Neg(Int(2))) do
                let ten: Int64 := 10;
                return ten * eval(unbox(x));
            when Add(l, r) do
                let a: Int64 := eval(unbox(l));
                let hundred: Int64 := 100;
                return a + (hundred * eval(unbox(r)));
            when Neg(x) do
                return eval(unbox(x));
            when Int(v) do
                return v;
        end case;
    end;

    function main(): ExitCode is
        let zero: Int64 := 0;
        let one: Int64 := 1;
        let two: Int64 := 2;
        let three: Int64 := 3;
        printLn(pick(Add(left => boxed(lit(zero)), right => boxed(lit(one)))));
        printLn(pick(Add(left => boxed(lit(zero)), right => boxed(lit(two)))));
        printLn(pick(Add(left => boxed(Neg(inner => boxed(lit(two)))), right => boxed(lit(three)))));
        printLn(pick(Add(left => boxed(lit(three)), right => boxed(Neg(inner => boxed(lit(two)))))));
        printLn(pick(Add(left => boxed(Neg(inner => boxed(lit(three)))), right => boxed(lit(one)))));
        return ExitSuccess();
    end;
end module body.
