-- Pattern matching: the value of a pattern case is an expression, evaluated once;
-- a pattern case inside the body of a when with alternatives (the body is
-- generated once per alternative); a pattern case in a loop.
module body Test is
    function twice(v: Int32): Int32 is
        return v * 2;
    end;

    function main(): ExitCode is
        var total: Int32 := 0;
        for i from 0 to 9 do
            let k: Int32 := 0;
            case twice(k) of
                when 0 | 2 do
                    let j: Nat8 := 7;
                    case j of
                        when 7 do
                            total := total + 1;
                        when _ do
                            skip;
                    end case;
                when _ do
                    skip;
            end case;
        end for;
        printLn(total);
        return ExitSuccess();
    end;
end module body.
