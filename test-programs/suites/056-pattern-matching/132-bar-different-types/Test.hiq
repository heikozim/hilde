-- x is an Int32 in one alternative and a Nat8 in the other.
module body Test is
    union U: Free is
        case I is
            v: Int32;
        case N is
            v: Nat8;
    end;

    function main(): ExitCode is
        let one: Int32 := 1;
        let u: U := I(v => one);
        case u of
            when I(x) | N(x) do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
