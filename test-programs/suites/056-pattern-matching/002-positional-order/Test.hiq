-- Pattern matching: sub-patterns are positional, in the order the
-- union declares the slots.  Pair(1, b) looks at the first slot.
module body Test is
    union Pair: Free is
        case P is
            a: Int32;
            b: Int32;
    end;

    function which(p: Pair): Int32 is
        case p of
            when P(1, b) do
                return b;
            when P(a, 1) do
                return a + 100;
            when P(a, b) do
                return a + (b * 1000);
        end case;
    end;

    function main(): ExitCode is
        let one: Int32 := 1;
        let two: Int32 := 2;
        let three: Int32 := 3;
        printLn(which(P(a => one, b => two)));
        printLn(which(P(a => two, b => one)));
        printLn(which(P(a => two, b => three)));
        printLn(which(P(a => one, b => one)));
        return ExitSuccess();
    end;
end module body.
