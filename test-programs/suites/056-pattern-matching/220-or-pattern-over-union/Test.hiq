-- Variants that go the same way share one when with |: each is named.
module body Test is
    union Block: Free is
        case Heading is
            level: Int32;
        case Paragraph is
            words: Int32;
        case Quote is
            depth: Int32;
        case Rule;
    end;

    function kindOf(b: Block): Int32 is
        case b of
            when Heading(level) do
                return level;
            when Paragraph(_) | Quote(_) | Rule do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        printLn(kindOf(Heading(level => 2)));
        printLn(kindOf(Quote(depth => 1)));
        printLn(kindOf(Rule()));
        return ExitSuccess();
    end;
end module body.
