-- A variant missing at the top: T2.
module body Test is
    union Leaf: Free is
        case A;
        case B;
    end;

    union Mid: Free is
        case M1 is
            l: Leaf;
        case M2;
    end;

    union Top: Free is
        case T1 is
            m: Mid;
        case T2;
    end;

    function main(): ExitCode is
        let t: Top := T2();
        case t of
            when T1(m) do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
