-- Pattern matching: a Bool is complete with true and false;
-- literals and a variable inside a variant.
module body Test is
    union Reading: Free is
        case Flag is
            on: Bool;
        case Level is
            v: Nat8;
    end;

    function describe(r: Reading): Int32 is
        case r of
            when Flag(true) do
                return 1;
            when Flag(false) do
                return 0;
            when Level(0) do
                return 10;
            when Level(1 .. 99) do
                return 11;
            when Level(v) do
                return 12;
        end case;
    end;

    function flip(b: Bool): Bool is
        case b of
            when true do
                return false;
            when false do
                return true;
        end case;
    end;

    function main(): ExitCode is
        let t: Bool := true;
        let low: Nat8 := 0;
        let mid: Nat8 := 50;
        let high: Nat8 := 200;
        printLn(describe(Flag(on => t)));
        printLn(describe(Flag(on => flip(t))));
        printLn(describe(Level(v => low)));
        printLn(describe(Level(v => mid)));
        printLn(describe(Level(v => high)));
        return ExitSuccess();
    end;
end module body.
