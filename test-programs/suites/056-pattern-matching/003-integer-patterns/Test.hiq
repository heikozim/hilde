-- Pattern matching: literals, ranges with and without spaces,
-- character, hexadecimal and negative literals, and a variable that binds
-- the rest.  The first when that matches is taken.
module body Test is
    function kind(c: Nat8): Int32 is
        case c of
            when 'a' .. 'z' do
                return 1;
            when 65 .. 90 do
                return 2;
            when '0' | '1' | #x32 do
                return 3;
            when 48 .. 57 do
                return 4;
            when n do
                return 5;
        end case;
    end;

    function sign(v: Int8): Int32 is
        case v of
            when -128 .. -1 do
                return -1;
            when 0 do
                return 0;
            when 1 .. 127 do
                return 1;
        end case;
    end;

    function main(): ExitCode is
        let a: Nat8 := 'q';
        let b: Nat8 := 'Q';
        let c: Nat8 := '2';
        let d: Nat8 := '7';
        let e: Nat8 := 32;
        printLn(kind(a));
        printLn(kind(b));
        printLn(kind(c));
        printLn(kind(d));
        printLn(kind(e));
        let m: Int8 := -128;
        let z: Int8 := 0;
        let p: Int8 := 127;
        printLn(sign(m));
        printLn(sign(z));
        printLn(sign(p));
        return ExitSuccess();
    end;
end module body.
