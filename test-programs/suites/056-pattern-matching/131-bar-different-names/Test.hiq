-- x in one alternative, y in the other.
module body Test is
    union Shape: Free is
        case Dot;
        case Circle is
            r: Int32;
        case Rect is
            w: Int32;
            h: Int32;
    end;

    function main(): ExitCode is
        let s: Shape := Circle(r => 1);
        case s of
            when Dot do
                skip;
            when Circle(x) | Rect(y, 1) do
                skip;
            when Rect(a, b) do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
