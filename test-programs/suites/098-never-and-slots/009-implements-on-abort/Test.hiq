pragma Unsafe_Module;
module body Test is
    pragma Implements(Name => "Hilde.Pervasive.onAbort");
    function report(message: Span[Nat8, Static]): Never is
        printLn("custom stop");
        @embed(Never, "hilde_abort($1)", message);
    end;

    function main(): ExitCode is
        abort("bye");
    end;
end module body.
