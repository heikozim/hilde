import Reading (
    read
);

module body Test is
    pragma Implements(Name => "Reading.read");
    generic [R: Region]
    function readTwice(number: &[Int32, R]): Int32 is
        return !number + !number;
    end;

    function main(): ExitCode is
        let first: Int32 := 20;
        let second: Int32 := 3;
        borrow a: &[Int32, A] := &first do
            borrow b: &[Int32, B] := &second do
                printLn(read(a));
                printLn(read(b));
            end borrow;
        end borrow;
        return ExitSuccess();
    end;
end module body.
