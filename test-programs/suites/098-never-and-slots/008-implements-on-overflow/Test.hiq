module body Test is
    pragma Implements(Name => "Hilde.Pervasive.onOverflow");
    function handled(message: Span[Nat8, Static]): Never is
        printLn("handled");
        abort(message);
    end;

    function main(): ExitCode is
        let a: Int8 := 127;
        let b: Int8 := a + 1;
        printLn(b);
        return ExitSuccess();
    end;
end module body.
