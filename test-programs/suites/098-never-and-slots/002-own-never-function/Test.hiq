module body Test is
    function stop(message: Span[Nat8, Static]): Never is
        abort(message);
    end;

    function half(n: Int32): Int32 is
        if n >= 0 then
            return n / 2;
        end if;
        stop("negative");
    end;

    function main(): ExitCode is
        printLn(half(10));
        return ExitSuccess();
    end;
end module body.
