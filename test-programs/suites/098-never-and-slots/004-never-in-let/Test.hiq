module body Test is
    function stop(message: Span[Nat8, Static]): Never is
        abort(message);
    end;

    function pick(b: Bool): Int32 is
        if b then
            return 1;
        end if;
        let x: Int32 := stop("no");
        return x;
    end;

    function main(): ExitCode is
        printLn(pick(true));
        return ExitSuccess();
    end;
end module body.
