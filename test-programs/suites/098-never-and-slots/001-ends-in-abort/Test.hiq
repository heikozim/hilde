module body Test is
    -- The value of n when it is positive; any other n stops the programme.
    function positive(n: Int32): Int32 is
        if n > 0 then
            return n;
        end if;
        abort("not positive");
    end;

    function main(): ExitCode is
        printLn(positive(5));
        return ExitSuccess();
    end;
end module body.
