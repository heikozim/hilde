import Standard.String (
    String,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    asSpan
);
import Standard.File (
    FileDescriptor,
    openWrite,
    closeFile,
    writeAll,
    removeFile,
    FileKind,
    kindUnknown,
    kindRegular,
    kindDirectory,
    kindSymlink,
    kindOther,
    sameKind,
    kindOf,
    kindOfTarget,
    linkTarget,
    createSymlink,
    containsSymlink
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region, S: Region]
    function sameText(left: &[String, R], right: &[String, S]): Bool is
        let size: Index := length(left);
        if size /= length(right) then
            return false;
        end if;
        if size = 0 then
            return true;
        end if;
        var same: Bool := true;
        for i from 0 to size - 1 do
            if nthByte(left, i) /= nthByte(right, i) then
                same := false;
            end if;
        end for;
        return same;
    end;

    function kindIs(text: Span[Nat8, Static], wanted: FileKind): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := sameKind(kindOf(asSpan(&path)), wanted);
        destroyString(path);
        return answer;
    end;

    function targetKindIs(text: Span[Nat8, Static], wanted: FileKind): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := sameKind(kindOfTarget(asSpan(&path)), wanted);
        destroyString(path);
        return answer;
    end;

    function passesLink(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        let answer: Bool := containsSymlink(asSpan(&path));
        destroyString(path);
        return answer;
    end;

    -- Write one byte into a name, so that there is a regular file to ask
    -- about.  True when every step worked.
    function putByte(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        var payload: String := fromLiteral("x");
        var made: Bool := false;
        case openWrite(asSpan(&path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, asSpan(&payload));
                let closed: Bool := closeFile(file);
                if written then
                    made := closed;
                end if;
            when None do
                made := false;
        end case;
        destroyString(path);
        destroyString(payload);
        return made;
    end;

    function drop(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        let gone: Bool := removeFile(asSpan(&path));
        destroyString(path);
        return gone;
    end;

    function linkPointsAt(linkText: Span[Nat8, Static],
        wantedText: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(linkText);
        var wanted: String := fromLiteral(wantedText);
        var answer: Bool := false;
        case linkTarget(asSpan(&path)) of
            when Some(value as got: String) do
                var target: String := got;
                answer := sameText(&target, &wanted);
                destroyString(target);
            when None do
                answer := false;
        end case;
        destroyString(path);
        destroyString(wanted);
        return answer;
    end;

    function noLinkTarget(text: Span[Nat8, Static]): Bool is
        var path: String := fromLiteral(text);
        var answer: Bool := false;
        case linkTarget(asSpan(&path)) of
            when Some(value as got: String) do
                var target: String := got;
                destroyString(target);
                answer := false;
            when None do
                answer := true;
        end case;
        destroyString(path);
        return answer;
    end;

    function makeLink(targetText: Span[Nat8, Static],
        nameText: Span[Nat8, Static]): Bool is
        var target: String := fromLiteral(targetText);
        var name: String := fromLiteral(nameText);
        let made: Bool := createSymlink(asSpan(&target), asSpan(&name));
        destroyString(target);
        destroyString(name);
        return made;
    end;

    function main(): ExitCode is
        -- 1. The three kinds a machine always has.
        printLn(widen(kindIs("/", kindDirectory)));
        printLn(widen(kindIs("/dev/null", kindOther)));
        printLn(widen(kindIs("hilde-038-absent.tmp", kindUnknown)));

        -- 2. A regular file this test makes.
        printLn(widen(putByte("hilde-038-target.tmp")));
        printLn(widen(kindIs("hilde-038-target.tmp", kindRegular)));

        -- 3. A link to it.  This is the pair the module exists for:
        --    kindOf sees the link, kindOfTarget sees what it leads to.
        printLn(widen(makeLink("hilde-038-target.tmp", "hilde-038-link.tmp")));
        printLn(widen(kindIs("hilde-038-link.tmp", kindSymlink)));
        printLn(widen(targetKindIs("hilde-038-link.tmp", kindRegular)));

        -- 4. And what it points at, as it was written.
        printLn(widen(linkPointsAt("hilde-038-link.tmp",
            "hilde-038-target.tmp")));
        printLn(widen(noLinkTarget("hilde-038-target.tmp")));

        -- 5. A link that points at nothing: the name is still a link, and
        --    what it leads to is unknown.  A check that followed links
        --    would call this one missing and pass it.
        printLn(widen(makeLink("hilde-038-absent.tmp", "hilde-038-dangling.tmp")));
        printLn(widen(kindIs("hilde-038-dangling.tmp", kindSymlink)));
        printLn(widen(targetKindIs("hilde-038-dangling.tmp", kindUnknown)));

        -- 6. The inherited item: does the path pass through a link?
        printLn(widen(passesLink("hilde-038-link.tmp")));
        printLn(widen(not passesLink("hilde-038-target.tmp")));
        --    The control that makes the two above mean something: a path
        --    whose prefix is the link, where the last component does not
        --    exist at all.  A check that only looked at the whole path
        --    would answer false here.
        printLn(widen(passesLink("hilde-038-link.tmp/whatever")));
        printLn(widen(not passesLink("/")));

        -- 7. Everything this test made is taken away again, and the last
        --    line is the proof.
        printLn(widen(drop("hilde-038-dangling.tmp")));
        printLn(widen(drop("hilde-038-link.tmp")));
        printLn(widen(drop("hilde-038-target.tmp")));
        printLn(widen(kindIs("hilde-038-target.tmp", kindUnknown)));
        return ExitSuccess();
    end;
end module body.
