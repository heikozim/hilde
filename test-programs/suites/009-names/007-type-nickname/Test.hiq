-- A type imported under a nickname is the same type as under its own name:
-- fromLiteral returns a String, and a variable declared as
-- Text -- String's nickname here -- takes it.  Upstream compares the
-- names with the nickname in them and refuses the assignment (H3027).
import Standard.String (
    String as Text,
    fromLiteral,
    destroyString,
    length
);

module body Test is
    function main(): ExitCode is
        let t: Text := fromLiteral("abc");
        print("length ");
        printLn(length(&t));
        destroyString(t);
        return ExitSuccess();
    end;
end module body.
