-- The heartbeat that the runtime writes while a rank computes: the
-- programme starts itself as the ranks of jobs on localhost and the last
-- rank computes for eight seconds, longer than the silence of five
-- seconds, without calling anything of the job.  In a job of two ranks
-- rank 0 waits for it; in a job of three rank 0 waits for rank 1, which
-- waits for rank 2.  No rank calls setSilence or heartbeat.  Every rank
-- must get its message and see heartbeats written.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    length,
    insertBack,
    removeLast,
    destroyEmpty
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Text (
    equal
);
import Standard.File (
    FileDescriptor,
    openWrite,
    writeAll,
    closeFile,
    removeFile
);
import Standard.Arguments (
    processArguments,
    programPath
);
import Standard.IO (
    TerminalCapability,
    acquireTerminal,
    releaseTerminal
);
import Standard.IO.Terminal (
    StandardInput,
    acquireInput,
    releaseInput,
    readLine
);
import Standard.Task (
    sleepFor
);
import Standard.Tls (
    heartbeatRounds
);
import Standard.SperliLaunch (
    RunOptions,
    parseRunArguments,
    runJob
);
import Standard.Sperli (
    Job,
    Comm,
    readJobText,
    init,
    rank,
    size,
    send,
    recv,
    finish
);

module body Test is
    function words(ranks: Span[Nat8, Static]): Buffer[String] is
        var out: Buffer[String] := allocateEmpty();
        insertBack(&!out, fromLiteral("-n"));
        insertBack(&!out, fromLiteral(ranks));
        insertBack(&!out, fromLiteral("--hosts"));
        insertBack(&!out, fromLiteral("sperli-beat-hosts.txt"));
        insertBack(&!out, programPath());
        insertBack(&!out, fromLiteral("rank"));
        return out;
    end;

    function destroyWords(list: Buffer[String]): Unit is
        var rest: Buffer[String] := list;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function writeHosts(): Bool is
        case openWrite("sperli-beat-hosts.txt") of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, "localhost\nlocalhost\nlocalhost\n");
                return closeFile(file) and written;
            when None do
                return false;
        end case;
    end;

    function job(ranks: Span[Nat8, Static]): Bool is
        print("job of ");
        printLn(ranks);
        let list: Buffer[String] := words(ranks);
        var status: Int32 := 0;
        case parseRunArguments(&list) of
            when Right(right as options: RunOptions) do
                destroyWords(list);
                status := runJob(options);
            when Left(left as code: Int32) do
                destroyWords(list);
                status := code;
        end case;
        print("launcher status ");
        printLn(status);
        return status = 0;
    end;

    function launcher(): ExitCode is
        if not writeHosts() then
            printLn("no host file");
            return ExitFailure();
        end if;
        var good: Bool := job("2");
        good := job("3") and good;
        let removed: Bool := removeFile("sperli-beat-hosts.txt");
        if good then
            return ExitSuccess();
        end if;
        return ExitFailure();
    end;

    -- The last rank computes, then sends to the rank before it; every
    -- other rank waits for the rank after it and passes the message on.
    function chain(opened: Comm): Bool is
        var comm: Comm := opened;
        let me: Nat32 := rank(&comm);
        let last: Nat32 := size(&comm) - 1;
        var good: Bool := true;
        if me = last then
            sleepFor(8000);
            good := send(&!comm, me - 1, 7, fromLiteral("done")) = 0;
            print("rank ");
            print(me);
            print(" computed and sent ");
            printLn(good);
            let beats: Bool := heartbeatRounds() >= 4;
            print("rank ");
            print(me);
            print(" wrote heartbeats while it computed ");
            printLn(beats);
            good := good and beats;
        else
            case recv(&!comm, me + 1, 7) of
                when Right(right as text: String) do
                    let heard: Bool := equal(asSpan(&text), "done");
                    destroyString(text);
                    print("rank ");
                    print(me);
                    print(" heard done ");
                    printLn(heard);
                    good := heard;
                    if me > 0 then
                        good := (send(&!comm, me - 1, 7, fromLiteral("done")) = 0) and good;
                    end if;
                when Left(left as code: Int32) do
                    print("rank ");
                    print(me);
                    print(" lost its peer with H");
                    printLn(code);
                    good := false;
            end case;
        end if;
        finish(comm);
        return good;
    end;

    function rankMain(line: String): ExitCode is
        case readJobText(asSpan(&line)) of
            when Left(left as why: Int32) do
                destroyString(line);
                print("the job was refused with ");
                printLn(why);
                return ExitStatus(status => 4);
            when Right(right as given: Job) do
                destroyString(line);
                case init(given) of
                    when Left(left as why: Int32) do
                        print("init failed with ");
                        printLn(why);
                        return ExitStatus(status => 5);
                    when Right(right as comm: Comm) do
                        if chain(comm) then
                            return ExitSuccess();
                        end if;
                        return ExitFailure();
                end case;
        end case;
    end;

    function readJobLine(root: RootCapability): String is
        var mut_root: RootCapability := root;
        var terminal: TerminalCapability := acquireTerminal(&!mut_root);
        var input: StandardInput := acquireInput(&!terminal);
        let line: String := readLine(&!input);
        releaseInput(input);
        releaseTerminal(terminal);
        surrenderRoot(mut_root);
        return line;
    end;

    function main(root: RootCapability): ExitCode is
        var arguments: Buffer[String] := processArguments();
        if length(&arguments) = 0 then
            destroyEmpty(arguments);
            surrenderRoot(root);
            return launcher();
        end if;
        destroyWords(arguments);
        return rankMain(readJobLine(root));
    end;
end module body.
