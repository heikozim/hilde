-- The hosts that SPERLI_REFUSED_HOSTS names never run a rank.  The runner
-- sets the variable to two names, separated by a comma and a blank.  A job
-- whose host list names one of them, a name below one or a name that starts
-- with one, in any letter case, is refused with H1603 before any process is
-- started, also when a deny file is given.  A name that only begins with the
-- same letters is another host and is let through.  The check a rank makes
-- for every host of its description and before it connects is the same
-- function, and it answers alike.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    length,
    insertBack,
    removeLast,
    destroyEmpty
);
import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.File (
    FileDescriptor,
    openWrite,
    writeAll,
    closeFile,
    removeFile
);
import Standard.SperliLaunch (
    HostList,
    RunOptions,
    parseHostList,
    hostCount,
    destroyHostList,
    parseRunArguments,
    runJob
);
import Standard.SperliWire (
    hostRefused
);
import Standard.SperliError (
    refusedHost
);

module body Test is
    function writeText(path: Span[Nat8, Static], text: Span[Nat8, Static]): Bool is
        case openWrite(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, text);
                return closeFile(file) and written;
            when None do
                return false;
        end case;
    end;

    function destroyWords(list: Buffer[String]): Unit is
        var rest: Buffer[String] := list;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    -- The launcher's answer for one rank on the hosts of the text, with the
    -- deny file when deny is true.  No rank is started when the list is
    -- refused, so the programme named is never run.
    function launch(hosts: Span[Nat8, Static], deny: Bool): Int32 is
        if not writeText("sperli-hosts.txt", hosts) then
            return 1;
        end if;
        var list: Buffer[String] := allocateEmpty();
        insertBack(&!list, fromLiteral("-n"));
        insertBack(&!list, fromLiteral("1"));
        insertBack(&!list, fromLiteral("--hosts"));
        insertBack(&!list, fromLiteral("sperli-hosts.txt"));
        if deny then
            insertBack(&!list, fromLiteral("--deny-hosts"));
            insertBack(&!list, fromLiteral("sperli-deny.txt"));
        end if;
        insertBack(&!list, fromLiteral("/nonexistent/sperli-rank"));
        case parseRunArguments(&list) of
            when Right(right as options: RunOptions) do
                destroyWords(list);
                let code: Int32 := runJob(options);
                let removed: Bool := removeFile("sperli-hosts.txt");
                return code;
            when Left(left as code: Int32) do
                destroyWords(list);
                let removed: Bool := removeFile("sperli-hosts.txt");
                return code;
        end case;
    end;

    function show(label: Span[Nat8, Static], code: Int32): Unit is
        print(label);
        print(" ");
        if code = refusedHost() then
            printLn("refused");
        else
            print("status ");
            printLn(code);
        end if;
        return nil;
    end;

    function flag(label: Span[Nat8, Static], value: Bool): Unit is
        print(label);
        if value then
            printLn(" refused");
        else
            printLn(" let through");
        end if;
        return nil;
    end;

    -- Whether the host list of the text is taken, without the variable's
    -- names in a deny file: only the variable can refuse it.
    function listTaken(text: Span[Nat8, Static]): Bool is
        case parseHostList(text, "") of
            when Right(right as hosts: HostList) do
                let taken: Bool := hostCount(&hosts) = 1;
                destroyHostList(hosts);
                return taken;
            when Left(left as code: Int32) do
                return false;
        end case;
    end;

    function main(): ExitCode is
        show("a listed name", launch("localhost\nnode9\n", false));
        show("a name below one", launch("localhost\nrack.LAB-X\n", false));
        show("a name that starts with one", launch("node9.example.org\n", false));
        if not writeText("sperli-deny.txt", "other-host\n") then
            printLn("no deny file");
            return ExitFailure();
        end if;
        show("with a deny file of other names", launch("NODE9\n", true));
        let removed: Bool := removeFile("sperli-deny.txt");
        if listTaken("node10\n") then
            printLn("node10 taken");
        else
            printLn("node10 not taken");
        end if;
        flag("rank check of node9", hostRefused("node9"));
        flag("rank check of Lab-X", hostRefused("Lab-X"));
        flag("rank check of node10", hostRefused("node10"));
        flag("rank check of localhost", hostRefused("localhost"));
        return ExitSuccess();
    end;
end module body.
