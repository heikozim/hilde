-- A module names C headers, and a constant takes its value from one of
-- them when the program is compiled.  <stdio.h> is the hard case:
-- it declares fputc, which Standard.IO.Terminal imports with Hilde's types,
-- and without the renaming around the #include the C would not compile.
-- eof and CHAR_BIT are the same numbers on every platform Hilde supports.
pragma Unsafe_Module;
pragma Foreign_Header(Name => "stdio.h");
pragma Foreign_Header(Name => "limits.h");

module body Test is
    constant end_of_file: Int32 := @embed(Int32, "EOF");
    constant bits_per_byte: Int32 := @embed(Int32, "CHAR_BIT");

    function main(): ExitCode is
        printLn(end_of_file);
        printLn(bits_per_byte);
        return ExitSuccess();
    end;
end module body.
