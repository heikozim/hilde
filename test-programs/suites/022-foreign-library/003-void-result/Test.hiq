pragma Unsafe_Module;

module body Test is
    -- A C function that returns nothing: its Hilde result is Unit, which
    -- the code generator must accept for every such foreign function
    -- instead of "Not allowed".  srand is declared by <stdlib.h>, which the
    -- generated C includes, so the declaration here must agree with it
    -- exactly -- and it does: void, one unsigned int.
    pragma Foreign_Import(External_Name => "srand");
    function seed(value: Nat32): Unit is
    end;

    function main(): ExitCode is
        let done: Unit := seed(7);
        printLn("seeded");
        return ExitSuccess();
    end;
end module body.
