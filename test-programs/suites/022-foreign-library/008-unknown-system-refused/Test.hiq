pragma Unsafe_Module;
pragma Foreign_Library(Name => "crypt", System => "linux");

module body Test is
    -- The system is compared with what uname -s prints, and that is Linux,
    -- with a capital.  A name the compiler does not know is refused, since
    -- a misspelt one would never match and its library would never be
    -- linked, without a word.
    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
