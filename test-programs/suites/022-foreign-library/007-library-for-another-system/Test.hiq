pragma Unsafe_Module;
pragma Foreign_Library(Name => "hilde_no_such_library", System => "NetBSD");
pragma Foreign_Library(Name => "m");

module body Test is
    -- A library named for one system is linked on that system only.  No
    -- machine has hilde_no_such_library; named for NetBSD, it is left out on
    -- Linux, OpenBSD, FreeBSD and Darwin, where the gates run, and the
    -- programme links.
    -- libm, named for every system, is still linked: sqrt needs it.  Were
    -- the first library linked, the link would fail with the name of the
    -- library.
    pragma Foreign_Import(External_Name => "sqrt");
    function squareRoot(value: Float64): Float64 is
    end;

    function main(): ExitCode is
        if squareRoot(16.0) = 4.0 then
            printLn("linked without it");
        end if;
        return ExitSuccess();
    end;
end module body.
