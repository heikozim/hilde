pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck
);

module body Test is
    record Cell: Free is
        value: Int32;
    end;

    record Other: Free is
        n: Int32;
    end;

    generic [H: Free, T: Free, R: Region]
    function get(holder: &![H, R]): Option[&![T, R]] is
        let p: Address[T] := @embed(Address[T], "(void*)($1)", holder);
        case nullCheck(p) of
            when Some(value: Pointer[T]) do
                return Some(value => @embed(&![T, R], "$1", value));
            when None do
                return None();
        end case;
    end;

    generic [R: Region]
    function showCell(cell: &![Cell, R]): Unit is
        printLn(cell->value);
        return nil;
    end;

    generic [R: Region]
    function showOther(other: &![Other, R]): Unit is
        printLn(other->n);
        return nil;
    end;

    function main(): ExitCode is
        var c: Cell := Cell(value => 3);
        var o: Other := Other(n => 5);
        borrow rc: &![Cell, R] := &!c do
            let s1: Option[&![Cell, R]] := get(rc);
            case s1 of
                when Some(value: &![Cell, R]) do
                    showCell(value);
                when None do
                    printLn(0);
            end case;
        end borrow;
        borrow ro: &![Other, S] := &!o do
            let s2: Option[&![Other, S]] := get(ro);
            case s2 of
                when Some(value: &![Other, S]) do
                    showOther(value);
                when None do
                    printLn(0);
            end case;
        end borrow;
        return ExitSuccess();
    end;
end module body.
