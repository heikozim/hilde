pragma Unsafe_Module;

import Hilde.Memory (
    Address,
    Pointer,
    nullCheck
);

module body Test is
    record Cell: Free is
        value: Int32;
    end;

    generic [R: Region]
    function show(cell: &[Cell, R]): Unit is
        printLn(cell->value);
        return nil;
    end;

    generic [T: Free, R: Region]
    function get(holder: &[Cell, R]): Option[&[T, R]] is
        let p: Address[T] := @embed(Address[T], "(void*)($1)", holder);
        case nullCheck(p) of
            when Some(value: Pointer[T]) do
                return Some(value => @embed(&[T, R], "$1", value));
            when None do
                return None();
        end case;
    end;

    function main(): ExitCode is
        let c: Cell := Cell(value => 9);
        borrow r: &[Cell, R] := &c do
            let slot: Option[&[Cell, R]] := get(r);
            case slot of
                when Some(value: &[Cell, R]) do
                    show(value);
                when None do
                    printLn(0);
            end case;
        end borrow;
        return ExitSuccess();
    end;
end module body.
