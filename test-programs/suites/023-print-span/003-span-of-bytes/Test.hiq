pragma Unsafe_Module;

import Hilde.Memory (
    Pointer,
    Address,
    allocateBuffer,
    nullCheck,
    deallocate,
    span,
    positiveOffset,
    store
);

module body Test is
    function allocateOrDie(count: Index): Pointer[Nat8] is
        let addr: Address[Nat8] := allocateBuffer(count);
        case nullCheck(addr) of
            when Some(value: Pointer[Nat8]) do
                return value;
            when None do
                abort("Allocation failed.");
        end case;
    end;

    function main(): ExitCode is
        -- Five bytes: a letter, a zero byte, the byte 127, a line feed
        -- and a letter.  Each must come out as it is, the zero byte too.
        var odd: Pointer[Nat8] := allocateOrDie(5);
        store(odd, 72);
        store(positiveOffset(odd, 1), 0);
        store(positiveOffset(odd, 2), 127);
        store(positiveOffset(odd, 3), 10);
        store(positiveOffset(odd, 4), 122);
        borrow ref: &[Pointer[Nat8], R] := &odd do
            let sp: Span[Nat8, R] := span(ref, 0, 4);
            print(7);
            print(sp);
            printLn(8);
        end borrow;
        deallocate(odd);
        -- 300 letters, a to z over and over, between two numbers: the
        -- order of the output stays the order of the prints.
        let count: Index := 300;
        var many: Pointer[Nat8] := allocateOrDie(count);
        var i: Index := 0;
        var letter: Nat8 := 97;
        while i < count do
            store(positiveOffset(many, i), letter);
            if letter = 122 then
                letter := 97;
            else
                letter := letter + 1;
            end if;
            i := i + 1;
        end while;
        borrow letters: &[Pointer[Nat8], S] := &many do
            let row: Span[Nat8, S] := span(letters, 0, count - 1);
            print(1);
            printLn(row);
            printLn(2);
        end borrow;
        deallocate(many);
        -- An empty span prints nothing.
        print("");
        printLn("end");
        return ExitSuccess();
    end;
end module body.
