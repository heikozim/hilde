module body Test is
    typeclass Greetable(T: Free) is
        method greet(value: T): Unit;
        method farewell(value: T): Unit;
    end;

    instance Greetable(Nat8) is
        method greet(value: Nat8): Unit is
            printLn(value);
            return nil;
        end;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
