-- Generated by scripts/regex/cases.py -- do not edit; edit the table there.
--
-- Every case of DEVIATIONS, run through Standard.Regex, with the message of
-- each refusal.  The expected output is this engine's own, reviewed.
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    getSpan,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Buffer (
    Buffer,
    destroyFree,
    length as bufferLength,
    nth
);
import Standard.Regex (
    Regex,
    compile,
    destroyRegex,
    groupCount,
    match,
    Found,
    find,
    foundStart,
    foundEnd,
    groupStart,
    groupEnd,
    destroyFound,
    Hit,
    find_all,
    replace
);

module body Test is
    constant ten: Nat8 := 10;
    constant sixteen: Nat8 := 16;

    function nibble(c: Nat8): Nat8 is
        if c <= '9' then
            return c - '0';
        end if;
        return (c - 'A') + ten;
    end;

    -- The literals of this file are ASCII: every other byte, and every
    -- %, quote and backslash, is written %xx (scripts/regex/cases.py).
    function decode(encoded: Span[Nat8, Static]): String is
        var out: StringBuilder := makeStringBuilder();
        let size: Index := spanLength(encoded);
        var i: Index := 0;
        while i < size do
            let c: Nat8 := encoded[i];
            if c = '%' then
                let high: Nat8 := nibble(encoded[i + 1]);
                let low: Nat8 := nibble(encoded[i + 2]);
                writeByte(&!out, (high * sixteen) + low);
                i := i + 3;
            else
                writeByte(&!out, c);
                i := i + 1;
            end if;
        end while;
        return finalize(out);
    end;

    generic [R: Region]
    function compileText(pattern: &[String, R]): Either[String, Regex] is
        let size: Index := length(pattern);
        if size = 0 then
            return compile("");
        end if;
        return compile(getSpan(pattern, 0, size - 1));
    end;

    function hexDigit(value: Nat8): Nat8 is
        if value < ten then
            return value + '0';
        end if;
        return (value - ten) + 'A';
    end;

    -- The expected output is a file of the repository, which is ASCII, so
    -- the text is printed with the same %xx escape the literals use.
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        let size: Index := length(text);
        var out: StringBuilder := makeStringBuilder();
        writeByte(&!out, '[');
        var i: Index := 0;
        while i < size do
            let c: Nat8 := nthByte(text, i);
            if (c < ' ') or ((c > '~') or (c = '%')) then
                writeByte(&!out, '%');
                writeByte(&!out, hexDigit(c / sixteen));
                writeByte(&!out, hexDigit(c - ((c / sixteen) * sixteen)));
            else
                writeByte(&!out, c);
            end if;
            i := i + 1;
        end while;
        writeByte(&!out, ']');
        let shown: String := finalize(out);
        printLn(getSpan(&shown, 0, length(&shown) - 1));
        destroyString(shown);
        return nil;
    end;

    function printOption(value: Option[Index]): Unit is
        case value of
            when Some(value as v: Index) do
                print(v);
            when None do
                print("-");
        end case;
        return nil;
    end;

    generic [R: Region, S: Region]
    function printFind(re: &[Regex, R], text: &[String, S]): Unit is
        case find(re, asSpan(text)) of
            when Some(value as f: Found) do
                print("find ");
                print(foundStart(&f));
                print(" ");
                print(foundEnd(&f));
                let groups: Index := groupCount(re);
                var g: Index := 1;
                while g <= groups do
                    print(" ");
                    printOption(groupStart(&f, g));
                    print(",");
                    printOption(groupEnd(&f, g));
                    g := g + 1;
                end while;
                printLn("");
                destroyFound(f);
            when None do
                printLn("find none");
        end case;
        return nil;
    end;

    generic [R: Region, S: Region]
    function printAll(re: &[Regex, R], text: &[String, S]): Unit is
        let hits: Buffer[Hit] := find_all(re, asSpan(text));
        let count: Index := bufferLength(&hits);
        print("all ");
        print(count);
        var i: Index := 0;
        while i < count do
            let hit: Hit := nth(&hits, i);
            print(" ");
            print(hit.start);
            print(",");
            print(hit.stop);
            i := i + 1;
        end while;
        printLn("");
        destroyFree(hits);
        return nil;
    end;

    function check(number: Index, pattern: Span[Nat8, Static], subject: Span[Nat8, Static],
        rewrite: Span[Nat8, Static], showMessage: Bool): Unit is
        print("case ");
        printLn(number);
        let text: String := decode(subject);
        let source: String := decode(pattern);
        let compiled: Either[String, Regex] := compileText(&source);
        destroyString(source);
        case compiled of
            when Right(right as re: Regex) do
                if match(&re, asSpan(&text)) then
                    printLn("match yes");
                else
                    printLn("match no");
                end if;
                printFind(&re, &text);
                printAll(&re, &text);
                let with: String := decode(rewrite);
                let out: String := replace(&re, asSpan(&text), asSpan(&with));
                print("replace ");
                printText(&out);
                destroyString(out);
                destroyString(with);
                destroyRegex(re);
            when Left(left as message: String) do
                if showMessage then
                    print("error ");
                    printText(&message);
                else
                    printLn("error");
                end if;
                destroyString(message);
        end case;
        destroyString(text);
        return nil;
    end;

    -- Only whether compile takes the pattern, and if not, its message.
    function checkCompile(number: Index, pattern: Span[Nat8, Static]): Unit is
        print("case ");
        printLn(number);
        let source: String := decode(pattern);
        let compiled: Either[String, Regex] := compileText(&source);
        destroyString(source);
        case compiled of
            when Right(right as re: Regex) do
                printLn("ok");
                destroyRegex(re);
            when Left(left as message: String) do
                print("error ");
                printText(&message);
                destroyString(message);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        check(1, "%5Cp{Foo}", "a", "-", true);
        check(2, "%5Cp{L", "a", "-", true);
        check(3, "[%5Cp{Foo}]", "a", "-", true);
        check(4, "%5Cp", "a", "-", true);
        check(5, "%5Cp{}", "a", "-", true);
        check(6, "%5Cp{Latn}", "a", "-", true);
        check(7, "%5Cp{L&}", "a", "-", true);
        check(8, "%5Cp{Unknown}", "a", "-", true);
        check(9, "%5CC", "a", "-", true);
        check(10, "(a)%5C1", "aa", "-", true);
        check(11, "%5Ck<n>", "a", "-", true);
        check(12, "a(?=b)", "ab", "-", true);
        check(13, "a(?!b)", "ac", "-", true);
        check(14, "(?<=a)b", "ab", "-", true);
        check(15, "(?<!a)b", "cb", "-", true);
        check(16, "(?>a+)", "aa", "-", true);
        check(17, "a++", "aa", "-", true);
        check(18, "a?+", "a", "-", true);
        check(19, "(?'n'a)", "a", "-", true);
        check(20, "%5CZ", "a", "-", true);
        check(21, "%5Ch", "a", "-", true);
        check(22, "%5CR", "a", "-", true);
        check(23, "%5CK", "a", "-", true);
        check(24, "%5CG", "a", "-", true);
        check(25, "(abc", "a", "-", true);
        check(26, "abc)", "a", "-", true);
        check(27, "*a", "a", "-", true);
        check(28, "a**", "a", "-", true);
        check(29, "a{2,1}", "a", "-", true);
        check(30, "x{1001}", "a", "-", true);
        check(31, "[z-a]", "a", "-", true);
        check(32, "[a", "a", "-", true);
        check(33, "[[:foo:]]", "a", "-", true);
        check(34, "%5Cq", "a", "-", true);
        check(35, "%5Cx{110000}", "a", "-", true);
        check(36, "(?P<>a)", "a", "-", true);
        check(37, "(?", "a", "-", true);
        check(38, "a%5C", "a", "-", true);
        return ExitSuccess();
    end;
end module body.
