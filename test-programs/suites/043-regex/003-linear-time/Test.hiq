-- Patterns that take a backtracking engine time exponential in the length
-- of the text, on texts long enough that exponential time would never end.
-- A Pike VM does a bounded amount of work per byte, so each search here
-- finishes; the output only records what it found.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Regex (
    Regex,
    compile,
    destroyRegex,
    match,
    Found,
    find,
    foundStart,
    foundEnd,
    destroyFound
);

module body Test is
    constant long: Index := 20000;

    -- count copies of c, then last if it is not zero.
    function repeated(c: Nat8, count: Index, last: Nat8): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < count do
            writeByte(&!out, c);
            i := i + 1;
        end while;
        if last /= 0 then
            writeByte(&!out, last);
        end if;
        return finalize(out);
    end;

    function run(pattern: Span[Nat8, Static], text: String): Unit is
        case compile(pattern) of
            when Right(right as re: Regex) do
                if match(&re, asSpan(&text)) then
                    print("match yes");
                else
                    print("match no");
                end if;
                case find(&re, asSpan(&text)) of
                    when Some(value as f: Found) do
                        print(" find ");
                        print(foundStart(&f));
                        print(" ");
                        printLn(foundEnd(&f));
                        destroyFound(f);
                    when None do
                        printLn(" find none");
                end case;
                destroyRegex(re);
            when Left(left as message: String) do
                printLn("error");
                destroyString(message);
        end case;
        destroyString(text);
        return nil;
    end;

    function main(): ExitCode is
        -- The classic: n optional a's and then n a's, against n a's.
        run("(a?){30}a{30}", repeated('a', 30, 0));
        -- Nested stars with no way to finish: every split of the a's is a
        -- path, and none of them ends in b.
        run("(a*)*b", repeated('a', long, 0));
        run("(x+x+)+y", repeated('x', long, 0));
        -- The same with the final byte present, so the long search succeeds.
        run("(a*)*b", repeated('a', long, 'b'));
        -- Alternatives that overlap completely.
        run("(a|a)*c", repeated('a', long, 0));
        -- The three above end in a literal the text does not contain, and
        -- since the required-literal check they are answered
        -- without running the VM at all.  These end in a class, which no
        -- literal check can see through, so the VM does all the work.
        run("(a*)*[bc]", repeated('a', long, 0));
        run("(x+x+)+[yz]", repeated('x', long, 0));
        run("(a|a)*[cd]", repeated('a', long, 0));
        return ExitSuccess();
    end;
end module body.
