import Standard.String (
    String,
    destroyString
);
import Standard.Regex (
    Regex,
    compile,
    destroyRegex
);

module body Test is
    function main(): ExitCode is
        -- Lookaround: Standard.Regex refuses it, and a literal pattern is
        -- checked when the programme is compiled.
        let compiled: Either[String, Regex] := compile("a(?=b)");
        case compiled of
            when Right(right as re: Regex) do
                destroyRegex(re);
            when Left(left as message: String) do
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
