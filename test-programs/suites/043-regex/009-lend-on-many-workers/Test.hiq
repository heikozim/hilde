import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Regex (
    Regex,
    compile,
    match,
    destroyRegex
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    -- Search with the lent Regex 500 times, in one text that matches and
    -- one that does not, and give back how many searches matched: 500.
    generic [R: Region]
    function searches(regex: &[Regex, R]): Int32 is
        let yes: String := fromLiteral("xaaaaby");
        let no: String := fromLiteral("xaaaay");
        var hits: Int32 := 0;
        var round: Int32 := 0;
        while round < 500 do
            hits := hits + widen(match(regex, asSpan(&yes)));
            hits := hits + widen(match(regex, asSpan(&no)));
            round := round + 1;
        end while;
        destroyString(yes);
        destroyString(no);
        return hits;
    end;

    -- left tasks, all started before any is joined.
    generic [R: Region, S: Region]
    function many(scope: &![Lending[R], S], r: &[Regex, R], left: Int32): Int32 is
        if left = 0 then
            return 0;
        end if;
        let work: Fn[&[Regex, R], Int32] := searches;
        case spawnLending(&~scope, work, r) of
            when Right(right as task: Task[Int32]) do
                let rest: Int32 := many(&~scope, r, left - 1);
                return rest + join(task);
            when Left(left as back: &[Regex, R]) do
                return -1;
        end case;
    end;

    -- 008 on eight workers (env.txt), with eight tasks and no yield: the
    -- one compiled Regex is searched by all of them at the same time, on
    -- different threads -- what 008's one thread could not show,
    -- and what the ThreadSanitizer run of the gate checks needs no lock.
    -- 8 * 500 = 4000.
    function main(): ExitCode is
        case compile("a+b") of
            when Right(right as regex: Regex) do
                borrow r: &[Regex, rho] := &regex do
                    case openLending(r) of
                        when Some(value as opened: Lending[rho]) do
                            var scope: Lending[rho] := opened;
                            printLn(many(&!scope, r, 8));
                            closeLending(scope);
                        when None do
                            printLn(-2);
                    end case;
                end borrow;
                destroyRegex(regex);
            when Left(left as message: String) do
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
