import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Regex (
    Regex,
    compile,
    match,
    destroyRegex
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    generic [R: Region]
    function probe(regex: &[Regex, R]): Bool is
        let text: String := fromLiteral("xaaby");
        let found: Bool := match(regex, asSpan(&text));
        destroyString(text);
        return found;
    end;

    -- One compiled Regex lent to a task.
    -- The scope is opened and closed inside the borrow, so every task has
    -- ended before the borrow does, and the task only reads an immutable
    -- Regex.  Refused all the same: the check of the tasks looks at the
    -- argument's type and cannot see where the scope closes.
    function main(): ExitCode is
        case compile("a+b") of
            when Right(right as regex: Regex) do
                borrow r: &[Regex, rho] := &regex do
                    case openScope() of
                        when Some(value as opened: Scope) do
                            var scope: Scope := opened;
                            let work: Fn[&[Regex, rho], Bool] := probe;
                            case spawn(&!scope, work, r) of
                                when Right(right as task: Task[Bool]) do
                                    printLn(join(task));
                                when Left(left as back: &[Regex, rho]) do
                                    printLn(false);
                            end case;
                            closeScope(scope);
                        when None do
                            skip;
                    end case;
                end borrow;
                destroyRegex(regex);
            when Left(left as message: String) do
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
