-- An anchored pattern with a literal after its start, on a long text that
-- does not hold the literal.  A search of such a pattern is over after a
-- few bytes; looking for the literal over the whole text first would make
-- each search cost the length of the text.  The programme prints whether
-- 50 searches on 4 MiB took less than a second, and the answers of the
-- pattern where it matches and where the literal comes too late.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Time (
    monotonicNanos
);
import Standard.Regex (
    Regex,
    compile,
    destroyRegex,
    Found,
    find,
    foundStart,
    foundEnd,
    destroyFound
);

module body Test is
    constant size: Index := 4194304;
    constant searches: Index := 50;

    function now(): Nat64 is
        case monotonicNanos() of
            when Some(value as t: Nat64) do
                return t;
            when None do
                return 0;
        end case;
    end;

    function filler(): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < size do
            writeByte(&!out, 'a');
            i := i + 1;
        end while;
        return finalize(out);
    end;

    generic [R: Region]
    function show(re: &[Regex, R], text: Span[Nat8, Static]): Unit is
        case find(re, text) of
            when Some(value as f: Found) do
                print("find ");
                print(foundStart(&f));
                print(" ");
                printLn(foundEnd(&f));
                destroyFound(f);
            when None do
                printLn("find none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case compile("\\A//[^\\n]*") of
            when Right(right as re: Regex) do
                let text: String := filler();
                var found: Index := 0;
                let before: Nat64 := now();
                var k: Index := 0;
                while k < searches do
                    case find(&re, asSpan(&text)) of
                        when Some(value as f: Found) do
                            found := found + 1;
                            destroyFound(f);
                        when None do
                            skip;
                    end case;
                    k := k + 1;
                end while;
                let after: Nat64 := now();
                destroyString(text);
                print("matches in 50 searches: ");
                printLn(found);
                let quick: Bool := (before > 0) and ((after - before) < 1000000000);
                print("50 searches on 4 MiB under a second: ");
                if quick then
                    printLn("true");
                else
                    printLn("false");
                end if;
                show(&re, "//x\nrest");
                show(&re, "a//x");
                destroyRegex(re);
            when Left(left as message: String) do
                printLn("error");
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
