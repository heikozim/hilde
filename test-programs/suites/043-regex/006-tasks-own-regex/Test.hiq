import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Regex (
    Regex,
    compile,
    match,
    destroyRegex
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    yieldNow
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    -- What works: each task compiles
    -- its own Regex and searches with it, yields, and searches again; the
    -- two tasks take turns at the yield -- 11 21 12 22.  Nothing is shared,
    -- so nothing needs a lock.  One Regex for both is test 007, refused.
    function worker(tag: Int32): Int32 is
        case compile("a+b") of
            when Right(right as regex: Regex) do
                let text: String := fromLiteral("xaaby");
                let first: Int32 := widen(match(&regex, asSpan(&text)));
                printLn((tag * 10) + first);
                yieldNow();
                let second: Int32 := widen(match(&regex, asSpan(&text)));
                printLn(((tag * 10) + second) + 1);
                destroyString(text);
                destroyRegex(regex);
                return first + second;
            when Left(left as message: String) do
                destroyString(message);
                return -1;
        end case;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Int32, Int32] := worker;
                case spawn(&!scope, work, 1) of
                    when Right(right as first: Task[Int32]) do
                        case spawn(&!scope, work, 2) of
                            when Right(right as second: Task[Int32]) do
                                printLn(join(first));
                                printLn(join(second));
                            when Left(left as unused: Int32) do
                                printLn(join(first));
                                printLn(-1);
                        end case;
                    when Left(left as unused: Int32) do
                        printLn(-1);
                end case;
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
