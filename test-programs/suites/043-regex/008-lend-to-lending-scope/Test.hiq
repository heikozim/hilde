import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Regex (
    Regex,
    compile,
    match,
    destroyRegex
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join,
    yieldNow
);

module body Test is
    -- What one task is handed: the one Regex, lent, and its tag.
    record Job[R: Region]: Free is
        regex: &[Regex, R];
        tag: Int32;
    end;

    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region]
    function worker(job: Job[R]): Int32 is
        let text: String := fromLiteral("xaaby");
        let first: Int32 := widen(match(job.regex, asSpan(&text)));
        printLn((job.tag * 10) + first);
        yieldNow();
        let second: Int32 := widen(match(job.regex, asSpan(&text)));
        printLn(((job.tag * 10) + second) + 1);
        destroyString(text);
        return first + second;
    end;

    -- one compiled Regex used by two tasks at once, without a lock (point
    -- 64): test 007 with a lending scope instead of a plain one.
    -- Both tasks search with the same Regex, yield, and search again; they
    -- take turns at the yield -- 11 21 12 22 -- as the two tasks of 006
    -- did with a Regex each.
    function main(): ExitCode is
        case compile("a+b") of
            when Right(right as regex: Regex) do
                borrow r: &[Regex, rho] := &regex do
                    case openLending(r) of
                        when Some(value as opened: Lending[rho]) do
                            var scope: Lending[rho] := opened;
                            let work: Fn[Job[rho], Int32] := worker;
                            case spawnLending(&!scope, work, Job(regex => r, tag => 1)) of
                                when Right(right as first: Task[Int32]) do
                                    case spawnLending(&!scope, work, Job(regex => r, tag => 2)) of
                                        when Right(right as second: Task[Int32]) do
                                            closeLending(scope);
                                            printLn(join(first));
                                            printLn(join(second));
                                        when Left(left as back: Job[rho]) do
                                            closeLending(scope);
                                            printLn(join(first));
                                            printLn(-1);
                                    end case;
                                when Left(left as back: Job[rho]) do
                                    closeLending(scope);
                                    printLn(-1);
                            end case;
                        when None do
                            printLn(-2);
                    end case;
                end borrow;
                destroyRegex(regex);
            when Left(left as message: String) do
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
