-- A pattern of 49,000 empty groups stays under the limit of instructions,
-- but every search of it would need a table of some two times 10^10
-- entries.  compile refuses it, as it refuses a program that is too
-- large, rather than leaving the first search to run out of memory.  A
-- pattern of 1,000 groups is taken, which shows where the line lies.
import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.Regex (
    Regex,
    compile,
    destroyRegex,
    groupCount
);

module body Test is
    -- count empty groups, one after the other.
    function groups(count: Index): String is
        var out: StringBuilder := makeStringBuilder();
        var i: Index := 0;
        while i < count do
            writeString(&!out, "()");
            i := i + 1;
        end while;
        return finalize(out);
    end;

    function attempt(count: Index): Unit is
        let pattern: String := groups(count);
        print(count);
        print(" groups: ");
        case compile(asSpan(&pattern)) of
            when Right(right as regex: Regex) do
                print("compiled, ");
                print(groupCount(&regex));
                printLn(" groups");
                destroyRegex(regex);
            when Left(left as message: String) do
                print("refused: ");
                if length(&message) > 0 then
                    printLn(getSpan(&message, 0, length(&message) - 1));
                else
                    printLn("");
                end if;
                destroyString(message);
        end case;
        destroyString(pattern);
        return nil;
    end;

    function main(): ExitCode is
        attempt(1000);
        attempt(49000);
        return ExitSuccess();
    end;
end module body.
