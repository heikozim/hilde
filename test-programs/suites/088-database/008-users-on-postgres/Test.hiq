-- Standard.Users over Standard.DatabaseUsers on PostgreSQL and on SQLite: a
-- user added once and not twice, two names that differ in case kept apart
-- and listed in the order of their bytes, the right and a wrong password,
-- a lock, and a removal.  The output of the two is the same apart from the
-- name of the backend.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Buffer (
    Buffer,
    length,
    nthRef
);
import Standard.File (
    removeFile
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    describe,
    closeDatabase
);
import Standard.Database.Sqlite (
    openSqlite
);
import Standard.Users (
    UserError,
    Verdict,
    Accepted,
    Rejected,
    Locked,
    Throttled,
    defaultAttemptLimits,
    addUser,
    deleteUser,
    listUsers,
    destroyUserNames,
    verify,
    lockUser
);
import Standard.DatabaseUsers (
    DatabaseUsers,
    DatabaseUsersFailed,
    openDatabaseUsers,
    closeDatabaseUsers
);
import DbTest (
    openTestPostgres
);

module body Test is
    function said(label: Span[Nat8, Static], answer: Either[UserError, Bool]): Unit is
        print(label);
        case answer of
            when Right(right as done: Bool) do
                printLn(done);
            when Left(left as error: UserError) do
                printLn("an error");
        end case;
        return nil;
    end;

    function verdict(label: Span[Nat8, Static], answer: Either[UserError, Verdict]): Unit is
        print(label);
        case answer of
            when Right(right as given: Verdict) do
                case given of
                    when Accepted do
                        printLn("accepted");
                    when Rejected do
                        printLn("rejected");
                    when Locked do
                        printLn("locked");
                    when Throttled do
                        printLn("throttled");
                end case;
            when Left(left as error: UserError) do
                printLn("an error");
        end case;
        return nil;
    end;

    generic [R: Region]
    function exercise(users: &![DatabaseUsers, R]): Unit is
        said("add alice: ", addUser(&~users, "alice", "a long password"));
        said("add alice again: ", addUser(&~users, "alice", "another password"));
        said("add Alice: ", addUser(&~users, "Alice", "a third password"));
        case listUsers(&~users) of
            when Right(right as names: Buffer[String]) do
                print("users: ");
                printLn(length(&names));
                for i from 0 to length(&names) - 1 do
                    print("  ");
                    printLn(asSpan(nthRef(&names, i)));
                end for;
                destroyUserNames(names);
            when Left(left as error: UserError) do
                printLn("users: an error");
        end case;
        verdict("right password: ", verify(&~users, "alice", "a long password", "client-1", defaultAttemptLimits(), 1000));
        verdict("wrong password: ", verify(&~users, "alice", "not the password", "client-2", defaultAttemptLimits(), 1000));
        said("lock alice: ", lockUser(&~users, "alice"));
        verdict("right password, locked: ", verify(&~users, "alice", "a long password", "client-1", defaultAttemptLimits(), 1001));
        said("delete Alice: ", deleteUser(&~users, "Alice"));
        said("delete Alice again: ", deleteUser(&~users, "Alice"));
        return nil;
    end;

    function run(label: Span[Nat8, Static], db: Database[Writing]): Unit is
        printLn(label);
        case openDatabaseUsers(db) of
            when Right(right as opened: DatabaseUsers) do
                var users: DatabaseUsers := opened;
                exercise(&!users);
                closeDatabase(closeDatabaseUsers(users));
            when Left(left as failed: DatabaseUsersFailed) do
                let { db as back: Database[Writing], error as why: UserError } := failed;
                printLn("the store did not open");
                closeDatabase(back);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        let path: String := fromLiteral("users-on-postgres.db");
        let gone: Bool := removeFile(asSpan(&path));
        case openSqlite(asSpan(&path)) of
            when Right(right as db: Database[Writing]) do
                run("sqlite", db);
            when Left(left as error: DbError) do
                printLn(describe(error));
        end case;
        let removed: Bool := removeFile(asSpan(&path));
        destroyString(path);
        case openTestPostgres() of
            when Right(right as db: Database[Writing]) do
                run("postgres", db);
            when Left(left as error: DbError) do
                printLn(describe(error));
        end case;
        return ExitSuccess();
    end;
end module body.
