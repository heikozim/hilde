-- openSqlite requires a path: an empty one is the caller's fault, and the
-- contract stops the programme before a file is touched.
import Standard.Database (
    Database,
    Writing,
    DbError,
    closeDatabase
);
import Standard.Database.Sqlite (
    openSqlite
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openSqlite("") of
            when Left(left as error: DbError) do
                printLn("refused");
            when Right(right as db: Database[Writing]) do
                closeDatabase(db);
        end case;
        printLn("after");
        return ExitSuccess();
    end;
end module body.
