-- A column is read by an index of 0 or more: columnInt64 requires it, and
-- a negative index stops the programme.  The same row read at column 0
-- first shows the cursor is good.
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    closeDatabase,
    noValues,
    start,
    advance,
    columnInt64,
    finish
);
import Standard.Database.Sqlite (
    openSqlite
);

module body Test is
    function main(): ExitCode is
        case openSqlite("negative.db") of
            when Left(left as error: DbError) do
                printLn("not opened");
            when Right(right as opened: Database[Writing]) do
                var db: Database[Writing] := opened;
                var rows: Cursor := start(&!db, "SELECT 7", noValues());
                if advance(&!rows) then
                    print("column 0: ");
                    printLn(columnInt64(&rows, 0));
                    print("column -1: ");
                    printLn(columnInt64(&rows, -1));
                end if;
                let failure: Option[DbError] := finish(&!db, rows);
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
