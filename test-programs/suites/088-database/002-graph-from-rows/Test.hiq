-- A graph read from two statements of a SQLite database: four nodes, one of
-- them twice in the rows, four edges, one of them to an id that is no node.
-- Each database id finds its node, and the node holds the id.
import Standard.Graph (
    Graph,
    NodeId,
    nodeCount,
    edgeCount,
    nodeValue,
    destroyFree as destroyGraph
);
import Standard.HashMap (
    HashMap,
    get as mapGet,
    destroyFree as destroyMap
);
import Standard.Order (
    TotalOrder
);
import Standard.Hash (
    Hashable
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    Cursor,
    LoadedGraph,
    describe,
    closeDatabase,
    migrate,
    noValues,
    withInt64,
    withFloat64,
    start,
    execute,
    finish,
    graphFromRows
);
import Standard.Database.Sqlite (
    openSqlite
);

module body Test is
    constant migrations: Span[Nat8, Static] := "127\nCREATE TABLE places (id int8 PRIMARY KEY); CREATE TABLE roads (tail int8 NOT NULL, head int8 NOT NULL, weight float8 NOT NULL);";

    function report(result: Either[DbError, Nat64]): Unit is
        case result of
            when Left(left as error: DbError) do
                printLn(describe(error));
            when Right(right as count: Nat64) do
                skip;
        end case;
        return nil;
    end;

    generic [R: Region]
    function fill(db: &![Database[Writing], R]): Unit is
        case migrate(&~db, migrations) of
            when Left(left as error: DbError) do
                printLn(describe(error));
            when Right(right as applied: Index) do
                skip;
        end case;
        report(execute(&~db, "INSERT INTO places (id) VALUES (10), (20), (30), (40)", noValues()));
        report(execute(&~db, "INSERT INTO roads (tail, head, weight) VALUES (?, ?, ?)", withFloat64(withInt64(withInt64(noValues(), 10), 20), 1.5)));
        report(execute(&~db, "INSERT INTO roads (tail, head, weight) VALUES (?, ?, ?)", withFloat64(withInt64(withInt64(noValues(), 20), 30), 2.5)));
        report(execute(&~db, "INSERT INTO roads (tail, head, weight) VALUES (?, ?, ?)", withFloat64(withInt64(withInt64(noValues(), 30), 40), 3.5)));
        report(execute(&~db, "INSERT INTO roads (tail, head, weight) VALUES (?, ?, ?)", withFloat64(withInt64(withInt64(noValues(), 40), 99), 9.5)));
        return nil;
    end;

    generic [R: Region, S: Region]
    function lookUp(ids: &[HashMap[Int64, NodeId], R], graph: &[Graph[Int64, Float64], S], id: Int64): Unit is
        print("id ");
        print(id);
        case mapGet(ids, &id) of
            when Some(value as node: NodeId) do
                case nodeValue(graph, node) of
                    when Some(value as held: Int64) do
                        print(": node holds ");
                        printLn(held);
                    when None do
                        printLn(": node not in the graph");
                end case;
            when None do
                printLn(": no node");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openSqlite("graph.db") of
            when Left(left as error: DbError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Database[Writing]) do
                var db: Database[Writing] := opened;
                fill(&!db);
                var nodes: Cursor := start(&!db, "SELECT id FROM places UNION ALL SELECT 20 ORDER BY 1", noValues());
                var edges: Cursor := start(&!db, "SELECT tail, head, weight FROM roads ORDER BY tail", noValues());
                let loaded: LoadedGraph := graphFromRows(&!nodes, &!edges);
                case finish(&!db, nodes) of
                    when Some(value as error: DbError) do
                        printLn(describe(error));
                    when None do
                        skip;
                end case;
                case finish(&!db, edges) of
                    when Some(value as error: DbError) do
                        printLn(describe(error));
                    when None do
                        skip;
                end case;
                closeDatabase(db);
                let { graph: Graph[Int64, Float64], nodes as ids: HashMap[Int64, NodeId], duplicateNodes: Index, unknownEnds: Index } := loaded;
                print("nodes ");
                printLn(nodeCount(&graph));
                print("edges ");
                printLn(edgeCount(&graph));
                print("duplicate nodes ");
                printLn(duplicateNodes);
                print("unknown ends ");
                printLn(unknownEnds);
                borrow g: &[Graph[Int64, Float64], rho] := &graph do
                    borrow m: &[HashMap[Int64, NodeId], gamma] := &ids do
                        lookUp(m, g, 10);
                        lookUp(m, g, 40);
                        lookUp(m, g, 99);
                    end borrow;
                end borrow;
                destroyGraph(graph);
                destroyMap(ids);
                return ExitSuccess();
        end case;
    end;
end module body.
