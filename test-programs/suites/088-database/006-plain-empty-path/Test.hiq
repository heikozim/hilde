-- openPlainWriter of Standard.SqlCipher requires a path, as the open with a
-- key does: an empty one stops the programme.
import Standard.SqlCipher (
    Connection,
    Writing,
    SqlError,
    openPlainWriter,
    closeDatabase
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openPlainWriter("") of
            when Left(left as error: SqlError) do
                printLn("refused");
            when Right(right as db: Connection[Writing]) do
                closeDatabase(db);
        end case;
        printLn("after");
        return ExitSuccess();
    end;
end module body.
