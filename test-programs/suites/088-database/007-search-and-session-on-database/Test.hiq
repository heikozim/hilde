-- Standard.Search and Standard.Session in one programme with
-- Standard.Database on SQLCipher: the three build together, and an index
-- and a session are made and read in an encrypted file.
import Standard.SqlCipher (
    makeKey
);
import Standard.Database (
    Database,
    Writing,
    DbError,
    closeDatabase
);
import Standard.Database.Sqlite (
    openSqlCipher
);
import Standard.Search (
    SearchError,
    prepareSearch,
    indexDocument,
    countMatches
);
import Standard.Session (
    SessionError,
    SessionLimits,
    defaultSessionLimits,
    prepareSessions,
    createSession,
    loadSession
);
import Standard.String (
    String,
    destroyString,
    asSpan
);

module body Test is
    function main(): ExitCode is
        case openSqlCipher("both.db", makeKey("a key for both")) of
            when Right(right as opened: Database[Writing]) do
                var db: Database[Writing] := opened;
                case prepareSearch(&!db) of
                    when Right(right as done: Unit) do
                        printLn("index prepared");
                    when Left(left as error: SearchError) do
                        printLn("no index");
                end case;
                case indexDocument(&!db, "doc/1", "Coffee", "A cafe serves coffee late.") of
                    when Right(right as done: Unit) do
                        printLn("indexed");
                    when Left(left as error: SearchError) do
                        printLn("not indexed");
                end case;
                case countMatches(&!db, "coffee") of
                    when Right(right as count: Int64) do
                        printLn(count);
                    when Left(left as error: SearchError) do
                        printLn("no count");
                end case;
                case prepareSessions(&!db) of
                    when Right(right as done: Unit) do
                        printLn("sessions prepared");
                    when Left(left as error: SessionError) do
                        printLn("no sessions");
                end case;
                case createSession(&!db, "user=1", 1000) of
                    when Right(right as token: String) do
                        case loadSession(&!db, asSpan(&token), defaultSessionLimits(), 1001) of
                            when Right(right as found: Option[String]) do
                                case found of
                                    when Some(value as data: String) do
                                        printLn("session loaded");
                                        destroyString(data);
                                    when None do
                                        printLn("session lost");
                                end case;
                            when Left(left as error: SessionError) do
                                printLn("load failed");
                        end case;
                        destroyString(token);
                    when Left(left as error: SessionError) do
                        printLn("no session");
                end case;
                closeDatabase(db);
            when Left(left as error: DbError) do
                printLn("no database");
        end case;
        return ExitSuccess();
    end;
end module body.
