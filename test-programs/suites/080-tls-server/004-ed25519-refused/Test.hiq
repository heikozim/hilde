-- Standard.Tls refuses an Ed25519 key before libtls is asked, from memory
-- and from a file, for a server and for a client; a P-521 key of the same
-- form is taken, so the refusal is the kind of the key and nothing else.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.File (
    FileDescriptor,
    openWrite,
    writeAll,
    closeFile,
    removeFile
);
import Standard.Tls (
    Client,
    Server,
    connectAs,
    closeClient,
    makeServer,
    makeServerFromMemory,
    closeServer
);
import Standard.X509 (
    KeyKind,
    PrivateKey,
    Certificate,
    EcP521,
    Ed25519Key,
    generateKey,
    privateKeyToPem,
    destroyPrivateKey,
    certificateToPem,
    destroyCertificate,
    selfSigned
);

module body Test is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    generic [R: Region]
    function writeFile(name: Span[Nat8, Static], text: &[String, R]): Bool is
        case openWrite(name) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, asSpan(text));
                return closeFile(file) and written;
            when None do
                return false;
        end case;
    end;

    function server(label: Span[Nat8, Static], made: Either[String, Server]): Unit is
        print(label);
        case made of
            when Left(left as message: String) do
                print(": refused: ");
                printText(&message);
                printLn("");
                destroyString(message);
            when Right(right as taken: Server) do
                printLn(": taken");
                closeServer(taken);
        end case;
        return nil;
    end;

    function client(label: Span[Nat8, Static], made: Either[String, Client]): Unit is
        print(label);
        case made of
            when Left(left as message: String) do
                print(": refused: ");
                printText(&message);
                printLn("");
                destroyString(message);
            when Right(right as taken: Client) do
                printLn(": connected");
                closeClient(taken);
        end case;
        return nil;
    end;

    -- A key of kind with a certificate it signs itself, tried from memory,
    -- from files and as the key of a client; the files are removed again.
    function tryKind(name: Span[Nat8, Static], kind: KeyKind): Unit is
        case generateKey(kind) of
            when Some(value as key: PrivateKey) do
                case selfSigned(&key, "localhost", "localhost", 2, false) of
                    when Some(value as certificate: Certificate) do
                        case privateKeyToPem(&key) of
                            when Some(value as key_pem: String) do
                                case certificateToPem(&certificate) of
                                    when Some(value as certificate_pem: String) do
                                        print(name);
                                        server(" server from memory", makeServerFromMemory(asSpan(&certificate_pem), asSpan(&key_pem)));
                                        let wrote: Bool := writeFile("tls-key.pem", &key_pem) and writeFile("tls-certificate.pem", &certificate_pem);
                                        if wrote then
                                            print(name);
                                            server(" server from files", makeServer("tls-certificate.pem", "tls-key.pem"));
                                            print(name);
                                            client(" client", connectAs("localhost", "1", "tls-certificate.pem", "tls-certificate.pem", "tls-key.pem"));
                                        else
                                            printLn("the files were not written");
                                        end if;
                                        let gone: Bool := removeFile("tls-key.pem") and removeFile("tls-certificate.pem");
                                        destroyString(certificate_pem);
                                    when None do
                                        printLn("no PEM of the certificate");
                                end case;
                                destroyString(key_pem);
                            when None do
                                printLn("no PEM of the key");
                        end case;
                        destroyCertificate(certificate);
                    when None do
                        printLn("no certificate");
                end case;
                destroyPrivateKey(key);
            when None do
                printLn("no key");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        tryKind("Ed25519", Ed25519Key());
        tryKind("P-521", EcP521());
        return ExitSuccess();
    end;
end module body.
