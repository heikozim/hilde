module body Test is
    function main(): ExitCode is
        let a: Int16 := minimum_int16;
        let b: Int16 := 1;
        let c: Int16 := a + b;
        let d: Int16 := -c;
        if d = maximum_int16 then
            printLn("ok");
            return ExitSuccess();
        end if;
        abort("the negation of the minimum plus one is not the maximum");
        return ExitFailure();
    end;
end module body.
