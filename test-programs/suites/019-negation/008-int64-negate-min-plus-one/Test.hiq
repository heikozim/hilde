module body Test is
    function main(): ExitCode is
        let a: Int64 := minimum_int64;
        let b: Int64 := 1;
        let c: Int64 := a + b;
        let d: Int64 := -c;
        if d = maximum_int64 then
            printLn("ok");
            return ExitSuccess();
        end if;
        abort("the negation of the minimum plus one is not the maximum");
        return ExitFailure();
    end;
end module body.
