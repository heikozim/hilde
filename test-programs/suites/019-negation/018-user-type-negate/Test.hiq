module body Test is
    record Money: Free is
        cents: Int32;
    end;

    instance TrappingNegation(Money) is
        method trappingNegate(value: Money): Money is
            return Money(cents => 0 - value.cents);
        end;
    end;

    function main(): ExitCode is
        let m: Money := Money(cents => 5);
        let o: Money := -m;
        printLn(o.cents);
        return ExitSuccess();
    end;
end module body.
