module body Test is
    function main(): ExitCode is
        let a: Int32 := minimum_int32;
        let b: Int32 := 1;
        let c: Int32 := a + b;
        let d: Int32 := -c;
        if d = maximum_int32 then
            printLn("ok");
            return ExitSuccess();
        end if;
        abort("the negation of the minimum plus one is not the maximum");
        return ExitFailure();
    end;
end module body.
