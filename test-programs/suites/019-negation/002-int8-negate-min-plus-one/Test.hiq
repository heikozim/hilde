module body Test is
    function main(): ExitCode is
        let a: Int8 := minimum_int8;
        let b: Int8 := 1;
        let c: Int8 := a + b;
        let d: Int8 := -c;
        if d = maximum_int8 then
            printLn("ok");
            return ExitSuccess();
        end if;
        abort("the negation of the minimum plus one is not the maximum");
        return ExitFailure();
    end;
end module body.
