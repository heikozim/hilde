import Standard.Graph (
    Graph,
    NodeId,
    makeGraph,
    destroyFree,
    addNode,
    containsNode
);

module body Test is
    -- Built with HILDE_SERIAL_NEAR_WRAP, the count of graphs starts two
    -- below the largest Nat64: the first graph gets the largest number but
    -- one, the second the largest, and the third would get 0.  The first
    -- node of each graph has the same slot and generation, so only the
    -- numbers of the two graphs keep them apart.  Making the third graph
    -- stops the programme.
    function main(): ExitCode is
        let one: Nat32 := 1;
        let two: Nat32 := 2;
        var first: Graph[Nat32, Nat32] := makeGraph();
        let a: NodeId := addNode(&!first, one);
        var second: Graph[Nat32, Nat32] := makeGraph();
        let b: NodeId := addNode(&!second, two);
        if containsNode(&first, a) then
            printLn("first holds its node");
        else
            printLn("first does not hold its node");
        end if;
        if containsNode(&second, a) then
            printLn("second holds the node of first");
        else
            printLn("second does not hold the node of first");
        end if;
        if containsNode(&first, b) then
            printLn("first holds the node of second");
        else
            printLn("first does not hold the node of second");
        end if;
        destroyFree(first);
        destroyFree(second);
        printLn("making a third graph");
        let third: Graph[Nat32, Nat32] := makeGraph();
        destroyFree(third);
        printLn("the third graph was made");
        return ExitSuccess();
    end;
end module body.
