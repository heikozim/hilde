import Standard.Tuples (
    Pair
);
import Standard.Buffer (
    Buffer,
    length,
    destroyFree as destroyFreeBuffer
);
import Standard.Graph (
    Graph,
    NodeId,
    EdgeId,
    NoPath,
    makeGraph,
    destroyFree,
    addNode,
    addEdge,
    removeNode,
    lightestPath
);

module body Test is
    generic [R: Region]
    function road(g: &![Graph[Nat8, Nat64], R], source: NodeId, target: NodeId, weight: Nat64): Unit is
        case addEdge(g, source, target, weight) of
            when Right(right as edge: EdgeId) do
                skip;
            when Left(left as back: Nat64) do
                abort("addEdge refused two nodes of the graph");
        end case;
        return nil;
    end;

    -- What lightestPath answered, on one line: the sum and the number of
    -- edges, or the reason there is no path.
    function printAnswer(label: Span[Nat8, Static], found: Either[NoPath, Pair[Nat64, Buffer[EdgeId]]]): Unit is
        print(label);
        case found of
            when Right(right as p: Pair[Nat64, Buffer[EdgeId]]) do
                let { first: Nat64, second: Buffer[EdgeId] } := p;
                print(first);
                print(", edges: ");
                printLn(length(&second));
                destroyFreeBuffer(second);
            when Left(left as reason: NoPath) do
                case reason of
                    when UnknownNode do
                        printLn("unknown node");
                    when Unreachable do
                        printLn("unreachable");
                    when TooHeavy do
                        printLn("too heavy");
                end case;
        end case;
        return nil;
    end;

    -- The only way from s to y weighs one more than the largest Nat64, and
    -- no way leads to z.  The two answers differ, neither stops the
    -- programme, and a number whose node was removed is a third answer.
    function main(): ExitCode is
        var g: Graph[Nat8, Nat64] := makeGraph();
        let s: NodeId := addNode(&!g, 's' : Nat8);
        let x: NodeId := addNode(&!g, 'x' : Nat8);
        let y: NodeId := addNode(&!g, 'y' : Nat8);
        let z: NodeId := addNode(&!g, 'z' : Nat8);
        road(&!g, s, x, maximum_nat64);
        road(&!g, x, y, 1);
        printAnswer("s to x: ", lightestPath(&g, s, x));
        printAnswer("s to y: ", lightestPath(&g, s, y));
        printAnswer("s to z: ", lightestPath(&g, s, z));
        case removeNode(&!g, z) of
            when Some(value as p: Pair[Nat8, Buffer[Nat64]]) do
                let { first: Nat8, second: Buffer[Nat64] } := p;
                destroyFreeBuffer(second);
            when None do
                printLn("z was not in the graph");
        end case;
        printAnswer("s to z after z was removed: ", lightestPath(&g, s, z));
        destroyFree(g);
        return ExitSuccess();
    end;
end module body.
