import Standard.String (
    String,
    fromLiteral
);
import Standard.Graph (
    Graph,
    NodeId,
    makeGraph,
    destroyEmpty,
    addNode
);

module body Test is
    -- A graph that still holds a town given to destroyEmpty: the name
    -- would be lost, so the programme stops.
    function main(): ExitCode is
        var g: Graph[String, Nat32] := makeGraph();
        let town: NodeId := addNode(&!g, fromLiteral("Aachen"));
        destroyEmpty(g);
        return ExitSuccess();
    end;
end module body.
