--
-- A road map of seven towns: the walks, the searches, a cycle, and a town
-- removed and its slot taken again.  Two towns have no road leading in, so
-- the topological order shows how such a tie is broken.  Every line of the
-- output is fixed by the calls that built the graph, so the expected
-- output holds on every run and every platform.
import Standard.Tuples (
    Pair
);
import Standard.Buffer (
    Buffer,
    length,
    nth,
    destroyFree as destroyFreeBuffer
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as stringLength,
    getSpan
);
import Standard.Graph (
    Graph,
    NodeId,
    EdgeId,
    NoPath,
    makeGraph,
    destroyEmpty,
    nodeSlot,
    nodeGeneration,
    edgeCount,
    nodeRef,
    edgeSource,
    edgeTarget,
    addNode,
    addEdge,
    removeNode,
    nodes,
    outEdges,
    breadthFirst,
    depthFirst,
    hasPath,
    shortestPath,
    lightestPath,
    findCycle,
    topologicalOrder
);

module body Test is
    generic [R: Region]
    function road(g: &![Graph[String, Nat32], R], source: NodeId, target: NodeId, kilometres: Nat32): Unit is
        case addEdge(g, source, target, kilometres) of
            when Right(right as edge: EdgeId) do
                skip;
            when Left(left as back: Nat32) do
                abort("addEdge refused two towns of the map");
        end case;
        return nil;
    end;

    generic [R: Region]
    function printName(g: &[Graph[String, Nat32], R], node: NodeId): Unit is
        case nodeRef(g, node) of
            when Some(value as name: &[String, R]) do
                print(getSpan(name, 0, stringLength(name) - 1));
            when None do
                print("none");
        end case;
        return nil;
    end;

    generic [R: Region]
    function printSource(g: &[Graph[String, Nat32], R], edge: EdgeId): Unit is
        case edgeSource(g, edge) of
            when Some(value as node: NodeId) do
                printName(g, node);
            when None do
                print("none");
        end case;
        return nil;
    end;

    generic [R: Region]
    function printTarget(g: &[Graph[String, Nat32], R], edge: EdgeId): Unit is
        case edgeTarget(g, edge) of
            when Some(value as node: NodeId) do
                printName(g, node);
            when None do
                print("none");
        end case;
        return nil;
    end;

    generic [R: Region, S: Region]
    function printNodes(g: &[Graph[String, Nat32], R], label: Span[Nat8, Static], ids: &[Buffer[NodeId], S]): Unit is
        print(label);
        var i: Index := 0;
        while i < length(ids) do
            print(" ");
            printName(g, nth(ids, i));
            i := i + 1;
        end while;
        printLn("");
        return nil;
    end;

    generic [R: Region]
    function printOrder(g: &[Graph[String, Nat32], R], label: Span[Nat8, Static], found: Option[Buffer[NodeId]]): Unit is
        case found of
            when Some(value as ids: Buffer[NodeId]) do
                printNodes(g, label, &ids);
                destroyFreeBuffer(ids);
            when None do
                print(label);
                printLn(" none");
        end case;
        return nil;
    end;

    -- A path or a cycle: the town each edge leaves, then the town the last
    -- one enters.
    generic [R: Region, S: Region]
    function printWalk(g: &[Graph[String, Nat32], R], ids: &[Buffer[EdgeId], S]): Unit is
        var i: Index := 0;
        while i < length(ids) do
            print(" ");
            printSource(g, nth(ids, i));
            i := i + 1;
        end while;
        if length(ids) > 0 then
            print(" ");
            printTarget(g, nth(ids, length(ids) - 1));
        end if;
        return nil;
    end;

    generic [R: Region]
    function printTargets(g: &[Graph[String, Nat32], R], label: Span[Nat8, Static], found: Option[Buffer[EdgeId]]): Unit is
        print(label);
        case found of
            when Some(value as ids: Buffer[EdgeId]) do
                var i: Index := 0;
                while i < length(&ids) do
                    print(" ");
                    printTarget(g, nth(&ids, i));
                    i := i + 1;
                end while;
                destroyFreeBuffer(ids);
            when None do
                print(" none");
        end case;
        printLn("");
        return nil;
    end;

    generic [R: Region]
    function printPath(g: &[Graph[String, Nat32], R], label: Span[Nat8, Static], found: Option[Buffer[EdgeId]]): Unit is
        print(label);
        case found of
            when Some(value as path: Buffer[EdgeId]) do
                printWalk(g, &path);
                destroyFreeBuffer(path);
            when None do
                print(" none");
        end case;
        printLn("");
        return nil;
    end;

    generic [R: Region]
    function printLightest(g: &[Graph[String, Nat32], R], label: Span[Nat8, Static], found: Either[NoPath, Pair[Nat64, Buffer[EdgeId]]]): Unit is
        print(label);
        case found of
            when Right(right as p: Pair[Nat64, Buffer[EdgeId]]) do
                let { first: Nat64, second: Buffer[EdgeId] } := p;
                printWalk(g, &second);
                print(", ");
                print(first);
                print(" km");
                destroyFreeBuffer(second);
            when Left(left as reason: NoPath) do
                print(" none");
        end case;
        printLn("");
        return nil;
    end;

    generic [R: Region]
    function printCycle(g: &[Graph[String, Nat32], R]): Unit is
        print("cycle:");
        case findCycle(g) of
            when Some(value as cycle: Buffer[EdgeId]) do
                printWalk(g, &cycle);
                destroyFreeBuffer(cycle);
            when None do
                print(" none");
        end case;
        printLn("");
        return nil;
    end;

    generic [R: Region]
    function printTopological(g: &[Graph[String, Nat32], R]): Unit is
        case topologicalOrder(g) of
            when Right(right as order: Buffer[NodeId]) do
                printNodes(g, "order:", &order);
                destroyFreeBuffer(order);
            when Left(left as cycle: Buffer[EdgeId]) do
                print("order: none, cycle:");
                printWalk(g, &cycle);
                printLn("");
                destroyFreeBuffer(cycle);
        end case;
        return nil;
    end;

    generic [R: Region]
    function printReach(g: &[Graph[String, Nat32], R], label: Span[Nat8, Static], start: NodeId, goal: NodeId): Unit is
        print(label);
        if hasPath(g, start, goal) then
            printLn("true");
        else
            printLn("false");
        end if;
        return nil;
    end;

    generic [R: Region]
    function printAll(g: &[Graph[String, Nat32], R]): Unit is
        let all: Buffer[NodeId] := nodes(g);
        printNodes(g, "nodes:", &all);
        destroyFreeBuffer(all);
        return nil;
    end;

    -- Every town taken out, its name and its roads given back, so that the
    -- map is empty for destroyEmpty.
    generic [R: Region]
    function empty(g: &![Graph[String, Nat32], R]): Unit is
        let all: Buffer[NodeId] := nodes(&g);
        var i: Index := 0;
        while i < length(&all) do
            case removeNode(&~g, nth(&all, i)) of
                when Some(value as p: Pair[String, Buffer[Nat32]]) do
                    let { first: String, second: Buffer[Nat32] } := p;
                    destroyString(first);
                    destroyFreeBuffer(second);
                when None do
                    abort("a listed town was not on the map");
            end case;
            i := i + 1;
        end while;
        destroyFreeBuffer(all);
        return nil;
    end;

    function main(): ExitCode is
        var g: Graph[String, Nat32] := makeGraph();
        let aachen: NodeId := addNode(&!g, fromLiteral("Aachen"));
        let bonn: NodeId := addNode(&!g, fromLiteral("Bonn"));
        let cologne: NodeId := addNode(&!g, fromLiteral("Cologne"));
        let dortmund: NodeId := addNode(&!g, fromLiteral("Dortmund"));
        let essen: NodeId := addNode(&!g, fromLiteral("Essen"));
        let frankfurt: NodeId := addNode(&!g, fromLiteral("Frankfurt"));
        let bochum: NodeId := addNode(&!g, fromLiteral("Bochum"));
        road(&!g, aachen, cologne, 70);
        road(&!g, aachen, bonn, 90);
        road(&!g, cologne, bonn, 30);
        road(&!g, cologne, dortmund, 95);
        road(&!g, bonn, frankfurt, 175);
        road(&!g, dortmund, essen, 40);
        road(&!g, essen, frankfurt, 250);
        road(&!g, cologne, frankfurt, 200);
        road(&!g, bochum, essen, 20);
        printAll(&g);
        printTargets(&g, "out of Cologne:", outEdges(&g, cologne));
        printOrder(&g, "breadth first from Aachen:", breadthFirst(&g, aachen));
        printOrder(&g, "depth first from Aachen:", depthFirst(&g, aachen));
        printPath(&g, "fewest edges Aachen to Frankfurt:", shortestPath(&g, aachen, frankfurt));
        printLightest(&g, "lightest Aachen to Frankfurt:", lightestPath(&g, aachen, frankfurt));
        printTopological(&g);
        printCycle(&g);
        printLn("after Frankfurt to Aachen:");
        road(&!g, frankfurt, aachen, 260);
        printCycle(&g);
        printTopological(&g);
        case removeNode(&!g, cologne) of
            when Some(value as p: Pair[String, Buffer[Nat32]]) do
                let { first: String, second: Buffer[Nat32] } := p;
                print("removed ");
                print(getSpan(&first, 0, stringLength(&first) - 1));
                print(" with ");
                print(length(&second));
                print(" edges:");
                var i: Index := 0;
                while i < length(&second) do
                    print(" ");
                    print(nth(&second, i));
                    i := i + 1;
                end while;
                printLn("");
                destroyString(first);
                destroyFreeBuffer(second);
            when None do
                printLn("Cologne was not on the map");
        end case;
        print("edges left: ");
        printLn(edgeCount(&g));
        print("Cologne's number: ");
        printName(&g, cologne);
        printLn("");
        printReach(&g, "Aachen reaches Dortmund: ", aachen, dortmund);
        let hamm: NodeId := addNode(&!g, fromLiteral("Hamm"));
        print("Hamm: slot ");
        print(nodeSlot(hamm));
        print(", generation ");
        printLn(nodeGeneration(hamm));
        print("Cologne's number after Hamm: ");
        printName(&g, cologne);
        printLn("");
        road(&!g, hamm, dortmund, 45);
        road(&!g, aachen, hamm, 120);
        printReach(&g, "Aachen reaches Dortmund: ", aachen, dortmund);
        printLightest(&g, "lightest Aachen to Essen:", lightestPath(&g, aachen, essen));
        printAll(&g);
        empty(&!g);
        destroyEmpty(g);
        return ExitSuccess();
    end;
end module body.
