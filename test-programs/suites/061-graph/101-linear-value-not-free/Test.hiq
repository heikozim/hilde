import Standard.String (
    String,
    fromLiteral
);
import Standard.Graph (
    Graph,
    NodeId,
    makeGraph,
    destroyFree,
    addNode
);

module body Test is
    -- A graph of Strings dropped whole with destroyFree: the String would
    -- be lost, and String is linear, so it must not compile.
    function main(): ExitCode is
        var g: Graph[String, Nat32] := makeGraph();
        let town: NodeId := addNode(&!g, fromLiteral("Aachen"));
        destroyFree(g);
        return ExitSuccess();
    end;
end module body.
