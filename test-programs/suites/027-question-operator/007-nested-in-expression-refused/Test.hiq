module body Test is
    function half(n: Int32): Option[Int32] is
        if n > 0 then
            return Some(value => n / 2);
        else
            return None();
        end if;
    end;

    function bad(n: Int32): Option[Int32] is
        let a: Int32 := 1 + half(n)?;
        return Some(value => a);
    end;

    function main(): ExitCode is
        case bad(8) of
            when Some(value: Int32) do
                printLn(value);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
