module body Test is
    function half(n: Int32): Option[Int32] is
        if n > 0 then
            return Some(value => n / 2);
        else
            return None();
        end if;
    end;

    function quarter(n: Int32): Option[Int32] is
        let a: Int32 := half(n)?;
        let b: Int32 := half(a)?;
        return Some(value => b);
    end;

    function show(o: Option[Int32]): Int32 is
        case o of
            when Some(value: Int32) do
                return value;
            when None do
                let z: Int32 := -1;
                return z;
        end case;
    end;

    function main(): ExitCode is
        let x: Int32 := show(quarter(100));
        printLn(x);
        let y: Int32 := show(quarter(-4));
        printLn(y);
        return ExitSuccess();
    end;
end module body.
