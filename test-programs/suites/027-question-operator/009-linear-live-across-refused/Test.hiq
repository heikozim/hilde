module body Test is
    record R: Linear is
        x: Int32;
    end;

    function half(n: Int32): Option[Int32] is
        if n > 0 then
            return Some(value => n / 2);
        else
            return None();
        end if;
    end;

    function use(n: Int32): Option[Int32] is
        let r: R := R(x => 1);
        let a: Int32 := half(n)?;
        let { x: Int32 } := r;
        return Some(value => a + x);
    end;

    function main(): ExitCode is
        case use(8) of
            when Some(value: Int32) do
                printLn(value);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
