module body Test is
    function positive(n: Int32): Either[Int32, Int32] is
        if n > 0 then
            return Right(right => n);
        else
            return Left(left => n);
        end if;
    end;

    function bad(n: Int32): Either[Bool, Int32] is
        let a: Int32 := positive(n)?;
        return Right(right => a);
    end;

    function main(): ExitCode is
        case bad(3) of
            when Left(left: Bool) do
                skip;
            when Right(right: Int32) do
                printLn(right);
        end case;
        return ExitSuccess();
    end;
end module body.
