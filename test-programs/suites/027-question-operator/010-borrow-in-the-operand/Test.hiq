module body Test is
    record Box: Free is
        n: Int32;
    end;

    record Item: Linear is
        x: Int32;
    end;

    -- An item with the count of the box, which then counts one up; none
    -- while the count is not above 0.
    generic [R: Region]
    function item(w: &![Box, R]): Option[Item] is
        let n: Int32 := w->n;
        if n <= 0 then
            return None();
        end if;
        w->n := n + 1;
        return Some(value => Item(x => n));
    end;

    generic [R: Region]
    function bump(w: &![Box, R]): Unit is
        w->n := w->n + 1;
        return nil;
    end;

    -- A borrow of a local in the operand of the operator, and a linear
    -- payload bound by it.
    function viaBorrow(n: Int32): Option[Int32] is
        var box: Box := Box(n => n);
        let i: Item := item(&!box)?;
        let { x: Int32 } := i;
        return Some(value => x);
    end;

    -- A reborrow of a reference parameter in the operand; the reference is
    -- used again after the operator, so the borrow has ended there.
    generic [R: Region]
    function viaReborrow(w: &![Box, R]): Option[Int32] is
        let i: Item := item(&~w)?;
        bump(&~w);
        let { x: Int32 } := i;
        return Some(value => x);
    end;

    -- The count of the box while it is above 0, else none.
    generic [R: Region]
    function positive(w: &![Box, R]): Option[Int32] is
        let n: Int32 := w->n;
        if n <= 0 then
            return None();
        end if;
        return Some(value => n);
    end;

    -- The operator as a whole statement, with a borrow in its operand.
    function viaStatement(n: Int32): Option[Int32] is
        var box: Box := Box(n => n);
        positive(&!box)?;
        return Some(value => box.n);
    end;

    function show(o: Option[Int32]): Int32 is
        case o of
            when Some(value: Int32) do
                return value;
            when None do
                let z: Int32 := -1;
                return z;
        end case;
    end;

    function main(): ExitCode is
        printLn(show(viaBorrow(3)));
        var b: Box := Box(n => 4);
        printLn(show(viaReborrow(&!b)));
        printLn(show(viaBorrow(0)));
        var z: Box := Box(n => 0);
        printLn(show(viaReborrow(&!z)));
        printLn(show(viaStatement(5)));
        printLn(show(viaStatement(0)));
        return ExitSuccess();
    end;
end module body.
