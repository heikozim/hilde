module body Test is
    function positive(n: Int32): Either[Int32, Int32] is
        if n > 0 then
            return Right(right => n);
        else
            return Left(left => n);
        end if;
    end;

    function sum(a: Int32, b: Int32): Either[Int32, Int32] is
        let x: Int32 := positive(a)?;
        let y: Int32 := positive(b)?;
        return Right(right => x + y);
    end;

    function show(e: Either[Int32, Int32]): Int32 is
        case e of
            when Left(left: Int32) do
                return left;
            when Right(right: Int32) do
                return right;
        end case;
    end;

    function main(): ExitCode is
        let p: Int32 := show(sum(3, 4));
        printLn(p);
        let q: Int32 := show(sum(3, -9));
        printLn(q);
        return ExitSuccess();
    end;
end module body.
