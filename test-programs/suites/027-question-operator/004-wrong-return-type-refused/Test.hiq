module body Test is
    function half(n: Int32): Option[Int32] is
        if n > 0 then
            return Some(value => n / 2);
        else
            return None();
        end if;
    end;

    function bad(n: Int32): Int32 is
        let a: Int32 := half(n)?;
        return a;
    end;

    function main(): ExitCode is
        let x: Int32 := bad(8);
        printLn(x);
        return ExitSuccess();
    end;
end module body.
