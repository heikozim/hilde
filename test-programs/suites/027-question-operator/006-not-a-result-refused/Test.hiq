module body Test is
    function bad(): Option[Int32] is
        let a: Int32 := 3?;
        return Some(value => a);
    end;

    function main(): ExitCode is
        case bad() of
            when Some(value: Int32) do
                printLn(value);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
