module body Test is
    record R: Linear is
        x: Int32;
    end;

    function make(n: Int32): Option[R] is
        if n > 0 then
            return Some(value => R(x => n));
        else
            return None();
        end if;
    end;

    function use(n: Int32): Option[Int32] is
        let r: R := make(n)?;
        let { x: Int32 } := r;
        return Some(value => x);
    end;

    function main(): ExitCode is
        case use(5) of
            when Some(value: Int32) do
                printLn(value);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
