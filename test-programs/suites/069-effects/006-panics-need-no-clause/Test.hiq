module body Test is
    function guard(n: Int32): Int32 is
        if n > 100 then
            abort("too large");
        end if;
        return n * 2;
    end;

    function half(n: Nat32): Nat32
        requires n > 0 is
        return n / 2;
    end;

    function main(): ExitCode is
        printLn(guard(4));
        printLn(half(8));
        return ExitSuccess();
    end;
end module body.
