module body Test is
    typeclass Measure(T: Free) is
        method measure(value: T): Int32
            raises Broken;
    end;

    instance Measure(Int32) is
        method measure(value: Int32): Int32 is
            if value < 0 then
                raise Broken;
            end if;
            return value * 2;
        end;
    end;

    function main(): ExitCode
        raises Broken is
        printLn(measure(21));
        return ExitSuccess();
    end;
end module body.
