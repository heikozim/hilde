module body Test is
    function pick(n: Int32): Int32
        raises NotFound, Denied is
        return n;
    end;

    function middle(n: Int32): Int32
        raises NotFound is
        return pick(n);
    end;

    function main(): ExitCode
        raises NotFound is
        printLn(middle(7));
        return ExitSuccess();
    end;
end module body.
