module body Test is
    function readOne(n: Int32): Int32
        raises NotFound is
        return n;
    end;

    function writeOne(n: Int32): Int32
        raises Denied is
        return n + 1;
    end;

    function both(n: Int32): Int32
        raises NotFound, Denied is
        return readOne(n) + writeOne(n);
    end;

    function justRead(n: Int32): Int32
        raises Denied, NotFound is
        return readOne(n);
    end;

    function main(): ExitCode
        raises NotFound, Denied is
        printLn(both(1));
        printLn(justRead(5));
        return ExitSuccess();
    end;
end module body.
