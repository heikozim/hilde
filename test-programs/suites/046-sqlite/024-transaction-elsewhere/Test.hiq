import Standard.Sqlite (
    Connection,
    Writing,
    SqlError,
    Transaction,
    openWriter,
    closeDatabase,
    begin,
    commit
);

module body Test is
    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                return ExitFailure();
            when Right(right as first: Connection[Writing]) do
                case openWriter(":memory:") of
                    when Left(left as error: SqlError) do
                        closeDatabase(first);
                        return ExitFailure();
                    when Right(right as second: Connection[Writing]) do
                        var a: Connection[Writing] := first;
                        var b: Connection[Writing] := second;
                        case begin(&!a) of
                            when Left(left as error: SqlError) do
                                printLn("begin failed");
                            when Right(right as tx: Transaction) do
                                case commit(&!b, tx) of
                                    when Left(left as error: SqlError) do
                                        printLn("commit failed");
                                    when Right(right as done: Unit) do
                                        printLn("committed");
                                end case;
                        end case;
                        closeDatabase(a);
                        closeDatabase(b);
                        return ExitSuccess();
                end case;
        end case;
    end;
end module body.
