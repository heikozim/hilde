import Standard.Sqlite (
    Connection,
    Writing,
    Reading,
    SqlError,
    Transaction,
    Cursor,
    describe,
    openWriter,
    openReader,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    preparedCount,
    noValues,
    start,
    advance,
    columnText,
    finish
);

module body Test is
    record Count: Free is
        n: Int64;
    end;

    generic [R: Region]
    function run(db: &![Connection[Writing], R]): Unit is
        var i: Int64 := 0;
        while i < 5 do
            case @execute(&~db, "INSERT INTO users (name, age) VALUES (?, ?)", "someone", i) of
                when Left(left as error: SqlError) do
                    failed("insert", error);
                when Right(right as changed: Nat64) do
                    skip;
            end case;
            @query(&~db, "SELECT count(*) AS n FROM users WHERE age >= ?", 0) for c: Count do
                print("rows: ");
                printLn(c.n);
            else error do
                failed("count", error);
            end for;
            i := i + 1;
        end while;
        print("statements prepared: ");
        printLn(preparedCount(&~db));
        -- The same query inside its own loop: the outer one is in use, so
        -- the inner one is prepared a second time.
        @query(&~db, "SELECT count(*) AS n FROM users WHERE age >= ?", 0) for outer: Count do
            @query(&~db, "SELECT count(*) AS n FROM users WHERE age >= ?", 0) for inner: Count do
                print("the same query inside itself: ");
                printLn(inner.n);
            else error do
                failed("inner", error);
            end for;
        else error do
            failed("outer", error);
        end for;
        print("statements prepared after that: ");
        printLn(preparedCount(&~db));
        return nil;
    end;

    function failed(what: Span[Nat8, Static], error: SqlError): Unit is
        print(what);
        print(": failed, code ");
        print(error.code);
        print(", ");
        printLn(describe(error));
        return nil;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                failed("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case migrate(&!db, @migrations) of
                    when Left(left as error: SqlError) do
                        failed("migrate", error);
                    when Right(right as applied: Index) do
                        skip;
                end case;
                run(&!db);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
