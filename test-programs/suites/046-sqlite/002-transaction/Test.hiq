import Standard.Sqlite (
    Connection,
    Writing,
    Reading,
    SqlError,
    Transaction,
    Cursor,
    describe,
    openWriter,
    openReader,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    preparedCount,
    noValues,
    start,
    advance,
    columnText,
    finish
);

module body Test is
    record Count: Free is
        n: Int64;
    end;

    generic [R: Region]
    function run(db: &![Connection[Writing], R]): Unit is
        case begin(&~db) of
            when Left(left as error: SqlError) do
                failed("begin", error);
            when Right(right as tx: Transaction) do
                case @execute(&~db, "INSERT INTO users (name) VALUES (?)", "rolled back") of
                    when Left(left as error: SqlError) do
                        failed("insert", error);
                    when Right(right as changed: Nat64) do
                        skip;
                end case;
                rollback(&~db, tx);
        end case;
        @query(&~db, "SELECT count(*) AS n FROM users") for c: Count do
            print("after rollback: ");
            printLn(c.n);
        else error do
            failed("count", error);
        end for;
        case begin(&~db) of
            when Left(left as error: SqlError) do
                failed("begin", error);
            when Right(right as tx: Transaction) do
                case @execute(&~db, "INSERT INTO users (name) VALUES (?)", "committed") of
                    when Left(left as error: SqlError) do
                        failed("insert", error);
                    when Right(right as changed: Nat64) do
                        skip;
                end case;
                case commit(&~db, tx) of
                    when Left(left as error: SqlError) do
                        failed("commit", error);
                    when Right(right as done: Unit) do
                        skip;
                end case;
        end case;
        @query(&~db, "SELECT count(*) AS n FROM users") for c: Count do
            print("after commit: ");
            printLn(c.n);
        else error do
            failed("count", error);
        end for;
        return nil;
    end;

    function failed(what: Span[Nat8, Static], error: SqlError): Unit is
        print(what);
        print(": failed, code ");
        print(error.code);
        print(", ");
        printLn(describe(error));
        return nil;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                failed("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case migrate(&!db, @migrations) of
                    when Left(left as error: SqlError) do
                        failed("migrate", error);
                    when Right(right as applied: Index) do
                        skip;
                end case;
                run(&!db);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
