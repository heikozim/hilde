import Standard.Sqlite (
    Connection,
    Writing,
    SqlError,
    describe,
    openWriter,
    closeDatabase,
    migrate
);

module body Test is
    record User[R: Region]: Free is
        id: Int64;
        name: Span[Nat8, R];
        email: Option[Span[Nat8, R]];
        age: Int64;
        score: Option[Float64];
    end;

    record Tally: Free is
        people: Int64;
        oldest: Option[Int64];
        average: Option[Float64];
    end;

    record NoteLine[R: Region]: Free is
        name: Span[Nat8, R];
        note: Option[Span[Nat8, R]];
    end;

    record Removed: Free is
        id: Int64;
    end;

    record Place[R: Region]: Free is
        name: Span[Nat8, R];
        city: Option[Span[Nat8, R]];
    end;

    generic [R: Region]
    function printText(value: Option[Span[Nat8, R]]): Unit is
        case value of
            when Some(value as text: Span[Nat8, R]) do
                print(text);
            when None do
                print("NULL");
        end case;
        return nil;
    end;

    function printInt(value: Option[Int64]): Unit is
        case value of
            when Some(value as number: Int64) do
                print(number);
            when None do
                print("NULL");
        end case;
        return nil;
    end;

    function printReal(value: Option[Float64]): Unit is
        case value of
            when Some(value as number: Float64) do
                print(number);
            when None do
                print("NULL");
        end case;
        return nil;
    end;

    function report(what: Span[Nat8, Static], result: Either[SqlError, Nat64]): Unit is
        print(what);
        case result of
            when Left(left as error: SqlError) do
                print(": failed, code ");
                print(error.code);
                print(", ");
                printLn(describe(error));
            when Right(right as changed: Nat64) do
                print(": ");
                print(changed);
                printLn(" row(s)");
        end case;
        return nil;
    end;

    function failed(what: Span[Nat8, Static], error: SqlError): Unit is
        print(what);
        print(": failed, code ");
        print(error.code);
        print(", ");
        printLn(describe(error));
        return nil;
    end;

    generic [R: Region]
    function run(db: &![Connection[Writing], R]): Unit is
        case migrate(&~db, @migrations) of
            when Left(left as error: SqlError) do
                failed("migrate", error);
            when Right(right as applied: Index) do
                print("migrations applied: ");
                printLn(applied);
        end case;

        let mail: Option[Span[Nat8, Static]] := Some(value => "alice@example.org");
        let score: Option[Float64] := Some(value => 1.5);
        report("insert alice",
            @execute(&~db, "INSERT INTO users (name, email, age, score) VALUES (?, ?, ?, ?)",
                "alice", mail, 34, score));
        let noMail: Option[Span[Nat8, Static]] := None();
        let noScore: Option[Float64] := None();
        report("insert bob",
            @execute(&~db, "INSERT INTO users (name, email, age, score) VALUES (?, ?, ?, ?)",
                "bob", noMail, 27, noScore));
        report("insert carol",
            @execute(&~db, "INSERT INTO users (name, age) VALUES (?, ?)", "carol", 41));

        @query(&~db, "SELECT id, name, email, age, score FROM users ORDER BY id")
            for user: User[Q] do
            print(user.id);
            print(" ");
            print(user.name);
            print(" ");
            printText(user.email);
            print(" ");
            print(user.age);
            print(" ");
            printReal(user.score);
            printLn("");
        else error do
            failed("select users", error);
        end for;

        @query(&~db, "SELECT count(*) AS people, max(age) AS oldest, avg(score) AS average FROM users")
            for tally: Tally do
            print("people ");
            print(tally.people);
            print(", oldest ");
            printInt(tally.oldest);
            print(", average score ");
            printReal(tally.average);
            printLn("");
        else error do
            failed("tally", error);
        end for;

        let bytes: Span[Nat8, Static] := "bytes of a note";
        report("insert note",
            @execute(&~db, "INSERT INTO notes (user_id, body) VALUES (?, ?)", 3, bytes));
        @query(&~db, "SELECT u.name AS name, n.body AS note FROM users u LEFT JOIN notes n ON n.user_id = u.id ORDER BY u.id")
            for line: NoteLine[Q] do
            print(line.name);
            print(": ");
            printText(line.note);
            printLn("");
        else error do
            failed("notes", error);
        end for;

        let bern: Option[Span[Nat8, Static]] := Some(value => "Bern");
        report("update",
            @execute(&~db, "UPDATE users SET city = ? WHERE age > ? AND name <> ?", bern, 30, "root"));
        @query(&~db, "DELETE FROM users WHERE name = ? RETURNING id", "carol")
            for gone: Removed do
            print("removed ");
            printLn(gone.id);
        else error do
            failed("delete", error);
        end for;
        @query(&~db, "SELECT name, city FROM users WHERE age BETWEEN ? AND ? ORDER BY name", 20, 50)
            for place: Place[Q] do
            print(place.name);
            print(" in ");
            printText(place.city);
            printLn("");
        else error do
            failed("places", error);
        end for;

        report("insert alice again",
            @execute(&~db, "INSERT INTO users (name) VALUES (?)", "alice"));
        return nil;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                failed("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                run(&!db);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
