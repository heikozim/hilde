import Standard.Sqlite (
    Connection,
    Writing,
    SqlError,
    Cursor,
    openWriter,
    closeDatabase,
    noValues,
    start,
    finish
);

module body Test is
    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                return ExitFailure();
            when Right(right as first: Connection[Writing]) do
                case openWriter(":memory:") of
                    when Left(left as error: SqlError) do
                        closeDatabase(first);
                        return ExitFailure();
                    when Right(right as second: Connection[Writing]) do
                        var a: Connection[Writing] := first;
                        var b: Connection[Writing] := second;
                        let cursor: Cursor := start(&!a, "SELECT 1", noValues());
                        case finish(&!b, cursor) of
                            when Some(value as error: SqlError) do
                                printLn("failed");
                            when None do
                                printLn("finished");
                        end case;
                        closeDatabase(a);
                        closeDatabase(b);
                        return ExitSuccess();
                end case;
        end case;
    end;
end module body.
