import Standard.Task (
    Scope,
    Task,
    openScope,
    closeScope,
    spawn,
    join
);
import Standard.Sqlite (
    Connection,
    Writing,
    SqlError,
    openWriter,
    closeDatabase
);

module body Test is
    generic [R: Region]
    function work(db: &![Connection[Writing], R]): Int64 is
        return 1;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case openScope() of
                    when None do
                        skip;
                    when Some(value as made: Scope) do
                        var scope: Scope := made;
                        borrow lent: &![Connection[Writing], D] := &!db do
                            let job: Fn[&![Connection[Writing], D], Int64] := work;
                            case spawn(&!scope, job, lent) of
                                when Left(left as back: &![Connection[Writing], D]) do
                                    skip;
                                when Right(right as task: Task[Int64]) do
                                    let one: Int64 := join(task);
                            end case;
                        end borrow;
                        closeScope(scope);
                end case;
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
