import Standard.Sqlite (
    Connection,
    Writing,
    SqlError,
    describe,
    openWriter,
    closeDatabase,
    noValues,
    execute
);

module body Test is
    -- SQLite prepares a text that is empty or only a comment to no
    -- statement and answers success.  Running it must still be an error:
    -- before, every later call on the missing statement failed and the
    -- run reported success.  A real statement is the control.
    function report(what: Span[Nat8, Static], done: Either[SqlError, Nat64]): Unit is
        print(what);
        case done of
            when Left(left as error: SqlError) do
                print(": failed, code ");
                printLn(error.code);
            when Right(right as changed: Nat64) do
                print(": ran, ");
                print(changed);
                printLn(" row(s)");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                printLn(describe(error));
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                report("empty text", execute(&!db, "", noValues()));
                report("only a comment", execute(&!db, "-- nothing here", noValues()));
                report("a table", execute(&!db, "CREATE TABLE t (x INTEGER) STRICT", noValues()));
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
