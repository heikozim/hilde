import Standard.Sqlite (
    Connection,
    Writing,
    Reading,
    SqlError,
    Transaction,
    Cursor,
    describe,
    openWriter,
    openReader,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    preparedCount,
    noValues,
    start,
    advance,
    columnText,
    finish
);

module body Test is
    generic [R: Region]
    function run(db: &![Connection[Reading], R]): Unit is
        case @execute(&~db, "DELETE FROM users WHERE age > ?", 3) of
            when Left(left as error: SqlError) do
                print("failed ");
                printLn(error.code);
            when Right(right as changed: Nat64) do
                printLn(changed);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openReader(":memory:") of
            when Left(left as error: SqlError) do
                return ExitFailure();
            when Right(right as opened: Connection[Reading]) do
                var db: Connection[Reading] := opened;
                run(&!db);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
