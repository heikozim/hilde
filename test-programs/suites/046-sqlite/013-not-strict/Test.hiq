import Standard.Sqlite (
    Connection,
    Writing,
    Reading,
    SqlError,
    Transaction,
    Cursor,
    describe,
    openWriter,
    openReader,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    preparedCount,
    noValues,
    start,
    advance,
    columnText,
    finish
);

module body Test is
    generic [R: Region]
    function run(db: &![Connection[Writing], R]): Unit is
        case @execute(&~db, "INSERT INTO users (name) VALUES (?)", "a") of
            when Left(left as error: SqlError) do
                failed("insert", error);
            when Right(right as changed: Nat64) do
                printLn(changed);
        end case;
        return nil;
    end;

    function failed(what: Span[Nat8, Static], error: SqlError): Unit is
        print(what);
        print(": failed, code ");
        print(error.code);
        print(", ");
        printLn(describe(error));
        return nil;
    end;

    function main(): ExitCode is
        case openWriter(":memory:") of
            when Left(left as error: SqlError) do
                failed("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                case migrate(&!db, @migrations) of
                    when Left(left as error: SqlError) do
                        failed("migrate", error);
                    when Right(right as applied: Index) do
                        skip;
                end case;
                run(&!db);
                closeDatabase(db);
                return ExitSuccess();
        end case;
    end;
end module body.
