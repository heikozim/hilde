module body Test is
    function main(): ExitCode is
        -- Two borrows of one name side by side: each block is a scope of
        -- its own, so the second binds the name to the second variable.
        let a: Int32 := 1;
        let b: Int64 := 2;
        borrow r: &[Int32, rho] := &a do
            printLn(!r);
        end borrow;
        borrow r: &[Int64, sigma] := &b do
            printLn(!r);
        end borrow;
        return ExitSuccess();
    end;
end module body.
