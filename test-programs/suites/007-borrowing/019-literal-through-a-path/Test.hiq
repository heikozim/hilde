import Standard.Buffer (
    Buffer,
    initialize,
    getSpanMut,
    nth,
    destroyFree
);

module body Test is
    record Cell: Free is
        n: Index;
        b: Nat8;
    end;

    function main(): ExitCode is
        var c: Cell := Cell(n => 1, b => 2);
        borrow r: &![Cell, R] := &!c do
            r->n := 7;
            r->b := 200;
        end borrow;
        printLn(c.n);
        printLn(c.b);
        var buf: Buffer[Nat8] := initialize(4, 0);
        borrow w: &![Buffer[Nat8], Q] := &!buf do
            var sp: Span![Nat8, Q] := getSpanMut(w, 0, 3);
            sp[1] := 9;
        end borrow;
        printLn(nth(&buf, 1));
        destroyFree(buf);
        return ExitSuccess();
    end;
end module body.
