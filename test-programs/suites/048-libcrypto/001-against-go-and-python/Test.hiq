import Standard.String (
    String,
    makeString,
    destroyString,
    length,
    nthByte,
    storeNth,
    getSpan
);
import Standard.Libcrypto (
    sealAes256Gcm,
    openAes256Gcm,
    sealChaCha20Poly1305,
    openChaCha20Poly1305,
    x25519PublicKey,
    x25519SharedSecret,
    ed25519PublicKey,
    ed25519Sign,
    ed25519Verify
);

module body Test is
    -- The bytes start, start+1, ... -- count of them.
    function sequence(start: Index, count: Index): String is
        var out: String := makeString(count, 0);
        var i: Index := 0;
        while i < count do
            case toNat8(start + i) of
                when Some(value as b: Nat8) do
                    storeNth(&!out, i, b);
                when None do
                    skip;
            end case;
            i := i + 1;
        end while;
        return out;
    end;

    -- 100 bytes that are not a sequence: (i * 13 + 5) mod 256.
    function long(): String is
        var out: String := makeString(100, 0);
        var i: Index := 0;
        while i < 100 do
            let v: Index := (i * 13) + 5;
            case toNat8(v - ((v / 256) * 256)) of
                when Some(value as b: Nat8) do
                    storeNth(&!out, i, b);
                when None do
                    skip;
            end case;
            i := i + 1;
        end while;
        return out;
    end;

    -- A String that is not empty, as a span.
    generic [R: Region]
    function spanOf(text: &[String, R]): Span[Nat8, R] is
        return getSpan(text, 0, length(text) - 1);
    end;

    function hexDigit(n: Nat8): Nat8 is
        if n < 10 then
            return n + '0';
        end if;
        return (n + 'a') - 10;
    end;

    -- The bytes as lowercase hex.  print writes a Nat8 as a decimal
    -- number, so the digits go into a String first.
    generic [R: Region]
    function printHex(text: &[String, R]): Unit is
        let size: Index := length(text);
        if size = 0 then
            return nil;
        end if;
        var hex: String := makeString(size * 2, 0);
        var i: Index := 0;
        while i < size do
            let b: Nat8 := nthByte(text, i);
            let high: Nat8 := b / 16;
            storeNth(&!hex, i * 2, hexDigit(high));
            storeNth(&!hex, (i * 2) + 1, hexDigit(b - (high * 16)));
            i := i + 1;
        end while;
        print(getSpan(&hex, 0, (size * 2) - 1));
        destroyString(hex);
        return nil;
    end;

    function line(label: Span[Nat8, Static], result: Option[String]): Unit is
        print(label);
        case result of
            when Some(value as bytes: String) do
                printHex(&bytes);
                destroyString(bytes);
            when None do
                print("FAILED");
        end case;
        printLn("");
        return nil;
    end;

    function main(): ExitCode is
        let key: String := sequence(0, 32);
        let other: String := sequence(32, 32);
        let nonce: String := sequence(0, 12);
        let short: String := sequence(0, 0);
        let longText: String := long();
        let aad: Span[Nat8, Static] := "header";
        let message: Span[Nat8, Static] := "attack at dawn";
        line("aes-256-gcm empty ", sealAes256Gcm(spanOf(&key), spanOf(&nonce), "", aad));
        line("aes-256-gcm short ", sealAes256Gcm(spanOf(&key), spanOf(&nonce), message, aad));
        line("aes-256-gcm long ", sealAes256Gcm(spanOf(&key), spanOf(&nonce), spanOf(&longText), aad));
        line("chacha20-poly1305 empty ", sealChaCha20Poly1305(spanOf(&key), spanOf(&nonce), "", aad));
        line("chacha20-poly1305 short ", sealChaCha20Poly1305(spanOf(&key), spanOf(&nonce), message, aad));
        line("chacha20-poly1305 long ", sealChaCha20Poly1305(spanOf(&key), spanOf(&nonce), spanOf(&longText), aad));
        line("x25519 public-a ", x25519PublicKey(spanOf(&key)));
        line("x25519 public-b ", x25519PublicKey(spanOf(&other)));
        case x25519PublicKey(spanOf(&other)) of
            when Some(value as publicB: String) do
                line("x25519 shared ", x25519SharedSecret(spanOf(&key), spanOf(&publicB)));
                destroyString(publicB);
            when None do
                printLn("x25519 shared FAILED");
        end case;
        line("ed25519 public ", ed25519PublicKey(spanOf(&key)));
        line("ed25519 signature ", ed25519Sign(spanOf(&key), message));
        destroyString(key);
        destroyString(other);
        destroyString(nonce);
        destroyString(short);
        destroyString(longText);
        return ExitSuccess();
    end;
end module body.
