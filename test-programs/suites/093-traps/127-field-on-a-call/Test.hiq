module body Test is
    record Point: Free is
        x: Int32;
        y: Int32;
    end;

    function origin(): Point is
        return Point(x => 3, y => 4);
    end;

    function main(): ExitCode is
        let x: Int32 := origin().x;
        printLn(x);
        return ExitSuccess();
    end;
end module body.
