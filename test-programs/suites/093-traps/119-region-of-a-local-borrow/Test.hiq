module body Test is
    generic [R: Region]
    function wrap(value: &[Int32, R]): Option[&[Int32, R]] is
        return Some(value => value);
    end;

    generic [R: Region]
    function f(other: &[Int32, R]): Int32 is
        let x: Int32 := 1;
        case wrap(&x) of
            when Some(value as there: &[Int32, R]) do
                return !there;
            when None do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
