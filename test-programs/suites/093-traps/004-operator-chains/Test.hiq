module body Test is
    function main(): ExitCode is
        let a: Int32 := 1 + 2 + 3;
        let b: Int32 := 2 * 3 * 4;
        let all: Bool := (a = 6) and (b = 24) and true;
        let any: Bool := false or false or (a = 6);
        printLn(a);
        printLn(b);
        if all and any then
            printLn(1);
        else
            printLn(0);
        end if;
        return ExitSuccess();
    end;
end module body.
