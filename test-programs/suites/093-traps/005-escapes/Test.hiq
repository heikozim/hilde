module body Test is
    function main(): ExitCode is
        let apostrophe: Nat8 := '\'';
        let text: Span[Nat8, Static] := "caf\u{e9}\u{1F600}";
        printLn(apostrophe);
        printLn(spanLength(text));
        printLn(text[3]);
        printLn(text[4]);
        printLn(text[5]);
        return ExitSuccess();
    end;
end module body.
