module body Test is
    constant one: Int64 := 1;

    function main(): ExitCode is
        let i: Index := 3;
        let j: Index := 55 + i;
        let n: Int64 := 4;
        let m: Int64 := 2 * n;
        let smallest: Int64 := -9223372036854775807 - one;
        printLn(j);
        printLn(m);
        printLn(smallest);
        return ExitSuccess();
    end;
end module body.
