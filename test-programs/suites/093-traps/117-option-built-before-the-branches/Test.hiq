module body Test is
    record Box: Linear is
        content: Int32;
    end;

    function make(c: Bool): Option[Box] is
        let nothing: Option[Box] := None();
        if c then
            return Some(value => Box(content => 1));
        else
            return nothing;
        end if;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
