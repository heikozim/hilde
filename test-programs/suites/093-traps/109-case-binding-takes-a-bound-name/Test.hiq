module body Test is
    function f(o: Option[Int32]): Int32 is
        let v: Int32 := 1;
        case o of
            when Some(value as v: Int32) do
                return v;
            when None do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
