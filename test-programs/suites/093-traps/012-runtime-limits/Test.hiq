-- Unsafe: the test calls two decisions of the runtime through @embed with
-- the values at their edges, which no call from Hilde can reach on this
-- machine.
pragma Unsafe_Module;

module body Test is
    function main(): ExitCode is
        printLn(@embed(Int32, "(int32_t) hilde_poll_millis(4294967295u)"));
        printLn(@embed(Int32, "(int32_t) hilde_poll_millis(2147483648u)"));
        printLn(@embed(Int32, "(int32_t) hilde_poll_millis(2147483647u)"));
        printLn(@embed(Int32, "(int32_t) hilde_poll_millis(5u)"));
        printLn(@embed(Int32, "hilde_sandbox_fallback_confines(1)"));
        printLn(@embed(Int32, "hilde_sandbox_fallback_confines(2)"));
        printLn(@embed(Int32, "hilde_sandbox_fallback_confines(-1)"));
        return ExitSuccess();
    end;
end module body.
