module body Test is
    generic [T: Free]
    function same(a: T, b: T): Bool is
        return a = b;
    end;

    function main(): ExitCode is
        let left: Span[Nat8, Static] := "a";
        let right: Span[Nat8, Static] := "a";
        printLn(same(left, right));
        return ExitSuccess();
    end;
end module body.
