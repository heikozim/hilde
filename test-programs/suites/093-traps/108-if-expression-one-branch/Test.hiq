module body Test is
    record Box: Linear is
        content: Int32;
    end;

    function open(box: Box): Int32 is
        let { content: Int32 } := box;
        return content;
    end;

    function f(box: Box, c: Bool): Int32 is
        let v: Int32 := if c then open(box) else 0;
        return v;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
