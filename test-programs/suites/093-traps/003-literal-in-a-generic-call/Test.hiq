module body Test is
    generic [T: Free]
    function pick(a: T, b: T): T is
        return a;
    end;

    generic [T: Free]
    function second(a: T, b: T): T is
        return b;
    end;

    function main(): ExitCode is
        let v: Int64 := 5000000000;
        printLn(second(v, 4));
        printLn(pick(4, v));
        let w: Int64 := pick(7, 8);
        printLn(w);
        return ExitSuccess();
    end;
end module body.
