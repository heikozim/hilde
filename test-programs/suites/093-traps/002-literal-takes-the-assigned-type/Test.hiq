module body Test is
    function main(): ExitCode is
        var pages: Nat64 := 0;
        pages := 1;
        var r: Either[Int32, Int64] := Left(left => 1);
        r := Right(right => 2);
        case r of
            when Left(left: Int32) do
                printLn(left);
            when Right(right: Int64) do
                printLn(right);
        end case;
        printLn(pages);
        return ExitSuccess();
    end;
end module body.
