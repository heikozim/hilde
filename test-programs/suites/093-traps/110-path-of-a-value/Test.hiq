module body Test is
    record Pair: Free is
        a: Int32;
        b: Int32;
    end;

    generic [R: Region]
    function g(x: &[Int32, R]): Int32 is
        return !x;
    end;

    function f(): Int32 is
        let p: Pair := Pair(a => 1, b => 2);
        return g(&(p.a));
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
