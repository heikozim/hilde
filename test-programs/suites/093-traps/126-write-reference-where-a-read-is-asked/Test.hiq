module body Test is
    generic [R: Region]
    function peek(x: &[Int32, R]): Int32 is
        return !x;
    end;

    generic [R: Region]
    function poke(x: &![Int32, R]): Int32 is
        return peek(x);
    end;

    function main(): ExitCode is
        var a: Int32 := 1;
        let b: Int32 := poke(&!a);
        return ExitSuccess();
    end;
end module body.
