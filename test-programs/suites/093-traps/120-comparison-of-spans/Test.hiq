module body Test is
    function main(): ExitCode is
        let text: Span[Nat8, Static] := "export PATH";
        let word: Span[Nat8, Static] := spanPart(text, 0, 7);
        if word = "export " then
            printLn("an export");
        end if;
        return ExitSuccess();
    end;
end module body.
