module body Test is
    record Box: Linear is
        content: Int32;
    end;

    function open(box: Box): Int32 is
        let { content: Int32 } := box;
        return content;
    end;

    function first(box: Box, early: Bool): Int32 is
        if early then
            return open(box);
        end if;
        return open(box) + 1;
    end;

    function second(box: Box, choice: Option[Int32]): Int32 is
        case choice of
            when Some(value: Int32) do
                return open(box) + value;
            when None do
                skip;
        end case;
        return open(box);
    end;

    function main(): ExitCode is
        printLn(first(Box(content => 1), true));
        printLn(first(Box(content => 1), false));
        printLn(second(Box(content => 10), Some(value => 5)));
        let none: Option[Int32] := None();
        printLn(second(Box(content => 10), none));
        return ExitSuccess();
    end;
end module body.
