module body Test is
    generic [T: Free]
    function same(a: T, b: T): Bool is
        return a = b;
    end;

    generic [R: Region]
    function sameReference(x: &[Int32, R], y: &[Int32, R]): Bool is
        return x = y;
    end;

    function main(): ExitCode is
        let a: Int32 := 3;
        let b: Int32 := 4;
        let x: Float64 := 1.5;
        let yes: Bool := true;
        printLn(a < b);
        printLn(a = b);
        printLn(x >= 1.5);
        printLn(yes /= false);
        let none: Unit := nil;
        printLn(none = nil);
        borrow ra: &[Int32, R] := &a do
            printLn(sameReference(ra, ra));
        end borrow;
        printLn(same(a, b));
        return ExitSuccess();
    end;
end module body.
