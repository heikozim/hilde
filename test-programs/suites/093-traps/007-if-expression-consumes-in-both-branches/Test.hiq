module body Test is
    record Box: Linear is
        content: Int32;
    end;

    function open(box: Box): Int32 is
        let { content: Int32 } := box;
        return content;
    end;

    function pickOne(box: Box, c: Bool): Int32 is
        let v: Int32 := if c then open(box) else open(box) * 2;
        return v;
    end;

    function main(): ExitCode is
        printLn(pickOne(Box(content => 3), true));
        printLn(pickOne(Box(content => 3), false));
        return ExitSuccess();
    end;
end module body.
