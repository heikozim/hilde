module body Test is
    record Box: Linear is
        content: Int32;
    end;

    function open(box: Box): Int32 is
        let { content: Int32 } := box;
        return content;
    end;

    function f(): Int32 is
        var b: Box := Box(content => 1);
        b := Box(content => 2);
        return open(b);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
