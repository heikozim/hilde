module body Test is
    record Words: Linear is
        long: Int32;
        short: Int32;
        double: Int32;
        default: Int32;
        int: Int32;
        unsigned: Int32;
    end;

    union Shape: Free is
        case Line is
            long: Int32;
        case Point;
    end;

    generic [R: Region]
    function longOf(w: &[Words, R]): Int32 is
        return w->long;
    end;

    generic [R: Region]
    function grow(w: &![Words, R]): Unit is
        w->long := w->long + 1;
        return nil;
    end;

    function lengthOf(s: Shape): Int32 is
        case s of
            when Line(long as l: Int32) do
                return l;
            when Point do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        var w: Words := Words(long => 40, short => 2, double => 7, default => 1, int => 5, unsigned => 6);
        printLn(longOf(&w));
        grow(&!w);
        let { long: Int32, short: Int32, double: Int32, default as d: Int32, int as i: Int32, unsigned as f: Int32 } := w;
        printLn(short);
        printLn(double);
        printLn(d);
        printLn(i);
        printLn(f);
        printLn(long);
        printLn(short + 1);
        printLn(lengthOf(Line(long => 12)));
        return ExitSuccess();
    end;
end module body.
