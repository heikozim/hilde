-- Five thousand rows written in one transaction and read back one by one:
-- the rows come in several data chunks, and the reader crosses from one to
-- the next without losing or repeating a row.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.DuckDB (
    Connection,
    Writing,
    Reading,
    DuckError,
    Values,
    Cursor,
    Transaction,
    describe,
    isUniqueViolation,
    isConstraintViolation,
    isBusy,
    lastMessage,
    openWriter,
    openReader,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    noValues,
    withInt64,
    withText,
    withNull,
    start,
    startWrite,
    execute,
    advance,
    columnInt64,
    columnText,
    finish
);

module body Test is
    function report(label: Span[Nat8, Static], error: DuckError): Unit is
        print(label);
        print(": ");
        print(describe(error));
        print(", unique ");
        print(isUniqueViolation(error));
        print(", constraint ");
        print(isConstraintViolation(error));
        print(", busy ");
        printLn(isBusy(error));
        return nil;
    end;

    function written(label: Span[Nat8, Static], result: Either[DuckError, Nat64]): Unit is
        case result of
            when Left(left as error: DuckError) do
                report(label, error);
            when Right(right as count: Nat64) do
                print(label);
                print(": rows ");
                printLn(count);
        end case;
        return nil;
    end;

    function ended(label: Span[Nat8, Static], failure: Option[DuckError]): Unit is
        case failure of
            when Some(value as error: DuckError) do
                report(label, error);
            when None do
                skip;
        end case;
        return nil;
    end;

    generic [M: Free, R: Region]
    function countRows(db: &![Connection[M], R], label: Span[Nat8, Static], sql: Span[Nat8, Static]): Unit is
        var rows: Cursor := start(&~db, sql, noValues());
        while advance(&!rows) do
            print(label);
            print(": ");
            printLn(columnInt64(&rows, 0));
        end while;
        ended(label, finish(&~db, rows));
        return nil;
    end;

    generic [R: Region]
    function exercise(db: &![Connection[Writing], R]): Unit is
        written("create", execute(&~db, "CREATE TABLE numbers (n BIGINT)", noValues()));
        written("insert", execute(&~db, "INSERT INTO numbers SELECT range FROM range(1, 5001)", noValues()));
        var rows: Cursor := start(&~db, "SELECT n FROM numbers ORDER BY n", noValues());
        var seen: Int64 := 0;
        var sum: Int64 := 0;
        var inOrder: Bool := true;
        while advance(&!rows) do
            let n: Int64 := columnInt64(&rows, 0);
            seen := seen + 1;
            sum := sum + n;
            if n /= seen then
                inOrder := false;
            end if;
        end while;
        ended("read", finish(&~db, rows));
        print("rows: ");
        printLn(seen);
        print("sum: ");
        printLn(sum);
        print("in order: ");
        printLn(inOrder);
        return nil;
    end;

    function main(): ExitCode is
        case openWriter("rows.duckdb") of
            when Left(left as error: DuckError) do
                report("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                exercise(&!db);
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
