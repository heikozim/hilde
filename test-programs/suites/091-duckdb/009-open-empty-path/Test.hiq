-- openWriter requires a path: an empty one is the caller's fault, and the
-- contract stops the programme before a file is touched.
import Standard.DuckDB (
    Connection,
    Writing,
    DuckError,
    openWriter,
    closeDatabase
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openWriter("") of
            when Left(left as error: DuckError) do
                printLn("refused");
            when Right(right as db: Connection[Writing]) do
                closeDatabase(db);
        end case;
        printLn("after");
        return ExitSuccess();
    end;
end module body.
