-- A column is read by an index of 0 or more: columnInt64 requires it, and
-- a negative index stops the programme.  The same row read at column 0
-- first shows the cursor is good.
import Standard.DuckDB (
    Connection,
    Writing,
    DuckError,
    Cursor,
    openWriter,
    closeDatabase,
    noValues,
    start,
    advance,
    columnInt64,
    finish
);

module body Test is
    function main(): ExitCode is
        case openWriter("negative.duckdb") of
            when Left(left as error: DuckError) do
                printLn("not opened");
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                var rows: Cursor := start(&!db, "SELECT CAST(7 AS BIGINT)", noValues());
                if advance(&!rows) then
                    print("column 0: ");
                    printLn(columnInt64(&rows, 0));
                    print("column -1: ");
                    printLn(columnInt64(&rows, -1));
                end if;
                let failure: Option[DuckError] := finish(&!db, rows);
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
