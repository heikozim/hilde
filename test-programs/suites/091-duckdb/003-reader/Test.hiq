-- A reading connection reads what the writer wrote, and a write sent
-- through it is refused by DuckDB, which opened the file read only.  A
-- reader does not create a file that is not there.
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.DuckDB (
    Connection,
    Writing,
    Reading,
    DuckError,
    Values,
    Cursor,
    Transaction,
    describe,
    isUniqueViolation,
    isConstraintViolation,
    isBusy,
    lastMessage,
    openWriter,
    openReader,
    closeDatabase,
    migrate,
    begin,
    commit,
    rollback,
    noValues,
    withInt64,
    withText,
    withNull,
    start,
    startWrite,
    execute,
    advance,
    columnInt64,
    columnText,
    finish
);

module body Test is
    function report(label: Span[Nat8, Static], error: DuckError): Unit is
        print(label);
        print(": ");
        print(describe(error));
        print(", unique ");
        print(isUniqueViolation(error));
        print(", constraint ");
        print(isConstraintViolation(error));
        print(", busy ");
        printLn(isBusy(error));
        return nil;
    end;

    function written(label: Span[Nat8, Static], result: Either[DuckError, Nat64]): Unit is
        case result of
            when Left(left as error: DuckError) do
                report(label, error);
            when Right(right as count: Nat64) do
                print(label);
                print(": rows ");
                printLn(count);
        end case;
        return nil;
    end;

    function ended(label: Span[Nat8, Static], failure: Option[DuckError]): Unit is
        case failure of
            when Some(value as error: DuckError) do
                report(label, error);
            when None do
                skip;
        end case;
        return nil;
    end;

    generic [M: Free, R: Region]
    function countRows(db: &![Connection[M], R], label: Span[Nat8, Static], sql: Span[Nat8, Static]): Unit is
        var rows: Cursor := start(&~db, sql, noValues());
        while advance(&!rows) do
            print(label);
            print(": ");
            printLn(columnInt64(&rows, 0));
        end while;
        ended(label, finish(&~db, rows));
        return nil;
    end;

    generic [R: Region]
    function exercise(db: &![Connection[Writing], R]): Unit is
        written("create", execute(&~db, "CREATE TABLE items (id BIGINT, name VARCHAR)", noValues()));
        written("insert", execute(&~db, "INSERT INTO items VALUES (?, ?)", withText(withInt64(noValues(), 7), "seven")));
        return nil;
    end;

    function main(): ExitCode is
        case openWriter("reader.duckdb") of
            when Left(left as error: DuckError) do
                report("open", error);
                return ExitFailure();
            when Right(right as opened: Connection[Writing]) do
                var db: Connection[Writing] := opened;
                exercise(&!db);
                closeDatabase(db);
        end case;
        case openReader("reader.duckdb") of
            when Left(left as error: DuckError) do
                report("reader", error);
            when Right(right as reader: Connection[Reading]) do
                var r: Connection[Reading] := reader;
                var rows: Cursor := start(&!r, "SELECT id, name FROM items", noValues());
                while advance(&!rows) do
                    print("read: ");
                    print(columnInt64(&rows, 0));
                    print(" ");
                    printLn(columnText(&rows, 1));
                end while;
                ended("read", finish(&!r, rows));
                var write: Cursor := start(&!r, "INSERT INTO items VALUES (?, ?)", withText(withInt64(noValues(), 8), "eight"));
                ended("write through the reader", finish(&!r, write));
                countRows(&!r, "items", "SELECT count(*) FROM items");
                closeDatabase(r);
        end case;
        case openReader("missing.duckdb") of
            when Left(left as error: DuckError) do
                report("reader of a missing file", error);
            when Right(right as reader: Connection[Reading]) do
                printLn("reader of a missing file: opened");
                closeDatabase(reader);
        end case;
        return ExitSuccess();
    end;
end module body.
