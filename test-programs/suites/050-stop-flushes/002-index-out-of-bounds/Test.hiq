module body Test is
    -- A line printed, then a stop inside the runtime -- an index
    -- past the end of a span, which the prelude refuses through
    -- hilde_abort_internal.
    function main(): ExitCode is
        let text: Span[Nat8, Static] := "abc";
        let past: Index := spanLength(text) + 7;
        printLn(691);
        let byte: Nat8 := text[past];
        printLn(byte);
        return ExitSuccess();
    end;
end module body.
