module body Test is
    -- Two lines printed, then a stop through abort.  The runner
    -- reads standard output through a pipe, which stdio buffers fully, so
    -- the two lines reach it only if the stop flushes first.
    function main(): ExitCode is
        printLn(691);
        printLn(692);
        abort("stopped on purpose");
        return ExitSuccess();
    end;
end module body.
