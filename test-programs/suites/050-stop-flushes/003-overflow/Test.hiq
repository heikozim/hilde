module body Test is
    -- A line printed, then an arithmetic overflow, the stop a
    -- programme meets most often.
    function main(): ExitCode is
        let a: Int8 := maximum_int8;
        let b: Int8 := 1;
        printLn(691);
        let c: Int8 := a + b;
        printLn(c);
        return ExitSuccess();
    end;
end module body.
