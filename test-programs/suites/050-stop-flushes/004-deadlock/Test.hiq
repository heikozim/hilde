import Standard.Task (
    Sender,
    Receiver,
    Channel,
    openChannel,
    receive,
    closeSender,
    closeReceiver
);

module body Test is
    -- A line printed, then a stop in the task runtime -- main
    -- waits on a channel whose only sender it holds itself (the programme
    -- of 041-task/004), and the runtime ends the programme through
    -- hilde_task_die.
    function main(): ExitCode is
        printLn(691);
        let made: Option[Channel[Int32]] := openChannel(1);
        case made of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var input: Receiver[Int32] := receiver;
                case receive(&!input) of
                    when Some(value as got: Int32) do
                        printLn(got);
                    when None do
                        printLn(0);
                end case;
                closeReceiver(input);
                closeSender(sender);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
