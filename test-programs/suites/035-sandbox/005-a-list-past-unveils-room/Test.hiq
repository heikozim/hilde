import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    writeString,
    finalize
);
import Standard.File (
    FileDescriptor,
    closeFile,
    readAll,
    Command,
    makeCommand,
    addArgument,
    Process,
    Running,
    spawnProcess,
    waitProcess,
    ProcessStatus
);
import Standard.Sandbox (
    Policy,
    Report,
    makePolicy,
    allowPath,
    allowFolding,
    applyPolicy,
    reportApplied,
    reportHas,
    reportBudgetExceeded,
    reportFirstRefused,
    reportPathsFolded,
    reportPathsApplied,
    mechanismUnveil
);

module body Test is
    -- A policy of 300 files under /tmp, each to be read: more names below
    -- one directory than unveil has room for.  The files need not exist.
    function manyPaths(): Policy is
        var policy: Policy := makePolicy();
        let zero: Nat8 := 48;
        let read: String := fromLiteral("r");
        var a: Nat8 := 0;
        while a < 3 do
            var b: Nat8 := 0;
            while b < 10 do
                var c: Nat8 := 0;
                while c < 10 do
                    let prefix: String := fromLiteral("/tmp/hilde-035-");
                    var builder: StringBuilder := makeStringBuilder();
                    writeString(&!builder, asSpan(&prefix));
                    writeByte(&!builder, zero + a);
                    writeByte(&!builder, zero + b);
                    writeByte(&!builder, zero + c);
                    let path: String := finalize(builder);
                    policy := allowPath(policy, asSpan(&path), asSpan(&read));
                    destroyString(path);
                    destroyString(prefix);
                    c := c + 1;
                end while;
                b := b + 1;
            end while;
            a := a + 1;
        end while;
        destroyString(read);
        return policy;
    end;

    -- Without folding: where there is unveil, it has no room, and nothing
    -- at all is applied.  Elsewhere there is no such room to run out of.
    function plain(): ExitCode is
        let report: Report := applyPolicy(manyPaths());
        let refusedHere: Bool := (reportBudgetExceeded(report) and (not reportApplied(report)))
            and (reportFirstRefused(report) > 0);
        let noRoomToLose: Bool := (not reportBudgetExceeded(report)) and (not reportHas(report, mechanismUnveil));
        if refusedHere or noRoomToLose then
            printLn("a list past unveil's room applies nothing, where there is unveil");
        else
            printLn("the list was applied in part");
        end if;
        return ExitSuccess();
    end;

    -- With folding: the 300 siblings become /tmp, which fits.
    function folding(): ExitCode is
        let report: Report := applyPolicy(allowFolding(manyPaths()));
        let foldedHere: Bool := (reportHas(report, mechanismUnveil) and (reportPathsFolded(report) = 299))
            and (reportPathsApplied(report) = 1);
        let nothingToFold: Bool := (reportPathsFolded(report) = 0) and (not reportHas(report, mechanismUnveil));
        if foldedHere or nothingToFold then
            printLn("with folding the paths become their parent, where there is unveil");
        else
            printLn("the paths were not folded");
        end if;
        return ExitSuccess();
    end;

    -- Starts this programme with the one argument and prints what it said.
    generic [R: Region]
    function run(mode: &[String, R]): Unit is
        let self: String := fromLiteral(nthArgument(0));
        let command: Command := addArgument(makeCommand(asSpan(&self)), asSpan(mode));
        destroyString(self);
        case spawnProcess(command) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor,
                    output: FileDescriptor, errors: FileDescriptor } := running;
                closeFile(input);
                var fromChild: FileDescriptor := output;
                case readAll(&!fromChild) of
                    when Some(value as said: String) do
                        print(asSpan(&said));
                        destroyString(said);
                    when None do
                        printLn("nothing was read from the child");
                end case;
                closeFile(fromChild);
                closeFile(errors);
                let status: ProcessStatus := waitProcess(process);
            when None do
                printLn("the child did not start");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        if argumentCount() > 1 then
            let mode: String := fromLiteral(nthArgument(1));
            let isPlain: Bool := (length(&mode) = 5) and (nthByte(&mode, 0) = 'p');
            destroyString(mode);
            if isPlain then
                return plain();
            else
                return folding();
            end if;
        end if;
        let plainMode: String := fromLiteral("plain");
        let foldingMode: String := fromLiteral("folding");
        run(&plainMode);
        run(&foldingMode);
        destroyString(plainMode);
        destroyString(foldingMode);
        return ExitSuccess();
    end;
end module body.
