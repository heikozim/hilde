import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.File (
    FileDescriptor,
    closeFile,
    readAll,
    Command,
    makeCommand,
    addArgument,
    Process,
    Running,
    spawnProcess,
    waitProcess,
    ProcessStatus,
    exitedNormally,
    exitCode
);
import Standard.Sandbox (
    Policy,
    Report,
    makePolicy,
    allowPromises,
    allowPath,
    applyPolicy,
    reportApplied
);

module body Test is
    -- The child: confined to reading /dev/null, it says whether something
    -- confined it and ends with a failure.  Where the sandbox starts the
    -- programme again, the line is printed once, by the confined process,
    -- and the failure is the one the parent sees.
    function child(): ExitCode is
        let promises: String := fromLiteral("stdio rpath");
        let path: String := fromLiteral("/dev/null");
        let read: String := fromLiteral("r");
        let policy: Policy := allowPath(allowPromises(makePolicy(), asSpan(&promises)), asSpan(&path), asSpan(&read));
        destroyString(promises);
        destroyString(path);
        destroyString(read);
        let report: Report := applyPolicy(policy);
        if reportApplied(report) then
            printLn("confined");
        else
            printLn("not confined");
        end if;
        return ExitFailure();
    end;

    generic [R: Region]
    function saysConfined(text: &[String, R]): Bool is
        let expected: String := fromLiteral("confined\n");
        let size: Index := length(&expected);
        var same: Bool := (length(text) = size);
        if same then
            for i from 0 to size - 1 do
                if nthByte(text, i) /= nthByte(&expected, i) then
                    same := false;
                end if;
            end for;
        end if;
        destroyString(expected);
        return same;
    end;

    function main(): ExitCode is
        if argumentCount() > 1 then
            return child();
        end if;
        let self: String := fromLiteral(nthArgument(0));
        let mode: String := fromLiteral("child");
        let command: Command := addArgument(makeCommand(asSpan(&self)), asSpan(&mode));
        destroyString(self);
        destroyString(mode);
        case spawnProcess(command) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor,
                    output: FileDescriptor, errors: FileDescriptor } := running;
                closeFile(input);
                var fromChild: FileDescriptor := output;
                var once: Bool := false;
                case readAll(&!fromChild) of
                    when Some(value as said: String) do
                        once := saysConfined(&said);
                        destroyString(said);
                    when None do
                        once := false;
                end case;
                closeFile(fromChild);
                closeFile(errors);
                let status: ProcessStatus := waitProcess(process);
                if (once and exitedNormally(status)) and (exitCode(status) = 1) then
                    printLn("a confined child prints once and ends as it ends");
                else
                    printLn("the confined child did not end as it ended");
                end if;
            when None do
                printLn("the child did not start");
        end case;
        return ExitSuccess();
    end;
end module body.
