-- Unsafe: the test asks the runtime through @embed whether a call the
-- filter refuses is refused, which no call from Hilde can reach.
pragma Unsafe_Module;

import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Sandbox (
    Policy,
    Report,
    makePolicy,
    allowPromises,
    applyPolicy,
    reportApplied
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function main(): ExitCode is
        -- Confined to stdio and no path.  On Linux the seccomp filter then
        -- refuses unshare as not permitted, and the runtime says 1.  Where
        -- there is no filter the runtime says -1, so the line is 1 there
        -- too, and 0 only when unshare went through.
        let promises: String := fromLiteral("stdio");
        let report: Report := applyPolicy(allowPromises(makePolicy(), asSpan(&promises)));
        destroyString(promises);
        printLn(widen(reportApplied(report)));
        printLn(@embed(Int32, "(int32_t) (hilde_sandbox_test_unshare_refused() != 0)"));
        return ExitSuccess();
    end;
end module body.
