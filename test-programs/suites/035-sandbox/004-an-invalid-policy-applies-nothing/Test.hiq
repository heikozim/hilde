import Standard.String (
    String,
    fromLiteral,
    makeString,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.Sandbox (
    Policy,
    Report,
    makePolicy,
    allowPromises,
    allowPath,
    policyValid,
    discardPolicy,
    applyPolicy,
    reportRefused,
    reportApplied,
    describeReport
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function promisesValid(text: Span[Nat8, Static]): Int32 is
        let promises: String := fromLiteral(text);
        let policy: Policy := allowPromises(makePolicy(), asSpan(&promises));
        destroyString(promises);
        let valid: Bool := policyValid(&policy);
        discardPolicy(policy);
        return widen(valid);
    end;

    function pathValid(path: Span[Nat8, Static], permissions: Span[Nat8, Static]): Int32 is
        let name: String := fromLiteral(path);
        let rights: String := fromLiteral(permissions);
        let policy: Policy := allowPath(makePolicy(), asSpan(&name), asSpan(&rights));
        destroyString(name);
        destroyString(rights);
        let valid: Bool := policyValid(&policy);
        discardPolicy(policy);
        return widen(valid);
    end;

    function main(): ExitCode is
        -- Promises: known words, one space between them.
        printLn(promisesValid("stdio"));
        printLn(promisesValid("stdio rpath inet"));
        printLn(promisesValid("stdio bogus"));
        printLn(promisesValid(""));
        printLn(promisesValid("stdio  rpath"));
        printLn(promisesValid(" stdio"));
        printLn(promisesValid("stdio "));
        printLn(promisesValid("stdi"));
        -- Paths and permissions.
        printLn(pathValid("/tmp", "rwxc"));
        printLn(pathValid("/tmp", "r"));
        printLn(pathValid("/tmp", ""));
        printLn(pathValid("/tmp", "rr"));
        printLn(pathValid("/tmp", "q"));
        printLn(pathValid("", "r"));
        -- A path with a zero byte inside.
        let inner: String := makeString(3, 0);
        let rights: String := fromLiteral("r");
        let withZero: Policy := allowPath(makePolicy(), asSpan(&inner), asSpan(&rights));
        destroyString(inner);
        destroyString(rights);
        printLn(widen(policyValid(&withZero)));
        -- An invalid policy applied: nothing tried, and the report says so.
        let report: Report := applyPolicy(withZero);
        printLn(widen(reportRefused(report)));
        printLn(widen(reportApplied(report)));
        let line: String := describeReport(report);
        printLn(getSpan(&line, 0, length(&line) - 1));
        destroyString(line);
        return ExitSuccess();
    end;
end module body.
