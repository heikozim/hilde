import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Sandbox (
    Policy,
    Report,
    makePolicy,
    allowPromises,
    applyPolicy,
    reportRefused,
    reportApplied,
    reportAgreesWithSystem
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function main(): ExitCode is
        -- Nothing is printed before the second policy is applied: on macOS
        -- the programme starts again under the profile, and what it had
        -- printed before would be printed twice.

        -- Before anything is applied, the kernel and a report that claims
        -- nothing agree.
        let invalid: String := fromLiteral("no-such-promise");
        let refused: Report := applyPolicy(allowPromises(makePolicy(), asSpan(&invalid)));
        destroyString(invalid);
        let refused_first: Int32 := widen(reportRefused(refused));
        let agreed_first: Int32 := widen(reportAgreesWithSystem(refused));

        -- Confined to stdio and no path, which is enough to print.  On
        -- Linux the kernel is asked about no new privileges and seccomp;
        -- on OpenBSD and macOS it cannot be asked, and the report claims
        -- neither.
        let promises: String := fromLiteral("stdio");
        let report: Report := applyPolicy(allowPromises(makePolicy(), asSpan(&promises)));
        destroyString(promises);
        printLn(refused_first);
        printLn(agreed_first);
        printLn(widen(reportRefused(report)));
        printLn(widen(reportApplied(report)));
        printLn(widen(reportAgreesWithSystem(report)));
        return ExitSuccess();
    end;
end module body.
