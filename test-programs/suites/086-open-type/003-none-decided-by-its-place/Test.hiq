module body Test is
    -- None as the value of a returned Right: the return type decides it.
    function nothing(): Either[Int32, Option[Int32]] is
        return Right(right => None());
    end;

    function count(maybe: Option[Int32]): Int32 is
        case maybe of
            when Some(value as n: Int32) do
                return n;
            when None do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        case nothing() of
            when Right(right as inner: Option[Int32]) do
                printLn(count(inner));
            when Left(left as e: Int32) do
                printLn(e);
        end case;
        -- None as an argument: the parameter's type decides it.
        printLn(count(None()));
        printLn(count(Some(value => 7)));
        -- Two levels deep: the type of the let reaches the inner None
        -- through Some and Right.
        let nested: Option[Either[Int32, Option[Int32]]] := Some(value => Right(right => None()));
        case nested of
            when Some(value as e: Either[Int32, Option[Int32]]) do
                case e of
                    when Right(right as o: Option[Int32]) do
                        printLn(count(o));
                    when Left(left as l: Int32) do
                        printLn(l);
                end case;
            when None do
                printLn(-1);
        end case;
        return ExitSuccess();
    end;
end module body.
