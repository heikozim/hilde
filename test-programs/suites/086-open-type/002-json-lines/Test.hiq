module body Test is
    -- The parameter of isEmpty is Option[T] with T its own, so nothing here
    -- decides T and the None has no type.
    generic [T: Free]
    function isEmpty(maybe: Option[T]): Bool is
        case maybe of
            when Some(value as inner: T) do
                return false;
            when None do
                return true;
        end case;
    end;

    function main(): ExitCode is
        let empty: Bool := isEmpty(None());
        return ExitSuccess();
    end;
end module body.
