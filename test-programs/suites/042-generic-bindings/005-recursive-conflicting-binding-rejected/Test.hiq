module body Test is
    constant seven: Index := 7;

    generic [T: Free]
    function both(x: T, y: T, n: Index): T is
        if n = 0 then
            return x;
        end if;
        return both(x, seven, n - 1);
    end;

    function main(): ExitCode is
        printLn(both(true, false, 1));
        return ExitSuccess();
    end;
end module body.
