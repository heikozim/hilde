module body Test is
    record Holder[A: Type]: Type is
        held: A;
    end;

    generic [T: Type]
    function wrap(x: T): Option[T] is
        let some: Option[T] := Some(value => x);
        return some;
    end;

    -- wrap is called on a Holder[A] where there is no asserted type -- a
    -- case scrutinee.  Its return type, with the argument's binding put in,
    -- is Option[Holder[A]], and A is a type variable of this function, not
    -- of wrap.  Austral's check compared type variables by name against
    -- wrap's own and refused the call as "generic but unconstrained".
    generic [A: Free]
    function holds(x: A): Bool is
        case wrap(Holder(held => x)) of
            when Some(value as h: Holder[A]) do
                return true;
            when None do
                return false;
        end case;
    end;

    function main(): ExitCode is
        if holds(5) then
            printLn(1);
        else
            printLn(0);
        end if;
        return ExitSuccess();
    end;
end module body.
