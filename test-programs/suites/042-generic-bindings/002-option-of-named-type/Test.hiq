module body Test is
    record Word: Linear is
        n: Int32;
    end;

    -- A generic body that names Option[T], instantiated with T a named type.
    -- The monomorphiser puts the monomorph of Word into Option[T] and then
    -- recomputed Option's universe from it -- and a monomorph carries no
    -- universe, so the compiler stopped with "Internal compiler error: You
    -- shouldn't be asking for the type_universe of a MonoTy".
    generic [T: Type]
    function keep(value: T): Option[T] is
        let some: Option[T] := Some(value => value);
        return some;
    end;

    function main(): ExitCode is
        let kept: Option[Word] := keep(Word(n => 42));
        case kept of
            when Some(value as w: Word) do
                let { n: Int32 } := w;
                printLn(n);
            when None do
                printLn(0);
        end case;
        return ExitSuccess();
    end;
end module body.
