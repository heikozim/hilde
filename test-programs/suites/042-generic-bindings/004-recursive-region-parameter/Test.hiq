import Standard.Buffer (
    Buffer,
    allocateEmpty,
    destroyFree,
    nth,
    insertBack
);

module body Test is
    constant seven: Index := 7;
    constant nine: Index := 9;

    generic [N: Region, P: Region]
    function walk(nodes: &[Buffer[Index], N], out: &![Buffer[Index], P], id: Index): Bool is
        let v: Index := nth(nodes, id);
        insertBack(&~out, v);
        if id = 0 then
            return true;
        end if;
        if not walk(nodes, &~out, id - 1) then
            return false;
        end if;
        return true;
    end;

    function main(): ExitCode is
        var items: Buffer[Index] := allocateEmpty();
        insertBack(&!items, seven);
        insertBack(&!items, nine);
        var out: Buffer[Index] := allocateEmpty();
        let ok: Bool := walk(&items, &!out, 1);
        printLn(nth(&out, 0));
        printLn(nth(&out, 1));
        destroyFree(items);
        destroyFree(out);
        if ok then
            printLn("ok");
        end if;
        return ExitSuccess();
    end;
end module body.
