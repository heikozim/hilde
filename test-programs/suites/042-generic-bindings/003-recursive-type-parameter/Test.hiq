module body Test is
    constant seven: Index := 7;

    generic [T: Free]
    function pick(x: T, n: Index): T is
        if n = 0 then
            return x;
        end if;
        return pick(x, n - 1);
    end;

    function main(): ExitCode is
        printLn(pick(seven, 3));
        return ExitSuccess();
    end;
end module body.
