module body Test is
    function bump(): Int32 is
        return @embed(Int32, "({ static int hilde_probe_n = 0; ++hilde_probe_n; })");
    end;

    function main(): ExitCode is
        let a: Int32 := bump();
        let b: Int32 := bump();
        if a = 1 then
            if b = 2 then
                return ExitSuccess();
            end if;
        end if;
        return ExitFailure();
    end;
end module body.
