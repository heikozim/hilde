-- Unsafe: the test puts a pipe with known bytes on standard input through
-- @embed, so that readSecretFromInput has something to read.
pragma Unsafe_Module;

import Standard.Secret (
    Secret,
    SecretError,
    NoTerminal,
    TooLong,
    Empty,
    Mismatch,
    Failed,
    readSecret,
    readSecretFromInput,
    secretBytes,
    destroySecret
);

module body Test is
    function said(error: SecretError): Span[Nat8, Static] is
        case error of
            when NoTerminal do
                return "no terminal";
            when TooLong do
                return "too long";
            when Empty do
                return "empty";
            when Mismatch do
                return "mismatch";
            when Failed do
                return "failed";
        end case;
    end;

    function show(answer: Either[SecretError, Secret]): Unit is
        case answer of
            when Right(right as secret: Secret) do
                print("[");
                print(secretBytes(&secret));
                printLn("]");
                destroySecret(secret);
            when Left(left as error: SecretError) do
                printLn(said(error));
        end case;
        return nil;
    end;

    -- Standard input from now on reads count bytes of value then a line
    -- feed, and then its end.
    function feed(value: Nat8, count: Int32): Unit is
        let fed: Int32 := @embed(Int32, "__extension__ ({ int hilde_p[2]; uint8_t hilde_v = $1; int32_t hilde_n = $2; if (pipe(hilde_p) == 0) { for (int32_t hilde_i = 0; hilde_i < hilde_n; hilde_i++) { (void) write(hilde_p[1], &hilde_v, 1); } uint8_t hilde_nl = 10; (void) write(hilde_p[1], &hilde_nl, 1); close(hilde_p[1]); dup2(hilde_p[0], 0); close(hilde_p[0]); } (int32_t) hilde_n; })", value, count);
        ignore(fed);
        return nil;
    end;

    function main(): ExitCode is
        -- No terminal in the test: the answer comes at once.
        show(readSecret("Password: "));
        feed('x', 7);
        show(readSecretFromInput());
        feed('y', 1024);
        let full: Either[SecretError, Secret] := readSecretFromInput();
        case full of
            when Right(right as secret: Secret) do
                printLn(spanLength(secretBytes(&secret)));
                destroySecret(secret);
            when Left(left as error: SecretError) do
                printLn(said(error));
        end case;
        feed('z', 1025);
        show(readSecretFromInput());
        feed('w', 0);
        show(readSecretFromInput());
        return ExitSuccess();
    end;
end module body.
