-- in over a buffer of numbers compares the displayed text: "3" in a buffer
-- holding the number 3 is true here, and false in Jinja2, where a string
-- is never equal to a number.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree
);
import Standard.String (
    String,
    destroyString,
    length as textLength,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        numbers: Buffer[Index];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        var numbers: Buffer[Index] := allocateEmpty();
        let three: Index := 3;
        insertBack(&!numbers, three);
        let page: Page := Page(numbers => numbers);
        let result: String := render(&page);
        printLn(getSpan(&result, 0, textLength(&result) - 1));
        destroyString(result);
        let { numbers as held: Buffer[Index] } := page;
        destroyFree(held);
        return ExitSuccess();
    end;
end module body.
