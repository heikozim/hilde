<!DOCTYPE html>
<html>
<head><title>{{.title}}</title></head>
<body>
<h1 class="{{.kind}}">{{.title}}</h1>
<ul>
{{range .links}}<li><a href="{{.href}}" title="{{.name}}">{{.name}}</a> <a href="/go?to={{.name}}&amp;from=list">go</a> <img src="/img/{{.name}}.png" alt='{{.name}}'></li>
{{end}}</ul>
{{if .note}}<p>{{.note}}</p>{{else}}<p>no note</p>{{end}}
<a href="mailto:{{.mail}}">mail</a>
</body>
</html>
