-- The migration check: page.jinja rewrites page.gohtml, and the
-- expected output is Go's html/template on the same data -- data.json,
-- built here by hand.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeLast,
    destroyEmpty,
    length
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as textLength,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Link: Linear is
        name: String;
        href: String;
    end;

    record Page: Linear is
        title: String;
        kind: String;
        links: Buffer[Link];
        note: String;
        mail: String;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function link(name: Span[Nat8, Static], href: Span[Nat8, Static]): Link is
        return Link(name => fromLiteral(name), href => fromLiteral(href));
    end;

    function main(): ExitCode is
        var list: Buffer[Link] := allocateEmpty();
        insertBack(&!list, link("a b", "http://example.org/x y?q=1&r=<2>#top"));
        insertBack(&!list, link("evil", "javascript:alert(1)"));
        insertBack(&!list, link("O'Neil (x)", "/local/p'q"));
        insertBack(&!list, link("up", "HTTPS://example.org/"));
        let page: Page := Page(title => fromLiteral("Links & <Things>"), kind => fromLiteral("list"),
            links => list, note => fromLiteral(""), mail => fromLiteral("a@b.example"));
        let result: String := render(&page);
        printLn(getSpan(&result, 0, textLength(&result) - 1));
        destroyString(result);
        let { title: String, kind: String, links: Buffer[Link], note: String, mail: String } := page;
        destroyString(title);
        destroyString(kind);
        destroyString(note);
        destroyString(mail);
        var rest: Buffer[Link] := links;
        while length(&rest) > 0 do
            let l: Link := removeLast(&!rest);
            let { name: String, href: String } := l;
            destroyString(name);
            destroyString(href);
        end while;
        destroyEmpty(rest);
        return ExitSuccess();
    end;
end module body.
