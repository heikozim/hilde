import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree
);
import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        name: String;
        numbers: Buffer[Index];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    -- One page lent to a task to render.
    -- The scope is opened and closed inside the borrow, so the task has
    -- ended before the borrow does, and rendering only reads the page.
    -- Refused all the same, by the check of the tasks: it looks at the
    -- argument's type and cannot see where the scope closes.  037 renders
    -- in several tasks, each from its own page.
    function main(): ExitCode is
        let one: Index := 1;
        var first: Buffer[Index] := allocateEmpty();
        insertBack(&!first, one);
        let page: Page := Page(name => fromLiteral("a<b"), numbers => first);
        borrow p: &[Page, rho] := &page do
            case openScope() of
                when Some(value as opened: Scope) do
                    var scope: Scope := opened;
                    let work: Fn[&[Page, rho], String] := render;
                    case spawn(&!scope, work, p) of
                        when Right(right as task: Task[String]) do
                            destroyString(join(task));
                        when Left(left as back: &[Page, rho]) do
                            skip;
                    end case;
                    closeScope(scope);
                when None do
                    skip;
            end case;
        end borrow;
        let { name: String, numbers: Buffer[Index] } := page;
        destroyString(name);
        destroyFree(numbers);
        return ExitSuccess();
    end;
end module body.
