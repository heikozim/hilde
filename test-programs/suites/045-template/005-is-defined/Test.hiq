-- is defined cannot be asked of a template compiled against one type; refused with a message that says so.
import Standard.Buffer (
    Buffer
);
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        title: String;
        motto: Option[String];
        items: Buffer[Index];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
