-- The two remaining differences from Go's html/template: an HTML
-- comment is kept, and a CSS value holding a backslash -- here the CSS
-- escape for r, so the value reads red to a browser -- is refused.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        c: String;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        let page: Page := Page(c => fromLiteral("\\72 ed"));
        let result: String := render(&page);
        printLn(getSpan(&result, 0, length(&result) - 1));
        destroyString(result);
        let { c: String } := page;
        destroyString(c);
        return ExitSuccess();
    end;
end module body.
