-- JavaScript and CSS escaping against Go's html/template: page.jinja rewrites
-- page.gohtml, and the expected output is Go's on data.json, built here by
-- hand.  The string s is a"b'c<d>&e/f\\g -- written below with the escapes
-- a Hilde string literal takes.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        s: String;
        n: Index;
        neg: Int32;
        flag: Bool;
        color: String;
        bad: String;
        font: String;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        let page: Page := Page(s => fromLiteral("a\"b'c<d>&e/f\\g"), n => 42, neg => -7, flag => true,
            color => fromLiteral("#fff"), bad => fromLiteral("red;x"),
            font => fromLiteral("Open Sans"));
        let result: String := render(&page);
        printLn(getSpan(&result, 0, length(&result) - 1));
        destroyString(result);
        let { s: String, n: Index, neg: Int32, flag: Bool, color: String, bad: String, font: String } := page;
        destroyString(s);
        destroyString(color);
        destroyString(bad);
        destroyString(font);
        return ExitSuccess();
    end;
end module body.
