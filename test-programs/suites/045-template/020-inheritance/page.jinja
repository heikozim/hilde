{% from "macros.jinja" import badge, money %}
{% extends "layout.jinja" %}
{% block title %}{{ title }} - {{ super() }}{% endblock %}
{% block body %}
<h1>{{ title }}</h1>
{{ badge(owner) }} {{ badge("new", "hot") }} {{ badge(title, "it's") }}
{% for item in items %}{% include "row.jinja" %}
{% endfor %}
{%- endblock %}
{% block row %}<li>{{ item.name }} = {{ super() }}</li>{% endblock %}
