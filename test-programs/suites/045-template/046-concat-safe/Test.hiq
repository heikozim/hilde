-- ~ joins texts that are escaped when printed; a |safe value cannot be joined to them.
import Standard.Buffer (
    Buffer
);
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        title: String;
        count: Int32;
        items: Buffer[String];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
