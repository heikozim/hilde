-- A module that uses @template without importing Standard.Template is refused with a message that says what to import.
import Standard.Buffer (
    Buffer
);
import Standard.String (
    String
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);

module body Test is
    record Page: Linear is
        title: String;
        motto: Option[String];
        items: Buffer[Index];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
