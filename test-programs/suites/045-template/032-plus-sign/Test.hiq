-- Where Go's html/template and Jinja2 disagree, and which one @template
-- follows: +.  The expected output is Jinja2's.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        word: String;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        let page: Page := Page(word => fromLiteral("a+b"));
        let result: String := render(&page);
        printLn(getSpan(&result, 0, length(&result) - 1));
        destroyString(result);
        let { word: String } := page;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
