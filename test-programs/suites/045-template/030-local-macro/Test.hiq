-- page.jinja extends layout.jinja, which extends base.jinja; macros and
-- includes.  The expected output is Jinja2's on the same templates and
-- data.json (scripts/jinja/oracle.py).
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeLast,
    destroyEmpty,
    length
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as textLength,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Item: Linear is
        name: String;
        price: Index;
    end;

    record Page: Linear is
        title: String;
        owner: String;
        items: Buffer[Item];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function main(): ExitCode is
        var goods: Buffer[Item] := allocateEmpty();
        insertBack(&!goods, Item(name => fromLiteral("pen"), price => 2));
        insertBack(&!goods, Item(name => fromLiteral("ink <blue>"), price => 11));
        let page: Page := Page(title => fromLiteral("Shop & <More>"), owner => fromLiteral("O'Brien"), items => goods);
        let result: String := render(&page);
        printLn(getSpan(&result, 0, textLength(&result) - 1));
        destroyString(result);
        let { title: String, owner: String, items: Buffer[Item] } := page;
        destroyString(title);
        destroyString(owner);
        var rest: Buffer[Item] := items;
        while length(&rest) > 0 do
            let item: Item := removeLast(&!rest);
            let { name: String, price: Index } := item;
            destroyString(name);
        end while;
        destroyEmpty(rest);
        return ExitSuccess();
    end;
end module body.
