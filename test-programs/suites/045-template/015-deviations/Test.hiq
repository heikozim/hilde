-- The deviations of @template that compile, next to what Jinja2 writes for
-- the same data: |upper, |lower and |trim touch ASCII only.  The
-- data is not ASCII, so it is built byte by byte -- a file of the repository
-- is ASCII.  word is U+00E9 t U+00C9, spaced is U+3000 x U+3000.
import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeByte,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        word: String;
        spaced: String;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function hexDigit(value: Nat8): Nat8 is
        if value < 10 then
            return value + '0';
        end if;
        return (value - 10) + 'A';
    end;

    -- The output with every byte outside printable ASCII, and every %,
    -- written %xx: the expected output is a file of the repository.
    generic [R: Region]
    function escaped(text: &[String, R]): String is
        var out: StringBuilder := makeStringBuilder();
        let total: Index := length(text);
        var i: Index := 0;
        while i < total do
            let b: Nat8 := nthByte(text, i);
            if ((b < 32) or (b > 126)) or (b = '%') then
                writeByte(&!out, '%');
                writeByte(&!out, hexDigit(b / 16));
                writeByte(&!out, hexDigit(b - ((b / 16) * 16)));
            else
                writeByte(&!out, b);
            end if;
            i := i + 1;
        end while;
        return finalize(out);
    end;

    function main(): ExitCode is
        var w: StringBuilder := makeStringBuilder();
        writeByte(&!w, 195);
        writeByte(&!w, 169);
        writeByte(&!w, 't');
        writeByte(&!w, 195);
        writeByte(&!w, 137);
        var s: StringBuilder := makeStringBuilder();
        writeByte(&!s, 227);
        writeByte(&!s, 128);
        writeByte(&!s, 128);
        writeByte(&!s, 'x');
        writeByte(&!s, 227);
        writeByte(&!s, 128);
        writeByte(&!s, 128);
        let page: Page := Page(word => finalize(w), spaced => finalize(s));
        let result: String := render(&page);
        let shown: String := escaped(&result);
        printLn(getSpan(&shown, 0, length(&shown) - 1));
        destroyString(shown);
        destroyString(result);
        let { word: String, spaced: String } := page;
        destroyString(word);
        destroyString(spaced);
        return ExitSuccess();
    end;
end module body.
