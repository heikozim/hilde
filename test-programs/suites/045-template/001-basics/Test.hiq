-- page.jinja rendered with the data of data.json, built here by hand.  The
-- expected output is Jinja2's on the same template and the same data
-- (scripts/jinja/oracle.py), so a line that differs is a place where
-- @template and Jinja2 part.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeLast,
    destroyEmpty,
    length
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as textLength,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);

module body Test is
    record Item: Linear is
        name: String;
        price: Index;
        note: Option[String];
    end;

    record Page: Linear is
        title: String;
        user: String;
        admin: Bool;
        count: Int32;
        items: Buffer[Item];
        empty: Buffer[Item];
        motto: Option[String];
        missing: Option[String];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function noText(): Option[String] is
        let nothing: Option[String] := None();
        return nothing;
    end;

    function destroyOption(value: Option[String]): Unit is
        case value of
            when Some(value as text: String) do
                destroyString(text);
            when None do
                skip;
        end case;
        return nil;
    end;

    function destroyItems(items: Buffer[Item]): Unit is
        var rest: Buffer[Item] := items;
        while length(&rest) > 0 do
            let item: Item := removeLast(&!rest);
            let { name: String, price: Index, note: Option[String] } := item;
            destroyString(name);
            destroyOption(note);
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function main(): ExitCode is
        var goods: Buffer[Item] := allocateEmpty();
        insertBack(&!goods, Item(name => fromLiteral("apple"), price => 3, note => noText()));
        insertBack(&!goods, Item(name => fromLiteral("pear <x>"), price => 12,
            note => Some(value => fromLiteral("ripe & sweet"))));
        let none: Buffer[Item] := allocateEmpty();
        let page: Page := Page(
            title => fromLiteral("Tom & Jerry's <Page>"),
            user => fromLiteral("Ann \"A\" O'Neil"),
            admin => true,
            count => 3,
            items => goods,
            empty => none,
            motto => Some(value => fromLiteral("  keep going  ")),
            missing => noText()
        );
        let result: String := render(&page);
        printLn(getSpan(&result, 0, textLength(&result) - 1));
        destroyString(result);
        let { title: String, user: String, admin: Bool, count: Int32, items: Buffer[Item],
            empty: Buffer[Item], motto: Option[String], missing: Option[String] } := page;
        destroyString(title);
        destroyString(user);
        destroyItems(items);
        destroyItems(empty);
        destroyOption(motto);
        destroyOption(missing);
        return ExitSuccess();
    end;
end module body.
