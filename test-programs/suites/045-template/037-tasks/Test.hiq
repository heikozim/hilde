-- Pages rendered in several tasks at once: each task owns its page,
-- renders it, yields, renders it again, and hands both renders back.  The
-- two tasks take turns at every yield (041-task shows that order), so the
-- renders of the two pages interleave.  See the README for what this does
-- not show.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    yieldNow
);
import Standard.Template (
    Render
);

module body Test is
    record Page: Linear is
        name: String;
        numbers: Buffer[Index];
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    -- The work of one task: render, yield, render, give the page back to
    -- nobody -- it is destroyed here -- and return both renders, one after
    -- the other.
    function work(page: Page): String is
        let first: String := render(&page);
        printLn("rendered once");
        yieldNow();
        let second: String := render(&page);
        printLn("rendered twice");
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, asSpan(&first));
        writeString(&!out, asSpan(&second));
        destroyString(first);
        destroyString(second);
        let { name: String, numbers: Buffer[Index] } := page;
        destroyString(name);
        destroyFree(numbers);
        return finalize(out);
    end;

    function makePage(name: Span[Nat8, Static], start: Index): Page is
        var numbers: Buffer[Index] := allocateEmpty();
        insertBack(&!numbers, start);
        insertBack(&!numbers, start + 1);
        insertBack(&!numbers, start + 2);
        return Page(name => fromLiteral(name), numbers => numbers);
    end;

    function show(text: String): Unit is
        printLn(getSpan(&text, 0, length(&text) - 1));
        destroyString(text);
        return nil;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let renderer: Fn[Page, String] := work;
                case spawn(&!scope, renderer, makePage("a<b", 1)) of
                    when Right(right as first: Task[String]) do
                        case spawn(&!scope, renderer, makePage("c&d", 10)) of
                            when Right(right as second: Task[String]) do
                                show(join(first));
                                show(join(second));
                            when Left(left as unused: Page) do
                                show(join(first));
                                let { name: String, numbers: Buffer[Index] } := unused;
                                destroyString(name);
                                destroyFree(numbers);
                                printLn("second task not started");
                        end case;
                    when Left(left as unused: Page) do
                        let { name: String, numbers: Buffer[Index] } := unused;
                        destroyString(name);
                        destroyFree(numbers);
                        printLn("first task not started");
                end case;
                closeScope(scope);
            when None do
                printLn("no scope");
        end case;
        return ExitSuccess();
    end;
end module body.
