-- page.jinja rendered with the data of data.json, built here by hand: every
-- form of the further Jinja2 syntax.  The expected output is Jinja2's on the same template
-- and the same data (scripts/jinja/oracle.py).
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeLast,
    destroyEmpty,
    length
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length as textLength,
    getSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Tuples (
    Pair
);
import Standard.Template (
    Render
);

module body Test is
    record User: Linear is
        name: String;
        active: Bool;
    end;

    record Person: Linear is
        name: String;
    end;

    record Page: Linear is
        title: String;
        name: String;
        word: String;
        sentence: String;
        n: Int32;
        m: Int32;
        items: Buffer[String];
        pairs: Buffer[Pair[String, Index]];
        users: Buffer[User];
        author: Person;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function destroyTexts(texts: Buffer[String]): Unit is
        var rest: Buffer[String] := texts;
        while length(&rest) > 0 do
            destroyString(removeLast(&!rest));
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function destroyPairs(pairs: Buffer[Pair[String, Index]]): Unit is
        var rest: Buffer[Pair[String, Index]] := pairs;
        while length(&rest) > 0 do
            let pair: Pair[String, Index] := removeLast(&!rest);
            let { first: String, second: Index } := pair;
            destroyString(first);
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function destroyUsers(users: Buffer[User]): Unit is
        var rest: Buffer[User] := users;
        while length(&rest) > 0 do
            let user: User := removeLast(&!rest);
            let { name: String, active: Bool } := user;
            destroyString(name);
        end while;
        destroyEmpty(rest);
        return nil;
    end;

    function main(): ExitCode is
        var items: Buffer[String] := allocateEmpty();
        insertBack(&!items, fromLiteral("a"));
        insertBack(&!items, fromLiteral("b<"));
        insertBack(&!items, fromLiteral("c"));
        var pairs: Buffer[Pair[String, Index]] := allocateEmpty();
        let xValue: Index := 1;
        let yValue: Index := 2;
        insertBack(&!pairs, Pair(first => fromLiteral("x"), second => xValue));
        insertBack(&!pairs, Pair(first => fromLiteral("y"), second => yValue));
        var users: Buffer[User] := allocateEmpty();
        insertBack(&!users, User(name => fromLiteral("Ann"), active => true));
        insertBack(&!users, User(name => fromLiteral("Ben"), active => false));
        insertBack(&!users, User(name => fromLiteral("Cy"), active => true));
        let page: Page := Page(
            title => fromLiteral("a tale-of two (cities)"),
            name => fromLiteral("Ada & <Bob>"),
            word => fromLiteral("hello world"),
            sentence => fromLiteral("The quick brown fox jumps over the lazy dog"),
            n => 7,
            m => -7,
            items => items,
            pairs => pairs,
            users => users,
            author => Person(name => fromLiteral("Eve"))
        );
        let result: String := render(&page);
        printLn(getSpan(&result, 0, textLength(&result) - 1));
        destroyString(result);
        let { title: String, name: String, word: String, sentence: String, n: Int32, m: Int32,
            items as texts: Buffer[String], pairs as two: Buffer[Pair[String, Index]],
            users as people: Buffer[User], author: Person } := page;
        destroyString(title);
        destroyString(name);
        destroyString(word);
        destroyString(sentence);
        destroyTexts(texts);
        destroyPairs(two);
        destroyUsers(people);
        let { name as authorName: String } := author;
        destroyString(authorName);
        return ExitSuccess();
    end;
end module body.
