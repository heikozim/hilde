module body Test is
    function main(): ExitCode is
        -- An arithmetic expression of float literals takes its type from
        -- the place it stands in, as a single float literal does.
        let x: Float32 := 0.1 + 0.2;
        let y: Float32 := (0.1 + 0.2) * 2.0;
        let z: Float32 := 1.0 / 3.0;
        printLn(x);
        printLn(y);
        printLn(z);
        return ExitSuccess();
    end;
end module body.
