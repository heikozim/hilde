import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree,
    swapIndex
);

module body Test is
    function main(): ExitCode is
        var buffer: Buffer[Nat32] := allocateEmpty();
        let one: Nat32 := 1;
        insertBack(&!buffer, one);
        insertBack(&!buffer, one);
        insertBack(&!buffer, one);
        let nine: Nat32 := 9;
        printLn("before");
        swapIndex(&!buffer, 0, 3); -- violates
        printLn("after");
        destroyFree(buffer);
        return ExitSuccess();
    end;
end module body.
