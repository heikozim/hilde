-- Standard.Bulk.fillBytes with a range that ends past its span: the
-- requires stops the programme at the call, before any byte is written.
import Standard.Buffer (
    Buffer,
    initialize,
    getSpanMut,
    destroyFree
);
import Standard.Bulk (
    fillBytes
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        var buf: Buffer[Nat8] := initialize(8, 0);
        borrow b: &![Buffer[Nat8], R] := &!buf do
            let sp: Span![Nat8, R] := getSpanMut(b, 0, 7);
            fillBytes(sp, 4, 5, 1);
        end borrow;
        destroyFree(buf);
        printLn("after");
        return ExitSuccess();
    end;
end module body.
