import Standard.String (
    String,
    fromLiteral,
    destroyString,
    getSpan
);

module body Test is
    function main(): ExitCode is
        var text: String := fromLiteral("abc");
        let byte: Nat8 := 65;
        printLn("before");
        printLn(spanLength(getSpan(&text, 2, 1))); -- violates
        printLn("after");
        destroyString(text);
        return ExitSuccess();
    end;
end module body.
