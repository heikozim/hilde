import Standard.String (
    String,
    fromLiteral,
    destroyString,
    nthByte
);

module body Test is
    function main(): ExitCode is
        var text: String := fromLiteral("abc");
        let byte: Nat8 := 65;
        printLn("before");
        printLn(nthByte(&text, 3)); -- violates
        printLn("after");
        destroyString(text);
        return ExitSuccess();
    end;
end module body.
