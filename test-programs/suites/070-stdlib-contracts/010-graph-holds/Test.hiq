import Standard.Tuples (
    Pair
);
import Standard.Buffer (
    Buffer,
    destroyEmpty as destroyEmptyBuffer
);
import Standard.Graph (
    Graph,
    NodeId,
    makeGraph,
    addNode,
    removeNode,
    nodeCount,
    destroyEmpty
);

module body Test is
    function dropRemoved(removed: Option[Pair[Nat32, Buffer[Nat32]]]): Unit is
        case removed of
            when Some(value as pair: Pair[Nat32, Buffer[Nat32]]) do
                let { first: Nat32, second: Buffer[Nat32] } := pair;
                destroyEmptyBuffer(second);
            when None do
                skip;
        end case;
        return nil;
    end;

    function main(): ExitCode is
        var empty: Graph[Nat32, Nat32] := makeGraph();
        destroyEmpty(empty);
        var graph: Graph[Nat32, Nat32] := makeGraph();
        let five: Nat32 := 5;
        let node: NodeId := addNode(&!graph, five);
        print("nodes ");
        printLn(nodeCount(&graph));
        dropRemoved(removeNode(&!graph, node));
        print("nodes ");
        printLn(nodeCount(&graph));
        destroyEmpty(graph);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
