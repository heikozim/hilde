import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyEmpty
);

module body Test is
    function main(): ExitCode is
        var buffer: Buffer[Nat32] := allocateEmpty();
        let seven: Nat32 := 7;
        insertBack(&!buffer, seven);
        printLn("before");
        destroyEmpty(buffer); -- violates
        printLn("after");
        return ExitSuccess();
    end;
end module body.
