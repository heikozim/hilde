import Standard.Graph (
    Graph,
    NodeId,
    makeGraph,
    addNode,
    destroyEmpty
);

module body Test is
    function main(): ExitCode is
        var graph: Graph[Nat32, Nat32] := makeGraph();
        let five: Nat32 := 5;
        let node: NodeId := addNode(&!graph, five);
        printLn("before");
        destroyEmpty(graph); -- violates
        printLn("after");
        return ExitSuccess();
    end;
end module body.
