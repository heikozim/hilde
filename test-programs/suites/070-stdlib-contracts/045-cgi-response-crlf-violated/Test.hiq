import Standard.String (
    String,
    destroyString
);
import Standard.FcgiServer (
    cgiResponse
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        -- A carriage return and a line feed in the type would add a header
        -- line of the caller's text to the answer.
        let output: String := cgiResponse(200, "text/plain\r\nSet-Cookie: session=stolen", "body"); -- violates
        printLn("after");
        destroyString(output);
        return ExitSuccess();
    end;
end module body.
