import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree,
    getSpanMut
);

module body Test is
    generic [R: Region]
    function touch(buffer: &![Buffer[Nat32], R], start: Index, final: Index): Unit is
        var window: Span![Nat32, R] := getSpanMut(buffer, start, final); -- violates
        let nine: Nat32 := 9;
        window[0] := nine;
        return nil;
    end;

    function main(): ExitCode is
        var buffer: Buffer[Nat32] := allocateEmpty();
        let one: Nat32 := 1;
        insertBack(&!buffer, one);
        insertBack(&!buffer, one);
        insertBack(&!buffer, one);
        let nine: Nat32 := 9;
        printLn("before");
        touch(&!buffer, 2, 1);
        printLn("after");
        destroyFree(buffer);
        return ExitSuccess();
    end;
end module body.
