import Standard.Arguments (
    Spec,
    option,
    fromEnvironment
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        let spec: Spec := fromEnvironment(option("level", 'l', "Help."), "BAD NAME"); -- violates
        printLn("after");
        return ExitSuccess();
    end;
end module body.
