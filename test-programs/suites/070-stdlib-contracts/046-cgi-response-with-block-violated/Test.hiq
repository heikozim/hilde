import Standard.String (
    String,
    destroyString
);
import Standard.FcgiServer (
    cgiResponseWith
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        -- An empty line in the block would end the header and make the rest
        -- of the block the start of the body.
        let output: String := cgiResponseWith(200, "text/plain", "Location: /a\r\n\r\n<script>", "body"); -- violates
        printLn("after");
        destroyString(output);
        return ExitSuccess();
    end;
end module body.
