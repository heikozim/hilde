import Standard.Arguments (
    Command,
    PositionalKey,
    makeCommand,
    addPositional,
    destroyCommand
);

module body Test is
    function main(): ExitCode is
        var command: Command := makeCommand("pack", "About.");
        printLn("before");
        let key: PositionalKey := addPositional(&!command, "bad name", "Help.", true, false); -- violates
        destroyCommand(command);
        printLn("after");
        return ExitSuccess();
    end;
end module body.
