-- Bindings.X509.rsaBits with a kind that is no kind of RSA: the requires
-- stops the programme instead of falling back on 4096 bits.  Kind 1 is
-- P-256.  Only the standard library imports a binding, so the probe calls
-- itself Standard.RsaBitsProbe.
import Bindings.X509 (
    kindRsa2048,
    rsaBits
);

module body Standard.RsaBitsProbe is
    function main(): ExitCode is
        printLn(rsaBits(kindRsa2048()));
        let p256: Int32 := 1;
        printLn(rsaBits(p256));
        printLn("not reached");
        return ExitSuccess();
    end;
end module body.
