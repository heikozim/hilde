-- Standard.SqliteReplica.openStore with an empty path: a store needs the
-- file of its database, and the requires stops the programme at the call.
import Standard.String (
    String,
    destroyString
);
import Standard.SqliteReplica (
    Store,
    openStore,
    closeStore
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openStore("", ".") of
            when Right(right as store: Store) do
                printLn("not reached");
                closeStore(store);
            when Left(left as message: String) do
                printLn("not reached");
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
