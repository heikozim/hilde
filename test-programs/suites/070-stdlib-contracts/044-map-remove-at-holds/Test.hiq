import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyEmpty,
    put,
    removeAt,
    size
);

module body Test is
    function drop(previous: Option[Pair[Nat32, Nat32]]): Unit is
        case previous of
            when Some(value as pair: Pair[Nat32, Nat32]) do
                let { first: Nat32, second: Nat32 } := pair;
            when None do
                skip;
        end case;
        return nil;
    end;

    function secondOf(pair: Pair[Nat32, Nat32]): Nat32 is
        let { first: Nat32, second as value: Nat32 } := pair;
        return value;
    end;

    function main(): ExitCode is
        var map: Map[Nat32, Nat32] := makeMap();
        let one: Nat32 := 1;
        let ten: Nat32 := 10;
        drop(put(&!map, one, ten));
        print("size ");
        printLn(size(&map));
        print("removed ");
        printLn(secondOf(removeAt(&!map, 0)));
        print("size ");
        printLn(size(&map));
        destroyEmpty(map);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
