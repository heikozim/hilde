import Standard.String (
    String,
    fromLiteral,
    destroyString,
    getSpanMut
);

module body Test is
    generic [R: Region]
    function touch(text: &![String, R], start: Index, final: Index): Unit is
        var window: Span![Nat8, R] := getSpanMut(text, start, final); -- violates
        let letter: Nat8 := 65;
        window[0] := letter;
        return nil;
    end;

    function main(): ExitCode is
        var text: String := fromLiteral("abc");
        let byte: Nat8 := 65;
        printLn("before");
        touch(&!text, 2, 1);
        printLn("after");
        destroyString(text);
        return ExitSuccess();
    end;
end module body.
