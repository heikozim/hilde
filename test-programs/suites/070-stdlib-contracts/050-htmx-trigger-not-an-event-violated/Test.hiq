-- Standard.Htmx.triggerHeader with a value that would end the line and
-- add a header of its own: the requires stops the programme at the call.
import Standard.String (
    String,
    destroyString,
    length
);
import Standard.Htmx (
    triggerHeader
);

module body Test is
    function main(): ExitCode is
        let good: String := triggerHeader("item-saved");
        printLn(length(&good));
        destroyString(good);
        let bad: String := triggerHeader("saved\r\nSet-Cookie: session=x");
        printLn("not reached");
        destroyString(bad);
        return ExitSuccess();
    end;
end module body.
