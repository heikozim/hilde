-- Bindings.X509.rsaBits: the bits of each of the three kinds of RSA.  Only
-- the standard library imports a binding, so the probe calls itself
-- Standard.RsaBitsProbe.
import Bindings.X509 (
    kindRsa2048,
    kindRsa3072,
    kindRsa4096,
    rsaBits
);

module body Standard.RsaBitsProbe is
    function main(): ExitCode is
        printLn(rsaBits(kindRsa2048()));
        printLn(rsaBits(kindRsa3072()));
        printLn(rsaBits(kindRsa4096()));
        return ExitSuccess();
    end;
end module body.
