-- Standard.Search.indexDocument with an empty key: a document is found
-- again and replaced only by its key, and the requires stops the
-- programme at the call, before any statement runs.
import Standard.Database (
    Database,
    Writing,
    DbError,
    closeDatabase
);
import Standard.Database.Sqlite (
    openSqlite
);
import Standard.Search (
    SearchError,
    indexDocument
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openSqlite(":memory:") of
            when Right(right as db: Database[Writing]) do
                var open: Database[Writing] := db;
                case indexDocument(&!open, "", "title", "body") of
                    when Right(right as done: Unit) do
                        printLn("not reached");
                    when Left(left as error: SearchError) do
                        printLn("not reached");
                end case;
                closeDatabase(open);
            when Left(left as error: DbError) do
                printLn("no database");
        end case;
        return ExitSuccess();
    end;
end module body.
