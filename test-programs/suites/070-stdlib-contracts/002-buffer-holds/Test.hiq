import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    removeFirst,
    length,
    destroyEmpty
);

module body Test is
    function main(): ExitCode is
        var empty: Buffer[Nat32] := allocateEmpty();
        destroyEmpty(empty);
        var buffer: Buffer[Nat32] := allocateEmpty();
        let seven: Nat32 := 7;
        insertBack(&!buffer, seven);
        let taken: Nat32 := removeFirst(&!buffer);
        print("taken ");
        printLn(taken);
        print("left ");
        printLn(length(&buffer));
        destroyEmpty(buffer);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
