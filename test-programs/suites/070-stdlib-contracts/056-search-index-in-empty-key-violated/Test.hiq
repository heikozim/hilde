-- Standard.Search.indexDocumentIn with an empty key: inside the caller's
-- transaction too a document is found again only by its key, and the
-- requires stops the programme at the call, before any statement runs.
import Standard.Database (
    Database,
    Writing,
    DbError,
    Transaction,
    closeDatabase,
    begin,
    rollback
);
import Standard.Database.Sqlite (
    openSqlite
);
import Standard.Search (
    SearchError,
    indexDocumentIn
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openSqlite(":memory:") of
            when Right(right as db: Database[Writing]) do
                var open: Database[Writing] := db;
                case begin(&!open) of
                    when Right(right as transaction: Transaction) do
                        case indexDocumentIn(&!open, &transaction, "", "title", "body") of
                            when Right(right as done: Unit) do
                                printLn("not reached");
                            when Left(left as error: SearchError) do
                                printLn("not reached");
                        end case;
                        rollback(&!open, transaction);
                    when Left(left as error: DbError) do
                        printLn("no transaction");
                end case;
                closeDatabase(open);
            when Left(left as error: DbError) do
                printLn("no database");
        end case;
        return ExitSuccess();
    end;
end module body.
