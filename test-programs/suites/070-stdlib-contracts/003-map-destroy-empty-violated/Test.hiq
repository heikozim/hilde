import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyEmpty,
    put
);

module body Test is
    function drop(previous: Option[Pair[Nat32, Nat32]]): Unit is
        case previous of
            when Some(value as pair: Pair[Nat32, Nat32]) do
                let { first: Nat32, second: Nat32 } := pair;
            when None do
                skip;
        end case;
        return nil;
    end;

    function dropPair(pair: Pair[Nat32, Nat32]): Unit is
        let { first: Nat32, second: Nat32 } := pair;
        return nil;
    end;

    function main(): ExitCode is
        var map: Map[Nat32, Nat32] := makeMap();
        let one: Nat32 := 1;
        let ten: Nat32 := 10;
        drop(put(&!map, one, ten));
        printLn("before");
        destroyEmpty(map); -- violates
        printLn("after");
        return ExitSuccess();
    end;
end module body.
