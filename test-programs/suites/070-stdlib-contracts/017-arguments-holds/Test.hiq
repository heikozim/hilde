import Standard.Arguments (
    Command,
    Spec,
    TextKey,
    PositionalKey,
    makeCommand,
    addAlias,
    option,
    fromEnvironment,
    addText,
    addPositional,
    destroyCommand,
    isName,
    isOptionNames
);

module body Test is
    function main(): ExitCode is
        print("a-b_1 is a name: ");
        printLn(isName("a-b_1"));
        print("empty is a name: ");
        printLn(isName(""));
        print("-a is a name: ");
        printLn(isName("-a"));
        print("a b is a name: ");
        printLn(isName("a b"));
        print("no long name and no letter name an option: ");
        printLn(isOptionNames("", 0));
        print("level and l name an option: ");
        printLn(isOptionNames("level", 'l'));
        print("a letter alone names an option: ");
        printLn(isOptionNames("", 'v'));
        print("a question mark is no letter: ");
        printLn(isOptionNames("level", '?'));
        var command: Command := makeCommand("pack", "A tool.");
        addAlias(&!command, "p");
        let spec: Spec := fromEnvironment(option("level", 'l', "The level."), "PACK_LEVEL");
        let level: TextKey := addText(&!command, spec, "info");
        let none: Spec := fromEnvironment(option("", 'q', "Quiet."), "");
        let file: PositionalKey := addPositional(&!command, "file", "The file.", true, false);
        destroyCommand(command);
        printLn("built");
        return ExitSuccess();
    end;
end module body.
