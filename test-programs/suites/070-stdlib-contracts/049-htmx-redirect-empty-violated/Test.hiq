-- Standard.Htmx.redirectHeader with an empty URL: the requires stops the
-- programme at the call, before a line HX-Redirect without a target is
-- written.
import Standard.String (
    String,
    destroyString,
    length
);
import Standard.Htmx (
    redirectHeader
);

module body Test is
    function main(): ExitCode is
        let good: String := redirectHeader("/orders");
        printLn(length(&good));
        destroyString(good);
        let empty: String := redirectHeader("");
        printLn("not reached");
        destroyString(empty);
        return ExitSuccess();
    end;
end module body.
