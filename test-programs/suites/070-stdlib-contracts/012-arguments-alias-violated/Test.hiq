import Standard.Arguments (
    Command,
    makeCommand,
    addAlias,
    destroyCommand
);

module body Test is
    function main(): ExitCode is
        var command: Command := makeCommand("pack", "About.");
        printLn("before");
        addAlias(&!command, "a b"); -- violates
        destroyCommand(command);
        printLn("after");
        return ExitSuccess();
    end;
end module body.
