import Standard.String (
    String,
    fromLiteral,
    fromSpan,
    length,
    nthByte,
    storeNth,
    getSpan,
    getSpanMut,
    asSpan,
    destroyString
);

module body Test is
    generic [R: Region]
    function setTail(text: &![String, R], value: Nat8): Unit is
        var window: Span![Nat8, R] := getSpanMut(text, 1, 2);
        window[0] := value;
        window[1] := value;
        return nil;
    end;

    function main(): ExitCode is
        var text: String := fromLiteral("abc");
        print("length ");
        printLn(length(&text));
        print("nthByte ");
        printLn(nthByte(&text, 1));
        let big: Nat8 := 66;
        storeNth(&!text, 1, big);
        print("stored ");
        printLn(nthByte(&text, 1));
        print("span ");
        printLn(spanLength(getSpan(&text, 0, 1)));
        print("whole ");
        printLn(spanLength(asSpan(&text)));
        let ninety: Nat8 := 90;
        setTail(&!text, ninety);
        print("mutable ");
        printLn(nthByte(&text, 2));
        var copy: String := fromSpan(getSpan(&text, 1, 2));
        print("copy ");
        printLn(length(&copy));
        destroyString(copy);
        destroyString(text);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
