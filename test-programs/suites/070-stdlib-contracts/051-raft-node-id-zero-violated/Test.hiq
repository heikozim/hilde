-- Standard.Raft.newNode with the id 0, which stands for no node in its
-- messages: the requires stops the programme at the call.  A node with
-- the id 1 is made first.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack
);
import Standard.Raft (
    Config,
    Node,
    majority,
    newNode,
    destroyNode,
    nodeId
);

module body Test is
    function members(): Buffer[Nat64] is
        var ids: Buffer[Nat64] := allocateEmpty();
        let one: Nat64 := 1;
        insertBack(&!ids, one);
        return ids;
    end;

    function main(): ExitCode is
        let good: Node := newNode(Config(id => 1, electionTicks => 10, heartbeatTicks => 2, seed => 7, quorum => majority), members());
        printLn(nodeId(&good));
        destroyNode(good);
        let zero: Node := newNode(Config(id => 0, electionTicks => 10, heartbeatTicks => 2, seed => 7, quorum => majority), members());
        printLn("not reached");
        destroyNode(zero);
        return ExitSuccess();
    end;
end module body.
