-- Standard.HttpClient.requestAs with an empty key file: a client
-- certificate is presented only with the key that proves it, and the
-- requires stops the programme at the call, before any connection.
import Standard.String (
    String,
    destroyString
);
import Standard.HttpClient (
    Get,
    Limits,
    Failure,
    Response,
    defaultLimits,
    destroyFailure,
    destroyResponse,
    requestAs
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case requestAs(Get(), "https://localhost/", "", "", "ca.pem", "client-cert.pem", "", defaultLimits()) of
            when Right(right as response: Response) do
                printLn("not reached");
                destroyResponse(response);
            when Left(left as failed: Failure) do
                printLn("not reached");
                destroyFailure(failed);
        end case;
        return ExitSuccess();
    end;
end module body.
