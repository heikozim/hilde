import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyEmpty,
    put,
    size,
    keyAt,
    valueAt,
    removeAt
);

module body Test is
    function drop(previous: Option[Pair[Nat32, Nat32]]): Unit is
        case previous of
            when Some(value as pair: Pair[Nat32, Nat32]) do
                let { first: Nat32, second: Nat32 } := pair;
            when None do
                skip;
        end case;
        return nil;
    end;

    function dropPair(pair: Pair[Nat32, Nat32]): Unit is
        let { first: Nat32, second: Nat32 } := pair;
        return nil;
    end;

    generic [R: Region]
    function show(map: &[Map[Nat32, Nat32], R], pos: Index): Unit is
        print("key ");
        print(!keyAt(map, pos));
        print(" value ");
        printLn(!valueAt(map, pos));
        return nil;
    end;

    function main(): ExitCode is
        var empty: Map[Nat32, Nat32] := makeMap();
        destroyEmpty(empty);
        var map: Map[Nat32, Nat32] := makeMap();
        let two: Nat32 := 2;
        let twenty: Nat32 := 20;
        let one: Nat32 := 1;
        let ten: Nat32 := 10;
        drop(put(&!map, two, twenty));
        drop(put(&!map, one, ten));
        show(&map, 0);
        show(&map, size(&map) - 1);
        dropPair(removeAt(&!map, 0));
        dropPair(removeAt(&!map, 0));
        destroyEmpty(map);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
