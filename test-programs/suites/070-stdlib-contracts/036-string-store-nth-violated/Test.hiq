import Standard.String (
    String,
    fromLiteral,
    destroyString,
    storeNth
);

module body Test is
    function main(): ExitCode is
        var text: String := fromLiteral("abc");
        let byte: Nat8 := 65;
        printLn("before");
        storeNth(&!text, 3, byte); -- violates
        printLn("after");
        destroyString(text);
        return ExitSuccess();
    end;
end module body.
