-- Standard.Tls.makeVerifyingServer with an empty CA file: a server for
-- mutual TLS needs the authority its clients are verified against, and the
-- requires stops the programme at the call.
import Standard.String (
    String,
    destroyString
);
import Standard.Tls (
    Server,
    makeVerifyingServer,
    closeServer
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case makeVerifyingServer("server.pem", "server-key.pem", "") of
            when Right(right as server: Server) do
                printLn("not reached");
                closeServer(server);
            when Left(left as message: String) do
                printLn("not reached");
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
