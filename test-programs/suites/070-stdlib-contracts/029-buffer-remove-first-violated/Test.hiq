import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree,
    removeFirst
);

module body Test is
    function main(): ExitCode is
        var buffer: Buffer[Nat32] := allocateEmpty();
        let nine: Nat32 := 9;
        printLn("before");
        printLn(removeFirst(&!buffer)); -- violates
        printLn("after");
        destroyFree(buffer);
        return ExitSuccess();
    end;
end module body.
