import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    insertFront,
    insert,
    storeNth,
    nthMut,
    nthRef,
    swapNth,
    swapIndex,
    removeFirst,
    removeLast,
    remove,
    length,
    getSpan,
    getSpanMut,
    wholeSpan,
    destroyFree
);

module body Test is
    generic [R: Region]
    function setBoth(buffer: &![Buffer[Nat32], R], value: Nat32): Unit is
        var window: Span![Nat32, R] := getSpanMut(buffer, 0, 1);
        window[0] := value;
        window[1] := value;
        return nil;
    end;

    function main(): ExitCode is
        var buffer: Buffer[Nat32] := allocateEmpty();
        let ten: Nat32 := 10;
        let twenty: Nat32 := 20;
        let thirty: Nat32 := 30;
        insertBack(&!buffer, ten);
        insertBack(&!buffer, twenty);
        insertBack(&!buffer, thirty);
        let five: Nat32 := 5;
        let fifteen: Nat32 := 15;
        insertFront(&!buffer, five);
        insert(&!buffer, 2, fifteen);
        print("length ");
        printLn(length(&buffer));
        let six: Nat32 := 6;
        storeNth(&!buffer, 0, six);
        print("first ");
        printLn(nthMut(&!buffer, 0));
        print("second ");
        printLn(nthMut(&!buffer, 1));
        print("third ");
        printLn(!nthRef(&buffer, 2));
        let twentyOne: Nat32 := 21;
        print("swapNth ");
        printLn(swapNth(&!buffer, 3, twentyOne));
        swapIndex(&!buffer, 0, 4);
        print("swapIndex ");
        printLn(nthMut(&!buffer, 0));
        print("removeFirst ");
        printLn(removeFirst(&!buffer));
        print("removeLast ");
        printLn(removeLast(&!buffer));
        print("remove ");
        printLn(remove(&!buffer, 1));
        print("length ");
        printLn(length(&buffer));
        print("span ");
        printLn(spanLength(getSpan(&buffer, 0, 1)));
        print("whole ");
        printLn(spanLength(wholeSpan(&buffer)));
        setBoth(&!buffer, 40);
        print("mutable ");
        printLn(nthMut(&!buffer, 1));
        destroyFree(buffer);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
