import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    destroyFree,
    swapTransform
);

module body Test is
    function bump(value: Nat32): Nat32 is
        return value + 1;
    end;

    function main(): ExitCode is
        var buffer: Buffer[Nat32] := allocateEmpty();
        let one: Nat32 := 1;
        insertBack(&!buffer, one);
        insertBack(&!buffer, one);
        insertBack(&!buffer, one);
        let nine: Nat32 := 9;
        printLn("before");
        swapTransform(&!buffer, 3, bump); -- violates
        printLn("after");
        destroyFree(buffer);
        return ExitSuccess();
    end;
end module body.
