import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Hash (
    Hashable
);
import Standard.HashMap (
    HashMap,
    makeHashMap,
    destroyEmpty,
    put,
    size,
    removeAt
);

module body Test is
    function drop(previous: Option[Pair[Nat32, Nat32]]): Unit is
        case previous of
            when Some(value as pair: Pair[Nat32, Nat32]) do
                let { first: Nat32, second: Nat32 } := pair;
            when None do
                skip;
        end case;
        return nil;
    end;

    function main(): ExitCode is
        var empty: HashMap[Nat32, Nat32] := makeHashMap();
        destroyEmpty(empty);
        var map: HashMap[Nat32, Nat32] := makeHashMap();
        let one: Nat32 := 1;
        let ten: Nat32 := 10;
        drop(put(&!map, one, ten));
        print("size ");
        printLn(size(&map));
        drop(removeAt(&!map, 0));
        print("size ");
        printLn(size(&map));
        destroyEmpty(map);
        printLn("destroyed");
        return ExitSuccess();
    end;
end module body.
