import Standard.String (
    String,
    destroyString,
    length,
    nthByte,
    asSpan
);
import Standard.File (
    FileDescriptor,
    Erasure,
    Overwritten,
    OnlyUnlinked,
    NotErased,
    openRead,
    openWrite,
    closeFile,
    readAll,
    writeAll,
    linkFile,
    createSymlink,
    removeFile,
    secureDelete
);

module body Test is
    function said(result: Erasure): Span[Nat8, Static] is
        case result of
            when Overwritten do
                return "overwritten";
            when OnlyUnlinked do
                return "only unlinked";
            when NotErased do
                return "not erased";
        end case;
    end;

    function put(path: Span[Nat8, Static], text: Span[Nat8, Static]): Bool is
        case openWrite(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, text);
                let closed: Bool := closeFile(file);
                return written and closed;
            when None do
                return false;
        end case;
    end;

    -- The bytes of the file at path, or the word missing.
    function shown(path: Span[Nat8, Static]): Unit is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                case readAll(&!file) of
                    when Some(value as text: String) do
                        printLn(asSpan(&text));
                        destroyString(text);
                    when None do
                        printLn("unreadable");
                end case;
                let closed: Bool := closeFile(file);
            when None do
                printLn("missing");
        end case;
        return nil;
    end;

    -- Whether the text read through a descriptor opened before the erasure
    -- has the length of the original and none of its bytes in place.
    generic [R: Region]
    function differs(text: &[String, R], original: Span[Nat8, Static]): Bool is
        if length(text) /= spanLength(original) then
            return false;
        end if;
        var same: Index := 0;
        var i: Index := 0;
        while i < spanLength(original) do
            if nthByte(text, i) = original[i] then
                same := same + 1;
            end if;
            i := i + 1;
        end while;
        return same < 8;
    end;

    function main(): ExitCode is
        let original: Span[Nat8, Static] := "secret contents, written to be overwritten by the test.";
        printLn(put("plain.txt", original));
        printLn(said(secureDelete("plain.txt")));
        shown("plain.txt");
        printLn(put("held.txt", original));
        case openRead("held.txt") of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                printLn(said(secureDelete("held.txt")));
                case readAll(&!file) of
                    when Some(value as text: String) do
                        printLn(differs(&text, original));
                        destroyString(text);
                    when None do
                        printLn("unreadable");
                end case;
                let closed: Bool := closeFile(file);
            when None do
                printLn("not opened");
        end case;
        printLn(put("first.txt", original));
        printLn(linkFile("first.txt", "second.txt"));
        printLn(said(secureDelete("first.txt")));
        shown("first.txt");
        shown("second.txt");
        printLn(said(secureDelete("second.txt")));
        printLn(put("target.txt", "the target"));
        printLn(createSymlink("target.txt", "pointer"));
        printLn(said(secureDelete("pointer")));
        shown("target.txt");
        printLn(removeFile("pointer"));
        printLn(said(secureDelete("target.txt")));
        printLn(put("empty.txt", ""));
        printLn(said(secureDelete("empty.txt")));
        printLn(said(secureDelete("missing.txt")));
        printLn(said(secureDelete(".")));
        printLn(put("kept.txt", "kept"));
        printLn(said(secureDelete("kept.txt\u{0}x")));
        shown("kept.txt");
        printLn(said(secureDelete("kept.txt")));
        return ExitSuccess();
    end;
end module body.
