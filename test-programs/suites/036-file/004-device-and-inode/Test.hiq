import Standard.File (
    FileDescriptor,
    FileStatus,
    FileLookup,
    FileFound,
    FileMissing,
    FileUnreadable,
    kindUnknown,
    createNewFile,
    openAppend,
    closeFile,
    createSymlink,
    linkFile,
    renameFile,
    statusOf,
    statusOfOpen
);

module body Test is
    -- The status of the name, or a status of zeros when nothing is there.
    function lookAt(path: Span[Nat8, Static]): FileStatus is
        case statusOf(path) of
            when FileFound(status: FileStatus) do
                return status;
            when FileMissing do
                return nothing();
            when FileUnreadable do
                return nothing();
        end case;
    end;

    function nothing(): FileStatus is
        let zero: Nat32 := 0;
        let none: Nat64 := 0;
        return FileStatus(kind => kindUnknown, mode => zero, owner => zero, group => zero, size => none, device => none, inode => none, links => none);
    end;

    function same(a: FileStatus, b: FileStatus): Bool is
        return (a.device = b.device) and (a.inode = b.inode);
    end;

    function made(path: Span[Nat8, Static]): Bool is
        let mode: Nat32 := 384;
        case createNewFile(path, mode) of
            when Some(value as opened: FileDescriptor) do
                return closeFile(opened);
            when None do
                return false;
        end case;
    end;

    -- Whether the open file is the file the name shows.
    function openIsNamed(path: Span[Nat8, Static]): Bool is
        let mode: Nat32 := 384;
        let named: FileStatus := lookAt(path);
        case openAppend(path, mode) of
            when Some(value as opened: FileDescriptor) do
                var result: Bool := false;
                case statusOfOpen(&opened) of
                    when Some(value as mine: FileStatus) do
                        result := same(mine, named);
                    when None do
                        result := false;
                end case;
                let closed: Bool := closeFile(opened);
                return result and closed;
            when None do
                return false;
        end case;
    end;

    function main(): ExitCode is
        let zero: Nat64 := 0;
        let one: Nat64 := 1;
        let two: Nat64 := 2;
        printLn(made("app.log"));
        let first: FileStatus := lookAt("app.log");
        printLn(first.inode /= zero);
        printLn(first.links = one);
        printLn(openIsNamed("app.log"));
        printLn(linkFile("app.log", "hard.log"));
        let linked: FileStatus := lookAt("hard.log");
        printLn(linked.links = two);
        printLn(same(lookAt("hard.log"), first));
        printLn(createSymlink("app.log", "soft.log"));
        printLn(same(lookAt("soft.log"), first));
        printLn(made("next.log"));
        printLn(renameFile("next.log", "app.log"));
        printLn(same(lookAt("app.log"), first));
        printLn(same(lookAt("hard.log"), first));
        let left: FileStatus := lookAt("hard.log");
        printLn(left.links = one);
        return ExitSuccess();
    end;
end module body.
