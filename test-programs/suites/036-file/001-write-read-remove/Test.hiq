import Standard.String (
    String,
    makeString,
    makeEmpty,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    storeNth,
    asSpan
);
import Standard.File (
    FileDescriptor,
    openRead,
    openWrite,
    closeFile,
    readAll,
    writeAll,
    fileNumber,
    removeFile
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region, S: Region]
    function sameBytes(left: &[String, R], right: &[String, S]): Bool is
        let size: Index := length(left);
        if size /= length(right) then
            return false;
        end if;
        if size = 0 then
            return true;
        end if;
        var same: Bool := true;
        for i from 0 to size - 1 do
            if nthByte(left, i) /= nthByte(right, i) then
                same := false;
            end if;
        end for;
        return same;
    end;

    -- Opens and closes at once: the question is whether the name is there.
    generic [R: Region]
    function exists(path: &[String, R]): Bool is
        case openRead(asSpan(path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                closeFile(file);
                return true;
            when None do
                return false;
        end case;
    end;

    -- Write a string to a name, and say whether every step worked.
    generic [R: Region, S: Region]
    function putFile(path: &[String, R], data: &[String, S]): Bool is
        case openWrite(asSpan(path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, asSpan(data));
                let closed: Bool := closeFile(file);
                if written then
                    return closed;
                end if;
                return false;
            when None do
                return false;
        end case;
    end;

    -- Read a name back and compare it with what was written.
    generic [R: Region, S: Region]
    function fileHolds(path: &[String, R], expected: &[String, S]): Bool is
        case openRead(asSpan(path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                var verdict: Bool := false;
                case readAll(&!file) of
                    when Some(value as got: String) do
                        var content: String := got;
                        verdict := sameBytes(&content, expected);
                        destroyString(content);
                    when None do
                        verdict := false;
                end case;
                closeFile(file);
                return verdict;
            when None do
                return false;
        end case;
    end;

    function main(): ExitCode is
        var path: String := fromLiteral("hilde-036-file-probe.tmp");
        var payload: String := fromLiteral("the quick brown fox");
        var empty: String := makeEmpty();

        -- 1. The name is the suite's own, and nothing may be there yet.
        printLn(widen(not exists(&path)));

        -- 2. Write it, 3. read it back byte for byte.
        printLn(widen(putFile(&path, &payload)));
        printLn(widen(fileHolds(&path, &payload)));

        -- 4. The descriptor the kernel gave is a real one: 0, 1 and 2 are
        --    taken by the standard streams, so an opened file is above them.
        case openRead(asSpan(&path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                printLn(widen(fileNumber(&file) > 2));
                closeFile(file);
            when None do
                printLn(0);
        end case;

        -- 5. A path with a zero byte in the middle is refused, and this is
        --    the case that shows the check does something: the bytes before
        --    the zero name the file that was just written, so an
        --    implementation that handed the path to the kernel as it stands
        --    would open it and answer true here.
        var attack: String := makeString(30, 0);
        for i from 0 to length(&path) - 1 do
            storeNth(&!attack, i, nthByte(&path, i));
        end for;
        -- Byte 24 is the zero; what follows is junk that must never be
        -- reached.
        storeNth(&!attack, 25, 'X');
        storeNth(&!attack, 26, 'Y');
        printLn(widen(not exists(&attack)));
        printLn(widen(not removeFile(asSpan(&attack))));

        -- 6. The negative control for 5, without which it says nothing: the
        --    same name without the tail opens.
        printLn(widen(exists(&path)));

        -- 7. An empty file reads back as an empty string, which is not the
        --    same answer as a failure and is not reported as one.
        var second: String := fromLiteral("hilde-036-file-empty.tmp");
        printLn(widen(putFile(&second, &empty)));
        printLn(widen(fileHolds(&second, &empty)));
        printLn(widen(not fileHolds(&second, &payload)));

        -- 8. Removing takes the name away, and removing twice is false the
        --    second time.
        printLn(widen(removeFile(asSpan(&path))));
        printLn(widen(not exists(&path)));
        printLn(widen(removeFile(asSpan(&second))));
        printLn(widen(not removeFile(asSpan(&second))));

        destroyString(path);
        destroyString(payload);
        destroyString(empty);
        destroyString(attack);
        destroyString(second);
        return ExitSuccess();
    end;
end module body.
