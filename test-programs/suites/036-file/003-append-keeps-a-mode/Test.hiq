import Standard.File (
    FileDescriptor,
    FileStatus,
    FileLookup,
    FileFound,
    FileMissing,
    FileUnreadable,
    createNewFile,
    openAppend,
    closeFile,
    createSymlink,
    statusOf
);

module body Test is
    -- The permission bits of the name, or 0 when nothing is there.
    function modeOf(path: Span[Nat8, Static]): Nat32 is
        case statusOf(path) of
            when FileFound(status: FileStatus) do
                return bitwiseAnd(status.mode, (511 : Nat32));
            when FileMissing do
                return 0;
            when FileUnreadable do
                return 0;
        end case;
    end;

    function made(path: Span[Nat8, Static], mode: Nat32): Bool is
        case createNewFile(path, mode) of
            when Some(value as opened: FileDescriptor) do
                return closeFile(opened);
            when None do
                return false;
        end case;
    end;

    function append(path: Span[Nat8, Static], mode: Nat32): Span[Nat8, Static] is
        case openAppend(path, mode) of
            when Some(value as opened: FileDescriptor) do
                let closed: Bool := closeFile(opened);
                return "opened";
            when None do
                return "refused";
        end case;
    end;

    -- 384 is 0600, 420 is 0644, 416 is 0640.
    function main(): ExitCode is
        let owner: Nat32 := 384;
        let wide: Nat32 := 420;
        let group: Nat32 := 416;
        printLn(made("kept.log", owner));
        printLn(modeOf("kept.log"));
        printLn(append("kept.log", wide));
        printLn(modeOf("kept.log"));
        printLn(append("made.log", group));
        printLn(modeOf("made.log"));
        printLn(createSymlink("kept.log", "link.log"));
        printLn(append("link.log", wide));
        printLn(modeOf("kept.log"));
        return ExitSuccess();
    end;
end module body.
