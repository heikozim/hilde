import Standard.Array (
    Shape,
    shape2,
    productShape
);

module body Test is
    -- The columns of the left matrix, 3, are not the rows of the right, 4.
    function main(): ExitCode is
        let p: Shape := productShape(shape2(2, 3), shape2(4, 5));
        return ExitSuccess();
    end;
end module body.
