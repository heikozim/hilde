import Standard.Array (
    Array,
    View,
    zeros,
    destroy,
    int32Type,
    shape2,
    view,
    sliceAxis,
    viewSize
);

module body Test is
    generic [R: Region]
    function cut(a: &[Array, R]): Index is
        return viewSize(sliceAxis(view(a), 1, 1, 5, 1));
    end;

    -- Columns 1 to 4 of a matrix of 3 columns: the requires on stop fails.
    function main(): ExitCode is
        let a: Array := zeros(int32Type(), shape2(2, 3));
        let n: Index := cut(&a);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
