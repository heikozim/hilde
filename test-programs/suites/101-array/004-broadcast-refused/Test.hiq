import Standard.Array (
    Array,
    View,
    zeros,
    destroy,
    int32Type,
    shape1,
    shape2,
    view,
    broadcast,
    viewSize
);

module body Test is
    generic [R: Region]
    function stretch(a: &[Array, R]): Index is
        return viewSize(broadcast(view(a), shape2(2, 4)));
    end;

    -- A vector of 3 does not stretch to 2 by 4: the requires fails.
    function main(): ExitCode is
        let a: Array := zeros(int32Type(), shape1(3));
        let n: Index := stretch(&a);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
