import Standard.Array (
    Array,
    View,
    zeros,
    destroy,
    int64Type,
    shape1,
    view,
    getFloat64
);

module body Test is
    generic [R: Region]
    function read(a: &[Array, R]): Float64 is
        return getFloat64(view(a), 0);
    end;

    -- A Float64 is read from an array of Int64: the programme stops with
    -- the requires on the element type.
    function main(): ExitCode is
        let a: Array := zeros(int64Type(), shape1(2));
        let x: Float64 := read(&a);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
