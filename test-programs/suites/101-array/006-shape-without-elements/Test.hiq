import Standard.Array (
    Shape,
    shape2
);

module body Test is
    -- An extent of 0 is not allowed: the requires of shape2 fails.
    function main(): ExitCode is
        let s: Shape := shape2(3, 0);
        return ExitSuccess();
    end;
end module body.
