import Standard.Array (
    Array,
    zeros,
    destroy,
    float64Type,
    shape2,
    setFloat64
);

module body Test is
    -- Ordinal 6 of an array of 6 elements: the requires on the position fails.
    function main(): ExitCode is
        var a: Array := zeros(float64Type(), shape2(2, 3));
        setFloat64(&!a, 6, 1.0);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
