import Standard.Array (
    Shape,
    shape2
);

module body Test is
    -- Two extents that are allowed alone, 65536 each, make 2^32 elements.
    function main(): ExitCode is
        let s: Shape := shape2(65536, 65536);
        return ExitSuccess();
    end;
end module body.
