-- A lowered limit of open files refuses the descriptor above it, and the
-- limit raised again lets the process open as many as before.  The counts
-- depend on how many descriptors the process holds when it starts, so the
-- test prints what must hold rather than the counts.
import Standard.File (
    FileDescriptor,
    openRead,
    closeFile
);
import Standard.Resource (
    Resource,
    OpenFiles,
    Limit,
    readLimit,
    setLimit
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    -- Opens /dev/null, keeps it open while it opens the next, and returns
    -- how many opens succeeded before one was refused, at most most.
    function openUntilRefused(opened: Int32, most: Int32): Int32 is
        if opened >= most then
            return opened;
        end if;
        case openRead("/dev/null") of
            when Some(value as file: FileDescriptor) do
                let total: Int32 := openUntilRefused(opened + 1, most);
                let closed: Bool := closeFile(file);
                return total;
            when None do
                return opened;
        end case;
    end;

    function main(): ExitCode is
        case readLimit(OpenFiles()) of
            when Some(value as before: Limit) do
                let ten: Nat64 := 10;
                printLn(widen(before.soft > 64));
                printLn(widen(setLimit(OpenFiles(), Limit(soft => ten, hard => before.hard))));
                let low: Int32 := openUntilRefused(0, 50);
                printLn(widen(low > 0));
                printLn(widen(low < 10));
                printLn(widen(setLimit(OpenFiles(), before)));
                let high: Int32 := openUntilRefused(0, 50);
                printLn(widen(high = 50));
            when None do
                printLn(-1);
        end case;
        return ExitSuccess();
    end;
end module body.
