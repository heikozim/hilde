import Standard.Array (
    Array,
    zeros,
    destroy,
    int32Type,
    shape1,
    view
);
import Standard.ArrayCompute (
    sumAxis
);

module body Test is
    -- A vector has no axis 1: the programme stops with the requires on
    -- the axis.
    function main(): ExitCode is
        var a: Array := zeros(int32Type(), shape1(4));
        let sums: Array := sumAxis(view(&a), 1);
        destroy(sums);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
