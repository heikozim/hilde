import Standard.Array (
    Array,
    zeros,
    destroy,
    int32Type,
    shape1,
    shape2,
    view
);
import Standard.ArrayCompute (
    add
);

module body Test is
    -- A matrix of 2 by 3 and a vector of 4 do not broadcast: the
    -- programme stops with the requires on the broadcast.
    function main(): ExitCode is
        var a: Array := zeros(int32Type(), shape2(2, 3));
        var b: Array := zeros(int32Type(), shape1(4));
        let wide: Array := add(view(&a), view(&b));
        destroy(wide);
        destroy(b);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
