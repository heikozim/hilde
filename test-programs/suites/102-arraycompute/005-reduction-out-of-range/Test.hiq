import Standard.Array (
    Array,
    zeros,
    destroy,
    int32Type,
    shape1,
    view
);
import Standard.ArrayCompute (
    combine
);

module body Test is
    -- Code 0 names no reduction of the protocol: the programme stops
    -- with the requires on the code.
    function main(): ExitCode is
        var a: Array := zeros(int32Type(), shape1(2));
        var b: Array := zeros(int32Type(), shape1(2));
        case combine(view(&a), view(&b), 0) of
            when Some(value as joined: Array) do
                destroy(joined);
            when None do
                skip;
        end case;
        destroy(b);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
