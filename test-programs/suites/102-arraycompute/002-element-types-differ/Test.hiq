import Standard.Array (
    Array,
    zeros,
    destroy,
    int32Type,
    int64Type,
    shape2,
    view
);
import Standard.ArrayCompute (
    add
);

module body Test is
    -- An Int32 matrix and an Int64 matrix do not join: the programme
    -- stops with the requires on the element types.
    function main(): ExitCode is
        var a: Array := zeros(int32Type(), shape2(2, 3));
        var b: Array := zeros(int64Type(), shape2(2, 3));
        let wide: Array := add(view(&a), view(&b));
        destroy(wide);
        destroy(b);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
