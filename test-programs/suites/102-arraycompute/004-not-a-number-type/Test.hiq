import Standard.Array (
    Array,
    zeros,
    destroy,
    nat8Type,
    shape2,
    view
);
import Standard.ArrayCompute (
    add
);

module body Test is
    -- Nat8 names no type an operation works on: the programme stops with
    -- the requires on the number types.
    function main(): ExitCode is
        var a: Array := zeros(nat8Type(), shape2(2, 3));
        var b: Array := zeros(nat8Type(), shape2(2, 3));
        let wide: Array := add(view(&a), view(&b));
        destroy(wide);
        destroy(b);
        destroy(a);
        return ExitSuccess();
    end;
end module body.
