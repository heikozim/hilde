-- The programme watches SIGHUP, SIGTERM and SIGUSR1 and sends them to
-- itself.  A watched signal does not end it: the watch counts it, and
-- takeSignal answers once per arrival.  SIGTERM makes shutdownRequested
-- true once.  A second watch is refused while one is in place, and a
-- watch can be made again after stopWatching.
import Standard.Signal (
    SignalKind,
    Hangup,
    Terminate,
    User1,
    Wanted,
    Signals,
    watchSignals,
    takeSignal,
    waitSignal,
    shutdownRequested,
    stopWatching,
    sendSignal,
    processNumber
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function wanted(): Wanted is
        return Wanted(hangup => true, interrupt => false, terminate => true, user1 => true, user2 => false);
    end;

    -- Whether a second watch is refused while one is in place.
    function secondRefused(): Bool is
        case watchSignals(wanted()) of
            when Some(value as other: Signals) do
                let stopped: Bool := stopWatching(other);
                return false;
            when None do
                return true;
        end case;
    end;

    function main(): ExitCode is
        let me: Int32 := processNumber();
        let patience: Nat32 := 5000;
        let moment: Nat32 := 50;
        case watchSignals(wanted()) of
            when Some(value as made: Signals) do
                var signals: Signals := made;
                printLn(widen(takeSignal(&!signals, Hangup())));
                printLn(widen(sendSignal(me, Hangup())));
                printLn(widen(waitSignal(&!signals, patience)));
                printLn(widen(takeSignal(&!signals, Hangup())));
                printLn(widen(takeSignal(&!signals, Hangup())));
                printLn(widen(takeSignal(&!signals, User1())));
                printLn(widen(sendSignal(me, User1())));
                printLn(widen(waitSignal(&!signals, patience)));
                printLn(widen(takeSignal(&!signals, User1())));
                printLn(widen(sendSignal(me, Terminate())));
                printLn(widen(waitSignal(&!signals, patience)));
                printLn(widen(shutdownRequested(&!signals)));
                printLn(widen(shutdownRequested(&!signals)));
                printLn(widen(waitSignal(&!signals, moment)));
                printLn(widen(secondRefused()));
                printLn(widen(stopWatching(signals)));
            when None do
                printLn(-1);
        end case;
        case watchSignals(wanted()) of
            when Some(value as again: Signals) do
                printLn(1);
                printLn(widen(stopWatching(again)));
            when None do
                printLn(0);
        end case;
        printLn(widen(sendSignal(0, Hangup())));
        printLn(widen(sendSignal(-1, Hangup())));
        return ExitSuccess();
    end;
end module body.
