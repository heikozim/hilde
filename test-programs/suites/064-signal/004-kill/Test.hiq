-- sendSignal with Kill ends a child that sleeps: waitProcess sees it end
-- by signal 9, the kill signal.  A child that watches no signal could also be ended
-- by Terminate; Kill is the one that no process can catch or ignore.
import Standard.File (
    Running,
    Process,
    FileDescriptor,
    ProcessStatus,
    makeCommand,
    addArgument,
    spawnProcess,
    processId,
    waitProcess,
    endedBySignal,
    signalNumber,
    closeFile
);
import Standard.Signal (
    SignalKind,
    Kill,
    sendSignal
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function main(): ExitCode is
        case spawnProcess(addArgument(makeCommand("/bin/sleep"), "30")) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor, output: FileDescriptor, errors: FileDescriptor } := running;
                let sent: Bool := sendSignal(processId(&process), Kill());
                let status: ProcessStatus := waitProcess(process);
                let a: Bool := closeFile(input);
                let b: Bool := closeFile(output);
                let c: Bool := closeFile(errors);
                printLn(widen(sent));
                printLn(widen(endedBySignal(status)));
                printLn(signalNumber(status));
            when None do
                printLn("the child did not start");
        end case;
        return ExitSuccess();
    end;
end module body.
