-- A PID file written, read back as this process's number, removed, and
-- removed again without complaint.  Then files that are not a PID file:
-- each is refused, -1 here, and the valid ones read.
import Standard.String (
    String,
    destroyString,
    fromLiteral,
    asSpan
);
import Standard.File (
    FileDescriptor,
    openWrite,
    closeFile,
    writeAll,
    removeFile
);
import Standard.Signal (
    writePidFile,
    readPidFile,
    removePidFile,
    processNumber
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region]
    function numberIn(path: Span[Nat8, R]): Int32 is
        case readPidFile(path) of
            when Some(value as number: Int32) do
                return number;
            when None do
                return -1;
        end case;
    end;

    -- The number read from a file that holds text, or -1.
    function readBack(text: Span[Nat8, Static]): Int32 is
        let path: Span[Nat8, Static] := "hilde-064-002-other.tmp";
        case openWrite(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, text);
                let closed: Bool := closeFile(file);
            when None do
                return -2;
        end case;
        let number: Int32 := numberIn(path);
        let gone: Bool := removeFile(path);
        return number;
    end;

    function main(): ExitCode is
        let path: Span[Nat8, Static] := "hilde-064-002.pid";
        printLn(widen(removePidFile(path)));
        printLn(widen(writePidFile(path)));
        printLn(widen(numberIn(path) = processNumber()));
        printLn(widen(removePidFile(path)));
        printLn(widen(removePidFile(path)));
        printLn(numberIn(path));
        printLn(readBack("12a\n"));
        printLn(readBack("0\n"));
        printLn(readBack("2147483648\n"));
        printLn(readBack(""));
        printLn(readBack("42\n\n"));
        printLn(readBack("-5\n"));
        printLn(readBack("42"));
        printLn(readBack("2147483647\n"));
        return ExitSuccess();
    end;
end module body.
