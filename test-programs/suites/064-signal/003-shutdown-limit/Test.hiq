-- limitShutdown sets the alarm and says what was left of the one before:
-- nothing at first, then between 1 and 30 of a limit of 30 seconds, which
-- limitShutdown(0) takes back.  That the kernel ends the process when the
-- limit passes is not tested here.
import Standard.Signal (
    limitShutdown
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function main(): ExitCode is
        let thirty: Nat32 := 30;
        let none: Nat32 := 0;
        let first: Nat32 := limitShutdown(thirty);
        let left: Nat32 := limitShutdown(none);
        let after: Nat32 := limitShutdown(none);
        printLn(widen(first = none));
        printLn(widen((left >= 1) and (left <= thirty)));
        printLn(widen(after = none));
        return ExitSuccess();
    end;
end module body.
