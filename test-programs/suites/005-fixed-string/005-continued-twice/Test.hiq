module body Test is
    function main(): ExitCode is
        -- A string continued over two line ends: each backslash, the
        -- white space after it and the next backslash are taken out.
        let twice: Span[Nat8, Static] := "AB\
            \CD\
            \EF";
        -- An escape after a continuation is read as an escape: the line
        -- feed, which only the escape pass makes of backslash n.
        let escaped: Span[Nat8, Static] := "AB\
            \C\nD";
        printLn(twice);
        printLn(spanLength(twice));
        printLn(escaped);
        printLn(spanLength(escaped));
        return ExitSuccess();
    end;
end module body.
