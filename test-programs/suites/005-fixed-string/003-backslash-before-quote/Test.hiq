module body Test is
    function main(): ExitCode is
        -- Two backslashes before the closing quote are one escaped
        -- backslash, and the quote ends the string.
        let one: Span[Nat8, Static] := "\\";
        let three: Span[Nat8, Static] := "a\\\\";
        -- Three are an escaped backslash and an escaped quote.
        let two: Span[Nat8, Static] := "\\\"";
        -- A string that ends in a backslash, and a second on the same line.
        let left: Span[Nat8, Static] := "x\\"; let right: Span[Nat8, Static] := "y";
        printLn(one);
        printLn(spanLength(one));
        printLn(three);
        printLn(spanLength(three));
        printLn(two);
        printLn(spanLength(two));
        printLn(left);
        printLn(right);
        return ExitSuccess();
    end;
end module body.
