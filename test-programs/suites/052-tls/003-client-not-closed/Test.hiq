-- A connection is Linear: one that is never closed does not
-- compile.
import Standard.String (
    String,
    destroyString
);
import Standard.Tls (
    Client,
    connect
);

module body Test is
    function main(): ExitCode is
        case connect("localhost", "1", "ca.pem") of
            when Right(right as client: Client) do
                printLn("connected");
            when Left(left as message: String) do
                destroyString(message);
        end case;
        return ExitSuccess();
    end;
end module body.
