-- Hilde.Pervasive.spanPart: a part that reaches past the end of the span stops the programme.
module body Test is
    function main(): ExitCode is
        let text: Span[Nat8, Static] := "hello world";
        let part: Span[Nat8, Static] := spanPart(text, 6, 6);
        printLn(spanLength(part));
        return ExitSuccess();
    end;
end module body.
