-- Hilde.Pervasive.spanPart: parts of a span are the same elements, for bytes and for elements of eight bytes.
import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    wholeSpan,
    destroyFree
);

module body Test is
    function main(): ExitCode is
        let text: Span[Nat8, Static] := "hello world";
        print(spanPart(text, 6, 5));
        printLn("");
        print(spanPart(text, 0, 5));
        printLn("");
        printLn(spanLength(spanPart(text, 11, 0)));
        printLn(spanLength(spanPart(text, 0, 11)));
        printLn(spanLength(spanPart(text, 3, 0)));
        var numbers: Buffer[Int64] := allocateEmpty();
        var n: Int64 := 1;
        let last: Int64 := 5;
        while n <= last do
            insertBack(&!numbers, n * 100);
            n := n + 1;
        end while;
        borrow view: &[Buffer[Int64], R] := &numbers do
            let middle: Span[Int64, R] := spanPart(wholeSpan(view), 1, 3);
            printLn(spanLength(middle));
            printLn(middle[0]);
            printLn(middle[1]);
            printLn(middle[2]);
        end borrow;
        destroyFree(numbers);
        return ExitSuccess();
    end;
end module body.
