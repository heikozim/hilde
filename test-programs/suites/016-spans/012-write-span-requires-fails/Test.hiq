import Standard.Buffer (
    Buffer,
    initialize,
    getSpanMut,
    destroyFree
);

module body Test is
    generic [R: Region]
    function firstFour(target: Span![Nat8, R]): Unit is
        var sp: Span![Nat8, R] := target;
        let one: Nat8 := 1;
        sp[0] := one;
        sp[1] := one + 1;
        sp[2] := one + 2;
        sp[3] := one + 3;
        return nil;
    end;

    function main(): ExitCode is
        var buf: Buffer[Nat8] := initialize(3, 0);
        borrow b: &![Buffer[Nat8], R] := &!buf do
            let sp: Span![Nat8, R] := getSpanMut(b, 0, 2);
            firstFour(sp);
        end borrow;
        destroyFree(buf);
        return ExitSuccess();
    end;
end module body.
