module Test is
    """
    Sets every byte of target to value.
    No contract: every length of target is allowed.
    """
    generic [R: Region]
    function fillAll(target: Span![Nat8, R], value: Nat8): Unit;

    """
    Sets the first four bytes of target to 1, 2, 3 and 4.
    """
    generic [R: Region]
    function firstFour(target: Span![Nat8, R]): Unit
        requires spanWriteLength(&target) >= 4;

    """
    Runs the test.
    No contract: the entry point of the test programme.
    """
    function main(): ExitCode;
end module.
