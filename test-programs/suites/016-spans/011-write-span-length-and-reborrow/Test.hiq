import Standard.Buffer (
    Buffer,
    initialize,
    getSpanMut,
    nth,
    destroyFree
);

module body Test is
    generic [R: Region]
    function fillAll(target: Span![Nat8, R], value: Nat8): Unit is
        var sp: Span![Nat8, R] := target;
        var i: Index := 0;
        while i < spanWriteLength(&sp) do
            sp[i] := value;
            i := i + 1;
        end while;
        return nil;
    end;

    generic [R: Region]
    function firstFour(target: Span![Nat8, R]): Unit is
        var sp: Span![Nat8, R] := target;
        let one: Nat8 := 1;
        sp[0] := one;
        sp[1] := one + 1;
        sp[2] := one + 2;
        sp[3] := one + 3;
        return nil;
    end;

    function main(): ExitCode is
        var buf: Buffer[Nat8] := initialize(8, 0);
        borrow b: &![Buffer[Nat8], R] := &!buf do
            var sp: Span![Nat8, R] := getSpanMut(b, 0, 7);
            printLn(spanWriteLength(&sp));
            fillAll(&~sp, 9);
            let five: Nat8 := 5;
            sp[7] := five;
            firstFour(&~sp);
            printLn(spanWriteLength(&sp));
        end borrow;
        var i: Index := 0;
        while i < 8 do
            printLn(nth(&buf, i));
            i := i + 1;
        end while;
        destroyFree(buf);
        return ExitSuccess();
    end;
end module body.
