-- Unsafe: the test calls the runtime's check of a packed block and its
-- spawn directly through @embed, with blocks Standard.File would never
-- hand over, since it checks the same before the call.
pragma Unsafe_Module;

module body Test is
    function main(): ExitCode is
        let two: Int32 := @embed(Int32, "(int32_t) hilde_packed_holds((const uint8_t[]) { 97, 98, 0, 99, 0 }, 5, 2)");
        let three: Int32 := @embed(Int32, "(int32_t) hilde_packed_holds((const uint8_t[]) { 97, 98, 0, 99, 0 }, 5, 3)");
        let open: Int32 := @embed(Int32, "(int32_t) hilde_packed_holds((const uint8_t[]) { 97, 98 }, 2, 1)");
        let empty: Int32 := @embed(Int32, "(int32_t) hilde_packed_holds((const uint8_t*) \"\", 0, 0)");
        printLn(two = 1);
        printLn(three = 1);
        printLn(open = 1);
        printLn(empty = 1);
        let pid: Int32 := @embed(Int32, "__extension__ ({ int hilde_ends[3]; hilde_process_spawn((const uint8_t*) \"/bin/true\", (const uint8_t*) \"/bin/true\", 10, 2, hilde_ends); })");
        printLn(pid);
        return ExitSuccess();
    end;
end module body.
