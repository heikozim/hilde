import Standard.String (
    String,
    destroyString,
    makeString,
    asSpan
);
import Standard.File (
    FileDescriptor,
    closeFile,
    readAll,
    Command,
    makeCommand,
    addArgument,
    Process,
    Running,
    spawnProcess,
    waitProcess,
    ProcessStatus,
    exitedNormally,
    exitCode
);

module body Test is
    -- Twice the ten kibibytes the runtime once stopped at.
    constant argumentSize: Index := 20000;

    -- Run again with one argument: say how long it is.
    function child(): ExitCode is
        print("the child got an argument of ");
        print(spanLength(nthArgument(1)));
        printLn(" bytes");
        return ExitSuccess();
    end;

    -- Reads a pipe end to its end, prints what came, and closes it.
    function drain(file: FileDescriptor): Unit is
        var pipeEnd: FileDescriptor := file;
        case readAll(&!pipeEnd) of
            when Some(value as got: String) do
                print(asSpan(&got));
                destroyString(got);
            when None do
                printLn("a pipe could not be read");
        end case;
        closeFile(pipeEnd);
        return nil;
    end;

    -- Starts this programme again with one long argument, and prints its
    -- standard output, then its standard error, then how it ended.
    function main(): ExitCode is
        if argumentCount() > 1 then
            return child();
        end if;
        let long: String := makeString(argumentSize, 'x');
        let command: Command := addArgument(makeCommand(nthArgument(0)), asSpan(&long));
        destroyString(long);
        case spawnProcess(command) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor,
                    output: FileDescriptor, errors: FileDescriptor } := running;
                closeFile(input);
                drain(output);
                drain(errors);
                let status: ProcessStatus := waitProcess(process);
                if exitedNormally(status) then
                    print("the child exited with code ");
                    printLn(exitCode(status));
                else
                    printLn("the child did not exit normally");
                end if;
            when None do
                printLn("the child could not be started");
        end case;
        return ExitSuccess();
    end;
end module body.
