import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.File (
    environmentValue,
    environmentLimit,
    kindOf,
    kindRegular,
    sameKind
);

module body Test is
    -- The variable test-programs/runner.py sets for every programme:
    -- set, and it names the tree -- its hilde.opam is a file.
    function treeVariable(): Unit is
        let name: String := fromLiteral("HILDE_TREE");
        case environmentValue(asSpan(&name)) of
            when Some(value as tree: String) do
                printLn("HILDE_TREE: set");
                var out: StringBuilder := makeStringBuilder();
                writeString(&!out, asSpan(&tree));
                let tail: String := fromLiteral("/hilde.opam");
                writeString(&!out, asSpan(&tail));
                destroyString(tail);
                let path: String := finalize(out);
                print("its hilde.opam is a regular file: ");
                printLn(sameKind(kindOf(asSpan(&path)), kindRegular));
                destroyString(path);
                destroyString(tree);
            when None do
                printLn("HILDE_TREE: not set");
        end case;
        destroyString(name);
        return nil;
    end;

    -- A name nobody sets: None, not an empty string.
    function unsetVariable(): Unit is
        let name: String := fromLiteral("HILDE_NO_SUCH_VARIABLE_4711");
        case environmentValue(asSpan(&name)) of
            when Some(value as got: String) do
                print("HILDE_NO_SUCH_VARIABLE_4711: set, length ");
                printLn(length(&got));
                destroyString(got);
            when None do
                printLn("HILDE_NO_SUCH_VARIABLE_4711: not set");
        end case;
        destroyString(name);
        return nil;
    end;

    -- A name that is set to the empty string (the runner sets it):
    -- Some with length 0, not None -- set and empty is not unset.
    function emptyVariable(): Unit is
        let name: String := fromLiteral("HILDE_TEST_EMPTY");
        case environmentValue(asSpan(&name)) of
            when Some(value as got: String) do
                print("HILDE_TEST_EMPTY: set, length ");
                printLn(length(&got));
                destroyString(got);
            when None do
                printLn("HILDE_TEST_EMPTY: not set");
        end case;
        destroyString(name);
        return nil;
    end;

    function main(): ExitCode is
        treeVariable();
        unsetVariable();
        emptyVariable();
        print("the limit: ");
        printLn(environmentLimit);
        return ExitSuccess();
    end;
end module body.
