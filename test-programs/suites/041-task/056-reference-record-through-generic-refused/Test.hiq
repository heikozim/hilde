import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- The borrow is in a record's slot, and the record reaches spawn
    -- through a generic helper.
    record View[R: Region]: Free is
        text: &[String, R];
    end;

    generic [R: Region]
    function read(view: View[R]): Int32 is
        return 1;
    end;

    -- A generic helper: at its own definition T is a type variable and
    -- nothing can be said.  The check is made on the instantiated type, so
    -- the record arrives there and is refused all the same.
    generic [T: Free, R: Region]
    function startWith(scope: &![Scope, R], work: Fn[T, Int32], argument: T): Int32 is
        case spawn(scope, work, argument) of
            when Right(right as task: Task[Int32]) do
                return join(task);
            when Left(left as back: T) do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                borrow w: &[String, rho] := &word do
                    let work: Fn[View[rho], Int32] := read;
                    printLn(startWith(&!scope, work, View(text => w)));
                end borrow;
                closeScope(scope);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
