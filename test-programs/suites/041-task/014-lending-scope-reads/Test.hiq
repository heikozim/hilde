import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join,
    yieldNow
);

module body Test is
    generic [R: Region]
    function size(word: &[String, R]): Index is
        let n: Index := length(word);
        printLn(n);
        yieldNow();
        printLn(n + 1);
        return n;
    end;

    -- one string lent to two tasks at once: the scope
    -- is opened for the borrow, both tasks read the same String through
    -- it, and the scope is closed before the borrow ends.  The two tasks
    -- take turns at the yield -- 8 8 9 9 -- and nothing needs a lock.  The
    -- 100 after closeLending comes after all four: the close waits for
    -- every task of the scope, which is what keeps the lent string alive
    -- for as long as a task can read it.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        borrow w: &[String, rho] := &word do
            case openLending(w) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    let work: Fn[&[String, rho], Index] := size;
                    case spawnLending(&!scope, work, w) of
                        when Right(right as first: Task[Index]) do
                            case spawnLending(&!scope, work, w) of
                                when Right(right as second: Task[Index]) do
                                    closeLending(scope);
                                    printLn(100);
                                    printLn(join(first) + join(second));
                                when Left(left as back: &[String, rho]) do
                                    closeLending(scope);
                                    printLn(join(first));
                            end case;
                        when Left(left as back: &[String, rho]) do
                            closeLending(scope);
                            printLn(0);
                    end case;
                when None do
                    skip;
            end case;
        end borrow;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
