import Standard.Task (
    Sender,
    Receiver,
    Channel,
    openChannel,
    send,
    closeSender,
    closeReceiver,
    Polled,
    tryReceive
);

module body Test is
    -- Print what a poll found: the value, empty or closed.
    function report(found: Polled[Int32]): Unit is
        case found of
            when Ready(value as v: Int32) do
                print("ready ");
                printLn(v);
            when Empty do
                printLn("empty");
            when Closed do
                printLn("closed");
        end case;
        return nil;
    end;

    -- One value sent; true when it was delivered.
    generic [R: Region]
    function put(out: &![Sender[Int32], R], value: Int32): Bool is
        case send(out, value) of
            when Some(value as back: Int32) do
                return back < 0;
            when None do
                return true;
        end case;
    end;

    function main(): ExitCode is
        let made1: Option[Channel[Int32]] := openChannel(2);
        case made1 of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var out: Sender[Int32] := sender;
                var input: Receiver[Int32] := receiver;
                report(tryReceive(&!input));
                printLn(put(&!out, 7));
                report(tryReceive(&!input));
                report(tryReceive(&!input));
                printLn(put(&!out, 8));
                closeSender(out);
                report(tryReceive(&!input));
                report(tryReceive(&!input));
                closeReceiver(input);
            when None do
                printLn(-1);
        end case;
        -- Capacity 0: nothing waits to hand over a value, so empty; after
        -- the sender closes, closed.
        let made2: Option[Channel[Int32]] := openChannel(0);
        case made2 of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var input: Receiver[Int32] := receiver;
                report(tryReceive(&!input));
                closeSender(sender);
                report(tryReceive(&!input));
                closeReceiver(input);
            when None do
                printLn(-1);
        end case;
        return ExitSuccess();
    end;
end module body.
