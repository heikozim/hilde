import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    generic [R: Region]
    function size(word: &[String, R]): Index is
        return length(word);
    end;

    -- A reference of another borrow handed to a task of a lending scope.
    -- The scope is opened for the borrow of outer;
    -- the task is handed a reference of the borrow of inner, which ends
    -- before the scope is closed.  Refused at the call, H3066.
    function main(): ExitCode is
        let outer: String := fromLiteral("outer");
        let inner: String := fromLiteral("inner");
        borrow o: &[String, rho] := &outer do
            case openLending(o) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    borrow i: &[String, sigma] := &inner do
                        let work: Fn[&[String, sigma], Index] := size;
                        case spawnLending(&!scope, work, i) of
                            when Right(right as task: Task[Index]) do
                                printLn(join(task));
                            when Left(left as back: &[String, sigma]) do
                                printLn(0);
                        end case;
                    end borrow;
                    closeLending(scope);
                when None do
                    skip;
            end case;
        end borrow;
        destroyString(inner);
        destroyString(outer);
        return ExitSuccess();
    end;
end module body.
