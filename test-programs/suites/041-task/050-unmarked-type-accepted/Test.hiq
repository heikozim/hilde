import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- The same records as the refused tests, without the pragma: a task
    -- takes them, also nested and through a generic helper.
    record Handle: Free is
        number: Int32;
    end;

    record Outer: Free is
        handle: Handle;
        count: Int32;
    end;

    function read(outer: Outer): Int32 is
        return outer.handle.number + outer.count;
    end;

    generic [T: Free, R: Region]
    function startWith(scope: &![Scope, R], work: Fn[T, Int32], argument: T): Int32 is
        case spawn(scope, work, argument) of
            when Right(right as task: Task[Int32]) do
                return join(task);
            when Left(left as back: T) do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Outer, Int32] := read;
                printLn(startWith(&!scope, work, Outer(handle => Handle(number => 7), count => 1)));
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
