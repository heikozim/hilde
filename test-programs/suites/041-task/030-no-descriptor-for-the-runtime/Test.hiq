-- The task runtime sets itself up at its first use and needs a pipe for
-- that.  With every descriptor of the process in use, openScope answers
-- None instead of ending the programme; with descriptors free again, the
-- next openScope sets the runtime up and a task runs.  The limit of open
-- files is lowered first, so that filling the table takes few opens; how
-- many descriptors the process held at its start does not matter.
import Standard.File (
    FileDescriptor,
    openRead,
    closeFile
);
import Standard.Resource (
    Resource,
    OpenFiles,
    Limit,
    readLimit,
    setLimit
);
import Standard.Task (
    Scope,
    Task,
    openScope,
    closeScope,
    spawn,
    join
);

module body Test is
    -- Whether openScope gives a scope now.
    function scopeOpens(): Bool is
        case openScope() of
            when Some(value as scope: Scope) do
                closeScope(scope);
                return true;
            when None do
                return false;
        end case;
    end;

    -- Opens /dev/null until the system refuses one more, holds them all
    -- while it asks for a scope, then closes them.  most keeps the depth
    -- bounded where the limit could not be lowered.
    function scopeWithEveryDescriptorInUse(opened: Int32, most: Int32): Bool is
        if opened >= most then
            return scopeOpens();
        end if;
        case openRead("/dev/null") of
            when Some(value as file: FileDescriptor) do
                let answer: Bool := scopeWithEveryDescriptorInUse(opened + 1, most);
                let closed: Bool := closeFile(file);
                return answer;
            when None do
                return scopeOpens();
        end case;
    end;

    function double(n: Int64): Int64 is
        let two: Int64 := 2;
        return n * two;
    end;

    function main(): ExitCode is
        case readLimit(OpenFiles()) of
            when Some(value as before: Limit) do
                let low: Nat64 := 64;
                if not setLimit(OpenFiles(), Limit(soft => low, hard => before.hard)) then
                    printLn("the limit could not be lowered");
                end if;
                print("with every descriptor in use: ");
                if scopeWithEveryDescriptorInUse(0, 200) then
                    printLn("a scope");
                else
                    printLn("no scope");
                end if;
                if not setLimit(OpenFiles(), before) then
                    printLn("the limit could not be raised again");
                end if;
            when None do
                printLn("the limit could not be read");
        end case;
        print("with descriptors free again: ");
        case openScope() of
            when Some(value as scope: Scope) do
                var open: Scope := scope;
                let work: Fn[Int64, Int64] := double;
                let n: Int64 := 21;
                case spawn(&!open, work, n) of
                    when Right(right as task: Task[Int64]) do
                        print("a task gave ");
                        printLn(join(task));
                    when Left(left as back: Int64) do
                        printLn("no task");
                end case;
                closeScope(open);
            when None do
                printLn("no scope");
        end case;
        return ExitSuccess();
    end;
end module body.
