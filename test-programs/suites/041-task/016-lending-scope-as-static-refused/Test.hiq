import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Lending,
    openLending,
    closeLending
);

module body Test is
    -- The second way out of the borrow: a variable
    -- declared before the borrow with a region that does exist there,
    -- Static, and the borrow's scope assigned to it.  A region is not
    -- widened to another, so the assignment is refused.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        var kept: Option[Lending[Static]] := None();
        borrow w: &[String, rho] := &word do
            case kept of
                when Some(value as old: Lending[Static]) do
                    closeLending(old);
                when None do
                    skip;
            end case;
            kept := openLending(w);
        end borrow;
        case kept of
            when Some(value as scope: Lending[Static]) do
                closeLending(scope);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
