import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- The borrow is one level down, in a record's slot.
    record View[R: Region]: Free is
        text: &[String, R];
    end;

    generic [R: Region]
    function size(view: View[R]): Index is
        return length(view.text);
    end;

    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                borrow w: &[String, rho] := &word do
                    let work: Fn[View[rho], Index] := size;
                    case spawn(&!scope, work, View(text => w)) of
                        when Right(right as task: Task[Index]) do
                            printLn(join(task));
                        when Left(left as back: View[rho]) do
                            printLn(0);
                    end case;
                end borrow;
                closeScope(scope);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
