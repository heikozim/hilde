import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.File (
    FileDescriptor,
    closeFile,
    Command,
    makeCommand,
    Process,
    Running,
    spawnProcess,
    waitProcess,
    ProcessStatus,
    exitedNormally,
    exitCode
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    function other(unused: Unit): Unit is
        printLn("the task ran");
        return nil;
    end;

    -- Starts /usr/bin/true and waits for it; says how it ended.
    function runChild(unused: Unit): Bool is
        let path: String := fromLiteral("/usr/bin/true");
        let command: Command := makeCommand(asSpan(&path));
        destroyString(path);
        case spawnProcess(command) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor,
                    output: FileDescriptor, errors: FileDescriptor } := running;
                closeFile(input);
                closeFile(output);
                closeFile(errors);
                let status: ProcessStatus := waitProcess(process);
                return exitedNormally(status) and (exitCode(status) = 0);
            when None do
                return false;
        end case;
    end;

    -- The task is spawned and has not started when the child is forked;
    -- it starts afterwards, on a stack whose pages the fork shared.
    generic [R: Region]
    function both(scope: &![Scope, R]): Unit is
        let first: Fn[Unit, Unit] := other;
        case spawn(&~scope, first, nil) of
            when Right(right as waiting: Task[Unit]) do
                let ended: Bool := runChild(nil);
                join(waiting);
                if ended then
                    printLn("the child ended");
                else
                    printLn("the child ended otherwise");
                end if;
            when Left(left as unused: Unit) do
                printLn(-2);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                both(&!scope);
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
