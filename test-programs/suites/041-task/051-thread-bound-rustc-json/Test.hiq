import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Stands for a C object that keeps state of the thread that made it.
    pragma Thread_Bound;
    record Handle: Free is
        number: Int32;
    end;

    function read(handle: Handle): Int32 is
        return handle.number;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Handle, Int32] := read;
                case spawn(&!scope, work, Handle(number => 7)) of
                    when Right(right as task: Task[Int32]) do
                        printLn(join(task));
                    when Left(left as back: Handle) do
                        printLn(0);
                end case;
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
