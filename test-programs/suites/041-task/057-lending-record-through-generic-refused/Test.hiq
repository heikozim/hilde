import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Lending,
    openLending,
    closeLending,
    Task,
    spawn,
    join
);

module body Test is
    -- The lending scope is in a record's slot, and the record reaches
    -- spawn through a generic helper.
    record Holder[R: Region]: Linear is
        scope: Lending[R];
    end;

    generic [R: Region]
    function finish(holder: Holder[R]): Unit is
        let { scope: Lending[R] } := holder;
        closeLending(scope);
        return nil;
    end;

    -- A generic helper: at its own definition T is a type variable and
    -- nothing can be said.  The check is made on the instantiated type, so
    -- the record arrives there and is refused all the same.
    generic [T: Linear, R: Region]
    function startWith(scope: &![Scope, R], work: Fn[T, Unit], argument: T): Option[T] is
        case spawn(scope, work, argument) of
            when Right(right as task: Task[Unit]) do
                let done: Unit := join(task);
                return None();
            when Left(left as back: T) do
                return Some(value => back);
        end case;
    end;

    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        case openScope() of
            when Some(value as opened: Scope) do
                var plain: Scope := opened;
                borrow w: &[String, rho] := &word do
                    case openLending(w) of
                        when Some(value as lending: Lending[rho]) do
                            let work: Fn[Holder[rho], Unit] := finish;
                            case startWith(&!plain, work, Holder(scope => lending)) of
                                when Some(value as back: Holder[rho]) do
                                    finish(back);
                                when None do
                                    skip;
                            end case;
                        when None do
                            skip;
                    end case;
                end borrow;
                closeScope(plain);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
