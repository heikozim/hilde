import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Arena (
    Arena
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    join
);
import Standard.TaskArena (
    WithArena,
    spawnWithArena
);

module body Test is
    generic [R: Region]
    function work(input: WithArena[&[String, R]]): WithArena[Index] is
        let { value as word: &[String, R], arena: Arena } := input;
        return WithArena(value => length(word), arena => arena);
    end;

    -- must not compile: a reference handed to a task of spawnWithArena.
    -- The argument goes through Standard.Task.spawn inside it, so it is
    -- checked as spawn's is (H3002) -- a second way to start a task that
    -- skipped the check would be a way around it.
    function main(): ExitCode is
        let word: String := fromLiteral("lent");
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                borrow w: &[String, rho] := &word do
                    let page: ByteSize := 4096;
                    let run: Fn[WithArena[&[String, rho]], WithArena[Index]] := work;
                    case spawnWithArena(&!scope, run, w, page) of
                        when Right(right as task: Task[Index]) do
                            printLn(join(task));
                        when Left(left as back: &[String, rho]) do
                            printLn(0);
                    end case;
                end borrow;
                closeScope(scope);
            when None do
                printLn(-3);
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
