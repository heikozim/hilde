import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    function size(text: Span[Nat8, Static]): Index is
        return spanLength(text);
    end;

    -- A span of a string literal handed to a task.
    -- Its region is Static: it lives as long as the programme,
    -- so no task can outlive what it points at.  The check of the tasks
    -- refuses it all the same.
    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Span[Nat8, Static], Index] := size;
                case spawn(&!scope, work, "static") of
                    when Right(right as task: Task[Index]) do
                        printLn(join(task));
                    when Left(left as back: Span[Nat8, Static]) do
                        printLn(0);
                end case;
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
