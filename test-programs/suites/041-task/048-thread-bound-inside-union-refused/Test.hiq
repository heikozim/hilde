import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Stands for a C object that keeps state of the thread that made it.
    pragma Thread_Bound;
    record Handle: Free is
        number: Int32;
    end;

    -- Thread-bound through one of its cases, whichever case a value is.
    union Maybe: Free is
        case Held is
            handle: Handle;
        case Empty;
    end;

    function read(maybe: Maybe): Int32 is
        case maybe of
            when Held(handle: Handle) do
                return handle.number;
            when Empty do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Maybe, Int32] := read;
                case spawn(&!scope, work, Empty()) of
                    when Right(right as task: Task[Int32]) do
                        printLn(join(task));
                    when Left(left as back: Maybe) do
                        printLn(0);
                end case;
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
