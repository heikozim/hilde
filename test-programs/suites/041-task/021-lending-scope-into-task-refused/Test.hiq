import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Lending,
    openLending,
    closeLending,
    Task,
    spawn,
    join
);

module body Test is
    generic [R: Region]
    function finish(scope: Lending[R]): Unit is
        closeLending(scope);
        return nil;
    end;

    -- A lending scope handed to a task of a plain scope.
    -- It holds no reference, so the check of H3002 lets it
    -- pass; but the task could keep it open after the borrow ended -- the
    -- plain scope is closed after the borrow.  Refused, H3070, on the
    -- instantiated type.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        case openScope() of
            when Some(value as opened: Scope) do
                var plain: Scope := opened;
                borrow w: &[String, rho] := &word do
                    case openLending(w) of
                        when Some(value as lending: Lending[rho]) do
                            let work: Fn[Lending[rho], Unit] := finish;
                            case spawn(&!plain, work, lending) of
                                when Right(right as task: Task[Unit]) do
                                    let done: Unit := join(task);
                                when Left(left as back: Lending[rho]) do
                                    closeLending(back);
                            end case;
                        when None do
                            skip;
                    end case;
                end borrow;
                closeScope(plain);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
