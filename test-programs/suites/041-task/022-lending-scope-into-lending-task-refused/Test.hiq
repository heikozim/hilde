import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    generic [R: Region]
    function finish(scope: Lending[R]): Unit is
        closeLending(scope);
        return nil;
    end;

    -- A second lending scope handed to a task of the first.
    -- Refused at the call, H3069: a task that held a scope
    -- could keep it open, and the rule is kept simple -- a scope is closed
    -- where it was opened.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        borrow w: &[String, rho] := &word do
            case openLending(w) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    case openLending(w) of
                        when Some(value as other: Lending[rho]) do
                            let work: Fn[Lending[rho], Unit] := finish;
                            case spawnLending(&!scope, work, other) of
                                when Right(right as task: Task[Unit]) do
                                    let done: Unit := join(task);
                                when Left(left as back: Lending[rho]) do
                                    closeLending(back);
                            end case;
                        when None do
                            skip;
                    end case;
                    closeLending(scope);
                when None do
                    skip;
            end case;
        end borrow;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
