import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    Sender,
    Receiver,
    Channel,
    openChannel,
    receive,
    closeSender,
    closeReceiver
);

module body Test is
    -- Waits for a value that never comes: the sender is held by main, which
    -- never sends and never closes it before it joins this task.
    function wait(receiver: Receiver[Int32]): Int32 is
        var input: Receiver[Int32] := receiver;
        var got: Int32 := 0;
        case receive(&!input) of
            when Some(value as v: Int32) do
                got := v;
            when None do
                got := -1;
        end case;
        closeReceiver(input);
        return got;
    end;

    -- The deadlock of 004, on four workers (env.txt) and with a task: main
    -- joins a task that waits on a channel whose sender main holds.  Every
    -- fiber waits, three workers sleep and the fourth runs out of work,
    -- and the last one to go idle says so -- the message of one thread,
    -- unchanged.
    function main(): ExitCode is
        let made: Option[Channel[Int32]] := openChannel(1);
        case made of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                case openScope() of
                    when Some(value as opened: Scope) do
                        var scope: Scope := opened;
                        let work: Fn[Receiver[Int32], Int32] := wait;
                        case spawn(&!scope, work, receiver) of
                            when Right(right as task: Task[Int32]) do
                                printLn(join(task));
                            when Left(left as unused: Receiver[Int32]) do
                                closeReceiver(unused);
                        end case;
                        closeScope(scope);
                    when None do
                        closeReceiver(receiver);
                end case;
                closeSender(sender);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
