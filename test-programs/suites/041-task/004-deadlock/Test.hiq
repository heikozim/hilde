import Standard.Task (
    Sender,
    Receiver,
    Channel,
    openChannel,
    receive,
    closeSender,
    closeReceiver
);

module body Test is
    -- Main waits on a channel whose only sender it holds itself and never
    -- uses.  No other task exists and nothing waits for a descriptor, so
    -- nothing can ever wake main: the runtime says so and ends the
    -- programme, instead of hanging.
    function main(): ExitCode is
        let made: Option[Channel[Int32]] := openChannel(1);
        case made of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var input: Receiver[Int32] := receiver;
                case receive(&!input) of
                    when Some(value as got: Int32) do
                        printLn(got);
                    when None do
                        printLn(0);
                end case;
                closeReceiver(input);
                closeSender(sender);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
