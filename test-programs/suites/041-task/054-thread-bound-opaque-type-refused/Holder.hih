"""
A connection that stands for a C object bound to the thread that made it.
"""
module Holder is
    """
    A connection; it must stay on the thread that opened it.
    """
    pragma Thread_Bound;
    type Connection: Linear;

    """
    Opens a connection with the given number.
    """
    function openConnection(number: Int32): Connection
        requires number > 0;

    """
    Closes the connection and gives its number back.
    No contract: it only frees or closes what it is given.
    """
    function closeConnection(connection: Connection): Int32;
end module.
