import Holder (
    Connection,
    openConnection,
    closeConnection
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- The mark stands at the opaque type in the interface of another
    -- module; its record in that module's body carries none.
    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Connection, Int32] := closeConnection;
                case spawn(&!scope, work, openConnection(7)) of
                    when Right(right as task: Task[Int32]) do
                        printLn(join(task));
                    when Left(left as back: Connection) do
                        printLn(closeConnection(back));
                end case;
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
