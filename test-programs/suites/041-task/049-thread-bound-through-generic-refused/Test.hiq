import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Stands for a C object that keeps state of the thread that made it.
    pragma Thread_Bound;
    record Handle: Free is
        number: Int32;
    end;

    function read(handle: Handle): Int32 is
        return handle.number;
    end;

    -- A generic helper: at its own definition T is a type variable and
    -- nothing can be said.  The check is made on the instantiated type, so
    -- the marked type arrives there and is refused all the same.
    generic [T: Free, R: Region]
    function startWith(scope: &![Scope, R], work: Fn[T, Int32], argument: T): Int32 is
        case spawn(scope, work, argument) of
            when Right(right as task: Task[Int32]) do
                return join(task);
            when Left(left as back: T) do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Handle, Int32] := read;
                printLn(startWith(&!scope, work, Handle(number => 7)));
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
