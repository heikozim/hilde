import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn
);

module body Test is
    function twice(value: Int32): Int32 is
        return value * 2;
    end;

    -- The handle is never joined.  It is Linear, so this does not compile:
    -- a task that nobody waits for is refused by the type checker, not
    -- discovered at run time.
    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Int32, Int32] := twice;
                case spawn(&!scope, work, 21) of
                    when Right(right as task: Task[Int32]) do
                        skip;
                    when Left(left as unused: Int32) do
                        skip;
                end case;
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
