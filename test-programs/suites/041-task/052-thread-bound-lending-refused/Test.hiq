import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    -- Stands for a C object that keeps state of the thread that made it.
    pragma Thread_Bound;
    record Handle: Free is
        number: Int32;
    end;

    -- A task of a lending scope may read what the scope lends, but a read
    -- reference to a thread-bound value would let it use the value on
    -- another thread all the same.
    generic [R: Region]
    function read(handle: &[Handle, R]): Int32 is
        return handle->number;
    end;

    function main(): ExitCode is
        let handle: Handle := Handle(number => 7);
        borrow h: &[Handle, rho] := &handle do
            case openLending(h) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    let work: Fn[&[Handle, rho], Int32] := read;
                    case spawnLending(&!scope, work, h) of
                        when Right(right as task: Task[Int32]) do
                            closeLending(scope);
                            printLn(join(task));
                        when Left(left as back: &[Handle, rho]) do
                            closeLending(scope);
                            printLn(0);
                    end case;
                when None do
                    skip;
            end case;
        end borrow;
        return ExitSuccess();
    end;
end module body.
