import Standard.Task (
    Sender,
    Receiver,
    Channel,
    openChannel,
    send,
    closeSender,
    closeReceiver
);

module body Test is
    -- A value is sent and never received, and the receiving end is closed
    -- over it.  The value could be Linear, so losing it is refused: the
    -- programme ends with a message, and nothing after the close runs.
    function main(): ExitCode is
        let made: Option[Channel[Int32]] := openChannel(1);
        case made of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var out: Sender[Int32] := sender;
                case send(&!out, 5) of
                    when Some(value as back: Int32) do
                        printLn(-back);
                    when None do
                        skip;
                end case;
                closeSender(out);
                closeReceiver(receiver);
                printLn(1);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
