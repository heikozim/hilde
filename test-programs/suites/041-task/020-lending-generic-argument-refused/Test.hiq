import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    generic [R: Region]
    function size(word: &[String, R]): Index is
        return length(word);
    end;

    -- A generic helper that starts a task of a lending scope with an
    -- argument of a type variable's type.  What T
    -- stands for is not known where spawnLending is called, and by the
    -- time it is, the regions are gone.  Refused at the call, H3068 --
    -- even though this programme would hand it a reference of the right
    -- region.  T is Free, so that dropping the argument handed back is
    -- not a second reason to refuse.
    generic [T: Free, R: Region, S: Region]
    function start(scope: &![Lending[R], S], work: Fn[T, Index], argument: T): Index is
        case spawnLending(scope, work, argument) of
            when Right(right as task: Task[Index]) do
                return join(task);
            when Left(left as back: T) do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        borrow w: &[String, rho] := &word do
            case openLending(w) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    let work: Fn[&[String, rho], Index] := size;
                    printLn(start(&!scope, work, w));
                    closeLending(scope);
                when None do
                    skip;
            end case;
        end borrow;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
