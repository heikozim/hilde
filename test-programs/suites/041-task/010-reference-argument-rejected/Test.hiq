import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    generic [R: Region]
    function size(word: &[String, R]): Index is
        return length(word);
    end;

    -- A borrow handed to a task.  The task may run until the scope closes,
    -- and nothing ties the scope to the borrow's region -- so a task could
    -- read the string after it was destroyed.  Refused at the spawn.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                borrow w: &[String, rho] := &word do
                    let work: Fn[&[String, rho], Index] := size;
                    case spawn(&!scope, work, w) of
                        when Right(right as task: Task[Index]) do
                            printLn(join(task));
                        when Left(left as back: &[String, rho]) do
                            printLn(0);
                    end case;
                end borrow;
                closeScope(scope);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
