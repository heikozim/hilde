import Standard.String (
    String,
    makeString,
    destroyString,
    length
);
import Standard.Task (
    tasksAvailable,
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    yieldNow
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    -- Three steps, printing tag*10+step at each and yielding after it, so
    -- that two of these started together show whether they interleave.
    function worker(tag: Int32): Int32 is
        var sum: Int32 := 0;
        var step: Int32 := 1;
        while step <= 3 do
            let mark: Int32 := (tag * 10) + step;
            printLn(mark);
            sum := sum + mark;
            yieldNow();
            step := step + 1;
        end while;
        return sum;
    end;

    -- A task whose argument and result are Linear: a String goes in, a
    -- longer one comes out, and each is owned by exactly one side.
    function lengthen(word: String): String is
        let size: Index := length(&word);
        destroyString(word);
        return makeString(size * 2, 'b');
    end;

    function main(): ExitCode is
        printLn(widen(tasksAvailable()));
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Int32, Int32] := worker;
                let grow: Fn[String, String] := lengthen;
                -- Nothing runs at spawn: the two workers start when main
                -- first waits, in the order they were started, and then
                -- take turns at every yield -- 11 21 12 22 13 23.
                case spawn(&!scope, work, 1) of
                    when Right(right as first: Task[Int32]) do
                        case spawn(&!scope, work, 2) of
                            when Right(right as second: Task[Int32]) do
                                printLn(join(first));
                                printLn(join(second));
                            when Left(left as unused: Int32) do
                                printLn(join(first));
                                printLn(-1);
                        end case;
                    when Left(left as unused: Int32) do
                        printLn(-1);
                end case;
                -- The Linear round trip.
                case spawn(&!scope, grow, makeString(4, 'a')) of
                    when Right(right as growing: Task[String]) do
                        let grown: String := join(growing);
                        printLn(length(&grown));
                        destroyString(grown);
                    when Left(left as word: String) do
                        destroyString(word);
                        printLn(-1);
                end case;
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
