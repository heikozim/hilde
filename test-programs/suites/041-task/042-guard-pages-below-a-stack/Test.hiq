-- Unsafe: the test writes below the stack of a task through @embed.  That
-- is the point: the guard pages are what stands between a frame larger
-- than a page and the memory below the stack.
pragma Unsafe_Module;

import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Writes one byte into the fifteenth page above the lowest address of
    -- the task's mapping, which is a guard page when there are sixteen and
    -- a page of the stack when there is one.  The programme must end there.
    function below(value: Int32): Int32 is
        let said: Int32 := @embed(Int32, "(hilde_write_stderr((const char[]) { 98, 101, 108, 111, 119, 10 }, 6), (int32_t) 0)");
        let wrote: Int32 := @embed(Int32, "hilde_task_test_touch_guard()");
        return (value + wrote) + said;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Int32, Int32] := below;
                let seven: Int32 := 7;
                case spawn(&!scope, work, seven) of
                    when Right(right as t: Task[Int32]) do
                        printLn(join(t));
                    when Left(left as n: Int32) do
                        printLn(-2);
                end case;
                closeScope(scope);
            when None do
                printLn(-1);
        end case;
        return ExitSuccess();
    end;
end module body.
