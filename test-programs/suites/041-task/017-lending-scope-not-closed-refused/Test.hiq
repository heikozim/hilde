import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Lending,
    openLending,
    closeLending
);

module body Test is
    -- A lending scope left open at the end of its borrow:
    -- it is Linear, and the borrow is the end of the only place
    -- it can be, so it must be closed there.  Refused: the scope is not
    -- consumed.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        borrow w: &[String, rho] := &word do
            case openLending(w) of
                when Some(value as scope: Lending[rho]) do
                    skip;
                when None do
                    skip;
            end case;
        end borrow;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
