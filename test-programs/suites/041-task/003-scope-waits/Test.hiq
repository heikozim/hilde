import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    yieldNow
);

module body Test is
    -- Yield a few times, then print, so that the print can only happen if
    -- somebody lets this task run to its end.
    function slow(tag: Int32): Int32 is
        yieldNow();
        yieldNow();
        yieldNow();
        printLn(tag);
        return tag + 1;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Int32, Int32] := slow;
                case spawn(&!scope, work, 7) of
                    when Right(right as task: Task[Int32]) do
                        -- Nothing has run yet: tasks start when main waits.
                        printLn(1);
                        -- closeScope does not return until the task has
                        -- ended, so 7 is printed before 2 -- although the
                        -- handle has not been joined.
                        closeScope(scope);
                        printLn(2);
                        -- The handle outlives the scope and is joined after
                        -- it, and the result is still there.
                        printLn(join(task));
                    when Left(left as unused: Int32) do
                        closeScope(scope);
                        printLn(-1);
                end case;
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
