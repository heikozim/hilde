import Standard.String (
    String,
    makeString,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Lending,
    openLending,
    openLendingWithStack,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    -- Recurses depth calls deep.  Each call holds a String across the next
    -- one, so the compiler cannot turn the recursion into a loop.
    function deep(depth: Index): Index is
        if depth = 0 then
            return 0;
        end if;
        let held: String := makeString(1, 'a');
        let below: Index := deep(depth - 1);
        let size: Index := length(&held);
        destroyString(held);
        return below + size;
    end;

    -- Reads the lent word and recurses 3000 calls deep, about 200 KiB.
    generic [R: Region]
    function far(word: &[String, R]): Index is
        return deep(3000) + length(word);
    end;

    -- Reads the lent word and recurses 10 calls deep.
    generic [R: Region]
    function near(word: &[String, R]): Index is
        return deep(10) + length(word);
    end;

    -- A lending scope with 4 MiB of stack runs far, a plain one runs near,
    -- both over the same borrow.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        borrow w: &[String, rho] := &word do
            case openLendingWithStack(w, 4194304) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    let work: Fn[&[String, rho], Index] := far;
                    case spawnLending(&!scope, work, w) of
                        when Right(right as task: Task[Index]) do
                            closeLending(scope);
                            printLn(join(task));
                        when Left(left as back: &[String, rho]) do
                            closeLending(scope);
                            printLn(-1);
                    end case;
                when None do
                    printLn(-2);
            end case;
            case openLending(w) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    let work: Fn[&[String, rho], Index] := near;
                    case spawnLending(&!scope, work, w) of
                        when Right(right as task: Task[Index]) do
                            closeLending(scope);
                            printLn(join(task));
                        when Left(left as back: &[String, rho]) do
                            closeLending(scope);
                            printLn(-1);
                    end case;
                when None do
                    printLn(-2);
            end case;
        end borrow;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
