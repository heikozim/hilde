import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Lending,
    openLending,
    closeLending
);

module body Test is
    -- The region rule a lending scope rests on: a
    -- value whose type names a borrow's region cannot be kept outside the
    -- borrow.  Here the scope is to be carried out through a variable
    -- declared before the borrow -- whose type has to name the region
    -- where the region does not exist yet.  Refused.
    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        var kept: Option[Lending[rho]] := None();
        borrow w: &[String, rho] := &word do
            kept := openLending(w);
        end borrow;
        case kept of
            when Some(value as scope: Lending[rho]) do
                closeLending(scope);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
