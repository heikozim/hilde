import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.File (
    FileDescriptor,
    closeFile,
    Command,
    makeCommand,
    addArgument,
    Process,
    Running,
    spawnProcess,
    waitProcess,
    ProcessStatus,
    exitedNormally,
    exitCode
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    sleepFor
);

module body Test is
    -- Starts sleep 1 and waits for it to end.
    function waitForChild(unused: Unit): Unit is
        let path: String := fromLiteral("/bin/sleep");
        let second: String := fromLiteral("1");
        let command: Command := addArgument(makeCommand(asSpan(&path)), asSpan(&second));
        destroyString(path);
        destroyString(second);
        case spawnProcess(command) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor,
                    output: FileDescriptor, errors: FileDescriptor } := running;
                closeFile(input);
                closeFile(output);
                closeFile(errors);
                let status: ProcessStatus := waitProcess(process);
                if exitedNormally(status) and (exitCode(status) = 0) then
                    printLn("the child ended");
                else
                    printLn("the child ended otherwise");
                end if;
            when None do
                printLn("the child did not start");
        end case;
        return nil;
    end;

    -- Sleeps 200 ms, which needs a worker free to fire its timer.
    function other(unused: Unit): Unit is
        let pause: Nat32 := 200;
        sleepFor(pause);
        printLn("the other task ran");
        return nil;
    end;

    generic [R: Region]
    function both(scope: &![Scope, R]): Unit is
        let first: Fn[Unit, Unit] := waitForChild;
        let second: Fn[Unit, Unit] := other;
        case spawn(&~scope, first, nil) of
            when Right(right as waiting: Task[Unit]) do
                case spawn(&~scope, second, nil) of
                    when Right(right as running: Task[Unit]) do
                        join(waiting);
                        join(running);
                    when Left(left as unused: Unit) do
                        join(waiting);
                        printLn(-2);
                end case;
            when Left(left as unused: Unit) do
                printLn(-2);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                both(&!scope);
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
