-- Unsafe: the test reads the sleep marks of the workers and calls the
-- runtime's wake-up through the hooks the runtime keeps for it, under the
-- runtime's own idle lock.  That is the point of the test, not a pattern.
pragma Unsafe_Module;

import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Gives its argument back.  Run once, so that the workers start.
    function same(value: Int32): Int32 is
        return value;
    end;

    -- The number of workers 1 to 3 marked asleep, read under the idle lock.
    function sleepers(): Int32 is
        return @embed(Int32, "hilde_task_test_sleepers()");
    end;

    -- Waits until workers 1 to 3 are all asleep, for at most 50 million
    -- looks, and gives the last count.
    function awaitSleepers(): Int32 is
        var looks: Index := 0;
        var count: Int32 := sleepers();
        while (count /= 3) and (looks < 50000000) do
            looks := looks + 1;
            count := sleepers();
        end while;
        return count;
    end;

    -- Two wake-ups in a row under one hold of the idle lock, as two fibers
    -- made runnable one after the other, must reach two different sleepers.
    -- Gives the number still marked asleep after them.
    function wakeTwo(): Int32 is
        return @embed(Int32, "hilde_task_test_wake_two()");
    end;

    -- Four workers (env.txt).  Prints the answer of one task, then 3 when
    -- the three other workers sleep, 1 when two wake-ups woke two of them,
    -- and 3 again when the two, woken with nothing to do, sleep again and
    -- can be woken once more.
    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Int32, Int32] := same;
                let seven: Int32 := 7;
                case spawn(&!scope, work, seven) of
                    when Right(right as t: Task[Int32]) do
                        printLn(join(t));
                    when Left(left as unused: Int32) do
                        printLn(-1);
                end case;
                printLn(awaitSleepers());
                printLn(wakeTwo());
                printLn(awaitSleepers());
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
