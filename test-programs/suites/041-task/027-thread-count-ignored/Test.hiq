-- HILDE_TASK_THREADS=0 (env.txt) is not a number from 1 to 64.  The
-- runtime ignores it, says so in one line on standard error, and runs its
-- tasks on the processors the system reports.  The programme starts itself
-- again as a child, which inherits the variable, so that the child's
-- standard error can be printed and held against the expected output.
import Standard.String (
    String,
    destroyString,
    fromLiteral,
    asSpan
);
import Standard.File (
    FileDescriptor,
    closeFile,
    readAll,
    Command,
    makeCommand,
    addArgument,
    Process,
    Running,
    spawnProcess,
    waitProcess,
    ProcessStatus,
    exitedNormally,
    exitCode
);
import Standard.Task (
    Scope,
    Task,
    openScope,
    closeScope,
    spawn,
    join
);

module body Test is
    function double(n: Int64): Int64 is
        let two: Int64 := 2;
        return n * two;
    end;

    -- The child: one task in one scope.
    function child(): ExitCode is
        printLn("the child runs");
        case openScope() of
            when Some(value as scope: Scope) do
                var open: Scope := scope;
                let work: Fn[Int64, Int64] := double;
                let n: Int64 := 21;
                case spawn(&!open, work, n) of
                    when Right(right as task: Task[Int64]) do
                        print("a task gave ");
                        printLn(join(task));
                    when Left(left as back: Int64) do
                        printLn("no task");
                end case;
                closeScope(open);
            when None do
                printLn("no scope");
        end case;
        return ExitSuccess();
    end;

    -- Reads a pipe end to its end, prints what came, and closes it.
    function drain(file: FileDescriptor): Unit is
        var pipeEnd: FileDescriptor := file;
        case readAll(&!pipeEnd) of
            when Some(value as got: String) do
                print(asSpan(&got));
                destroyString(got);
            when None do
                printLn("a pipe could not be read");
        end case;
        closeFile(pipeEnd);
        return nil;
    end;

    function main(): ExitCode is
        if argumentCount() > 1 then
            return child();
        end if;
        let word: String := fromLiteral("child");
        let command: Command := addArgument(makeCommand(nthArgument(0)), asSpan(&word));
        destroyString(word);
        case spawnProcess(command) of
            when Some(value as running: Running) do
                let { process: Process, input: FileDescriptor,
                    output: FileDescriptor, errors: FileDescriptor } := running;
                closeFile(input);
                drain(output);
                drain(errors);
                let status: ProcessStatus := waitProcess(process);
                if exitedNormally(status) then
                    print("the child exited with code ");
                    printLn(exitCode(status));
                else
                    printLn("the child did not exit normally");
                end if;
            when None do
                printLn("the child could not be started");
        end case;
        return ExitSuccess();
    end;
end module body.
