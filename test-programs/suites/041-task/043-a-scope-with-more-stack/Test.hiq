import Standard.String (
    String,
    makeString,
    destroyString,
    length
);
import Standard.Task (
    Scope,
    openScope,
    openScopeWithStack,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Recurses depth calls deep.  Each call holds a String across the next
    -- one, so the compiler cannot turn the recursion into a loop.
    function deep(depth: Index): Index is
        if depth = 0 then
            return 0;
        end if;
        let held: String := makeString(1, 'a');
        let below: Index := deep(depth - 1);
        let size: Index := length(&held);
        destroyString(held);
        return below + size;
    end;

    -- Runs deep(depth) in a task of scope and prints what it returns.
    generic [R: Region]
    function runIn(scope: &![Scope, R], depth: Index): Unit is
        let work: Fn[Index, Index] := deep;
        case spawn(&~scope, work, depth) of
            when Right(right as task: Task[Index]) do
                printLn(join(task));
            when Left(left as unused: Index) do
                printLn(-1);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openScopeWithStack(4194304) of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                runIn(&!scope, 3000);
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                runIn(&!scope, 10);
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        return ExitSuccess();
    end;
end module body.
