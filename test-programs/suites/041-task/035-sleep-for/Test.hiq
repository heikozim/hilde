import Standard.Time (
    monotonicNanos
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    Sender,
    Receiver,
    Channel,
    openChannel,
    send,
    closeSender,
    closeReceiver,
    Selected,
    receiveEither,
    sleepFor
);

module body Test is
    function now(): Nat64 is
        case monotonicNanos() of
            when Some(value as t: Nat64) do
                return t;
            when None do
                return 0;
        end case;
    end;

    record Delayed: Linear is
        out: Sender[Int32];
        milliseconds: Nat32;
        value: Int32;
    end;

    -- Waits, then sends its value and closes.
    function wakeAndSend(job: Delayed): Unit is
        let { out: Sender[Int32], milliseconds: Nat32, value: Int32 } := job;
        var sender: Sender[Int32] := out;
        sleepFor(milliseconds);
        case send(&!sender, value) of
            when Some(value as back: Int32) do
                printLn(back);
            when None do
                skip;
        end case;
        closeSender(sender);
        return nil;
    end;

    generic [R: Region]
    function twoSleepers(scope: &![Scope, R]): Unit is
        let two: Index := 2;
        let made1: Option[Channel[Int32]] := openChannel(two);
        case made1 of
            when Some(value as slow_ends: Channel[Int32]) do
                let made2: Option[Channel[Int32]] := openChannel(two);
                case made2 of
                    when Some(value as fast_ends: Channel[Int32]) do
                        let { sender as slow_out: Sender[Int32], receiver as slow_in: Receiver[Int32] } := slow_ends;
                        let { sender as fast_out: Sender[Int32], receiver as fast_in: Receiver[Int32] } := fast_ends;
                        let work: Fn[Delayed, Unit] := wakeAndSend;
                        let slow_time: Nat32 := 400;
                        let fast_time: Nat32 := 20;
                        let slow_value: Int32 := 2;
                        let fast_value: Int32 := 1;
                        -- The slow one starts first and ends last.
                        case spawn(&~scope, work, Delayed(out => slow_out, milliseconds => slow_time, value => slow_value)) of
                            when Right(right as ts: Task[Unit]) do
                                case spawn(&~scope, work, Delayed(out => fast_out, milliseconds => fast_time, value => fast_value)) of
                                    when Right(right as tf: Task[Unit]) do
                                        var fast: Receiver[Int32] := fast_in;
                                        var slow: Receiver[Int32] := slow_in;
                                        -- Whichever sends first is taken first: the
                                        -- fast one, although it started second.
                                        var more: Bool := true;
                                        while more do
                                            case receiveEither(&!slow, &!fast) of
                                                when FromFirst(value as v: Int32) do
                                                    printLn(v);
                                                when FromSecond(value as v: Int32) do
                                                    printLn(v);
                                                when AllClosed do
                                                    more := false;
                                            end case;
                                        end while;
                                        join(tf);
                                        join(ts);
                                        closeReceiver(fast);
                                        closeReceiver(slow);
                                    when Left(left as unused: Delayed) do
                                        let { out as o: Sender[Int32], milliseconds as m: Nat32, value as v: Int32 } := unused;
                                        closeSender(o);
                                        join(ts);
                                        closeReceiver(fast_in);
                                        closeReceiver(slow_in);
                                        printLn(-2);
                                end case;
                            when Left(left as unused: Delayed) do
                                let { out as o: Sender[Int32], milliseconds as m: Nat32, value as v: Int32 } := unused;
                                closeSender(o);
                                closeSender(fast_out);
                                closeReceiver(fast_in);
                                closeReceiver(slow_in);
                                printLn(-2);
                        end case;
                    when None do
                        let { sender as s: Sender[Int32], receiver as r: Receiver[Int32] } := slow_ends;
                        closeSender(s);
                        closeReceiver(r);
                        printLn(-1);
                end case;
            when None do
                printLn(-1);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        -- main alone, before any task: it waits, and that is no deadlock.
        let fifty: Nat32 := 50;
        let millis: Nat64 := 1000000;
        let fifty_wide: Nat64 := 50;
        let before: Nat64 := now();
        sleepFor(fifty);
        let later: Nat64 := now();
        print("slept at least 50 ms: ");
        printLn((later - before) >= (fifty_wide * millis));
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                twoSleepers(&!scope);
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        -- main alone again, after the tasks.
        let ten: Nat32 := 10;
        sleepFor(ten);
        printLn("no deadlock");
        return ExitSuccess();
    end;
end module body.
