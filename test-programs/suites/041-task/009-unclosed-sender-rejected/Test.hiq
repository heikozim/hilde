import Standard.Task (
    Sender,
    Receiver,
    Channel,
    openChannel,
    closeReceiver
);

module body Test is
    -- The receiving end is closed and the sending end is simply dropped.
    -- Both ends are Linear, so this does not compile -- which is why the
    -- commonest channel deadlock, a receive whose sender was dropped without
    -- closing, cannot be written.
    function main(): ExitCode is
        let made: Option[Channel[Int32]] := openChannel(1);
        case made of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                closeReceiver(receiver);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
