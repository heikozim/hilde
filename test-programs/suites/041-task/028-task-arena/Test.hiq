import Standard.Arena (
    Arena,
    arenaSpan,
    arenaCapacity
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    join
);
import Standard.TaskArena (
    WithArena,
    spawnWithArena
);

module body Test is
    -- Write factor * i into the span for each of its n places, and give
    -- back the sum.  n is handed in: a writable span is Linear, and
    -- asking it its length would consume it.
    generic [R: Region]
    function fill(span: Span![Int32, R], factor: Int32, n: Index): Int32 is
        var sp: Span![Int32, R] := span;
        var k: Int32 := 0;
        for i from 0 to n - 1 do
            sp[i] := factor * k;
            k := k + 1;
        end for;
        var sum: Int32 := 0;
        for i from 0 to n - 1 do
            sum := sum + sp[i];
        end for;
        return sum;
    end;

    -- A task of spawnWithArena: it gets its argument and an arena, asks
    -- the arena -- explicitly, here and nowhere else -- for 100 Int32, and
    -- hands the arena back with its result.  Its result is 7 * 4950 =
    -- 34650, and 1 when the arena held at least the 4096 bytes asked for.
    function work(input: WithArena[Int32]): WithArena[Int32] is
        let { value as factor: Int32, arena: Arena } := input;
        var a: Arena := arena;
        var sum: Int32 := -1;
        borrow r: &![Arena, R] := &!a do
            let got: Option[Span![Int32, R]] := arenaSpan(r, 100);
            case got of
                when Some(value as sp: Span![Int32, R]) do
                    sum := fill(sp, factor, 100);
                when None do
                    sum := -2;
            end case;
        end borrow;
        var big: Int32 := 0;
        borrow c: &[Arena, R] := &a do
            if arenaCapacity(c) >= 4096 then
                big := 1;
            end if;
        end borrow;
        return WithArena(value => (sum * 10) + big, arena => a);
    end;

    -- Part C of 2026-09-25: a task is handed an arena of its own, which
    -- ends with it.  The first task gets 4096 bytes and prints 346501; the
    -- second asks for 0 bytes, no arena can be made, and its argument, 9,
    -- comes back in Left with nothing started.
    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let page: ByteSize := 4096;
                let nothing: ByteSize := 0;
                case spawnWithArena(&!scope, work, 7, page) of
                    when Right(right as task: Task[Int32]) do
                        printLn(join(task));
                    when Left(left as back: Int32) do
                        printLn(-back);
                end case;
                case spawnWithArena(&!scope, work, 9, nothing) of
                    when Right(right as task: Task[Int32]) do
                        printLn(-join(task));
                    when Left(left as back: Int32) do
                        printLn(back);
                end case;
                closeScope(scope);
            when None do
                printLn(-3);
        end case;
        return ExitSuccess();
    end;
end module body.
