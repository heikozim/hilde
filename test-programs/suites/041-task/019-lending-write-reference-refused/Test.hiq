import Standard.String (
    String,
    fromLiteral,
    destroyString
);
import Standard.Task (
    Lending,
    openLending,
    closeLending,
    Task,
    spawnLending,
    join
);

module body Test is
    generic [R: Region]
    function size(word: &![String, R]): Index is
        return 0;
    end;

    -- A write reference handed to a task of a lending scope.
    -- Tasks of a lending scope may only read what they are
    -- lent.  Refused at the call, H3067 -- before the region is looked at.
    function main(): ExitCode is
        let anchor: String := fromLiteral("anchor");
        var word: String := fromLiteral("written");
        borrow a: &[String, rho] := &anchor do
            case openLending(a) of
                when Some(value as opened: Lending[rho]) do
                    var scope: Lending[rho] := opened;
                    borrow w: &![String, sigma] := &!word do
                        let work: Fn[&![String, sigma], Index] := size;
                        case spawnLending(&!scope, work, w) of
                            when Right(right as task: Task[Index]) do
                                printLn(join(task));
                            when Left(left as back: &![String, sigma]) do
                                printLn(0);
                        end case;
                    end borrow;
                    closeLending(scope);
                when None do
                    skip;
            end case;
        end borrow;
        destroyString(word);
        destroyString(anchor);
        return ExitSuccess();
    end;
end module body.
