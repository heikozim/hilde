import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    -- Stands for a C object that keeps state of the thread that made it.
    pragma Thread_Bound;
    record Handle: Free is
        number: Int32;
    end;

    -- Not marked itself: it is thread-bound because a slot two levels
    -- down is.
    record Inner: Free is
        handle: Handle;
    end;

    record Outer: Free is
        inner: Inner;
        count: Int32;
    end;

    function read(outer: Outer): Int32 is
        return outer.count;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[Outer, Int32] := read;
                let outer: Outer := Outer(inner => Inner(handle => Handle(number => 7)), count => 1);
                case spawn(&!scope, work, outer) of
                    when Right(right as task: Task[Int32]) do
                        printLn(join(task));
                    when Left(left as back: Outer) do
                        printLn(0);
                end case;
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
