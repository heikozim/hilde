import Standard.Task (
    Sender,
    Receiver,
    Channel,
    openChannel,
    closeSender,
    closeReceiver
);

module body Test is
    -- Stands for a C object that keeps state of the thread that made it.
    pragma Thread_Bound;
    record Handle: Free is
        number: Int32;
    end;

    -- A channel carries its values to whichever task receives them, so a
    -- channel of a thread-bound type is refused where it is opened.
    function main(): ExitCode is
        let made: Option[Channel[Handle]] := openChannel(1);
        case made of
            when Some(value as ends: Channel[Handle]) do
                let { sender: Sender[Handle], receiver: Receiver[Handle] } := ends;
                closeSender(sender);
                closeReceiver(receiver);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
