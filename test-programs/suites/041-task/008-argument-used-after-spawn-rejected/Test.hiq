import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    function size(word: String): Index is
        let n: Index := length(&word);
        destroyString(word);
        return n;
    end;

    -- The String is moved into the task, and then used again.  The move is
    -- the linear type system's, unchanged: the second use does not compile.
    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                let work: Fn[String, Index] := size;
                let word: String := fromLiteral("moved");
                case spawn(&!scope, work, word) of
                    when Right(right as task: Task[Index]) do
                        printLn(join(task));
                    when Left(left as back: String) do
                        destroyString(back);
                end case;
                destroyString(word);
                closeScope(scope);
            when None do
                skip;
        end case;
        return ExitSuccess();
    end;
end module body.
