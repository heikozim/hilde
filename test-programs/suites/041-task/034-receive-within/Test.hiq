import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join,
    Sender,
    Receiver,
    Channel,
    openChannel,
    send,
    closeSender,
    closeReceiver,
    Polled,
    receiveWithin,
    sleepFor
);

module body Test is
    function report(found: Polled[Int32]): Unit is
        case found of
            when Ready(value as v: Int32) do
                print("ready ");
                printLn(v);
            when Empty do
                printLn("empty");
            when Closed do
                printLn("closed");
        end case;
        return nil;
    end;

    -- Waits a while, sends 7 and closes.
    function late(sender: Sender[Int32]): Unit is
        var out: Sender[Int32] := sender;
        let wait: Nat32 := 50;
        sleepFor(wait);
        let seven: Int32 := 7;
        case send(&!out, seven) of
            when Some(value as back: Int32) do
                printLn(back);
            when None do
                skip;
        end case;
        closeSender(out);
        return nil;
    end;

    generic [R: Region]
    function withTask(scope: &![Scope, R]): Unit is
        let one: Index := 1;
        let made1: Option[Channel[Int32]] := openChannel(one);
        case made1 of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var input: Receiver[Int32] := receiver;
                -- Nothing is sent and the sender is open: the time runs out.
                let short: Nat32 := 20;
                report(receiveWithin(&!input, short));
                let work: Fn[Sender[Int32], Unit] := late;
                case spawn(&~scope, work, sender) of
                    when Right(right as t: Task[Unit]) do
                        -- The value comes long before the limit.
                        let long: Nat32 := 20000;
                        report(receiveWithin(&!input, long));
                        report(receiveWithin(&!input, long));
                        join(t);
                    when Left(left as unused: Sender[Int32]) do
                        closeSender(unused);
                        printLn(-2);
                end case;
                closeReceiver(input);
            when None do
                printLn(-1);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                withTask(&!scope);
                closeScope(scope);
            when None do
                printLn(-2);
        end case;
        -- Capacity 0: no sender waits to hand over, so the time runs out.
        let none: Index := 0;
        let made2: Option[Channel[Int32]] := openChannel(none);
        case made2 of
            when Some(value as ends: Channel[Int32]) do
                let { sender: Sender[Int32], receiver: Receiver[Int32] } := ends;
                var input: Receiver[Int32] := receiver;
                let short: Nat32 := 10;
                report(receiveWithin(&!input, short));
                closeSender(sender);
                report(receiveWithin(&!input, short));
                closeReceiver(input);
            when None do
                printLn(-1);
        end case;
        return ExitSuccess();
    end;
end module body.
