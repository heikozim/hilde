import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length
);
import Standard.Task (
    Scope,
    openScope,
    closeScope,
    Task,
    spawn,
    join
);

module body Test is
    generic [R: Region]
    function size(word: &[String, R]): Index is
        return length(word);
    end;

    -- A generic helper: at its own definition A is a type variable and
    -- nothing can be said.  The check is made on the instantiated type, so
    -- the reference arrives there and is refused all the same.
    generic [T: Free, R: Region]
    function startWith(scope: &![Scope, R], work: Fn[T, Index], argument: T): Index is
        case spawn(scope, work, argument) of
            when Right(right as task: Task[Index]) do
                return join(task);
            when Left(left as back: T) do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        let word: String := fromLiteral("borrowed");
        case openScope() of
            when Some(value as opened: Scope) do
                var scope: Scope := opened;
                borrow w: &[String, rho] := &word do
                    let work: Fn[&[String, rho], Index] := size;
                    printLn(startWith(&!scope, work, w));
                end borrow;
                closeScope(scope);
            when None do
                skip;
        end case;
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
