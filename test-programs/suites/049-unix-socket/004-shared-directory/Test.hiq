-- Unsafe: the test makes a directory that everybody may write to, as /tmp
-- is, with mkdir and chmod through @embed, and removes it at the end.
pragma Unsafe_Module;

import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.File (
    FileDescriptor,
    FileStatus,
    FileFound,
    FileMissing,
    FileUnreadable,
    Listener,
    listenUnix,
    closeListener,
    openWrite,
    openRead,
    readAll,
    writeAll,
    closeFile,
    statusOf,
    removeFile
);

module body Test is
    function modeOf(path: Span[Nat8, Static]): Nat32 is
        case statusOf(path) of
            when FileFound(status: FileStatus) do
                return bitwiseAnd(status.mode, (511 : Nat32));
            when FileMissing do
                return 0;
            when FileUnreadable do
                return 0;
        end case;
    end;

    function main(): ExitCode is
        let made: Int32 := @embed(Int32, "(int32_t) (mkdir(\"shared\", 0700) == 0 && chmod(\"shared\", 01777) == 0)");
        print("shared directory: ");
        printLn(made);
        case listenUnix("shared/s.sock", #o600) of
            when Some(value as opened: Listener) do
                print("listening, mode ");
                printLn(modeOf("shared/s.sock"));
                print("closed: ");
                printLn(closeListener(opened));
            when None do
                printLn("listen: refused");
        end case;
        -- A file at the path is not replaced, though the socket comes to
        -- the path by a rename.
        case openWrite("shared/keep.txt") of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let wrote: Bool := writeAll(&!file, "keep me");
                let closed: Bool := closeFile(file);
            when None do
                printLn("write: failed");
        end case;
        case listenUnix("shared/keep.txt", #o600) of
            when Some(value as opened: Listener) do
                printLn("a file at the path: WRONGLY replaced");
                let closed: Bool := closeListener(opened);
            when None do
                printLn("a file at the path: refused");
        end case;
        case openRead("shared/keep.txt") of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                case readAll(&!file) of
                    when Some(value as text: String) do
                        print("the file holds: ");
                        printLn(asSpan(&text));
                        destroyString(text);
                    when None do
                        printLn("unreadable");
                end case;
                let closed: Bool := closeFile(file);
            when None do
                printLn("the file: missing");
        end case;
        print("removed: ");
        printLn(removeFile("shared/keep.txt"));
        -- Empty now, so nothing was left behind by the listen.
        let gone: Int32 := @embed(Int32, "(int32_t) (rmdir(\"shared\") == 0)");
        print("directory empty and removed: ");
        printLn(gone);
        return ExitSuccess();
    end;
end module body.
