import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.File (
    FileDescriptor,
    Listener,
    socketPathLimit,
    listenUnix,
    acceptConnection,
    connectUnix,
    closeListener,
    readExactly,
    writeAll,
    closeFile,
    kindOf,
    describeKind,
    removeFile
);

module body Test is
    generic [R: Region]
    function printText(text: &[String, R]): Unit is
        if length(text) > 0 then
            print(getSpan(text, 0, length(text) - 1));
        end if;
        return nil;
    end;

    generic [R: Region]
    function printKind(what: Span[Nat8, Static], path: &[String, R]): Unit is
        print(what);
        print(": ");
        let described: String := describeKind(kindOf(asSpan(path)));
        printText(&described);
        printLn("");
        destroyString(described);
        return nil;
    end;

    -- Read count bytes and print them after who.
    generic [R: Region]
    function readAndPrint(who: Span[Nat8, Static], file: &![FileDescriptor, R],
        count: Index): Unit is
        print(who);
        case readExactly(file, count) of
            when Some(value as got: String) do
                print(" read: ");
                printText(&got);
                printLn("");
                destroyString(got);
            when None do
                printLn(" read: nothing");
        end case;
        return nil;
    end;

    -- One exchange on a listening socket: connect, write before the server
    -- has accepted -- the kernel queues the connection and the bytes --
    -- accept, read, answer, read the answer.
    generic [R: Region, S: Region]
    function exchange(listener: &[Listener, R], path: &[String, S]): Unit is
        case connectUnix(asSpan(path)) of
            when Some(value as connected: FileDescriptor) do
                var client: FileDescriptor := connected;
                let request: String := fromLiteral("ping from the client");
                let reply: String := fromLiteral("pong from the server");
                print("client wrote: ");
                printLn(writeAll(&!client, asSpan(&request)));
                case acceptConnection(listener) of
                    when Some(value as accepted: FileDescriptor) do
                        var server: FileDescriptor := accepted;
                        readAndPrint("server", &!server, length(&request));
                        print("server wrote: ");
                        printLn(writeAll(&!server, asSpan(&reply)));
                        readAndPrint("client", &!client, length(&reply));
                        print("server closed: ");
                        printLn(closeFile(server));
                    when None do
                        printLn("accept: failed");
                end case;
                print("client closed: ");
                printLn(closeFile(client));
                destroyString(request);
                destroyString(reply);
            when None do
                printLn("connect: failed");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        let path: String := fromLiteral("hilde-049-001.sock");
        -- Left from an interrupted run, if anything; not part of the output.
        removeFile(asSpan(&path));
        print("path limit at least 100: ");
        printLn(socketPathLimit() >= 100);
        case listenUnix(asSpan(&path), #o600) of
            when Some(value as opened: Listener) do
                let listener: Listener := opened;
                printKind("the path while listening", &path);
                exchange(&listener, &path);
                -- A second exchange on the same listener: it is not used up.
                exchange(&listener, &path);
                -- A second listener on a socket somebody is listening on is
                -- refused: that socket is not stale.
                case listenUnix(asSpan(&path), #o600) of
                    when Some(value as second: Listener) do
                        printLn("second listener: WRONGLY accepted");
                        closeListener(second);
                    when None do
                        printLn("second listener on a live socket: refused");
                end case;
                print("listener closed: ");
                printLn(closeListener(listener));
            when None do
                printLn("listen: failed");
        end case;
        printKind("the path after closing", &path);
        case connectUnix(asSpan(&path)) of
            when Some(value as connected: FileDescriptor) do
                printLn("connect after close: WRONGLY connected");
                closeFile(connected);
            when None do
                printLn("connect after close: refused");
        end case;
        destroyString(path);
        return ExitSuccess();
    end;
end module body.
