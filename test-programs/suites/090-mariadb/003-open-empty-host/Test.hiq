-- openWriter requires a host: an empty one is the caller's fault, and the
-- contract stops the programme before anything is sent.
import Standard.MariaDB (
    Connection,
    Writing,
    MariaError,
    openWriter,
    closeDatabase
);

module body Test is
    function main(): ExitCode is
        printLn("before");
        case openWriter("", 3306, "hilde", "hilde", "secret", "ca.crt") of
            when Left(left as error: MariaError) do
                printLn("refused");
            when Right(right as db: Connection[Writing]) do
                closeDatabase(db);
        end case;
        printLn("after");
        return ExitSuccess();
    end;
end module body.
