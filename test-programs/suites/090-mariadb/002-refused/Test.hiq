-- A wrong password is refused, and so is a CA that did not sign the
-- server's certificate; the right password and CA then work, so each
-- refusal is its own and not a server that is not there.
import Standard.MariaDB (
    Connection,
    Writing,
    MariaError,
    describe,
    usesTls,
    closeDatabase
);
import MariaTest (
    openTest,
    openWithPassword,
    openWithOtherCa
);

module body Test is
    function main(): ExitCode is
        case openWithPassword("not-the-password") of
            when Left(left as error: MariaError) do
                print("wrong password: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                printLn("wrong password: CONNECTED");
                closeDatabase(db);
        end case;
        case openWithOtherCa() of
            when Left(left as error: MariaError) do
                print("other CA: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                printLn("other CA: CONNECTED");
                closeDatabase(db);
        end case;
        case openTest() of
            when Left(left as error: MariaError) do
                print("right password: ");
                printLn(describe(error));
            when Right(right as db: Connection[Writing]) do
                print("right password: connected, tls ");
                printLn(usesTls(&db));
                closeDatabase(db);
        end case;
        return ExitSuccess();
    end;
end module body.
