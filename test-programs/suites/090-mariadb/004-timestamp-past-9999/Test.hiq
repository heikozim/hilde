-- A timestamp of MariaDB holds the years 0 to 9999: withTimestamp requires
-- a value inside them, and the first microsecond of the year 10000 stops
-- the programme.  The last microsecond of 9999 is taken.
import Standard.MariaDB (
    Values,
    noValues,
    withTimestamp,
    valueCount,
    dropValues
);

module body Test is
    function main(): ExitCode is
        let last: Values := withTimestamp(noValues(), 253402300799999999);
        print("last microsecond of 9999: values ");
        printLn(valueCount(&last));
        dropValues(last);
        let past: Values := withTimestamp(noValues(), 253402300800000000);
        printLn("after");
        dropValues(past);
        return ExitSuccess();
    end;
end module body.
