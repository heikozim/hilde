-- directorySize over files whose sizes add up to more than a Nat64 holds:
-- a Left of kind Invalid, not a stop.  The files are sparse, 2^62 bytes
-- each with one byte written at the end, in /dev/shm, a tmpfs that holds
-- such files; one of them alone is summed first, which shows that the
-- files are what the test takes them to be.  Everything made is removed.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    writeByte,
    finalize
);
import Standard.Failure (
    Failure,
    Invalid,
    hasKind,
    destroyFailure
);
import Standard.File (
    FileDescriptor,
    openWrite,
    writeAll,
    closeFile,
    seekFile,
    seekFromStart,
    createDirectory,
    removeDirectory,
    removeFile
);
import Standard.FileHelpers (
    directorySize
);

module body Test is
    constant place: Span[Nat8, Static] := "/dev/shm/hilde-sizes-past-a-nat64";

    -- The path of file number n, one digit, inside place.
    function fileOf(n: Nat8): String is
        var out: StringBuilder := makeStringBuilder();
        let dir: String := fromLiteral(place);
        writeString(&!out, asSpan(&dir));
        destroyString(dir);
        let tail: String := fromLiteral("/f");
        writeString(&!out, asSpan(&tail));
        destroyString(tail);
        let digitZero: Nat8 := '0';
        writeByte(&!out, digitZero + n);
        return finalize(out);
    end;

    -- A sparse file of 2^62 bytes: its last byte written, nothing before.
    function makeSparse(n: Nat8): Bool is
        let path: String := fileOf(n);
        var made: Bool := false;
        case openWrite(asSpan(&path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let last: Int64 := 4611686018427387903;
                case seekFile(&!file, last, seekFromStart) of
                    when Some(value as at: Int64) do
                        made := writeAll(&!file, "x");
                    when None do
                        made := false;
                end case;
                let closed: Bool := closeFile(file);
                made := made and closed;
            when None do
                made := false;
        end case;
        destroyString(path);
        return made;
    end;

    function removeOne(n: Nat8): Bool is
        let path: String := fileOf(n);
        let removed: Bool := removeFile(asSpan(&path));
        destroyString(path);
        return removed;
    end;

    function report(label: Span[Nat8, Static]): Unit is
        print(label);
        case directorySize(place) of
            when Right(right as bytes: Nat64) do
                printLn(bytes);
            when Left(left as why: Failure) do
                if hasKind(&why, Invalid()) then
                    printLn("refused as invalid");
                else
                    printLn("refused otherwise");
                end if;
                destroyFailure(why);
        end case;
        return nil;
    end;

    function main(): ExitCode is
        if not createDirectory(place) then
            printLn("no directory under /dev/shm");
            return ExitSuccess();
        end if;
        let first: Nat8 := 0;
        let step: Nat8 := 1;
        let five: Nat8 := 5;
        if makeSparse(first) then
            report("one file of 2^62 bytes: ");
        else
            printLn("the first sparse file could not be made");
        end if;
        var n: Nat8 := step;
        var all: Bool := true;
        while n < five do
            all := all and makeSparse(n);
            n := n + step;
        end while;
        if all then
            report("five of them: ");
        else
            printLn("the other sparse files could not be made");
        end if;
        var removed: Bool := true;
        n := first;
        while n < five do
            removed := removed and removeOne(n);
            n := n + step;
        end while;
        removed := removed and removeDirectory(place);
        if removed then
            printLn("removed");
        else
            printLn("not everything could be removed");
        end if;
        return ExitSuccess();
    end;
end module body.
