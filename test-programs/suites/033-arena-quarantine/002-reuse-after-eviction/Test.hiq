-- Unsafe, because it reads an arena's address as a number, to see which
-- arena comes back.
pragma Unsafe_Module;

import Standard.Arena (
    Arena,
    createArena,
    arenaSpan,
    freeArena
);
import Hilde.Memory (
    Pointer,
    spanWriteToPointer,
    store,
    load
);

module body Test is
    -- An arena, the address of its first byte, and what that byte held
    -- when the arena was handed out.
    record Held: Linear is
        arena: Arena;
        at: Index;
        first: Nat8;
    end;

    function hold(): Held is
        let asked: ByteSize := 1;
        case createArena(asked) of
            when Some(value as made: Arena) do
                var arena: Arena := made;
                var at: Index := 0;
                var first: Nat8 := 255;
                borrow r: &![Arena, R] := &!arena do
                    let got: Option[Span![Nat8, R]] := arenaSpan(r, 16);
                    case got of
                        when Some(value as piece: Span![Nat8, R]) do
                            let p: Pointer[Nat8] := spanWriteToPointer(piece);
                            at := @embed(Index, "(size_t) $1", p);
                            first := load(p);
                            -- Written, so that the reuse below can show
                            -- that the byte was overwritten on the free.
                            let seven: Nat8 := 7;
                            store(p, seven);
                        when None do
                            abort("The arena was full.");
                    end case;
                end borrow;
                return Held(arena => arena, at => at, first => first);
            when None do
                abort("Arena creation failed.");
        end case;
    end;

    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    -- The quarantine holds a fixed number of
    -- freed arenas; when it is full, the oldest is opened again and handed
    -- to the next createArena of its size.  Prints the length (16), then 1
    -- when the arena made after length + 1 frees is the first one freed
    -- -- the same address -- and then the byte that arena holds: 0, not
    -- the 7 written before its free.
    function main(): ExitCode is
        let length: Index := @embed(Index, "hilde_arena_quarantine_length()");
        printLn(length);
        let held: Held := hold();
        let { arena as oldest: Arena, at as firstAt: Index, first as unused: Nat8 } := held;
        freeArena(oldest);
        for i from 1 to length do
            let more: Held := hold();
            let { arena as next: Arena, at as nextAt: Index, first as nextFirst: Nat8 } := more;
            freeArena(next);
        end for;
        let again: Held := hold();
        let { arena as back: Arena, at as backAt: Index, first as backFirst: Nat8 } := again;
        printLn(widen(backAt = firstAt));
        printLn(backFirst);
        freeArena(back);
        return ExitSuccess();
    end;
end module body.
