pragma Unsafe_Module;

module body Test is
    -- The answer of the wait for a descriptor where the task runtime is
    -- not there, given the events poll reported: 1 only for the event
    -- asked for, or a hang-up on a read; 0 for an error alone, an invalid
    -- descriptor, a hang-up on a write, a time out and a failed poll.
    function answer(rc: Int32, events: Span[Nat8, Static], what: Int32): Unit is
        print(events);
        print(" for ");
        if what = 1 then
            print("read");
        else
            print("write");
        end if;
        print(": ");
        printLn(@embed(Int32, "hilde_task_poll_answer($1, (short) ($2), $3)", rc, eventsOf(events), what));
        return nil;
    end;

    function eventsOf(name: Span[Nat8, Static]): Int32 is
        if name[0] = 'I' then
            return @embed(Int32, "POLLIN");
        end if;
        if name[0] = 'O' then
            return @embed(Int32, "POLLOUT");
        end if;
        if name[0] = 'H' then
            return @embed(Int32, "POLLHUP");
        end if;
        if name[0] = 'E' then
            if spanLength(name) > 3 then
                return @embed(Int32, "(POLLERR | POLLOUT)");
            end if;
            return @embed(Int32, "POLLERR");
        end if;
        if name[0] = 'N' then
            return @embed(Int32, "POLLNVAL");
        end if;
        return 0;
    end;

    function main(): ExitCode is
        answer(1, "IN", 1);
        answer(1, "OUT", 2);
        answer(1, "HUP", 1);
        answer(1, "ERR+OUT", 2);
        answer(1, "ERR", 1);
        answer(1, "ERR", 2);
        answer(1, "NVAL", 1);
        answer(1, "NVAL", 2);
        answer(1, "HUP", 2);
        answer(1, "IN", 2);
        answer(0, "-", 1);
        answer(-1, "-", 1);
        return ExitSuccess();
    end;
end module body.
