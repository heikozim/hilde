pragma Unsafe_Module;

module body Test is
    -- The fix the refusal of a Bool result names: the C result imported as
    -- Int32 and compared with /= 0.  wctob answers 65 for A and 0 for the
    -- null character.
    pragma Foreign_Import(External_Name => "wctob");
    function byteOf(character: Nat32): Int32 is
    end;

    function main(): ExitCode is
        let letter: Bool := byteOf(65) /= 0;
        let nothing: Bool := byteOf(0) /= 0;
        if letter = true then
            printLn("65 is true");
        else
            printLn("65 is not true");
        end if;
        if nothing = false then
            printLn("0 is false");
        else
            printLn("0 is not false");
        end if;
        return ExitSuccess();
    end;
end module body.
