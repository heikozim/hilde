pragma Unsafe_Module;

module body Test is
    -- A C function imported with a Bool result is refused: C gives a truth
    -- value as an int, and the one byte of a Bool would lose the rest.
    -- wctob answers 65 for A; isalpha of glibc answers 1024 for a letter,
    -- whose lowest byte is 0.
    pragma Foreign_Import(External_Name => "wctob");
    function byteOf(character: Nat32): Bool is
    end;

    function main(): ExitCode is
        let letter: Bool := byteOf(65);
        return ExitSuccess();
    end;
end module body.
