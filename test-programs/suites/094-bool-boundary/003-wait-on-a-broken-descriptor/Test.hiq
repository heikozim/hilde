pragma Unsafe_Module;

import Hilde.Memory (
    Address
);

module body Test is
    -- hilde_task_wait_fd answers 1 only for a descriptor ready for what was
    -- asked, or for a read end that has hung up.  poll reports a closed
    -- descriptor as invalid, an event of its own, and that must answer 0.
    -- A write end without a reader is left out: Linux reports it
    -- writable and in error at once, and the write then fails.
    function waitFor(number: Int32, what: Int32): Int32 is
        return @embed(Int32, "hilde_task_wait_fd($1, $2)", number, what);
    end;

    function show(name: Span[Nat8, Static], answer: Int32): Unit is
        print(name);
        print(": ");
        printLn(answer);
        return nil;
    end;

    function main(): ExitCode is
        let numbers: Address[Int32] := @embed(Address[Int32], "hilde_calloc(2, sizeof(int))");
        if @embed(Bool, "(($1) == NULL)", numbers) then
            printLn("no memory");
            return ExitFailure();
        end if;
        if @embed(Int32, "pipe((int*) ($1))", numbers) /= 0 then
            printLn("no pipe");
            @embed(Unit, "hilde_free($1)", numbers);
            return ExitFailure();
        end if;
        let reading: Int32 := @embed(Int32, "((int*) ($1))[0]", numbers);
        let writing: Int32 := @embed(Int32, "((int*) ($1))[1]", numbers);
        show("write end with a reader", waitFor(writing, 2));
        let wrote: Int64 := @embed(Int64, "(int64_t) write($1, \"x\", 1)", writing);
        show("read end with a byte", waitFor(reading, 1));
        let readerClosed: Int32 := @embed(Int32, "close($1)", reading);
        let writerClosed: Int32 := @embed(Int32, "close($1)", writing);
        show("closed descriptor, read", waitFor(writing, 1));
        show("closed descriptor, write", waitFor(writing, 2));
        if @embed(Int32, "pipe((int*) ($1))", numbers) /= 0 then
            printLn("no second pipe");
            @embed(Unit, "hilde_free($1)", numbers);
            return ExitFailure();
        end if;
        let second: Int32 := @embed(Int32, "((int*) ($1))[0]", numbers);
        let secondWriting: Int32 := @embed(Int32, "((int*) ($1))[1]", numbers);
        let hungUp: Int32 := @embed(Int32, "close($1)", secondWriting);
        show("read end hung up", waitFor(second, 1));
        let secondClosed: Int32 := @embed(Int32, "close($1)", second);
        @embed(Unit, "hilde_free($1)", numbers);
        return ExitSuccess();
    end;
end module body.
