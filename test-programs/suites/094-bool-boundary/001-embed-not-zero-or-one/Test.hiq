pragma Unsafe_Module;

module body Test is
    -- C text whose value is neither 0 nor 1 becomes a Bool.  Each must
    -- compare equal to true or false, never to a third value: 2 and -1 are
    -- true, 256 is true although its low byte is 0, and 0 is false.
    function report(name: Span[Nat8, Static], value: Bool): Unit is
        print(name);
        if value = true then
            printLn(" is true");
        else
            if value = false then
                printLn(" is false");
            else
                printLn(" is neither");
            end if;
        end if;
        return nil;
    end;

    function main(): ExitCode is
        let two: Bool := @embed(Bool, "2");
        let minus: Bool := @embed(Bool, "-1");
        let big: Bool := @embed(Bool, "256");
        let wide: Bool := @embed(Bool, "(int64_t)1 << 40");
        let zero: Bool := @embed(Bool, "0");
        report("2", two);
        report("-1", minus);
        report("256", big);
        report("2 to the 40", wide);
        report("0", zero);
        if two = minus then
            printLn("2 equals -1");
        else
            printLn("2 differs from -1");
        end if;
        return ExitSuccess();
    end;
end module body.
