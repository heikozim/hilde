-- page.jinja in English, in German and in French, which the catalog does
-- not have and which gives the default, for one item and for three.  The
-- user's name holds markup, which the escaping of the place takes.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);
import Standard.I18n (
    Catalog
);
import Messages (
    Key,
    Greeting,
    Items,
    Motto,
    messages
);

module body Test is
    record Page: Linear is
        lang: String;
        user: String;
        count: Int32;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function show(code: Span[Nat8, Static], number: Int32): Unit is
        let page: Page := Page(lang => fromLiteral(code), user => fromLiteral("<Ada>"), count => number);
        let text: String := render(&page);
        printLn(asSpan(&text));
        destroyString(text);
        let { lang: String, user: String, count: Int32 } := page;
        destroyString(lang);
        destroyString(user);
        return nil;
    end;

    function main(): ExitCode is
        show("en", 1);
        show("de", 3);
        show("fr", 3);
        return ExitSuccess();
    end;
end module body.
