-- The function a template's translation is turned into, called from code:
-- the same text as the template gives, for a key, a count and an argument.
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    finalize
);
import Standard.Template (
    Render
);
import Standard.I18n (
    Message,
    Plural,
    Language,
    Catalog,
    englishPlural,
    germanPlural,
    Arguments,
    makeArguments,
    addNumber,
    destroyArguments,
    translate
);

module body Test is
    union Key: Free is
        case Items;
    end;

    function english(key: Key): Message is
        case key of
            when Items do
                return Plural(one => "{count} item", other => "{count} items");
        end case;
    end;

    function german(key: Key): Message is
        case key of
            when Items do
                return Plural(one => "{count} Teil", other => "{count} Teile");
        end case;
    end;

    function others(i: Index): Option[Language[Key]] is
        if i = 0 then
            return Some(value => Language(code => "de", texts => german, plural => germanPlural));
        end if;
        return None();
    end;

    function messages(): Catalog[Key] is
        return Catalog(default => Language(code => "en", texts => english, plural => englishPlural), others => others);
    end;

    record Page: Linear is
        lang: String;
        count: Int64;
    end;

    generic [R: Region]
    function render(page: &[Page, R]): String is
        var out: StringBuilder := makeStringBuilder();
        @template("page.jinja", page, out);
        return finalize(out);
    end;

    function inCode(code: Span[Nat8, Static], count: Int64): String is
        var arguments: Arguments := makeArguments();
        addNumber(&!arguments, "count", count);
        let text: String := translate(messages(), code, Items(), Some(value => count), &arguments);
        destroyArguments(arguments);
        return text;
    end;

    function show(code: Span[Nat8, Static], number: Int64): Unit is
        let page: Page := Page(lang => fromLiteral(code), count => number);
        let fromTemplate: String := render(&page);
        let fromCode: String := inCode(code, number);
        printLn(asSpan(&fromTemplate));
        printLn(asSpan(&fromCode));
        destroyString(fromTemplate);
        destroyString(fromCode);
        let { lang: String, count: Int64 } := page;
        destroyString(lang);
        return nil;
    end;

    function main(): ExitCode is
        show("de", 1);
        show("en", 2);
        return ExitSuccess();
    end;
end module body.
