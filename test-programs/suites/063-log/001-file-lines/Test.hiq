-- A log file at the level Info: a Debug entry is dropped, an Info and an
-- Error entry are written as one line each.  Each line is printed from its
-- level on, after a 1 when the time before it has the form of RFC 3339 in
-- UTC with milliseconds.
import Standard.String (
    String,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    asSpan,
    getSpan
);
import Standard.File (
    FileDescriptor,
    openRead,
    closeFile,
    readAll,
    removeFile
);
import Standard.Log (
    Level,
    Debug,
    Info,
    Error,
    TextLines,
    Log,
    Entry,
    logToFile,
    logsLevel,
    closeLog,
    makeEntry,
    addInteger,
    addText,
    writeEntry,
    logLine
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region]
    function contentOf(path: Span[Nat8, R]): String is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let content: Option[String] := readAll(&!file);
                let closed: Bool := closeFile(file);
                case content of
                    when Some(value as text: String) do
                        return text;
                    when None do
                        return fromLiteral("");
                end case;
            when None do
                return fromLiteral("");
        end case;
    end;

    -- Whether the text from at has the form of the string form below, a
    -- time with milliseconds and a space: the fixed bytes where they
    -- belong, a digit wherever the form has a 0.
    generic [R: Region]
    function timeForm(text: &[String, R], at: Index): Bool is
        let form: Span[Nat8, Static] := "time=0000-00-00T00:00:00.000Z ";
        let size: Index := spanLength(form);
        if (at + size) > length(text) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            let want: Nat8 := form[i];
            let have: Nat8 := nthByte(text, at + i);
            if want = '0' then
                if (have < '0') or (have > '9') then
                    return false;
                end if;
            else
                if have /= want then
                    return false;
                end if;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    -- Prints, for each line of text, 1 or 0 for its time and then the rest.
    generic [R: Region]
    function printLines(text: &[String, R]): Int32 is
        let size: Index := length(text);
        var start: Index := 0;
        var lines: Int32 := 0;
        var i: Index := 0;
        while i < size do
            if nthByte(text, i) = '\n' then
                lines := lines + 1;
                printLn(widen(timeForm(text, start)));
                if (start + 30) < i then
                    printLn(getSpan(text, start + 30, i - 1));
                end if;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return lines;
    end;

    function main(): ExitCode is
        let path: Span[Nat8, Static] := "hilde-063-001.tmp";
        let gone: Bool := removeFile(path);
        case logToFile(path, Info(), TextLines()) of
            when Some(value as opened: Log) do
                var log: Log := opened;
                printLn(widen(logsLevel(&log, Debug())));
                printLn(widen(logsLevel(&log, Info())));
                printLn(widen(writeEntry(&!log, makeEntry(Debug(), "not written"))));
                printLn(widen(logLine(&!log, Info(), "first")));
                let five: Int64 := 5;
                let entry: Entry := addText(addInteger(makeEntry(Error(), "second one"), "n", five), "who", "anna");
                printLn(widen(writeEntry(&!log, entry)));
                printLn(widen(closeLog(log)));
            when None do
                printLn(-1);
        end case;
        let content: String := contentOf(path);
        printLn(printLines(&content));
        destroyString(content);
        printLn(widen(removeFile(path)));
        return ExitSuccess();
    end;
end module body.
