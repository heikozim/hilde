-- A log file in JSON lines: each line is printed from after its time on,
-- after a 1 when the time has the form of RFC 3339 in UTC with
-- milliseconds.  A quotation mark in a value is escaped.
import Standard.String (
    String,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    asSpan,
    getSpan
);
import Standard.File (
    FileDescriptor,
    openRead,
    closeFile,
    readAll,
    removeFile
);
import Standard.Log (
    Level,
    Info,
    Warning,
    JsonLines,
    Log,
    Entry,
    logToFile,
    closeLog,
    makeEntry,
    addText,
    addBool,
    writeEntry,
    logLine
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region]
    function contentOf(path: Span[Nat8, R]): String is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let content: Option[String] := readAll(&!file);
                let closed: Bool := closeFile(file);
                case content of
                    when Some(value as text: String) do
                        return text;
                    when None do
                        return fromLiteral("");
                end case;
            when None do
                return fromLiteral("");
        end case;
    end;

    generic [R: Region]
    function timeForm(text: &[String, R], at: Index): Bool is
        let form: Span[Nat8, Static] := "{\"time\":\"0000-00-00T00:00:00.000Z\"";
        let size: Index := spanLength(form);
        if (at + size) > length(text) then
            return false;
        end if;
        var i: Index := 0;
        while i < size do
            let want: Nat8 := form[i];
            let have: Nat8 := nthByte(text, at + i);
            if want = '0' then
                if (have < '0') or (have > '9') then
                    return false;
                end if;
            else
                if have /= want then
                    return false;
                end if;
            end if;
            i := i + 1;
        end while;
        return true;
    end;

    generic [R: Region]
    function printLines(text: &[String, R]): Int32 is
        let size: Index := length(text);
        var start: Index := 0;
        var lines: Int32 := 0;
        var i: Index := 0;
        while i < size do
            if nthByte(text, i) = '\n' then
                lines := lines + 1;
                printLn(widen(timeForm(text, start)));
                if (start + 34) < i then
                    printLn(getSpan(text, start + 34, i - 1));
                end if;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return lines;
    end;

    function main(): ExitCode is
        let path: Span[Nat8, Static] := "hilde-063-003.tmp";
        let before: Bool := removeFile(path);
        case logToFile(path, Info(), JsonLines()) of
            when Some(value as opened: Log) do
                var log: Log := opened;
                printLn(widen(logLine(&!log, Warning(), "w")));
                let entry: Entry := addText(addBool(makeEntry(Info(), "x y"), "ok", true), "k", "a\"b");
                printLn(widen(writeEntry(&!log, entry)));
                printLn(widen(closeLog(log)));
            when None do
                printLn(-1);
        end case;
        let content: String := contentOf(path);
        printLn(printLines(&content));
        destroyString(content);
        printLn(widen(removeFile(path)));
        return ExitSuccess();
    end;
end module body.
