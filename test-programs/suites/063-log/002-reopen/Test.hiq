-- A rotation renames the log file away; here it is removed, which leaves
-- the log's descriptor on a file without a name the same way.  reopenLog
-- opens the path again, and the next line lands in the new file only.
-- Then a reopen that cannot open its path, whose directory is gone: it
-- says false, and the log still writes, into the file it had.
import Standard.String (
    String,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    asSpan,
    getSpan
);
import Standard.File (
    FileDescriptor,
    openRead,
    closeFile,
    readAll,
    removeFile,
    createDirectory,
    removeDirectory
);
import Standard.Log (
    Level,
    Debug,
    Info,
    TextLines,
    Log,
    logToFile,
    closeLog,
    reopenLog,
    logLine
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region]
    function contentOf(path: Span[Nat8, R]): String is
        case openRead(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let content: Option[String] := readAll(&!file);
                let closed: Bool := closeFile(file);
                case content of
                    when Some(value as text: String) do
                        return text;
                    when None do
                        return fromLiteral("");
                end case;
            when None do
                return fromLiteral("");
        end case;
    end;

    -- Prints each line of text from its level on, and returns how many
    -- lines there were.
    generic [R: Region]
    function printLines(text: &[String, R]): Int32 is
        let size: Index := length(text);
        var start: Index := 0;
        var lines: Int32 := 0;
        var i: Index := 0;
        while i < size do
            if nthByte(text, i) = '\n' then
                lines := lines + 1;
                if (start + 30) < i then
                    printLn(getSpan(text, start + 30, i - 1));
                end if;
                start := i + 1;
            end if;
            i := i + 1;
        end while;
        return lines;
    end;

    function main(): ExitCode is
        let path: Span[Nat8, Static] := "hilde-063-002.tmp";
        let before: Bool := removeFile(path);
        case logToFile(path, Debug(), TextLines()) of
            when Some(value as opened: Log) do
                var log: Log := opened;
                printLn(widen(logLine(&!log, Info(), "one")));
                printLn(widen(removeFile(path)));
                printLn(widen(reopenLog(&!log)));
                printLn(widen(logLine(&!log, Info(), "two")));
                printLn(widen(closeLog(log)));
            when None do
                printLn(-1);
        end case;
        let content: String := contentOf(path);
        printLn(printLines(&content));
        destroyString(content);
        printLn(widen(removeFile(path)));

        let directory: Span[Nat8, Static] := "hilde-063-002.dir";
        let inside: Span[Nat8, Static] := "hilde-063-002.dir/x.log";
        printLn(widen(createDirectory(directory)));
        case logToFile(inside, Debug(), TextLines()) of
            when Some(value as opened: Log) do
                var log: Log := opened;
                printLn(widen(logLine(&!log, Info(), "three")));
                printLn(widen(removeFile(inside)));
                printLn(widen(removeDirectory(directory)));
                printLn(widen(reopenLog(&!log)));
                printLn(widen(logLine(&!log, Info(), "four")));
                printLn(widen(closeLog(log)));
            when None do
                printLn(-1);
        end case;
        return ExitSuccess();
    end;
end module body.
