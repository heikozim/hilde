-- Standard error through writeErrorText, a whole text in one call, after
-- bytes written one at a time with writeByte: they come first.  Then a log
-- to standard error whose level drops the entry, so that nothing with a
-- time in it reaches the expected output.  The programme ends with a
-- failure, the one shape the harness has for comparing standard error.
import Standard.IO (
    TerminalCapability,
    acquireTerminal,
    releaseTerminal,
    writeByte
);
import Standard.IO.Terminal (
    StandardError,
    acquireError,
    releaseError,
    writeErrorText
);
import Standard.Log (
    Level,
    Info,
    Error,
    TextLines,
    Log,
    logToError,
    logsLevel,
    closeLog,
    logLine
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    function main(root: RootCapability): ExitCode is
        var mutRoot: RootCapability := root;
        var terminal: TerminalCapability := acquireTerminal(&!mutRoot);
        var stderr: StandardError := acquireError(&!terminal);
        writeByte(&!stderr, 'a');
        writeByte(&!stderr, 'b');
        printLn(widen(writeErrorText(&!stderr, "c whole line\n")));
        printLn(widen(writeErrorText(&!stderr, "")));
        releaseError(stderr);
        var log: Log := logToError(acquireError(&!terminal), Error(), TextLines());
        printLn(widen(logsLevel(&log, Info())));
        printLn(widen(logLine(&!log, Info(), "dropped")));
        printLn(widen(closeLog(log)));
        releaseTerminal(terminal);
        surrenderRoot(mutRoot);
        return ExitFailure();
    end;
end module body.
