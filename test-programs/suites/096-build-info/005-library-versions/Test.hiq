import Standard.Buffer (
    Buffer,
    allocateEmpty,
    insertBack,
    length,
    removeLast,
    destroyEmpty
);
import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.Text (
    contains,
    startsWith
);
import Standard.About (
    fullVersionWith
);
import Standard.Libcrypto (
    libraryVersion as cryptoVersion
);
import Standard.Pcre (
    libraryVersion as pcreVersion
);
import Standard.Postgres (
    libraryVersion as pqVersion
);
import Standard.MariaDB (
    libraryVersion as mariaVersion
);
import Standard.DuckDB (
    libraryVersion as duckVersion
);
import Standard.Sqlite (
    libraryVersion as sqliteVersion
);

module body Test is
    -- name, a blank and version.
    generic [V: Region]
    function entry(name: Span[Nat8, Static], version: Span[Nat8, V]): String is
        var out: StringBuilder := makeStringBuilder();
        writeString(&!out, name);
        writeString(&!out, " ");
        writeString(&!out, version);
        return finalize(out);
    end;

    -- Says which check failed; true when it held.
    function held(good: Bool, what: Span[Nat8, Static]): Bool is
        if not good then
            print("failed: ");
            printLn(what);
        end if;
        return good;
    end;

    function main(): ExitCode is
        let pcre: String := pcreVersion();
        let pq: String := pqVersion();
        var good: Bool := true;
        good := held(spanLength(cryptoVersion()) > 0, "libcrypto answers") and good;
        good := held(startsWith(asSpan(&pcre), "10."), "PCRE2 is 10.x") and good;
        good := held(contains(asSpan(&pq), "."), "libpq is major.minor") and good;
        good := held(spanLength(mariaVersion()) > 0, "the MariaDB client answers") and good;
        good := held(spanLength(duckVersion()) > 0, "libduckdb answers") and good;
        good := held(startsWith(sqliteVersion(), "3."), "SQLite is 3.x") and good;
        var libraries: Buffer[String] := allocateEmpty();
        insertBack(&!libraries, entry("libcrypto", cryptoVersion()));
        insertBack(&!libraries, entry("pcre2", asSpan(&pcre)));
        let text: String := fullVersionWith("1.0.0", "2026 Example", &libraries);
        good := held(contains(asSpan(&text), "\nlibrary     libcrypto "), "the libcrypto line") and good;
        good := held(contains(asSpan(&text), "\nlibrary     pcre2 10."), "the PCRE2 line") and good;
        destroyString(text);
        while length(&libraries) > 0 do
            destroyString(removeLast(&!libraries));
        end while;
        destroyEmpty(libraries);
        destroyString(pcre);
        destroyString(pq);
        if good then
            printLn("ok");
            return ExitSuccess();
        end if;
        return ExitFailure();
    end;
end module body.
