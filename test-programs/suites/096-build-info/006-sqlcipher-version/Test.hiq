import Standard.Text (
    startsWith
);
import Standard.SqlCipher (
    libraryVersion
);

module body Test is
    function main(): ExitCode is
        if startsWith(libraryVersion(), "3.") then
            printLn("ok");
            return ExitSuccess();
        end if;
        print("failed: SQLCipher reports ");
        printLn(libraryVersion());
        return ExitFailure();
    end;
end module body.
