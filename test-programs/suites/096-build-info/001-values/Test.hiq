import Standard.BuildInfo (
    commit,
    dirty,
    builtAt,
    compilerVersion,
    valueCount,
    valueName,
    valueText,
    value
);

module body Test is
    function show(name: Span[Nat8, Static]): Unit is
        case value(name) of
            when Some(value as found: Span[Nat8, Static]) do
                print("[");
                print(found);
                printLn("]");
            when None do
                printLn("none");
        end case;
        return nil;
    end;

    function main(): ExitCode is
        printLn(spanLength(commit()));
        printLn(dirty());
        printLn(builtAt());
        printLn(spanLength(compilerVersion()) > 0);
        let total: Index := valueCount();
        printLn(total);
        var i: Index := 0;
        while i < total do
            print(valueName(i));
            print("=");
            printLn(valueText(i));
            i := i + 1;
        end while;
        show("channel");
        show("url");
        show("empty");
        show("missing");
        return ExitSuccess();
    end;
end module body.
