import Standard.Buffer (
    Buffer,
    allocateEmpty,
    length as bufferLength,
    insertBack
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Arguments (
    Command,
    FlagKey,
    TextKey,
    WholeKey,
    ArgumentError,
    Outcome,
    Run,
    Help,
    Version,
    Matches,
    makeCommand,
    destroyCommand,
    option,
    fromEnvironment,
    addFlag,
    addText,
    addWhole,
    destroyArguments,
    parse,
    destroyMatches,
    describeError,
    destroyError,
    flagCount,
    textOf,
    wholeOf
);

module body Test is
    record Keys: Free is
        name: TextKey;
        count: WholeKey;
        loud: FlagKey;
    end;

    generic [R: Region]
    function report(m: &[Matches, R], keys: Keys): Unit is
        case textOf(m, keys.name) of
            when Some(value as n: &[String, R]) do
                print("name: ");
                printLn(asSpan(n));
            when None do
                printLn("name: none");
        end case;
        case wholeOf(m, keys.count) of
            when Some(value as k: Int64) do
                print("count: ");
                printLn(k);
            when None do
                printLn("count: none");
        end case;
        print("loud: ");
        printLn(flagCount(m, keys.loud));
        return nil;
    end;

    generic [R: Region]
    function run(c: &[Command, R], keys: Keys, words: Buffer[String]): Unit is
        case parse(c, &words) of
            when Right(right as outcome: Outcome) do
                case outcome of
                    when Run(matches as m: Matches) do
                        report(&m, keys);
                        destroyMatches(m);
                    when Help(text as t: String) do
                        destroyString(t);
                    when Version(text as t: String) do
                        destroyString(t);
                end case;
            when Left(left as e: ArgumentError) do
                let message: String := describeError(c, &e);
                print(asSpan(&message));
                destroyString(message);
                destroyError(e);
        end case;
        destroyArguments(words);
        return nil;
    end;

    function main(): ExitCode is
        var c: Command := makeCommand("tool", "Reads its options from the environment too.");
        let name: TextKey := addText(&!c, fromEnvironment(option("name", 'n', "Who"), "TOOL_NAME"), "");
        let count: WholeKey := addWhole(&!c, fromEnvironment(option("count", 'q', "How often"), "TOOL_COUNT"), 1, 9, "1");
        let loud: FlagKey := addFlag(&!c, fromEnvironment(option("loud", 'l', "Shout"), "TOOL_LOUD"));
        let keys: Keys := Keys(name => name, count => count, loud => loud);
        printLn("nothing on the line:");
        let empty: Buffer[String] := allocateEmpty();
        run(&c, keys, empty);
        printLn("the line wins:");
        var line: Buffer[String] := allocateEmpty();
        insertBack(&!line, fromLiteral("--name=Bo"));
        insertBack(&!line, fromLiteral("-q2"));
        run(&c, keys, line);
        destroyCommand(c);
        return ExitSuccess();
    end;
end module body.
