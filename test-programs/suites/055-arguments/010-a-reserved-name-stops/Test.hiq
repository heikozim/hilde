import Standard.Arguments (
    Command,
    FlagKey,
    makeCommand,
    destroyCommand,
    option,
    addFlag
);

module body Test is
    -- verbose declared with option, though only addVerbose may: a
    -- mistake of the programme, found when it is declared.
    function main(): ExitCode is
        var c: Command := makeCommand("tool", "");
        printLn("declaring");
        let verbose: FlagKey := addFlag(&!c, option("verbose", 0, ""));
        printLn("declared");
        destroyCommand(c);
        return ExitSuccess();
    end;
end module body.
