import Standard.Buffer (
    Buffer,
    allocateEmpty
);
import Standard.String (
    String
);
import Standard.Arguments (
    Command,
    FlagKey,
    Matches,
    makeCommand,
    destroyCommand,
    option,
    addFlag,
    textOf,
    addVerbose
);

module body Test is
    -- A flag's key given where a text's key belongs.
    generic [R: Region]
    function ask(m: &[Matches, R], key: FlagKey): Bool is
        case textOf(m, key) of
            when Some(value as s: &[String, R]) do
                return true;
            when None do
                return false;
        end case;
    end;

    function main(): ExitCode is
        var c: Command := makeCommand("tool", "");
        let verbose: FlagKey := addVerbose(&!c, "");
        destroyCommand(c);
        return ExitSuccess();
    end;
end module body.
