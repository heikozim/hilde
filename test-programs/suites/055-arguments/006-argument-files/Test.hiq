import Standard.Buffer (
    Buffer,
    allocateEmpty,
    length as bufferLength,
    nthRef,
    insertBack
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.File (
    FileDescriptor,
    openWrite,
    writeAll,
    closeFile,
    removeFileIfThere
);
import Standard.Arguments (
    Command,
    FlagKey,
    TextKey,
    PositionalKey,
    ArgumentError,
    Outcome,
    Run,
    Help,
    Version,
    Matches,
    makeCommand,
    destroyCommand,
    option,
    repeatable,
    addFlag,
    addText,
    addPositional,
    destroyArguments,
    expandArgumentFiles,
    parse,
    destroyMatches,
    describeError,
    destroyError,
    flagCount,
    textOf,
    positionalCount,
    positionalAt,
    addVerbose
);

module body Test is
    record Keys: Free is
        verbose: FlagKey;
        output: TextKey;
        files: PositionalKey;
    end;

    -- The file at path holds text.
    function put(path: Span[Nat8, Static], text: Span[Nat8, Static]): Unit is
        case openWrite(path) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let wrote: Bool := writeAll(&!file, text);
                let closed: Bool := closeFile(file);
                if not (wrote and closed) then
                    printLn("a file could not be written");
                end if;
            when None do
                printLn("a file could not be made");
        end case;
        return nil;
    end;

    function line(first: Span[Nat8, Static], second: Span[Nat8, Static], third: Span[Nat8, Static]): Buffer[String] is
        var words: Buffer[String] := allocateEmpty();
        insertBack(&!words, fromLiteral(first));
        insertBack(&!words, fromLiteral(second));
        insertBack(&!words, fromLiteral(third));
        return words;
    end;

    generic [R: Region]
    function report(m: &[Matches, R], keys: Keys): Unit is
        print("verbose: ");
        printLn(flagCount(m, keys.verbose));
        case textOf(m, keys.output) of
            when Some(value as o: &[String, R]) do
                print("output: ");
                printLn(asSpan(o));
            when None do
                printLn("output: none");
        end case;
        let count: Index := positionalCount(m, keys.files);
        print("files: ");
        printLn(count);
        var i: Index := 0;
        while i < count do
            case positionalAt(m, keys.files, i) of
                when Some(value as f: &[String, R]) do
                    print("  ");
                    printLn(asSpan(f));
                when None do
                    skip;
            end case;
            i := i + 1;
        end while;
        return nil;
    end;

    -- The line expanded, each word in brackets, then parsed.
    generic [R: Region]
    function run(c: &[Command, R], keys: Keys, words: Buffer[String]): Unit is
        case expandArgumentFiles(&words) of
            when Left(left as e: ArgumentError) do
                let message: String := describeError(c, &e);
                print(asSpan(&message));
                destroyString(message);
                destroyError(e);
            when Right(right as expanded: Buffer[String]) do
                printLn("expanded:");
                var i: Index := 0;
                while i < bufferLength(&expanded) do
                    print("  [");
                    print(asSpan(nthRef(&expanded, i)));
                    printLn("]");
                    i := i + 1;
                end while;
                case parse(c, &expanded) of
                    when Right(right as outcome: Outcome) do
                        case outcome of
                            when Run(matches as m: Matches) do
                                report(&m, keys);
                                destroyMatches(m);
                            when Help(text as t: String) do
                                destroyString(t);
                            when Version(text as t: String) do
                                destroyString(t);
                        end case;
                    when Left(left as e: ArgumentError) do
                        let message: String := describeError(c, &e);
                        print(asSpan(&message));
                        destroyString(message);
                        destroyError(e);
                end case;
                destroyArguments(expanded);
        end case;
        destroyArguments(words);
        return nil;
    end;

    function main(): ExitCode is
        var c: Command := makeCommand("tool", "Reads some of its words from files.");
        let verbose: FlagKey := addVerbose(&!c, "More output");
        let output: TextKey := addText(&!c, option("output", 'o', "Where to write"), "");
        let files: PositionalKey := addPositional(&!c, "file", "What to read", false, true);
        let keys: Keys := Keys(verbose => verbose, output => output, files => files);
        put("argfile-main.txt", "-v --output \"my file.txt\"\n@argfile-more.txt 'b c.c'\n");
        put("argfile-more.txt", "a.c @@not-a-file.c\n");
        put("argfile-self.txt", "x\n@argfile-self.txt\n");
        put("argfile-open.txt", "x\n'never closed\n");
        printLn("a file that names a file, quotes and an escaped @:");
        run(&c, keys, line("-v", "@argfile-main.txt", "last.c"));
        printLn("after --, nothing is a file:");
        run(&c, keys, line("--", "@argfile-main.txt", "@@x"));
        printLn("a file that is not there:");
        run(&c, keys, line("a.c", "b.c", "@argfile-gone.txt"));
        printLn("a file that names itself:");
        run(&c, keys, line("-v", "@argfile-self.txt", "b.c"));
        printLn("a quote that is never closed:");
        run(&c, keys, line("-v", "@argfile-open.txt", "b.c"));
        destroyCommand(c);
        let gone1: Bool := removeFileIfThere("argfile-main.txt");
        let gone2: Bool := removeFileIfThere("argfile-more.txt");
        let gone3: Bool := removeFileIfThere("argfile-self.txt");
        let gone4: Bool := removeFileIfThere("argfile-open.txt");
        return ExitSuccess();
    end;
end module body.
