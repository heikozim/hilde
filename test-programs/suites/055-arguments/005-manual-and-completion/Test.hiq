import Standard.String (
    String,
    destroyString,
    asSpan
);
import Standard.Arguments (
    Command,
    FlagKey,
    TextKey,
    ChoiceKey,
    PathKey,
    SubcommandKey,
    Shell,
    Bash,
    Zsh,
    Fish,
    makeCommand,
    destroyCommand,
    setVersion,
    addAlias,
    option,
    global,
    fromEnvironment,
    valueName,
    addFlag,
    addText,
    addChoice,
    addPath,
    addPositionalPath,
    addSubcommand,
    manPage,
    completionScript
);

module body Test is
    function show(title: Span[Nat8, Static], text: String): Unit is
        print("=== ");
        printLn(title);
        print(asSpan(&text));
        destroyString(text);
        return nil;
    end;

    -- The texts written from one command: its manual page and the scripts
    -- that complete it in bash, zsh and fish.
    function main(): ExitCode is
        var root: Command := makeCommand("pack", "pack files into an archive");
        setVersion(&!root, "2.0");
        let quiet: FlagKey := addFlag(&!root, global(option("quiet", 'q', "Say nothing")));
        var create: Command := makeCommand("create", "Make a new archive.");
        let level: ChoiceKey := addChoice(&!create, option("level", 'l', "How hard to pack"), "fast|best", "fast");
        let output: PathKey := addPath(&!create, option("output", 'o', "Where to write"));
        let files: PathKey := addPositionalPath(&!create, "file", "What to pack", true, true);
        addAlias(&!create, "c");
        var list: Command := makeCommand("list", "Name what an archive holds.");
        let key: TextKey := addText(&!list, valueName(fromEnvironment(option("key", 'k', "The key of the archive"), "PACK_KEY"), "secret"), "");
        let archive: PathKey := addPositionalPath(&!list, "archive", "The archive", true, false);
        let createKey: SubcommandKey := addSubcommand(&!root, create);
        let listKey: SubcommandKey := addSubcommand(&!root, list);
        show("man", manPage(&root, "September 28, 2026"));
        show("bash", completionScript(&root, Bash()));
        show("zsh", completionScript(&root, Zsh()));
        show("fish", completionScript(&root, Fish()));
        destroyCommand(root);
        return ExitSuccess();
    end;
end module body.
