import Standard.Arguments (
    Command,
    FlagKey,
    makeCommand,
    destroyCommand,
    option,
    addFlag,
    addVerbose
);

module body Test is
    -- The key is verbose; the programme asks for verbos.
    function main(): ExitCode is
        var c: Command := makeCommand("tool", "");
        let verbose: FlagKey := addVerbose(&!c, "");
        let asked: FlagKey := verbos;
        destroyCommand(c);
        return ExitSuccess();
    end;
end module body.
