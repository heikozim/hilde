import Standard.Buffer (
    Buffer,
    allocateEmpty,
    length as bufferLength,
    insertBack
);
import Standard.String (
    String,
    fromLiteral,
    destroyString,
    asSpan
);
import Standard.Arguments (
    Command,
    FlagKey,
    PositionalKey,
    ArgumentError,
    Outcome,
    Run,
    Help,
    Version,
    Matches,
    makeCommand,
    destroyCommand,
    option,
    repeatable,
    addFlag,
    addPositional,
    processArguments,
    destroyArguments,
    parse,
    destroyMatches,
    destroyError,
    flagCount,
    positionalCount,
    addVerbose
);

module body Test is
    -- The process's own words, none when the runner starts it, parsed
    -- against a command with a flag and positional arguments.
    function main(): ExitCode is
        var c: Command := makeCommand("tool", "");
        let verbose: FlagKey := addVerbose(&!c, "");
        let files: PositionalKey := addPositional(&!c, "file", "", false, true);
        let words: Buffer[String] := processArguments();
        print("words: ");
        printLn(bufferLength(&words));
        case parse(&c, &words) of
            when Right(right as outcome: Outcome) do
                case outcome of
                    when Run(matches as m: Matches) do
                        print("verbose: ");
                        printLn(flagCount(&m, verbose));
                        print("files: ");
                        printLn(positionalCount(&m, files));
                        destroyMatches(m);
                    when Help(text as t: String) do
                        printLn("help");
                        destroyString(t);
                    when Version(text as t: String) do
                        printLn("version");
                        destroyString(t);
                end case;
            when Left(left as e: ArgumentError) do
                printLn("refused");
                destroyError(e);
        end case;
        destroyArguments(words);
        destroyCommand(c);
        return ExitSuccess();
    end;
end module body.
