import Standard.Arguments (
    Command,
    FlagKey,
    makeCommand,
    destroyCommand,
    option,
    addFlag
);

module body Test is
    -- Two options named loud: a mistake of the programme, not of its
    -- user, found when the command is declared, before any line is read.
    function main(): ExitCode is
        var c: Command := makeCommand("tool", "");
        printLn("declaring");
        let first: FlagKey := addFlag(&!c, option("loud", 'l', ""));
        let second: FlagKey := addFlag(&!c, option("loud", 'w', ""));
        printLn("declared");
        destroyCommand(c);
        return ExitSuccess();
    end;
end module body.
