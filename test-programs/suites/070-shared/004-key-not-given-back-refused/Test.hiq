import Standard.Shared (
    Mutex,
    Key,
    acquire
);

module body Test is
    -- The value is returned and the key from acquire is never given to
    -- release.  The key is linear, so the programme does not compile.
    generic [R: Region]
    function peek(mutex: &[Mutex[Int64], R]): Int64 is
        let { value as seen: Int64, key: Key } := acquire(mutex);
        return seen;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
