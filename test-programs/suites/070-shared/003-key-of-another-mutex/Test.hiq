import Standard.Shared (
    Mutex,
    Key,
    makeMutex,
    acquire,
    release,
    destroyMutex
);

module body Test is
    -- The key of the second mutex given back to the first: the programme
    -- stops, because the first would be let go while the second stays
    -- held and its value lost.
    generic [R: Region, S: Region]
    function crossed(first: &[Mutex[Int64], R], second: &[Mutex[Int64], S]): Unit is
        let { value as a: Int64, key as ka: Key } := acquire(first);
        let { value as b: Int64, key as kb: Key } := acquire(second);
        release(first, a, kb);
        release(second, b, ka);
        return nil;
    end;

    function main(): ExitCode is
        let one: Int64 := 1;
        let two: Int64 := 2;
        case makeMutex(one) of
            when Right(right as made: Mutex[Int64]) do
                let first: Mutex[Int64] := made;
                case makeMutex(two) of
                    when Right(right as other: Mutex[Int64]) do
                        let second: Mutex[Int64] := other;
                        borrow f: &[Mutex[Int64], rho] := &first do
                            borrow s: &[Mutex[Int64], sigma] := &second do
                                crossed(f, s);
                            end borrow;
                        end borrow;
                        printLn(destroyMutex(first));
                        printLn(destroyMutex(second));
                    when Left(left as back: Int64) do
                        printLn(back);
                        printLn(destroyMutex(first));
                end case;
            when Left(left as back: Int64) do
                printLn(back);
        end case;
        return ExitSuccess();
    end;
end module body.
