import Standard.Shared (
    Mutex,
    Key,
    makeMutex,
    acquire,
    release,
    destroyMutex
);

module body Test is
    -- Holds the mutex and asks for it again.  Nothing else could let it
    -- go, so the runtime says so and ends the programme, instead of
    -- hanging.
    generic [R: Region]
    function twice(mutex: &[Mutex[Int64], R]): Unit is
        let { value as first: Int64, key as outer: Key } := acquire(mutex);
        let { value as second: Int64, key as inner: Key } := acquire(mutex);
        release(mutex, second, inner);
        release(mutex, first, outer);
        return nil;
    end;

    function main(): ExitCode is
        let zero: Int64 := 0;
        case makeMutex(zero) of
            when Right(right as made: Mutex[Int64]) do
                let mutex: Mutex[Int64] := made;
                borrow m: &[Mutex[Int64], rho] := &mutex do
                    twice(m);
                end borrow;
                printLn(destroyMutex(mutex));
            when Left(left as back: Int64) do
                printLn(back);
        end case;
        return ExitSuccess();
    end;
end module body.
