import Standard.String (
    String,
    fromLiteral,
    destroyString,
    length,
    asSpan
);
import Standard.Text (
    equal
);

module body Test is
    -- Standard.String, Standard.Text and what they import come from the
    -- directories of --modules; the command line names this file alone.
    function main(): ExitCode is
        let word: String := fromLiteral("hilde");
        printLn(equal(asSpan(&word), "hilde"));
        printLn(equal(asSpan(&word), "hildE"));
        printLn(length(&word));
        destroyString(word);
        return ExitSuccess();
    end;
end module body.
