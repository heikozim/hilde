module body Test is
    record Ticket: Linear is
        number: Int32;
    end;

    record Holder: Linear is
        ticket: Ticket;
    end;

    -- An assignment through the name of a write borrow writes a Free value
    -- only: overwriting the linear ticket would lose it, so it is refused,
    -- as through a parameter.
    function main(): ExitCode is
        var h: Holder := Holder(ticket => Ticket(number => 1));
        borrow w: &![Holder, rho] := &!h do
            w->ticket := Ticket(number => 2);
        end borrow;
        let { ticket: Ticket } := h;
        let { number: Int32 } := ticket;
        return ExitSuccess();
    end;
end module body.
