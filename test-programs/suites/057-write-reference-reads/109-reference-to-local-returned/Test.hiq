module body Test is
    -- R is chosen by the caller and outlives the call.  A reference to the
    -- local variable x ends with the function and cannot be returned as R.
    generic [R: Region]
    function local(n: Int32): &[Int32, R] is
        let x: Int32 := n;
        return &x;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
