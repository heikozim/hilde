module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    generic [R: Region]
    function bump(c: &![Counter, R]): Unit is
        c->count := c->count + 1;
        return nil;
    end;

    -- The name of a read borrow is a read reference: lending it for
    -- writing is refused.
    function main(): ExitCode is
        var c: Counter := Counter(count => 1);
        borrow r: &[Counter, rho] := &c do
            bump(&!r);
        end borrow;
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
