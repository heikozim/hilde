import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyFree,
    getRef,
    put
);

module body Test is
    -- A reference into the map, found through a read borrow of the write
    -- reference, is still alive when the map is changed.  put could move
    -- the value the reference points at, so the change is refused.
    generic [R: Region]
    function show(map: &![Map[Int32, Int32], R], key: Int32): Unit is
        borrow m: &[Map[Int32, Int32], rho] := &map do
            case getRef(m, &key) of
                when Some(value as v: &[Int32, rho]) do
                    case put(&~map, key + 1, 0) of
                        when Some(value as old: Pair[Int32, Int32]) do
                            skip;
                        when None do
                            skip;
                    end case;
                    printLn(!v);
                when None do
                    skip;
            end case;
        end borrow;
        return nil;
    end;

    function main(): ExitCode is
        var map: Map[Int32, Int32] := makeMap();
        case put(&!map, 1, 10) of
            when Some(value as old: Pair[Int32, Int32]) do
                skip;
            when None do
                skip;
        end case;
        show(&!map, 1);
        destroyFree(map);
        return ExitSuccess();
    end;
end module body.
