module body Test is
    record Inner: Linear is
        value: Int32;
    end;

    record Two: Linear is
        first: Inner;
        second: Inner;
    end;

    generic [R: Region]
    function setValue(i: &![Inner, R], v: Int32): Unit is
        i->value := v;
        return nil;
    end;

    -- A reference to a part has the region of the write reference it is
    -- taken through, so it uses the write reference up.  The record cannot
    -- be written through p while that reference may still be read.
    generic [R: Region]
    function both(p: &![Two, R]): Unit is
        let a: &[Inner, R] := &(p->first);
        setValue(&!(p->second), 1);
        printLn(a->value);
        return nil;
    end;

    function main(): ExitCode is
        var t: Two := Two(first => Inner(value => 5), second => Inner(value => 0));
        both(&!t);
        let { first: Inner, second: Inner } := t;
        let { value as a: Int32 } := first;
        let { value as b: Int32 } := second;
        return ExitSuccess();
    end;
end module body.
