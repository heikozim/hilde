module body Test is
    record Point: Free is
        x: Int32;
        y: Int32;
    end;

    -- A write reference bound to a name with let or var: the declaration
    -- names the reference's own type, and the reference is moved into the
    -- name.  An assignment through the name writes the point.
    function main(): ExitCode is
        var p: Point := Point(x => 1, y => 2);
        borrow q: &![Point, R] := &!p do
            var r: &![Point, R] := q;
            r->x := 10;
            let s: &![Point, R] := r;
            s->y := 20;
        end borrow;
        printLn(p.x);
        printLn(p.y);
        return ExitSuccess();
    end;
end module body.
