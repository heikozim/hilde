module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    generic [R: Region]
    function bump(c: &![Counter, R]): Unit is
        c->count := c->count + 1;
        return nil;
    end;

    -- While the read reference r lives, the write reference c is borrowed
    -- and cannot be handed on to write.
    generic [R: Region]
    function show(c: &![Counter, R]): Unit is
        borrow r: &[Counter, rho] := &c do
            bump(&~c);
            printLn(r->count);
        end borrow;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 1);
        show(&!c);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
