-- A write reference stands where a read reference is asked: &~w hands it
-- to the reader and keeps it, so w writes again afterwards; passed itself
-- in the last use, it is used up as a write reference always is.
import Standard.Buffer (
    Buffer,
    initialize,
    length,
    nth,
    storeNth,
    destroyFree
);

module body Test is
    generic [R: Region]
    function firstOf(buf: &[Buffer[Int32], R]): Int32 is
        return nth(buf, 0);
    end;

    generic [R: Region]
    function bump(buf: &![Buffer[Int32], R]): Unit is
        let before: Int32 := firstOf(&~buf);
        storeNth(&~buf, 0, before + 1);
        printLn(length(&~buf));
        printLn(firstOf(buf));
        return nil;
    end;

    function main(): ExitCode is
        var b: Buffer[Int32] := initialize(3, 41);
        bump(&!b);
        printLn(nth(&b, 0));
        destroyFree(b);
        return ExitSuccess();
    end;
end module body.
