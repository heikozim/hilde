module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    -- r is a read reference made from the write reference c.  Assigning
    -- through r is refused, as through any read reference.
    generic [R: Region]
    function clear(c: &![Counter, R]): Unit is
        borrow r: &[Counter, rho] := &c do
            r->count := 0;
        end borrow;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 1);
        clear(&!c);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
