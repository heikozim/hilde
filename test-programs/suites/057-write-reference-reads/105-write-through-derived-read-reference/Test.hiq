module body Test is
    record Inner: Linear is
        value: Int32;
    end;

    record Two: Linear is
        first: Inner;
        second: Inner;
    end;

    generic [R: Region]
    function setValue(i: &![Inner, R], v: Int32): Unit is
        i->value := v;
        return nil;
    end;

    -- &(p->first) is a read reference, even though p is a write reference.
    -- Handing it to a function that writes is refused.
    generic [R: Region]
    function clear(p: &![Two, R]): Unit is
        setValue(&(p->first), 0);
        return nil;
    end;

    function main(): ExitCode is
        var t: Two := Two(first => Inner(value => 5), second => Inner(value => 0));
        clear(&!t);
        let { first: Inner, second: Inner } := t;
        let { value as a: Int32 } := first;
        let { value as b: Int32 } := second;
        return ExitSuccess();
    end;
end module body.
