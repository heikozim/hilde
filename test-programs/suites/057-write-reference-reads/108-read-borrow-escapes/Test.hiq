module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    -- &c reads through the write reference only for the statement it
    -- stands in.  It cannot be handed out with the region R of c: that
    -- would let the caller read while also writing through c.
    generic [R: Region]
    function view(c: &![Counter, R]): &[Counter, R] is
        return &c;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 1);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
