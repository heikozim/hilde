module body Test is
    record Counter: Linear is
        count: Int32;
        step: Int32;
    end;

    generic [R: Region]
    function current(c: &[Counter, R]): Int32 is
        return c->count;
    end;

    -- A function that holds the counter through a write reference reads it
    -- through a read borrow of that reference, twice in one expression,
    -- and then writes through the write reference again.
    generic [R: Region]
    function double(c: &![Counter, R]): Unit is
        let twice: Int32 := current(&c) + current(&c);
        c->count := twice;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 3, step => 1);
        double(&!c);
        printLn(current(&c));
        double(&!c);
        printLn(current(&c));
        let { count: Int32, step: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
