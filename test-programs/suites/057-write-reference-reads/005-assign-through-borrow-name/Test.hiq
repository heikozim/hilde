module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    -- The name of a borrow statement that borrows for writing is a write
    -- reference, and an assignment through it changes the value, as an
    -- assignment through a parameter that holds one does.
    generic [R: Region]
    function reset(c: &![Counter, R]): Unit is
        borrow r: &![Counter, rho] := &~c do
            r->count := 0;
        end borrow;
        c->count := c->count + 5;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 1);
        borrow w: &![Counter, rho] := &!c do
            w->count := w->count + 41;
            printLn(w->count);
        end borrow;
        printLn(c.count);
        reset(&!c);
        printLn(c.count);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
