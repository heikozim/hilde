module body Test is
    record Inner: Linear is
        value: Int32;
    end;

    record Two: Linear is
        first: Inner;
        second: Inner;
    end;

    -- A read reference and a write reference to a part of the value, both
    -- with the region of the write reference they are taken through.
    generic [R: Region]
    function firstRead(p: &![Two, R]): &[Inner, R] is
        return &(p->first);
    end;

    generic [R: Region]
    function secondWrite(p: &![Two, R]): &![Inner, R] is
        return &!(p->second);
    end;

    generic [R: Region]
    function valueOf(i: &[Inner, R]): Int32 is
        return i->value;
    end;

    generic [R: Region]
    function setValue(i: &![Inner, R], v: Int32): Unit is
        i->value := v;
        return nil;
    end;

    function main(): ExitCode is
        var t: Two := Two(first => Inner(value => 5), second => Inner(value => 0));
        let v: Int32 := valueOf(firstRead(&!t));
        setValue(secondWrite(&!t), v * 2);
        printLn(t.second.value);
        let { first: Inner, second: Inner } := t;
        let { value as a: Int32 } := first;
        let { value as b: Int32 } := second;
        printLn(a + b);
        return ExitSuccess();
    end;
end module body.
