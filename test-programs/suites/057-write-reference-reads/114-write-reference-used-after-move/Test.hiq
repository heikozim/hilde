module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    generic [R: Region]
    function bump(c: &![Counter, R]): Unit is
        c->count := c->count + 1;
        return nil;
    end;

    -- Binding a write reference to a new name moves it: the old name is
    -- used up, so the two cannot both write.
    generic [R: Region]
    function twice(c: &![Counter, R]): Unit is
        let d: &![Counter, R] := c;
        bump(d);
        bump(c);
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 0);
        twice(&!c);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
