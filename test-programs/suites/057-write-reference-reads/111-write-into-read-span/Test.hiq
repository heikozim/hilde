module body Test is
    record Holder[R: Region]: Linear is
        data: Span[Int32, R];
    end;

    -- data is a read span.  A write reference to the holder does not make
    -- its elements writable.
    generic [R: Region, S: Region]
    function firstMut(h: &![Holder[R], S]): &![Int32, R] is
        return &!(h->data[0]);
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
