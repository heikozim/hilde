module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    -- The borrow statement names the read reference, so it can be kept for
    -- the whole block; the write reference is borrowed for as long.
    generic [R: Region]
    function show(c: &![Counter, R]): Unit is
        borrow r: &[Counter, rho] := &c do
            let seen: &[Int32, rho] := &(r->count);
            printLn(!seen);
            printLn(r->count + 1);
        end borrow;
        c->count := 0;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 41);
        show(&!c);
        printLn(c.count);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
