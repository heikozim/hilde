module body Test is
    record Counter: Linear is
        count: Int32;
    end;

    generic [R: Region]
    function reset(c: &![Counter, R]): Unit is
        c->count := 0;
        return nil;
    end;

    -- The write reference c itself is handed on, which uses it up, while
    -- the read reference r made from it still lives.
    generic [R: Region]
    function show(c: &![Counter, R]): Unit is
        borrow r: &[Counter, rho] := &c do
            reset(c);
            printLn(r->count);
        end borrow;
        return nil;
    end;

    function main(): ExitCode is
        var c: Counter := Counter(count => 1);
        show(&!c);
        let { count: Int32 } := c;
        return ExitSuccess();
    end;
end module body.
