import Standard.Tuples (
    Pair
);
import Standard.Order (
    TotalOrder
);
import Standard.Map (
    Map,
    makeMap,
    destroyFree,
    size,
    get,
    put
);

module body Test is
    -- Count one more under key.  The map is held through a write
    -- reference; size and get take a read reference and are handed &map,
    -- a read borrow of the write reference; put writes through &~map.
    generic [R: Region]
    function bump(map: &![Map[Int32, Int32], R], key: Int32): Unit is
        let before: Index := size(&map);
        var count: Int32 := 0;
        case get(&map, &key) of
            when Some(value as v: Int32) do
                count := v;
            when None do
                skip;
        end case;
        case put(&~map, key, count + 1) of
            when Some(value as old: Pair[Int32, Int32]) do
                skip;
            when None do
                skip;
        end case;
        printLn(size(&map) - before);
        return nil;
    end;

    function main(): ExitCode is
        var map: Map[Int32, Int32] := makeMap();
        bump(&!map, 7);
        bump(&!map, 7);
        bump(&!map, 3);
        let seven: Int32 := 7;
        case get(&map, &seven) of
            when Some(value as v: Int32) do
                printLn(v);
            when None do
                printLn(seven);
        end case;
        destroyFree(map);
        return ExitSuccess();
    end;
end module body.
