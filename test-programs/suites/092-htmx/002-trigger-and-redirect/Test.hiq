-- Standard.Htmx: the answers of a handler that saved something and tells
-- htmx to fire item-saved, and of one that sends htmx to another page
-- with HX-Redirect; both lines together in one answer; and the event
-- names a caller can test before it builds HX-Trigger.  The carriage
-- returns of the answers are printed as nothing.
import Standard.String (
    String,
    destroyString,
    length,
    getSpan,
    asSpan
);
import Standard.StringBuilder (
    StringBuilder,
    makeStringBuilder,
    writeString,
    finalize
);
import Standard.Text (
    replace
);
import Standard.Htmx (
    isEventName,
    redirectHeader,
    triggerHeader,
    htmlResponse
);

module body Test is
    generic [R: Region]
    function show(label: Span[Nat8, Static], answer: &[String, R]): Unit is
        printLn(label);
        let plain: String := replace(asSpan(answer), "\r", "");
        if length(&plain) > 0 then
            print(getSpan(&plain, 0, length(&plain) - 1));
        end if;
        destroyString(plain);
        printLn("");
        printLn("-- end");
        return nil;
    end;

    function main(): ExitCode is
        let trigger: String := triggerHeader("item-saved");
        let saved: String := htmlResponse(201, asSpan(&trigger), "<li>tea</li>");
        show("== saved", &saved);
        destroyString(saved);
        let redirect: String := redirectHeader("/orders/7");
        let moved: String := htmlResponse(200, asSpan(&redirect), "");
        show("== redirected", &moved);
        destroyString(moved);
        var both: StringBuilder := makeStringBuilder();
        writeString(&!both, asSpan(&trigger));
        writeString(&!both, asSpan(&redirect));
        let lines: String := finalize(both);
        let together: String := htmlResponse(200, asSpan(&lines), "");
        show("== both", &together);
        destroyString(together);
        destroyString(lines);
        destroyString(trigger);
        destroyString(redirect);
        print("item-saved is an event name: ");
        printLn(isEventName("item-saved"));
        print("a b is an event name: ");
        printLn(isEventName("a b"));
        return ExitSuccess();
    end;
end module body.
