import Standard.IO (
    acquireTerminal,
    releaseTerminal,
    TerminalCapability
);
import Standard.IO.Terminal (
    StandardInput,
    acquireInput,
    releaseInput,
    readLine,
    inputIsTerminal,
    readHiddenLine,
    drainInput
);
import Standard.String (
    String,
    destroyString
);

module body Test is
    -- The four functions of Standard.IO.Terminal that read the standard
    -- input, in a programme that also compiles the binding of libcrypto:
    -- its header openssl/evp.h brings stdio.h, where stdin is a macro on
    -- OpenBSD.  The branch is compiled and never taken, so the test reads
    -- nothing from its input.
    function main(root: RootCapability): ExitCode is
        var mutRoot: RootCapability := root;
        var terminal: TerminalCapability := acquireTerminal(&!mutRoot);
        var input: StandardInput := acquireInput(&!terminal);
        let never: Index := 0;
        if never = 1 then
            let isTerminal: Bool := inputIsTerminal(&input);
            let line: String := readLine(&!input);
            destroyString(line);
            case readHiddenLine(&!input) of
                when Some(value as hidden: String) do
                    destroyString(hidden);
                when None do
                    skip;
            end case;
            let drained: Bool := drainInput(&!input);
        end if;
        printLn("compiled");
        releaseInput(input);
        releaseTerminal(terminal);
        surrenderRoot(mutRoot);
        return ExitSuccess();
    end;
end module body.
