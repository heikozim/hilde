module body Test is
    -- errno is a macro of errno.h, which every generated file includes;
    -- stdin, stdout and stderr are macros of stdio.h on OpenBSD.  Each is
    -- used here as a parameter, a local, a variable, a binding of a slot
    -- and the variable of a loop.
    record Pair: Free is
        errno: Int32;
        stdin: Int32;
    end;

    function sum(errno: Int32, stdin: Int32): Int32 is
        let stdout: Int32 := errno + stdin;
        var stderr: Int32 := stdout;
        stderr := stderr + 1;
        return stderr;
    end;

    generic [R: Region]
    function firstOf(stdin: &[Pair, R]): Int32 is
        return stdin->errno;
    end;

    function main(): ExitCode is
        let errno: Int32 := sum(2, 3);
        printLn(errno);
        let p: Pair := Pair(errno => 7, stdin => 8);
        printLn(firstOf(&p));
        let { errno as stdout: Int32, stdin: Int32 } := p;
        printLn(stdout + stdin);
        var count: Index := 0;
        for stderr from 1 to 3 do
            count := count + stderr;
        end for;
        printLn(count);
        return ExitSuccess();
    end;
end module body.
