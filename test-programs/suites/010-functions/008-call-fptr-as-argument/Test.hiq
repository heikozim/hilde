module body Test is
    function adder(x: Int32, y: Int32): Int32 is
        return x + y;
    end;

    function main(): ExitCode is
        let f: Fn[Int32, Int32, Int32] := adder;
        printLn(f(5, 10));
        printLn(f(f(5, 5), f(10, 10)));
        return ExitSuccess();
    end;
end module body.
