import Standard.IO (
    acquireTerminal,
    releaseTerminal,
    TerminalCapability
);
import Standard.IO.Terminal (
    StandardInput,
    StandardOutput,
    StandardError,
    acquireInput,
    acquireOutput,
    acquireError,
    releaseInput,
    releaseOutput,
    releaseError,
    readLine,
    inputIsTerminal,
    outputIsTerminal,
    terminalWidth,
    drainInput
);
import Standard.String (
    String,
    destroyString
);

module body Test is
    -- The streams of Standard.IO.Terminal held in locals named stdin, stdout
    -- and stderr, and a result named errno, in a programme that also
    -- compiles the binding of libcrypto, whose header brings stdio.h and
    -- errno.h: all four are macros of the C library.  The output is a pipe
    -- when the test runs, so outputIsTerminal answers false.  The reads are
    -- compiled and never taken.
    function main(root: RootCapability): ExitCode is
        var mutRoot: RootCapability := root;
        var terminal: TerminalCapability := acquireTerminal(&!mutRoot);
        var stdin: StandardInput := acquireInput(&!terminal);
        var stdout: StandardOutput := acquireOutput(&!terminal);
        var stderr: StandardError := acquireError(&!terminal);
        let errno: Bool := outputIsTerminal(&stdout);
        if errno then
            printLn("stdout is a terminal: true");
        else
            printLn("stdout is a terminal: false");
        end if;
        let never: Index := 0;
        if never = 1 then
            let isTerminal: Bool := inputIsTerminal(&stdin);
            let width: Nat32 := terminalWidth(&stdout);
            let line: String := readLine(&!stdin);
            destroyString(line);
            let drained: Bool := drainInput(&!stdin);
        end if;
        releaseError(stderr);
        releaseOutput(stdout);
        releaseInput(stdin);
        releaseTerminal(terminal);
        surrenderRoot(mutRoot);
        return ExitSuccess();
    end;
end module body.
