module body Test is
    function pick(base: Int32, twice: Bool): Int64 is
        var n: Int64 := 3;
        if base = 2 then
            n := 4;
        end if;
        if twice then
            return n + 3;
        end if;
        return n;
    end;

    function call(f: Fn[Int32, Bool, Int64]): Int64 is
        return f(1, true);
    end;

    function main(): ExitCode is
        let f: Fn[Int32, Bool, Int64] := pick;
        printLn(call(f));
        return ExitSuccess();
    end;
end module body.
