-- Every place a docstring may stand in a union: before the first case,
-- before a case after a case with slots, before a case after a case with
-- is and no slot, before a slot after a slot, and before a case with no
-- slots after all of them.
module body Test is
    union Reading: Free is
        """
        Nothing was read.
        """
        case Nothing;
        """
        One value.
        """
        case One is
            """
            The value.
            """
            value: Int32;
        """
        A case after a case with a slot.
        """
        case Two is
            first: Int32;
            """
            A slot after a slot.
            """
            second: Int32;
        """
        A case after a case with two slots.
        """
        case Empty is
        """
        A case after a case with is and no slot.
        """
        case Last;
    end;

    function number(reading: Reading): Int32 is
        case reading of
            when Nothing do
                return 0;
            when One(value: Int32) do
                return value;
            when Two(first: Int32, second: Int32) do
                return first + second;
            when Empty do
                return 7;
            when Last do
                return 9;
        end case;
    end;

    function main(): ExitCode is
        printLn(number(Nothing()));
        printLn(number(One(value => 1)));
        printLn(number(Two(first => 2, second => 3)));
        printLn(number(Empty()));
        printLn(number(Last()));
        return ExitSuccess();
    end;
end module body.
