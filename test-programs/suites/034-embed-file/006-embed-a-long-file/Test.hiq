module body Test is
    function widen(byte: Nat8): Int32 is
        case toInt32(byte) of
            when Some(value: Int32) do
                return value;
            when None do
                abort("A Nat8 did not fit in an Int32.");
        end case;
    end;

    function main(): ExitCode is
        -- The long file reaches the limit of a string literal and the short
        -- one stays below it.  Both are read back whole: the length, the
        -- first, a high and the last byte, and the sum of all of them.
        let long: Span[Nat8, Static] := @bytes("long.bin");
        let short: Span[Nat8, Static] := @bytes("short.bin");
        printLn(spanLength(long));
        printLn(spanLength(short));
        let first: Index := 0;
        let high: Index := 255;
        let last_long: Index := 4094;
        let last_short: Index := 4093;
        printLn(widen(long[first]));
        printLn(widen(long[high]));
        printLn(widen(long[last_long]));
        printLn(widen(short[high]));
        printLn(widen(short[last_short]));
        var total_long: Int32 := 0;
        for i from 0 to 4094 do
            total_long := total_long + widen(long[i]);
        end for;
        var total_short: Int32 := 0;
        for j from 0 to 4093 do
            total_short := total_short + widen(short[j]);
        end for;
        printLn(total_long);
        printLn(total_short);
        return ExitSuccess();
    end;
end module body.
