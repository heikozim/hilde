module body Test is
    function widen(byte: Nat8): Int32 is
        case toInt32(byte) of
            when Some(value: Int32) do
                return value;
            when None do
                abort("A Nat8 did not fit in an Int32.");
        end case;
    end;

    function main(): ExitCode is
        -- Every byte there is, 0 to 255, so that the embedding is measured
        -- over the whole range and not only over the printable part.  A nul
        -- and every byte above 126 have to leave the compiler as an escape
        -- in the generated C, and this is what says they did.
        let data: Span[Nat8, Static] := @bytes("bytes.bin");
        printLn(spanLength(data));
        let first: Index := 0;
        let last: Index := 255;
        let middle: Index := 128;
        printLn(widen(data[first]));
        printLn(widen(data[middle]));
        printLn(widen(data[last]));
        var total: Int32 := 0;
        for i from 0 to 255 do
            total := total + widen(data[i]);
        end for;
        -- 0 + 1 + ... + 255, which no subset of the bytes can reach by
        -- accident.
        printLn(total);
        return ExitSuccess();
    end;
end module body.
