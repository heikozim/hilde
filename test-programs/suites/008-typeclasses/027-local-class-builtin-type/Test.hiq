module body Test is
    typeclass Doubler(T: Free) is
        method double(value: T): T;
    end;

    instance Doubler(Int32) is
        method double(value: Int32): Int32 is
            return value + value;
        end;
    end;

    function main(): ExitCode is
        printLn(double(21));
        return ExitSuccess();
    end;
end module body.
