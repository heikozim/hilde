module body Test is
    instance BitwiseOperations(Float32) is
        method bitwiseAnd(lhs: Float32, rhs: Float32): Float32 is
            return lhs;
        end;

        method bitwiseOr(lhs: Float32, rhs: Float32): Float32 is
            return lhs;
        end;

        method bitwiseXor(lhs: Float32, rhs: Float32): Float32 is
            return lhs;
        end;

        method bitwiseNot(value: Float32): Float32 is
            return value;
        end;
    end;

    function main(): ExitCode is
        return ExitSuccess();
    end;
end module body.
