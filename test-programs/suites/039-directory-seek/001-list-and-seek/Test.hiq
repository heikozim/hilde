import Standard.String (
    String,
    destroyString,
    fromLiteral,
    length,
    nthByte,
    asSpan
);
import Standard.File (
    FileDescriptor,
    openRead,
    openWrite,
    closeFile,
    readAll,
    writeAll,
    removeFile,
    Pipe,
    openPipe,
    closePipe,
    readEndMut,
    SeekOrigin,
    seek_from_start,
    seek_from_here,
    seek_from_end,
    seekFile,
    createDirectory,
    removeDirectory,
    Directory,
    openDirectory,
    nextEntry,
    directoryFailed,
    closeDirectory
);

module body Test is
    function widen(value: Bool): Int32 is
        if value then
            return 1;
        end if;
        return 0;
    end;

    generic [R: Region, S: Region]
    function sameBytes(left: &[String, R], right: &[String, S]): Bool is
        let size: Index := length(left);
        if size /= length(right) then
            return false;
        end if;
        if size = 0 then
            return true;
        end if;
        var same: Bool := true;
        for i from 0 to size - 1 do
            if nthByte(left, i) /= nthByte(right, i) then
                same := false;
            end if;
        end for;
        return same;
    end;

    generic [R: Region, S: Region]
    function putFile(path: &[String, R], data: &[String, S]): Bool is
        case openWrite(asSpan(path)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                let written: Bool := writeAll(&!file, asSpan(data));
                let closed: Bool := closeFile(file);
                if written then
                    return closed;
                end if;
                return false;
            when None do
                return false;
        end case;
    end;

    generic [R: Region]
    function canOpenDirectory(path: &[String, R]): Bool is
        case openDirectory(asSpan(path)) of
            when Some(value as opened: Directory) do
                closeDirectory(opened);
                return true;
            when None do
                return false;
        end case;
    end;

    -- What seekFile answered, as a number: -1 for None.
    function offsetOr(answer: Option[Int64]): Int64 is
        case answer of
            when Some(value as where: Int64) do
                return where;
            when None do
                return -1;
        end case;
    end;

    -- Read the rest of an open file and compare it.
    generic [R: Region, S: Region]
    function restIs(file: &![FileDescriptor, R], expected: &[String, S]): Bool is
        case readAll(file) of
            when Some(value as got: String) do
                let same: Bool := sameBytes(&got, expected);
                destroyString(got);
                return same;
            when None do
                return false;
        end case;
    end;

    function main(): ExitCode is
        var dir: String := fromLiteral("hilde-039-directory.tmp");
        var alpha: String := fromLiteral("hilde-039-directory.tmp/alpha");
        var beta: String := fromLiteral("hilde-039-directory.tmp/beta");
        var gamma: String := fromLiteral("hilde-039-directory.tmp/gamma");
        var name_alpha: String := fromLiteral("alpha");
        var name_beta: String := fromLiteral("beta");
        var name_gamma: String := fromLiteral("gamma");
        var payload: String := fromLiteral("0123456789");

        -- 1. Nothing there yet, so it cannot be opened.
        printLn(widen(not canOpenDirectory(&dir)));

        -- 2. Made, and 3. not made twice.
        printLn(widen(createDirectory(asSpan(&dir))));
        printLn(widen(not createDirectory(asSpan(&dir))));

        -- 4. Three files inside it.
        let a: Bool := putFile(&alpha, &payload);
        let b: Bool := putFile(&beta, &payload);
        let c: Bool := putFile(&gamma, &payload);
        printLn(widen((a and b) and c));

        -- 5. Read it: exactly three names, each of the three once, and
        --    neither . nor ...  The order is the file system's, so the
        --    names are counted, not compared in sequence.
        case openDirectory(asSpan(&dir)) of
            when Some(value as opened: Directory) do
                var listing: Directory := opened;
                var count: Int32 := 0;
                var seen_alpha: Int32 := 0;
                var seen_beta: Int32 := 0;
                var seen_gamma: Int32 := 0;
                var reading: Bool := true;
                while reading do
                    case nextEntry(&!listing) of
                        when Some(value as name: String) do
                            count := count + 1;
                            if sameBytes(&name, &name_alpha) then
                                seen_alpha := seen_alpha + 1;
                            end if;
                            if sameBytes(&name, &name_beta) then
                                seen_beta := seen_beta + 1;
                            end if;
                            if sameBytes(&name, &name_gamma) then
                                seen_gamma := seen_gamma + 1;
                            end if;
                            destroyString(name);
                        when None do
                            reading := false;
                    end case;
                end while;
                printLn(count);
                printLn((seen_alpha + seen_beta) + seen_gamma);
                printLn(widen(not directoryFailed(&listing)));
                printLn(widen(closeDirectory(listing)));
            when None do
                printLn(0);
                printLn(0);
                printLn(0);
                printLn(0);
        end case;

        -- 6. A directory with files in it is not removed.
        printLn(widen(not removeDirectory(asSpan(&dir))));

        -- 7. Seeking.  From the start to 5, and the rest is "56789".
        var from_five: String := fromLiteral("56789");
        var from_seven: String := fromLiteral("789");
        case openRead(asSpan(&alpha)) of
            when Some(value as opened: FileDescriptor) do
                var file: FileDescriptor := opened;
                printLn(offsetOr(seekFile(&!file, 5, seek_from_start)));
                printLn(widen(restIs(&!file, &from_five)));
                -- The end is at 10; three back from there is 7, and the
                -- rest from 7 is "789".
                printLn(offsetOr(seekFile(&!file, 0, seek_from_end)));
                printLn(offsetOr(seekFile(&!file, -3, seek_from_here)));
                printLn(widen(restIs(&!file, &from_seven)));
                -- Before the start is refused, not clamped to 0.
                printLn(offsetOr(seekFile(&!file, -20, seek_from_start)));
                closeFile(file);
            when None do
                printLn(0);
        end case;

        -- 8. A pipe cannot seek, and says so.
        case openPipe() of
            when Some(value as made: Pipe) do
                var pipe: Pipe := made;
                printLn(offsetOr(seekFile(readEndMut(&!pipe), 0, seek_from_start)));
                closePipe(pipe);
            when None do
                printLn(0);
        end case;

        -- 9. Emptied, removed, and gone.
        let ra: Bool := removeFile(asSpan(&alpha));
        let rb: Bool := removeFile(asSpan(&beta));
        let rc: Bool := removeFile(asSpan(&gamma));
        printLn(widen((ra and rb) and rc));
        printLn(widen(removeDirectory(asSpan(&dir))));
        printLn(widen(not canOpenDirectory(&dir)));

        destroyString(dir);
        destroyString(alpha);
        destroyString(beta);
        destroyString(gamma);
        destroyString(name_alpha);
        destroyString(name_beta);
        destroyString(name_gamma);
        destroyString(payload);
        destroyString(from_five);
        destroyString(from_seven);
        return ExitSuccess();
    end;
end module body.
